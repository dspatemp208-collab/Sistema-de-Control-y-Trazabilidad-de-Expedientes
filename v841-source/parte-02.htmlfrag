<span id="masterBulkReturnSummary">0 expedientes</span>
</div>
<div id="masterBulkReturnTable">
<div class="empty">Seleccione expedientes en el Registro maestro.</div>
</div>
</div>
<div class="note" id="masterBulkReturnStatus" style="margin-top:10px"></div>
<div class="modal-foot">
<button class="btn secondary" onclick="closeMasterBulkReturnModal()" type="button">Cerrar</button>
<button class="btn" disabled="" id="masterBulkReturnConfirmBtn" onclick="confirmMasterBulkReturns()" type="button">
        ✓ Aceptar devoluciones
      </button>
</div>
</div>
