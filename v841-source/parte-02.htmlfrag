<!-- Búsqueda dirigida para solicitar expedientes -->
<div class="modal" id="requestSearchModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box">
<div class="modal-head">
<div>
<h2 id="requestSearchModalTitle">Agregar expedientes a la solicitud</h2>
<div class="note">Puede buscar expedientes existentes, registrar uno nuevo manualmente o cargar varios desde Excel.</div>
</div>
<div style="display:flex;gap:6px">
<button class="btn secondary small" onclick="returnToNewRequestFromSearch()">← Volver a Nueva solicitud</button>
<button class="btn secondary small" onclick="closeRequestSearchModal()">Cerrar</button>
</div>
</div>
<div class="form-grid">
<div class="field span2">
<label>Número de expediente</label>
<input id="requestLookupInput" oninput="updateRequestExtensionRequirementV265();scheduleRequestExtensionDropdownV330()" onkeydown="if(event.key==='Enter'){event.preventDefault();searchRequestCandidates()}" placeholder="Ej.: 0123-2006 o 132456-2005"/>
</div>
<div class="field">
<label id="requestLookupExtensionLabel">Extensión / sigla</label>
<select id="requestLookupExtension" onchange="updateRequestExtensionRequirementV265()" onkeydown="if(event.key==='Enter'){event.preventDefault();searchRequestCandidates()}">
<option value="">Seleccione extensión</option>
</select>
<div class="request-extension-help" id="requestLookupExtensionHelp">
          Regla por año: 2000-2005 DINSECOVI · 2006 DINSECOVI/DIGSECOVI · 2007-2011 DIGSECOVI · 2012 DIGSECOVI/DGS · 2013-2016 DGS · 2017 DGS/DSF-PA · 2018-2026 DSF-PA.
        </div>
</div>
<div style="display:flex;align-items:flex-end;gap:8px;flex-wrap:wrap">
<button class="btn" onclick="searchRequestCandidates()">Buscar</button>
<button class="btn secondary" onclick="el('requestExcelFile').click()" type="button">📊 Cargar Excel</button>
<button class="btn secondary" onclick="downloadRequestTemplateV267()" type="button">⬇ Descargar plantilla</button>
<input accept=".xlsx,.xls,.csv" class="hidden" id="requestExcelFile" onchange="importRequestExcel(this.files[0]);this.value=''" type="file"/>
</div>
</div>
<div class="excel-import-box">
<div class="excel-import-actions">
<strong>Solicitud masiva desde Excel</strong>
<span class="note">Detecta expedientes del archivo y los compara con la base de datos.</span>
</div>
<div class="hidden" id="requestExcelSummary"></div>
<div id="requestExcelResults"></div>
</div>
<div class="note" id="requestLookupStatus" style="margin-top:8px">
      Escriba el número y año del expediente. El número puede tener 1, 4, 5, 6 o más dígitos.
      Ej.: <b>0065-2012</b> o <b>132456-2005</b>.
    </div>
<div class="card hidden" id="newExpRequestBox" style="margin-top:10px;padding:12px">
<strong id="newExpRequestTitle">El expediente no está registrado</strong>
<div class="note" id="newExpRequestNote" style="margin:4px 0 10px">
        Puede registrarlo por primera vez y agregarlo a la misma solicitud. Archivo verificará el expediente antes de atenderlo.
      </div>
<div class="form-grid">
<div class="field">
<label>Expediente *</label>
<input id="newReqExpediente" readonly=""/>
</div>
<div class="field">
<label id="newReqExtensionLabel">Extensión</label>
<input id="newReqExtension" oninput="updateNewRequestExtensionRequirementV265()" placeholder="Opcional"/>
<div class="request-extension-help" id="newReqExtensionHelp">Opcional, excepto para 2006, 2012 y 2017.</div>
</div>
<div class="field">
<label>R.D.</label>
<input id="newReqRd" placeholder="Opcional"/>
</div>
<div class="field">
<label>Último folio</label>
<input id="newReqFolio" placeholder="Opcional"/>
</div>
<div class="field span4">
<label>Observación del expediente</label>
<input id="newReqExpObs" placeholder="Dato adicional, si corresponde"/>
</div>
</div>
<div style="margin-top:10px">
<button class="btn" id="newExpRequestAddBtn" onclick="openNewFirstTimeRequest()">+ Agregar expediente nuevo a la solicitud</button>
</div>
</div>
<div class="request-search-results" id="requestLookupResults">
<div class="empty">Sin búsqueda.</div>
</div>
<div class="request-draft-box">
<div class="request-draft-head">
<strong>Expedientes agregados a esta solicitud</strong>
<span id="requestDraftCount">0 expedientes</span>
</div>
<div class="request-draft-empty" id="requestDraftTable">
        Aún no ha agregado expedientes.
      </div>
</div>
<div class="modal-foot">
<span class="note" id="requestLookupCount">0 seleccionados en la búsqueda</span>
<div style="display:flex;gap:8px;flex-wrap:wrap">
<button class="btn secondary" onclick="closeRequestSearchModal()">Cerrar</button>
<button class="btn secondary" disabled="" id="requestLookupAddBtn" onclick="addSelectedSearchResultsToDraft()">+ Agregar seleccionados</button>
<button class="btn secondary" disabled="" id="requestLookupNextBtnV501" onclick="prepareNextRequestLookupV501()">+ Agregar otro expediente</button>
<button class="btn" disabled="" id="requestLookupContinueBtn" onclick="continueRequestFromSearch()">Continuar solicitud</button>
</div>
</div>
</div>
</div>
