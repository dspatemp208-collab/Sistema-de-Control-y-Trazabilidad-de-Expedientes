async function loadReceivedReassignPanelRowsV196(search=''){
  const age=internalReassignLoadedAtV187
    ?Date.now()-internalReassignLoadedAtV187
    :Infinity;

  if(!internalReassignLoadedAtV187){
    await loadInternalReassignRequests(true);
  }else if(age>20000){
    // V244 · no bloquear el cambio de tarjeta por una recarga completa.
    loadInternalReassignRequests(true).catch(error=>
      console.warn('V244 · actualización silenciosa de reasignaciones recibidas:',error?.message||error)
    );
  }

  let rows=receivedPendingReassignRowsV196();

  const q=norm(search||'');
  if(q){
    rows=rows.filter(r=>[
      r.expediente,
      r.extension,
      r.solicitante_nombre,
      r.responsable_actual_nombre,
      r.asunto,
      r.observacion
    ].some(v=>norm(v||'').includes(q)));
  }

  return rows.sort((a,b)=>
    String(b.created_at||'').localeCompare(
      String(a.created_at||'')
    )
  );
}

async function confirmInternalReassignFromPanelV196(id,button=null){
  const row=(internalReassignRows||[]).find(
    r=>String(r.id)===String(id)
  );

  if(!row)return;

  const target=row.solicitante_nombre||'el usuario solicitante';

  const ok=window.confirm(
    `¿Confirmar la reasignación del expediente ${row.expediente||''} a ${target}?\n\n`+
    'La custodia cambiará directamente al usuario solicitante.'
  );

  if(!ok)return;

  const oldText=button?.textContent||'Confirmar reasignación';

  if(button){
    button.disabled=true;
    button.textContent='Reasignando...';
  }

  try{
    await respondInternalReassign(id,'ACEPTAR');

    // Mantener visible esta misma tarjeta después de confirmar.
    userPanelMode='SOLICITUDES_REASIGNACION';
    page=0;

    await Promise.all([
      loadInternalReassignRequests(true),
      loadUserPersonalSummary(),
      loadPanel({refreshCards:false})
    ]);
  }finally{
    if(button){
      button.disabled=false;
      button.textContent=oldText;
    }
  }
}

async function rejectInternalReassignFromPanelV196(id,button=null){
  const row=(internalReassignRows||[]).find(
    r=>String(r.id)===String(id)
  );

  if(!row)return;

  const ok=window.confirm(
    `¿Rechazar la solicitud de reasignación del expediente ${row.expediente||''}?`
  );

  if(!ok)return;

  const oldText=button?.textContent||'Rechazar';

  if(button){
    button.disabled=true;
    button.textContent='Rechazando...';
  }

  try{
    await respondInternalReassign(id,'RECHAZAR');

    userPanelMode='SOLICITUDES_REASIGNACION';
    page=0;

    await Promise.all([
      loadInternalReassignRequests(true),
      loadUserPersonalSummary(),
      loadPanel({refreshCards:false})
    ]);
  }finally{
    if(button){
      button.disabled=false;
      button.textContent=oldText;
    }
  }
}


let reassignTrackingRowsV198=[];
let reassignTrackingFilteredV198=[];
let reassignTrackingTimerV198=null;

function reassignTrackingActualRowsV198(){
  let rows=(internalReassignRows||[]).filter(r=>
    !r._derived_custodian_alert &&
    r.id &&
    r.expediente_id
  );

  if(isCoordinator()){
    const allowed=new Set(coordinatorAllowedUserNamesV205().map(norm));

    rows=rows.filter(r=>{
      const requester=norm(r.solicitante_nombre||'');
      const custodian=norm(
        r.responsable_actual_nombre||
        r.responsable_actual||
        ''
      );

      return allowed.has(requester)||allowed.has(custodian);
    });
  }

  return rows;
}

function reassignTrackingStateV198(row){
  const s=norm(row?.estado||'');
  if(s==='ACEPTADA')return 'ACEPTADA';
  if(s==='RECHAZADA')return 'RECHAZADA';
  if(s==='CANCELADA')return 'CANCELADA';
  return 'PENDIENTE';
}

function reassignTrackingResponseDateV198(row){
  return (
    row?.responded_at||
    row?.fecha_respuesta||
    row?.updated_at||
    row?.respuesta_at||
    null
  );
}

function reassignTrackingAgeHoursV198(row){
  if(reassignTrackingStateV198(row)!=='PENDIENTE')return 0;

  const d=appTimestampDateV186(row?.created_at);
  if(!d)return 0;

  return Math.max(
    0,
    (Date.now()-d.getTime())/3600000
  );
}

function reassignTrackingAgeTextV198(row){
  if(reassignTrackingStateV198(row)!=='PENDIENTE')return '—';

  const hours=reassignTrackingAgeHoursV198(row);
  if(hours<1)return `${Math.max(0,Math.floor(hours*60))} min`;
  if(hours<24)return `${Math.floor(hours)} h`;

  const days=Math.floor(hours/24);
  const rest=Math.floor(hours-(days*24));
  return `${days} d ${rest} h`;
}

function reassignTrackingStateLabelV198(row){
  const s=reassignTrackingStateV198(row);
  if(s==='ACEPTADA')return 'CONFIRMADA';
  if(s==='RECHAZADA')return 'RECHAZADA';
  if(s==='CANCELADA')return 'CANCELADA';
  return 'PENDIENTE DE CONFIRMACIÓN';
}

function reassignTrackingStatePillV198(row){
  const s=reassignTrackingStateV198(row);
  if(s==='ACEPTADA')return '<span class="pill returned">CONFIRMADA</span>';
  if(s==='RECHAZADA')return '<span class="pill alert">RECHAZADA</span>';
  if(s==='CANCELADA')return '<span class="pill">CANCELADA</span>';
  return '<span class="pill pending">PENDIENTE DE CONFIRMACIÓN</span>';
}

function populateReassignTrackingSelectV198(id,values){
  const select=el(id);
  if(!select)return;

  const current=select.value;
  const unique=[...new Set(
    (values||[])
      .map(v=>String(v||'').trim())
      .filter(Boolean)
  )].sort((a,b)=>a.localeCompare(b,'es',{sensitivity:'base'}));

  select.innerHTML=
    '<option value="">TODOS</option>'+
    unique.map(v=>`<option value="${esc(v)}">${esc(v)}</option>`).join('');

  if(unique.some(v=>v===current)){
    select.value=current;
  }
}

function updateReassignTrackingCardsV198(rows){
  const list=Array.isArray(rows)?rows:[];

  const counts={
    PENDIENTE:0,
    ACEPTADA:0,
    RECHAZADA:0,
    CANCELADA:0,
    MAYOR_24:0
  };

  list.forEach(r=>{
    const state=reassignTrackingStateV198(r);
    counts[state]=Number(counts[state]||0)+1;

    if(
      state==='PENDIENTE' &&
      reassignTrackingAgeHoursV198(r)>=24
    ){
      counts.MAYOR_24++;
    }
  });

  if(el('v198PendingCount'))el('v198PendingCount').textContent=counts.PENDIENTE;
  if(el('v198AcceptedCount'))el('v198AcceptedCount').textContent=counts.ACEPTADA;
  if(el('v198RejectedCount'))el('v198RejectedCount').textContent=counts.RECHAZADA;
  if(el('v198CancelledCount'))el('v198CancelledCount').textContent=counts.CANCELADA;
  if(el('v198Over24Count'))el('v198Over24Count').textContent=counts.MAYOR_24;

  const selected=el('v198TrackState')?.value||'';

  document.querySelectorAll('.v198-track-kpi[data-v198-state]').forEach(card=>{
    card.classList.toggle(
      'quick-active',
      card.dataset.v198State===selected
    );
  });
}

function filterReassignTrackingRowsV198(rows){
  const q=norm(el('v198TrackSearch')?.value||'');
  const state=String(el('v198TrackState')?.value||'').trim();
  const requester=norm(el('v198TrackRequester')?.value||'');
  const custodian=norm(el('v198TrackCustodian')?.value||'');

  return (rows||[]).filter(r=>{
    const rowState=reassignTrackingStateV198(r);

    if(state==='MAYOR_24'){
      if(
        rowState!=='PENDIENTE' ||
        reassignTrackingAgeHoursV198(r)<24
      ){
        return false;
      }
    }else if(state && rowState!==state){
      return false;
    }

    if(
      requester &&
      norm(r.solicitante_nombre||'')!==requester
    ){
      return false;
    }

    if(
      custodian &&
      norm(
        r.responsable_actual_nombre||
        r.responsable_actual||
        ''
      )!==custodian
    ){
      return false;
    }

    if(q){
      const haystack=[
        r.expediente,
        r.extension,
        r.solicitante_nombre,
        r.responsable_actual_nombre,
        r.responsable_actual,
        r.asunto,
        r.observacion,
        r.motivo_respuesta,
        reassignTrackingStateLabelV198(r)
      ].map(v=>norm(v||'')).join(' ');

      if(!haystack.includes(q))return false;
    }

    return true;
  });
}

function renderReassignTrackingV198(){
  const table=el('v198TrackTable');
  if(!table)return;

  const rows=filterReassignTrackingRowsV198(
    reassignTrackingRowsV198
  );

  reassignTrackingFilteredV198=rows;

  if(el('v198TrackCount')){
    el('v198TrackCount').textContent=
      `${rows.length} solicitud${rows.length===1?'':'es'}`;
  }

  updateReassignTrackingCardsV198(
    reassignTrackingRowsV198
  );

  if(!rows.length){
    table.innerHTML=
      '<div class="empty">No hay solicitudes de reasignación que coincidan con los filtros.</div>';
    return;
  }

  table.innerHTML=`<table class="v198-track-table">
    <thead>
      <tr>
        <th>Expediente</th>
        <th>Ext.</th>
        <th>Solicitado por</th>
        <th>Custodio / responsable</th>
        <th>Fecha / hora solicitud</th>
        <th class="subject-cell-v639">Asunto</th>
        <th>Estado</th>
        <th>Tiempo pendiente</th>
        <th>Fecha / hora respuesta</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      ${rows.map(r=>{
        const responseDate=reassignTrackingResponseDateV198(r);
        return `<tr class="${reassignTrackingAgeHoursV198(r)>=24?'v198-overdue-row':''}">
          <td><b>${esc(r.expediente||'—')}</b></td>
          <td>${esc(r.extension||'—')}</td>
          <td><b>${esc(r.solicitante_nombre||'—')}</b></td>
          <td><b>${esc(r.responsable_actual_nombre||r.responsable_actual||'—')}</b></td>
          <td>
            <div class="datetime-cell">
              <span class="datetime-date">${fmtDate(r.created_at)||'—'}</span>
              <span class="datetime-time">${masterValueHasExplicitTime(r.created_at)?fmtTime(r.created_at):'—'}</span>
            </div>
          </td>
          <td class="subject-cell-v639" title="${esc(r.asunto||'')}"><div class="subject-text-v639">${esc(r.asunto||'—')}</div></td>
          <td>${reassignTrackingStatePillV198(r)}</td>
          <td><b>${esc(reassignTrackingAgeTextV198(r))}</b></td>
          <td>
            ${responseDate
              ?`<div class="datetime-cell">
                   <span class="datetime-date">${fmtDate(responseDate)||'—'}</span>
                   <span class="datetime-time">${masterValueHasExplicitTime(responseDate)?fmtTime(responseDate):'—'}</span>
                 </div>`
              :'—'
            }
          </td>
          <td>
            <div class="v198-track-actions">
              <button class="btn secondary small"
                      type="button"
                      onclick="openReassignTrackingDetailV198('${r.id}')">
                Detalle
              </button>
              ${r.expediente_id
                ?cycleHistoryButton(r.expediente_id,r,'Historial')
                :''
              }
            </div>
          </td>
        </tr>`;
      }).join('')}
    </tbody>
  </table>`;
}

async function loadReassignTrackingV198(force=true){
  if(!sb||!session||!(isAdmin()||isArchive()))return;

  const table=el('v198TrackTable');
  if(table && force){
    table.innerHTML=
      '<div class="empty">Consultando solicitudes de reasignación...</div>';
  }

  await loadInternalReassignRequests(true);

  reassignTrackingRowsV198=reassignTrackingActualRowsV198()
    .slice()
    .sort((a,b)=>
      String(b.created_at||'').localeCompare(
        String(a.created_at||'')
      )
    );

  populateReassignTrackingSelectV198(
    'v198TrackRequester',
    reassignTrackingRowsV198.map(r=>r.solicitante_nombre)
  );

  populateReassignTrackingSelectV198(
    'v198TrackCustodian',
    reassignTrackingRowsV198.map(r=>
      r.responsable_actual_nombre||
      r.responsable_actual
    )
  );

  renderReassignTrackingV198();
}

function debounceReassignTrackingV198(){
  clearTimeout(reassignTrackingTimerV198);
  reassignTrackingTimerV198=setTimeout(
    renderReassignTrackingV198,
    160
  );
}

function setReassignTrackingFilterV198(value){
  if(el('v198TrackState')){
    el('v198TrackState').value=value||'';
  }
  renderReassignTrackingV198();
}

function clearReassignTrackingFiltersV198(){
  if(el('v198TrackSearch'))el('v198TrackSearch').value='';
  if(el('v198TrackState'))el('v198TrackState').value='';
  if(el('v198TrackRequester'))el('v198TrackRequester').value='';
  if(el('v198TrackCustodian'))el('v198TrackCustodian').value='';
  renderReassignTrackingV198();
}

function ensureReassignTrackingDetailModalV198(){
  let modal=el('v198ReassignDetailModal');
  if(modal)return modal;

  modal=document.createElement('div');
  modal.id='v198ReassignDetailModal';
  modal.className='modal';

  modal.innerHTML=`
    <div class="modal-card v198-detail-card">
      <div class="modal-head">
        <div>
          <h2 style="margin:0">Detalle de la solicitud de reasignación</h2>
          <div class="note" id="v198ReassignDetailSubtitle"></div>
        </div>
        <button class="btn secondary"
                type="button"
                onclick="closeReassignTrackingDetailV198()">
          Cerrar
        </button>
      </div>

      <div id="v198ReassignDetailBody"></div>
    </div>
  `;

  document.body.appendChild(modal);

  modal.addEventListener('click',event=>{
    if(event.target===modal){
      closeReassignTrackingDetailV198();
    }
  });

  return modal;
}

function openReassignTrackingDetailV198(id){
  const row=(reassignTrackingRowsV198||[]).find(
    r=>String(r.id)===String(id)
  );

  if(!row)return;

  const modal=ensureReassignTrackingDetailModalV198();
  const responseDate=reassignTrackingResponseDateV198(row);

  if(el('v198ReassignDetailSubtitle')){
    el('v198ReassignDetailSubtitle').textContent=
      `${row.expediente||'Expediente'} · ${reassignTrackingStateLabelV198(row)}`;
  }

  if(el('v198ReassignDetailBody')){
    el('v198ReassignDetailBody').innerHTML=`
      <div class="v198-detail-grid">
        <div><small>Expediente</small><b>${esc(row.expediente||'—')}</b></div>
        <div><small>Extensión</small><b>${esc(row.extension||'—')}</b></div>
        <div><small>Solicitado por</small><b>${esc(row.solicitante_nombre||'—')}</b></div>
        <div><small>Custodio / responsable</small><b>${esc(row.responsable_actual_nombre||row.responsable_actual||'—')}</b></div>
        <div><small>Fecha / hora solicitud</small><b>${fmtDate(row.created_at)||'—'} ${masterValueHasExplicitTime(row.created_at)?fmtTime(row.created_at):''}</b></div>
        <div><small>Estado</small><div>${reassignTrackingStatePillV198(row)}</div></div>
        <div><small>Asunto</small><b>${esc(row.asunto||'—')}</b></div>
        <div><small>Tiempo pendiente</small><b>${esc(reassignTrackingAgeTextV198(row))}</b></div>
        <div><small>Fecha / hora respuesta</small><b>${responseDate?`${fmtDate(responseDate)} ${masterValueHasExplicitTime(responseDate)?fmtTime(responseDate):''}`:'—'}</b></div>
        <div><small>Motivo / resultado</small><b>${esc(row.motivo_respuesta||'—')}</b></div>
      </div>

      <div class="v198-detail-observation">
        <small>Observación</small>
        <div>${esc(row.observacion||'Sin observación')}</div>
      </div>

      <div class="note" style="margin-top:12px">
        Esta es una vista de supervisión. Archivo y Administrador no confirman ni rechazan la reasignación en nombre del custodio.
      </div>
    `;
  }

  modal.classList.add('show');
}

function closeReassignTrackingDetailV198(){
  el('v198ReassignDetailModal')?.classList.remove('show');
}

function internalReassignStatePill(state){
  const s=norm(state||'');
  if(s==='ACEPTADA')return '<span class="pill returned">ACEPTADA</span>';
  if(s==='RECHAZADA')return '<span class="pill alert">RECHAZADA</span>';
  if(s==='CANCELADA')return '<span class="pill">CANCELADA</span>';
  return '<span class="pill alert">PENDIENTE</span>';
}


async function myPendingInternalReassignPanelRows(search=''){
  if(!isLimitedUser()||!sb||!session)return [];

  // Refrescar primero la bandeja interna para que Mis Expedientes refleje
  // únicamente solicitudes ENVIADAS que todavía están PENDIENTES.
  await loadInternalReassignRequests(true);

  let sent=(internalReassignRows||[]).filter(r=>
    norm(r.direccion)==='ENVIADA' && norm(r.estado)==='PENDIENTE'
  );

  const q=norm(search||'');
  if(q){
    sent=sent.filter(r=>[
      r.expediente,r.extension,r.responsable_actual_nombre,
      r.area_trabajo,r.asunto,r.observacion
    ].some(v=>norm(v||'').includes(q)));
  }

  if(!sent.length)return [];

  // Intentar completar los datos del Registro Maestro. Si RLS no permite
  // leer algún dato, se mantiene de todos modos la fila mínima devuelta por RPC.
  const ids=[...new Set(sent.map(r=>r.expediente_id).filter(Boolean))];
  let masterMap=new Map();
  if(ids.length){
    const {data,error}=await sb
      .from('expedientes')
      .select('*')
      .in('id',ids);
    if(!error){
      masterMap=new Map((data||[]).map(x=>[String(x.id),x]));
    }else{
      console.warn('Datos de reasignación solicitada:',error.message);
    }
  }

  return sent.map(r=>{
    const m=masterMap.get(String(r.expediente_id))||{};
    const detail=[
      r.area_trabajo?`Área: ${r.area_trabajo}`:'',
      r.asunto?`Asunto: ${r.asunto}`:'',
      r.observacion||''
    ].filter(Boolean).join(' · ');

    return {
      ...m,
      id:r.expediente_id,
      expediente:r.expediente||m.expediente||'',
      extension:r.extension||m.extension||'',
      responsable:r.responsable_actual_nombre||m.responsable||'',
      estado:'REASIGNACIÓN SOLICITADA',
      modalidad:'REASIGNACIÓN DIRECTA',
      fecha_devolucion:null,
      observacion:detail||m.observacion||'',
      _internal_reassign_requested:true,
      _internal_request_id:r.id,
      _internal_request_created_at:r.created_at,
      _internal_request_target:r.responsable_actual_nombre||'',
      _internal_request_area:r.area_trabajo||''
    };
  });
}

let internalAlertFilter='all';
let reassignmentAlertFilter='all';
function setInternalAlertFilter(filter){internalAlertFilter=filter==='pending'?'pending':'all';renderInternalReassignRequests();}
function setReassignmentAlertFilter(filter){reassignmentAlertFilter=filter==='unread'?'unread':'all';renderNotifications();}
function renderInternalReassignRequests(){
  const list=el('internalReassignAlertsList');
  if(!list)return;

  const visibleInternalRows=internalAlertFilter==='pending'
    ?internalReassignRows.filter(row=>norm(row.estado)==='PENDIENTE')
    :internalReassignRows;

  document.querySelectorAll('[data-internal-alert-filter]').forEach(button=>{
    const active=button.dataset.internalAlertFilter===internalAlertFilter;
    button.classList.toggle('active',active);
    button.setAttribute('aria-pressed',String(active));
  });

  if(!visibleInternalRows.length){
    list.innerHTML='<div class="empty">No hay solicitudes de reasignación pendientes.</div>';
    return;
  }

  list.innerHTML=visibleInternalRows.map(r=>{
    const received=norm(r.direccion)==='RECIBIDA';
    const sent=norm(r.direccion)==='ENVIADA';
    const legacyReturn=!!r._derived_custodian_alert;

    let message='';

    if(legacyReturn){
      message=
        `<b>${esc(r.solicitante_nombre||'Otro usuario')}</b> tiene una solicitud antigua vinculada a este expediente. `+
        `Este aviso corresponde al flujo anterior y debe gestionarse mediante devolución a Archivo.`;
    }else if(received){
      message=
        `<b>${esc(r.solicitante_nombre||'Otro usuario')}</b> solicita que le reasigne este expediente. `+
        `<b>Si confirma, la custodia pasará directamente a ${esc(r.solicitante_nombre||'ese usuario')}</b>. `+
        `No se generará una nueva solicitud de préstamo ni será necesario devolverlo previamente a Archivo.`;
    }else if(sent){
      message=
        `Solicitud de reasignación enviada a <b>${esc(r.responsable_actual_nombre||'—')}</b>. `+
        `El expediente continuará bajo su custodia hasta que confirme la reasignación.`;
    }else{
      message=
        `<b>${esc(r.solicitante_nombre||'—')}</b> solicita la reasignación del expediente actualmente bajo custodia de `+
        `<b>${esc(r.responsable_actual_nombre||'—')}</b>.`;
    }

    return `<div class="notification-item ${norm(r.estado)==='PENDIENTE'?'unread':''}">
      <div class="notification-head">
        <div>
          <div class="notification-title">
            🤝 ${esc(r.expediente||'—')} · ${legacyReturn?'FLUJO ANTERIOR':'REASIGNACIÓN'}
          </div>
          <div class="notification-meta">
            ${fmtDate(r.created_at)}${masterValueHasExplicitTime(r.created_at)?' · '+fmtTime(r.created_at):''}
            · ${esc(r.direccion||'SUPERVISIÓN')}
          </div>
        </div>
        ${internalReassignStatePill(r.estado)}
      </div>

      <div class="notification-message">
        ${message}
        ${r.asunto?`<br>Asunto: ${esc(r.asunto)}`:''}
        ${r.observacion?`<br>Observación: ${esc(r.observacion)}`:''}
        ${r.motivo_respuesta?`<br>Resultado: ${esc(r.motivo_respuesta)}`:''}
      </div>

      <div class="notification-actions">
        ${legacyReturn && r.puede_responder && norm(r.estado)==='PENDIENTE'
          ?`<button class="btn"
                    onclick="openInternalReturnFromAlert('${r.id}',this)">
               Gestionar devolución a Archivo
             </button>`
          :''}

        ${!legacyReturn && received && r.puede_responder && norm(r.estado)==='PENDIENTE'
          ?`<button class="btn"
                    onclick="confirmInternalReassignFromAlert('${r.id}',this)">
               ✓ Confirmar reasignación
             </button>
             <button class="btn secondary small"
                    onclick="respondInternalReassign('${r.id}','RECHAZAR')">
               Rechazar
             </button>`
          :''}

        ${sent && norm(r.estado)==='PENDIENTE'
          ?`<button class="btn secondary small"
                    onclick="cancelInternalReassign('${r.id}')">
               Cancelar solicitud
             </button>`
          :''}

        ${r.expediente_id
          ?`<button class="btn secondary small"
                    onclick="closeAlertsModal();manageExpedienteFromPanel('${r.expediente_id}')">
               Ver expediente
             </button>`
          :''}
      </div>
    </div>`;
  }).join('');
}

async function confirmInternalReassignFromAlert(id,button=null){
  const row=(internalReassignRows||[]).find(
    x=>String(x.id)===String(id)
  );

  if(!row)return;

  const target=row.solicitante_nombre||'el usuario solicitante';

  const ok=window.confirm(
    `¿Confirmar la reasignación del expediente ${row.expediente||''} a ${target}?\n\n`+
    'La custodia cambiará directamente al usuario solicitante.'
  );

  if(!ok)return;

  const oldText=button?.textContent||'Confirmar reasignación';

  if(button){
    button.disabled=true;
    button.textContent='Reasignando...';
  }

  try{
    await respondInternalReassign(id,'ACEPTAR');
  }finally{
    if(button){
      button.disabled=false;
      button.textContent=oldText;
    }
  }
}


async function openInternalReturnFromAlert(id,button=null){
  const row=(internalReassignRows||[]).find(
    x=>String(x.id)===String(id)
  );

  if(!row?.expediente_id){
    showToast('No se pudo identificar el expediente de la alerta.');
    return;
  }

  const oldText=button?.textContent||'Gestionar / devolver a Archivo';

  if(button){
    button.disabled=true;
    button.textContent='Abriendo...';
  }

  try{
    closeAlertsModal();
    await manageExpedienteFromPanel(row.expediente_id,button);

    if(el('rqActionStatus')){
      el('rqActionStatus').innerHTML=
        `<b>${esc(row.expediente||'Expediente')} solicitado por ${esc(row.solicitante_nombre||'otro usuario')}.</b> `+
        `El expediente continúa bajo su responsabilidad. `+
        `Actualice el Último folio y utilice <b>Devolver</b> para enviarlo a Archivo.`;
    }
  }finally{
    if(button){
      button.disabled=false;
      button.textContent=oldText;
    }
  }
}

async function closeReturnAlertsForExpedientes(expedienteIds){
  const ids=new Set((expedienteIds||[]).map(String));
  if(!ids.size)return;

  await loadInternalReassignRequests(true);

  const pending=(internalReassignRows||[]).filter(r=>
    ids.has(String(r.expediente_id||'')) &&
    norm(r.direccion)==='RECIBIDA' &&
    norm(r.estado)==='PENDIENTE' &&
    r.puede_responder &&
    !r._derived_custodian_alert
  );

  for(const row of pending){
    const {error}=await sb.rpc('responder_reasignacion_personal_v242',{
      p_solicitud_interna_id:row.id,
      p_accion:'RECHAZAR',
      p_motivo:'EXPEDIENTE DEVUELTO A ARCHIVO PARA ATENDER LA NUEVA SOLICITUD'
    });

    if(error){
      console.warn('Cerrar aviso de devolución:',error.message);
    }
  }

  await loadInternalReassignRequests(true);
}

async function respondInternalReassign(id,action){
  const row=(internalReassignRows||[]).find(x=>String(x.id)===String(id));
  if(!row)return;

  const {data,error}=await sb.rpc('responder_reasignacion_personal_v242',{
    p_solicitud_interna_id:id,
    p_accion:action,
    p_motivo:null
  });

  if(error){
    showToast(error.message);
    return;
  }

  showToast(action==='ACEPTAR'
    ?`${data?.expediente||row.expediente} reasignado a ${data?.nuevo_responsable||row.solicitante_nombre}`
    :`Solicitud de ${row.expediente||'expediente'} rechazada`);

  await Promise.all([
    loadInternalReassignRequests(true),loadNotifications(true),loadPanel(),loadRequests(),loadHistory(),
    isLimitedUser()?loadUserPersonalSummary():Promise.resolve()
  ]);
  renderInternalReassignRequests();
}

async function cancelInternalReassign(id){
  const {error}=await sb.rpc('cancelar_reasignacion_personal_v242',{
    p_solicitud_interna_id:id
  });
  if(error){showToast(error.message);return}
  showToast('Solicitud interna cancelada');
  await loadInternalReassignRequests(true);
  if(isLimitedUser()){
    await Promise.all([loadSummary(),loadPanel()]);
  }
  renderInternalReassignRequests();
}

function pendingSentInternalReassignRowsV481(){
  return (internalReassignRows||[])
    .map(r=>{
      try{
        return typeof normalizeInternalReassignRowV476==='function'
          ?normalizeInternalReassignRowV476(r)
          :r;
      }catch(_){
        return r;
      }
    })
    .filter(r=>
      norm(r.direccion)==='ENVIADA' &&
      norm(r.estado)==='PENDIENTE' &&
      r.expediente_id
    );
}

function pendingSentInternalReassignIds(){
  return new Set(
    pendingSentInternalReassignRowsV481()
      .map(r=>String(r.expediente_id))
  );
}

function pendingSentInternalReassignMapV481(){
  const map=new Map();
  pendingSentInternalReassignRowsV481().forEach(r=>{
    const key=String(r.expediente_id||'');
    if(!key)return;

    const prev=map.get(key);
    if(
      !prev ||
      String(r.created_at||'')>String(prev.created_at||'')
    ){
      map.set(key,r);
    }
  });
  return map;
}

async function filterAlreadyRequestedInternalReassign(rows){
  if(!canRequestDirectReassignV466() || !Array.isArray(rows) || !rows.length)return rows||[];

  // V481 · Cargar la bandeja reciente para detectar una reasignación
  // ya solicitada por el usuario actual.
  if(
    !internalReassignLoadedAtV187 ||
    (Date.now()-internalReassignLoadedAtV187)>12000
  ){
    await loadInternalReassignRequests(true);
  }

  const pendingMap=pendingSentInternalReassignMapV481();

  // No ocultar el expediente. Mantenerlo visible y explicar que la
  // reasignación YA fue enviada; se evita crear una solicitud duplicada.
  return rows.map(r=>{
    const pending=r?.id
      ?pendingMap.get(String(r.id))
      :null;

    if(!pending)return r;

    return {
      ...r,
      disponible:false,
      _existingPendingReassignV481:pending,
      motivo:
        `REASIGNACIÓN YA SOLICITADA · `+
        `Pendiente de respuesta de ${pending.responsable_actual_nombre||r.responsable_actual||'responsable actual'}.`
    };
  });
}

function requestLatestStateDateValue(r){
  const responsible=norm(r?.responsable_actual||r?.responsable||'');
  const state=norm(
    r?.estado_operativo||
    r?.ultimo_estado||
    r?.estado||
    operationalStatus(r)||
    ''
  );

  const latestMovement=
    r?.fecha_ultimo_estado ||
    r?.ultimo_movimiento_fecha ||
    r?.fecha_ultimo_movimiento ||
    null;

  // 1. DERIVACIONES activas
  if(
    r?._instruction_active ||
    responsible==='INSTRUCCIÓN' ||
    responsible==='INSTRUCCION' ||
    state==='DERIVADO A INSTRUCCIÓN' ||
    state==='DERIVADO A INSTRUCCION'
  ){
    return (
      r?.fecha_derivacion_instruccion ||
      r?._instruction_fecha_derivacion ||
      latestMovement ||
      null
    );
  }

  if(
    responsible==='DVC' ||
    state==='DERIVADO A LA DVC' ||
    state==='DERIVADO A DVC'
  ){
    return (
      r?.fecha_derivacion_dvc ||
      r?.fecha_derivacion ||
      latestMovement ||
      null
    );
  }

  if(
    responsible==='ELEVADO AL CONAS' ||
    state==='DERIVADO AL CONAS' ||
    state==='DERIVADO A CONAS'
  ){
    return (
      r?.fecha_derivacion_conas ||
      r?.fecha_derivacion ||
      latestMovement ||
      null
    );
  }

  // 2. RETORNOS / DEVOLUCIONES
  if(
    state==='RETORNO DE INSTRUCCIÓN' ||
    state==='RETORNO DE INSTRUCCION'
  ){
    return (
      r?.fecha_retorno_instruccion ||
      r?.fecha_devolucion ||
      latestMovement ||
      r?.updated_at ||
      null
    );
  }

  if(
    state==='DEVUELTO AL ARCHIVO' ||
    state==='DEVUELTO' ||
    state==='CUSTODIA'
  ){
    return (
      r?.fecha_devolucion ||
      r?.fecha_ultimo_estado ||
      latestMovement ||
      r?.fecha_reasignacion ||
      r?.fecha_custodia_actual ||
      null
    );
  }

  if(state==='DEVOLUCIÓN SOLICITADA'){
    return (
      r?.fecha_solicitud_devolucion ||
      r?.fecha_devolucion_solicitada ||
      r?.fecha_ultimo_estado ||
      latestMovement ||
      null
    );
  }

  // 3. REASIGNACIÓN
  if(state==='REASIGNADO'){
    return (
      r?.fecha_ultima_reasignacion ||
      r?.fecha_reasignacion ||
      r?.fecha_ultimo_estado ||
      latestMovement ||
      null
    );
  }

  // 4. PRÉSTAMO vigente
  if(state==='EN PRÉSTAMO'){
    return (
      r?.fecha_entrega ||
      r?.fecha_entrega_prestamo ||
      r?.fecha_ultima_entrega_prestamo ||
      r?.fecha_ultimo_estado ||
      latestMovement ||
      null
    );
  }

  // 5. PENDIENTE POR ATENDER / solicitud recién ingresada
  if(
    state==='PENDIENTE POR ATENDER' ||
    state==='SOLICITADO' ||
    state==='ACEPTADO'
  ){
    return (
      r?.fecha_solicitud ||
      r?.fecha_atencion ||
      latestMovement ||
      null
    );
  }

  // Respaldo para estados no previstos.
  return (
    latestMovement ||
    r?.updated_at ||
    r?.fecha_devolucion ||
    r?.fecha_ultima_reasignacion ||
    r?.fecha_reasignacion ||
    r?.fecha_entrega ||
    r?.fecha_solicitud ||
    r?.fecha_custodia_actual ||
    null
  );
}

function requestLatestStateLabel(r){
  const state=norm(
    r?.estado_operativo||
    r?.ultimo_estado||
    r?.estado||
    operationalStatus(r)||
    ''
  );

  if(
    state==='DERIVADO A INSTRUCCIÓN' ||
    state==='DERIVADO A INSTRUCCION'
  )return 'Derivado a Instrucción';

  if(
    state==='DERIVADO A LA DVC' ||
    state==='DERIVADO A DVC'
  )return 'Derivado a la DVC';

  if(
    state==='DERIVADO AL CONAS' ||
    state==='DERIVADO A CONAS'
  )return 'Derivado al CONAS';

  if(
    state==='RETORNO DE INSTRUCCIÓN' ||
    state==='RETORNO DE INSTRUCCION'
  )return 'Retorno de Instrucción';

  if(
    state==='DEVUELTO AL ARCHIVO' ||
    state==='DEVUELTO' ||
    state==='CUSTODIA'
  )return 'Devuelto al Archivo';

  if(state==='DEVOLUCIÓN SOLICITADA')
    return 'Devolución solicitada';

  if(state==='REASIGNADO')
    return 'Reasignado';

  if(state==='EN PRÉSTAMO')
    return 'En préstamo';

  if(state==='PENDIENTE POR ATENDER')
    return 'Pendiente por atender';

  return state||'Último estado';
}

function requestCustodyDateValue(r){
  // Se conserva el nombre por compatibilidad con otras partes del sistema,
  // pero desde ahora devuelve la FECHA DEL ÚLTIMO ESTADO.
  return requestLatestStateDateValue(r);
}

function requestConasDateValue(r){
  return (
    r?.fecha_derivacion_conas ||
    r?.fecha_derivacion ||
    null
  );
}

function requestDvcDateValue(r){
  return (
    r?.fecha_derivacion_dvc ||
    r?.fecha_derivacion ||
    null
  );
}

function requestInstructionDateValue(r){
  return (
    r?.fecha_derivacion_instruccion ||
    r?._instruction_fecha_derivacion ||
    null
  );
}

function requestCustodyDateHtml(r){
  const date=requestLatestStateDateValue(r);
  const label=requestLatestStateLabel(r);
  const state=norm(
    r?.estado_operativo||
    r?.ultimo_estado||
    r?.estado||
    operationalStatus(r)||
    ''
  );

  if(!date){
    return `<span class="request-date-context">${esc(label)}: <b>—</b></span>`;
  }

  let cls='';

  if(
    state==='DERIVADO A INSTRUCCIÓN' ||
    state==='DERIVADO A INSTRUCCION'
  ){
    cls=' instruction-date';
  }else if(
    state==='DERIVADO A LA DVC' ||
    state==='DERIVADO A DVC'
  ){
    cls=' dvc-date';
  }else if(
    state==='DERIVADO AL CONAS' ||
    state==='DERIVADO A CONAS'
  ){
    cls=' conas-date';
  }

  return `<span class="request-date-context${cls}">
    ${esc(label)}: <b>${fmtDate(date)}</b>
  </span>`;
}


function requestMovementState(m){
  const action=norm(m?.accion||'');
  const state=norm(m?.estado||'');

  if(
    action.includes('RETORNO DE INSTRUCCIÓN') ||
    action.includes('RETORNO DE INSTRUCCION')
  )return 'RETORNO DE INSTRUCCIÓN';

  if(
    action.includes('DERIVADO A INSTRUCCIÓN') ||
    action.includes('DERIVADO A INSTRUCCION')
  )return 'DERIVADO A INSTRUCCIÓN';

  if(
    action.includes('RETORNO DE DVC') ||
    action.includes('RETORNO DVC')
  )return 'DEVUELTO AL ARCHIVO';

  if(
    action.includes('DERIVADO A LA DVC') ||
    action.includes('DERIVADO A DVC')
  )return 'DERIVADO A LA DVC';

  if(
    action.includes('RETORNO DE CONAS') ||
    action.includes('RETORNO CONAS')
  )return 'DEVUELTO AL ARCHIVO';

  if(
    action.includes('DERIVADO AL CONAS') ||
    action.includes('DERIVADO A CONAS')
  )return 'DERIVADO AL CONAS';

  if(
    action.includes('DEVOLUCIÓN CONFIRMADA') ||
    action.includes('DEVOLUCION CONFIRMADA') ||
    action.includes('RECIBIDO EN ARCHIVO') ||
    action.includes('DEVUELTO AL ARCHIVO')
  )return 'DEVUELTO AL ARCHIVO';

  if(
    action.includes('DEVOLUCIÓN SOLICITADA') ||
    action.includes('DEVOLUCION SOLICITADA')
  )return 'DEVOLUCIÓN SOLICITADA';

  if(
    action.includes('REASIGNACIÓN') ||
    action.includes('REASIGNACION')
  )return 'REASIGNADO';

  if(
    action.includes('CARGO GENERADO') ||
    action.includes('ENTREGA EN PRÉSTAMO') ||
    action.includes('ENTREGA EN PRESTAMO') ||
    action.includes('ATENDIDO CON CARGO') ||
    action.includes('EN PRÉSTAMO') ||
    action.includes('EN PRESTAMO')
  )return 'EN PRÉSTAMO';

  // Algunos movimientos antiguos guardaban el estado directamente.
  if(state==='DEVUELTO')return 'DEVUELTO AL ARCHIVO';
  if(state==='DEVOLUCIÓN SOLICITADA')return 'DEVOLUCIÓN SOLICITADA';
  if(state==='REASIGNADO')return 'REASIGNADO';
  if(state==='EN PRÉSTAMO')return 'EN PRÉSTAMO';

  return '';
}

// V793 · Estado de la búsqueda: último cambio OPERATIVO del expediente.
// No se modifica el estado físico ni el historial: se consulta la bitácora
// existente, que ya se carga para resolver las fechas de esta búsqueda.
let v793LookupRefreshTimer=null;
function requestLookupLiveStateUpdateV793(payload){
  const table=String(payload?.table||'');
  if(!['expedientes','movimientos_prestamo','solicitud_expedientes'].includes(table))return;
  const id=String(
    table==='expedientes'?(payload?.new?.id||payload?.old?.id):
    (payload?.new?.expediente_id||payload?.old?.expediente_id)
  ||'');
  if(!id)return;
  // Las búsquedas anteriores no deben conservar un estado obsoleto hasta
  // el vencimiento de la caché normal de 30 segundos.
  for(const [key,item] of v187RequestLookupCache){
    if((item?.rows||[]).some(x=>String(x?.id||'')===id))
      v187RequestLookupCache.delete(key);
  }
  if(!el('requestSearchModal')?.classList.contains('show'))return;
  if(!(requestSearchRows||[]).some(x=>String(x?.id||'')===id))return;
  clearTimeout(v793LookupRefreshTimer);
  v793LookupRefreshTimer=setTimeout(async()=>{
    if(!sb||!session||!el('requestSearchModal')?.classList.contains('show'))return;
    const version=requestLookupSequence;
    const currentRows=(requestSearchRows||[]).slice();
    try{
      const refreshed=await enrichRequestCustodyContext(currentRows);
      if(version!==requestLookupSequence||
         !el('requestSearchModal')?.classList.contains('show'))return;
      const byId=new Map(refreshed.map(r=>[String(r?.id||''),r]));
      requestSearchRows=requestSearchRows.map(r=>{
        const latest=byId.get(String(r?.id||''));
        if(!latest)return r;
        return {...r,
          _v793_estado_ultimo_movimiento:latest._v793_estado_ultimo_movimiento,
          _v793_fecha_movimiento_operativo:latest._v793_fecha_movimiento_operativo,
          ultimo_estado:latest.ultimo_estado||r.ultimo_estado,
          // Fuente y presentación de la fecha existente se conservan.
          fecha_ultimo_estado:latest.fecha_ultimo_estado||r.fecha_ultimo_estado
        };
      });
      renderRequestLookupResults();
    }catch(err){console.warn('V793 · actualización del estado:',err?.message||err);}
  },650);
}

function requestMovementStateV793(m){
  const clean=v=>String(v||'').trim().toUpperCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g,'');
  const action=clean(m?.accion), recorded=clean(m?.estado);
  if(action.includes('CIERRE ADMINISTRATIVO') || recorded==='CERRADO POR ADMINISTRADOR')
    return 'CERRADO POR ADMINISTRADOR';
  if(action.includes('RETORNO DE INSTRUCCION'))return 'RETORNO DE INSTRUCCIÓN';
  if(action.includes('RETORNO DE DVC') || action.includes('RETORNO DE CONAS'))
    return 'DEVUELTO AL ARCHIVO';
  if(action.includes('DERIVADO A INSTRUCCION'))return 'DERIVADO A INSTRUCCIÓN';
  if(action.includes('DERIVADO A LA DVC'))return 'DERIVADO A LA DVC';
  if(action.includes('DERIVADO AL CONAS'))return 'DERIVADO AL CONAS';
  if(action.includes('DEVOLUCION CONFIRMADA') || action.includes('RECIBIDO EN ARCHIVO') ||
     action==='DEVUELTO AL ARCHIVO')return 'DEVUELTO AL ARCHIVO';
  if(action.includes('DEVOLUCION SOLICITADA'))return 'DEVOLUCIÓN SOLICITADA';
  // Pedir una reasignación no equivale a ejecutarla.
  if(action.includes('REASIGN') && !action.includes('SOLICITUD') &&
     !action.includes('SOLICITADA'))return 'REASIGNADO';
  if(action.includes('CARGO GENERADO') || action.includes('ENTREGA EN PRESTAMO') ||
     action.includes('ATENDIDO CON CARGO') || action==='EN PRESTAMO')return 'EN PRÉSTAMO';
  if(action.includes('INCORPORACION AL REGISTRO MAESTRO') ||
     action.includes('ENVIO DE LISTADO A SAN LUIS'))return 'CUSTODIA';
  // Actualizaciones de folios, observaciones y trámites no cambian el estado.
  return '';
}

function requestLatestStateValueV793(r){
  const canonical=String(r?.estado_operativo||r?.ultimo_estado||r?.estado||'').trim();
  const normal=v=>String(v||'').trim().toUpperCase().normalize('NFD')
    .replace(/[\u0300-\u036f]/g,'');
  const current=normal(canonical);
  const last=String(r?._v793_estado_ultimo_movimiento||'').trim();

  // Un retorno o una derivación vigente prevalece cuando su flujo especial
  // ya comprobó la custodia; nunca reutilizar un préstamo histórico.
  if(r?._instruction_active || r?._referralDestination){
    return canonical||last||'—';
  }
  if(current==='CERRADO POR ADMINISTRADOR' || current==='CERRADA POR ADMINISTRADOR')
    return 'CERRADO POR ADMINISTRADOR';
  // Si otra fuente ha confirmado la devolución pero la bitácora consultable
  // aún no la refleja, no presentar engañosamente una custodia anterior.
  if(current==='DEVUELTO' || current==='DEVUELTO AL ARCHIVO'){
    if(!last || ['REASIGNADO','EN PRÉSTAMO','DERIVADO AL CONAS',
                  'DERIVADO A LA DVC','DERIVADO A INSTRUCCIÓN'].includes(last))
      return 'DEVUELTO AL ARCHIVO';
  }
  if(current==='DEVOLUCION SOLICITADA' && last!=='DEVOLUCIÓN SOLICITADA' &&
     last!=='DEVUELTO AL ARCHIVO')return 'DEVOLUCIÓN SOLICITADA';
  // La diferencia principal: después de una reasignación el estado maestro
  // sigue siendo EN PRÉSTAMO porque permanece fuera de Archivo. Mostrar en
  // esta columna REASIGNADO según el último traslado efectivo.
  if(last)return last;
  if(current==='DEVUELTO')return 'DEVUELTO AL ARCHIVO';
  if(current==='CERRADA POR ADMINISTRADOR')return 'CERRADO POR ADMINISTRADOR';
  return canonical||'—';
}

function requestLatestStateHtmlV793(r){
  const value=requestLatestStateValueV793(r);
  const key=String(value||'').trim().toUpperCase();
  const cls=key==='EN PRÉSTAMO'?'loan':
    key==='REASIGNADO'?'reassigned':
    key==='DEVUELTO AL ARCHIVO'||key==='DEVUELTO'?'returned-archive':
    key==='DEVOLUCIÓN SOLICITADA'?'return-requested':
    key==='DERIVADO AL CONAS'?'conas':
    key==='DERIVADO A LA DVC'?'dvc':
    key==='DERIVADO A INSTRUCCIÓN'?'instruction':
    key==='RETORNO DE INSTRUCCIÓN'?'instruction-return':
    key==='CERRADO POR ADMINISTRADOR'?'returned':'';
  return `<span class="pill ${cls}">${esc(stateDisplayName(value))}</span>`;
}

function requestMovementDateForCurrentState(r,movements){
  const current=norm(
    r?.estado_operativo||
    r?.ultimo_estado||
    r?.estado||
    operationalStatus(r)||
    ''
  );

  const normalizedCurrent=
    current==='DEVUELTO' || current==='CUSTODIA'
      ?'DEVUELTO AL ARCHIVO'
      :current;

  // Primero buscar el movimiento más reciente que produjo exactamente
  // el estado que hoy vemos en pantalla.
  const exact=(movements||[]).find(m=>
    requestMovementState(m)===normalizedCurrent &&
    m?.created_at
  );

  if(exact)return exact.created_at;

  // Respaldo: último movimiento que sí represente un cambio operativo.
  const operational=(movements||[]).find(m=>
    requestMovementState(m) && m?.created_at
  );

  return operational?.created_at||null;
}

function requestCurrentCustodianV120(state,owner){
  // Una devolución aceptada termina la custodia del prestatario anterior.
  // Una mera solicitud de devolución todavía conserva al custodio actual.
  const physicalState=norm(state||'');
  if(['DEVUELTO AL ARCHIVO','DEVUELTO'].includes(physicalState))return 'ARCHIVO';
  return owner||null;
}

async function enrichRequestCustodyContext(rows){
  if(!Array.isArray(rows) || !rows.length || !sb || !session)return rows||[];

  const ids=[...new Set(rows.map(r=>r?.id).filter(Boolean))];
  if(!ids.length)return rows;

  // V627 · Estas seis consultas son independientes.
  // Antes se ejecutaban una después de otra; ahora se ejecutan simultáneamente.
  const [
    secureResult,
    contextResult,
    masterResult,
    linksResult,
    movementResult,
    custodyV627Result
  ]=await Promise.allSettled([

    sb.rpc(
      'obtener_fechas_operativas_expedientes',
      {p_expediente_ids:ids}
    ),

    sb.rpc(
      'obtener_contexto_custodia_expedientes',
      {p_expediente_ids:ids}
    ),

    sb
      .from('expedientes')
      .select('id,fecha_entrega,fecha_devolucion,fecha_reasignacion,updated_at')
      .in('id',ids),

    sb
      .from('solicitud_expedientes')
      .select('expediente_id,estado,fecha_entrega,fecha_solicitud_devolucion,fecha_devolucion,updated_at')
      .in('expediente_id',ids)
      .order('updated_at',{ascending:false}),

    sb
      .from('movimientos_prestamo')
      .select('expediente_id,accion,estado,created_at')
      .in('expediente_id',ids)
      .order('created_at',{ascending:false}),

    sb.rpc('v627_fechas_custodia_actual',{p_expediente_ids:ids})
  ]);

  const unwrapV187=(result,label)=>{
    if(result.status!=='fulfilled'){
      console.warn(label,result.reason?.message||result.reason);
      return [];
    }

    const response=result.value||{};
    if(response.error){
      console.warn(label,response.error.message);
      return [];
    }

    return response.data||[];
  };

  const secureDateRows=unwrapV187(
    secureResult,
    'obtener_fechas_operativas_expedientes:'
  );

  const contextRows=unwrapV187(
    contextResult,
    'obtener_contexto_custodia_expedientes:'
  );

  const masterRows=unwrapV187(
    masterResult,
    'fechas expediente maestro:'
  );

  const links=unwrapV187(
    linksResult,
    'fechas solicitud-expediente:'
  );

  const movementRows=unwrapV187(
    movementResult,
    'movimientos para fecha último estado:'
  );

  const custodyRowsV627=unwrapV187(
    custodyV627Result,
    'v627_fechas_custodia_actual:'
  );

  const custodyMapV627=new Map(
    custodyRowsV627.map(x=>[String(x.expediente_id||''),x])
  );

  const secureDateMap=new Map(
    secureDateRows.map(
      x=>[String(x.expediente_id||''),x]
    )
  );
  const contextMap=new Map(
    contextRows.map(x=>[String(x.expediente_id),x])
  );
  const masterMap=new Map(
    masterRows.map(x=>[String(x.id),x])
  );
  const latestLinkMap=new Map();

  (links||[]).forEach(x=>{
    const key=String(x.expediente_id||'');
    if(key && !latestLinkMap.has(key)){
      latestLinkMap.set(key,x);
    }
  });
  const movementMap=new Map();

  (movementRows||[]).forEach(m=>{
    const key=String(m.expediente_id||'');
    if(!key)return;

    if(!movementMap.has(key)){
      movementMap.set(key,[]);
    }

    movementMap.get(key).push(m);
  });

  return rows.map(r=>{
    const key=String(r.id||'');
    const ctx=contextMap.get(key)||{};
    const master=masterMap.get(key)||{};
    const link=latestLinkMap.get(key)||{};
    const movements=movementMap.get(key)||[];
    // V793: resolver el último movimiento que sí cambió el estado.
    // Ignorar cambios de folio, observaciones y ediciones administrativas.
    const ultimoMovimientoOperativoV793=movements.find(m=>
      m?.created_at && requestMovementStateV793(m)
    )||null;
    const secure=secureDateMap.get(key)||{};
    const custodyV627=custodyMapV627.get(key)||{};

    const linkState=norm(link.estado||'');

    const currentOperationalState=norm(
      ctx.ultimo_estado||
      r.ultimo_estado||
      operationalStatus(r)||
      link.estado||
      r.estado||
      ''
    );

    let secureCurrentStateDate=null;

    if(currentOperationalState==='EN PRÉSTAMO'){
      secureCurrentStateDate=secure.fecha_en_prestamo||null;
    }else if(currentOperationalState==='REASIGNADO'){
      secureCurrentStateDate=secure.fecha_reasignado||null;
    }else if(currentOperationalState==='DEVOLUCIÓN SOLICITADA'){
      secureCurrentStateDate=secure.fecha_devolucion_solicitada||null;
    }else if(
      currentOperationalState==='DEVUELTO AL ARCHIVO' ||
      currentOperationalState==='DEVUELTO' ||
      currentOperationalState==='CUSTODIA'
    ){
      secureCurrentStateDate=secure.fecha_devuelto_archivo||null;
    }else if(
      currentOperationalState==='DERIVADO AL CONAS' ||
      currentOperationalState==='DERIVADO A CONAS'
    ){
      secureCurrentStateDate=secure.fecha_derivado_conas||null;
    }else if(
      currentOperationalState==='DERIVADO A LA DVC' ||
      currentOperationalState==='DERIVADO A DVC'
    ){
      secureCurrentStateDate=secure.fecha_derivado_dvc||null;
    }else if(
      currentOperationalState==='DERIVADO A INSTRUCCIÓN' ||
      currentOperationalState==='DERIVADO A INSTRUCCION'
    ){
      secureCurrentStateDate=secure.fecha_derivado_instruccion||null;
    }else if(
      currentOperationalState==='RETORNO DE INSTRUCCIÓN' ||
      currentOperationalState==='RETORNO DE INSTRUCCION'
    ){
      secureCurrentStateDate=secure.fecha_retorno_instruccion||null;
    }
    const movementStateDate=requestMovementDateForCurrentState(
      {
        ...r,
        ultimo_estado:
          ctx.ultimo_estado||
          r.ultimo_estado||
          link.estado||
          null
      },
      movements
    );

    // Hora real de la entrega en préstamo. En registros donde fecha_entrega
    // conserva solo YYYY-MM-DD, recuperar el timestamp del movimiento que
    // produjo EN PRÉSTAMO para mostrar también la hora en pantalla.
    const loanMovementDate=(movements||[]).find(m=>
      requestMovementState(m)==='EN PRÉSTAMO' && m?.created_at
    )?.created_at||null;

    // La fecha/hora del préstamo debe provenir del ciclo vigente y priorizar
    // una fuente que conserve timestamp completo.
    const fechaEntrega=
      secure.fecha_en_prestamo ||
      loanMovementDate ||
      link.fecha_entrega ||
      master.fecha_entrega ||
      r.fecha_entrega ||
      r.fecha_entrega_prestamo ||
      null;

    const fechaDevolucion=
      secure.fecha_devuelto_archivo ||
      link.fecha_devolucion ||
      master.fecha_devolucion ||
      r.fecha_devolucion ||
      null;

    const fechaReasignacion=
      secure.fecha_reasignado ||
      master.fecha_reasignacion ||
      r.fecha_ultima_reasignacion ||
      r.fecha_reasignacion ||
      (linkState==='REASIGNADO' ? link.updated_at : null) ||
      null;

    const fechaSolicitudDevolucion=
      secure.fecha_devolucion_solicitada ||
      link.fecha_solicitud_devolucion ||
      r.fecha_solicitud_devolucion ||
      r.fecha_devolucion_solicitada ||
      null;

    // Para estados que no poseen una columna propia, updated_at del vínculo
    // más reciente funciona como respaldo del último movimiento operativo.
    const fechaUltimoEstado=
      // Prioridad 1: RPC segura, válida también para perfil USUARIO.
      secureCurrentStateDate ||

      // Prioridad 2: movimiento real cuando el perfil puede consultarlo.
      movementStateDate ||

      // Prioridad 3: RPC/contexto general.
      ctx.fecha_ultimo_estado ||

      // Prioridad 3: columnas específicas.
      (linkState==='EN PRÉSTAMO' ? fechaEntrega : null) ||
      (linkState==='DEVOLUCIÓN SOLICITADA' ? fechaSolicitudDevolucion : null) ||
      (linkState==='DEVUELTO' ? fechaDevolucion : null) ||
      (linkState==='REASIGNADO' ? fechaReasignacion : null) ||

      // Respaldo.
      link.updated_at ||
      master.updated_at ||
      r.fecha_ultimo_estado ||
      null;

    return {
      ...r,
      _v793_estado_ultimo_movimiento:ultimoMovimientoOperativoV793
        ?requestMovementStateV793(ultimoMovimientoOperativoV793):null,
      _v793_fecha_movimiento_operativo:ultimoMovimientoOperativoV793?.created_at||null,

      responsable_actual:requestCurrentCustodianV120(
        r.estado_operativo || currentOperationalState,
        ctx.responsable_actual || r.responsable_actual || r.responsable || null
      ),

      // Fechas reales que utiliza requestLatestStateDateValue().
      fecha_entrega:fechaEntrega,
      fecha_entrega_prestamo:fechaEntrega,
      fecha_devolucion:fechaDevolucion,
      fecha_reasignacion:fechaReasignacion,
      fecha_ultima_reasignacion:fechaReasignacion,
      fecha_solicitud_devolucion:fechaSolicitudDevolucion,

      fecha_inicio_custodia_vigente:
        custodyV627.fecha_inicio_custodia ||
        r.fecha_inicio_custodia_vigente ||
        r.fecha_inicio_custodia ||
        ctx.fecha_custodia_actual ||
        fechaReasignacion ||
        fechaEntrega ||
        null,

      fecha_inicio_custodia:
        custodyV627.fecha_inicio_custodia ||
        r.fecha_inicio_custodia ||
        ctx.fecha_custodia_actual ||
        fechaReasignacion ||
        fechaEntrega ||
        null,

      fecha_custodia_actual:
        custodyV627.fecha_inicio_custodia ||
        ctx.fecha_custodia_actual ||
        r.fecha_custodia_actual ||
        fechaReasignacion ||
        fechaEntrega ||
        null,

      movimiento_inicio_custodia:
        custodyV627.movimiento_custodia ||
        r.movimiento_inicio_custodia ||
        '',
      custodia_desde:custodyV627.desde||r.custodia_desde||'',
      custodia_hacia:custodyV627.hacia||r.custodia_hacia||'',
      dias_custodia:Number.isFinite(Number(custodyV627.dias_habiles))
        ?Number(custodyV627.dias_habiles)
        :(r.dias_custodia??null),

      fecha_derivacion_conas:
        secure.fecha_derivado_conas ||
        ctx.fecha_derivacion_conas ||
        r.fecha_derivacion_conas ||
        null,

      fecha_derivacion_dvc:
        secure.fecha_derivado_dvc ||
        ctx.fecha_derivacion_dvc ||
        r.fecha_derivacion_dvc ||
        null,

      fecha_derivacion_instruccion:
        secure.fecha_derivado_instruccion ||
        r.fecha_derivacion_instruccion ||
        null,

      fecha_retorno_instruccion:
        secure.fecha_retorno_instruccion ||
        r.fecha_retorno_instruccion ||
        null,

      fecha_ultimo_estado:fechaUltimoEstado,
      ultimo_estado:
        ctx.ultimo_estado ||
        r.ultimo_estado ||
        link.estado ||
        null
    };
  });
}

async function annotateInstructionReturnEligibility(rows){
  if(!Array.isArray(rows) || !rows.length || !hasFullAccess()){
    return rows||[];
  }

  const ids=new Set(
    rows.map(r=>String(r?.id||'')).filter(Boolean)
  );

  if(!ids.size)return rows;

  const searchNumbers=[...new Set(
    rows.map(r=>String(r?.expediente||'').trim()).filter(Boolean)
  )];

  const targetedSearch=
    searchNumbers.length===1
      ?searchNumbers[0]
      :null;

  const {data,error}=await sb.rpc(
    'listar_derivados_instruccion',
    {p_busqueda:targetedSearch}
  );

  if(error){
    console.warn(
      'listar_derivados_instruccion en búsqueda:',
      error.message
    );
    return rows;
  }

  const map=new Map(
    (data||[])
      .filter(x=>ids.has(String(x.expediente_id||'')))
      .map(x=>[String(x.expediente_id),x])
  );

  return rows.map(r=>{
    const mi=map.get(String(r.id||''));

    if(!mi)return r;

    return {
      ...r,

      // Mientras siga físicamente en Instrucción no es una solicitud
      // normal. Archivo debe registrar primero el retorno.
      disponible:false,
      motivo:'RETORNO DE INSTRUCCIÓN PENDIENTE DE RECEPCIÓN',

      responsable_actual:'INSTRUCCIÓN',
      estado_operativo:'DERIVADO A INSTRUCCIÓN',

      _instruction_active:true,
      _instruction_movimiento_id:mi.movimiento_instruccion_id,
      _instruction_ciclo:Number(mi.ciclo_numero||1),
      _instruction_fecha_derivacion:mi.fecha_derivacion||null,
      fecha_derivacion_instruccion:mi.fecha_derivacion||null,
      _instruction_dias:Number(mi.dias_en_instruccion||0),
      _instruction_folio:mi.ultimo_folio_derivacion||r.ultimo_folio||null,
      _instruction_origen:mi.responsable_origen||null,
      _instruction_cargo:mi.cargo_origen||null
    };
  });
}


function isDirectReassignCustodianRoleV236(role){
  // V481 · Un miembro de ARCHIVO puede tener custodia personal de un
  // expediente y, en ese caso, también puede recibir una solicitud
  // de reasignación directa.
  return ['USUARIO','COORDINADOR','ARCHIVO'].includes(norm(role||''));
}

function custodianProfileByNameV236(name){
  const key=norm(name||'');
  if(!key)return null;

  const profile=(reassignmentProfiles||[]).find(
    x=>norm(x.nombre_personal||'')===key
  );

  if(profile && isDirectReassignCustodianRoleV236(profile.rol)){
    return profile;
  }

  // El catálogo sigue siendo respaldo para mostrar el expediente en la búsqueda.
  return catalogPersonByName(name)||null;
}

function canRequestDirectReassignV466(){
  if(!currentProfile || currentProfile.activo===false)return false;
  const role=norm(currentProfile.rol||'');
  // V794: el Administrador también puede iniciar una reasignación a nombre
  // del destinatario elegido; Supabase valida y guarda al solicitante real.
  // No se modifican los permisos de préstamo ni de los módulos restantes.
  return isLimitedUser() || role==='ARCHIVO' || role==='COORDINADOR' || role==='ADMINISTRADOR';
}

async function annotateInternalReassignEligibility(rows){
  if(!canRequestDirectReassignV466() || !Array.isArray(rows) || !rows.length)return rows||[];

  // V827 · El perfil Administrador clasifica la custodia usando el mismo
  // control de Supabase que se vuelve a ejecutar al pulsar Enviar.
  // No debe depender de la elegibilidad calculada para el usuario solicitante.
  if(norm(currentProfile?.rol||'')==='ADMINISTRADOR'){
    const destino=String(el('rqSolicitante')?.value||'').trim();
    const modalidad=String(el('rqModalidad')?.value||'PRÉSTAMO').trim();
    const ids=[...new Set(rows.map(x=>String(x?.id||'')).filter(Boolean))];
    if(ids.length && destino){
      try{
        const controles=[];
        for(let i=0;i<ids.length;i+=50){
          const {data,error}=await sb.rpc('v827_revisar_solicitud_admin',{
            p_expediente_ids:ids.slice(i,i+50),
            p_destinatario_nombre:destino,p_modalidad:modalidad
          });
          if(error || !data?.ok || !Array.isArray(data.casos)){
            throw new Error(error?.message||'Verificación de custodia no disponible');
          }
          controles.push(...data.casos);
        }
        const mapa=new Map(controles.map(x=>[String(x.expediente_id),x]));
        return rows.map(r=>{
          if(!r?.id)return r;
          const x=mapa.get(String(r.id));
          if(!x)return {...r,disponible:false,motivo:'No se verificó la custodia de este expediente.'};
          const reasignar=x.ruta==='REASIGNACION';
          const archive=x.ruta==='ARCHIVO';
          return {...r,
            disponible:reasignar||archive,
            solicitud_interna:reasignar,
            solicitud_otra_area:false,
            usar_reasignacion_interna:reasignar,
            _v792_reasignacion_validada:reasignar,
            responsable_actual:x.responsable_actual||r.responsable_actual||r.responsable,
            area_trabajo:x.area_trabajo||r.area_trabajo,
            motivo:x.motivo||r.motivo,
            _v827_ruta:x.ruta
          };
        });
      }catch(err){
        console.warn('V827 · verificación de custodia Administrador:',err?.message||err);
        return rows.map(r=>r?.id?{...r,disponible:false,
          motivo:'No fue posible verificar la custodia en Supabase. Actualice la búsqueda antes de registrar.'}:r);
      }
    }
  }

  const ids=[...new Set(rows.map(x=>x.id).filter(Boolean))];
  if(!ids.length)return rows;

  // Se conserva el RPC existente como fuente de apoyo, pero la regla V190
  // ya no depende de que ambos usuarios pertenezcan a la misma área.
  let evalMap=new Map();

  try{
    const {data,error}=await sb.rpc('evaluar_reasignacion_interna',{
      p_expediente_ids:ids
    });

    if(error){
      console.warn('evaluar_reasignacion_interna:',error.message);
    }else{
      evalMap=new Map((data||[]).map(x=>[String(x.expediente_id),x]));
    }
  }catch(err){
    console.warn('evaluar_reasignacion_interna:',err?.message||err);
  }

  const currentName=String(currentProfile?.nombre_personal||'').trim();

  return rows.map(r=>{
    const ev=evalMap.get(String(r.id));

    const ownerName=String(
      ev?.responsable_actual||
      r.responsable_actual||
      r.responsable||
      ''
    ).trim();

    const ownerPerson=custodianProfileByNameV236(ownerName);
    const ownerArea=String(
      ev?.area_trabajo||
      ownerPerson?.area_trabajo||
      ''
    ).trim();

    // V422 · ARCHIVO no es un custodio personal para efectos de reasignación.
    // Si el expediente ya está DEVUELTO AL ARCHIVO, limpiar cualquier marca
    // proveniente del RPC/catalogo que pudiera clasificarlo como reasignación.
    if(isReturnedToArchiveForNewRequestV422({
      ...r,
      responsable_actual:ownerName||r.responsable_actual||r.responsable||null
    })){
      return {
        ...r,
        solicitud_interna:false,
        solicitud_otra_area:false,
        usar_reasignacion_interna:false,
        responsable_actual:'ARCHIVO',
        area_trabajo:null,
        motivo:r.motivo||'DISPONIBLE · Expediente devuelto al Archivo. Corresponde una nueva solicitud normal.'
      };
    }

    const anotherUser=
      !!r?.id &&
      !!currentName &&
      !!ownerName &&
      norm(ownerName)!==norm(currentName) &&
      !!ownerPerson;

    // V190:
    // Si el expediente está físicamente con OTRO USUARIO O COORDINADOR, sin importar el área,
    // NO se genera una solicitud normal.
    // Se crea una solicitud de reasignación directa al custodio actual.
    // V792: si Supabase evaluó el expediente, respetar su decisión.
    // EN PRÉSTAMO es el requisito físico de la reasignación, no un bloqueo.
    // El evaluador valida también el préstamo vigente, la identidad del
    // custodio, los roles y la ausencia de otra reasignación pendiente.
    const backendRespondio=!!ev && typeof ev.elegible==='boolean';
    const autorizado=backendRespondio ? ev.elegible===true : anotherUser;
    const custodioDiferente=!!r.id && !!currentName && !!ownerName &&
      norm(ownerName)!==norm(currentName);
    if(autorizado && custodioDiferente &&
       !r._referralDestination && !r._instruction_active &&
       !r._activeLookupFailed){
      return {
        ...r,
        disponible:true,
        solicitud_interna:true,
        solicitud_otra_area:false,
        usar_reasignacion_interna:true,
        _v792_reasignacion_validada:true,
        area_trabajo:ownerArea||ev?.area_trabajo||null,
        responsable_actual:ownerName||ev?.responsable_actual||r.responsable_actual||null,
        motivo:`REQUIERE REASIGNACIÓN · Actualmente con ${ownerName}. No se genera préstamo del Archivo.`
      };
    }

    return {
      ...r,
      solicitud_interna:false,
      solicitud_otra_area:false,
      usar_reasignacion_interna:false,
      _v792_reasignacion_validada:false,
      _v792_motivo_reasignacion:ev?.motivo||null
    };
  });
}

async function splitInternalReassignItems(cleanItems,modalidad){
  if(!canRequestDirectReassignV466() || modalidad!=='PRÉSTAMO'){
    return {internal:[],normal:cleanItems};
  }

  const ids=[...new Set(cleanItems.map(x=>x.id).filter(Boolean))];

  if(!ids.length){
    return {internal:[],normal:cleanItems};
  }

  let eligibleIds=new Set();
  const evaluatedIdsV792=new Set();
  const deniedIdsV792=new Map();

  // V792 · Volver a validar en Supabase antes del envío. Si la RPC
  // responde NO ELEGIBLE no crear un préstamo normal como alternativa.
  try{
    const {data,error}=await sb.rpc('evaluar_reasignacion_interna',{
      p_expediente_ids:ids
    });

    if(!error){
      (data||[]).forEach(x=>{
        const id=String(x.expediente_id||'');
        if(!id)return;
        evaluatedIdsV792.add(id);
        if(x.elegible){eligibleIds.add(id);}
        else{deniedIdsV792.set(id,x.motivo||'La reasignación todavía no puede registrarse.');}
      });
    }else{
      console.warn('evaluar_reasignacion_interna:',error.message);
    }
  }catch(err){
    console.warn('evaluar_reasignacion_interna:',err?.message||err);
  }

  // V422 · Si el expediente ya fue DEVUELTO AL ARCHIVO, cualquier
  // elegibilidad heredada del RPC debe descartarse antes de clasificar.
  cleanItems.forEach(item=>{
    if(item?.id && isReturnedToArchiveForNewRequestV422(item)){
      eligibleIds.delete(String(item.id));
      item.solicitud_interna=false;
      item.solicitud_otra_area=false;
      item.usar_reasignacion_interna=false;
      item.responsable_actual='ARCHIVO';
      item.area_trabajo=null;
    }
  });

  // V190 · Regla principal:
  // cualquier expediente bajo custodia de OTRO USUARIO O COORDINADOR se resuelve mediante
  // SOLICITUD DE REASIGNACIÓN, sin importar el área.
  const currentName=String(currentProfile?.nombre_personal||'').trim();

  cleanItems.forEach(item=>{
    if(isReturnedToArchiveForNewRequestV422(item))return;

    const ownerName=String(item?.responsable_actual||'').trim();
    const ownerPerson=custodianProfileByNameV236(ownerName);

    const anotherUser=
      !!item?.id &&
      !!currentName &&
      !!ownerName &&
      norm(ownerName)!==norm(currentName) &&
      !!ownerPerson;

    const expedienteId=String(item?.id||'');
    if(deniedIdsV792.has(expedienteId) && (anotherUser || item?.solicitud_interna)){
      throw new Error(`${item.expediente||'Expediente'}: ${deniedIdsV792.get(expedienteId)}. No se creó una nueva solicitud de préstamo.`);
    }
    // Cuando el evaluador no devolvió la fila, preservar el respaldo
    // histórico para una cuenta activa; la RPC de solicitud aún valida.
    if(anotherUser && !evaluatedIdsV792.has(expedienteId)){
      eligibleIds.add(expedienteId);
    }
  });

  const internal=cleanItems
    .filter(x=>x.id && eligibleIds.has(String(x.id)))
    .map(x=>({
      ...x,
      solicitud_interna:true,
      solicitud_otra_area:false,
      usar_reasignacion_interna:true,
      _direct_reassign:true
    }));

  // CAMBIO CLAVE V190:
  // Los expedientes que van por reasignación NO forman parte de una solicitud
  // normal y, por tanto, no ingresan a PENDIENTE POR ATENDER en Archivo.
  const normal=cleanItems.filter(
    x=>!x.id || !eligibleIds.has(String(x.id))
  );

  return {internal,normal};
}

// ============================================================
// FIN SOLICITUD INTERNA DE REASIGNACIÓN · MISMA ÁREA
// ============================================================

// V601 · Compatibilidad: la RPC histórica mis_notificaciones_reasignacion ya no
// existe en el proyecto actual. Mantener esta función como fuente local vacía evita
// cientos de POST 404 sin alterar las capas vigentes de tareas/reasignaciones V170/V483/V549.
async function loadNotifications(silent=false){
  if(!sb||!session)return [];
  notificationRows=[];
  notificationUnread=0;
  notificationsLoaded=true;
  try{ updateAlertsBadge(); }catch(_){ }
  if(el('alertsModal')?.classList.contains('show')){
    try{ renderNotifications(); }catch(_){ }
  }
  return notificationRows;
}

function renderNotifications(){
  const list=el('notificationsList');
  if(!list)return;

  const visibleNotificationRows=reassignmentAlertFilter==='unread'
    ?notificationRows.filter(row=>!row.leida)
    :notificationRows;
  document.querySelectorAll('[data-reassignment-alert-filter]').forEach(button=>{
    const active=button.dataset.reassignmentAlertFilter===reassignmentAlertFilter;
    button.classList.toggle('active',active);button.setAttribute('aria-pressed',String(active));
  });
  if(!visibleNotificationRows.length){
    list.innerHTML='<div class="empty">No hay alertas de reasignación.</div>';
    return;
  }

  list.innerHTML=visibleNotificationRows.map(n=>`
    <div class="notification-item ${n.leida?'':'unread'}">
      <div class="notification-head">
        <div>
          <div class="notification-title">${esc(n.titulo||'Expediente reasignado')}</div>
          <div class="notification-meta">
            ${fmtDate(n.created_at)}
            ${n.cargo_numero?' · Cargo '+esc(n.cargo_numero):''}
          </div>
        </div>
        ${n.leida
          ?'<span class="pill returned">LEÍDA</span>'
          :'<span class="pill alert">NUEVA</span>'}
      </div>

      <div class="notification-message">
        ${esc(n.mensaje||'')}
      </div>

      <div class="notification-meta" style="margin-top:7px">
        Expediente: <b>${esc(n.expediente||'—')}</b>
        ${n.extension?' · Ext.: '+esc(n.extension):''}
        ${n.desde?' · Desde: '+esc(n.desde):''}
        ${n.hacia?' · Hacia: '+esc(n.hacia):''}
      </div>

      <div class="notification-actions">
        ${!n.leida
          ?`<button class="btn secondary small"
              onclick="markNotificationRead('${n.id}')">
              Marcar como leída
            </button>`
          :''}

        ${n.expediente_id
          ?`<button class="btn small"
              onclick="openNotificationExpediente('${n.id}','${n.expediente_id}')">
              Gestionar expediente
            </button>`
          :''}
      </div>
    </div>
  `).join('');
}

async function openAlertsModal(){
  loadLocationAlerts();
  if(!session)return;

  el('alertsModal').classList.add('show');

  // V170 abre primero la bandeja unificada. Las listas legacy se cargan después
  // como compatibilidad, sin hacer esperar al usuario para ver sus tareas.
  const v170Ready=await loadV170Tasks(false,true);

  if(v170Ready){
    Promise.allSettled([
      loadNotifications(true),
      loadOperationalAlerts(true),
      loadArchiveDeliveryRequests(true),
      loadInternalReassignRequests(true),
      loadCrossAreaWaits(true)
    ]).then(()=>{
      if(!el('alertsModal')?.classList.contains('show'))return;
      renderNotifications();
      renderOperationalAlerts();
      renderArchiveDeliveryRequests();
      renderInternalReassignRequests();
      renderCrossAreaWaitAlerts();
      updateAlertsBadge();
    });
    return;
  }

  if(el('notificationsList'))el('notificationsList').innerHTML='<div class="empty">Cargando reasignaciones...</div>';
  if(el('operationalAlertsList'))el('operationalAlertsList').innerHTML='<div class="empty">Cargando alertas operativas...</div>';

  await Promise.all([
    loadNotifications(false),
    loadOperationalAlerts(false),
    loadArchiveDeliveryRequests(false),
    loadInternalReassignRequests(false),
    loadCrossAreaWaits(false)
  ]);
  renderNotifications();
  renderOperationalAlerts();
  renderArchiveDeliveryRequests();
  renderInternalReassignRequests();
  renderCrossAreaWaitAlerts();
  updateAlertsBadge();
}

function closeAlertsModal(){
  el('alertsModal').classList.remove('show');
}

async function markNotificationRead(id){
  const {error}=await sb.rpc('marcar_notificacion_reasignacion_leida',{
    p_notificacion_id:id
  });

  if(error){
    alert(error.message);
    return;
  }

  await loadNotifications(true);
  renderNotifications();
}

async function markAllNotificationsRead(){
  const {error}=await sb.rpc('marcar_todas_notificaciones_reasignacion_leidas');

  if(error){
    alert(error.message);
    return;
  }

  await loadNotifications(true);
  renderNotifications();
}

async function openNotificationExpediente(notificationId,expedienteId){
  // Marcar como leída antes de abrir la gestión.
  if(notificationId){
    await sb.rpc('marcar_notificacion_reasignacion_leida',{
      p_notificacion_id:notificationId
    });
  }

  await loadNotifications(true);
  closeAlertsModal();

  await manageExpedienteFromPanel(expedienteId);
}


// =========================================================
// V170 · NÚCLEO DE ESTADOS Y FLUJOS
// Centraliza los conceptos principales sin cambiar los estados existentes
// en Supabase. Sirve como referencia única para nuevas mejoras y evita
// seguir creando reglas distintas en cada pantalla.
// =========================================================
const SYSTEM_FLOW_V170=Object.freeze({
  request:Object.freeze({
    pending:Object.freeze(['REGISTRADA POR ARCHIVO','ACEPTADO','PENDIENTE POR ATENDER','ENTREGA PARCIAL','EN ESPERA DE DEVOLUCIÓN']),
    delivered:Object.freeze(['ENTREGA TOTAL']),
    closed:Object.freeze(['CERRADA POR ARCHIVO','CERRADO POR ARCHIVO','CERRADA POR ADMINISTRADOR','CERRADO POR ADMINISTRADOR'])
  }),
  custody:Object.freeze({
    archive:Object.freeze(['CUSTODIA','DEVUELTO','DEVUELTO AL ARCHIVO']),
    outside:Object.freeze(['EN PRÉSTAMO','REASIGNADO','DEVOLUCIÓN SOLICITADA']),
    derived:Object.freeze(['DERIVADO AL CONAS','DERIVADO A LA DVC','DERIVADO A INSTRUCCIÓN'])
  }),
  actions:Object.freeze({
    request:'SOLICITUD',loan:'PRÉSTAMO',reassign:'REASIGNACIÓN',
    returnRequest:'SOLICITUD DE DEVOLUCIÓN',returnConfirm:'DEVOLUCIÓN CONFIRMADA',
    derivation:'DERIVACIÓN'
  })
});

// Alias temporal para no romper llamadas existentes durante la migración.
const SYSTEM_FLOW_V169=SYSTEM_FLOW_V170;

function systemFlowStateInV169(group,value){
  const v=norm(value||'');
  return (group||[]).some(x=>norm(x)===v);
}

function tabSectionVisible(name){
  const section=el(`tab-${name}`);
  return !!section && !section.classList.contains('hidden');
}

async function refreshReturnCountersAndViews(options={}){
  if(!sb||!session)return;

  const {
    full=true,
    reason='DEVOLUCIÓN ACEPTADA'
  }=options;

  if(returnCountersRefreshPromise){
    return returnCountersRefreshPromise;
  }

  returnCountersRefreshPromise=(async()=>{
    try{
      // V171/V657: cualquier mutación de devolución/custodia invalida la lectura
      // canónica compartida y también la búsqueda por usuario/expediente.
      invalidateV171CustodyCache();
      try{
        if(typeof ownerTeamFilterCacheV538!=='undefined')ownerTeamFilterCacheV538.clear();
      }catch(_){ }

      // V169: siempre recalcular el resumen desde Supabase, pero evitar
      // recargar TODOS los módulos cuando solo uno está visible.
      await loadSummary();

      const jobs=[];
      const active=document.querySelector('section[id^="tab-"]:not(.hidden)')?.id||'';

      // Panel de usuarios / Mis expedientes.
      if(active==='tab-panel'){
        jobs.push(loadPanel());
      }else if(hasFullAccess() && ownerCardsMode()){
        // Mantener las tarjetas de personal sincronizadas sin reconstruir
        // tablas que el usuario no está mirando.
        jobs.push(loadOwnerCards());
        if(selectedOwnerIsUser())jobs.push(loadOwnerUserKpis(selectedOwner));
      }

      // La devolución afecta directamente solicitudes y estados físicos.
      // Solo refrescamos esas vistas si están abiertas; al entrar después,
      // su loader normal leerá la información actualizada.
      if(active==='tab-requests')jobs.push(loadRequests());
      if(active==='tab-states')jobs.push(loadStates());
      if(active==='tab-all')jobs.push(loadAll());
      if(active==='tab-history')jobs.push(loadHistory());
      if(active==='tab-cargos')jobs.push(loadCargos());

      // La bandeja de devoluciones se actualiza cuando es pertinente.
      if(hasFullAccess() && (active==='tab-states' || el('statesReturnAdminBox')?.classList.contains('hidden')===false)){
        jobs.push(loadReturnRequests());
      }

      // Alertas y esperas sí deben quedar consistentes después de una
      // devolución, pero se ejecutan en paralelo y sin repintar módulos ajenos.
      if(full){
        if(v170TaskLayerAvailable===true){
          jobs.push(loadV170TaskCounters(true,true));
        }else{
          jobs.push(
            loadOperationalAlerts(true),
            loadNotifications(true),
            loadArchiveDeliveryRequests(true),
            loadInternalReassignRequests(true),
            loadCrossAreaWaits(true,true)
          );
        }
      }

      await Promise.allSettled(jobs);

      // V657: si el usuario estaba buscando un expediente en el panel,
      // recalcular el resultado después de una devolución para no dejar
      // en pantalla una custodia anterior almacenada en memoria.
      try{
        const ownerExpSearch=typeof ownerTeamFilterValuesV538==='function'
          ?ownerTeamFilterValuesV538().expediente
          :'';
        if(ownerExpSearch && active==='tab-panel' && typeof applyOwnerTeamFilterV538==='function'){
          await applyOwnerTeamFilterV538(true);
        }
      }catch(error){
        console.warn('V657 · refresco de búsqueda tras devolución:',error?.message||error);
      }

      console.debug(
        '[V169 · ACTUALIZACIÓN DIRIGIDA]',
        reason,
        active||'sin módulo visible',
        limaNowTimeV186()
      );
    }finally{
      returnCountersRefreshPromise=null;
    }
  })();

  return returnCountersRefreshPromise;
}

async function refreshPassiveCountersFromDatabase(){
  if(!sb||!session||document.hidden)return;

  // El sondeo general ya ocurre cada 15 segundos. Esta protección evita
  // duplicar peticiones si también se dispara el evento focus.
  const now=Date.now();
  if(now-lastPassiveCountersRefreshAt<12000)return;
  lastPassiveCountersRefreshAt=now;

  try{
    // Recalcular contadores visibles sin interrumpir formularios ni
    // volver a dibujar tablas completas.
    await loadSummary();

    if(hasFullAccess()){
      if(ownerCardsMode() && tabSectionVisible('panel')){
        await loadOwnerCards();

        if(selectedOwnerIsUser()){
          await loadOwnerUserKpis(selectedOwner);
        }
      }
    }

    // En USUARIO, loadSummary() ejecuta loadUserPersonalSummary():
    // Todos mis expedientes, En préstamo, Devolución solicitada,
    // Reasignados, Devueltos y Alertas quedan sincronizados.
  }catch(err){
    console.warn(
      'Actualización automática de contadores:',
      err?.message||err
    );
  }
}


let visibleRefreshPromise=null;
async function refreshVisibleViewSafely(){
  if(!sb||!session||document.hidden||navigator.onLine===false)return;
  if(document.querySelector('.modal.show'))return;
  if(document.activeElement?.matches('input,textarea,select,[contenteditable="true"]'))return;
  if([selectedIds,requestSelectedIds,requestSearchSelectedIds,conasSelectedIds,dvcSelectedIds,instructionSelectedIds,returnedArchiveSelectedIds,archiveListSelectedIds].some(ids=>ids.size))return;
  if(visibleRefreshPromise)return visibleRefreshPromise;

  const active=document.querySelector('section[id^="tab-"]:not(.hidden)');
  const activeId=active?.id||'';

  // V390: Estados y Registro maestro NO se reconstruyen automáticamente
  // mientras el usuario está desplazándose o se encuentra abajo del listado.
  if(
    typeof window.v390ShouldDeferActiveRefresh==='function' &&
    window.v390ShouldDeferActiveRefresh(activeId)
  ){
    return;
  }

  const loaders={ 'tab-panel':loadPanel,'tab-summary':loadSummary,
    'tab-requests':loadRequests,'tab-reassignTracking':loadReassignTrackingV198,
    'tab-requestsByLawyer':loadRequestsByLawyer,
    'tab-states':loadStates,'tab-all':loadAll,'tab-conas':loadConasFolder,
    'tab-dvc':loadDvcFolder,'tab-instruction':loadInstructionFolder,
    'tab-cargos':loadCargos,'tab-history':loadHistory };
  const loader=loaders[activeId];
  if(!loader)return;

  const saved=
    typeof window.v390CaptureScroll==='function'
      ?window.v390CaptureScroll(activeId)
      :null;

  visibleRefreshPromise=Promise.resolve().then(()=>loader());

  try{
    await visibleRefreshPromise;
    if(saved && typeof window.v390RestoreScroll==='function'){
      window.v390RestoreScroll(activeId,saved);
    }
  }finally{
    visibleRefreshPromise=null;
  }
}

let passiveRefreshPromise=null;
let passiveRefreshLastStarted=0;
function updateConnectionState(){
  const offline=navigator.onLine===false;
  el('connectionBar').dataset.offline=String(offline);
  el('connectionText').textContent=offline?'Sin conexión a Internet':'Conexión de red disponible';
  if(offline)el('backgroundReviewText').textContent='Reconecta antes de guardar o consultar expedientes.';
}
async function refreshPassiveSafely(){
  updateConnectionState();
  if(document.hidden || !session || navigator.onLine===false)return;
  if(window.v601Protection && !window.v601Protection.canPoll('refresh-passive'))return;
  if(passiveRefreshPromise)return passiveRefreshPromise;
  if(Date.now()-passiveRefreshLastStarted<45000)return;
  passiveRefreshLastStarted=Date.now();
  const reviewSession=session.user?.id;
  el('backgroundReviewText').textContent='Revisando cambios…';

  passiveRefreshPromise=(async()=>{
    const stats=window.v602RefreshStats||(window.v602RefreshStats={idlePulses:0,changeBursts:0,locationChecks:0,lastPulseAt:0,lastChangeAt:0});
    stats.idlePulses+=1;stats.lastPulseAt=Date.now();

    // V602: el reposo consulta SOLO el contador compacto V170. No se recargan
    // solicitudes, préstamos, movimientos, asuntos, paneles ni listados completos.
    const beforeSignature=JSON.stringify({
      total:Number(typeof v170TaskTotal!=='undefined'?v170TaskTotal:0),
      unread:Number(typeof v170TaskUnread!=='undefined'?v170TaskUnread:0),
      byType:(typeof v170TaskCountsByType!=='undefined'&&v170TaskCountsByType)||{}
    });

    const results=[];
    if(typeof loadV170TaskCounters==='function'){
      results.push(await Promise.resolve(loadV170TaskCounters(true)).then(v=>({status:'fulfilled',value:v}),e=>({status:'rejected',reason:e})));
    }

    // Ubicación verificada es una fuente independiente de V170: revisar como
    // máximo una vez cada 2 minutos (una consulta head/count, no el detalle).
    const now=Date.now();
    if(typeof window.__v602LastLocationCheck!=='number')window.__v602LastLocationCheck=0;
    if(now-window.__v602LastLocationCheck>=120000 && typeof refreshLocationUnread==='function'){
      window.__v602LastLocationCheck=now;stats.locationChecks+=1;
      results.push(await Promise.resolve(refreshLocationUnread()).then(v=>({status:'fulfilled',value:v}),e=>({status:'rejected',reason:e})));
    }

    if(session?.user?.id!==reviewSession)return;

    const afterSignature=JSON.stringify({
      total:Number(typeof v170TaskTotal!=='undefined'?v170TaskTotal:0),
      unread:Number(typeof v170TaskUnread!=='undefined'?v170TaskUnread:0),
      byType:(typeof v170TaskCountsByType!=='undefined'&&v170TaskCountsByType)||{}
    });

    // Solo cuando V170 detecta un cambio real se permite un refresco dirigido.
    // El primer pulso establece la línea base y NO dispara una ráfaga.
    if(typeof window.__v602TaskSignature!=='string'){
      window.__v602TaskSignature=afterSignature;
    }else if(afterSignature!==window.__v602TaskSignature){
      window.__v602TaskSignature=afterSignature;
      stats.changeBursts+=1;stats.lastChangeAt=Date.now();

      const changedJobs=[];
      // Las alertas específicas se consultan únicamente cuando cambió el contador.
      try{
        if(typeof v362CanReceiveRequestAlerts==='function' && v362CanReceiveRequestAlerts() && typeof window.loadV362RequestAlerts==='function'){
          changedJobs.push(window.loadV362RequestAlerts({silent:true}));
        }
      }catch(_){ }
      try{
        if(typeof window.refreshPersistentReassignmentNotificationsV483==='function'){
          changedJobs.push(window.refreshPersistentReassignmentNotificationsV483());
        }
      }catch(_){ }
      // Refrescar solo la pantalla que está mirando el usuario, no todo el sistema.
      try{if(typeof refreshVisibleViewSafely==='function')changedJobs.push(refreshVisibleViewSafely());}catch(_){ }
      if(changedJobs.length)await Promise.allSettled(changedJobs);
    }

    const failed=results.some(r=>r.status==='rejected');
    if(failed) window.v601Protection?.reportFailure?.('refresh-passive');
    else window.v601Protection?.reportSuccess?.('refresh-passive');
    el('backgroundReviewText').textContent=failed
      ?'No se completó la revisión ligera. Se intentará nuevamente.'
      :'Última revisión ligera: '+limaNowTimeV186()+'.';
  })();
  try{await passiveRefreshPromise;}finally{passiveRefreshPromise=null;}
}
function startNotificationPolling(){
  refreshLocationUnread();
  clearInterval(notificationsPollTimer);
  notificationsPollTimer=setInterval(refreshPassiveSafely,60000);
  if(!window.__notificationFocusHook){
    window.addEventListener('focus',refreshPassiveSafely);
    document.addEventListener('visibilitychange',()=>{if(!document.hidden)refreshPassiveSafely();});
    window.addEventListener('online',()=>{passiveRefreshLastStarted=0;refreshPassiveSafely();});
    window.addEventListener('offline',updateConnectionState);
    window.__notificationFocusHook=true;
  }
}
async function loadReassignmentProfiles(force=false){
  if(!sb||!session)return;

  // Evita consultar Supabase cada vez que se abre "Gestionar".
  // La lista se renueva cada 5 minutos o cuando se fuerza la carga.
  if(!force && reassignmentProfiles.length &&
     (Date.now()-reassignmentProfilesLoadedAt)<300000){
    return reassignmentProfiles;
  }

  const {data,error}=await sb.rpc('listar_usuarios_reasignacion');

  if(error){
    console.warn('listar_usuarios_reasignacion:',error.message);

    // Fallback: usar los abogados visibles y el usuario actual.
    const fallback=[
      ...(abogadoProfiles||[]),
      ...(currentProfile?.nombre_personal ? [{
        user_id:currentProfile.id,
        email:currentProfile.email||'',
        nombre_personal:currentProfile.nombre_personal,
        rol:currentProfile.rol||'USUARIO'
      }] : [])
    ];

    const seen=new Set();
    reassignmentProfiles=fallback.filter(x=>{
      const k=norm(x.nombre_personal||'');
      if(!k || seen.has(k))return false;
      seen.add(k);
      return true;
    });

    reassignmentProfilesLoadedAt=Date.now();
    return reassignmentProfiles;
  }

  const seen=new Set();

  reassignmentProfiles=(data||[])
    .filter(x=>x.nombre_personal)
    .filter(x=>{
      const k=norm(x.nombre_personal||'');
      if(!k || seen.has(k))return false;
      seen.add(k);
      return true;
    })
    .sort((a,b)=>(a.nombre_personal||'').localeCompare(b.nombre_personal||'','es'));

  reassignmentProfilesLoadedAt=Date.now();
  return reassignmentProfiles;
}

function reassignmentNames(){
  return reassignmentProfiles
    .map(x=>(x.nombre_personal||'').trim())
    .filter(Boolean);
}


async function loadArchiveProfilesV462(force=false){
  if(!sb||!session)return archiveProfilesV462;

  if(!force && archiveProfilesV462.length &&
     (Date.now()-archiveProfilesLoadedAtV462)<300000){
    return archiveProfilesV462;
  }

  try{
    const {data,error}=await sb
      .from('perfiles_usuario')
      .select('id,email,nombre_personal,rol,activo')
      .eq('rol','ARCHIVO')
      .order('nombre_personal');

    if(error)throw error;

    const seen=new Set();
    archiveProfilesV462=(data||[])
      .filter(x=>x?.activo!==false)
      .filter(x=>String(x?.nombre_personal||'').trim())
      .filter(x=>{
        const k=norm(x.nombre_personal||'');
        if(!k||seen.has(k))return false;
        seen.add(k);
        return true;
      })
      .sort((a,b)=>String(a.nombre_personal||'').localeCompare(String(b.nombre_personal||''),'es'));

    archiveProfilesLoadedAtV462=Date.now();
    return archiveProfilesV462;
  }catch(error){
    console.warn('V462 · perfiles ARCHIVO:',error?.message||error);
    // El respaldo sigue siendo estricto: jamás incorpora perfiles distintos de ARCHIVO.
    const fallback=[];
    (Array.isArray(userProfiles)?userProfiles:[]).forEach(x=>fallback.push(x));
    (Array.isArray(reassignmentProfiles)?reassignmentProfiles:[]).forEach(x=>fallback.push(x));
    if(currentProfile)fallback.push(currentProfile);

    const seen=new Set();
    archiveProfilesV462=fallback
      .filter(x=>x?.activo!==false && norm(x?.rol||'')==='ARCHIVO')
      .filter(x=>String(x?.nombre_personal||'').trim())
      .filter(x=>{
        const k=norm(x.nombre_personal||'');
        if(!k||seen.has(k))return false;
        seen.add(k);
        return true;
      });
    archiveProfilesLoadedAtV462=Date.now();
    return archiveProfilesV462;
  }
}

function archiveStaffNames(){
  // V462: fuente estricta de atención = perfiles_usuario.rol = ARCHIVO.
  // El área de trabajo, el catálogo de personal y la lista de reasignación
  // NO habilitan a una persona para atender una solicitud.
  const byKey=new Map();

  (Array.isArray(archiveProfilesV462)?archiveProfilesV462:[]).forEach(x=>{
    const name=String(x?.nombre_personal||'').trim();
    if(name && x?.activo!==false && norm(x?.rol||'')==='ARCHIVO'){
      byKey.set(norm(name),name);
    }
  });

  // Respaldo en memoria, siempre exigiendo rol ARCHIVO.
  (Array.isArray(userProfiles)?userProfiles:[]).forEach(x=>{
    const name=String(x?.nombre_personal||'').trim();
    if(name && x?.activo!==false && norm(x?.rol||'')==='ARCHIVO'){
      byKey.set(norm(name),name);
    }
  });

  (Array.isArray(reassignmentProfiles)?reassignmentProfiles:[]).forEach(x=>{
    const name=String(x?.nombre_personal||'').trim();
    if(name && x?.activo!==false && norm(x?.rol||'')==='ARCHIVO'){
      byKey.set(norm(name),name);
    }
  });

  if(currentProfile?.nombre_personal && currentProfile?.activo!==false &&
     norm(currentProfile?.rol||'')==='ARCHIVO'){
    const name=String(currentProfile.nombre_personal).trim();
    if(name)byKey.set(norm(name),name);
  }

  return [...byKey.values()].sort((a,b)=>a.localeCompare(b,'es'));
}

// V423: la validación también usa la lista estricta por perfil; aunque un nombre
// llegue de un registro histórico o del DOM, no podrá guardarse si no tiene rol ARCHIVO.
function isArchiveStaffNameV421(value){
  const key=norm(value||'');
  if(!key)return false;
  return archiveStaffNames().some(name=>norm(name)===key);
}

function validateArchiveStaffV421(value,statusId,selectId){
  const v=String(value||'').trim();
  const status=statusId?el(statusId):null;
  const select=selectId?el(selectId):null;

  if(!v){
    if(status)status.textContent='Seleccione quién atiende el requerimiento.';
    select?.focus();
    return false;
  }

  if(!isArchiveStaffNameV421(v)){
    if(status)status.textContent='La atención del requerimiento solo puede registrarse a nombre de una cuenta activa con perfil ARCHIVO.';
    select?.focus();
    return false;
  }

  return true;
}

function fillArchiveStaffSelect(id){
  const s=el(id);
  if(!s)return;

  const current=String(s.value||'').trim();
  const names=archiveStaffNames();
  const currentIsArchive=current && names.some(x=>norm(x)===norm(current));

  s.innerHTML=
    '<option value="">— SOLO PERSONAL CON PERFIL ARCHIVO —</option>'+ 
    names.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('');

  // Los responsables históricos ajenos a Archivo se conservan únicamente
  // para lectura del registro antiguo; no pueden elegirse para una nueva atención.
  if(current && !currentIsArchive){
    const opt=document.createElement('option');
    opt.value=current;
    opt.textContent=current+' (histórico · no habilitado para nueva atención)';
    opt.disabled=true;
    opt.dataset.historical='1';
    s.appendChild(opt);
    s.value=current;
  }else if(current){
    s.value=current;
  }
}

function renderArchiveStaffSelects(){
  ['rqPrepareAtiende','rqDAtiende','fAtiende','bAtiende','cAtiende']
    .forEach(fillArchiveStaffSelect);
}


function setArchiveStaffValue(id,value){
  const s=el(id);
  if(!s)return;
  fillArchiveStaffSelect(id);

  const v=String(value||'').trim();
  if(v && ![...s.options].some(o=>norm(o.value)===norm(v))){
    const opt=document.createElement('option');
    opt.value=v;
    opt.textContent=v+' (histórico · no habilitado para nueva atención)';
    opt.disabled=true;
    opt.dataset.historical='1';
    s.appendChild(opt);
  }
  s.value=v;
}

async function loadAbogadoProfiles(){
  if(!sb||!session)return;

  if(isCoordinator()){
    abogadoProfiles=(coordinatorTeamRowsV211||[])
      .filter(x=>x.supervisado_nombre)
      .map(x=>({
        user_id:x.supervisado_id,
        email:x.supervisado_email||'',
        nombre_personal:x.supervisado_nombre,
        rol:'USUARIO',
        area_coordinacion:coordinatorPrimaryAreaV211()||''
      }))
      .sort((a,b)=>
        (a.nombre_personal||'')
          .localeCompare(b.nombre_personal||'','es')
      );
    return;
  }

  // V233:
  // ADMINISTRADOR y ARCHIVO deben visualizar tanto USUARIOS como COORDINADORES.
  if(isAdmin() || isPureArchiveV231()){
    const {data,error}=await sb.rpc(
      'v233_listar_personal_operativo_archivo'
    );

    if(!error){
      abogadoProfiles=(data||[])
        .filter(x=>x.nombre_personal)
        .map(x=>({
          user_id:x.user_id,
          email:x.email||'',
          nombre_personal:x.nombre_personal,
          rol:String(x.rol||'USUARIO').toUpperCase(),
          area_coordinacion:x.area_coordinacion||''
        }))
        .sort((a,b)=>
          (a.nombre_personal||'')
            .localeCompare(b.nombre_personal||'','es')
        );

      // V234:
      // No borrar la caché de tarjetas en cada carga de perfiles.
      // loadOwnerCardsNow() ya reconcilia la lista vigente, agrega usuarios
      // nuevos y elimina los que ya no correspondan.
      // Mantener esta caché permite mostrar las tarjetas inmediatamente.
      return;
    }

    console.warn(
      'v233_listar_personal_operativo_archivo:',
      error.message
    );
  }

  // Respaldo para instalaciones donde V233 aún no esté disponible.
  const {data,error}=await sb.rpc('listar_usuarios_abogados');

  if(error){
    console.warn('listar_usuarios_abogados:',error.message);
    abogadoProfiles=isLimitedUser() && currentProfile?.nombre_personal
      ? [{
          user_id:currentProfile.id,
          email:currentProfile.email||'',
          nombre_personal:currentProfile.nombre_personal,
          rol:currentProfile.rol||'USUARIO',
          area_coordinacion:''
        }]
      : [];
    return;
  }

  abogadoProfiles=(data||[])
    .filter(x=>x.nombre_personal)
    .map(x=>({
      ...x,
      rol:String(x.rol||'USUARIO').toUpperCase(),
      area_coordinacion:x.area_coordinacion||''
    }))
    .sort((a,b)=>
      (a.nombre_personal||'')
        .localeCompare(b.nombre_personal||'','es')
    );
}

function abogadoNames(){
  if(isCoordinator()){
    return coordinatorAllowedUserNamesV205();
  }

  return [...new Set(
    abogadoProfiles
      .map(x=>(x.nombre_personal||'').trim())
      .filter(Boolean)
  )];
}

function fillSelects(){
  const activos=catalogo.filter(x=>x.activo!==false);
  const abogados=abogadoNames();
  const ubicaciones=activos
    .filter(x=>x.tipo!=='PERSONAL')
    .filter(x=>!isCoordinator()||coordinatorCanViewAreaV205(x.nombre));

  if(el('ownerSelect')){
    if(isLimitedUser()){
      el('ownerFilterLabel').textContent='Usuario / abogado';
      el('ownerSelect').innerHTML=currentProfile?.nombre_personal
        ? `<option value="${esc(currentProfile.nombre_personal)}">${esc(currentProfile.nombre_personal)}</option>`
        : '<option value="">SIN PERSONAL ASOCIADO</option>';
    }else{
      el('ownerFilterLabel').textContent='Usuario / abogado';
      el('ownerSelect').innerHTML=
        '<option value="">TODOS LOS USUARIOS / ABOGADOS</option>'+
        (abogados.length
          ? `<optgroup label="USUARIOS / ABOGADOS">${
              abogados.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('')
            }</optgroup>`
          :'')+
        (ubicaciones.length
          ? `<optgroup label="ÁREAS / UBICACIONES">${
              ubicaciones.map(x=>`<option value="${esc(x.nombre)}">${esc(x.nombre)}</option>`).join('')
            }</optgroup>`
          :'');
    }

    // Mantener coherencia entre lo que muestra el selector y la vista cargada.
    // Evita que aparezca "TODOS" mientras selectedOwner sigue apuntando a un usuario.
    if(!isLimitedUser()){
      const values=[...el('ownerSelect').options].map(o=>o.value);
      if(selectedOwner && values.includes(selectedOwner)){
        if(el('ownerSelect'))el('ownerSelect').value=selectedOwner;
      }else if(selectedOwner && !values.includes(selectedOwner)){
        selectedOwner='';
        el('ownerSelect').value='';
      }else{
        el('ownerSelect').value='';
      }
    }
  }

  el('fResponsable').innerHTML=activos.map(x=>`<option>${esc(x.nombre)}</option>`).join('');
  el('fEstado').innerHTML=STATUSES.map(x=>`<option>${esc(x)}</option>`).join('');

  if(el('bResponsable')) el('bResponsable').innerHTML=activos.map(x=>`<option>${esc(x.nombre)}</option>`).join('');
  if(el('bEstado')) el('bEstado').innerHTML=STATUSES.map(x=>`<option>${esc(x)}</option>`).join('');

  if(el('rqSolicitante')){
    const solicitantes=isLimitedUser()
      ?(currentProfile?.nombre_personal?[currentProfile.nombre_personal]:[])
      :isCoordinator()
        ?coordinatorAllowedUserNamesV205()
        :activos
          .filter(x=>x.tipo==='PERSONAL')
          .map(x=>x.nombre)
          .sort((a,b)=>String(a).localeCompare(String(b),'es'));

    el('rqSolicitante').innerHTML=isLimitedUser()
      ?solicitantes.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('')
      :'<option value="">— SELECCIONE RESPONSABLE DE DESTINO —</option>'+
       solicitantes.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('');
  }

  if(el('rqDNuevoResponsable')){
    const responsables=reassignmentNames().length
      ? reassignmentNames()
      : (
          abogados.length
            ? abogados
            : activos.filter(x=>x.tipo==='PERSONAL').map(x=>x.nombre)
        );

    el('rqDNuevoResponsable').innerHTML=
      '<option value="">— SELECCIONE NUEVO RESPONSABLE —</option>'+
      responsables.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('');
  }

  if(el('rqDRetorno')){
    el('rqDRetorno').innerHTML=ubicaciones.map(x=>`<option>${esc(x.nombre)}</option>`).join('');
  }

  if(isLimitedUser() && el('rqSolicitante')){
    el('rqSolicitante').innerHTML=currentProfile.nombre_personal
      ? `<option>${esc(currentProfile.nombre_personal)}</option>`
      : '<option value="">SIN PERSONAL ASOCIADO</option>';
    el('rqSolicitante').value=currentProfile.nombre_personal||'';
    el('rqSolicitante').disabled=true;
  }
}


function asuntoActivo(nombre){
  const n=norm(nombre);
  return asuntosCatalogo.some(x=>x.activo!==false && norm(x.nombre)===n);
}

/* V457 · ASUNTO NATIVO
   Un único <select> real. No se crean botones, portales, datalist ni capas
   flotantes con el catálogo de asuntos. */
function requestAsuntoPickerDisabled(){
  return !!el('rqAsunto')?.disabled;
}

function requestAsuntoOptionsFromSelect(){
  const current=String(el('rqAsunto')?.value||'').trim();
  const activos=(asuntosCatalogo||[])
    .filter(x=>x&&x.activo!==false&&String(x.nombre||'').trim())
    .slice()
    .sort((a,b)=>String(a.nombre).localeCompare(String(b.nombre),'es'))
    .map(x=>({value:String(x.nombre).trim(),label:String(x.nombre).trim()}));

  if(current&&!activos.some(x=>norm(x.value)===norm(current))){
    activos.unshift({value:current,label:`${current} (ASUNTO ANTERIOR)`});
  }
  return activos;
}

function renderRequestAsuntoSelect(preferred=''){
  const field=el('rqAsunto');
  if(!field)return;

  const wanted=String(preferred||field.value||'').trim();
  const options=requestAsuntoOptionsFromSelect();
  const frag=document.createDocumentFragment();

  const placeholder=document.createElement('option');
  placeholder.value='';
  placeholder.textContent='— SELECCIONE ASUNTO —';
  frag.appendChild(placeholder);

  for(const item of options){
    const opt=document.createElement('option');
    opt.value=item.value;
    opt.textContent=item.label;
    frag.appendChild(opt);
  }

  field.replaceChildren(frag);
  if(wanted&&[...field.options].some(o=>o.value===wanted)) field.value=wanted;
  else field.value='';
}

function syncRequestAsuntoPicker(){
  // Compatibilidad con llamadas históricas: el SELECT nativo se actualiza solo.
  const field=el('rqAsunto');
  if(!field)return;
}

function renderRequestAsuntoPickerOptions(){ return; }
function openRequestAsuntoPicker(){ el('rqAsunto')?.focus(); }
function closeRequestAsuntoPicker(){ return; }
function toggleRequestAsuntoPicker(){ el('rqAsunto')?.focus(); }
function filterRequestAsuntoOptions(){ return; }
function setRequestAsuntoActive(){ return; }
function requestAsuntoSearchKeydown(){ return; }
function chooseRequestAsunto(){ return; }
function focusRequestAsuntoPicker(){
  const field=el('rqAsunto');
  if(field&&!field.disabled)field.focus();
}

function clearRequestAsuntoOptionsV458(){
  const field=el('rqAsunto');
  if(!field)return;
  const placeholder=document.createElement('option');
  placeholder.value='';
  placeholder.textContent='— SELECCIONE ASUNTO —';
  field.replaceChildren(placeholder);
  field.value='';
}

function renderAsuntosDatalist(){
  // V458: el catálogo NO se mantiene renderizado cuando Nueva solicitud está cerrada.
  // Esto evita que Chromium conserve/pinte OPTION de asuntos fuera del modal.
  const modal=el('newRequestModal');
  if(modal?.classList.contains('show')) renderRequestAsuntoSelect();
  else clearRequestAsuntoOptionsV458();
}

async function loadAsuntosCatalogo(){
  if(!sb||!session)return;

  const {data,error}=await sb
    .from('catalogo_asuntos')
    .select('id,nombre,activo,created_at,updated_at')
    .order('nombre');

  if(error){
    console.warn('catalogo_asuntos:',error.message);
    asuntosCatalogo=ASUNTOS_PREDETERMINADOS.map((nombre,i)=>({
      id:'fallback-asunto-'+i,
      nombre,
      activo:true
    }));
    renderAsuntosDatalist();
    return;
  }

  asuntosCatalogo=(data||[]).map(x=>({
    id:x.id,
    nombre:x.nombre,
    activo:x.activo,
    created_at:x.created_at,
    updated_at:x.updated_at
  }));

  renderAsuntosDatalist();
}

function renderSubjects(){
  if(!el('subjectsBody'))return;
  if(!el('subjectsModal')?.classList.contains('show')){
    el('subjectsBody').replaceChildren();
    return;
  }

  if(!asuntosCatalogo.length){
    el('subjectsBody').innerHTML=
      '<tr><td colspan="3" class="empty">No hay asuntos registrados.</td></tr>';
    return;
  }

  el('subjectsBody').innerHTML=asuntosCatalogo
    .slice()
    .sort((a,b)=>a.nombre.localeCompare(b.nombre,'es'))
    .map(x=>`<tr>
      <td><b>${esc(x.nombre)}</b></td>
      <td>${x.activo!==false
        ?'<span class="pill returned">ACTIVO</span>'
        :'<span class="pill alert">INACTIVO</span>'}</td>
      <td>
        <div style="display:flex;gap:6px;white-space:nowrap">
          <button class="btn secondary small"
            onclick="editSubject('${x.id}')">Editar</button>
          <button class="btn secondary small"
            onclick="toggleSubject('${x.id}',${x.activo!==false?'false':'true'})">
            ${x.activo!==false?'Inactivar':'Activar'}
          </button>
        </div>
      </td>
    </tr>`).join('');
}

async function openSubjectsModal(){
  if(!isAdmin()){
    alert('Solo el ADMINISTRADOR puede administrar asuntos.');
    return;
  }

  if(!sb||!session){
    alert('Debe iniciar sesión.');
    return;
  }

  el('sNombre').value='';
  el('sActivo').value='true';
  el('subjectsStatus').textContent='Cargando...';
  el('subjectsModal').hidden=false;
  el('subjectsModal').classList.add('show');

  await loadAsuntosCatalogo();
  renderSubjects();
  el('subjectsStatus').textContent='';
}

function closeSubjectsModal(){
  el('subjectsModal').classList.remove('show');
  el('subjectsModal').hidden=true;
  el('subjectsBody')?.replaceChildren();
  el('subjectsStatus').textContent='';
}

async function saveSubject(){
  if(!isAdmin()){
    alert('Solo el ADMINISTRADOR puede crear asuntos.');
    return;
  }

  const nombre=el('sNombre').value.trim().toUpperCase();
  const activo=el('sActivo').value==='true';

  if(!nombre){
    el('subjectsStatus').textContent='Escriba el asunto.';
    el('sNombre').focus();
    return;
  }

  el('subjectsStatus').textContent='Guardando asunto...';

  const {error}=await sb
    .from('catalogo_asuntos')
    .insert({
      nombre,
      activo,
      created_by:session.user.id,
      updated_by:session.user.id
    });

  if(error){
    el('subjectsStatus').textContent=error.message;
    return;
  }

  el('sNombre').value='';
  el('sActivo').value='true';

  await loadAsuntosCatalogo();
  renderSubjects();

  el('subjectsStatus').textContent='Asunto agregado correctamente.';
  showToast('Asunto agregado');
}

async function editSubject(id){
  if(!isAdmin())return;

  const x=asuntosCatalogo.find(a=>String(a.id)===String(id));
  if(!x)return;

  const nuevo=prompt('Editar asunto:',x.nombre);
  if(nuevo===null)return;

  const nombre=nuevo.trim().toUpperCase();

  if(!nombre){
    alert('El asunto no puede quedar vacío.');
    return;
  }

  const {error}=await sb
    .from('catalogo_asuntos')
    .update({
      nombre,
      updated_by:session.user.id
    })
    .eq('id',id);

  if(error){
    alert(error.message);
    return;
  }

  await loadAsuntosCatalogo();
  renderSubjects();
  showToast('Asunto actualizado');
}

async function toggleSubject(id,activo){
  if(!isAdmin())return;

  const {error}=await sb
    .from('catalogo_asuntos')
    .update({
      activo,
      updated_by:session.user.id
    })
    .eq('id',id);

  if(error){
    alert(error.message);
    return;
  }

  await loadAsuntosCatalogo();
  renderSubjects();
  showToast(activo?'Asunto activado':'Asunto inactivado');
}

function validarAsuntoActivo(asunto,statusId,inputId){
  if(asuntoActivo(asunto))return true;

  const msg='Seleccione un asunto ACTIVO del catálogo. Solo el ADMINISTRADOR puede crear nuevos asuntos.';
  if(statusId && el(statusId))el(statusId).textContent=msg;
  else alert(msg);

  if(inputId==='rqAsunto'){
    focusRequestAsuntoPicker();
  }else if(inputId && el(inputId)){
    el(inputId).focus();
  }
  return false;
}


function initRequestAsuntoPickerObserver(){
  // V458: se elimina el MutationObserver histórico.
  // El SELECT solo se llena al abrir Nueva solicitud y se vacía al cerrarla.
  const field=el('rqAsunto');
  if(!field)return;
  field.addEventListener('change',syncRequestAsuntoPicker);
  clearRequestAsuntoOptionsV458();
}

if(document.readyState==='loading'){
  document.addEventListener('DOMContentLoaded',initRequestAsuntoPickerObserver,{once:true});
}else{
  initRequestAsuntoPickerObserver();
}


async function loadCatalogo(){
  if(!sb||!session)return;
  const {data,error}=await sb.from('catalogo_responsables').select('*').order('tipo').order('nombre');
  if(error){
    console.warn('catalogo_responsables:',error.message);
    catalogo=MASTER.map(([nombre,tipo],i)=>({id:'fallback-'+i,nombre,tipo,activo:true,area_trabajo:null}));
    return;
  }
  catalogo=(data||[]).map(x=>({
    id:x.id,
    nombre:x.nombre,
    tipo:x.tipo,
    activo:x.activo,
    area_trabajo:x.area_trabajo||null
  }));
}
function workAreaNames(){
  return [...new Set(
    (catalogo||[])
      .filter(x=>x.activo!==false && norm(x.tipo)==='ÁREA / UBICACIÓN')
      .map(x=>String(x.nombre||'').trim())
      .filter(Boolean)
  )].sort((a,b)=>a.localeCompare(b,'es'));
}
function renderPeopleAreaSelect(preferred=''){
  const s=el('pArea');
  if(!s)return;
  const wanted=String(preferred||s.value||'').trim();
  const areas=workAreaNames();
  s.innerHTML='<option value="">— SIN ASIGNAR —</option>'+areas.map(a=>`<option value="${esc(a)}">${esc(a)}</option>`).join('');
  if(wanted && !areas.some(a=>norm(a)===norm(wanted))){
    s.insertAdjacentHTML('beforeend',`<option value="${esc(wanted)}">${esc(wanted)} (histórico)</option>`);
  }
  s.value=wanted||'';
}
function syncPeopleAreaField(){
  const personal=norm(el('pTipo')?.value||'')==='PERSONAL';
  if(el('pArea')){
    el('pArea').disabled=!personal;
    if(!personal)el('pArea').value='';
  }
  if(el('pAreaField'))el('pAreaField').style.opacity=personal?'1':'.55';
}
async function openPeopleModal(){
  if(!isAdmin()){alert('Solo el ADMINISTRADOR puede administrar personal y áreas.');return}
  if(!sb||!session){alert('Debe iniciar sesión.');return}
  el('pNombre').value='';el('pTipo').value='PERSONAL';el('pActivo').value='true';
  el('peopleModal').classList.add('show');el('peopleStatus').textContent='Cargando...';
  await loadCatalogo();renderPeopleAreaSelect('');syncPeopleAreaField();renderPeople();el('peopleStatus').textContent='';
}
function closePeopleModal(){el('peopleModal').classList.remove('show')}
function areaOptionsForPerson(x){
  const current=String(x?.area_trabajo||'').trim();
  const areas=workAreaNames();
  let html='<option value="">— SIN ASIGNAR —</option>';
  if(current && !areas.some(a=>norm(a)===norm(current))){
    html+=`<option value="${esc(current)}" selected>${esc(current)} (histórico)</option>`;
  }
  html+=areas.map(a=>`<option value="${esc(a)}" ${norm(a)===norm(current)?'selected':''}>${esc(a)}</option>`).join('');
  return html;
}
function renderPeople(){
  if(!catalogo.length){el('peopleBody').innerHTML='<tr><td colspan="5" class="empty">No hay registros.</td></tr>';return}
  el('peopleBody').innerHTML=catalogo.slice().sort((a,b)=>a.tipo.localeCompare(b.tipo)||a.nombre.localeCompare(b.nombre)).map(x=>`<tr>
    <td><b>${esc(x.nombre)}</b></td><td>${esc(x.tipo)}</td>
    <td>${norm(x.tipo)==='PERSONAL'
      ?`<div class="v750-area-cell"><select class="request-item-edit v750-area-select" aria-label="Área de trabajo de ${esc(x.nombre)}" data-old-area="${esc(x.area_trabajo||'')}" onchange="v750AreaChanged(this)">${areaOptionsForPerson(x)}</select><button type="button" class="btn small v750-save-area" onclick="v750SavePersonArea('${x.id}',this)" disabled>Guardar área</button></div>`
      :'—'}</td>
    <td class="${x.activo?'status-active':'status-inactive'}">${x.activo?'ACTIVO':'INACTIVO'}</td>
    <td><div class="people-actions"><button class="btn secondary small" onclick="editPerson('${x.id}')">Editar</button><button class="btn secondary small" onclick="togglePerson('${x.id}',${x.activo?'false':'true'})">${x.activo?'Inactivar':'Activar'}</button></div></td>
  </tr>`).join('');
}
async function v298SyncPersonTeamAfterAreaChange(personName,newArea){
  if(!isAdmin()||!sb)return {removed:[],warnings:[]};

  const targetName=String(personName||'').trim();
  const targetArea=String(newArea||'').trim();
  if(!targetName)return {removed:[],warnings:[]};

  // El equipo del coordinador se guarda por ID de perfil (auth/perfiles_usuario),
  // mientras que el área de trabajo se guarda en catalogo_responsables.
  // Si una persona cambia de área, retirarla de cualquier equipo cuyo área ya no coincida.
  if(!Array.isArray(userProfiles)||!userProfiles.length){
    try{await loadUserProfiles();}catch(_){/* continuar con lo disponible */}
  }

  const profile=(userProfiles||[]).find(p=>
    norm(p?.nombre_personal||'')===norm(targetName)
  );
  if(!profile?.id)return {removed:[],warnings:['No se encontró una cuenta/perfil asociado al nombre.']};

  const coordResult=await sb.rpc('v211_admin_listar_coordinadores');
  if(coordResult.error){
    return {removed:[],warnings:[coordResult.error.message]};
  }

  const removed=[];
  const warnings=[];
  const coordinators=Array.isArray(coordResult.data)?coordResult.data:[];

  for(const cfg of coordinators){
    const coordId=String(cfg?.coordinador_id||'').trim();
    if(!coordId)continue;

    const coordArea=String(cfg?.area||'').trim();
    const sameArea=!!targetArea && !!coordArea && areaMatchKey(targetArea)===areaMatchKey(coordArea);
    if(sameArea)continue;

    const teamResult=await sb.rpc('v211_admin_listar_equipo',{p_coordinador_id:coordId});
    if(teamResult.error){
      warnings.push(teamResult.error.message);
      continue;
    }

    const member=(teamResult.data||[]).find(r=>String(r?.supervisado_id||'')===String(profile.id));
    if(!member)continue;

    const removeResult=await sb.rpc('v211_admin_quitar_supervisado',{
      p_coordinador_id:coordId,
      p_supervisado_id:String(profile.id)
    });

    if(removeResult.error){
      warnings.push(removeResult.error.message);
      continue;
    }

    removed.push({
      coordinator:cfg?.coordinador_nombre||cfg?.nombre_personal||cfg?.email||'Coordinador',
      area:coordArea||'Sin área'
    });
  }

  return {removed,warnings};
}

async function savePersonArea(id,area){
  if(!isAdmin())return;
  const x=catalogo.find(p=>String(p.id)===String(id));
  if(!x||norm(x.tipo)!=='PERSONAL')return;

  const previous=String(x.area_trabajo||'').trim();
  const value=String(area||'').trim()||null;

  if(norm(previous||'')===norm(value||''))return;

  const {error}=await sb.from('catalogo_responsables').update({area_trabajo:value}).eq('id',id);
  if(error){alert(error.message);renderPeople();return}

  x.area_trabajo=value;

  let sync={removed:[],warnings:[]};
  try{
    sync=await v298SyncPersonTeamAfterAreaChange(x.nombre,value||'');
  }catch(err){
    console.warn('V298 sincronización área/equipo:',err);
    sync.warnings=[String(err?.message||err)];
  }

  // Refrescar catálogo y vistas para que Expedientes por área / usuario
  // reflejen el cambio sin recargar la página.
  try{
    await refreshCatalogoUI();
    if(typeof loadOwnerCards==='function')await loadOwnerCards();
    if(typeof renderOwnerCards==='function')renderOwnerCards();
  }catch(err){
    console.warn('V298 refresco visual:',err);
  }

  let msg=value?`Área asignada: ${value}`:'Área retirada';
  if(sync.removed.length){
    const teams=sync.removed.map(r=>r.area).filter(Boolean).join(', ');
    msg+=` · Retirado automáticamente de ${sync.removed.length} equipo${sync.removed.length===1?'':'s'} incompatible${sync.removed.length===1?'':'s'}${teams?` (${teams})`:''}.`;
  }
  if(sync.warnings.length){
    msg+=' · Revise la configuración de equipos.';
  }
  showToast(msg);
}
async function savePerson(){
  if(!isAdmin())return;
  const nombre=el('pNombre').value.trim().toUpperCase(),tipo=el('pTipo').value,activo=el('pActivo').value==='true';
  const area=norm(tipo)==='PERSONAL'?(el('pArea').value.trim()||null):null;
  if(!nombre){el('peopleStatus').textContent='Ingrese el nombre.';el('pNombre').focus();return}
  const existing=(catalogo||[]).find(x=>norm(x.nombre)===norm(nombre));
  if(existing){
    el('peopleStatus').textContent=`«${nombre}» ya existe en el catálogo. No vuelva a agregarlo: cambie su área en la fila del personal con el botón «Guardar área».`;
    el('peopleStatus').style.color='#a15c00';
    const row=[...document.querySelectorAll('#peopleBody tr')].find(tr=>norm(tr.cells?.[0]?.textContent||'')===norm(nombre));
    row?.scrollIntoView({block:'nearest',behavior:'smooth'});
    return;
  }
  el('peopleStatus').style.color='';
  el('peopleStatus').textContent='Guardando nuevo registro...';
  const {error}=await sb.from('catalogo_responsables').insert({nombre,tipo,activo,area_trabajo:area});
  if(error){
    const duplicate=error.code==='23505'||/duplicate key|unique constraint/i.test(String(error.message||''));
    el('peopleStatus').textContent=duplicate
      ?`«${nombre}» ya está registrado. Utilice «Guardar área» en su fila, no «Agregar personal».`
      :`No se pudo agregar el personal: ${error.message||'Error de base de datos'}`;
    el('peopleStatus').style.color='#a61b1b';
    return;
  }
  el('pNombre').value='';el('pArea').value='';await refreshCatalogoUI();renderPeopleAreaSelect('');syncPeopleAreaField();el('peopleStatus').textContent='Nombre agregado correctamente.';
}
async function editPerson(id){
  if(!isAdmin())return;
  const x=catalogo.find(p=>String(p.id)===String(id));if(!x)return;
  const nuevo=prompt('Editar nombre:',x.nombre);if(nuevo===null)return;
  const nombre=nuevo.trim().toUpperCase();if(!nombre){alert('El nombre no puede quedar vacío.');return}
  const tipo=prompt('Tipo: PERSONAL / ÁREA / UBICACIÓN / ETAPA / UBICACIÓN',x.tipo);if(tipo===null)return;
  const tipoNorm=tipo.trim().toUpperCase(),permitidos=['PERSONAL','ÁREA / UBICACIÓN','ETAPA / UBICACIÓN','UBICACIÓN'];
  if(!permitidos.includes(tipoNorm)){alert('Tipo no válido.');return}
  const patch={nombre,tipo:tipoNorm};
  if(tipoNorm!=='PERSONAL')patch.area_trabajo=null;
  const {error}=await sb.from('catalogo_responsables').update(patch).eq('id',id);
  if(error){alert(error.message);return}await refreshCatalogoUI();renderPeopleAreaSelect('');syncPeopleAreaField();showToast('Registro actualizado');
}
async function togglePerson(id,activo){
  if(!isAdmin())return;
  const {error}=await sb.from('catalogo_responsables').update({activo}).eq('id',id);
  if(error){alert(error.message);return}await refreshCatalogoUI();renderPeopleAreaSelect(el('pArea')?.value||'');syncPeopleAreaField();showToast(activo?'Registro activado':'Registro inactivado');
}
async function refreshCatalogoUI(){
  await loadCatalogo();fillSelects();renderSidebar();renderSummary();renderPeople();
  if(
    selectedOwner &&
    !catalogo.some(x=>x.nombre===selectedOwner&&x.activo) &&
    !ownerNameIsSelectableV392(selectedOwner)
  ){
    selectedOwner='';
    if(el('ownerSelect'))el('ownerSelect').value='';
    page=0;
    await loadPanel()
  }
}



let coordinatorAdminSelectedIdV211='';
let coordinatorAdminTeamRowsV211=[];

function coordinatorAreaOptionsV211(current=''){
  const areas=[...new Set(
    (catalogo||[])
      .filter(x=>x.activo!==false && norm(x.tipo||'')!=='PERSONAL')
      .map(x=>String(x.nombre||'').trim())
      .filter(Boolean)
  )].sort((a,b)=>a.localeCompare(b,'es'));

  if(current && !areas.some(x=>norm(x)===norm(current))){
    areas.unshift(current);
  }

  return areas;
}

async function openCoordinatorTeamModalV211(id){
  if(!isAdmin()){
    alert('Solo el ADMINISTRADOR puede configurar equipos.');
    return;
  }

  coordinatorAdminSelectedIdV211=id;

  const profile=(userProfiles||[]).find(x=>String(x.id)===String(id));

  el('coordinatorTeamTitleV211').textContent=
    `Equipo · ${profile?.nombre_personal||profile?.email||'COORDINADOR'}`;

  el('coordinatorTeamStatusV211').textContent='Cargando configuración...';
  el('coordinatorTeamModalV211').classList.add('show');

  await loadCoordinatorTeamAdminV211();
}

function closeCoordinatorTeamModalV211(){
  el('coordinatorTeamModalV211').classList.remove('show');
  coordinatorAdminSelectedIdV211='';
  coordinatorAdminTeamRowsV211=[];
}

async function loadCoordinatorTeamAdminV211(){
  if(!coordinatorAdminSelectedIdV211)return;

  const [coordResult,teamResult]=await Promise.all([
    sb.rpc('v211_admin_listar_coordinadores'),
    sb.rpc(
      'v211_admin_listar_equipo',
      {p_coordinador_id:coordinatorAdminSelectedIdV211}
    )
  ]);

  if(coordResult.error){
    el('coordinatorTeamStatusV211').textContent=coordResult.error.message;
    return;
  }

  if(teamResult.error){
    el('coordinatorTeamStatusV211').textContent=teamResult.error.message;
    return;
  }

  const config=(coordResult.data||[]).find(
    x=>String(x.coordinador_id)===String(coordinatorAdminSelectedIdV211)
  )||{};

  coordinatorAdminTeamRowsV211=teamResult.data||[];

  const area=String(config.area||'').trim();
  const areas=coordinatorAreaOptionsV211(area);

  el('coordinatorAreaSelectV211').innerHTML=
    '<option value="">— Seleccione área —</option>'+
    areas.map(a=>
      `<option value="${esc(a)}" ${norm(a)===norm(area)?'selected':''}>${esc(a)}</option>`
    ).join('');

  const currentMembers=new Set(
    coordinatorAdminTeamRowsV211.map(x=>String(x.supervisado_id))
  );

  const candidates=(userProfiles||[])
    .filter(x=>{
      if(
        x.activo===false ||
        String(x.id)===String(coordinatorAdminSelectedIdV211) ||
        norm(x.rol||'')!=='USUARIO' ||
        currentMembers.has(String(x.id))
      )return false;

      // V298: un integrante solo puede ser agregado al equipo de un coordinador
      // cuando su Área de trabajo coincide con el área configurada del coordinador.
      const person=catalogPersonByName(x.nombre_personal||'');
      const personArea=String(person?.area_trabajo||'').trim();
      if(area && areaMatchKey(personArea)!==areaMatchKey(area))return false;

      return true;
    })
    .sort((a,b)=>
      String(a.nombre_personal||a.email||'')
        .localeCompare(String(b.nombre_personal||b.email||''),'es')
    );

  el('coordinatorMemberSelectV211').innerHTML=
    '<option value="">— Seleccione personal —</option>'+
    candidates.map(x=>
      `<option value="${esc(String(x.id))}">${esc(x.nombre_personal||x.email||'SIN NOMBRE')}</option>`
    ).join('');

  renderCoordinatorTeamAdminV211();

  el('coordinatorTeamStatusV211').textContent=
    area
      ?`Área configurada: ${area}.`
      :'Defina el área del coordinador.';
}

function renderCoordinatorTeamAdminV211(){
  const rows=coordinatorAdminTeamRowsV211||[];

  el('coordinatorTeamCountV211').textContent=
    `${rows.length} integrante${rows.length===1?'':'s'}`;

  if(!rows.length){
    el('coordinatorTeamTableV211').innerHTML=
      '<div class="empty">Este coordinador todavía no tiene personal asignado.</div>';
    return;
  }

  el('coordinatorTeamTableV211').innerHTML=`<table>
    <thead>
      <tr>
        <th>Personal</th>
        <th>Correo</th>
        <th>Área</th>
        <th>Acción</th>
      </tr>
    </thead>
    <tbody>
      ${rows.map(x=>`
        <tr>
          <td><b>${esc(x.nombre_personal||'—')}</b></td>
          <td>${esc(x.email||'—')}</td>
          <td>${esc(x.area||'—')}</td>
          <td>
            <button class="btn secondary small"
                    onclick="removeCoordinatorMemberV211('${x.supervisado_id}')">
              Quitar del equipo
            </button>
          </td>
        </tr>
      `).join('')}
    </tbody>
  </table>`;
}

async function saveCoordinatorAreaV211(){
  if(!isAdmin()||!coordinatorAdminSelectedIdV211)return;

  const area=String(el('coordinatorAreaSelectV211')?.value||'').trim();

  if(!area){
    el('coordinatorTeamStatusV211').textContent='Seleccione un área.';
    return;
  }

  el('coordinatorTeamStatusV211').textContent='Guardando área...';

  const {error}=await sb.rpc(
    'v211_admin_configurar_coordinador',
    {
      p_coordinador_id:coordinatorAdminSelectedIdV211,
      p_area:area,
      p_activo:true
    }
  );

  if(error){
    el('coordinatorTeamStatusV211').textContent=error.message;
    return;
  }

  el('coordinatorTeamStatusV211').textContent='Área actualizada.';
  await Promise.all([
    loadUserProfiles(),
    loadCoordinatorTeamAdminV211()
  ]);
}

async function addCoordinatorMemberV211(){
  if(!isAdmin()||!coordinatorAdminSelectedIdV211)return;

  const supervisado=String(
    el('coordinatorMemberSelectV211')?.value||''
  ).trim();

  if(!supervisado){
    el('coordinatorTeamStatusV211').textContent='Seleccione una persona.';
    return;
  }

  el('coordinatorTeamStatusV211').textContent='Asignando personal...';

  const {error}=await sb.rpc(
    'v211_admin_asignar_supervisado',
    {
      p_coordinador_id:coordinatorAdminSelectedIdV211,
      p_supervisado_id:supervisado
    }
  );

  if(error){
    el('coordinatorTeamStatusV211').textContent=error.message;
    return;
  }

  el('coordinatorTeamStatusV211').textContent='Personal agregado al equipo.';
  await loadCoordinatorTeamAdminV211();
}

async function removeCoordinatorMemberV211(supervisadoId){
  if(!isAdmin()||!coordinatorAdminSelectedIdV211)return;

  if(!confirm('¿Quitar a esta persona del equipo del coordinador?'))return;

  const {error}=await sb.rpc(
    'v211_admin_quitar_supervisado',
    {
      p_coordinador_id:coordinatorAdminSelectedIdV211,
      p_supervisado_id:supervisadoId
    }
  );

  if(error){
    el('coordinatorTeamStatusV211').textContent=error.message;
    return;
  }

  el('coordinatorTeamStatusV211').textContent='Personal retirado del equipo.';
  await loadCoordinatorTeamAdminV211();
}

async function openUsersModal(){
  if(!isAdmin()){
    alert('Solo un ADMINISTRADOR puede cambiar permisos.');
    return;
  }

  el('usersModal').classList.add('show');
  el('usersStatus').textContent='Cargando usuarios...';
  await loadUserProfiles();
}

function closeUsersModal(){
  el('usersModal').classList.remove('show');
}

async function loadUserProfiles(){
  const {data,error}=await sb
    .from('perfiles_usuario')
    .select('*')
    .order('email');

  if(error){
    el('usersStatus').textContent=error.message;
    return;
  }

  userProfiles=data||[];
  renderUserProfiles();
  el('usersStatus').textContent=`${userProfiles.length} cuentas registradas.`;
}

function renderUserProfiles(){
  const personal=catalogo
    .filter(x=>x.activo!==false && x.tipo==='PERSONAL')
    .map(x=>x.nombre)
    .sort((a,b)=>a.localeCompare(b));

  if(!userProfiles.length){
    el('usersBody').innerHTML='<tr><td colspan="5" class="empty">No hay usuarios.</td></tr>';
    return;
  }

  el('usersBody').innerHTML=userProfiles.map(u=>{
    const nameOptions=['',...personal]
      .map(n=>`<option value="${esc(n)}" ${n===(u.nombre_personal||'')?'selected':''}>${n?esc(n):'— SIN ASOCIAR —'}</option>`)
      .join('');

    return `<tr>
      <td>
        <b>${esc(u.email||'')}</b>
        ${u.id===session.user.id?'<div class="note">Cuenta actual</div>':''}
      </td>
      <td>
        <select id="user-name-${u.id}">${nameOptions}</select>
      </td>
      <td>
        <select id="user-role-${u.id}">
          <option value="USUARIO" ${u.rol==='USUARIO'?'selected':''}>USUARIO</option>
          <option value="ARCHIVO" ${u.rol==='ARCHIVO'?'selected':''}>ARCHIVO</option>
          <option value="COORDINADOR" ${u.rol==='COORDINADOR'?'selected':''}>COORDINADOR</option>
          <option value="ADMINISTRADOR" ${u.rol==='ADMINISTRADOR'?'selected':''}>ADMINISTRADOR</option>
        </select>
        ${u.rol==='COORDINADOR'
          ?'<span class="coordinator-pilot-note">ROL REAL · ALCANCE EN SUPABASE</span>'
          :''
        }
      </td>
      <td style="text-align:center">
        <input type="checkbox" id="user-active-${u.id}" ${u.activo?'checked':''}>
      </td>
      <td>
        <div style="display:flex;gap:5px;justify-content:center;flex-wrap:wrap">
          <button class="btn secondary small" onclick="saveUserProfile('${u.id}')">Guardar</button>
          ${u.rol==='COORDINADOR'
            ?`<button class="btn secondary small" onclick="openCoordinatorTeamModalV211('${u.id}')">Equipo</button>`
            :''
          }
        </div>
      </td>
    </tr>`;
  }).join('');
}

async function saveUserProfile(id){
  if(!isAdmin())return;

  const nombre=el(`user-name-${id}`).value.trim()||null;
  const selectedRole=el(`user-role-${id}`).value;
  const activo=el(`user-active-${id}`).checked;

  const rol=selectedRole;

  if(rol==='COORDINADOR'){
    const person=catalogPersonByName(nombre||'');
    const inferredArea=String(person?.area_trabajo||'').trim();

    if(!inferredArea){
      el('usersStatus').textContent=
        'Para asignar el rol COORDINADOR, primero configure el área de trabajo de la persona en el catálogo.';
      return;
    }
  }

  if(rol==='USUARIO' && !nombre){
  }

  if(id===session.user.id && (!activo || rol!=='ADMINISTRADOR')){
  }

  const {error}=await sb
    .from('perfiles_usuario')
    .update({
      nombre_personal:nombre,
      rol,
      activo,
      updated_at:new Date().toISOString()
    })
    .eq('id',id);

  if(error){
    el('usersStatus').textContent=error.message;
    return;
  }

  if(rol==='COORDINADOR'){
    const person=catalogPersonByName(nombre||'');
    const inferredArea=String(person?.area_trabajo||'').trim();

    const configResult=await sb.rpc(
      'v211_admin_configurar_coordinador',
      {
        p_coordinador_id:id,
        p_area:inferredArea,
        p_activo:activo
      }
    );

    if(configResult.error){
      el('usersStatus').textContent=
        'Rol guardado, pero no se pudo configurar el área del coordinador: '+
        configResult.error.message;
      return;
    }
  }

  el('usersStatus').textContent='Permisos actualizados.';
  await Promise.all([
    loadUserProfiles(),
    loadAbogadoProfiles()
  ]);
  await loadReassignmentProfiles();
  fillSelects();
  renderArchiveStaffSelects();
  renderSidebar();

  if(id===session.user.id){
    await loadMyProfile();
    applyRoleUI();
  }
}

async function loadSummary(){
  if(isLimitedUser()){
    await loadUserPersonalSummary();
    return;
  }

  const {data,error}=await sb.rpc('resumen_responsables');
  if(error){serverError(error);return}
  summaryRows=data||[];
  renderSidebar();renderSummary();renderKpis()
}

function reassignedAwayFromCurrentUser(r){
  if(!isLimitedUser() || r?._internal_reassign_requested)return false;

  const mine=norm(currentProfile?.nombre_personal||'');
  if(!mine)return false;

  const action=norm(r?.ultimo_movimiento||'');
  const from=norm(r?.ultimo_movimiento_desde||'');
  const to=norm(r?.ultimo_movimiento_hacia||'');

  // Cuando la última acción es una REASIGNACIÓN desde el usuario actual
  // hacia otra persona, el expediente ya no forma parte de su custodia.
  // Solo debe conservarse en la tarjeta histórica "Reasignados por mí".
  return action.includes('REASIGNACIÓN') && from===mine && !!to && to!==mine;
}



// ============================================================
// V207 · COORDINADOR HÍBRIDO SIN ROMPER RLS / RPC
//
// Marcela conserva en Supabase el rol ARCHIVO durante el piloto.
// Por eso su "espacio personal" no debe invocar RPCs que exigen que
// la cuenta tenga un perfil USUARIO activo.
//
// En V207, cuando Marcela está en su espacio PERSONAL:
//   - la interfaz sigue siendo la del perfil USUARIO;
//   - los datos se consultan con las funciones administrativas;
//   - todas las consultas se restringen explícitamente a MARCELA ALONZO.
// ============================================================

function coordinatorSelfNameV207(){
  return String(currentProfile?.nombre_personal||'').trim();
}

function coordinatorSelfAdminTypeV207(type){
  const map={
    TODOS:'CUSTODIA',
    CUSTODIA:'CUSTODIA',
    PRESTAMO:'PRESTAMO',
    REASIGNADOS_A_MI:'REASIGNADOS_A_MI',
    PENDIENTES_POR_ATENDER:'PENDIENTES_POR_ATENDER',
    DEVOLUCION_SOLICITADA:'DEVOLUCION_SOLICITADA',
    DEVUELTOS:'DEVUELTOS_AL_ARCHIVO',
    DEVUELTOS_AL_ARCHIVO:'DEVUELTOS_AL_ARCHIVO',
    ALERTAS_30:'ALERTAS_30',
    REASIGNADOS_POR_MI:'REASIGNADOS_POR_MI'
  };
  return map[String(type||'').toUpperCase()]||String(type||'').toUpperCase();
}

async function coordinatorReassignedByRowsV207(search=''){
  if(!sb||!session||!isCoordinatorSelfWorkspaceV206())return [];

  const name=coordinatorSelfNameV207();
  if(!name)return [];

  const {data,error}=await coordinatorCardRpcV404({
      p_nombre:name,
      p_tipo:'REASIGNADOS_POR_MI',
      p_busqueda:cleanSearch(search||'')||null
    });

  if(error){
    console.warn('V404 · REASIGNADOS_POR_MI:',error.message);
    throw error;
  }

  return v211JsonRows(data);
}

async function coordinatorSelfCardRowsV207(type,search=''){
  if(!sb||!session||!isCoordinatorSelfWorkspaceV206())return [];

  const name=coordinatorSelfNameV207();
  if(!name)return [];

  const normalized=String(type||'').toUpperCase();
  const pTipo=coordinatorSelfAdminTypeV207(normalized);

  const {data,error}=await coordinatorCardRpcV404({
      p_nombre:name,
      p_tipo:pTipo,
      p_busqueda:cleanSearch(search||'')||null
    });

  if(error){
    console.warn(
      `V404 · ${normalized} de ${name}:`,
      error.message
    );
    throw error;
  }

  return v211JsonRows(data);
}

// V312 · corrección: el pendiente propio usa pendingRowsSelfV310.length.
async function coordinatorSelfSummaryV207(){
  if(!sb||!session||!isCoordinatorSelfWorkspaceV206())return null;

  const name=coordinatorSelfNameV207();
  if(!name)return null;

  const [summaryResult,pendingRowsSelfV310]=await Promise.all([
    sb.rpc('v646_resumen_usuarios_agrupado',{p_nombres:[name]}),
    coordinatorSelfCardRowsV207('PENDIENTES_POR_ATENDER','').catch(error=>{
      console.warn('V646 · pendientes propios del coordinador:',error?.message||error);
      return null;
    })
  ]);

  if(summaryResult.error)throw summaryResult.error;
  const grouped=Array.isArray(summaryResult.data)?summaryResult.data:[];
  const s=grouped.find(x=>norm(x?.nombre||'')===norm(name))||grouped[0]||{};

  await loadInternalReassignRequests(true);

  return {
    todos:Number(s.total_custodia||0),
    en_prestamo:Number(s.en_prestamo||0),
    pendientes_por_atender:Array.isArray(pendingRowsSelfV310)
      ?pendingRowsSelfV310.length
      :Number(s.pendientes_por_atender||0),
    devolucion_solicitada:Number(s.devolucion_solicitada||0),
    reasignados_por_mi:Number(s.reasignados_por_mi||0),
    reasignados_a_mi:Number(s.reasignados_a_mi||0),
    devueltos:Number(s.devueltos_al_archivo||0),
    alertas_30:Number(s.alertas_30||0),
    solicitudes_reasignacion:receivedPendingReassignRowsV196().length,
    reasignaciones_solicitadas_por_mi:sentPendingReassignRowsV197().length
  };
}

// Perfil USUARIO · Total en custodia = EN PRÉSTAMO + REASIGNADO.
// Usa la misma lógica V5 de custodia resuelta que ADMINISTRADOR / ARCHIVO.
async function loadMyCurrentCustodyRows(search=''){
  if(!sb||!session||!isLimitedUser())return [];

  if(isCoordinatorSelfWorkspaceV206()){
    return coordinatorSelfCardRowsV207('CUSTODIA',search);
  }

  if(isStaffPersonalWorkspaceV319()){
    try{return await staffSelfCardRowsV320('CUSTODIA',search);}
    catch(error){console.warn('V320 · CUSTODIA propia:',error?.message||error);return [];}
  }

  const {data,error}=await sb.rpc(
    'listar_mis_custodia_actual',
    {
      p_tipo:'CUSTODIA',
      p_busqueda:cleanSearch(search||'')||null
    }
  );

  if(error){
    console.warn('listar_mis_custodia_actual:',error.message);
    return [];
  }

  const rows=Array.isArray(data)?data:[];
  return applyV171CanonicalCustody(rows,{overwriteResponsible:true,overwriteLocation:true,filterOutside:true});
}

async function loadMyHistoricalReturns(search=''){
  if(!sb||!session||!isLimitedUser())return [];

  if(isCoordinatorSelfWorkspaceV206()){
    return coordinatorSelfCardRowsV207(
      'DEVUELTOS_AL_ARCHIVO',
      search
    );
  }

  if(isStaffPersonalWorkspaceV319()){
    try{return await staffSelfCardRowsV320('DEVUELTOS_AL_ARCHIVO',search);}
    catch(error){console.warn('V320 · DEVUELTOS propios:',error?.message||error);return [];}
  }

  const {data,error}=await sb.rpc(
    'listar_mis_devoluciones_historicas',
    {
      p_busqueda:cleanSearch(search||'')||null
    }
  );

  if(error){
    console.warn('listar_mis_devoluciones_historicas:',error.message);
    return [];
  }

  return normalizeHistoricalReturnRows(data);
}

async function loadMyPendingAttentionRows(search=''){
  if(!sb||!session||!isLimitedUser())return [];

  const me=String(currentProfile?.nombre_personal||'').trim();

  if(isCoordinatorSelfWorkspaceV206()){
    let rows=await coordinatorSelfCardRowsV207(
      'PENDIENTES_POR_ATENDER',
      search
    );

    rows=await enrichPendingAttentionRequestTimes(rows||[]);
    return sortPendingAttentionByDateDesc(rows||[]);
  }

  if(isStaffPersonalWorkspaceV319()){
    let rows=[];
    try{rows=await staffSelfCardRowsV320('PENDIENTES_POR_ATENDER',search);}catch(error){
      console.warn('V320 · PENDIENTES propios:',error?.message||error);
      return [];
    }
    rows=await enrichPendingAttentionRequestTimes(rows||[]);
    return sortPendingAttentionByDateDesc(rows||[]);
  }

  // V183:
  // "Pendientes por atender" incluye:
  //   A) expedientes ya listos para ser atendidos por Archivo;
  //   B) expedientes ya solicitados por el usuario pero que todavía están
  //      bajo custodia de otro usuario y deben retornar primero a Archivo.
  const [pendingResult,waitResult]=await Promise.allSettled([
    sb.rpc('listar_pendientes_por_atender_inclusivo'),
    loadCrossAreaWaits(true)
  ]);

  let rows=[];

  if(pendingResult.status==='fulfilled'){
    const response=pendingResult.value;
    if(response?.error){
      console.warn(
        'listar_pendientes_por_atender_inclusivo:',
        response.error.message
      );
    }else{
      rows=(response?.data||[])
        .filter(r=>norm(r.solicitante||'')===norm(me))
        .map(r=>({...r,_v183_pending_source:'ARCHIVO'}));
    }
  }else{
    console.warn(
      'listar_pendientes_por_atender_inclusivo:',
      pendingResult.reason?.message||pendingResult.reason
    );
  }

  // Esperas vinculadas a solicitudes realizadas por este usuario.
  const waitRows=(crossAreaWaitRows||[])
    .filter(w=>
      !!w.es_solicitante_destino ||
      norm(w.solicitante_destino||'')===norm(me)
    )
    .filter(w=>
      ['SOLICITADA','DEVOLUCIÓN SOLICITADA']
        .includes(norm(w.estado||''))
    )
    .map(w=>({
      id:w.expediente_id||w.id||'',
      expediente_id:w.expediente_id||w.id||'',
      expediente:w.expediente||'—',
      extension:w.extension||'',
      rd:w.rd||'',
      ultimo_folio:w.ultimo_folio||'',
      solicitud_id:w.solicitud_destino_id||w.solicitud_id||null,
      solicitud_numero:w.solicitud_numero||'—',
      solicitante:w.solicitante_destino||me,
      asunto:w.asunto||'SOLICITUD DE EXPEDIENTE',
      observacion:w.observacion||'',
      solicitud_created_at:
        w.fecha_solicitud||
        w.created_at||
        w.fecha_registro||
        null,
      created_at:
        w.fecha_solicitud||
        w.created_at||
        w.fecha_registro||
        null,
      responsable_actual:w.responsable_actual||'',
      area_actual:w.area_actual||'',
      estado:'PENDIENTE POR ATENDER',
      _cross_wait:w,
      _v183_pending_source:'OTRO_USUARIO'
    }));

  // Evitar duplicar el mismo expediente dentro de la misma solicitud.
  const merged=new Map();
  [...rows,...waitRows].forEach(r=>{
    const key=[
      String(r.solicitud_id||r.solicitud_numero||''),
      String(r.expediente_id||r.id||r.expediente||'')
    ].join('::');

    if(!merged.has(key)){
      merged.set(key,r);
      return;
    }

    const current=merged.get(key);
    if(!current._cross_wait && r._cross_wait){
      current._cross_wait=r._cross_wait;
      current._v183_pending_source='OTRO_USUARIO';
    }
    if(!current.responsable_actual && r.responsable_actual){
      current.responsable_actual=r.responsable_actual;
    }
  });

  let result=[...merged.values()];

  const q=norm(search||'');
  if(q){
    result=result.filter(r=>[
      r.expediente,
      r.extension,
      r.rd,
      r.ultimo_folio,
      r.solicitud_numero,
      r.asunto,
      r.observacion,
      r.solicitante,
      r.responsable_actual
    ].some(v=>norm(v||'').includes(q)));
  }

  // V189 · completar la HORA REAL de la solicitud.
  // listar_pendientes_por_atender_inclusivo puede devolver solo la fecha.
  // Por eso recuperamos created_at desde solicitudes_prestamo usando
  // solicitud_id / solicitud_numero antes de pintar la tabla.
  result=await enrichPendingAttentionRequestTimes(result);

  return sortPendingAttentionByDateDesc(result);
}

async function countMyPendingAttentionItems(){
  const rows=await loadMyPendingAttentionRows('');
  return rows.length;
}

const pendingRequestHeaderStatesV163=new Set([
  'REGISTRADA POR ARCHIVO',
  'ACEPTADO',
  'PENDIENTE POR ATENDER',
  'ENTREGA PARCIAL'
]);

function requestPendingUnitsV163(row){
  // V720 · La misma clasificación alimenta tarjeta, filtro y resumen por usuario.
  // No incluir solicitudes cerradas ni copias digitales completamente atendidas.
  const head=norm(row?.estado||'');
  const terminal=new Set([
    'CERRADO POR ADMINISTRADOR','CERRADA POR ADMINISTRADOR',
    'CERRADO POR ARCHIVO','CERRADA POR ARCHIVO',
    'CANCELADO','CANCELADA','ANULADO','ANULADA','DEVUELTO',
    'COPIA DIGITAL ENTREGADA'
  ]);
  if(terminal.has(head))return 0;
  const state=norm(row?.estado_atencion||row?.estado||'');
  if(['ENTREGA TOTAL','CERRADA POR ARCHIVO','CERRADO POR ARCHIVO',
     'CERRADO POR ADMINISTRADOR','CERRADA POR ADMINISTRADOR'].includes(state))return 0;

  const total=Math.max(0,Number(row?.total_expedientes||0));
  const waiting=Math.max(0,Number(row?._cross_wait_count||0));
  const closed=Math.max(0,Number(row?._admin_closed_count||0));
  // Cuando están completos los vínculos, priorizar el detalle REAL del ciclo.
  // Cuando faltan datos por permisos/error, conservar los contadores de la RPC.
  const attended=row?._v720_items_complete===true
    ?Math.max(0,Number(row?._v720_attended_item_count||0))
    :Math.max(0,Number(row?.atendidos||0))+
      Math.max(0,Number(row?._v720_digital_delivered_count||0));
  if(state==='EN ESPERA DE DEVOLUCIÓN' && !waiting)return 0;
  return Math.max(0,total-attended-waiting-closed);
}

function requestCountsAsPendingAttentionV163(row){
  return requestPendingUnitsV163(row)>0;
}

async function loadPendingRequestCountMapBySolicitanteV163(){
  if(!sb||!session)return new Map();
  const {data,error}=await sb.rpc('listar_solicitudes_prestamo',{
    p_busqueda:null,p_estado:null
  });
  if(error){
    console.warn('Conteo de solicitudes pendientes por atender:',error.message);
    return new Map();
  }
  const rows=await applyAdminClosedStateToRequests(
    requestsVisibleForCurrentProfile(data||[])
  );
  const counts=new Map();
  rows.forEach(r=>{
    if(!requestCountsAsPendingAttentionV163(r))return;
    const name=String(r.solicitante||'').trim();
    if(name)counts.set(name,Number(counts.get(name)||0)+1);
  });
  return counts;
}

async function loadPendingItemCountMapBySolicitanteV165(){
  if(!sb||!session)return new Map();
  await loadCrossAreaWaits(true);
  const {data,error}=await sb.rpc('listar_solicitudes_prestamo',{
    p_busqueda:null,p_estado:null
  });
  if(error){
    console.warn('Conteo de expedientes pendientes por atender:',error.message);
    return new Map();
  }
  const rows=enrichRequestsWithCrossAreaWait(
    await applyAdminClosedStateToRequests(
      requestsVisibleForCurrentProfile(data||[])
    )
  );
  const counts=new Map();
  for(const r of rows){
    const n=requestPendingUnitsV163(r);
    const name=String(r?.solicitante||'').trim();
    if(n>0&&name)counts.set(name,Number(counts.get(name)||0)+n);
  }
  return counts;
}

async function loadMyReassignedByRows(search=''){
  if(!sb||!session||!isLimitedUser())return [];

  // V637 · Una sola fuente para todos los perfiles.
  // Supabase ya devuelve exclusivamente las reasignaciones ACTIVAS cuyo
  // último cambio efectivo de custodia fue una reasignación hecha por el usuario.
  // No se vuelve a consultar movimientos_prestamo desde el navegador.
  if(isCoordinatorSelfWorkspaceV206()){
    return await coordinatorReassignedByRowsV207(search);
  }

  if(isStaffPersonalWorkspaceV319()){
    try{
      return await staffSelfCardRowsV320('REASIGNADOS_POR_MI',search);
    }catch(error){
      console.warn('V637 · REASIGNADOS_POR_MI ARCHIVO/ADMIN:',error?.message||error);
      throw error;
    }
  }

  const {data,error}=await sb.rpc(
    'listar_mi_tarjeta_v5',
    {
      p_tipo:'REASIGNADOS_POR_MI',
      p_busqueda:cleanSearch(search||'')||null
    }
  );

  if(error){
    console.warn('V637 · REASIGNADOS_POR_MI:',error.message);
    throw error;
  }

  return Array.isArray(data)?data:[];
}

function openMyPendingAttentionFromPanel(){
  const tab=document.querySelector('.tab[data-tab="requests"]');
  if(tab) switchTab('requests',tab);
  if(el('requestStateFilter'))el('requestStateFilter').value='PENDIENTES_POR_ATENDER_ITEMS';
  loadRequests();
}

// ============================================================
// V184 · TARJETAS DEL PERFIL USUARIO MÁS RÁPIDAS
// Guarda temporalmente los últimos contadores en sessionStorage.
// Al volver a Mis expedientes, las tarjetas se pintan de inmediato y
// se actualizan silenciosamente contra Supabase.
// ============================================================
const V184_USER_SUMMARY_TTL=120000; // V736: evitar indicadores de devoluciones antiguos
let v184UserSummaryFlight=null;

function v184UserSummaryStorageKey(){
  return [
    'v637_user_summary',
    String(session?.user?.id||'anon'),
    isCoordinatorSelfWorkspaceV206()?'COORDINADOR_SELF':'USUARIO'
  ].join('_');
}

function applyUserSummaryV184(s){
  if(!s)return;

  userPanelSummary={
    todos:Number(s.todos||0),
    en_prestamo:Number(s.en_prestamo||0),
    pendientes_por_atender:Number(s.pendientes_por_atender||0),
    devolucion_solicitada:Number(s.devolucion_solicitada||0),
    reasignados_por_mi:Number(s.reasignados_por_mi||0),
    reasignados_a_mi:Number(s.reasignados_a_mi||0),
    devueltos:Number(s.devueltos||0),
    alertas_30:Number(s.alertas_30||0),
    solicitudes_reasignacion:Number(
      s.solicitudes_reasignacion ??
      receivedPendingReassignRowsV196().length ??
      0
    ),
    reasignaciones_solicitadas_por_mi:Number(
      s.reasignaciones_solicitadas_por_mi ??
      sentPendingReassignRowsV197().length ??
      0
    )
  };

  if(el('uKAll'))el('uKAll').textContent=userPanelSummary.todos;
  if(el('uKLoan'))el('uKLoan').textContent=userPanelSummary.en_prestamo;
  if(el('uKPendingAttention'))el('uKPendingAttention').textContent=userPanelSummary.pendientes_por_atender;
  if(el('uKReturnRequested'))el('uKReturnRequested').textContent=userPanelSummary.devolucion_solicitada;
  if(el('uKReassignedBy'))el('uKReassignedBy').textContent=userPanelSummary.reasignados_por_mi;
  if(el('uKReassignedTo'))el('uKReassignedTo').textContent=userPanelSummary.reasignados_a_mi;
  if(el('uKReturned'))el('uKReturned').textContent=userPanelSummary.devueltos;
  if(el('uKAlert'))el('uKAlert').textContent=userPanelSummary.alertas_30;
  if(el('uKReassignRequests')){
    el('uKReassignRequests').textContent=
      Number(userPanelSummary.solicitudes_reasignacion||0);
  }

  if(el('uKReassignSent')){
    el('uKReassignSent').textContent=
      Number(userPanelSummary.reasignaciones_solicitadas_por_mi||0);
  }

  updateReassignRequestsCardV196();
  updateReassignSentCardV197();
  updateUserPersonalKpiUI();

  // V712 · Si la tarjeta cambió de cantidad mientras la tabla conserva
  // un snapshot antiguo, invalidarlo inmediatamente.
  try{
    const key=v179PanelCacheKey();
    const snap=v179PanelViewCache?.get?.(key) || v353LoadStoredPanelSnapshot(key);
    if(snap && !v712SnapshotMatchesCurrentCard(snap)){
      v712DiscardPanelSnapshot(key);
    }
  }catch(_){}
}

function restoreUserSummaryV184(){
  try{
    const raw=sessionStorage.getItem(v184UserSummaryStorageKey());
    if(!raw)return false;

    const saved=JSON.parse(raw);
    if(!saved?.summary)return false;

    const age=Date.now()-Number(saved.savedAt||0);
    if(age>V184_USER_SUMMARY_TTL)return false;

    applyUserSummaryV184(saved.summary);
    return true;
  }catch(_){
    return false;
  }
}

function saveUserSummaryV184(summary){
  try{
    sessionStorage.setItem(
      v184UserSummaryStorageKey(),
      JSON.stringify({savedAt:Date.now(),summary})
    );
  }catch(_){}
}

async function refreshUserSummaryV184(){
  if(v184UserSummaryFlight)return v184UserSummaryFlight;

  v184UserSummaryFlight=(async()=>{
    if(isStaffPersonalWorkspaceV319()){
      const summary=await staffSelfSummaryV320();
      applyUserSummaryV184(summary);
      saveUserSummaryV184(summary);
      return summary;
    }

    if(isCoordinatorSelfWorkspaceV206()){
      const summary=await coordinatorSelfSummaryV207();
      applyUserSummaryV184(summary);
      saveUserSummaryV184(summary);
      return summary;
    }

    const me=String(currentProfile?.nombre_personal||'').trim();
    const [{data,error},pendingAttentionCount]=await Promise.all([
      sb.rpc('v646_resumen_usuarios_agrupado',{p_nombres:me?[me]:null}),
      countMyPendingAttentionItems(),
      loadInternalReassignRequests(true)
    ]);

    if(error)throw error;

    const grouped=Array.isArray(data)?data:[];
    const s=grouped.find(x=>norm(x?.nombre||'')===norm(me))||grouped[0]||{};

    const summary={
      todos:Number(s.total_custodia||0),
      en_prestamo:Number(s.en_prestamo||0),
      pendientes_por_atender:Number(pendingAttentionCount||0),
      devolucion_solicitada:Number(s.devolucion_solicitada||0),
      reasignados_por_mi:Number(s.reasignados_por_mi||0),
      reasignados_a_mi:Number(s.reasignados_a_mi||0),
      devueltos:Number(s.devueltos_al_archivo||0),
      alertas_30:Number(s.alertas_30||0),
      solicitudes_reasignacion:receivedPendingReassignRowsV196().length,
      reasignaciones_solicitadas_por_mi:sentPendingReassignRowsV197().length
    };

    applyUserSummaryV184(summary);
    saveUserSummaryV184(summary);
    return summary;
  })();

  try{
    return await v184UserSummaryFlight;
  }finally{
    v184UserSummaryFlight=null;
  }
}

async function loadUserPersonalSummary(){
  if(!sb||!session||!isLimitedUser())return;

  // V476 · En el espacio personal de ARCHIVO/ADMINISTRADOR las tarjetas
  // de reasignación son operativas y deben consultarse frescas.
  if(isStaffPersonalWorkspaceV319()){
    try{
      const summary=await staffSelfSummaryV320();
      applyUserSummaryV184(summary);
      saveUserSummaryV184(summary);
      return summary;
    }catch(error){
      console.warn('V476 · resumen personal ARCHIVO/ADMIN:',error?.message||error);
    }
  }

  const restored=restoreUserSummaryV184();

  if(restored){
    // No bloquear la pantalla: refrescar detrás.
    refreshUserSummaryV184().catch(error=>
      console.warn('Actualización silenciosa de tarjetas:',error?.message||error)
    );
    return userPanelSummary;
  }

  try{
    return await refreshUserSummaryV184();
  }catch(error){
    console.warn('resumen_mis_tarjetas_v5:',error?.message||error);

    ['uKAll','uKLoan','uKPendingAttention','uKReturnRequested',
     'uKReassignRequests','uKReassignSent','uKReassignedBy','uKReassignedTo','uKReturned','uKAlert']
      .forEach(id=>{
        if(el(id))el(id).textContent='—';
      });
  }
}

function areaMatchKey(v){
  return norm(v||'')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g,'');
}

function catalogPersonByName(name){
  const key=norm(name||'');
  return (catalogo||[]).find(x=>
    x.activo!==false &&
    norm(x.tipo)==='PERSONAL' &&
    norm(x.nombre)===key
  )||null;
}

function catalogAreaByName(name){
  const key=areaMatchKey(name||'');
  return (catalogo||[]).find(x=>
    x.activo!==false &&
    norm(x.tipo)!=='PERSONAL' &&
    areaMatchKey(x.nombre)===key
  )||null;
}

function userBelongsToArea(userName,areaName){
  if(!areaName)return true;
  const person=catalogPersonByName(userName);
  return !!(
    person &&
    areaMatchKey(person.area_trabajo||'')===areaMatchKey(areaName)
  );
}

function ownerCardsMode(){
  // V779: el espacio TEAM del coordinador es de lectura supervisada,
  // distinto del acceso global de Archivo/Administrador. La autorización
  // de cada integrante se valida mediante V211 y las RPC V409/V412.
  return !!(
    (hasFullAccess() && !isLimitedUser()) ||
    isCoordinatorTeamWorkspaceV206()
  );
}

// ============================================================
// V392 · VALIDACIÓN ÚNICA DE USUARIO / ABOGADO SELECCIONABLE
// Antes varias rutas dependían de abogadoNames().includes(nombre).
// Eso dejaba fuera tarjetas agregadas por jerarquía, catálogo o pendientes.
// ============================================================
function ownerNameIsSelectableV392(name){
  const key=norm(String(name||'').trim());
  if(!key)return false;

  const sources=[];

  try{
    sources.push(...(abogadoNames()||[]));
  }catch(_){}

  try{
    sources.push(
      ...(Array.isArray(ownerCardsRows)
        ?ownerCardsRows.map(x=>x?.nombre)
        :[])
    );
  }catch(_){}

  try{
    sources.push(
      ...(Array.isArray(catalogo)
        ?catalogo
          .filter(x=>x?.activo!==false && norm(x?.tipo)==='PERSONAL')
          .map(x=>x?.nombre)
        :[])
    );
  }catch(_){}

  try{
    sources.push(
      ...(Array.isArray(abogadoProfiles)
        ?abogadoProfiles.map(x=>x?.nombre_personal)
        :[])
    );
  }catch(_){}

  return sources.some(value=>
    norm(String(value||'').trim())===key
  );
}

function canonicalOwnerNameV392(name){
  const raw=String(name||'').trim();
  const key=norm(raw);
  if(!key)return '';

  const candidates=[];

  try{
    candidates.push(
      ...(Array.isArray(ownerCardsRows)
        ?ownerCardsRows.map(x=>x?.nombre)
        :[])
    );
  }catch(_){}

  try{
    candidates.push(...(abogadoNames()||[]));
  }catch(_){}

  try{
    candidates.push(
      ...(Array.isArray(catalogo)
        ?catalogo
          .filter(x=>x?.activo!==false && norm(x?.tipo)==='PERSONAL')
          .map(x=>x?.nombre)
        :[])
    );
  }catch(_){}

  const found=candidates.find(value=>
    norm(String(value||'').trim())===key
  );

  return String(found||raw).trim();
}

function updateOwnerPanelVisibility(){
  const cardsAvailable=ownerCardsMode();

  syncCoordinatorScopeSearchUIV229();
  const limited=isLimitedUser();
  const otherUser=typeof v629IsOtherUser==='function' && v629IsOtherUser();
  // V780 · TEAM se inicia como relación completa, jamás como el usuario propio.
  const teamOverviewV780=isCoordinatorTeamWorkspaceV206() &&
    (!selectedOwner || norm(selectedOwner)===norm(currentProfile?.nombre_personal||''));
  if(teamOverviewV780){
    // V781: direct-owner CSS overrides 'hidden'; strip stale forced display.
    document.body.classList.remove('v631-direct-owner','v631-no-owner');
    document.querySelector('.app')?.classList.remove('v631-direct-owner');
    el('ownerCardsPanel')?.style.removeProperty('display');
    el('ownerDetailFilters')?.style.removeProperty('display');
  }
  const individualUser=selectedOwnerIsUser() && !teamOverviewV780;
  const showDetail=!teamOverviewV780 && (limited||individualUser||otherUser);

  if(el('ownerCardsPanel')){
    const showCards=cardsAvailable && !showDetail;
    el('ownerCardsPanel').classList.toggle('hidden-by-role',!showCards);
    el('ownerCardsPanel').classList.toggle('hidden',!showCards);
  }

  if(el('ownerDetailFilters')){
    el('ownerDetailFilters').classList.toggle('hidden',!showDetail);
  }

  if(el('selectedOwnerDisplay')){
    const selfName=currentProfile?.nombre_personal||'';
    const target=teamOverviewV780?'':(selectedOwner||selfName);
    if(document.activeElement!==el('selectedOwnerDisplay')){
      el('selectedOwnerDisplay').value=target;
    }
  }

  if(el('ownerBackWrap')){
    el('ownerBackWrap').classList.toggle('hidden',limited?!otherUser:!individualUser);
    const btn=el('ownerBackWrap')?.querySelector('button');
    if(btn && limited)btn.textContent='← Volver a mi usuario';
  }

  if(el('ownerSelectedContext')){
    el('ownerSelectedContext').classList.add('hidden');
  }

  if(el('fullAccessKpis')){
    const showStaffCards=individualUser||otherUser;
    el('fullAccessKpis').classList.toggle('hidden',!showStaffCards);
    el('fullAccessKpis').classList.toggle('owner-user-kpis',showStaffCards);
  }

  if(el('userPersonalKpis')){
    el('userPersonalKpis').classList.toggle('hidden',limited&&otherUser);
  }

  if(el('panelDetailWrap')){
    el('panelDetailWrap').classList.toggle('hidden',!showDetail);
  }

  if(el('ownerStateField')){
    el('ownerStateField').classList.toggle('hidden',limited&&!otherUser);
  }

  if(el('ownerStateLabel')){
    el('ownerStateLabel').textContent=(limited&&!otherUser)?'':'Estado del expediente';
  }

  if(el('ownerStateFilter')){
    if(limited&&!otherUser){
      const current=userPanelMode||'TODOS';
      el('ownerStateFilter').innerHTML=`
        <option value="TODOS_EXPEDIENTES">TODOS LOS EXPEDIENTES</option>
        <option value="TODOS">TOTAL EN CUSTODIA</option>
        <option value="PRESTAMO">PRÉSTAMOS</option>
        <option value="REASIGNADOS_A_MI">REASIGNADOS</option>
        <option value="PENDIENTES_POR_ATENDER">PENDIENTES POR ATENDER</option>
        <option value="DEVOLUCION_SOLICITADA">SOLICITUDES DE DEVOLUCIÓN</option>
        <option value="DEVUELTOS">DEVUELTOS AL ARCHIVO</option>
        <option value="REASIGNADOS_POR_MI">REASIGNADOS POR MÍ</option>
        <option value="ALERTAS_30">ALERTAS &gt; 30 DÍAS</option>`;
      el('ownerStateFilter').value=current;
    }else if(individualUser||otherUser){
      const current=['custody','loan','reassigned','pending_attention','pending','returns','alert'].includes(panelQuickFilter)
        ?panelQuickFilter
        :'custody';
      el('ownerStateFilter').innerHTML=`
        <option value="custody">TOTAL EN CUSTODIA</option>
        <option value="loan">EN PRÉSTAMO</option>
        <option value="reassigned">REASIGNADOS</option>
        <option value="pending_attention">PENDIENTES POR ATENDER</option>
        <option value="pending">SOLICITUDES DE DEVOLUCIÓN</option>
        <option value="returns">DEVUELTOS AL ARCHIVO</option>
        <option value="alert">ALERTAS &gt; 30 DÍAS</option>`;
      el('ownerStateFilter').value=current;
    }
  }

  if(typeof v629SyncOwnerMode==='function')v629SyncOwnerMode();
}

function userAllRowsUnique(rows=[]){
  const map=new Map();

  // La primera aparición tiene prioridad.
  // Se cargan primero estados actuales y después históricos.
  for(const r of (rows||[])){
    const key=String(
      r?.expediente_id||
      r?.id||
      `${norm(r?.expediente||'')}|${norm(r?.extension||'')}`
    );

    if(!key || map.has(key))continue;
    map.set(key,r);
  }

  return [...map.values()].sort((a,b)=>{
    const da=new Date(
      a?.ultimo_movimiento_fecha||
      a?.updated_at||
      a?.fecha_solicitud||
      a?.fecha_entrega||
      0
    ).getTime();

    const db=new Date(
      b?.ultimo_movimiento_fecha||
      b?.updated_at||
      b?.fecha_solicitud||
      b?.fecha_entrega||
      0
    ).getTime();

    return db-da;
  });
}

async function loadAllExpedientesForSelectedUser(nombre,search=''){
  if(!sb||!session||!nombre||!hasFullAccess())return [];

  const types=[
    'CUSTODIA',
    'PENDIENTES_POR_ATENDER',
    'DEVOLUCION_SOLICITADA',
    'DEVUELTOS_AL_ARCHIVO'
  ];

  let results=[];

  if(isCoordinatorTeamWorkspaceV206()){
    results=await Promise.all(
      types.map(async p_tipo=>{
        try{
          const rows=await coordinatorTeamRowsV218(
            nombre,
            p_tipo,
            search
          );
          return {data:rows,error:null};
        }catch(error){
          return {data:[],error};
        }
      })
    );
  }else{
    results=await Promise.all(
      types.map(p_tipo=>
        sb.rpc(
          'listar_tarjeta_usuario_admin_v5',
          {
            p_nombre:nombre,
            p_tipo,
            p_busqueda:cleanSearch(search||'')||null
          }
        )
      )
    );
  }

  const rows=[];

  results.forEach((res,index)=>{
    if(res.error){
      console.warn(
        `Todos los expedientes (${types[index]}):`,
        res.error.message||res.error
      );
      return;
    }

    (Array.isArray(res.data)?res.data:[]).forEach(r=>{
      rows.push({
        ...r,
        categoria_usuario:
          types[index]==='CUSTODIA'
            ?'CUSTODIA ACTUAL'
            :types[index]
      });
    });
  });

  return userAllRowsUnique(rows);
}

async function loadAllMyExpedientes(search=''){
  if(!sb||!session||!isLimitedUser())return [];

  const types=[
    'CUSTODIA',
    'PENDIENTES_POR_ATENDER',
    'DEVOLUCION_SOLICITADA',
    'DEVUELTOS_AL_ARCHIVO'
  ];

  if(isCoordinatorSelfWorkspaceV206() || isStaffPersonalWorkspaceV319()){
    const results=await Promise.all(
      types.map(type=>
        isCoordinatorSelfWorkspaceV206()
          ?coordinatorSelfCardRowsV207(type,search)
          :staffSelfCardRowsV320(type,search)
      )
    );

    const rows=[];
    results.forEach((list,index)=>{
      (Array.isArray(list)?list:[]).forEach(r=>{
        rows.push({
          ...r,
          categoria_usuario:
            types[index]==='CUSTODIA'
              ?'CUSTODIA ACTUAL'
              :types[index]
        });
      });
    });

    return userAllRowsUnique(rows);
  }

  const results=await Promise.all(
    types.map(p_tipo=>
      sb.rpc(
        'listar_mi_tarjeta_v5',
        {
          p_tipo,
          p_busqueda:cleanSearch(search||'')||null
        }
      )
    )
  );

  const rows=[];

  results.forEach((res,index)=>{
    if(res.error){
      console.warn(
        `Todos mis expedientes (${types[index]}):`,
        res.error.message
      );
      return;
    }

    (Array.isArray(res.data)?res.data:[]).forEach(r=>{
      rows.push({
        ...r,
        categoria_usuario:
          types[index]==='CUSTODIA'
            ?'CUSTODIA ACTUAL'
            :types[index]
      });
    });
  });

  return userAllRowsUnique(rows);
}

function normalizeHistoricalReturnRows(data){
  if(Array.isArray(data))return data;

  // Algunas versiones del cliente devuelven JSON ya interpretado,
  // otras pueden entregarlo como texto.
  if(typeof data==='string'){
    try{
      const parsed=JSON.parse(data);
      return Array.isArray(parsed)?parsed:[];
    }catch(_){
      return [];
    }
  }

  return [];
}

async function loadHistoricalReturnsForOwner(nombre,search=''){
  if(!hasFullAccess() || !nombre)return [];

  const {data,error}=await sb.rpc(
    'listar_devoluciones_historicas_por_usuario',
    {
      p_nombre:nombre,
      p_busqueda:search||null
    }
  );

  if(error){
    console.warn(
      `devoluciones históricas de ${nombre}:`,
      error.message
    );
    return [];
  }

  return normalizeHistoricalReturnRows(data);
}

// ============================================================
// V181 · EXPEDIENTES POR USUARIO: CARGA RÁPIDA
//
// Problema anterior:
//   1) Primero se esperaba el cálculo de pendientes.
//   2) Después se lanzaban consultas por cada usuario.
//   3) Además se consultaba el histórico de devoluciones por cada usuario,
//      aunque ese resultado no se utilizaba para construir la tarjeta.
//   4) Hasta terminar todo, la pantalla mostraba "Cargando...".
//
// V181:
//   - Dibuja las tarjetas inmediatamente.
//   - Reutiliza la última lectura disponible.
//   - Pendientes y resúmenes se consultan al mismo tiempo.
//   - Elimina la consulta histórica redundante.
//   - Guarda un snapshot breve en sessionStorage.
// ============================================================
const V181_OWNER_CACHE_FRESH_MS=60000;
const V181_OWNER_CACHE_MAX_MS=120000;

let ownerCardsFlight=null;
let ownerCardsFlightUser='';
let ownerCardsLoadedAt=0;

function ownerCardsCacheKeyV181(){
  return 'v233_owner_cards_'+String(session?.user?.id||'anon');
}


function ownerOperationalProfileV233(nombre){
  return (abogadoProfiles||[]).find(
    x=>norm(x.nombre_personal||'')===norm(nombre||'')
  )||null;
}

function ownerRoleMetaV233(nombre){
  const cleanNombre=String(nombre||'').trim();

  if(cleanNombre && norm(cleanNombre)===norm(currentProfile?.nombre_personal||'')){
    return {
      _role:String(currentProfile?.rol||'USUARIO').toUpperCase(),
      _area:String(coordinatorPrimaryAreaV211?.()||currentProfile?.area_coordinacion||'').trim()
    };
  }

  const profile=ownerOperationalProfileV233(nombre);

  return {
    _role:String(profile?.rol||'USUARIO').toUpperCase(),
    _area:String(profile?.area_coordinacion||'').trim()
  };
}

function ownerCardsPlaceholderV181(nombre){
  return {
    nombre,
    ...ownerRoleMetaV233(nombre),
    total_custodia:0,
    pendientes_por_atender:0,
    en_prestamo:0,
    reasignados:0,
    devoluciones_pendientes_aceptacion:0,
    devoluciones_realizadas:0,
    alertas_30:0,
    _summary_loading:true,
    _pending_loading:true
  };
}

function saveOwnerCardsCacheV181(){
  try{
    sessionStorage.setItem(
      ownerCardsCacheKeyV181(),
      JSON.stringify({
        savedAt:Date.now(),
        rows:(ownerCardsRows||[]).map(x=>{
          const row={...x};
          delete row._summary_loading;
          delete row._pending_loading;
          return row;
        })
      })
    );
  }catch(_){}
}

function restoreOwnerCardsCacheV181(){
  try{
    const raw=sessionStorage.getItem(ownerCardsCacheKeyV181());
    if(!raw)return false;

    const parsed=JSON.parse(raw);
    const age=Date.now()-Number(parsed?.savedAt||0);

    if(
      !Array.isArray(parsed?.rows) ||
      !parsed.rows.length ||
      age>V181_OWNER_CACHE_MAX_MS
    ){
      return false;
    }

    ownerCardsRows=parsed.rows;
    ownerCardsLoadedAt=Number(parsed.savedAt||0);
    renderOwnerCards();
    return true;
  }catch(_){
    return false;
  }
}

function ownerMetricHtmlV181(row,key,kind='summary'){
  if(row?.error && kind!=='pending')return '<span title="No se pudo consultar">—</span>';
  const loading=kind==='pending'
    ?row?._pending_loading
    :row?._summary_loading;

  return loading
    ?'<span class="owner-metric-loading" aria-label="Cargando">…</span>'
    :String(Number(row?.[key]||0));
}

async function loadOwnerCards(){
  const user=session?.user?.id||'';

  if(!ownerCardsMode()){
    updateOwnerPanelVisibility();
    return;
  }

  updateOwnerPanelVisibility();

  // Si ya existen datos en memoria, se muestran de inmediato.
  if(ownerCardsRows.length){
    renderOwnerCards();

    if(Date.now()-ownerCardsLoadedAt<V181_OWNER_CACHE_FRESH_MS){
      return ownerCardsRows;
    }
  }else{
    // V409: no reutilizar snapshots antiguos del equipo que puedan contener
    // los ceros generados por versiones anteriores.
    if(!isCoordinatorTeamWorkspaceV206()){
      restoreOwnerCardsCacheV181();
    }
  }

  if(ownerCardsFlight && ownerCardsFlightUser===user){
    return ownerCardsFlight;
  }

  ownerCardsFlightUser=user;
  const flight=loadOwnerCardsNow(user);
  ownerCardsFlight=flight;

  try{
    return await flight;
  }finally{
    if(ownerCardsFlight===flight){
      ownerCardsFlight=null;
      ownerCardsFlightUser='';
    }
  }
}

// ============================================================
// V310 · PENDIENTES DEL EQUIPO MEDIANTE RPC SEGURA POR INTEGRANTE
//
// El COORDINADOR ya NO llama directamente a:
//   - listar_pendientes_por_atender_inclusivo
//   - listar_esperas_otra_area
//
// Ambas RPC dependen de auth.uid() / perfil del usuario conectado.
// V310 llama a:
//   v310_coordinador_fuentes_pendientes_usuario(p_nombre)
//
// PostgreSQL valida que:
//   1) quien consulta sea COORDINADOR activo;
//   2) el usuario objetivo pertenezca realmente a su equipo;
//   3) las fuentes se ejecuten bajo el contexto temporal del integrante.
//
// El HTML conserva exactamente la deduplicación del perfil USUARIO:
// solicitud + expediente.
// ============================================================
function pendingAttentionKeyV310(r){
  return [
    String(r?.solicitud_id||r?.solicitud_numero||''),
    String(r?.expediente_id||r?.id||r?.expediente||'')
  ].join('::');
}

function pendingAttentionRowsForUserV310(nombre,pendingRows=[],waitRows=[],search=''){
  const target=String(nombre||'').trim();
  const targetNorm=norm(target);
  if(!targetNorm)return [];

  const direct=(Array.isArray(pendingRows)?pendingRows:[])
    .filter(r=>norm(r?.solicitante||'')===targetNorm)
    .map(r=>({...r,_v310_pending_source:'ARCHIVO'}));

  // Las waitRows ya fueron obtenidas por PostgreSQL bajo el contexto
  // temporal del usuario objetivo. Por eso es_solicitante_destino
  // vuelve a tener el mismo significado que en el perfil USUARIO.
  const waits=(Array.isArray(waitRows)?waitRows:[])
    .filter(w=>
      !!w?.es_solicitante_destino ||
      norm(w?.solicitante_destino||'')===targetNorm
    )
    .filter(w=>
      ['SOLICITADA','DEVOLUCIÓN SOLICITADA']
        .includes(norm(w?.estado||''))
    )
    .map(w=>({
      id:w.expediente_id||w.id||'',
      expediente_id:w.expediente_id||w.id||'',
      expediente:w.expediente||'—',
      extension:w.extension||'',
      rd:w.rd||'',
      ultimo_folio:w.ultimo_folio||'',
      solicitud_id:w.solicitud_destino_id||w.solicitud_id||null,
      solicitud_numero:w.solicitud_numero||'—',
      solicitante:w.solicitante_destino||target,
      asunto:w.asunto||'SOLICITUD DE EXPEDIENTE',
      observacion:w.observacion||'',
      solicitud_created_at:
        w.fecha_solicitud||
        w.created_at||
        w.fecha_registro||
        null,
      created_at:
        w.fecha_solicitud||
        w.created_at||
        w.fecha_registro||
        null,
      responsable_actual:w.responsable_actual||'',
      area_actual:w.area_actual||'',
      estado:'PENDIENTE POR ATENDER',
      _cross_wait:w,
      _v310_pending_source:'OTRO_USUARIO'
    }));

  const merged=new Map();

  [...direct,...waits].forEach(r=>{
    const key=pendingAttentionKeyV310(r);

    if(!merged.has(key)){
      merged.set(key,r);
      return;
    }

    const current=merged.get(key);

    if(!current._cross_wait && r._cross_wait){
      current._cross_wait=r._cross_wait;
      current._v310_pending_source='OTRO_USUARIO';
    }

    if(!current.responsable_actual && r.responsable_actual){
      current.responsable_actual=r.responsable_actual;
    }
  });

  let result=[...merged.values()];
  const q=norm(search||'');

  if(q){
    result=result.filter(r=>[
      r.expediente,
      r.extension,
      r.rd,
      r.ultimo_folio,
      r.solicitud_numero,
      r.asunto,
      r.observacion,
      r.solicitante,
      r.responsable_actual
    ].some(v=>norm(v||'').includes(q)));
  }

  return result;
}

const coordinatorPendingSourceCacheV310=new Map();
const coordinatorPendingSourceFlightV310=new Map();
const V310_PENDING_CACHE_MS=15000;

function normalizeV310Payload(data){
  if(data==null)return {};
  if(typeof data==='string'){
    try{return JSON.parse(data)||{};}catch(_){return {};}
  }
  if(Array.isArray(data) && data.length===1 && data[0] && typeof data[0]==='object'){
    return data[0];
  }
  return typeof data==='object'?data:{};
}

async function loadCoordinatorPendingSourceV310(nombre,force=false){
  if(!sb||!session||!isCoordinatorTeamWorkspaceV206()){
    return {pendingRows:[],waitRows:[]};
  }

  const target=String(nombre||'').trim();
  const key=norm(target);
  if(!key)return {pendingRows:[],waitRows:[]};

  const cached=coordinatorPendingSourceCacheV310.get(key);
  if(
    !force &&
    cached &&
    (Date.now()-Number(cached.loadedAt||0))<V310_PENDING_CACHE_MS
  ){
    return cached.source;
  }

  if(coordinatorPendingSourceFlightV310.has(key)){
    return coordinatorPendingSourceFlightV310.get(key);
  }

  const flight=(async()=>{
    const {data,error}=await sb.rpc(
      'v310_coordinador_fuentes_pendientes_usuario',
      {p_nombre:target}
    );

    if(error)throw coordinatorTrackingErrorV404(error);

    const payload=normalizeV310Payload(data);
    const source={
      pendingRows:Array.isArray(payload.pending_rows)?payload.pending_rows:[],
      waitRows:Array.isArray(payload.wait_rows)?payload.wait_rows:[]
    };

    coordinatorPendingSourceCacheV310.set(key,{
      loadedAt:Date.now(),
      source
    });

    return source;
  })();

  coordinatorPendingSourceFlightV310.set(key,flight);

  try{
    return await flight;
  }finally{
    if(coordinatorPendingSourceFlightV310.get(key)===flight){
      coordinatorPendingSourceFlightV310.delete(key);
    }
  }
}

async function loadCoordinatorPendingCountMapV409(names=[]){
  const result=new Map();

  await Promise.all(
    (names||[]).map(async nombre=>{
      try{
        const rows=await coordinatorTeamRowsV218(
          nombre,
          'PENDIENTES_POR_ATENDER',
          ''
        );
        result.set(nombre,Array.isArray(rows)?rows.length:0);
      }catch(error){
        console.warn(
          `V409 · pendientes de ${nombre}:`,
          error?.message||error
        );
        result.set(nombre,0);
      }
    })
  );

  return result;
}


async function loadCoordinatorPendingCountMapV310(names=[]){
  const result=new Map();

  await Promise.all(
    (names||[]).map(async nombre=>{
      const source=await loadCoordinatorPendingSourceV310(nombre,false);

      result.set(
        nombre,
        pendingAttentionRowsForUserV310(
          nombre,
          source.pendingRows,
          source.waitRows,
          ''
        ).length
      );
    })
  );

  return result;
}

async function loadCoordinatorPendingRowsV310(nombre,search=''){
  const source=await loadCoordinatorPendingSourceV310(nombre,true);

  let rows=pendingAttentionRowsForUserV310(
    nombre,
    source.pendingRows,
    source.waitRows,
    search
  );

  rows=await enrichPendingAttentionRequestTimes(rows);
  rows=await enrichPendingAttentionMasterFieldsV148(rows);

  return sortPendingAttentionByDateDesc(rows);
}

function invalidateCoordinatorPendingCacheV310(nombre=''){
  const key=norm(nombre||'');
  if(key){
    coordinatorPendingSourceCacheV310.delete(key);
    coordinatorPendingSourceFlightV310.delete(key);
    return;
  }

  coordinatorPendingSourceCacheV310.clear();
  coordinatorPendingSourceFlightV310.clear();
}

async function loadOwnerCardsNow(user){
  if(!ownerCardsMode()){
    updateOwnerPanelVisibility();
    return;
  }

  updateOwnerPanelVisibility();

  // Leer la relación vigente antes de construir las tarjetas del equipo.
  // Un integrante sin custodia también debe aparecer en la vista.
  if(isCoordinatorTeamWorkspaceV206()){
    if(document.body.classList.contains('v631-direct-owner') ||
       el('ownerCardsPanel')?.style.getPropertyValue('display')==='none'){
      try{window.v748ExitDirectOwnerExplorer?.();}catch(_){ }
      document.body.classList.remove('v631-direct-owner','v631-no-owner');
      document.querySelector('.app')?.classList.remove('v631-direct-owner');
      el('ownerCardsPanel')?.style.removeProperty('display');
      el('ownerDetailFilters')?.style.removeProperty('display');
    }
    try{
      await loadCoordinatorScopeV211(true);
    }catch(error){
      const gridError=el('ownerCardsGrid');
      if(gridError){gridError.innerHTML='<div class="empty"><b>No se pudo consultar el personal del área.</b><p>'+esc(error?.message||String(error))+'</p><button type="button" class="btn secondary small" onclick="loadOwnerCards()">Volver a intentar</button></div>';}
      if(el('ownerCardsPanel'))el('ownerCardsPanel').classList.remove('hidden','hidden-by-role');
      return [];
    }
  }

  const grid=el('ownerCardsGrid');

  // V347:
  // "Expedientes por usuario" no debe depender únicamente del catálogo de
  // perfiles que ya tienen custodia. También debe incluir a cualquier
  // solicitante que tenga EXPEDIENTES PENDIENTES POR ATENDER.
  //
  // Caso típico: un integrante puede tener 0 expedientes en custodia pero
  // haber generado un requerimiento nuevo. Debe aparecer inmediatamente
  // en esta vista con su contador pendiente.
  const coordinatorModeV347=isCoordinatorTeamWorkspaceV206();
  // V749: las tarjetas administrativas deben incluir también al personal del
  // catálogo oficial aunque no figure aún en listar_usuarios_abogados.
  // Sin esta unión, áreas como DECOMISO pueden aparecer con integrantes en
  // el modal de áreas y abrir luego una lista vacía o incompleta.
  const catalogNamesV749=!coordinatorModeV347 && hasFullAccess()
    ?(Array.isArray(catalogo)?catalogo:[])
      .filter(person=>person && person.activo!==false && norm(person.tipo)==='PERSONAL')
      .map(person=>String(person.nombre||'').trim()).filter(Boolean)
    :[];
  // V780 · No deducir el equipo desde abogadoNames ni desde custodia.
  // La única fuente válida en el perfil COORDINADOR es V211 (activo y autorizado).
  // Incluye íntegramente a quienes tienen cero expedientes.
  const teamNamesV780=coordinatorModeV347
    ?[
        String(currentProfile?.nombre_personal||'').trim(),
        ...(Array.isArray(coordinatorTeamRowsV211)?coordinatorTeamRowsV211:[])
          .map(row=>String(row?.supervisado_nombre||'').trim())
      ]
      .filter(Boolean)
    :[];
  const baseNamesV347=[...new Map(
    (coordinatorModeV347?teamNamesV780:[...abogadoNames(),...catalogNamesV749])
      .filter(Boolean).map(name=>[norm(name),name])
  ).values()];

  const pendingPromise=coordinatorModeV347
    ?loadCoordinatorPendingCountMapV409(baseNamesV347)
      .catch(error=>{
        console.warn('V409 · pendientes del equipo:',error?.message||error);
        return new Map();
      })
    :loadPendingItemCountMapBySolicitanteV165()
      .catch(error=>{
        console.warn('Pendientes por usuario:',error?.message||error);
        return new Map();
      });

  let pendingEarlyV347=null;
  let names=[...baseNamesV347];

  // V348: cuando ARCHIVO/ADMINISTRADOR está viendo un área,
  // incluir explícitamente a cada COORDINADOR y a TODO su personal a cargo
  // según la relación V211. Esto evita que un coordinador con 0 custodia
  // desaparezca y garantiza el orden visual:
  // COORDINADOR -> PERSONAL A SU CARGO.
  if(!coordinatorModeV347 && selectedAreaFilter &&
     typeof window.loadHierarchyV307==='function'){
    try{
      const groupsV348=await window.loadHierarchyV307(selectedAreaFilter,false);
      const seenV348=new Set(names.map(n=>norm(n)));

      for(const group of (Array.isArray(groupsV348)?groupsV348:[])){
        const orderedNamesV348=[
          String(group?.name||'').trim(),
          ...(Array.isArray(group?.members)?group.members:[])
        ].filter(Boolean);

        for(const nombre of orderedNamesV348){
          const key=norm(nombre);
          if(!key || seenV348.has(key))continue;
          seenV348.add(key);
          names.push(nombre);
        }
      }
    }catch(error){
      console.warn('V348 · no se pudo completar coordinador/equipo:',error?.message||error);
    }
  }

  // Para ARCHIVO / ADMINISTRADOR, incorporar además los nombres que vienen
  // de las solicitudes pendientes. Así también aparecen personas que todavía
  // no tienen custodia actual o que no estaban incluidas en abogadoProfiles.
  if(!coordinatorModeV347){
    pendingEarlyV347=await pendingPromise;

    const seenV347=new Set(names.map(n=>norm(n)));
    for(const rawName of pendingEarlyV347.keys()){
      const nombre=String(rawName||'').trim();
      const key=norm(nombre);
      if(!nombre||!key||seenV347.has(key))continue;
      seenV347.add(key);
      names.push(nombre);
    }
  }

  if(el('ownerCardsCount')){
    el('ownerCardsCount').textContent=
      `${names.length} usuario${names.length===1?'':'s'}`;
  }

  if(!names.length){
    ownerCardsRows=[];
    if(grid){
      grid.innerHTML='<div class="empty">No hay usuarios / abogados registrados ni solicitantes con pendientes por atender.</div>';
    }
    return;
  }

  // Si todavía no tenemos datos, mostrar las tarjetas AHORA MISMO,
  // sin esperar a los demás resúmenes.
  if(!ownerCardsRows.length){
    ownerCardsRows=names.map(nombre=>{
      const row=ownerCardsPlaceholderV181(nombre);
      if(pendingEarlyV347?.has(nombre)){
        row.pendientes_por_atender=Number(pendingEarlyV347.get(nombre)||0);
        row._pending_loading=false;
      }
      return row;
    });
    renderOwnerCards();
  }

  // Mantener los usuarios vigentes y agregar solicitantes nuevos con pendientes.
  const previousByName=new Map(
    (ownerCardsRows||[]).map(x=>[norm(x.nombre),x])
  );

  ownerCardsRows=names.map(nombre=>{
    const current=previousByName.get(norm(nombre))||ownerCardsPlaceholderV181(nombre);
    if(pendingEarlyV347?.has(nombre)){
      current.pendientes_por_atender=Number(pendingEarlyV347.get(nombre)||0);
      current._pending_loading=false;
    }
    return current;
  });

  renderOwnerCards();

  let summaries=[];

  try{
    const {data,error}=await sb.rpc(
      'v646_resumen_usuarios_agrupado',
      {p_nombres:names}
    );
    if(error)throw error;

    const groupedRows=Array.isArray(data)?data:[];
    const byName=new Map(
      groupedRows.map(s=>[norm(s?.nombre||''),s])
    );

    summaries=names.map(nombre=>{
      const s=byName.get(norm(nombre))||{};
      return {
        nombre,
        total_custodia:Number(s.total_custodia||0),
        pendientes_por_atender:Number(s.pendientes_por_atender||0),
        en_prestamo:Number(s.en_prestamo||0),
        reasignados:Number(s.reasignados_a_mi||0),
        devoluciones_pendientes_aceptacion:Number(s.devolucion_solicitada||0),
        devoluciones_realizadas:Number(s.devueltos_al_archivo||0),
        alertas_30:Number(s.alertas_30||0)
      };
    });
  }catch(groupedError){
    console.warn('V646 · resumen agrupado no disponible; se usa respaldo:',groupedError?.message||groupedError);

    summaries=await Promise.all(names.map(async nombre=>{
      const response=isCoordinatorTeamWorkspaceV206()
        ?await coordinatorSummaryRpcV409(nombre)
        :await sb.rpc('resumen_tarjetas_usuario_admin_v5',{p_nombre:nombre});

      const {data,error}=response;
      if(error){
        return {
          nombre,error:error.message,total_custodia:0,
          pendientes_por_atender:0,en_prestamo:0,reasignados:0,
          devoluciones_pendientes_aceptacion:0,
          devoluciones_realizadas:0,alertas_30:0
        };
      }

      const s=Array.isArray(data)?v211JsonObject(data[0]||{}):v211JsonObject(data);
      return {
        nombre,
        total_custodia:Number(s.total_custodia||0),
        pendientes_por_atender:Number(s.pendientes_por_atender||0),
        en_prestamo:Number(s.en_prestamo||0),
        reasignados:Number(s.reasignados_a_mi||0),
        devoluciones_pendientes_aceptacion:Number(s.devolucion_solicitada||0),
        devoluciones_realizadas:Number(s.devueltos_al_archivo||0),
        alertas_30:Number(s.alertas_30||0)
      };
    }));
  }

  // La consulta inclusiva de pendientes se mantiene como fuente prioritaria
  // cuando existe, pero ya no se recalculan seis bandejas por cada integrante.
  const pendingByUser=pendingEarlyV347 instanceof Map
    ?pendingEarlyV347
    :await pendingPromise;

  if((session?.user?.id||'')!==user)return;

  ownerCardsRows=summaries.map(summary=>({
    ...summary,
    ...ownerRoleMetaV233(summary.nombre),
    pendientes_por_atender:pendingByUser.has(summary.nombre)
      ?Number(pendingByUser.get(summary.nombre)||0)
      :Number(summary.pendientes_por_atender||0),
    _summary_loading:false,
    _pending_loading:false
  }));

  ownerCardsRows.sort((a,b)=>
    Number(b.pendientes_por_atender||0)-Number(a.pendientes_por_atender||0) ||
    Number(b.total_custodia||0)-Number(a.total_custodia||0) ||
    a.nombre.localeCompare(b.nombre,'es')
  );

  ownerCardsLoadedAt=Date.now();

  syncSelectedOwnerKpisFromCards();
  renderOwnerCards();
  saveOwnerCardsCacheV181();

  return ownerCardsRows;
}


function syncCoordinatorStateCountsV216(){
  if(!isCoordinatorTeamWorkspaceV206())return;

  const select=el('ownerStateFilter');
  if(!select || !selectedOwner)return;

  const summary=(ownerCardsRows||[]).find(
    x=>norm(x.nombre)===norm(selectedOwner)
  );

  if(!summary)return;

  const counts={
    custody:Number(summary.total_custodia||0),
    loan:Number(summary.en_prestamo||0),
    pending_attention:Number(summary.pendientes_por_atender||0),
    reassigned:Number(summary.reasignados||0),

    // V406 · option value="pending" = solicitudes de devolución.
    pending:Number(summary.devoluciones_pendientes_aceptacion||0),

    // option value="returns" = devueltos al archivo.
    returns:Number(summary.devoluciones_realizadas||0)
  };

  const labels={
    custody:'TOTAL EN CUSTODIA',
    loan:'EN PRÉSTAMO',
    pending_attention:'PENDIENTES POR ATENDER',
    reassigned:'REASIGNADOS',
    pending:'SOLICITUDES DE DEVOLUCIÓN',
    returns:'DEVUELTOS AL ARCHIVO'
  };

  [...select.options].forEach(opt=>{
    const key=opt.value;
    if(Object.prototype.hasOwnProperty.call(counts,key)){
      opt.textContent=`${labels[key]||opt.textContent.split(' (')[0]} (${counts[key]})`;
    }
  });
}


// ============================================================
// V538 · COORDINADOR · FILTRO COMBINADO DE PERSONAL DE MI ÁREA
// Criterios: expediente + estado + nombre de usuario.
// ============================================================
let ownerTeamFilterTimerV538=null;
let ownerTeamFilterSequenceV538=0;
let ownerTeamExpMatchNamesV538=null;
let ownerTeamExpMatchStatesV538=new Map();
let ownerTeamFilterBusyV538=false;
const ownerTeamFilterCacheV538=new Map();
let ownerTeamExpResultRowsV539=[];


function ownerTeamFilterAvailableV543(){
  try{
    if(typeof isCoordinator==='function' && isCoordinator())return true;
  }catch(_){ }
  try{
    if(typeof hasFullAccess==='function' && hasFullAccess())return true;
  }catch(_){ }
  return false;
}

async function ownerTeamRowsForFilterV543(nombre,type,search=''){
  const target=String(nombre||'').trim();
  const pTipo=String(type||'CUSTODIA').toUpperCase();
  const pBusqueda=cleanSearch(search||'')||null;
  if(!target)return [];

  // Coordinador: conservar la RPC segura que limita la consulta a su equipo.
  try{
    if(typeof isCoordinator==='function' && isCoordinator()){
      const rows=await coordinatorTeamRowsV218(target,pTipo,pBusqueda||'');
      return Array.isArray(rows)?rows:[];
    }
  }catch(error){
    console.warn('V543 · consulta coordinador:',error?.message||error);
    throw error;
  }

  // Administrador / Archivo: misma fuente usada por las tarjetas del sistema.
  if(typeof hasFullAccess==='function' && hasFullAccess()){
    const {data,error}=await sb.rpc('listar_tarjeta_usuario_admin_v5',{
      p_nombre:target,
      p_tipo:pTipo,
      p_busqueda:pBusqueda
    });
    if(error)throw error;
    if(typeof v211JsonRows==='function')return v211JsonRows(data);
    return Array.isArray(data)?data:(Array.isArray(data?.rows)?data.rows:[]);
  }

  return [];
}

function ownerTeamFilterTitleV543(){
  const box=document.getElementById('ownerTeamSearchV538');
  if(!box)return;
  const title=box.querySelector('div[style*="text-transform:uppercase"]');
  if(!title)return;
  try{
    title.textContent=(typeof isCoordinator==='function' && isCoordinator())
      ?'FILTRAR PERSONAL Y EXPEDIENTES DE MI ÁREA'
      :'FILTRAR PERSONAL Y EXPEDIENTES';
  }catch(_){ }
}

function syncOwnerUserSelectV539(){
  const select=el('ownerCardsUserSearchV538');
  if(!select || select.tagName!=='SELECT')return;
  const previous=select.value||'';
  const names=[...new Set((ownerCardsRows||[])
    .filter(r=>!isCoordinator() || coordinatorCanViewUserV205(r.nombre))
    .map(r=>String(r?.nombre||'').trim())
    .filter(Boolean))]
    .sort((a,b)=>a.localeCompare(b,'es',{sensitivity:'base'}));
  select.innerHTML='<option value="">TODOS</option>'+names.map(name=>
    `<option value="${esc(name)}">${esc(name)}</option>`
  ).join('');
  if(previous && names.some(name=>norm(name)===norm(previous))){
    const match=names.find(name=>norm(name)===norm(previous));
    select.value=match||'';
  }else{
    select.value='';
  }
}

function ownerTeamResultValueV539(row,...keys){
  for(const key of keys){
    const value=row?.[key];
    if(value!==undefined && value!==null && String(value).trim() && String(value).trim()!=='—')return String(value).trim();
  }
  return '';
}

// V540 · Fecha/hora contextual del movimiento mostrado en cada fila.
// Se prioriza la fecha propia del estado (solicitud, préstamo, reasignación,
// devolución, etc.) y se usa la fecha general del movimiento como respaldo.
function ownerTeamResultDateV540(item){
  const row=item?.row||{};
  const stateKey=String(item?.stateKey||'').trim().toLowerCase();
  const candidates={
    pending_attention:[
      'solicitud_created_at','created_at','fecha_solicitud','fecha_registro','updated_at'
    ],
    loan:[
      // V541: priorizar timestamps reales del movimiento antes que DATE puro.
      'ultimo_movimiento_fecha','fecha_ultimo_estado','fecha_entrega_prestamo',
      'fecha_ultima_entrega_prestamo','fecha_entrega','fecha_prestamo',
      'fecha_inicio_custodia','updated_at','created_at'
    ],
    reassigned:[
      'ultimo_movimiento_fecha','fecha_ultimo_estado','fecha_ultima_reasignacion',
      'fecha_reasignacion','fecha_reasignado','ultima_reasignacion_fecha',
      'master_reasignacion_fecha','updated_at','created_at'
    ],
    pending_return:[
      'fecha_ultimo_estado','ultimo_movimiento_fecha','fecha_solicitud_devolucion',
      'fecha_devolucion_solicitada','solicitud_devolucion_fecha','updated_at','created_at'
    ],
    returned:[
      'fecha_ultimo_estado','ultimo_movimiento_fecha','fecha_devolucion',
      'fecha_recepcion','fecha_retorno','updated_at','created_at'
    ],
    custody:[
      'ultimo_movimiento_fecha','fecha_ultimo_estado','fecha_inicio_custodia',
      'updated_at','created_at'
    ]
  };
  const keys=candidates[stateKey]||[
    'ultimo_movimiento_fecha','fecha_ultimo_estado','fecha_entrega','fecha_solicitud',
    'updated_at','created_at'
  ];

  const values=keys.map(key=>row?.[key]).filter(value=>
    value!==undefined && value!==null && String(value).trim() && String(value).trim()!=='—'
  );

  // Primera prioridad: cualquier fuente contextual que conserve hora explícita.
  for(const value of values){
    try{
      if(typeof masterValueHasExplicitTime==='function' && masterValueHasExplicitTime(value))return value;
    }catch(_){ }
    if(/[T ]\d{1,2}:\d{2}/.test(String(value).trim()))return value;
  }

  // Segunda prioridad: la fuente consolidada del equipo si conserva timestamp.
  try{
    if(typeof coordinatorTeamDateV217==='function'){
      const consolidated=coordinatorTeamDateV217(row)||null;
      if(consolidated){
        const raw=String(consolidated).trim();
        const hasTime=(typeof masterValueHasExplicitTime==='function')
          ?masterValueHasExplicitTime(consolidated)
          :/[T ]\d{1,2}:\d{2}/.test(raw);
        if(hasTime)return consolidated;
      }
    }
  }catch(_){ }

  // Último recurso: conservar la mejor fecha disponible aunque no tenga hora.
  if(values.length)return values[0];
  try{
    if(typeof coordinatorTeamDateV217==='function')return coordinatorTeamDateV217(row)||null;
  }catch(_){ }
  return null;
}

function ownerTeamSeparateTimeV541(item){
  const row=item?.row||{};
  const stateKey=String(item?.stateKey||'').trim().toLowerCase();
  const timeKeys={
    pending_attention:['hora_solicitud','hora_registro'],
    loan:['hora_entrega','hora_prestamo','hora_atencion'],
    reassigned:['hora_reasignacion'],
    pending_return:['hora_solicitud_devolucion','hora_devolucion_solicitada'],
    returned:['hora_devolucion','hora_recepcion'],
    custody:['hora_movimiento']
  }[stateKey]||['hora_movimiento','hora_registro'];
  for(const key of timeKeys){
    const value=String(row?.[key]||'').trim();
    if(/^\d{1,2}:\d{2}(?::\d{2})?$/.test(value))return value;
  }
  return '';
}

function ownerTeamResultDateHtmlV540(item){
  const value=ownerTeamResultDateV540(item);
  if(!value)return '—';

  const separateTime=ownerTeamSeparateTimeV541(item);
  let hasExplicit=false;
  try{
    hasExplicit=typeof masterValueHasExplicitTime==='function' && masterValueHasExplicitTime(value);
  }catch(_){ }
  if(!hasExplicit)hasExplicit=/[T ]\d{1,2}:\d{2}/.test(String(value).trim());

  // Si la fecha viene como DATE pero la RPC entrega la hora aparte, combinarlas.
  if(!hasExplicit && separateTime){
    const dateText=typeof fmtDate==='function'?fmtDate(value):String(value);
    const timeText=typeof fmtTime==='function'?fmtTime(separateTime):separateTime;
    return `<div class="datetime-cell"><span class="datetime-date">${esc(dateText||'—')}</span><span class="datetime-time">${esc(timeText||'—')}</span></div>`;
  }

  try{
    if(typeof masterDateTimeHtml==='function')return masterDateTimeHtml(value);
  }catch(_){ }
  return esc(String(value));
}

// V778 · La clasificación de la tarjeta es un subconjunto, NO un nuevo estado.
// El estado vigente procede del registro consolidado y de su último movimiento operativo.
// Mantener préstamos y relaciones históricas intactos; consolidar solo la consulta actual.
function v778EstadoVigente(item){
  const r=item?.row||{};
  const normalize=(value)=>String(value??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toUpperCase();
  const raw=normalize(r.estado_operativo||r.ultimo_estado||r.estado_actual_db||
    r.estado_actual||r.estado||r.estado_item||r.estado_solicitud_item||'');
  const last=normalize(r.ultimo_movimiento||r.movimiento_inicio_custodia||r.accion_ultimo_movimiento||'');
  const result=(key,estado)=>({key,estado});
  if(raw.includes('DEVOLUCION SOLICITADA')||raw.includes('SOLICITUD DE DEVOLUCION')||
    raw.includes('DEVOLUCION PENDIENTE'))return result('pending_return','SOLICITUD DE DEVOLUCIÓN');
  if(raw.includes('DEVUELTO')||raw.includes('DEVOLUCION CONFIRMADA')||
    raw.includes('RETORNADO AL ARCHIVO'))return result('returned','DEVUELTO AL ARCHIVO');
  if(raw.includes('REASIGN')||raw.includes('DERIVADO A USUARIO'))return result('reassigned','REASIGNADO');
  // Algunas fuentes solo conservan EN PRÉSTAMO, aunque la última operación fue reasignar.
  if((raw.includes('PRESTAMO')||raw.includes('CUSTODIA DEL USUARIO'))&&
     last.includes('REASIGN'))return result('reassigned','REASIGNADO');
  if(raw.includes('PENDIENTE POR ATENDER')||raw.includes('POR ATENDER'))
    return result('pending_attention','PENDIENTE POR ATENDER');
  if(raw.includes('PRESTAMO')||raw.includes('CUSTODIA DEL USUARIO'))
    return result('loan','EN PRÉSTAMO');
  if(last.includes('REASIGN')&&raw!=='CUSTODIA')return result('reassigned','REASIGNADO');
  if(raw==='CUSTODIA'||raw.includes('CUSTODIA DEL ARCHIVO')){
    return last.includes('DEVOLUCION CONFIRMADA')
      ?result('returned','DEVUELTO AL ARCHIVO')
      :result('custody','EN CUSTODIA DEL ARCHIVO');
  }
  if(raw.includes('PENDIENTE'))return result('pending_attention','PENDIENTE POR ATENDER');
  // Si la fuente no incluye estado operativo, conservar el subtipo consultado.
  const fallback={loan:'EN PRÉSTAMO',reassigned:'REASIGNADO',custody:'EN CUSTODIA',
    pending_return:'SOLICITUD DE DEVOLUCIÓN',returned:'DEVUELTO AL ARCHIVO',
    pending_attention:'PENDIENTE POR ATENDER'};
  const key=String(item?.stateKey||'custody');
  return result(key,fallback[key]||String(item?.estado||'SIN ESTADO'));
}

function v778ConsolidarResultados(items,filter=''){
  const records=Array.isArray(items)?items:[];
  const map=new Map();
  const normKey=v=>String(v??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toUpperCase();
  function statePriority(key){
    return {pending_return:60,reassigned:50,loan:40,returned:35,custody:30,pending_attention:20}[key]||0;
  }
  function quality(item){
    const r=item.row||{};
    const timestamp=r.ultimo_movimiento_fecha||r.fecha_ultimo_estado||r.fecha_inicio_custodia||
      r.fecha_reasignacion||r.fecha_devolucion||r.fecha_entrega;
    const time=timestamp?Date.parse(String(timestamp)):NaN;
    const source=Boolean(r.estado_operativo||r.ultimo_estado||r.estado_actual_db||r.estado_actual);
    const sourceOwner=normKey(r.responsable_actual||r.responsable||'');
    const ownerMatch=sourceOwner&&sourceOwner===normKey(item.usuario);
    return {time:Number.isFinite(time)?time:0,source,ownerMatch};
  }
  for(const original of records){
    const r=original?.row||{};
    const uid=String(r.expediente_id||r.id||r.id_expediente||'').trim();
    const number=String(ownerTeamRowExpV538(r)||r.expediente||'').trim();
    const ext=normKey(r.extension||r.ext||'');
    // No fusionar extensiones ni años diferentes: la identidad UUID tiene prioridad.
    const key=uid?'ID:'+uid:'EXP:'+normKey(number)+'|'+ext;
    if(key==='EXP:|')continue;
    const effective=v778EstadoVigente(original);
    const item={...original,...effective};
    const prev=map.get(key);
    if(!prev){map.set(key,item);continue;}
    const a=quality(item),b=quality(prev);
    // Movimiento operativo reciente > fuente con estado explícito > subtipo de tarjeta.
    const take=a.time>b.time || (a.time===b.time&&(
      (a.source&&!b.source)||
      (a.source===b.source && a.ownerMatch&&!b.ownerMatch)||
      (a.source===b.source && a.ownerMatch===b.ownerMatch &&
        statePriority(item.stateKey)>statePriority(prev.stateKey))));
    if(take)map.set(key,item);
  }
  const wanted=String(filter||'').trim();
  return [...map.values()].filter(item=>!wanted||item.stateKey===wanted)
    .sort((a,b)=>String(a.row?.expediente||'').localeCompare(String(b.row?.expediente||''),'es',{numeric:true}));
}
window.v778ConsolidarResultados=v778ConsolidarResultados;
window.v778EstadoVigente=v778EstadoVigente;

function ownerTeamRenderExpResultsV539(rows,query=''){
  const box=el('ownerTeamExpResultsV539');
  if(!box)return;
  const list=v778ConsolidarResultados(rows,ownerTeamFilterValuesV538().estado);
  if(!cleanSearch(query||'')){
    box.classList.add('hidden');
    box.innerHTML='';
    return;
  }
  box.classList.remove('hidden');
  if(!list.length){
    box.innerHTML='<div class="empty" style="padding:12px">No se encontró el expediente con los filtros seleccionados.</div>';
    return;
  }
  box.innerHTML=`
    <div style="border:1px solid var(--line);border-radius:10px;overflow:auto;background:var(--block)">
      <div style="padding:9px 11px;border-bottom:1px solid var(--line);font-weight:800;color:#12365f">Expediente encontrado · Estado vigente</div>
      <table style="margin:0;min-width:1120px">
        <thead><tr>
          <th>Expediente</th><th>Ext.</th><th>Usuario / relación</th><th>Estado</th><th>Fecha / hora</th><th>R.D.</th><th class="subject-cell-v639">Asunto</th><th>Responsable / ubicación</th>
        </tr></thead>
        <tbody>${list.map(item=>{
          const r=item.row||{};
          const expediente=coordinatorExpNumberV216(r)||query||'—';
          const extension=ownerTeamResultValueV539(r,'extension','ext')||'—';
          const rd=ownerTeamResultValueV539(r,'rd','resolucion_directoral','numero_rd')||'—';
          const asunto=v732AsuntoValor(r)||'—';
          const state=item.estado||(typeof coordinatorTeamStateV217==='function'?coordinatorTeamStateV217(r):'')||'—';
          const responsable=ownerTeamResultValueV539(r,'responsable_actual','responsable','ubicacion_actual','ubicacion')||'—';
          const fechaHora=ownerTeamResultDateHtmlV540(item);
          return `<tr>
            <td><b>${esc(expediente)}</b></td>
            <td>${esc(extension)}</td>
            <td><b>${esc(item.usuario||'—')}</b>${item.stateKey==='returned'?'<div style="font-size:9px;color:#5d7188;margin-top:2px">DEVOLVIÓ EL EXPEDIENTE</div>':''}</td>
            <td><span class="v217-state">${esc(state)}</span></td>
            <td>${fechaHora}</td>
            <td>${esc(rd)}</td>
            <td class="subject-cell-v639" title="${esc(asunto||'')}"><div class="subject-text-v639">${esc(asunto||'—')}</div></td>
            <td>${esc(responsable)}</td>
          </tr>`;
        }).join('')}</tbody>
      </table>
    </div>`;
}

function ownerTeamFilterValuesV538(){
  return {
    expediente:cleanSearch(el('ownerCardsExpSearchV538')?.value||''),
    estado:String(el('ownerCardsStateSearchV538')?.value||'').trim(),
    usuario:norm(el('ownerCardsUserSearchV538')?.value||'')
  };
}

function ownerTeamStateDefsV538(){
  return [
    {key:'pending_attention',type:'PENDIENTES_POR_ATENDER',count:'pendientes_por_atender',label:'PENDIENTE POR ATENDER'},
    {key:'loan',type:'PRESTAMO',count:'en_prestamo',label:'EN PRÉSTAMO'},
    {key:'reassigned',type:'REASIGNADOS_A_MI',count:'reasignados',label:'REASIGNADO'},
    {key:'pending_return',type:'DEVOLUCION_SOLICITADA',count:'devoluciones_pendientes_aceptacion',label:'SOLICITUD DE DEVOLUCIÓN'},
    {key:'returned',type:'DEVUELTOS_AL_ARCHIVO',count:'devoluciones_realizadas',label:'DEVUELTO AL ARCHIVO'}
  ];
}

function ownerTeamRowHasStateV538(row,stateKey){
  if(!stateKey)return true;
  const def=ownerTeamStateDefsV538().find(x=>x.key===stateKey);
  return def?Number(row?.[def.count]||0)>0:true;
}

function ownerTeamQueryDefsV538(row,stateKey){
  const defs=ownerTeamStateDefsV538();
  if(stateKey){
    const def=defs.find(x=>x.key===stateKey);
    return def&&Number(row?.[def.count]||0)>0?[def]:[];
  }

  const active=defs.filter(def=>Number(row?.[def.count]||0)>0);
  const classified=Number(row?.en_prestamo||0)+Number(row?.reasignados||0);
  const totalCustody=Number(row?.total_custodia||0);
  if(totalCustody>classified){
    active.push({key:'custody',type:'CUSTODIA',count:'total_custodia',label:'EN CUSTODIA'});
  }
  return active;
}

function ownerTeamNormalizeExpV538(value){
  const raw=cleanSearch(value||'');
  if(!raw)return '';
  try{return typeof expBase==='function'?expBase(raw):raw;}catch(_){return raw;}
}

function ownerTeamRowExpV538(row){
  try{
    if(typeof coordinatorExpNumberV216==='function'){
      const v=coordinatorExpNumberV216(row);
      if(v)return ownerTeamNormalizeExpV538(v);
    }
  }catch(_){ }
  return ownerTeamNormalizeExpV538(
    row?.expediente||row?.numero_expediente||row?.nro_expediente||row?.expediente_numero||''
  );
}

async function ownerTeamExpExistsV538(nombre,def,query){
  const normalizedQuery=ownerTeamNormalizeExpV538(query);
  const key=[norm(nombre),def.type,norm(normalizedQuery)].join('::');
  const cached=ownerTeamFilterCacheV538.get(key);
  if(cached && Date.now()-cached.at<30000)return cached.value;

  let rows=[];
  try{
    rows=await ownerTeamRowsForFilterV543(nombre,def.type,normalizedQuery);
  }catch(error){
    console.warn(`V538 · filtro ${def.type} · ${nombre}:`,error?.message||error);
    ownerTeamFilterCacheV538.set(key,{at:Date.now(),value:false});
    return false;
  }

  const q=norm(normalizedQuery);
  const exact=(Array.isArray(rows)?rows:[]).some(r=>norm(ownerTeamRowExpV538(r))===q);
  const value=exact || (Array.isArray(rows)&&rows.length>0);
  ownerTeamFilterCacheV538.set(key,{at:Date.now(),value});
  return value;
}

async function ownerTeamExpRowsV539(nombre,def,query){
  const normalizedQuery=ownerTeamNormalizeExpV538(query);
  let rows=[];
  try{
    rows=await ownerTeamRowsForFilterV543(nombre,def.type,normalizedQuery);
  }catch(error){
    console.warn(`V539 · resultado ${def.type} · ${nombre}:`,error?.message||error);
    return [];
  }
  const all=Array.isArray(rows)?rows:[];
  const q=norm(normalizedQuery);
  const exact=all.filter(r=>norm(ownerTeamRowExpV538(r))===q);
  return exact.length?exact:all;
}

function ownerTeamFilterStatusV538(message,tone='normal'){
  const node=el('ownerTeamFilterStatusV538');
  if(!node)return;
  node.textContent=message;
  node.style.color=tone==='error'?'#9f1c1c':tone==='ok'?'#17643b':'';
}

function ownerTeamMatchBadgeV538(nombre){
  const filters=ownerTeamFilterValuesV538();
  if(!filters.expediente)return '';
  const states=ownerTeamExpMatchStatesV538.get(norm(nombre));
  if(!states||!states.size)return '';
  return `<span style="display:inline-flex;align-items:center;margin-left:6px;padding:2px 7px;border-radius:999px;background:#e8f3ff;color:#225f94;font-size:9px;font-weight:800;vertical-align:middle">${esc([...states].join(' · '))}</span>`;
}

function scheduleOwnerTeamFilterV538(){
  const filters=ownerTeamFilterValuesV538();
  clearTimeout(ownerTeamFilterTimerV538);

  // Nombre y estado se filtran localmente de inmediato.
  if(typeof renderOwnerCards==='function')renderOwnerCards();

  if(!filters.expediente){
    ownerTeamExpMatchNamesV538=null;
    ownerTeamExpMatchStatesV538=new Map();
    ownerTeamFilterBusyV538=false;
    ownerTeamExpResultRowsV539=[];
    ownerTeamRenderExpResultsV539([], '');
    ownerTeamFilterStatusV538('Puede filtrar por número de expediente, estado y usuario. Los filtros se pueden combinar.');
    if(typeof renderOwnerCards==='function')renderOwnerCards();
    return;
  }

  if(filters.expediente.length<2){
    ownerTeamExpMatchNamesV538=null;
    ownerTeamExpMatchStatesV538=new Map();
    ownerTeamFilterStatusV538('Escriba al menos 2 caracteres del expediente.');
    return;
  }

  ownerTeamExpMatchNamesV538=null;
  ownerTeamExpMatchStatesV538=new Map();
  ownerTeamFilterBusyV538=true;
  ownerTeamFilterStatusV538((typeof isCoordinator==='function'&&isCoordinator())?'Buscando el expediente dentro del personal de su área…':'Buscando el expediente dentro del personal visible…');
  ownerTeamFilterTimerV538=setTimeout(()=>applyOwnerTeamFilterV538(false),260);
}

async function applyOwnerTeamFilterV538(force=false){
  if(!ownerTeamFilterAvailableV543()){
    if(typeof renderOwnerCards==='function')renderOwnerCards();
    ownerTeamFilterStatusV538('Este filtro está disponible para Coordinador, Archivo y Administrador.','error');
    return;
  }

  clearTimeout(ownerTeamFilterTimerV538);
  const filters=ownerTeamFilterValuesV538();
  const seq=++ownerTeamFilterSequenceV538;

  if(!filters.expediente){
    ownerTeamExpMatchNamesV538=null;
    ownerTeamExpMatchStatesV538=new Map();
    ownerTeamFilterBusyV538=false;
    ownerTeamExpResultRowsV539=[];
    ownerTeamRenderExpResultsV539([], '');
    ownerTeamFilterStatusV538('Puede filtrar por número de expediente, estado y usuario. Los filtros se pueden combinar.');
    renderOwnerCards();
    return;
  }

  const query=ownerTeamNormalizeExpV538(filters.expediente);
  ownerTeamFilterBusyV538=true;
  ownerTeamFilterStatusV538((typeof isCoordinator==='function'&&isCoordinator())?`Buscando ${query} en el personal de su área…`:`Buscando ${query} en el personal visible…`);

  const coordinatorScope=(typeof isCoordinator==='function' && isCoordinator());
  const candidates=(ownerCardsRows||[]).filter(row=>{
    if(coordinatorScope && !coordinatorCanViewUserV205(row.nombre))return false;
    if(filters.usuario && !norm(row.nombre).includes(filters.usuario))return false;
    if(filters.estado && !ownerTeamRowHasStateV538(row,filters.estado))return false;
    return true;
  });

  const matchedNames=new Set();
  const matchedStates=new Map();
  const matchedExpedientes=[];

  // Lotes pequeños para no saturar Supabase cuando el equipo sea grande.
  const batchSize=(typeof isCoordinator==='function' && isCoordinator())?4:8;
  for(let i=0;i<candidates.length;i+=batchSize){
    const batch=candidates.slice(i,i+batchSize);
    await Promise.all(batch.map(async row=>{
      const defs=ownerTeamQueryDefsV538(row,filters.estado);
      if(!defs.length)return;
      const hits=await Promise.all(defs.map(async def=>{
        const rows=await ownerTeamExpRowsV539(row.nombre,def,query);
        return {def,rows,hit:rows.length>0};
      }));
      const labels=hits.filter(x=>x.hit).map(x=>x.def.label);
      if(labels.length){
        const key=norm(row.nombre);
        matchedNames.add(key);
        matchedStates.set(key,new Set(labels));
        hits.filter(x=>x.hit).forEach(hit=>{
          hit.rows.forEach(found=>matchedExpedientes.push({
            usuario:row.nombre,
            estado:hit.def.label,
            stateKey:hit.def.key,
            row:found
          }));
        });
      }
    }));
    if(seq!==ownerTeamFilterSequenceV538)return;
  }

  if(seq!==ownerTeamFilterSequenceV538)return;
  // V778: un expediente actual = una fila, aunque coincida con CUSTODIA y
  // REASIGNADOS_A_MI. Las operaciones antiguas siguen solo en el Historial.
  ownerTeamExpResultRowsV539=v778ConsolidarResultados(matchedExpedientes,filters.estado);
  const currentNames=new Set();
  const currentStates=new Map();
  for(const item of ownerTeamExpResultRowsV539){
    const user=norm(item.usuario);
    currentNames.add(user);
    if(!currentStates.has(user))currentStates.set(user,new Set());
    currentStates.get(user).add(item.estado);
  }
  ownerTeamExpMatchNamesV538=currentNames;
  ownerTeamExpMatchStatesV538=currentStates;
  ownerTeamFilterBusyV538=false;
  ownerTeamRenderExpResultsV539(ownerTeamExpResultRowsV539,query);
  renderOwnerCards();

  const total=currentNames.size;
  ownerTeamFilterStatusV538(
    total
      ?`${total} usuario${total===1?'':'s'} con coincidencia para ${query}.`
      :`No se encontró ${query} en los expedientes del personal visible.`,
    total?'ok':'error'
  );
}

function clearOwnerTeamFilterV538(){
  clearTimeout(ownerTeamFilterTimerV538);
  ownerTeamFilterSequenceV538++;
  ['ownerCardsExpSearchV538','ownerCardsUserSearchV538'].forEach(id=>{
    const node=el(id);if(node)node.value='';
  });
  if(el('ownerCardsStateSearchV538'))el('ownerCardsStateSearchV538').value='';
  ownerTeamExpMatchNamesV538=null;
  ownerTeamExpMatchStatesV538=new Map();
  ownerTeamExpResultRowsV539=[];
  ownerTeamRenderExpResultsV539([], '');
  ownerTeamFilterBusyV538=false;
  ownerTeamFilterStatusV538('Puede filtrar por número de expediente, estado y usuario. Los filtros se pueden combinar.');
  if(typeof renderOwnerCards==='function')renderOwnerCards();
  el('ownerCardsExpSearchV538')?.focus();
}

function renderOwnerCards(){
  const grid=el('ownerCardsGrid');
  if(!grid)return;
  if(ownerTeamFilterAvailableV543()){
    syncOwnerUserSelectV539();
    ownerTeamFilterTitleV543();
  }

  // V538: el Coordinador dispone de tres filtros independientes:
  // expediente, estado y nombre del usuario.
  const teamFilterActiveV543=ownerTeamFilterAvailableV543();
  const teamFiltersV538=teamFilterActiveV543?ownerTeamFilterValuesV538():null;
  const q=teamFilterActiveV543
    ?teamFiltersV538.usuario
    :norm(el('searchInput')?.value||'');

  const rows=ownerCardsRows.filter(x=>{
    if(typeof isCoordinator==='function' && isCoordinator()){
      if(!coordinatorCanViewUserV205(x.nombre))return false;
    }else if(selectedAreaFilter && !userBelongsToArea(x.nombre,selectedAreaFilter)){
      // V748: el filtro del área es obligatorio también cuando Archivo o
      // Administrador tienen habilitados filtros combinados (V543).
      return false;
    }

    if(teamFilterActiveV543){
      if(q && !norm(x.nombre).includes(q))return false;
      if(teamFiltersV538.estado && !ownerTeamRowHasStateV538(x,teamFiltersV538.estado))return false;
      if(
        teamFiltersV538.expediente &&
        ownerTeamExpMatchNamesV538 instanceof Set &&
        !ownerTeamExpMatchNamesV538.has(norm(x.nombre))
      ) return false;
      return true;
    }

    return !q || norm(x.nombre).includes(q);
  }).sort((a,b)=>{
    // V323: primero quienes tienen expedientes pendientes por atender.
    const pa=Number(a?.pendientes_por_atender||0);
    const pb=Number(b?.pendientes_por_atender||0);
    if(pb!==pa)return pb-pa;

    const ca=Number(a?.total_custodia||0);
    const cb=Number(b?.total_custodia||0);
    if(cb!==ca)return cb-ca;

    return String(a?.nombre||'').localeCompare(String(b?.nombre||''),'es');
  });

  if(el('ownerCardsCount')){
    const pendingUsers=rows.filter(x=>Number(x?.pendientes_por_atender||0)>0).length;
    const pendingText=pendingUsers
      ?` · ${pendingUsers} con pendientes por atender`
      :'';

    el('ownerCardsCount').textContent=(typeof isCoordinator==='function' && isCoordinator())
      ?`${rows.length} usuario${rows.length===1?'':'s'} · ${coordinatorPrimaryAreaV211()||'Mi área'}${pendingText}`
      :teamFilterActiveV543
        ?`${rows.length} usuario${rows.length===1?'':'s'}${pendingText}`
      :selectedAreaFilter
        ?`${rows.length} usuario${rows.length===1?'':'s'} · ${selectedAreaFilter}${pendingText}`
        :`${rows.length} usuario${rows.length===1?'':'s'}${pendingText}`;
  }

  if(!rows.length){
    const teamQuery=teamFilterActiveV543&&ownerTeamFilterValuesV538();
    const hasTeamFilter=!!(teamQuery&&(teamQuery.expediente||teamQuery.estado||teamQuery.usuario));
    grid.innerHTML=hasTeamFilter
      ?'<div class="empty">No hay personal de su área que coincida con los filtros seleccionados.</div>'
      :selectedAreaFilter
        ?`<div class="empty">No hay usuarios / abogados configurados en ${esc(selectedAreaFilter)}.</div>`
        :'<div class="empty">No hay usuarios que coincidan con la búsqueda.</div>';
    return;
  }

  grid.innerHTML=rows.map(x=>`
    <div class="owner-user-card ${selectedOwner===x.nombre?'selected-user-card':''} ${Number(x.pendientes_por_atender||0)>0?'has-pending-attention':''}"
         data-owner-name="${esc(x.nombre)}"
         role="button"
         tabindex="0"
         onclick="openOwnerCustodyV215('${String(x.nombre).replace(/'/g,"\'")}')"
         onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openOwnerCustodyV215('${String(x.nombre).replace(/'/g,"\'")}')}">
      <div class="owner-user-name">
        ${esc(x.nombre)}
        ${isCoordinator()?ownerTeamMatchBadgeV538(x.nombre):''}
        ${Number(x.pendientes_por_atender||0)>0
          ?`<span class="owner-pending-user-badge">PENDIENTE POR ATENDER · ${Number(x.pendientes_por_atender||0)}</span>`
          :''
        }
        ${
          x._role==='COORDINADOR'
            ?`<span class="v233-role-badge">
                 COORDINADOR${x._area?` · ${esc(x._area)}`:''}
               </span>`
            :''
        }
      </div>

      <div class="owner-user-total">${ownerMetricHtmlV181(x,'total_custodia')}</div>
      <div class="owner-user-summary-box">expedientes actualmente en custodia</div>

      <div class="owner-user-stats">
        <div class="owner-user-stat">
          <span>PENDIENTES POR ATENDER</span>
          <b>${ownerMetricHtmlV181(x,'pendientes_por_atender','pending')}</b>
        </div>

        <div class="owner-user-stat">
          <span>EN PRÉSTAMO</span>
          <b>${ownerMetricHtmlV181(x,'en_prestamo')}</b>
        </div>

        <div class="owner-user-stat">
          <span>REASIGNADOS</span>
          <b>${ownerMetricHtmlV181(x,'reasignados')}</b>
        </div>

        <div class="owner-user-stat">
          <span>SOLICITUDES DE DEVOLUCIÓN</span>
          <b>${ownerMetricHtmlV181(x,'devoluciones_pendientes_aceptacion')}</b>
        </div>

        <div class="owner-user-stat">
          <span>DEVUELTOS AL ARCHIVO</span>
          <b>${ownerMetricHtmlV181(x,'devoluciones_realizadas')}</b>
        </div>

      </div>

      ${x.error
        ?`<div class="note" style="margin-top:8px;color:#a61b1b">${esc(x.error)}</div>`
        :''}

      <div class="owner-user-actions">
        <button class="btn secondary small" type="button" data-owner-action="custody"
          onclick="event.stopPropagation();openOwnerCustodyV215('${String(x.nombre).replace(/'/g,"\'")}')">
          Ver expedientes (${Number(x.total_custodia||0)})
        </button>
      </div>

      <div class="owner-user-options">
        ${Number(x.pendientes_por_atender||0)>0
          ?`<button class="btn small" type="button" data-owner-action="pending_attention"
              onclick="event.stopPropagation();openOwnerExpedientes('${String(x.nombre).replace(/'/g,"\'")}','pending_attention')">
              Por atender (${Number(x.pendientes_por_atender||0)})
            </button>`
          :''}

        ${Number(x.en_prestamo||0)>0
          ?`<button class="btn secondary small"
              onclick="event.stopPropagation();openOwnerExpedientes('${String(x.nombre).replace(/'/g,"\'")}','loan')">
              En préstamo (${Number(x.en_prestamo||0)})
            </button>`
          :''}

        ${Number(x.reasignados||0)>0
          ?`<button class="btn secondary small"
              onclick="event.stopPropagation();openOwnerExpedientes('${String(x.nombre).replace(/'/g,"\'")}','reassigned')">
              Reasignados (${Number(x.reasignados||0)})
            </button>`
          :''}

        ${Number(x.devoluciones_pendientes_aceptacion||0)>0
          ?`<button class="btn secondary small"
              onclick="event.stopPropagation();openOwnerExpedientes('${String(x.nombre).replace(/'/g,"\'")}','pending')">
              Solicitudes devolución (${Number(x.devoluciones_pendientes_aceptacion||0)})
            </button>`
          :''}

        ${Number(x.devoluciones_realizadas||0)>0
          ?`<button class="btn secondary small"
              onclick="event.stopPropagation();openOwnerExpedientes('${String(x.nombre).replace(/'/g,"\'")}','returns')">
              Devueltos (${Number(x.devoluciones_realizadas||0)})
            </button>`
          :''}

      </div>
    </div>
  `).join('');
}

async function openPendingOwnerRequest(solicitudId,solicitante){
  switchTab('requests',document.querySelector('[data-tab="requests"]'));
  if(el('requestSearch'))el('requestSearch').value=solicitante||'';
  if(el('requestStateFilter'))el('requestStateFilter').value='PENDIENTES_POR_ATENDER_ITEMS';
  if(isAdmin()&&el('requestOriginFilter'))el('requestOriginFilter').value='';
  await loadRequests();
  if(solicitudId){
    const row=(requestRows||[]).find(r=>String(r.id)===String(solicitudId));
    if(row)await openEditRequest(row.id);
  }
}



function startCoordinatorPanelTimeoutV217(nombre){
  if(!isCoordinatorTeamWorkspaceV206())return;

  const loadId=panelLoadSequence;

  setTimeout(()=>{
    if(
      isCoordinatorTeamWorkspaceV206() &&
      selectedOwner===nombre &&
      loadId===panelLoadSequence &&
      /Cargando expedientes/i.test(el('panelTable')?.textContent||'')
    ){
      el('panelTable').innerHTML=`
        <div class="empty v217-timeout">
          <b>La consulta está demorando más de lo esperado.</b>
          <div>Puede volver a intentar sin cambiar de usuario.</div>
          <button class="btn secondary small"
                  onclick="loadPanel({forceFresh:true,refreshCards:false})">
            Reintentar consulta
          </button>
        </div>`;
      if(el('pageInfo'))el('pageInfo').textContent='Consulta pendiente';
    }
  },10000);
}

async function openOwnerCustodyV215(nombre){
  if(isCoordinator() && !coordinatorCanViewUserV205(nombre)){
    toast('El perfil Coordinador solo puede consultar al personal de su área.');
    return;
  }

  // V215 · El botón general "Ver expedientes" siempre empieza en
  // TOTAL EN CUSTODIA. Nunca reutiliza el estado que hubiera quedado
  // seleccionado previamente.
  panelQuickFilter='custody';
  page=0;
  selectedIds.clear();

  if(el('searchInput'))el('searchInput').value='';
  if(el('ownerStateFilter'))el('ownerStateFilter').value='custody';

  updateSelectionUI();

  startCoordinatorPanelTimeoutV217(nombre);
  await setOwner(nombre,'custody');

  if(el('ownerStateFilter')){
    el('ownerStateFilter').value='custody';
  }

  panelQuickFilter='custody';
  updateKpiQuickUI();
  syncCoordinatorStateCountsV216();

  el('ownerDetailFilters')?.scrollIntoView({
    behavior:'auto',
    block:'start'
  });

  syncCoordinatorStateCountsV216();
}

async function openOwnerExpedientes(nombre,tipo='custody'){
  if(isCoordinator() && !coordinatorCanViewUserV205(nombre)){
    toast('El perfil Coordinador solo puede consultar al personal de su área.');
    return;
  }

  if(el('searchInput'))el('searchInput').value='';

  selectedIds.clear();
  updateSelectionUI();
  await setOwner(nombre,tipo==='total'?'custody':tipo);

  renderOwnerCards();

  el('ownerDetailFilters')?.scrollIntoView({
    behavior:'auto',
    block:'start'
  });
}

function syncSelectedOwnerKpisFromCards(){
  if(!selectedOwnerIsUser())return;
  const s=ownerCardsRows.find(x=>x.nombre===selectedOwner)||{};
  if(el('kTotal'))el('kTotal').textContent=Number(s.total_custodia||0);
  if(el('kLoan'))el('kLoan').textContent=Number(s.en_prestamo||0);
  if(el('kReassigned'))el('kReassigned').textContent=Number(s.reasignados||0);
  if(el('kPendingAttention'))el('kPendingAttention').textContent=Number(s.pendientes_por_atender||0);
  if(el('kPending'))el('kPending').textContent=Number(s.devoluciones_pendientes_aceptacion||0);
  if(el('kReturnedHistory'))el('kReturnedHistory').textContent=Number(s.devoluciones_realizadas||0);
}



function currentResponsibleDisplay(r){
  if(!r)return '—';

  // V721 · responsable del ciclo vigente, no del maestro histórico.
  if(r._v721_custodia_verificada && r.responsable_actual){
    return r.responsable_actual;
  }

  const state=norm(
    r.estado_operativo||
    r.estado_actual_db||
    r.estado||
    operationalStatus(r)||
    ''
  );

  // Cuando el expediente ya fue recibido físicamente por Archivo,
  // su responsable/ubicación actual debe mostrarse como ARCHIVO.
  if(
    state==='DEVUELTO AL ARCHIVO' ||
    state==='DEVUELTO' ||
    state==='CUSTODIA'
  ){
    return 'ARCHIVO';
  }

  return (
    r.responsable||
    r.responsable_actual_db||
    r.responsable_actual||
    '—'
  );
}

function historicalReturnCurrentState(r){
  // El expediente puede haber iniciado un ciclo nuevo después de la devolución.
  // Mostrar aquí el estado ACTUAL sin alterar el hecho histórico.
  return operationalStatus(r)||r.estado_actual_db||r.estado||'—';
}


function isReturnAcceptanceMovement(m){
  const action=norm(m?.accion||'');
  return (
    action.includes('DEVOLUCION CONFIRMADA') ||
    action.includes('DEVOLUCIÓN CONFIRMADA') ||
    action.includes('RECIBIDO EN ARCHIVO') ||
    action.includes('RECEPCION CONFIRMADA') ||
    action.includes('RECEPCIÓN CONFIRMADA')
  );
}

function historicalReturnAcceptedAt(r){
  return (
    r?.fecha_aceptacion_devolucion||
    r?.fecha_recepcion_archivo||
    r?.master_fecha_devolucion||
    r?.fecha_devolucion||
    r?.fecha_devuelto_por_usuario||
    null
  );
}

function historicalReturnAcceptedBy(r){
  const value=String(
    r?.responsable_acepta_devolucion||
    r?.aceptado_devolucion_por||
    r?.profesional_recibe||
    r?.recibido_por||
    r?.master_recibe||
    ''
  ).trim();

  // "ARCHIVO" es una ubicación/área, no una persona.
  // El responsable de aceptar debe ser un perfil ARCHIVO o ADMINISTRADOR.
  if(
    !value ||
    norm(value)==='ARCHIVO' ||
    norm(value)==='ARCHIVO DE GESTIÓN' ||
    norm(value)==='ARCHIVO DE GESTION'
  ){
    return 'NO REGISTRADO';
  }

  return value;
}

async function enrichHistoricalReturnAcceptance(rows){
  const list=Array.isArray(rows)?rows:[];
  if(!list.length||!sb||!session)return list;

  const expedienteIds=[...new Set(
    list.map(r=>String(
      r?.expediente_id||
      r?.id||
      ''
    )).filter(Boolean)
  )];

  if(!expedienteIds.length)return list;

  // =========================================================
  // V110 · FUENTE PRINCIPAL
  // Leer el responsable REAL que aceptó la devolución.
  // Ese dato lo registra automáticamente PostgreSQL en el momento
  // en que un perfil ARCHIVO o ADMINISTRADOR confirma la recepción.
  // =========================================================
  const acceptanceItems=list
    .map(r=>({
      solicitud_id:String(
        r?.solicitud_id||
        r?.solicitud_pendiente_id||
        ''
      ).trim()||null,

      expediente_id:String(
        r?.expediente_id||
        r?.id||
        ''
      ).trim()||null
    }))
    .filter(x=>x.expediente_id);

  const acceptanceMap=new Map();

  if(acceptanceItems.length){
    const {data:acceptanceData,error:acceptanceError}=await sb.rpc(
      'obtener_aceptaciones_devolucion_operativo',
      {p_items:acceptanceItems}
    );

    if(!acceptanceError){
      (acceptanceData||[]).forEach(x=>{
        const key=
          `${String(x.solicitud_id||'')}::${String(x.expediente_id||'')}`;

        acceptanceMap.set(key,x);
      });
    }else{
      console.warn(
        'obtener_aceptaciones_devolucion_operativo:',
        acceptanceError.message
      );
    }
  }

  // =========================================================
  // RESPALDO HISTÓRICO
  // Para devoluciones anteriores a V110, intentar recuperar el nombre
  // desde movimientos_prestamo. No inventar "ARCHIVO".
  // =========================================================
  let movements=[];

  try{
    const {data,error}=await sb
      .from('movimientos_prestamo')
      .select('*')
      .in('expediente_id',expedienteIds)
      .order('created_at',{ascending:false});

    if(error){
      console.warn('Recepción histórica de devoluciones:',error.message);
    }else{
      movements=(data||[]).filter(isReturnAcceptanceMovement);
    }
  }catch(error){
    console.warn(
      'Recepción histórica de devoluciones:',
      error?.message||error
    );
  }

  return list.map(r=>{
    const expedienteId=String(
      r?.expediente_id||
      r?.id||
      ''
    );

    const requestId=String(
      r?.solicitud_id||
      r?.solicitud_pendiente_id||
      ''
    );

    const acceptanceKey=`${requestId}::${expedienteId}`;
    const savedAcceptance=acceptanceMap.get(acceptanceKey)||null;

    const cargo=String(
      r?.cargo_devolucion_usuario||
      r?.cargo||
      ''
    ).trim();

    const candidates=movements.filter(m=>
      String(m?.expediente_id||'')===expedienteId
    );

    let acceptedMovement=requestId
      ?candidates.find(m=>
          String(m?.solicitud_id||'')===requestId
        )
      :null;

    if(!acceptedMovement && cargo){
      acceptedMovement=candidates.find(m=>
        String(m?.cargo_numero||'').trim()===cargo
      )||null;
    }

    if(!acceptedMovement){
      acceptedMovement=candidates[0]||null;
    }

    const movementReceiver=String(
      acceptedMovement?.recibido_por||
      acceptedMovement?.profesional_recibe||
      acceptedMovement?.atendido_por||
      acceptedMovement?.registrado_por||
      acceptedMovement?.atiende||
      ''
    ).trim();

    const movementTarget=String(
      acceptedMovement?.hacia||
      ''
    ).trim();

    const targetLooksLikePerson=
      movementTarget &&
      !norm(movementTarget).includes('ARCHIVO') &&
      !norm(movementTarget).includes('CUSTODIA');

    const savedActor=String(
      savedAcceptance?.aceptado_por||
      ''
    ).trim();

    return {
      ...r,

      fecha_aceptacion_devolucion:
        savedAcceptance?.fecha_aceptacion_devolucion||
        acceptedMovement?.created_at||
        r.fecha_devolucion||
        r.fecha_devuelto_por_usuario||
        null,

      responsable_acepta_devolucion:
        savedActor||
        r.responsable_acepta_devolucion||
        r.aceptado_devolucion_por||
        r.profesional_recibe||
        r.recibido_por||
        movementReceiver||
        (targetLooksLikePerson?movementTarget:'')||
        '',

      rol_acepta_devolucion:
        savedAcceptance?.rol||
        r.rol_acepta_devolucion||
        ''
    };
  });
}


function renderOwnerHistoricalReturnsTable(rows,owner){
  if(!rows.length){
    if(isCoordinatorTeamWorkspaceV206()){
      const summary=(ownerCardsRows||[]).find(
        x=>norm(x.nombre)===norm(owner)
      )||{};
      const expected=Number(summary.devoluciones_realizadas||0);

      return `<div class="empty v222-return-empty">
        <b>No se pudieron mostrar las devoluciones históricas.</b>
        ${expected>0
          ?`<div>La tarjeta registra <b>${expected}</b> devolución${expected===1?'':'es'} para ${esc(owner)}.</div>
             <div>Verifique que la función V222 esté instalada en Supabase y vuelva a intentar.</div>`
          :''
        }
      </div>`;
    }

    return '<div class="empty">No hay devoluciones al Archivo registradas para este usuario.</div>';
  }

  return `<table>
    <thead><tr>
      <th>Expediente</th>
      <th>Ext.</th>
      <th>R.D.</th>
      <th class="subject-cell-v455 subject-cell-v639">Asunto</th>
      <th>Devuelto por</th>
      <th>Fecha / hora devolución</th>
      <th title="Perfil ARCHIVO o ADMINISTRADOR que confirmó la recepción física">Responsable que acepta la devolución</th>
      <th>Cargo del ciclo</th>
      <th>Estado actual</th>
      <th>Listado</th>
      <th>Ubicación actual</th>
      <th>Responsable actual / ubicación</th>
      <th>Último folio</th>
      <th></th>
    </tr></thead>

    <tbody>${rows.map(r=>`
      <tr>
        <td><b>${esc(r.expediente||'—')}</b></td>
        <td>${esc(r.extension||'—')}</td>
        <td>${esc(r.rd||'—')}</td>

        <td class="subject-cell-v455 subject-cell-v639" title="${esc(expedienteAsuntoValue(r)||'')}"><div class="subject-text-v639">${esc(expedienteAsuntoValue(r)||'—')}</div></td>

        <td class="historical-returner-name">
          <b>${esc(r.devuelto_por||owner||'—')}</b>
        </td>

        <td class="historical-return-accepted-at">
          ${historicalReturnAcceptedAt(r)
            ?masterDateTimeHtml(historicalReturnAcceptedAt(r))
            :'—'
          }
        </td>

        <td class="historical-return-accepted-by">
          <b>${esc(historicalReturnAcceptedBy(r))}</b>
        </td>

        <td>${esc(r.cargo_devolucion_usuario||r.cargo||'—')}</td>

        <td>
          ${rowStatus(r)}
          <div class="historical-current-note">
            Estado actual
          </div>
        </td>

        <td>${v246ArchiveListHtml(r)}</td>
        <td>${v246ArchiveLocationHtml(r)}</td>

        <td><b>${esc(currentResponsibleDisplay(r))}</b></td>
        <td>${esc(r.ultimo_folio||'—')}</td>

        <td>
          ${cycleHistoryButton(
            r.id,
            r
          )}
        </td>
      </tr>
    `).join('')}</tbody>
  </table>`;
}

function summaryFor(name){
  if(!name){
    return summaryRows.reduce(
      (a,x)=>({
        total:a.total+Number(x.total||0),
        pendientes:a.pendientes+Number(x.pendientes||0),
        en_prestamo:a.en_prestamo+Number(x.en_prestamo||0),
        alertas:a.alertas+Number(x.alertas||0)
      }),
      {total:0,pendientes:0,en_prestamo:0,alertas:0}
    );
  }

  const x=summaryRows.find(s=>s.responsable===name);
  return x
    ?{
      total:Number(x.total||0),
      pendientes:Number(x.pendientes||0),
      en_prestamo:Number(x.en_prestamo||0),
      alertas:Number(x.alertas||0)
    }
    :{total:0,pendientes:0,en_prestamo:0,alertas:0};
}

function selectedOwnerIsUser(){
  return !!(
    selectedOwner &&
    !isLimitedUser() &&
    ownerNameIsSelectableV392(selectedOwner)
  );
}


function stateSummaryOrder(state){
  const order={
    'EN PRÉSTAMO':1,
    'REASIGNADO':2,
    'DEVOLUCIÓN SOLICITADA':3,
    'DEVUELTO AL ARCHIVO':4,
    'PENDIENTE DE VERIFICACIÓN':5,
    'EN TRÁMITE':6
  };
  return order[state]||50;
}

function summarizeOperationalStates(rows){
  const counts=new Map();

  (rows||[]).forEach(r=>{
    const state=(operationalStatus(r)||'SIN ESTADO').trim()||'SIN ESTADO';
    counts.set(state,(counts.get(state)||0)+1);
  });

  return [...counts.entries()]
    .sort((a,b)=>
      stateSummaryOrder(a[0])-stateSummaryOrder(b[0]) ||
      b[1]-a[1] ||
      a[0].localeCompare(b[0],'es')
    );
}

function renderKpiStateSummary(id,rows){
  const box=el(id);
  if(!box)return;

  const list=summarizeOperationalStates(rows);

  if(!list.length){
    box.innerHTML='<span class="state-summary-title">Estados:</span> sin expedientes';
    return;
  }

  box.innerHTML=
    '<span class="state-summary-title">Estados:</span> '+
    list.map(([state,count])=>
      `<span class="kpi-state-chip">${esc(state)} <b>${count}</b></span>`
    ).join('');
}

function setOwnerKpiStatesLoading(){
  if(el('kTotalStates')){
    el('kTotalStates').innerHTML=
      '<span class="state-summary-title">Estados:</span> cargando...';
  }
}

function clearOwnerKpiStateSummaries(){
  if(el('kTotalStates'))el('kTotalStates').innerHTML='';
}

async function loadOwnerUserKpiStates(name,requestedName){
  const {data,error}=await sb.rpc(
    'listar_tarjeta_usuario_admin_v5',
    {
      p_nombre:name,
      p_tipo:'CUSTODIA',
      p_busqueda:null
    }
  );

  if(selectedOwner!==requestedName)return;

  if(error){
    console.warn('CUSTODIA:',error.message);
    if(el('kTotalStates')){
      el('kTotalStates').innerHTML=
        '<span class="state-summary-title">Estados:</span> no disponible';
    }
    return;
  }

  let enriched=Array.isArray(data)?data:[];
  enriched=await applyV171CanonicalCustody(enriched,{overwriteResponsible:true,overwriteLocation:true});

  if(selectedOwner!==requestedName)return;

  renderKpiStateSummary('kTotalStates',enriched);
}
async function loadOwnerUserKpis(name){
  if(!name||!sb||!session)return;

  const requested=name;

  const [{data,error},pendingByUser]=await Promise.all([
    sb.rpc(
      'resumen_tarjetas_usuario_admin_v5',
      {p_nombre:name}
    ),
    loadPendingItemCountMapBySolicitanteV165()
  ]);

  if(selectedOwner!==requested)return;

  if(error){
    console.warn('resumen_tarjetas_usuario_admin_v5:',error.message);
    ['kTotal','kLoan','kReassigned','kPendingAttention',
     'kPending','kReturnedHistory','kAlert']
      .forEach(id=>{
        if(el(id))el(id).textContent='—';
      });
    return;
  }

  const s=Array.isArray(data)?(data[0]||{}):(data||{});

  ownerUserKpiSummary={
    total_custodia:Number(s.total_custodia||0),
    en_prestamo:Number(s.en_prestamo||0),
    reasignados:Number(s.reasignados_a_mi||0),
    pendientes_por_atender:Number(pendingByUser.get(name)||0),
    devoluciones_pendientes_aceptacion:Number(s.devolucion_solicitada||0),
    devoluciones_realizadas:Number(s.devueltos_al_archivo||0),
    alertas_30:Number(s.alertas_30||0)
  };

  if(el('kTotal'))el('kTotal').textContent=ownerUserKpiSummary.total_custodia;
  if(el('kLoan'))el('kLoan').textContent=ownerUserKpiSummary.en_prestamo;
  if(el('kReassigned'))el('kReassigned').textContent=ownerUserKpiSummary.reasignados;
  if(el('kPendingAttention'))el('kPendingAttention').textContent=ownerUserKpiSummary.pendientes_por_atender;
  if(el('kPending'))el('kPending').textContent=ownerUserKpiSummary.devoluciones_pendientes_aceptacion;
  if(el('kReturnedHistory'))el('kReturnedHistory').textContent=ownerUserKpiSummary.devoluciones_realizadas;
  if(el('kAlert'))el('kAlert').textContent=ownerUserKpiSummary.alertas_30;

  setOwnerKpiStatesLoading();
  loadOwnerUserKpiStates(name,requested);

  updateKpiQuickUI();
}

function renderKpis(){
  updateOwnerPanelVisibility();

  if(typeof v629IsOtherUser==='function' && v629IsOtherUser()){
    if(el('fullAccessKpis')){
      el('fullAccessKpis').classList.remove('hidden','hidden-by-role');
      el('fullAccessKpis').classList.add('owner-user-kpis');
    }
    if(typeof v629RefreshOtherKpis==='function'){
      v629RefreshOtherKpis(selectedOwner).catch(error=>
        console.warn('V629 · tarjetas de otro usuario:',error?.message||error)
      );
    }
    return;
  }

  // ADMINISTRADOR / ARCHIVO: las tarjetas aparecen al seleccionar
  // un usuario y quedan vinculadas a su detalle.
  if(hasFullAccess() && !isLimitedUser()){
    if(el('fullAccessKpis')){
      el('fullAccessKpis').classList.toggle('hidden',!selectedOwnerIsUser());
      el('fullAccessKpis').classList.toggle('owner-user-kpis',selectedOwnerIsUser());
    }
    syncSelectedOwnerKpisFromCards();
    return;
  }

  const s=summaryFor(selectedOwner);
  if(el('kTotal'))el('kTotal').textContent=s.total;
  if(el('kPending'))el('kPending').textContent=s.pendientes;
  if(el('kLoan'))el('kLoan').textContent=s.en_prestamo;
  if(el('kAlert'))el('kAlert').textContent=s.alertas;
}
function renderSidebar(){
  const activos=catalogo.filter(x=>x.activo!==false);
  const allAbogados=abogadoNames();

  // Si hay un área activa, el bloque USUARIOS / ABOGADOS se limita
  // únicamente al personal configurado dentro de esa área.
  const abogados=selectedAreaFilter
    ?allAbogados.filter(name=>userBelongsToArea(name,selectedAreaFilter))
    :allAbogados;

  if(el('sidePersonalTitle')){
    el('sidePersonalTitle').textContent=selectedAreaFilter
      ?`Usuarios / abogados · ${selectedAreaFilter}`
      :'Usuarios / abogados';
  }

  // USUARIOS / ABOGADOS:
  // Conservan el conteo que ya utilizaba el panel.
  const pendingMap=new Map(
    summaryRows.map(x=>[
      norm(x.responsable||''),
      Number(x.pendientes||0)
    ])
  );

  // ÁREAS / ETAPAS / UBICACIONES:
  // El total del área incluye:
  // 1) expedientes asignados directamente a esa ubicación/área; y
  // 2) expedientes en custodia del personal cuyo area_trabajo
  //    corresponde a esa área.
  const totalMap=new Map(
    summaryRows.map(x=>[
      norm(x.responsable||''),
      Number(x.total||0)
    ])
  );

  const personalByArea=new Map();
  activos
    .filter(x=>norm(x.tipo)==='PERSONAL' && String(x.area_trabajo||'').trim())
    .forEach(p=>{
      const areaKey=areaMatchKey(p.area_trabajo||'');
      if(!areaKey)return;
      if(!personalByArea.has(areaKey))personalByArea.set(areaKey,[]);
      personalByArea.get(areaKey).push(p);
    });

  function totalCustodiaArea(areaName){
    const areaKey=norm(areaName||'');
    let total=Number(totalMap.get(areaKey)||0);

    const miembros=personalByArea.get(areaMatchKey(areaName))||[];
    miembros.forEach(p=>{
      total+=Number(totalMap.get(norm(p.nombre||''))||0);
    });

    return total;
  }

  const makeName=name=>{
    const count=pendingMap.get(norm(name))||0;
    return `<div class="side-item ${selectedOwner===name?'active':''}"
      onclick="setOwner('${name.replace(/'/g,"\\'")}')
      " title="${count} expediente${count===1?'':'s'}">
        <span>${esc(name)}</span>
        <span class="badge">${count}</span>
      </div>`;
  };

  const makeArea=x=>{
    const count=totalCustodiaArea(x.nombre);
    const miembros=(personalByArea.get(areaMatchKey(x.nombre))||[])
      .map(p=>p.nombre)
      .filter(Boolean);

    const detalle=miembros.length
      ?`Incluye custodia directa del área y expedientes de: ${miembros.join(', ')}`
      :'Cantidad de expedientes actualmente ubicados en esta área';

    return `<div class="side-item ${areaMatchKey(selectedAreaFilter)===areaMatchKey(x.nombre)?'active':''}"
      onclick="setOwner('${x.nombre.replace(/'/g,"\\'")}')
      " title="${esc(detalle)}">
        <span>${esc(x.nombre)}</span>
        <span class="badge">${count}</span>
      </div>`;
  };

  el('sidePersonal').innerHTML=abogados.length
    ?abogados.map(makeName).join('')
    :selectedAreaFilter
      ?`<div class="note" style="padding:8px">No hay usuarios / abogados configurados en ${esc(selectedAreaFilter)}.</div>`
      :'<div class="note" style="padding:8px">No hay usuarios/abogados asociados.</div>';

  el('sideAreas').innerHTML=activos
    .filter(x=>x.tipo!=='PERSONAL')
    .filter(x=>!isCoordinator()||coordinatorCanViewAreaV205(x.nombre))
    .map(makeArea)
    .join('');

  el('countAll').textContent=summaryFor('').pendientes;
  el('sideAll').classList.toggle('active',!selectedOwner&&!selectedAreaFilter);
}
function renderSummary(){
  const activos=catalogo.filter(x=>x.activo!==false);
  const map=new Map(
    summaryRows.map(x=>[
      norm(x.responsable||''),
      {
        total:Number(x.total||0),
        pendientes:Number(x.pendientes||0),
        alertas:Number(x.alertas||0)
      }
    ])
  );

  const personalByArea=new Map();
  activos
    .filter(x=>norm(x.tipo)==='PERSONAL' && String(x.area_trabajo||'').trim())
    .forEach(p=>{
      const k=norm(p.area_trabajo||'');
      if(!personalByArea.has(k))personalByArea.set(k,[]);
      personalByArea.get(k).push(p);
    });

  const data=activos.map(x=>{
    const key=norm(x.nombre);
    const s=map.get(key)||{};
    let total=Number(s.total||0);

    if(norm(x.tipo)!=='PERSONAL'){
      (personalByArea.get(key)||[]).forEach(p=>{
        total+=Number(map.get(norm(p.nombre))?.total||0);
      });
    }

    return{
      name:x.nombre,
      type:x.tipo,
      total,
      pending:Number(s.pendientes||0),
      alerts:Number(s.alertas||0)
    };
  }).sort((a,b)=>b.pending-a.pending||a.name.localeCompare(b.name));

  el('summaryGrid').innerHTML=data.map(x=>`
    <div class="card summary-card" onclick="setOwner('${x.name.replace(/'/g,"\\'")}')">
      <div>
        <h3>${esc(x.name)}</h3>
        <small>${esc(x.type)} · ${x.pending} pendientes · ${x.alerts} alertas</small>
      </div>
      <div class="summary-num">${x.total}</div>
    </div>`).join('');
}

function applySearch(query,q){
  q=cleanSearch(q);
  if(!q)return query;

  const p=`%${q}%`;

  return query.or(
    `expediente.ilike.${p},`+
    `extension.ilike.${p},`+
    `rd.ilike.${p},`+
    `responsable.ilike.${p},`+
    `estado.ilike.${p},`+
    `modalidad.ilike.${p},`+
    `cargo.ilike.${p},`+
    `observacion.ilike.${p},`+
    `acumulado.ilike.${p},`+
    `ultimo_folio.ilike.${p}`
  );
}

async function attachLatestMovementToRecords(rows){
  if(!rows?.length || !sb)return rows||[];

  const ids=[...new Set(rows.map(r=>r.id).filter(Boolean))];
  if(!ids.length)return rows;

  // Consultar en grupos pequeños y paginar internamente.
  // Así el "último estado" no depende del límite de 1000 filas de Supabase.
  const chunks=[];
  const CHUNK_SIZE=100;
  for(let i=0;i<ids.length;i+=CHUNK_SIZE){
    chunks.push(ids.slice(i,i+CHUNK_SIZE));
  }

  const movementRows=[];
  const itemRows=[];
  const custodyRowsV627=[];
  // V721 · comparar la misma fila física con su ciclo de custodia vigente.
  const custodyRowsV721=[];

  async function fetchPaged(table,columns,idChunk,orderColumn){
    const out=[];
    const PAGE=1000;
    let from=0;

    while(true){
      const q=sb
        .from(table)
        .select(columns)
        .in('expediente_id',idChunk)
        .order(orderColumn,{ascending:false})
        .range(from,from+PAGE-1);

      const {data,error}=await q;
      if(error)throw error;

      const part=data||[];
      out.push(...part);

      if(part.length<PAGE)break;
      from+=PAGE;
    }

    return out;
  }

  for(const idChunk of chunks){
    try{
      const [moves,items,custodyResult,v721Result]=await Promise.all([
        fetchPaged(
          'movimientos_prestamo',
          'expediente_id,accion,desde,hacia,estado,cargo_numero,created_at',
          idChunk,
          'created_at'
        ),
        fetchPaged(
          'solicitud_expedientes',
          'expediente_id,estado,fecha_entrega,updated_at',
          idChunk,
          'updated_at'
        ),
        sb.rpc('v627_fechas_custodia_actual',{p_expediente_ids:idChunk}),
        // V721 · este resultado solo hidrata UUIDs ya autorizados en la vista.
        // No realiza acciones de escritura ni cruza variantes por número.
        sb.from('v_custodia_usuario_v5')
          .select('expediente_id,solicitud_id,estado_actual,responsable_actual,ultimo_movimiento,ultimo_movimiento_desde,ultimo_movimiento_hacia,ultimo_movimiento_fecha,fecha_entrega_vinculo')
          .in('expediente_id',idChunk)
      ]);

      movementRows.push(...moves);
      itemRows.push(...items);

      if(custodyResult?.error){
        console.warn('V627 · fecha de custodia:',custodyResult.error.message);
      }else{
        custodyRowsV627.push(...(custodyResult?.data||[]));
      }
      if(v721Result?.error){
        // Si la vista no está habilitada para un perfil, se conserva el
        // comportamiento anterior sin hacer pasar un error por CUSTODIA.
        console.warn('V721 · custodia vigente no disponible:',v721Result.error.message);
      }else{
        custodyRowsV721.push(...(v721Result?.data||[]));
      }
    }catch(error){
      console.warn('No se pudo cargar contexto operativo del expediente:',error?.message||error);
    }
  }

  const latest=new Map();
  movementRows.forEach(m=>{
    const key=String(m.expediente_id||'');
    if(key && !latest.has(key))latest.set(key,m);
  });

  // Última reasignación efectiva registrada.
  // movementRows viene ordenado desde el movimiento más reciente.
  const latestReassignment=new Map();
  movementRows.forEach(m=>{
    const key=String(m.expediente_id||'');
    const action=norm(m.accion||'');

    if(
      key &&
      !latestReassignment.has(key) &&
      action.includes('REASIGN') &&
      !action.includes('SOLICITUD')
    ){
      latestReassignment.set(key,m);
    }
  });

  const custodyMapV627=new Map(
    custodyRowsV627.map(x=>[String(x.expediente_id||''),x])
  );
  const custodyMapV721=new Map(
    custodyRowsV721.map(x=>[String(x.expediente_id||''),x])
  );

  const latestItem=new Map();
  itemRows.forEach(x=>{
    const key=String(x.expediente_id||'');
    if(key && !latestItem.has(key))latestItem.set(key,x);
  });

  // Primera entrega física registrada del expediente.
  // Se conserva como referencia histórica aunque después existan
  // devoluciones, reasignaciones o nuevas solicitudes.
  const firstDelivery=new Map();

  itemRows.forEach(x=>{
    const key=String(x.expediente_id||'');
    const date=normalizeDate(x.fecha_entrega);
    if(!key||!date)return;

    const prev=firstDelivery.get(key);
    if(!prev || String(date)<String(prev)){
      firstDelivery.set(key,date);
    }
  });

  return rows.map(r=>{
    const key=String(r.id||'');
    const m=latest.get(key);
    const reassign=latestReassignment.get(key);
    const item=latestItem.get(key);
    const custodyV627=custodyMapV627.get(key)||{};
    const custodyV721=custodyMapV721.get(key)||null;
    const v721EstadoNormalizado=v=>String(v||'').trim()
      .normalize('NFD').replace(/[̀-ͯ]/g,'').toUpperCase();
    const currentCycle=Boolean(custodyV721?.solicitud_id) &&
      ['EN PRESTAMO','REASIGNADO','DEVOLUCION SOLICITADA']
        .includes(v721EstadoNormalizado(custodyV721.estado_actual));
    const first=firstDelivery.get(key)||normalizeDate(r.fecha_entrega)||null;

    return {
      ...r,
      // La lectura por solicitud activa prevalece sobre la devolución de
      // cualquier solicitud anterior del mismo UUID físico. El registro
      // maestro no se modifica aquí; el histórico permanece intacto.
      ...(currentCycle ? {
        _v721_custodia_verificada:true,
        _v721_estado_maestro_original:r.estado||'',
        _v721_responsable_maestro_original:r.responsable||'',
        _v721_solicitud_vigente:custodyV721.solicitud_id,
        estado_operativo:custodyV721.estado_actual,
        estado_actual_db:custodyV721.estado_actual,
        responsable_actual:custodyV721.responsable_actual,
        responsable_actual_db:custodyV721.responsable_actual,
        ultimo_movimiento:custodyV721.ultimo_movimiento||m?.accion||'',
        ultimo_movimiento_desde:custodyV721.ultimo_movimiento_desde||m?.desde||'',
        ultimo_movimiento_hacia:custodyV721.ultimo_movimiento_hacia||m?.hacia||'',
        ultimo_movimiento_fecha:custodyV721.ultimo_movimiento_fecha||m?.created_at||null,
        fecha_entrega_solicitud_actual:custodyV721.fecha_entrega_vinculo||null,
        estado_solicitud_item:custodyV721.estado_actual
      } : {
        ultimo_movimiento:m?.accion||'',
        ultimo_movimiento_desde:m?.desde||'',
        ultimo_movimiento_hacia:m?.hacia||'',
        ultimo_movimiento_fecha:m?.created_at||null,
        estado_solicitud_item:item?.estado||''
      }),

      // V627 · fecha canónica desde la que se cuentan los días de la
      // custodia ACTUAL, independientemente del módulo que originó el traslado.
      fecha_inicio_custodia_vigente:
        custodyV627.fecha_inicio_custodia ||
        r.fecha_inicio_custodia_vigente ||
        r.fecha_inicio_custodia ||
        null,
      fecha_inicio_custodia:
        custodyV627.fecha_inicio_custodia ||
        r.fecha_inicio_custodia ||
        null,
      movimiento_inicio_custodia:
        custodyV627.movimiento_custodia ||
        r.movimiento_inicio_custodia ||
        '',
      custodia_desde:custodyV627.desde||r.custodia_desde||'',
      custodia_hacia:custodyV627.hacia||r.custodia_hacia||'',
      dias_custodia:Number.isFinite(Number(custodyV627.dias_habiles))
        ?Number(custodyV627.dias_habiles)
        :(r.dias_custodia??null),

      // Última reasignación histórica. Se conserva incluso si después
      // el expediente fue devuelto, derivado o cambió nuevamente de estado.
      fecha_ultima_reasignacion:
        r.fecha_ultima_reasignacion||
        r.fecha_reasignacion||
        reassign?.created_at||
        null,

      // Fecha del ciclo / solicitud vigente.
      fecha_entrega_solicitud_actual:currentCycle
        ?(custodyV721.fecha_entrega_vinculo||null)
        :(item?.fecha_entrega||undefined),

      // Fecha histórica de la PRIMERA entrega física.
      fecha_primera_entrega:first
    };
  });
}

function archiveDeliveryVisualState(r){
  const expedienteId=String(r?.id||r?.expediente_id||'');
  if(!expedienteId)return '';

  const req=(archiveDeliveryRows||[]).find(x=>
    String(x.expediente_id||'')===expedienteId
  );
  if(!req)return '';

  const state=norm(req.estado||'');
  if(state==='SOLICITADA')return 'SOLICITADO POR EL ARCHIVO';
  if(state==='PREPARADA')return 'DEVOLUCIÓN SOLICITADA';
  return '';
}

function movementLabel(r){
  if(r?._internal_reassign_requested){
    const from=String(
      r._internal_request_from||
      r.ultimo_movimiento_desde||
      ''
    ).trim();

    const target=String(
      r._internal_request_target||
      r.responsable||
      ''
    ).trim();

    if(from && target){
      return `REASIGNACIÓN SOLICITADA · ${esc(from)} → ${esc(target)}`;
    }

    return target
      ?`REASIGNACIÓN SOLICITADA → ${esc(target)}`
      :'REASIGNACIÓN SOLICITADA';
  }

  const archiveState=archiveDeliveryVisualState(r);
  if(archiveState==='SOLICITADO POR EL ARCHIVO'){
    return 'SOLICITUD DE DEVOLUCIÓN · ARCHIVO';
  }

  const action=(r.ultimo_movimiento||'').trim();
  if(!action)return '—';

  const desde=(r.ultimo_movimiento_desde||'').trim();
  const hacia=(r.ultimo_movimiento_hacia||'').trim();

  // V112:
  // En una reasignación el último movimiento debe indicar claramente
  // quién tenía el expediente y hacia quién fue reasignado.
  if(
    norm(action).includes('REASIGN') &&
    !norm(action).includes('SOLICITUD')
  ){
    if(desde && hacia){
      return `REASIGNACIÓN · ${esc(desde)} → ${esc(hacia)}`;
    }

    if(hacia){
      return `REASIGNACIÓN → ${esc(hacia)}`;
    }

    if(desde){
      return `REASIGNACIÓN · ${esc(desde)} →`;
    }

    return esc(action);
  }

  let text=action;

  if(
    hacia &&
    [
      'DEVOLUCIÓN SOLICITADA',
      'DEVOLUCIÓN CONFIRMADA / RECIBIDO EN ARCHIVO'
    ].some(x=>action.includes(x))
  ){
    text+=` → ${hacia}`;
  }

  return esc(text);
}


async function openAdminDirectManagement(expedienteId){
  if(!isAdmin()){
    alert('La gestión directa sin solicitud está reservada al ADMINISTRADOR.');
    return;
  }

  await editRecord(expedienteId,true);

  if(el('saveStatus')){
    el('saveStatus').textContent=
      'Gestión directa del administrador: este expediente no tiene una solicitud asociada. Puede actualizar sus datos, estado y responsable.';
  }
}

async function manageExpedienteFromPanel(expedienteId,button=null){
  if(isCoordinator()){
    toast('El perfil Coordinador es de seguimiento y no puede gestionar la atención de solicitudes.');
    return;
  }

  if(!sb||!session)return;

  expedienteId=String(expedienteId||'').trim();

  if(!expedienteId){
    alert('No se pudo identificar el expediente seleccionado.');
    return;
  }

  const originalText=button?.textContent||'Gestionar';
  if(button){
    button.disabled=true;
    button.textContent='Abriendo...';
  }

  try{
    // Relación directa expediente → solicitud.
    // Es mucho más rápida que recorrer el historial de movimientos.
    const {data:links,error:linkError}=await sb
      .from('solicitud_expedientes')
      .select('solicitud_id')
      .eq('expediente_id',expedienteId);

    if(linkError)throw linkError;

    const ids=[...new Set((links||[])
      .map(x=>x.solicitud_id)
      .filter(Boolean))];

    if(!ids.length){
      if(isAdmin()){
        await openAdminDirectManagement(expedienteId);
        return;
      }

      alert('Este expediente no tiene una solicitud asociada para gestionar.');
      return;
    }

    // Traer únicamente las cabeceras relacionadas con este expediente.
    const {data:sols,error:solErr}=await sb
      .from('solicitudes_prestamo')
      .select('*')
      .in('id',ids)
      .order('created_at',{ascending:false});

    if(solErr)throw solErr;

    const solicitudes=sols||[];

    // Priorizar la solicitud operativa más reciente.
    const cerrados=new Set(['CERRADA POR ARCHIVO','CERRADA']);
    const activa=solicitudes.find(s=>
      !cerrados.has(String(s.estado||'').trim().toUpperCase())
    );
    const target=activa||solicitudes[0];

    if(!target){
      if(isAdmin()){
        await openAdminDirectManagement(expedienteId);
        return;
      }
      alert('No se encontró la solicitud relacionada con este expediente.');
      return;
    }

    // Guardar la cabecera en memoria para que openRequestDetail no tenga
    // que recargar toda la bandeja de Solicitudes.
    requestRows=[
      target,
      ...(requestRows||[]).filter(x=>x.id!==target.id)
    ];

    await openRequestDetail(target.id);

    // Seleccionar automáticamente el expediente desde el cual se pulsó Gestionar.
    requestSelectedIds.clear();
    const item=requestDetailRows.find(x=>x.expediente_id===expedienteId);

    if(item && requestItemSelectable(item)){
      requestSelectedIds.add(expedienteId);
    }

    renderRequestDetailItems();
    renderRequestActions();

    if(el('rqActionStatus')){
      el('rqActionStatus').textContent=
        item ? `Expediente ${item.expediente} seleccionado para gestión.` : '';
    }

  }catch(err){
    if(isAdmin()){
      try{
        await openAdminDirectManagement(expedienteId);
        return;
      }catch(_){}
    }
    alert(err?.message||String(err));
  }finally{
    if(button){
      button.disabled=false;
      button.textContent=originalText;
    }
  }
}


async function openPendingAttentionDirect(expedienteId,button=null){
  if(!hasFullAccess()){
    alert('Solo Archivo o Administrador puede atender directamente un expediente.');
    return;
  }

  expedienteId=String(expedienteId||'').trim();
  if(!expedienteId){
    alert('No se pudo identificar el expediente pendiente por atender.');
    return;
  }

  const originalText=button?.textContent||'Gestionar';
  if(button){
    button.disabled=true;
    button.textContent='Abriendo...';
  }

  try{
    // Reutiliza la gestión directa existente:
    // 1) localiza la solicitud operativa,
    // 2) abre su detalle,
    // 3) selecciona automáticamente este expediente.
    await manageExpedienteFromPanel(expedienteId,null);

    const item=(requestDetailRows||[]).find(
      x=>String(x.expediente_id||'')===expedienteId
    );

    if(!item){
      if(el('rqActionStatus')){
        el('rqActionStatus').textContent=
          'No se encontró el expediente dentro de la solicitud relacionada.';
      }
      return;
    }

    const itemState=norm(item.estado_item||'');
    if(!['ACEPTADO','PENDIENTE POR ATENDER'].includes(itemState)){
      if(el('rqActionStatus')){
        el('rqActionStatus').textContent=
          `El expediente ${item.expediente||''} ya no se encuentra pendiente por atender. Estado actual: ${item.estado_item||'—'}.`;
      }
      return;
    }

    // Garantizar que solo quede seleccionado el expediente desde el cual
    // se pulsó Gestionar.
    requestSelectedIds.clear();
    requestSelectedIds.add(expedienteId);

    renderRequestDetailItems();
    renderRequestActions();

    if(el('rqActionStatus')){
      el('rqActionStatus').innerHTML=
        `<b>${esc(item.expediente||'Expediente')} listo para atender.</b> `+
        'Revise o complete <b>Extensión, R.D. y Último folio</b>, '+
        'seleccione <b>quién atiende</b> y pulse '+
        '<b>Guardar, generar e imprimir cargo</b>.';
    }

    // Llevar al usuario directamente a la zona de atención.
    setTimeout(()=>{
      const target=
        (!el('rqAttentionSection')?.classList.contains('hidden')
          ?el('rqAttentionSection')
          :el('rqWorkflowActions'));
      target?.scrollIntoView({behavior:'auto',block:'center'});
    },80);

  }catch(err){
    alert(err?.message||String(err));
  }finally{
    if(button){
      button.disabled=false;
      button.textContent=originalText;
    }
  }
}


async function openMasterReturnAcceptance(expedienteId,button=null){
  if(!hasFullAccess()){
    alert('Solo Archivo o Administrador puede aceptar una solicitud de devolución.');
    return;
  }

  const originalText=button?.textContent||'✓ Aceptar devolución';
