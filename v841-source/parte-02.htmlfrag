    </div>

    
<style id="v589-digital-mail-local-style">
#v588DigitalMailPanel{
  display:block!important;
  margin-top:12px!important;
  padding:12px!important;
  border:1px solid #cbd9e8!important;
  border-radius:10px!important;
  background:#f8fbff!important;
  box-sizing:border-box!important;
  font-family:inherit!important;
}
#v588DigitalMailPanel *{box-sizing:border-box!important}
#v588DigitalMailPanel .v588-digital-mail-head{
  display:flex!important;align-items:center!important;justify-content:space-between!important;
  gap:12px!important;margin-bottom:8px!important
}
#v588DigitalMailPanel .v588-digital-mail-head strong{
  font-size:15px!important;color:#0b3565!important;line-height:1.2!important
}
#v588DigitalMailPanel .v588-mail-toggle{
  display:flex!important;align-items:center!important;gap:7px!important;
  width:auto!important;margin:0!important;font-size:12px!important;font-weight:800!important
}
#v588DigitalMailPanel .v588-mail-toggle input{
  width:17px!important;height:17px!important;margin:0!important
}
#v588DigitalMailPanel .v588-digital-mail-note{
  display:block!important;margin:0 0 10px!important;padding:8px 10px!important;
  border:1px solid #dbe6f1!important;border-radius:8px!important;background:#fff!important;
  font-size:10px!important;line-height:1.4!important;color:#516b86!important
}
#v588DigitalMailPanel .v588-digital-mail-grid{
  display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1.12fr)!important;
  gap:12px!important;align-items:start!important
}
#v588DigitalMailPanel label{
  display:block!important;margin:0 0 5px!important;font-size:9px!important;
  font-weight:800!important;text-transform:uppercase!important;color:#536d89!important
}
#v588DigitalMailPanel input[type="text"],
#v588DigitalMailPanel input:not([type]),
#v588DigitalMailPanel #v588DigitalMailSearch,
#v588DigitalMailPanel #v588DigitalMailSubject{
  width:100%!important;min-width:0!important;height:38px!important;padding:7px 10px!important;
  border:1px solid #b9cbe0!important;border-radius:8px!important;background:#fff!important;
  font-size:12px!important;color:#173a5e!important
}
#v588DigitalMailPanel .v588-mail-search-row{
  display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;
  align-items:center!important;gap:8px!important
}
#v588DigitalMailPanel .v588-mail-search-row span,
#v588DigitalMailPanel #v588DigitalMailSelectedCount{
  font-size:10px!important;font-weight:850!important;color:#173f6b!important;white-space:nowrap!important
}
#v588DigitalMailPanel .v588-mail-recipient-list{
  display:block!important;margin-top:7px!important;max-height:205px!important;overflow:auto!important;
  border:1px solid #d7e1ec!important;border-radius:8px!important;background:#fff!important
}
#v588DigitalMailPanel .v588-mail-recipient{
  display:grid!important;grid-template-columns:20px minmax(0,1fr)!important;gap:8px!important;
  align-items:center!important;margin:0!important;padding:8px 9px!important;
  border-bottom:1px solid #edf2f7!important;cursor:pointer!important;
  text-transform:none!important
}
#v588DigitalMailPanel .v588-mail-recipient:last-child{border-bottom:0!important}
#v588DigitalMailPanel .v588-mail-recipient input{
  width:15px!important;height:15px!important;margin:0!important
}
#v588DigitalMailPanel .v588-mail-recipient b{
  display:block!important;font-size:11px!important;line-height:1.2!important;color:#123d6b!important
}
#v588DigitalMailPanel .v588-mail-recipient small{
  display:block!important;margin-top:2px!important;font-size:9px!important;line-height:1.25!important;color:#58708a!important
}
#v588DigitalMailPanel .v588-mail-selected-box{
  display:block!important;margin-top:8px!important;border:1px solid #d7e1ec!important;
  border-radius:8px!important;background:#fff!important;overflow:hidden!important
}
#v588DigitalMailPanel .v588-mail-selected-head{
  display:flex!important;align-items:center!important;justify-content:space-between!important;
  gap:8px!important;padding:8px 10px!important;background:#edf5fb!important;
  border-bottom:1px solid #d7e1ec!important;font-size:9px!important;color:#234d77!important
}
#v588DigitalMailPanel #v588DigitalMailSelected{
  display:grid!important;gap:6px!important;padding:7px!important;max-height:205px!important;overflow:auto!important
}
#v588DigitalMailPanel .v588-mail-selected-item{
  display:flex!important;align-items:center!important;justify-content:space-between!important;
  gap:8px!important;padding:7px 8px!important;border:1px solid #dbe5ef!important;border-radius:7px!important
}
#v588DigitalMailPanel .v588-mail-selected-item b{
  font-size:10px!important;color:#173f6b!important;line-height:1.35!important
}
#v588DigitalMailPanel .v588-mail-selected-item small{
  display:block!important;margin-top:2px!important;font-size:9px!important;color:#5c7188!important
}
#v588DigitalMailPanel .v588-mail-role{
  display:inline-flex!important;align-items:center!important;margin-left:5px!important;padding:1px 6px!important;
  border-radius:999px!important;font-size:8px!important;font-weight:900!important;vertical-align:1px!important
}
#v588DigitalMailPanel .v588-mail-role-to{
  background:#e7f1ff!important;border:1px solid #9fc4f2!important;color:#0b4f91!important
}
#v588DigitalMailPanel .v588-mail-role-cc{
  background:#f3f5f7!important;border:1px solid #cbd5df!important;color:#425466!important
}
#v588DigitalMailPanel .v588-mail-role-me{
  background:#e8f2fb!important;border:1px solid #bdd3e8!important;color:#245d8d!important
}
#v588DigitalMailPanel .v588-mail-remove{
  flex:0 0 28px!important;width:28px!important;height:28px!important;padding:0!important;
  border:1px solid #d4deea!important;border-radius:7px!important;background:#fff!important;
  color:#355474!important;cursor:pointer!important
}
#v588DigitalMailPanel .v588-digital-mail-status{
  display:block!important;margin-top:8px!important;font-size:10px!important
}
@media(max-width:820px){
  #v588DigitalMailPanel .v588-digital-mail-grid{grid-template-columns:1fr!important}
}
</style>

<section class="v588-digital-mail-panel" id="v588DigitalMailPanel">
      <div class="v588-digital-mail-head">
        <strong>✉ Notificación por correo de la copia digital</strong>
        <label class="v588-mail-toggle">
          <input id="v588DigitalMailEnabled" type="checkbox" checked>
          <span>Enviar correo</span>
        </label>
      </div>

      <div class="v588-digital-mail-note">
        <b>PARA:</b> solicitante original ·
        <b>CC:</b> Coordinador de Archivo + quien atiende + destinatarios adicionales.
        Si el Coordinador es quien atiende, aparecerá una sola vez en CC.
        El correo es complementario y no bloquea la entrega de la copia digital.
      </div>

      <div class="v588-digital-mail-grid">
        <div>
          <label>Destinatarios autorizados</label>
          <div class="v588-mail-search-row">
            <input id="v588DigitalMailSearch" placeholder="Buscar por nombre, apellido o correo...">
            <span id="v588DigitalMailCount">0 seleccionados</span>
          </div>
          <div class="v588-mail-recipient-list" id="v588DigitalMailRecipients">
            <div class="note">Cargando correos autorizados...</div>
          </div>
        </div>

        <div>
          <label>Asunto del correo *</label>
          <input id="v588DigitalMailSubject" value="Copia digital atendida">
          <div class="v588-mail-selected-box">
            <div class="v588-mail-selected-head">
              <b>DESTINATARIOS SELECCIONADOS</b>
              <span id="v588DigitalMailSelectedCount">0 seleccionados</span>
            </div>
            <div id="v588DigitalMailSelected">
              <div class="note">Aún no hay destinatarios seleccionados.</div>
            </div>
          </div>
        </div>
      </div>
      <div class="note v588-digital-mail-status" id="v588DigitalMailStatus"></div>
    </section>

    <div class="v488-digital-modal-actions">
      <button class="btn secondary" id="v488OpenLinkBtn" type="button" onclick="openDigitalCopyDraftLinkV488()">Abrir enlace</button>
      <button class="btn" id="v488DeliverBtn" type="button" onclick="deliverDigitalCopyV488()">Entregar y cerrar</button>
    </div>
    <div class="note" id="v488DigitalModalStatus" style="margin-top:10px"></div>
  </div>
</div>

<!-- Detalle y gestión de solicitud -->
<div class="modal" id="requestDetailModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box">
<p aria-live="polite" id="requestDetailLoading" role="status"></p>
<div class="modal-head">
<div>
<h2 id="rqDetailTitle">Solicitud</h2>
<div class="note" id="rqDetailMeta"></div>
</div>
<button class="btn secondary small" onclick="closeRequestDetail()">Cerrar</button>
</div>
<div class="req-summary">
<div class="mini">Estado<b id="rqDState">—</b></div>
<div class="mini">Expedientes<b id="rqDTotal">0</b></div>
<div class="mini">Cargo<b id="rqDCargo">—</b></div>
<div class="mini">Solicitante<b id="rqDSolicitante" style="font-size:12px">—</b></div>
<div class="mini" id="rqDOrigenBox">Origen<b id="rqDOrigen">—</b></div>
<div class="mini" id="rqDRegistradoPorBox">Registrado por<b id="rqDRegistradoPor" style="font-size:12px">—</b></div>
</div>
<section id="v788Entry" class="v788-regularize-entry" hidden aria-label="Regularización de expedientes acumulados">
  <div class="v788-regularize-copy"><strong>Regularización administrativa de acumulados</strong>
   <div class="note">Si el acumulado ya existe como expediente independiente y sus solicitudes fueron cerradas, evalúe su vínculo con un principal. <b>No elimina registros ni movimientos.</b></div>
  </div>
  <button class="btn secondary" type="button" id="v788OpenBtn" onclick="v788OpenRegularizationPicker()">↳ Regularizar acumulado existente</button>
 </section>
<div class="request-quick-intro">
<b>Gestión rápida desde el Registro Maestro.</b>
      Puede revisar los datos del expediente, informar su ubicación, guardar cambios,
      generar o vincular el cargo y consultar el historial del ciclo sin salir de esta solicitud.
      La pantalla de <b>Nueva solicitud</b> se mantiene para registrar y administrar el pedido completo.
    </div>


<section class="request-unified-section hidden" id="v669ModalitySection">
  <div class="request-unified-title">
    <div>
      <strong>Modalidad de atención de los expedientes seleccionados</strong>
      <div class="note" style="margin-top:3px">
        Archivo o Administrador puede cambiar la modalidad de <b>uno, varios o todos</b> los expedientes seleccionados,
        siempre que todavía no hayan iniciado o cerrado su atención. Los demás expedientes de la solicitud no se modifican.
      </div>
    </div>
  </div>
  <div class="v669-modality-summary">
    <div><span>Modalidad original</span><b id="v669OriginalMode">—</b></div>
    <div><span>Modalidades actuales</span><b id="v669CurrentMode">—</b></div>
    <div><span>Expedientes seleccionados</span><b id="v669LastChange">0 seleccionados</b></div>
  </div>
  <div class="request-unified-grid v669-modality-grid">
    <div class="field">
      <label>Nueva modalidad de atención *</label>
      <select id="v669NewMode" onchange="v669SyncChangeButton()">
        <option value="">— Seleccione modalidad —</option>
        <option value="PRÉSTAMO">PRÉSTAMO</option>
        <option value="COPIA DIGITAL">COPIA DIGITAL</option>
        <option value="LECTURA EN SALA">LECTURA EN SALA</option>
      </select>
    </div>
    <div class="field">
      <label>Motivo del cambio *</label>
      <select id="v669ReasonType" onchange="v669SyncReasonUI();v669SyncChangeButton()">
        <option value="">— Seleccione motivo —</option>
        <option value="FÍSICO NO DISPONIBLE / ATENDER CON COPIA DIGITAL">FÍSICO NO DISPONIBLE / ATENDER CON COPIA DIGITAL</option>
        <option value="DISPONIBILIDAD DE COPIA DIGITAL">DISPONIBILIDAD DE COPIA DIGITAL</option>
        <option value="ERROR EN MODALIDAD REGISTRADA">ERROR EN MODALIDAD REGISTRADA</option>
        <option value="COORDINADO CON EL SOLICITANTE">COORDINADO CON EL SOLICITANTE</option>
        <option value="OTRO">OTRO</option>
      </select>
    </div>
    <div class="field span2 hidden" id="v669ReasonDetailBox">
      <label>Detalle del motivo *</label>
      <input id="v669ReasonDetail" placeholder="Describa brevemente el sustento del cambio" oninput="v669SyncChangeButton()"/>
    </div>
  </div>
  <div class="v669-modality-foot">
    <div class="note" id="v669ModeRule">Seleccione en la tabla los expedientes a los que desea aplicar el cambio.</div>
    <button class="btn secondary" id="v669ChangeModeBtn" type="button" onclick="v669SubmitModeChange()" disabled>Aplicar a seleccionados</button>
  </div>
  <div class="note v669-modality-status" id="v669ModeStatus"></div>
</section>

<section class="request-unified-section hidden" id="rqMovementSection">
<div class="request-unified-title">
<div>
<strong>Gestión del expediente en custodia</strong>
<div class="note" style="margin-top:3px">
            Estas opciones se habilitan cuando el expediente ya está EN PRÉSTAMO,
            REASIGNADO o en proceso de devolución.
          </div>
</div>
</div>
<div class="request-unified-grid">
<div class="field">
<label>Nuevo responsable del expediente (reasignación)</label>
<select id="rqDNuevoResponsable" onchange="syncUserReturnButtonState()"></select>
<div class="note">Este campo corresponde a una reasignación posterior del expediente. <b>No define quién atiende la solicitud.</b></div>
</div>
<div class="field">
<label>Ubicación al devolver</label>
<select id="rqDRetorno"></select>
</div>
<div class="field v752-detail-subject-area">
  <label>Asunto de atención por reasignación (opcional)</label>
  <div id="v752DetailSubjectRows"><span class="note">Seleccione el expediente a reasignar. Si no elige otro asunto, se conserva el vigente.</span></div>
  <div class="note">No modifica el asunto de la solicitud original ni el del cargo.</div>
</div>
</div>
</section>


<section class="request-unified-section hidden" id="v488DigitalRequestPanel">
  <div class="request-unified-title">
    <div>
      <strong>Atención de copia digital</strong>
      <div class="note" style="margin-top:3px">Este servicio no genera préstamo, cargo, reasignación ni devolución. El enlace entregado queda asociado a la solicitud.</div>
    </div>
  </div>
  <div id="v488DigitalRequestDetail"><div class="empty">Cargando atención digital...</div></div>
</section>

<div class="req-actions" id="rqWorkflowActions" style="margin-bottom:12px"></div>
<div class="card table-wrap request-items-card">
<div class="table-head request-items-head">
<div>
<strong>Expedientes solicitados</strong>
<div class="note request-items-head-note">Seleccione uno o más expedientes. La atención y el cargo se gestionan directamente en este cuadro.</div>
</div>
<div class="v801-correction-head-actions">
  <span id="rqDSelectedCount">0 seleccionados</span>
  <button id="v801CorrectionSelectedBtn" class="btn secondary small" type="button"
    onclick="window.v801OpenSelectedNumberCorrection()" style="display:none"
    title="Solo Administrador. Corrige el número del expediente existente sin generar otra solicitud ni modificar el cargo.">
    ✎ Corregir número
  </button>
</div>
</div>
<div class="v613-attention-inside" id="v613AttentionInsideItems">
<section class="request-unified-section v613-attention-section hidden" id="rqAttentionSection">
<div class="request-unified-title">
<div>
<strong>Opciones de atención</strong>
<div class="note" style="margin-top:3px">
            Complete los datos de atención para los expedientes seleccionados y elija si generará un cargo nuevo o utilizará uno existente.
          </div>
</div>
</div>
<div class="request-unified-grid">
<div class="field">
<label>Atiende el requerimiento *</label>
<select id="rqDAtiende">
<option value="">— SOLO PERSONAL CON PERFIL ARCHIVO —</option>
</select>
</div>
<div class="field">
<label>Cargo existente</label>
<input id="rqDCargoExistente" placeholder="Ej.: 0126-2026"/>
<div class="note">
            Déjelo vacío si generará un cargo nuevo.
          </div>
</div>
</div>
</section>
<section class="request-unified-section v613-observation-section hidden" id="rqObservationSection">
<div class="field">
<label>Observación de la gestión</label>
<input id="rqDObservacion" maxlength="1500" placeholder="Observación opcional para la atención, reasignación o devolución. Quedará en el historial y será visible al siguiente responsable."/>
</div>
</section>
<div class="request-item-primary-actions hidden" id="rqItemPrimaryActions" aria-label="Acciones sobre expedientes seleccionados"></div>
</div>
<div id="rqDetailItems"></div>
<section aria-label="Ubicación verificada" class="request-location-section">
<div class="request-location-head">
<div>
<strong>Ubicación del expediente</strong>
<div class="note" style="margin-top:3px">
              Después de revisar la trazabilidad, comunique al solicitante la ubicación verificada.
              Este aviso no genera entrega, préstamo ni cierre del ciclo.
            </div>
</div>
<button class="btn secondary small hidden" id="locationInformBtn" onclick="openLocationNotice()" type="button">
            Informar ubicación
          </button>
</div>
<div aria-live="polite" id="locationDetailNotices" role="status"></div>
</section>
</div>
<section class="v626-reit-history hidden" id="v626ReiterationSection" aria-label="Seguimiento de reiteraciones">
  <div class="v626-reit-history-head">
    <div>
      <strong>Seguimiento de reiteraciones</strong>
      <div class="note">La reiteración mantiene el mismo número de solicitud y deja trazabilidad del seguimiento realizado por el usuario.</div>
    </div>
  </div>
  <div id="v626ReiterationHistory"><div class="empty">Sin reiteraciones.</div></div>
</section>
<div style="margin-top:14px">
<strong>Historial del ciclo</strong>
<div class="req-movements" id="rqMovements"><div class="empty">Sin movimientos.</div></div>
</div>
<div class="modal-foot">
<span class="note" id="rqActionStatus"></span>
<button class="btn secondary" onclick="closeRequestDetail()">Cerrar</button>
</div>
</div>
</div>
<!-- Gestión de expedientes acumulados -->
<!-- V788: Selector independiente del expediente PRINCIPAL sin desmarcar los 31 expedientes de la solicitud. -->
<div id="v788PrincipalPicker" role="dialog" aria-modal="true" aria-labelledby="v788PickerTitle" hidden>
 <div class="v788-picker-content">
  <div class="v788-picker-head"><h2 id="v788PickerTitle">Regularizar acumulado existente</h2><button class="btn secondary small" type="button" onclick="v788CloseRegularizationPicker()">Cerrar</button></div>
  <p>Primero seleccione el expediente <b>PRINCIPAL</b> al que quedará vinculado el acumulado. Esta elección es independiente de las casillas de la solicitud: <b>no modifica los 31 expedientes seleccionados</b>.</p>
  <label for="v788PrincipalSelect"><strong>Expediente principal y extensión</strong></label>
  <select id="v788PrincipalSelect" aria-label="Elegir expediente principal de esta solicitud"><option value="">— SELECCIONE EL PRINCIPAL —</option></select>
  <div class="note" id="v788PickerNote" role="status" aria-live="polite">Seleccione el principal y continúe.</div>
  <div class="v788-picker-actions"><button class="btn secondary" type="button" onclick="v788CloseRegularizationPicker()">Cancelar</button><button class="btn" type="button" onclick="v788ContinueRegularization()">Continuar con regularización</button></div>
 </div>
</div>
<div class="modal" id="acumuladosModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box">
<div class="modal-head">
<div>
<h2>Expedientes acumulados de la solicitud</h2>
<div class="note">Archivo puede vincular al expediente principal los expedientes acumulados identificados durante la verificación física.</div>
</div>
<button class="btn secondary small" onclick="closeAccumulatedModal()" type="button">Cerrar</button>
</div>
<div class="accum-principal-box">
<div class="note">Expediente físico principal</div>
<strong id="accumPrincipalLabel" style="font-size:17px;color:var(--navy)">—</strong>
<div id="accumPrincipalExtensionLabel" style="margin-top:3px;font-size:12px;font-weight:850;color:#315b98">
        Extensión: —
      </div>
<div class="note" style="margin-top:4px">
        Identificador físico: <b>N.° de expediente + extensión</b>.
      </div>
<div class="note" id="accumRequestLabel" style="margin-top:4px"></div>
</div>
<div class="note" style="margin-bottom:12px">
<b>Regla:</b> el expediente solicitado es el <b>PRINCIPAL</b>. Los acumulados quedan vinculados a ese principal y, cuando se registran desde esta pantalla, a la <b>misma solicitud</b>.
      No generan un préstamo, cargo, responsable ni devolución independientes.
      Estado, responsable, cargo, reasignaciones y devolución siguen perteneciendo al expediente principal.
      Si existen dos expedientes con el mismo número, <b>la extensión define cuál es el físico correcto</b>.
    </div>
<div class="accum-form-grid">
<div class="field">
<label>N.° de expediente acumulado *</label>
<input id="accumNumeroInput" onkeydown="if(event.key==='Enter'){event.preventDefault();saveAccumulatedExpediente()}" placeholder="Ej.: 0123-2016"/>
</div>
<div class="field">
<label>Extensión del acumulado</label>
<input id="accumExtensionInput" placeholder="Ej.: DINSECOVI"/>
<div class="note" style="margin-top:4px">
          La extensión distingue expedientes que tienen el mismo número.
        </div>
</div>
</div>
<div class="field" style="margin-top:10px">
<label>Observación de la verificación física</label>
<textarea id="accumObservationInput" placeholder="Ej.: Durante la revisión física se verificó que este expediente se encuentra acumulado al principal."></textarea>
</div>
<div class="modal-foot" style="margin-top:10px">
<span class="note" id="accumStatus"></span>
<button class="btn" id="accumAddBtn" onclick="saveAccumulatedExpediente()" type="button">+ Agregar acumulado</button>
</div>
<div style="margin-top:14px">
<strong>Acumulados registrados</strong>
<div class="accum-list" id="accumList">
<div class="empty">Sin acumulados registrados.</div>
</div>
</div>
<section id="v787Section" hidden aria-label="Regularización administrativa de expediente existente">
 <div class="v787-heading">Regularizar un expediente físico existente como acumulado</div>
 <p>Solo Administrador. Si el acumulado ya tiene un registro propio y sus solicitudes fueron cerradas administrativamente, puede evaluarse su vinculación. <b>El historial original no se elimina.</b></p>
 <div class="v787-row"><label>Buscar expediente físico acumulado
  <input id="v787Find" placeholder="Ej.: 0123-2016" autocomplete="off" /></label>
  <button type="button" id="v787SearchBtn" class="btn secondary small">Buscar expediente</button></div>
 <div class="v787-row"><label>Seleccione el número y la extensión correctos
  <select id="v787Select"><option value="">— BUSQUE UN EXPEDIENTE —</option></select></label>
  <button type="button" id="v787EvalBtn" class="btn secondary small">Evaluar regularización</button></div>
 <div id="v787Preview" aria-live="polite">Seleccione un expediente físico y pulse <b>Evaluar regularización</b>.</div>
 <div class="field"><label for="v787Reason">Motivo de la regularización (obligatorio; mínimo 15 caracteres)</label>
 <textarea id="v787Reason" maxlength="1000" rows="2" placeholder="Indique cómo se verificó que el expediente forma parte del principal y por qué se regulariza..."></textarea></div>
 <label class="v787-check"><input type="checkbox" id="v787Confirm" /> He revisado la custodia y los antecedentes y confirmo que este expediente físico está acumulado al principal.</label>
 <div class="v787-actions"><span class="note" id="v787Status" aria-live="polite"></span>
  <button type="button" id="v787Do" class="btn" disabled>Confirmar regularización</button></div>
 <p class="v787-warning">El cierre administrativo de una solicitud no se eliminará ni se revertirá. Si el expediente tiene préstamos, devoluciones, derivaciones o recepciones pendientes, la regularización será rechazada.</p>
</section>
</div>
</div>
<!-- Cierre administrativo de solicitud / expediente -->
<div class="modal" id="adminCloseModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box" style="max-width:720px">
<div class="modal-head">
<div>
<h2 id="adminCloseTitle">Cierre administrativo</h2>
<div class="note" id="adminCloseNote">El registro permanecerá en el historial.</div>
</div>
<button class="btn secondary small" onclick="closeAdminCloseModal()">Cerrar</button>
</div>
<div class="admin-close-summary" id="adminCloseSummary"></div>
<div class="admin-close-warning" style="margin-top:12px">
      El cierre administrativo <b>no devuelve ni cambia la custodia física</b>. Solo puede aplicarse antes de que el expediente haya sido entregado, prestado o se encuentre en proceso de devolución.
    </div>
<div class="form-grid" style="margin-top:14px">
<div class="field">
<label>Motivo del cierre *</label>
<select id="adminCloseReasonType">
<option value="">— Seleccione motivo —</option>
<option value="SOLICITUD DUPLICADA">SOLICITUD DUPLICADA</option>
<option value="YA NO REQUERIDO">YA NO REQUERIDO</option>
<option value="ERROR DE REGISTRO">ERROR DE REGISTRO</option>
<option value="ATENDIDO POR OTRA VÍA">ATENDIDO POR OTRA VÍA</option>
<option value="OTRO">OTRO</option>
</select>
</div>
<div class="field">
<label>Detalle / sustento</label>
<textarea id="adminCloseReasonDetail" placeholder="Detalle adicional, si corresponde"></textarea>
</div>
</div>
<div class="modal-foot">
<span class="note" id="adminCloseStatus"></span>
<button class="btn secondary" onclick="closeAdminCloseModal()">Cerrar</button>
<button class="btn" id="adminCloseSubmitBtn" onclick="submitAdminClose()">Cerrar administrativamente</button>
</div>
</div>
</div>
<!-- V235 · Eliminación segura de solicitud por ADMINISTRADOR -->
<div class="modal" id="adminDeleteRequestModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box" style="max-width:720px">
<div class="modal-head">
<div>
<h2>Eliminar solicitud</h2>
<div class="note">
          Opción exclusiva del perfil ADMINISTRADOR.
        </div>
</div>
<button class="btn secondary small" onclick="closeAdminDeleteRequestV235()">Cerrar</button>
</div>
<div class="v235-delete-summary" id="adminDeleteRequestSummaryV235"></div>
<div class="v235-delete-warning">
<b>Acción irreversible en las bandejas operativas.</b><br/>
      Solo se permite eliminar solicitudes que todavía no tengan cargo,
      entrega, préstamo, devolución ni movimientos registrados.
      Si la solicitud ya avanzó en el flujo, utilice
      <b>Cerrar solicitud completa</b> para conservar su trazabilidad.
    </div>
<div class="form-grid" style="margin-top:14px">
<div class="field">
<label>Motivo de eliminación *</label>
<select id="adminDeleteReasonTypeV235">
<option value="">— Seleccione motivo —</option>
<option value="SOLICITUD DUPLICADA">SOLICITUD DUPLICADA</option>
<option value="ERROR DE REGISTRO">ERROR DE REGISTRO</option>
<option value="REGISTRO DE PRUEBA">REGISTRO DE PRUEBA</option>
<option value="CREADA POR EQUIVOCACIÓN">CREADA POR EQUIVOCACIÓN</option>
<option value="OTRO">OTRO</option>
</select>
</div>
<div class="field">
<label>Detalle / sustento</label>
<textarea id="adminDeleteReasonDetailV235" placeholder="Detalle adicional, si corresponde"></textarea>
</div>
<div class="field span2">
<label>Confirmación *</label>
<input autocomplete="off" class="v235-delete-confirm" id="adminDeleteConfirmV235" placeholder="Escriba el número exacto de la solicitud"/>
<div class="v235-delete-audit-note">
          Para evitar eliminaciones accidentales, escriba exactamente el número
          de la solicitud que se muestra arriba.
        </div>
</div>
</div>
<div class="v235-delete-audit-note">
      Antes de eliminar, Supabase guardará una copia de auditoría del encabezado,
      expedientes vinculados, motivo, usuario administrador y fecha/hora.
    </div>
<div class="modal-foot">
<span class="note" id="adminDeleteStatusV235"></span>
<button class="btn secondary" onclick="closeAdminDeleteRequestV235()">Cerrar</button>
<button class="btn admin-delete-btn" id="adminDeleteSubmitV235" onclick="submitAdminDeleteRequestV235()">
        Eliminar solicitud
      </button>
</div>
</div>
</div>
<!-- Usuarios y permisos -->
<div class="modal" id="usersModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box">
<div class="modal-head">
<div>
<h2>Usuarios y permisos</h2>
<div class="note">Solo el ADMINISTRADOR puede cambiar roles. Cada cuenta debe existir previamente en Supabase Authentication.</div>
</div>
<button class="btn secondary small" onclick="closeUsersModal()">Cerrar</button>
</div>
<div class="permission-note">
<b>USUARIO / ABOGADO:</b> solo ve sus solicitudes y movimientos.
      <b>ARCHIVO:</b> acceso operativo a expedientes, solicitudes, cargos y devoluciones.
      <b>COORDINADOR:</b> conserva su espacio personal y puede consultar únicamente al equipo asignado en Supabase. No atiende solicitudes ni edita expedientes del equipo.
      <b>ADMINISTRADOR:</b> acceso total + administración de permisos.
    </div>
<div style="margin:10px 0;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
  <button type="button" class="btn secondary" onclick="v734OpenLinkManager()">✉ Vincular y administrar correos</button>
  <span class="note">El correo para iniciar sesión y el correo de notificaciones son independientes.</span>
</div>
<div class="note" id="usersStatus" style="margin-top:8px"></div>
<div class="user-perm-table">
<table>
<thead>
<tr><th>Correo</th><th>Personal asociado</th><th>Rol</th><th>Activo</th><th></th></tr>
</thead>
<tbody id="usersBody"></tbody>
</table>
</div>
<section id="v839AdminSection" class="v839-admin" hidden>
  <h3>Permisos de derivación por usuario</h3>
  <p class="note">Configure cada destino por separado. El cambio se registra con fecha, responsable, estado anterior y estado nuevo. Los administradores conservan sus facultades institucionales.</p>
  <div class="v839-filters">
    <label>Buscar trabajador <input type="search" id="v839AdminSearch" placeholder="Nombre, correo o rol" oninput="v839AdminFilter()"></label>
    <button class="btn secondary small" type="button" onclick="v839AdminReload()">Actualizar permisos</button>
    <button class="btn secondary small" type="button" onclick="v839ToggleHistory()">Ver historial de cambios</button>
  </div>
  <div class="note" id="v839AdminStatus" aria-live="polite">Cargando permisos...</div>
  <div class="v839-table-scroll">
   <table class="v839-table"><thead><tr><th>Trabajador</th><th>Rol</th><th>CONAS</th><th>DVC</th><th>Instrucción</th><th>Motivo (opcional)</th><th>Acción</th></tr></thead>
   <tbody id="v839AdminBody"></tbody></table>
  </div>
  <div id="v839History" hidden>
    <h4>Historial de cambios de permisos</h4>
    <div class="v839-table-scroll"><table class="v839-table"><thead><tr><th>Fecha</th><th>Usuario</th><th>Destino</th><th>Antes</th><th>Después</th><th>Modificado por</th><th>Motivo</th></tr></thead><tbody id="v839HistoryBody"></tbody></table></div>
  </div>
</section>
</div>
</div>
