<section class="v595-conas-mail-panel" id="v595ConasMailPanel">
  <div class="v595-conas-mail-head">
    <strong>✉ Comunicación por correo</strong>
    <label class="v595-mail-toggle">
      <input id="v595ConasMailEnabled" type="checkbox" checked>
      <span>Enviar correo</span>
    </label>
  </div>

  <div class="v595-conas-mail-note">
    <b>PARA:</b> Coordinador de Archivo ·
    <b>CC:</b> Armando + Jaime + quien deriva + destinatarios adicionales.
