<!-- Administración de personal, áreas y ubicaciones -->
<div class="modal" id="peopleModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box">
<div class="modal-head">
<div>
<h2>Administrar personal</h2>
<div style="font-size:12px;color:#64748b;margin-top:3px">Administra el personal y su área desde el sistema. Selecciona otra área y pulsa «Guardar área» en la fila correspondiente.</div>
</div>
<button class="btn secondary small" onclick="closePeopleModal()">Cerrar</button>
</div>
<div class="people-grid">
<div class="field"><label>Nombre *</label><input id="pNombre" placeholder="Ej.: CARLOS PÉREZ"/></div>
<div class="field"><label>Tipo *</label><select id="pTipo" onchange="syncPeopleAreaField()"><option>PERSONAL</option><option>ÁREA / UBICACIÓN</option><option>ETAPA / UBICACIÓN</option><option>UBICACIÓN</option></select></div>
<div class="field" id="pAreaField"><label>Área de trabajo</label><select id="pArea"><option value="">— SIN ASIGNAR —</option></select></div>
<div class="field"><label>Estado</label><select id="pActivo"><option value="true">ACTIVO</option><option value="false">INACTIVO</option></select></div>
<button class="btn" onclick="savePerson()">+ Agregar personal</button>
</div>
<div id="peopleStatus" style="font-size:12px;color:#64748b;margin-top:9px"></div>
<div class="people-table"><table><thead><tr><th>Nombre</th><th>Tipo</th><th>Área de trabajo</th><th>Estado</th><th></th></tr></thead><tbody id="peopleBody"></tbody></table></div>
</div>
</div>
<!-- Configuración -->
<div class="modal" id="configModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box auth-box">
<div class="auth-logo">Conectar base de datos</div>
<div class="note" style="margin:10px 0">Ingresa la URL del proyecto Supabase y la <b>Publishable key</b>. No uses una Secret key.</div>
<div class="field"><label>Supabase URL</label><input id="cfgUrl" placeholder="https://xxxx.supabase.co"/></div>
<div class="field" style="margin-top:10px"><label>Publishable key</label><textarea id="cfgKey" placeholder="sb_publishable_..." rows="4"></textarea></div>
<div class="config-help">La configuración se guarda únicamente en este navegador. Los datos de expedientes permanecen en PostgreSQL.</div>
<div class="modal-foot"><button class="btn" onclick="saveConfig()">Guardar y conectar</button></div>
</div>
</div>
<!-- Inicio de sesión -->
<div class="modal" id="loginModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box auth-box">
<div class="auth-logo">Iniciar sesión</div>
<div class="note" style="margin:10px 0">Solo usuarios creados/autorizados en Supabase Auth pueden acceder a los expedientes.</div>
<form onsubmit="login(event)">
<div class="field"><label>Correo</label><input id="loginEmail" required="" type="email"/></div>
<div class="field" style="margin-top:10px"><label>Contraseña</label><input id="loginPassword" required="" type="password"/></div>
<div id="loginStatus" style="font-size:12px;color:#a61b1b;margin-top:8px"></div>
<div class="modal-foot"><button class="btn" type="submit">Ingresar</button></div>
</form>
</div>
</div>
<!-- Incorporación directa al Registro Maestro -->
<div class="modal" id="custodyIncorporateModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box" style="max-width:1020px">
<div class="modal-head">
<div>
<h2>➕ Incorporar expedientes al Registro Maestro</h2>
<div class="note">
          Registra expedientes existentes directamente en <b>CUSTODIA</b>.
          Esta operación <b>no genera solicitud, cargo ni préstamo</b>.
        </div>
</div>
<button class="btn secondary small" onclick="closeCustodyIncorporateModal()" type="button">Cerrar</button>
</div>
<div class="custody-mode">
<button class="mode-btn active" id="custodyModeSingleBtn" onclick="setCustodyIncorporateMode('single')" type="button">
        Un expediente
      </button>
<button class="mode-btn" id="custodyModeCsvBtn" onclick="setCustodyIncorporateMode('csv')" type="button">
        Carga masiva CSV
      </button>
</div>
<div class="custody-rule">
<b>Ubicación inicial:</b>
      para expedientes 1995–2016 el sistema propone <b>SAN LUIS</b>;
      para los demás propone <b>BARRENECHEA</b>.
      Puede cambiar la sede antes de incorporar cuando corresponda.
    </div>
<div class="custody-import-box" id="custodySingleBox" style="margin-top:10px">
<div class="form-grid">
<div class="field">
<label>Expediente *</label>
<input id="custodyExpediente" oninput="suggestCustodySedeFromExpediente()" placeholder="Ej.: 0004-2015"/>
</div>
<div class="field">
<label>Extensión (opcional)</label>
<input id="custodyExtension" placeholder="Ej.: 01 o A"/>
</div>
<div class="field">
<label>R.D.</label>
<input id="custodyRd"/>
</div>
<div class="field">
<label>Serie / tipo</label>
<select id="custodySerie">
<option>PAS</option>
<option>RESOLUCIÓN DIRECTORAL</option>
<option>OTRO</option>
</select>
</div>
<div class="field">
<label>Último folio</label>
<input id="custodyFolio"/>
</div>
<div class="field">
<label>Sede física *</label>
<select id="custodySede">
<option value="BARRENECHEA">BARRENECHEA</option>
<option value="SAN LUIS">SAN LUIS</option>
</select>
</div>
<div class="field">
<label>Estado inicial</label>
<input readonly="" value="CUSTODIA"/>
</div>
<div class="field">
<label>Digitalizado</label>
<select id="custodyDigitalizado">
<option>NO</option>
<option>SÍ</option>
<option>PARCIAL</option>
</select>
</div>
<div class="field span2">
<label>Expediente acumulado / vinculado</label>
<input id="custodyAcumulado"/>
</div>
<div class="field span4">
<label>Observación</label>
<textarea id="custodyObservacion" placeholder="Opcional"></textarea>
</div>
</div>
<div class="modal-foot" style="padding-bottom:0">
<span id="custodySingleStatus" style="margin-right:auto;font-size:11px;color:#64748b"></span>
<button class="btn" id="custodySingleSaveBtn" onclick="saveSingleCustodyExpediente()" type="button">
          Incorporar en custodia
        </button>
</div>
</div>
<div class="custody-import-box hidden" id="custodyCsvBox" style="margin-top:10px">
<div style="display:flex;gap:7px;align-items:center;flex-wrap:wrap">
<button class="btn secondary" onclick="downloadCustodyCSVTemplate()" type="button">
          Descargar plantilla CSV
        </button>
<button class="btn secondary" onclick="el('custodyCsvFile').click()" type="button">
          Seleccionar CSV
        </button>
<span class="note" id="custodyCsvFileName">Ningún archivo seleccionado.</span>
</div>
<div class="note" style="margin-top:8px">
        Columnas admitidas:
        <b>EXPEDIENTE, EXTENSIÓN, R.D., SERIE / TIPO, ÚLTIMO FOLIO,
        SEDE, DIGITALIZADO, EXPEDIENTE ACUMULADO / VINCULADO, OBSERVACIÓN</b>.
      </div>
<div class="custody-summary">
<div class="mini">
<span>Registros</span>
<b id="custodyCsvTotal">0</b>
</div>
<div class="mini">
<span>Nuevos</span>
<b id="custodyCsvNew">0</b>
</div>
<div class="mini">
<span>Ya existen</span>
<b id="custodyCsvExisting">0</b>
</div>
<div class="mini">
<span>Errores</span>
<b id="custodyCsvErrors">0</b>
</div>
</div>
<div class="custody-preview" id="custodyCsvPreview">
<div class="empty">Seleccione un CSV para revisar los expedientes antes de incorporarlos.</div>
</div>
<div class="modal-foot" style="padding-bottom:0">
<span id="custodyCsvStatus" style="margin-right:auto;font-size:11px;color:#64748b"></span>
<button class="btn" disabled="" id="custodyCsvImportBtn" onclick="importCustodyCsvRows()" type="button">
          Incorporar expedientes nuevos
        </button>
</div>
</div>
</div>
</div>
<!-- Formulario -->
<div class="modal" id="recordModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box">
<div class="modal-head"><h2 id="modalTitle">Agregar expediente no registrado</h2><button class="btn secondary small" onclick="closeRecordModal()">Cerrar</button></div>
<div class="record-mode" id="recordModeBar">
<button class="mode-btn active" id="modeSingleBtn" onclick="setRecordMode('single')" type="button">Un expediente</button>
<button class="mode-btn" id="modeBatchBtn" onclick="setRecordMode('batch')" type="button">Varios del mismo cargo</button>
</div>
<div class="note" id="recordModeNote" style="margin:-6px 0 12px">
      Tanto un expediente como varios expedientes generan automáticamente el siguiente Cargo N.° correlativo.
    </div>
<div class="record-entry-v321" id="recordEntryV321">
<div>
<strong>Tipo de ingreso</strong>
<small>Disponible únicamente para ARCHIVO y ADMINISTRADOR. Antes de guardar, el sistema verifica que el expediente no exista.</small>
</div>
<div class="record-entry-actions-v321">
<button class="btn secondary small" onclick="applyReturnConasPresetV321()" type="button">↩ Retorno CONAS</button>
<button class="btn secondary small" onclick="clearRecordEntryPresetV321()" type="button">Otro asunto</button>
</div>
</div>
<form id="recordForm" onsubmit="saveRecord(event)">
<input id="fId" type="hidden"/>
<div class="form-grid" id="singleRecordFields">
<div class="field"><label>Expediente *</label><input id="fExpediente" placeholder="Ej.: 0012-2025" required=""/></div>
<div class="field"><label>Extensión (opcional)</label><input id="fExtension" placeholder="Ej.: 01 o A"/></div>
<div class="field"><label>R.D.</label><input id="fRd"/></div>
<div class="field"><label>Serie / tipo</label><select id="fSerie"><option>PAS</option><option>RESOLUCIÓN DIRECTORAL</option><option>OTRO</option></select></div>
<div class="field"><label>Estado actual</label><select id="fEstado"></select></div>
<div class="field span2"><label>Responsable / ubicación actual *</label><select id="fResponsable" required=""></select></div>
<div class="field"><label>Modalidad</label><select id="fModalidad"><option>FÍSICO</option><option>COPIA DIGITAL</option></select></div>
<div class="field"><label>Fecha solicitud</label><input id="fSolicitud" type="date"/></div>
<div class="field"><label>Fecha entrega</label><input id="fEntrega" type="date"/></div>
<div class="field"><label>Fecha devolución</label><input id="fDevolucion" type="date"/></div>
<div class="field"><label>Última reasignación</label><input id="fReasignacion" type="date"/></div>
<div class="field"><label>Último folio</label><input id="fFolio"/></div>
<div class="field"><label>Digitalizado</label><select id="fDigitalizado"><option>NO</option><option>SÍ</option><option>PARCIAL</option></select></div>
<div class="field span2"><label>Enlace digital</label><input id="fEnlace" placeholder="https://..."/></div>
<div class="field">
<label>Cargo N°</label>
<input id="fCargo" readonly="" title="Al guardar un expediente nuevo se asignará el siguiente correlativo, por ejemplo 0153-2026" value="AUTOMÁTICO"/>
</div>
<div class="field span2">
<label>Asunto del cargo *</label>
<input id="fAsunto" placeholder="Seleccione o escriba el asunto"/>
</div>
<div class="field span2">
<label>Atiende el requerimiento *</label>
<select id="fAtiende">
<option value="">— SOLO PERSONAL CON PERFIL ARCHIVO —</option>
</select>
</div>
<div class="field span2"><label>Expediente acumulado / vinculado</label><input id="fAcumulado"/></div>
<div class="field span4"><label>Observación</label><textarea id="fObservacion"></textarea></div>
</div>
<div class="hidden" id="batchRecordFields">
<div class="form-grid">
<div class="field">
<label>Cargo N°</label>
<input id="bCargo" readonly="" title="Se asignará automáticamente con formato 0001-AÑO, por ejemplo 0152-2026" value="AUTOMÁTICO"/>
</div>
<div class="field span2">
<label>Responsable / ubicación actual *</label>
<select id="bResponsable"></select>
</div>
<div class="field">
<label>Serie / tipo</label>
<select id="bSerie"><option>PAS</option><option>RESOLUCIÓN DIRECTORAL</option><option>OTRO</option></select>
</div>
<div class="field">
<label>Estado actual</label>
<select id="bEstado"></select>
</div>
<div class="field">
<label>Modalidad</label>
<select id="bModalidad"><option>FÍSICO</option><option>COPIA DIGITAL</option></select>
</div>
<div class="field">
<label>Fecha solicitud</label>
<input id="bSolicitud" type="date"/>
</div>
<div class="field">
<label>Fecha entrega</label>
<input id="bEntrega" type="date"/>
</div>
<div class="field span4">
<label>Asunto del cargo *</label>
<input id="bAsunto" placeholder="Seleccione o escriba el asunto"/>
</div>
<div class="field span2">
<label>Atiende el requerimiento *</label>
<select id="bAtiende">
<option value="">— SOLO PERSONAL CON PERFIL ARCHIVO —</option>
</select>
</div>
<div class="field span4">
<label>Observación general</label>
<textarea id="bObservacion" placeholder="Esta observación se aplicará a todos los expedientes, si corresponde"></textarea>
</div>
</div>
<div class="batch-cargo-info" id="batchCargoInfo">
          El número de cargo se generará automáticamente. Todos los expedientes registrados aquí quedarán vinculados al mismo cargo.
        </div>
<div class="batch-box">
<div class="batch-head">
<div>Expediente *</div><div>Extensión</div><div>R.D.</div><div>Último folio</div><div>Observación individual</div><div></div>
</div>
<div id="batchRows"></div>
<button class="btn secondary small" onclick="addBatchRow()" type="button">+ Agregar expediente</button>
<div class="batch-summary" id="batchSummary">0 expedientes preparados</div>
</div>
</div>
<div class="modal-foot"><span id="saveStatus" style="margin-right:auto;font-size:12px;color:#64748b"></span><button class="btn secondary" onclick="closeRecordModal()" type="button">Cerrar</button><button class="btn" id="recordSaveBtn" type="submit">Guardar expediente</button></div>
</form>
</div>
</div>
<!-- Generación e impresión de cargo -->
<div class="modal" id="cargoModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box">
<div class="modal-head">
<div>
<h2>Generar cargo de préstamo</h2>
<div style="font-size:12px;color:#64748b;margin-top:3px">El asunto y quien atiende se cargan automáticamente desde la solicitud aceptada. Al generar e imprimir el cargo, el expediente queda EN PRÉSTAMO.</div>
</div>
<button class="btn secondary small" onclick="closeCargoModal()">Cerrar</button>
</div>
<div class="form-grid">
<div class="field"><label>Cargo N°</label><input id="cNumero" readonly="" title="Supabase asigna automáticamente el formato 0001-AÑO, por ejemplo 0152-2026" value="AUTOMÁTICO"/></div>
<div class="field span2">
<label>Solicitante / Responsable de destino *</label>
<input id="cSolicitante" placeholder="Nombre de quien recibe los expedientes" title="Se carga desde la solicitud y puede corregirse antes de imprimir"/>
</div>
<div class="field"><label>Fecha</label><input id="cFecha" type="date"/></div>
<div class="field span4"><label>Asunto *</label><input id="cAsunto" placeholder="Seleccione o escriba el asunto"/></div>
<div class="field span2">
<label>Atiende el requerimiento *</label>
<select id="cAtiende">
<option value="">— SOLO PERSONAL CON PERFIL ARCHIVO —</option>
</select>
</div>
<div class="field span4"><label>Observación general</label><textarea id="cObservacion" placeholder="Observación del cargo, de corresponder"></textarea></div>
</div>
<div class="cargo-preview-note">Al generar el cargo, el número se registrará también en los expedientes seleccionados y quedará reflejado en su historial.</div>
<div class="cargo-list" id="cargoSelectedList"></div>
<div class="modal-foot">
<span id="cargoStatus" style="margin-right:auto;font-size:12px;color:#64748b"></span>
<button class="btn secondary" onclick="closeCargoModal()">Cerrar</button>
<button class="btn" id="cargoPrintBtn" onclick="saveAndPrintCargo()">Guardar e imprimir</button>
</div>
</div>
</div>
<!-- V651 · Elección de cargo oficial o prueba controlada -->
<div class="modal" id="v651CargoTypeModal" onclick="closeModalFromBackdrop(event,this)">
  <div class="modal-box" style="max-width:720px">
    <div class="modal-head">
      <div>
        <h2>Tipo de cargo para esta atención</h2>
      </div>
      <button class="btn secondary small" onclick="closeCargoTypeV651()" type="button">Cerrar</button>
    </div>
    <div class="v651-cargo-type-grid">
      <button class="v651-cargo-type-card" type="button" onclick="assignNewCargoToAccepted('OFICIAL')">
        <span class="v651-cargo-type-tag">CARGO OFICIAL</span>
        <strong id="v651OfficialNext">—</strong>
        <small>Usa y avanza el correlativo físico oficial. Debe elegirse cuando la atención corresponde al cargo real que será emitido por Archivo.</small>
      </button>
      <button class="v651-cargo-type-card v651-test" type="button" onclick="assignNewCargoToAccepted('PRUEBA')">
        <span class="v651-cargo-type-tag">PRUEBA CONTROLADA</span>
        <strong id="v651TestNext">—</strong>
        <small>Permite probar la atención e impresión sin consumir el correlativo físico oficial. El resto del flujo se mantiene igual.</small>
      </button>
    </div>
    <div class="v651-cargo-choice-note" id="v651CargoTypeStatus">
      El correlativo oficial se asigna únicamente cuando se confirma la opción CARGO OFICIAL.
    </div>
    <div class="modal-foot">
      <button class="btn secondary" onclick="closeCargoTypeV651()" type="button">Cancelar</button>
    </div>
  </div>
</div>
<!-- V739 · Detalle de expedientes del cargo, solo lectura, sin salir de Cargos -->
<div class="modal" id="v739CargoExpedientesModal" role="dialog" aria-modal="true" aria-labelledby="v739CargoExpedientesTitle" onclick="closeModalFromBackdrop(event,this)">
  <div class="modal-box v739-cargo-modal-box">
    <div class="modal-head v739-cargo-head">
      <div><h2 id="v739CargoExpedientesTitle">Expedientes del cargo</h2>
      <p id="v739CargoExpedientesInfo" class="v739-cargo-subtitle">Consultando...</p></div>
      <button type="button" class="btn secondary small" onclick="v739CerrarExpedientesCargo()">Cerrar</button>
    </div>
    <div id="v739CargoExpedientesBody" aria-live="polite"></div>
    <div class="modal-foot"><button type="button" class="btn secondary" onclick="v739CerrarExpedientesCargo()">Cerrar ventana</button></div>
  </div>
</div>
<!-- V650 · Edición controlada del número de cargo · Solo ADMINISTRADOR -->
<div class="modal" id="cargoNumberEditModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box" style="max-width:620px">
<div class="modal-head">
<div>
<h2>Editar número de cargo</h2>
</div>
<button class="btn secondary small" onclick="closeCargoNumberEditModal()" type="button">Cerrar</button>
</div>
<input id="cargoEditId" type="hidden"/>
<div class="form-grid" style="grid-template-columns:1fr 1fr">
<div class="field">
<label>Número actual</label>
<input id="cargoEditOld" readonly/>
</div>
<div class="field">
<label>Nuevo número *</label>
<input id="cargoEditNew" maxlength="9" placeholder="Ej.: 0301-2026" autocomplete="off"/>
</div>
<div class="field" style="grid-column:1/-1">
<label>Motivo de la corrección</label>
<textarea id="cargoEditReason" rows="3" placeholder="Ej.: Corrección de correlativo digitado por error"></textarea>
</div>
</div>
<div class="modal-foot">
<span id="cargoEditStatus" style="margin-right:auto;font-size:12px;color:#64748b"></span>
<button class="btn secondary" onclick="closeCargoNumberEditModal()" type="button">Cancelar</button>
<button class="btn" id="cargoEditSaveBtn" onclick="saveCargoNumberEdit()" type="button">Guardar corrección</button>
</div>
</div>
</div>
<!-- Centro de alertas -->

<div class="modal" id="cargoCorrelativeModal" onclick="closeModalFromBackdrop(event,this)">
  <div class="modal-card" style="max-width:520px">
    <div class="modal-head">
      <div><h3 style="margin:0">Correlativo físico de cargos</h3></div>
      <button class="icon-btn" onclick="closeCargoCorrelativeModal()" type="button">✕</button>
    </div>
    <div class="form-grid" style="grid-template-columns:1fr 1fr;gap:10px">
      <div class="field"><label>Año</label><input id="cargoCorrYear" inputmode="numeric" maxlength="4"/></div>
      <div class="field"><label>Último cargo físico</label><input id="cargoCorrLast" inputmode="numeric" maxlength="4" placeholder="1686"/></div>
      <div class="field" style="grid-column:1/-1"><label>Observación</label><input id="cargoCorrNote" placeholder="Ej.: Último cargo físico verificado"/></div>
    </div>
    <div class="note" id="cargoCorrPreview" style="margin-top:8px"></div>
    <div id="cargoCorrStatus" style="min-height:20px;margin-top:8px"></div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:12px">
      <button class="btn secondary" onclick="closeCargoCorrelativeModal()" type="button">Cancelar</button>
      <button class="btn" id="cargoCorrSaveBtn" onclick="saveCargoCorrelative()" type="button">Guardar correlativo</button>
    </div>
  </div>
</div>
<div class="modal" id="alertsModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box alerts-modal-box">
<div class="modal-head alerts-modal-head">
<div>
<h2>🔔 Centro de alertas</h2>
<div class="alerts-modal-subtitle">
          Las alertas están separadas por tipo para facilitar su atención.
        </div>
</div>
<button class="btn secondary small" onclick="closeAlertsModal()">Cerrar</button>
</div>
<div class="alerts-total-card">
<div>
<span class="alerts-total-label">ALERTAS ACTIVAS</span>
<strong id="alertsUnreadText">0</strong>
</div>
<div class="alerts-total-help">
        Total de avisos operativos que requieren revisión o seguimiento.
      </div>
</div>
<section aria-live="polite" class="v364-alert-center" id="v361AlertsCenter">
<div class="v364-summary">
<button class="v364-summary-card is-new" onclick="setV364AlertFilter('new')" type="button">
<span class="v364-summary-icon">📥</span>
<span class="v364-summary-text">NUEVAS SOLICITUDES</span>
<strong id="v364NewCount">0</strong>
</button>
<button class="v364-summary-card is-action" onclick="setV364AlertFilter('tasks')" type="button">
<span class="v364-summary-icon">✓</span>
<span class="v364-summary-text">OTRAS TAREAS</span>
<strong id="v364TaskCount">0</strong>
</button>
<button class="v364-summary-card is-notice" onclick="setV364AlertFilter('notices')" type="button">
<span class="v364-summary-icon">🔔</span>
<span class="v364-summary-text">AVISOS SIN LEER</span>
<strong id="v364NoticeCount">0</strong>
</button>
</div>
<div class="v364-toolbar">
<div aria-label="Filtros del Centro de alertas" class="v364-tabs" role="group">
<button class="btn secondary small active" data-v364-filter="all" onclick="setV364AlertFilter('all')" type="button">Pendientes</button>
<button class="btn secondary small" data-v364-filter="new" onclick="setV364AlertFilter('new')" type="button">Nuevas solicitudes</button>
<button class="btn secondary small" data-v364-filter="tasks" onclick="setV364AlertFilter('tasks')" type="button">Otras tareas</button>
<button class="btn secondary small" data-v364-filter="notices" onclick="setV364AlertFilter('notices')" type="button">Avisos</button>
<button class="btn secondary small" data-v364-filter="read" onclick="setV364AlertFilter('read')" type="button">Leídas</button>
</div>
<button class="btn secondary small" id="v364RefreshBtn" onclick="refreshV364Alerts(true)" type="button">Actualizar</button>
</div>
<div class="v364-status" id="v364Status">Cargando alertas…</div>
<section class="v364-section is-new" id="v364NewSection">
<div class="v364-section-head">
<div>
<strong>Nuevas solicitudes</strong>
<small>Pedidos nuevos todavía no revisados por este usuario.</small>
</div>
<span class="v364-count" id="v364NewSectionCount">0</span>
</div>
<div class="v364-list" id="v364NewList"></div>
</section>
<section class="v364-section" id="v364TaskSection">
<div class="v364-section-head">
<div>
<strong>Otras tareas pendientes</strong>
<small>Devoluciones, reasignaciones, recepción y control de préstamos.</small>
</div>
<div class="v364-head-actions">
<button class="btn secondary small hidden" id="v364ToggleTasksBtn" onclick="toggleV364AllTasks()" type="button">Ver todas</button>
<span class="v364-count" id="v364TaskSectionCount">0</span>
</div>
</div>
<div class="v364-list" id="v364TaskList"></div>
</section>
<section class="v364-section is-notice" id="v364NoticeSection">
<div class="v364-section-head">
<div>
<strong>Avisos</strong>
<small>Información para conocimiento, como ubicación verificada.</small>
</div>
<span class="v364-count" id="v364NoticeSectionCount">0</span>
</div>
<div class="v364-list" id="v364NoticeList"></div>
</section>
<div class="v364-empty hidden" id="v364Empty">
        No hay alertas para el filtro seleccionado.
      </div>
</section>
<section class="hidden" id="v170TaskCenter">
<div class="v170-task-head">
<div>
<strong>✓ Tareas operativas unificadas</strong>
<small>Una sola bandeja para atención, devolución, recepción, reasignación y alertas de custodia.</small>
</div>
<div class="v170-task-summary">
<span class="v170-task-count" id="v170TaskCount">0</span>
<button class="btn secondary small" onclick="loadV170Tasks(false,true)" type="button">Actualizar</button>
</div>
</div>
<div id="v170TaskList"><div class="empty">Consultando tareas V170...</div></div>
</section>
<!-- GRUPO 1: CONTROL DE PRÉSTAMOS -->
<section class="alerts-group alerts-group-loans">
<div class="alerts-group-title">
<div>
<span class="alerts-group-number">1</span>
<strong>CONTROL DE PRÉSTAMOS</strong>
</div>
<span class="alerts-group-hint">Seguimiento por tiempo sin movimiento</span>
</div>
<div class="alerts-type-card">
<div class="alerts-type-head">
<div>
<strong>⏱ Préstamos &gt; 30 días sin movimiento</strong>
<div class="alerts-type-description">
              Se calcula desde el último movimiento registrado; si no existe, desde la fecha de entrega.
            </div>
</div>
<span class="pill alert"><span id="operationalAlertsCount">0</span> alertas</span>
</div>
<div class="alert-format-toolbar">
<strong><span id="operationalAlertsToolbarCount">0</span> alerta(s) activa(s)</strong>
<button class="btn secondary small" onclick="loadOperationalAlerts(false)" type="button">Actualizar</button>
</div>
<div class="notification-list alerts-type-list" id="operationalAlertsList">
<div class="empty">Cargando alertas operativas...</div>
</div>
</div>
</section>
<!-- GRUPO 2: ENTREGA Y DEVOLUCIONES -->
<section class="alerts-group alerts-group-returns">
<div class="alerts-group-title">
<div>
<span class="alerts-group-number">2</span>
<strong>ENTREGA Y DEVOLUCIONES A ARCHIVO</strong>
</div>
<span class="alerts-group-hint">Recepción física y solicitudes pendientes</span>
</div>
<div class="alerts-type-card">
<div class="alerts-type-head">
<div>
<strong>📁 Solicitudes de entrega a Archivo</strong>
<div class="alerts-type-description">
              Archivo puede requerir un expediente que permanece bajo custodia de un usuario. La custodia cambia recién al confirmar la recepción.
            </div>
</div>
<span class="pill alert"><span id="archiveDeliveryAlertsCount">0</span> pendientes</span>
</div>
<div class="alert-format-toolbar">
<strong><span id="archiveDeliveryToolbarCount">0</span> solicitud(es) pendiente(s)</strong>
<button class="btn secondary small" onclick="loadArchiveDeliveryRequests(false)" type="button">Actualizar</button>
</div>
<div class="notification-list alerts-type-list" id="archiveDeliveryAlertsList">
<div class="empty">No hay solicitudes de entrega a Archivo.</div>
</div>
</div>
<div class="alerts-type-card alerts-type-card-crossarea">
<div class="alerts-type-head">
<div>
<strong>🔄 Solicitudes entre áreas · esperando devolución</strong>
<div class="alerts-type-description">
              El expediente fue solicitado por un usuario de otra área, pero continúa físicamente con su responsable actual. La nueva solicitud se habilita recién cuando Archivo confirma su recepción.
            </div>
</div>
<span class="pill alert"><span id="crossAreaWaitAlertsCount">0</span> pendientes</span>
</div>
<div class="alert-format-toolbar">
<strong><span id="crossAreaToolbarCount">0</span> expediente(s) en espera</strong>
<button class="btn secondary small" onclick="loadCrossAreaWaits(false)" type="button">Actualizar</button>
</div>
<div class="notification-list alerts-type-list" id="crossAreaWaitAlertsList">
<div class="empty">No hay solicitudes entre áreas esperando devolución.</div>
</div>
</div>
</section>
<!-- GRUPO 3: REASIGNACIONES -->
<section class="alerts-group alerts-group-reassign">
<div class="alerts-group-title">
<div>
<span class="alerts-group-number">3</span>
<strong>REASIGNACIONES</strong>
</div>
<span class="alerts-group-hint">Movimientos internos y avisos no leídos</span>
</div>
<div class="alerts-type-card">
<div class="alerts-type-head">
<div>
<strong>🤝 Solicitudes de reasignación recibidas</strong>
<div class="alerts-type-description">
              Si otro usuario necesita un expediente que está bajo su custodia, aquí recibirá la solicitud. Esto también aplica cuando usted tenga perfil COORDINADOR. Al confirmar la reasignación, el expediente pasará directamente al solicitante sin regresar previamente a Archivo.
            </div>
</div>
<span class="pill alert"><span id="internalReassignAlertsCount">0</span> pendientes</span>
</div>
<div class="alert-format-toolbar">
<div><button class="btn secondary small active" data-internal-alert-filter="all" onclick="setInternalAlertFilter('all')" type="button">Todos</button>
<button class="btn secondary small" data-internal-alert-filter="pending" onclick="setInternalAlertFilter('pending')" type="button">Pendientes</button></div>
<button class="btn secondary small" onclick="loadInternalReassignRequests(false)" type="button">Actualizar</button>
</div>
<div class="notification-list alerts-type-list" id="internalReassignAlertsList">
<div class="empty">No hay expedientes solicitados por otro usuario que requieran devolución.</div>
</div>
</div>
<div class="alerts-type-card">
<div class="alerts-type-head">
<div>
<strong>↪ Reasignaciones no leídas</strong>
<div class="alerts-type-description">
              Avisos de reasignación que todavía no han sido marcados como leídos.
            </div>
</div>
<div class="alerts-type-actions">
<span class="pill alert"><span id="reassignmentUnreadText">0</span> no leídas</span>
<button class="btn secondary small" id="markAllAlertsBtn" onclick="markAllNotificationsRead()">
              Marcar como leídas
            </button>
</div>
</div>
<div class="alert-format-toolbar">
<div><button class="btn secondary small active" data-reassignment-alert-filter="all" onclick="setReassignmentAlertFilter('all')" type="button">Todos</button>
<button class="btn secondary small" data-reassignment-alert-filter="unread" onclick="setReassignmentAlertFilter('unread')" type="button">Pendientes de lectura</button></div>
<button class="btn secondary small" onclick="loadNotifications(false)" type="button">Actualizar</button>
</div>
<div class="notification-list alerts-type-list" id="notificationsList">
<div class="empty">No hay alertas de reasignación.</div>
</div>
</div>
</section>
<section class="location-alerts-section" style="margin:12px 0">
<div class="location-alerts-title"><div><strong>Ubicaciones verificadas</strong>
<p>Consulte los expedientes cuya ubicación fue verificada mediante su trazabilidad.</p></div>
<strong class="location-alerts-summary" id="locationAlertsSummary">Consultando avisos…</strong></div>
<div aria-label="Filtros de avisos de ubicación" class="location-alert-tools">
<button aria-pressed="true" class="btn secondary small active" data-location-filter="all" onclick="setLocationAlertsFilter('all')" type="button">Todos</button>
<button aria-pressed="false" class="btn secondary small" data-location-filter="unread" onclick="setLocationAlertsFilter('unread')" type="button">Pendientes de lectura</button>
<button class="btn secondary small" id="locationMarkAllBtn" onclick="markAllLocationNoticesRead()" type="button">Marcar pendientes como leídos</button>
<button class="btn secondary small" onclick="loadLocationAlerts()" type="button">Actualizar</button>
</div>
<div aria-live="polite" id="locationAlertsList" role="status"></div>
</section>
</div>
</div>
<!-- Historial individual -->
<div class="modal" id="expHistoryModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box">
<div class="modal-head"><div><h2 id="expHistoryTitle">Historial del expediente</h2><div style="font-size:12px;color:#64748b;margin-top:3px">Cada solicitud conserva su propio historial; el expediente maestro permanece único.</div></div><button class="btn secondary small" onclick="closeExpHistory()">Cerrar</button></div>
<div class="history-summary">
<div class="mini"><span>Expediente</span><b id="hExp">—</b></div>
<div class="mini"><span>Extensión</span><b id="hExt">—</b></div>
<div class="mini"><span>Responsable actual</span><b id="hResp">—</b></div>
<div class="mini"><span>Estado actual</span><b id="hEstado">—</b></div>
</div>
<div id="expTimeline"></div>
</div>
</div>
<!-- Reasignación múltiple del usuario -->
<div class="modal" id="bulkReassignModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box" style="max-width:1050px">
<div class="modal-head">
<div>
<h2>Reasignar expedientes seleccionados</h2>
<div style="font-size:12px;color:#64748b;margin-top:3px">
          Seleccione responsable y, si cambia la finalidad, un nuevo asunto por expediente. El Último folio sigue siendo obligatorio.
        </div>
</div>
<button class="btn secondary small" onclick="closeBulkReassignModal()">Cerrar</button>
</div>
<div class="form-grid" style="margin-bottom:10px">
<div class="field span2">
<label>Nuevo responsable *</label>
<select id="bulkReassignTarget" onchange="syncBulkReassignState()">
<option value="">— SELECCIONE NUEVO RESPONSABLE —</option>
</select>
</div>
<div class="field span2">
<label for="bulkReassignObservation">Observación de reasignación (opcional)</label>
<textarea id="bulkReassignObservation" maxlength="1500" rows="2" placeholder="Ej.: Falta incorporar el descargo. El nuevo responsable podrá ver este comentario en Observaciones."></textarea>
</div>
</div>
<div class="v560-mail-panel" id="v560ReassignMailPanel" style="margin:10px 0 12px">
  <div class="v560-mail-head">
    <div>
      <strong>✉ Notificación por correo</strong>
      <div class="note" style="margin-top:3px">Opcional. Un solo correo incluirá todos los expedientes, con su asunto anterior y el asunto para el nuevo responsable.</div><div class="note" style="margin-top:4px"><b>Predeterminados:</b> Coordinador de Archivo + Armando + Jaime + <b>quien reasigna</b>. El nuevo responsable se agrega como destinatario funcional de la reasignación.</div>
    </div>
    <label class="v560-mail-switch"><input id="v560ReassignMailEnabled" type="checkbox" onchange="v560SyncReassignMailUI()"> Enviar correo</label>
  </div>
  <div id="v560ReassignMailContent" class="v560-mail-content hidden">
    <div class="field">
      <label>Destinatarios autorizados</label>
      <div id="v560ReassignMailRecipients" class="v560-recipient-list"><span class="note">Cargando correos configurados por el Administrador...</span></div>
    </div>
    <div class="field">
      <label>Asunto del correo *</label>
      <input id="v560ReassignMailSubject" maxlength="180" placeholder="Ej.: Reasignación de expedientes" oninput="this.dataset.manual='1'">
    </div>
  </div>
</div>
<div class="note">
      Solo se reasignarán expedientes que actualmente estén <b>EN PRÉSTAMO</b> y bajo su responsabilidad.
      Si Archivo ya había solicitado uno de ellos, la solicitud de entrega continuará activa para el nuevo responsable.
    </div>
<div class="bulk-return-summary">
<div class="mini"><b id="bulkReassignCount">0</b> expedientes seleccionados</div>
<div class="mini"><b id="bulkReassignArchiveCount">0</b> solicitados por Archivo</div>
</div>
<div class="bulk-return-table" id="bulkReassignTable">
<div class="empty">Seleccione expedientes para reasignar.</div>
</div>
<div class="modal-foot">
<span id="bulkReassignStatus" style="margin-right:auto;font-size:12px;color:#64748b"></span>
<button class="btn secondary" onclick="closeBulkReassignModal()">Cerrar</button>
<button class="btn" disabled="" id="bulkReassignSubmitBtn" onclick="submitBulkReassign()">REASIGNAR EXPEDIENTES</button>
</div>
</div>
</div>
<!-- Devolución múltiple del usuario -->
<div class="modal" id="bulkReturnModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box" style="max-width:1050px">
<div class="modal-head">
<div>
<h2>Devolver varios expedientes</h2>
<div style="font-size:12px;color:#64748b;margin-top:3px">
          Actualice R.D. si corresponde y registre obligatoriamente el Último folio de cada expediente antes de devolver.
        </div>
</div>
<button class="btn secondary small" onclick="closeBulkReturnModal()">Cerrar</button>
</div>
<div class="note">
      La devolución se valida por el <b>ciclo activo de atención</b>, no por ciclos anteriores ya cerrados. Un mismo expediente puede ser solicitado, devuelto y posteriormente solicitado nuevamente. La custodia permanecerá con el usuario hasta que Archivo confirme la recepción.
    </div>
    <div class="field" style="margin:12px 0">
<label for="bulkReturnObservation"><b>Comentario general de la devolución (opcional)</b></label>
<textarea id="bulkReturnObservation" rows="2" maxlength="700" style="width:100%;box-sizing:border-box;min-height:62px;padding:9px;border:1px solid #b8cde8;border-radius:7px;resize:vertical" placeholder="Ej.: Devolver con documentación pendiente; esta nota quedará en el historial de cada expediente seleccionado."></textarea>
<div class="note">También puede registrar una observación distinta para cada expediente en la relación inferior. Si deja ambos campos vacíos, podrá devolver normalmente.</div>
</div>
<div class="bulk-return-summary">
<div class="mini"><b id="bulkReturnSelectedTotal">0</b> seleccionados</div>
<div class="mini"><b id="bulkReturnCount">0</b> válidos para devolver</div>
<div class="mini"><b id="bulkReturnExcludedCount">0</b> excluidos</div>
<div class="mini"><b id="bulkReturnArchiveCount">0</b> solicitados por Archivo</div>
</div>
<div class="bulk-return-table" id="bulkReturnTable">
<div class="empty">Seleccione expedientes para devolver.</div>
</div>
<div class="modal-foot">
<span id="bulkReturnStatus" style="margin-right:auto;font-size:12px;color:#64748b"></span>
<button class="btn secondary" onclick="closeBulkReturnModal()">Cerrar</button>
<button class="btn" disabled="" id="bulkReturnSubmitBtn" onclick="submitBulkReturn()">DEVOLVER EXPEDIENTES</button>
</div>
</div>
</div>
<!-- Listados de expedientes devueltos: ARCHIVO / ADMINISTRADOR -->
<div class="modal" id="archiveListsModal" onclick="closeModalFromBackdrop(event,this)">
<div class="modal-box archive-lists-modal-box" style="max-width:1500px;width:97vw">
<div class="modal-head">
<div>
<h2>Listados de expedientes devueltos</h2>
<div class="note">El destino se determina automáticamente por el año: SAN LUIS únicamente para expedientes 1995–2016 · los demás permanecen en BARRENECHEA.</div>
</div>
<button class="btn secondary small" onclick="closeArchiveListsModal()" type="button">Cerrar</button>
</div>
<div class="archive-list-modal-grid">
<div class="archive-list-panel">
<div class="archive-list-panel-head archive-list-bulk-head">
<div>
<b>Listados</b>
<div class="note">
              Seleccione uno o varios listados para revisarlos, exportarlos o imprimirlos juntos.
              El envío a San Luis se habilita únicamente para los listados GENERADOS que correspondan.
            </div>
</div>
<div class="archive-list-bulk-actions">
<span class="sel-count" id="archiveListBulkSelectedCount">0 seleccionados</span>
<button class="btn secondary small" id="archiveListSelectAllSanLuisBtn" onclick="selectAllVisibleArchiveLists()" type="button">
              Seleccionar visibles
            </button>
<button class="btn secondary small" disabled="" id="archiveListBulkViewBtn" onclick="loadSelectedArchiveListsDetail()" type="button">
              Ver selección (0)
            </button>
<button class="btn secondary small" disabled="" id="archiveListBulkExportBtn" onclick="exportSelectedArchiveListsCSV()" type="button">
              Exportar seleccionados
            </button>
<button class="btn secondary small" disabled="" id="archiveListBulkPrintBtn" onclick="printSelectedArchiveLists()" type="button">
              Imprimir seleccionados
            </button>
<button class="btn small" disabled="" id="archiveListBulkSendBtn" onclick="sendSelectedArchiveListsToSanLuis()" type="button">
              Enviar a San Luis (0)
            </button>
<button class="btn secondary small" onclick="loadArchiveLists()" type="button">
              Actualizar
            </button>
</div>
</div>
<div class="archive-list-search-row">
<div class="field archive-list-search-field">
<label>Buscar listado</label>
<input autocomplete="off" id="archiveListSearch" oninput="filterArchiveLists()" placeholder="Ej.: SL-003-2026, SAN LUIS, GENERADO, fecha de envío..." type="search"/>
</div>
<button class="btn secondary small archive-list-search-clear" id="archiveListSearchClearBtn" onclick="clearArchiveListSearch()" type="button">
            Limpiar
          </button>
<span class="archive-list-search-count" id="archiveListSearchCount"></span>
</div>
<div class="note archive-list-bulk-status" id="archiveListBulkStatus"></div>
<div id="archiveListsTable"><div class="empty">Cargando listados...</div></div>
</div>
<div class="archive-list-panel">
<div class="archive-list-panel-head">
<div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
<div>
<b id="archiveListDetailTitle">Seleccione un listado</b>
<div class="note" id="archiveListDetailMeta"></div>
</div>
<div style="display:flex;gap:6px;flex-wrap:wrap">
<button class="btn secondary small" disabled="" id="archiveListExportBtn" onclick="exportCurrentArchiveListCSV()" type="button">Exportar CSV</button>
<button class="btn secondary small" disabled="" id="archiveListPrintBtn" onclick="printCurrentArchiveList()" type="button">Imprimir</button>
<button class="btn small" disabled="" id="archiveListGenerateBtn" onclick="generateCurrentArchiveList()" type="button">Generar listado</button>
<button class="btn small hidden" disabled="" id="archiveListSendSanLuisBtn" onclick="sendCurrentArchiveListToSanLuis()" type="button">Enviar a San Luis</button>
</div>
</div>
<div class="note" id="archiveListStatus" style="margin-top:6px"></div>
</div>
<div id="archiveListDetailTable"><div class="empty">Seleccione un listado para revisar sus expedientes.</div></div>
</div>
</div>
</div>
</div>
<!-- Aceptación múltiple de devoluciones desde Registro Maestro -->
