<style id="v651-cargo-type-css">
.v651-cargo-type-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:14px 0}
.v651-cargo-type-card{border:1px solid #cbd9e8;border-radius:12px;background:#fff;padding:16px;text-align:left;cursor:pointer;transition:.15s ease;min-height:138px}
.v651-cargo-type-card:hover{transform:translateY(-1px);box-shadow:0 8px 18px rgba(23,54,93,.10);border-color:#7aa7d4}
.v651-cargo-type-card strong{display:block;font-size:21px;color:#17365d;margin:7px 0}
.v651-cargo-type-card small{display:block;color:#64748b;line-height:1.35}
.v651-cargo-type-card.v651-test{background:#fffaf0;border-color:#e7c978}
.v651-cargo-type-tag{font-size:11px;font-weight:800;letter-spacing:.4px;color:#17365d}
.v651-test .v651-cargo-type-tag{color:#8a5a00}
.v651-cargo-choice-note{font-size:12px;color:#475569;background:#f8fbff;border:1px solid #d7e3ef;border-radius:9px;padding:10px 12px}
@media(max-width:760px){.v651-cargo-type-grid{grid-template-columns:1fr}}
</style>

<style id="v653-progressive-detail-style">
#requestDetailModal .v653-progressive-loading{
  min-height:54px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:700;
  color:#526b86;
}
#requestDetailModal[aria-busy="true"] .modal-head::after{
  content:"Actualizando…";
  margin-left:auto;
  margin-right:8px;
  font-size:11px;
  font-weight:700;
  color:#64748b;
}
</style>
<!-- V658 · Reimpresión directa de cargo existente sin selección obligatoria. No altera correlativo ni préstamo. -->
<!-- V660 · Cierre administrativo no bloquea una nueva solicitud si el expediente ya está físicamente en Archivo. -->
<!-- V661 · La evaluación aplicada al cierre administrativo se generaliza a TODOS los expedientes cerrados por ADMINISTRADOR. -->

<style id="v672-request-detail-overlay-style">
/* =========================================================
   V672 · GESTIONAR SOLICITUD COMO MODAL SUPERPUESTO REAL
   - Mantiene visible la pantalla de origen detrás del modal.
   - Evita que el tema verde de Archivo/Admin pinte el modal.
   - El contenido principal queda blanco y desplazable dentro
     de la ventana, no como una página que reemplaza la vista.
   ========================================================= */
html body #requestDetailModal.modal{
  position:fixed!important;
  inset:0!important;
  z-index:200!important;
  padding:24px!important;
  align-items:center!important;
  justify-content:center!important;
  background:rgba(15,23,42,.46)!important;
  backdrop-filter:blur(1.5px)!important;
  -webkit-backdrop-filter:blur(1.5px)!important;
}
html body #requestDetailModal.modal.show{
  display:flex!important;
}
html body #requestDetailModal > .modal-box{
  position:relative!important;
  width:min(92vw,1180px)!important;
  max-width:1180px!important;
  max-height:88vh!important;
  margin:0!important;
  padding:18px!important;
  overflow:auto!important;
  background:#ffffff!important;
  color:#203044!important;
  border:1px solid #d5e0ea!important;
  border-radius:14px!important;
  box-shadow:0 24px 72px rgba(3,18,36,.34)!important;
}
html body #requestDetailModal .modal-head{
  position:sticky!important;
  top:-18px!important;
  z-index:15!important;
  margin:-18px -18px 12px!important;
  padding:18px 18px 12px!important;
  background:#ffffff!important;
  border-bottom:1px solid #e2e8f0!important;
}
html body #requestDetailModal .req-summary{
  background:transparent!important;
}
html body #requestDetailModal .req-summary .mini{
  background:#f7f9fc!important;
  border-color:#d5e0ea!important;
}
html body #requestDetailModal .request-quick-intro{
  background:#f7f9fc!important;
  border-color:#cddcf7!important;
}
html body #requestDetailModal .request-unified-section,
html body #requestDetailModal .request-location-section,
html body #requestDetailModal .v613-attention-inside,
html body #requestDetailModal .request-items-card,
html body #requestDetailModal .v626-reit-history,
html body #requestDetailModal #rqAttentionSection,
html body #requestDetailModal #rqObservationSection,
html body #requestDetailModal #v669ModalitySection{
  background:#ffffff!important;
}
html body #requestDetailModal .request-items-card > .table-head,
html body #requestDetailModal .request-unified-title,
html body #requestDetailModal .request-location-head{
  background:#ffffff!important;
}
html body #requestDetailModal #v669ModalitySection .v669-modality-summary > div{
  background:#f7f9fc!important;
  border-color:#d5e0ea!important;
}
html body #requestDetailModal .field input,
html body #requestDetailModal .field select,
html body #requestDetailModal .field textarea{
  background:#ffffff!important;
}
html body #requestDetailModal .note{
  background:#f7f9fc!important;
}
@media(max-width:900px){
  html body #requestDetailModal.modal{padding:10px!important;align-items:center!important;}
  html body #requestDetailModal > .modal-box{
    width:calc(100vw - 20px)!important;
    max-width:none!important;
    max-height:94vh!important;
    padding:14px!important;
  }
  html body #requestDetailModal .modal-head{
    top:-14px!important;
    margin:-14px -14px 10px!important;
    padding:14px 14px 10px!important;
  }
}
</style>
<!-- V672 · Gestionar solicitud vuelve a ser una ventana modal superpuesta: pantalla de origen visible detrás, overlay translúcido y contenido blanco. -->
<!-- V727 · Exportar en tarjetas de otro usuario: solo ADMINISTRADOR y ARCHIVO. -->
<style id="v727-restrict-owner-export-by-role">
/* No modificar tarjetas, contadores ni la accion Ver expedientes. */
.app.role-user #fullAccessKpis .kpi-export-v708,
.app.role-coordinator #fullAccessKpis .kpi-export-v708 {
  display: none !important;
}
</style>
<!-- V730 · La eliminación de Último movimiento no debe ensanchar Días en custodia por los estilos históricos nth-child(8). -->
<style id="v730-days-custody-layout">
#panelTable td.v730-days-custody,
#panelTable th.v730-days-custody {
  min-width: 90px !important;
  max-width: 145px !important;
  white-space: nowrap !important;
  text-align: center !important;
}
</style>
<!-- V733 · Respetar desmarcado manual y verificar persistencia de estado de destinatarios -->

<style id="v738-mis-solicitudes-detalle-final">
/* V738: detalle ubicado al final y consulta actual bajo demanda. */
#requestsTable .v738-detail-th,#requestsTable .v738-detail-td{width:60px!important;min-width:58px!important;max-width:72px!important;white-space:nowrap;text-align:center;padding:5px 4px!important}
#requestsTable .v738-detail-button{border:1px solid #c0d2eb;background:#f6faff;color:#134679;border-radius:6px;font-weight:700;font-size:11px;padding:6px 8px;cursor:pointer;white-space:nowrap}
#requestsTable .v738-detail-button:hover{border-color:#3379cd;background:#e7f1ff}
#requestsTable .v738-detail-button:focus-visible{outline:2px solid #1b65bf;outline-offset:2px}
.v738-dialog-backdrop{position:fixed;inset:0;z-index:2147482000;background:rgba(8,26,53,.46);display:flex;align-items:center;justify-content:center;padding:22px}
.v738-dialog{width:min(900px,100%);max-height:90vh;display:flex;flex-direction:column;background:white;border-radius:12px;box-shadow:0 18px 50px rgba(0,0,0,.24);overflow:hidden;font-family:inherit;color:#183d68}
.v738-dialog-header{padding:16px 18px 12px;display:flex;align-items:flex-start;justify-content:space-between;gap:12px;background:#f5f9ff;border-bottom:1px solid #dce7f7}
.v738-dialog-header h3{font-size:18px;line-height:1.3;margin:0 0 3px;font-weight:800}
.v738-dialog-header p{margin:0;font-size:12px;color:#55708e}
.v738-dialog-close{font-size:17px;border:1px solid #d3deeb;border-radius:8px;background:#fff;cursor:pointer;width:34px;height:32px}
.v738-dialog-content{overflow:auto;padding:12px 18px 18px;min-height:100px}
.v738-items-count{margin:0 0 10px;font-size:12px;color:#486782;font-weight:600}
.v738-table-scroll{overflow-x:auto}
.v738-detail-table{width:100%;min-width:600px;border-collapse:collapse;font-size:12px;text-align:left}
.v738-detail-table th{background:#eaf2fc;color:#184679;padding:9px 10px;font-weight:800;border:1px solid #d6e2f2}
.v738-detail-table td{padding:10px;border:1px solid #e2e8f2;vertical-align:middle;line-height:1.4}
.v738-detail-table tbody tr:nth-child(even){background:#f7faff}
.v738-detail-table td small{display:block;color:#657e97;font-size:11px;margin-top:3px}
.v738-detail-table .v738-seq{text-align:center;width:35px;color:#526b85}
.v738-status{display:inline-block;border-radius:20px;padding:5px 9px;font-size:10px;font-weight:800;white-space:normal}
.v738-returned{color:#086044;background:#daf5e7}
.v738-reassigned{color:#6033ad;background:#ede3ff}
.v738-return-requested{color:#9f4c0e;background:#fff0db}
.v738-loan{color:#805000;background:#fff1ce}
.v738-pending{color:#975624;background:#fff2dc}
.v738-delivered{color:#066786;background:#dff5fa}
.v738-neutral{color:#365676;background:#eaf0f7}
.v738-other-cycle{display:block;color:#66788c;font-weight:500;font-size:10px;margin-top:5px}
.v738-dialog-footer{display:flex;justify-content:flex-end;padding:10px 18px;border-top:1px solid #dfe9f4;background:#fafcff}
.v738-dialog-footer button{border:1px solid #b7cbe5;color:#184679;background:white;border-radius:7px;padding:7px 16px;font-weight:700;cursor:pointer}
.v738-dialog-loading,.v738-dialog-empty{color:#506985;padding:16px 4px;font-size:13px}
.v738-dialog-error{background:#fff3f2;color:#92312a;border:1px solid #fad0ca;padding:10px;border-radius:7px;font-size:12px}
@media(max-width:680px){.v738-dialog-backdrop{padding:9px}.v738-dialog-header{padding:13px}.v738-dialog-header h3{font-size:15px}.v738-dialog-content{padding:10px}.v738-dialog-footer{padding:9px 12px}}
</style>
<style id="v739CargosDetalleEstilos">
/* V739 · Ventana interna de consulta, sin modificar estilos globales */
#v739CargoExpedientesModal{z-index:85}
#v739CargoExpedientesModal .v739-cargo-modal-box{width:min(900px,96vw);max-width:900px;max-height:88vh;padding:18px;overflow:auto}
#v739CargoExpedientesModal .v739-cargo-head{gap:16px;align-items:flex-start}
#v739CargoExpedientesModal .v739-cargo-head h2{font-size:18px;margin:0;color:#153b66}
#v739CargoExpedientesModal .v739-cargo-subtitle{font-size:12px;color:#64748b;margin:6px 0 0}
#v739CargoExpedientesModal .v739-table-scroll{width:100%;overflow-x:auto;max-height:58vh;border:1px solid #d9e4f1;border-radius:9px}
#v739CargoExpedientesModal .v739-table{width:100%;border-collapse:collapse;font-size:12px;min-width:660px}
#v739CargoExpedientesModal .v739-table thead{position:sticky;top:0;z-index:1}
#v739CargoExpedientesModal .v739-table th{background:#e7f0fa;color:#24466b;text-transform:uppercase;font-size:10px;letter-spacing:.02em;text-align:left;padding:10px 9px;white-space:nowrap}
#v739CargoExpedientesModal .v739-table td{padding:11px 9px;border-top:1px solid #e2e8f0;vertical-align:middle}
#v739CargoExpedientesModal .v739-table tbody tr:nth-child(even){background:#f5f9fe}
#v739CargoExpedientesModal .v739-table td:nth-child(2){white-space:nowrap;color:#092f61}
#v739CargoExpedientesModal .v739-status{display:inline-block;border-radius:20px;padding:5px 9px;font-size:10px;font-weight:800;white-space:nowrap}
#v739CargoExpedientesModal .v739-status-blue{background:#e2efff;color:#1955a1}
#v739CargoExpedientesModal .v739-status-purple{background:#ede9fe;color:#6941aa}
#v739CargoExpedientesModal .v739-status-amber{background:#fff1d6;color:#9c5800}
#v739CargoExpedientesModal .v739-status-green{background:#dff5e8;color:#146743}
#v739CargoExpedientesModal .v739-status-neutral{background:#edf2f7;color:#475569}
#v739CargoExpedientesModal .v739-loading,#v739CargoExpedientesModal .v739-empty,#v739CargoExpedientesModal .v739-error{padding:22px;text-align:center;font-size:13px;color:#64748b;background:#f8fafc;border:1px solid #e2e8f0;border-radius:9px}
#v739CargoExpedientesModal .v739-error{color:#a32336;background:#fff3f4;border-color:#f7c8ce}
#v739CargoExpedientesModal .v739-footnote{font-size:11px;color:#64748b;margin-top:10px}
@media(max-width:680px){#v739CargoExpedientesModal .v739-cargo-modal-box{padding:12px;max-width:98vw}#v739CargoExpedientesModal .v739-cargo-head h2{font-size:15px}}
</style>

<style id="v765OriginalHeadersCSS">
#tab-dataAssignments .v765-table-scroll{overflow-x:auto;max-width:100%;border:1px solid #cdd9e6;border-radius:9px;overscroll-behavior-x:contain;scrollbar-width:thin}
#tab-dataAssignments .v765-data-table{min-width:1500px;width:max-content;max-width:none;border-collapse:separate;border-spacing:0;font-size:12px;table-layout:auto}
#tab-dataAssignments .v765-data-table th{white-space:nowrap;text-align:left;background:#17426e;color:white;position:sticky;top:0;padding:10px 8px;z-index:1;font-weight:700;letter-spacing:.01em}
#tab-dataAssignments .v765-data-table td{vertical-align:top;border-bottom:1px solid #e2e9f1;padding:10px 8px;max-width:330px;min-width:86px;overflow-wrap:anywhere;line-height:1.45}
#tab-dataAssignments .v765-data-table tr:nth-child(even) td{background:#f4f8fd}
#tab-dataAssignments .v765-data-table td[data-col="ADMINISTRADO"]{min-width:205px;max-width:260px}
#tab-dataAssignments .v765-data-table td[data-col="RD_PRIMIGENIA"]{min-width:170px;max-width:220px}
#tab-dataAssignments .v765-data-table td[data-col="SOLICITUD"]{min-width:165px}
#tab-dataAssignments .v765-data-table td[data-col="FECHA_VENCIMIENTO"]{min-width:128px;font-weight:650}
#tab-dataAssignments .v765-data-table td[data-col="NRO_REG"]{white-space:nowrap;font-variant-numeric:tabular-nums}
#tab-dataAssignments .v765-inline-info{font-size:11px;color:#526c87;margin-top:3px}
#tab-dataAssignments .v765-table-scroll:focus-visible{outline:2px solid #176caa;outline-offset:3px}
</style>
<style id="v768GroupStyles">
.v768-blocks{margin:0 0 12px;padding:10px;background:#f4f8fc;border:1px solid #cbd9e8;border-radius:9px}
.v768-block{display:flex;gap:10px;justify-content:space-between;align-items:center;padding:9px;margin:7px 0;border:1px solid #dae3ed;background:white;border-radius:8px;font-size:12px}
.v768-block p{margin:3px 0;overflow-wrap:anywhere}
#v768Modal .modal-box{max-width:950px;width:95%;max-height:85vh;overflow:auto}
#v768GroupRows{margin:10px 0;max-height:45vh;overflow:auto;border:1px solid #d9e2ec;border-radius:7px}
.v768-row{display:grid;grid-template-columns:25px minmax(110px,1fr) minmax(95px,1fr) minmax(130px,1.4fr);gap:8px;align-items:start;padding:9px;border-bottom:1px solid #e2e9f2;font-size:12px}
.v768-row:nth-child(even){background:#f7f9fc}
.v768-row input[type=text]{width:110px;max-width:100%;padding:5px;border:1px solid #9aaec4;border-radius:5px}
.v768-small{font-size:11px;color:#536f88;overflow-wrap:anywhere}
.v768-actions{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:12px 0}
@media(max-width:640px){.v768-block{align-items:stretch;flex-direction:column}.v768-row{grid-template-columns:25px 1fr}.v768-row>div:nth-child(4){grid-column:2}}
</style>
<style id="v774-recepciones-estilos">
/* V774: Recepción accesible al perfil Usuario y Coordinador, sin alterar sus otras pestañas. */
body .app.limited-user .tabs .tab[data-tab="receipts"]:not([data-tab="panel"]):not([data-tab="requests"]),
body .app.limited-user .main-sticky-header .tabs .tab[data-tab="receipts"]:not([data-tab="panel"]):not([data-tab="requests"]){display:inline-flex!important;align-items:center;gap:6px;visibility:visible!important}
body .app.limited-user .tabs,body .app.limited-user .main-sticky-header .tabs{grid-template-columns:repeat(3,minmax(0,1fr))!important}
#tab-receipts{max-width:100%;min-width:0}
.v774-receipts-card{padding:18px!important;max-width:100%;min-width:0}
.v774-receipts-heading{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;flex-wrap:wrap}
.v774-receipts-heading h3{font-size:19px;margin:0 0 7px;color:#173a62}
.v774-receipts-heading p{margin:0 0 10px}
.v774-receipts-summary{display:flex;gap:9px;flex-wrap:wrap;margin:12px 0}
.v774-summary-box{display:flex;align-items:center;gap:8px;background:#f5f8fc;border:1px solid #dbe5ef;border-radius:7px;padding:8px 11px}
.v774-summary-box b{font-size:20px;color:#17446f}
.v774-summary-box span{font-size:12px;color:#475f77}
.v774-receipts-filters{display:grid;grid-template-columns:minmax(240px,2fr) minmax(180px,1fr) minmax(165px,1fr);gap:10px;margin-bottom:12px}
.v774-receipts-filters label,.v774-receipts-note label{display:block;font-size:11px;font-weight:700;color:#506986;margin-bottom:5px}
.v774-receipts-filters :is(select,input){width:100%;min-height:35px;box-sizing:border-box;border:1px solid #b9cfe4;border-radius:6px;padding:7px 9px}
.v774-receipts-tools{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:10px 0}
.v774-selectall{display:flex;align-items:center;gap:6px;font-size:12px}
#v774SelectionCount{font-size:12px;color:#51677d}
.v774-receipts-table{width:100%;overflow-x:auto;border:1px solid #d4e0eb;border-radius:7px;max-height:54vh;overflow-y:auto}
.v774-receipts-table table{border-collapse:collapse;width:100%;min-width:1020px;font-size:12px}
.v774-receipts-table th{background:#184673;color:#fff;padding:9px 7px;text-align:left;position:sticky;top:0;z-index:1}
.v774-receipts-table td{border-bottom:1px solid #e1e9f1;padding:8px 7px;vertical-align:top}
.v774-receipts-table tr:nth-child(even){background:#f5f9fd}
.v774-receipts-table .v774-state{font-size:11px;font-weight:700;color:#274a6c}
.v774-receipts-note{margin:12px 0 8px;max-width:700px}
.v774-receipts-note textarea{width:100%;box-sizing:border-box;border:1px solid #b9cfe4;border-radius:6px;padding:9px}
@media(max-width:850px){.v774-receipts-filters{grid-template-columns:1fr}}
</style>


<!-- V780: La membresía activa del equipo se valida con v211_listar_mi_equipo.
     Expedientes por área sigue reservado para Administración/Archivo. -->
<style id="v780-coordinator-team-exclusivity">
body.produce-coordinator-team #ownerCardsPanel:not(.hidden):not(.hidden-by-role){display:block!important}
body.produce-coordinator-team #ownerCardsPanel .owner-cards-grid{min-height:80px}
body.produce-coordinator .produce-nav .v280-area-nav{display:none!important}
</style>

<!-- V814: solo presentación de filtros en Pendiente por atender; sin cambios de JS o Supabase -->
<style id="v814-filters-layout">
/* La cuadrícula V813 no se estaba aplicando porque su estilo quedó en el HTML de impresión.
   Esta regla sí se carga en la página principal y queda limitada a la tarjeta Pendiente. */
#statePendingFilters{container-type:inline-size;}
#statePendingFilters > .filters.v813-pending-grid{
  display:grid!important;
  grid-template-columns:minmax(0,2.05fr) minmax(0,1.38fr) minmax(0,1fr) minmax(0,1.32fr) max-content!important;
  gap:12px!important;
  align-items:end!important;
  width:100%!important;
  max-width:100%!important;
  min-width:0!important;
  margin:0!important;
  padding:0!important;
  background:transparent!important;
  border:0!important;
  box-shadow:none!important;
}
#statePendingFilters > .v813-pending-grid > .field{
  display:flex!important;flex-direction:column!important;justify-content:flex-end!important;
  gap:5px!important;min-width:0!important;width:100%!important;max-width:100%!important;
  margin:0!important;padding:0!important;
}
#statePendingFilters > .v813-pending-grid > .field > label{
  display:block!important;font-size:11px!important;line-height:15px!important;
  min-height:15px!important;margin:0!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
#statePendingFilters > .v813-pending-grid input,
#statePendingFilters > .v813-pending-grid select{
  height:42px!important;min-height:42px!important;width:100%!important;min-width:0!important;
  max-width:100%!important;box-sizing:border-box!important;margin:0!important;
  font-size:13px!important;padding:0 12px!important;
}
#statePendingFilters > .v813-pending-grid > div:last-child{
  display:flex!important;align-items:flex-end!important;justify-content:flex-end!important;
  min-width:0!important;height:42px!important;margin:0!important;
}
#statePendingFilters > .v813-pending-grid > div:last-child > button{
  height:42px!important;min-height:42px!important;margin:0!important;
  padding:0 13px!important;white-space:nowrap!important;
  font-size:12px!important;box-sizing:border-box!important;
}
/* El ancho disponible de la tarjeta gobierna el salto, no el de la pantalla completa. */
@container (max-width:1120px){
  #statePendingFilters > .filters.v813-pending-grid{
    grid-template-columns:minmax(0,1.4fr) minmax(0,1fr)!important;
  }
  #statePendingFilters > .v813-pending-grid > div:last-child{justify-content:flex-start!important;}
}
@container (max-width:650px){
  #statePendingFilters > .filters.v813-pending-grid{grid-template-columns:minmax(0,1fr)!important;gap:10px!important;}
  #statePendingFilters > .v813-pending-grid > div:last-child,
  #statePendingFilters > .v813-pending-grid > div:last-child > button{width:100%!important;}
}
/* Respaldo para navegadores sin container queries. */
@supports not (container-type:inline-size){
 @media(max-width:1180px){#statePendingFilters > .filters.v813-pending-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;}}
 @media(max-width:700px){#statePendingFilters > .filters.v813-pending-grid{grid-template-columns:minmax(0,1fr)!important;}}
}
</style>

<style id="v821-tarjetas-en-menu-style">
.produce-nav #v821QuickCardsToggle{gap:10px;justify-content:flex-start;min-height:44px;margin-top:3px;margin-bottom:7px;background:rgba(48,100,153,.14)!important;border:1px solid rgba(146,194,231,.3)!important;color:inherit!important;font-size:13px!important;font-weight:700!important;padding:9px 13px!important;border-radius:9px!important;white-space:normal}
.produce-nav #v821QuickCardsToggle[hidden]{display:none!important}
.produce-nav #v821QuickCardsToggle:hover,.produce-nav #v821QuickCardsToggle.active{background:#254b70!important;color:#fff!important}
.produce-nav #v821QuickCardsToggle .v821-menu-icon{font-size:18px;min-width:21px;text-align:center}
.produce-nav #v821QuickCardsToggle .v821-chevron{margin-left:auto;font-size:16px}
#v821QuickCardsMenu{position:fixed;z-index:5000;background:#fff;color:#14375e;box-shadow:0 14px 42px rgba(9,33,62,.25);border:1px solid #cbddec;border-radius:12px;padding:7px;overflow-y:auto;overscroll-behavior:contain;box-sizing:border-box}
#v821QuickCardsMenu[hidden]{display:none!important}
#v821QuickCardsMenu .v821-card-entry{display:flex;width:100%;gap:10px;align-items:center;min-height:52px;padding:8px 10px;text-align:left;color:#183c63;background:transparent;border:0;border-radius:7px;cursor:pointer;box-sizing:border-box}
#v821QuickCardsMenu .v821-card-entry:hover,#v821QuickCardsMenu .v821-card-entry:focus-visible{background:#e8f3fd;outline:2px solid #6baff0;outline-offset:-2px}
#v821QuickCardsMenu .v821-card-entry[hidden]{display:none!important}
#v821QuickCardsMenu .v821-card-symbol{flex:none;display:grid;place-items:center;width:30px;height:30px;background:#e7f0fb;border-radius:8px;font-size:16px;font-weight:800;color:#14538b}
#v821QuickCardsMenu .v821-card-content{display:flex;flex-direction:column;flex:1;gap:2px;min-width:0}
#v821QuickCardsMenu .v821-card-content strong{font-size:12px}
#v821QuickCardsMenu .v821-card-content small{font-size:10px;line-height:1.25;color:#677e96;white-space:normal}
#v821QuickCardsMenu .v821-card-count:not([hidden]){font-weight:800;font-size:12px;flex:none;border:1px solid #c7d8ea;background:#f2f7fd;border-radius:18px;padding:3px 6px}
@media(max-width:720px){.produce-nav #v821QuickCardsToggle{white-space:nowrap!important;width:auto!important}}
</style>
</head>
<body>
<div aria-labelledby="inventoryTitle" aria-modal="true" class="modal" id="inventoryModal" onclick="closeModalFromBackdrop(event,this)" role="dialog">
<div class="modal-box inventory-modal-box">
<div class="modal-head"><div><h2 id="inventoryTitle">📚 Inventarios externos</h2><p>Consulta independiente de los inventarios institucionales.</p></div><button class="btn secondary small" onclick="closeInventoryModal()">Cerrar</button></div>
<div class="inventory-search-row"><div class="field"><label for="inventorySearch">Buscar expediente, extensión, fuente, sede o ubicación</label><input id="inventorySearch" oninput="debounceInventorySearch()" onkeydown="if(event.key==='Enter'){event.preventDefault();searchIntegratedInventory()}" placeholder="Ej.: 1-2017, DGS, Barrenechea…"/></div><button class="btn" onclick="searchIntegratedInventory()">Buscar</button></div>
<div aria-live="polite" class="inventory-status" id="inventoryStatus" role="status"></div>
<div aria-live="polite" id="inventoryResults" role="status"><div class="empty">Escriba un expediente para consultar.</div></div>
<div class="note inventory-example-note"><b>Inventario independiente:</b> esta información no se combina con el Registro maestro y no cambia estados, responsables ni custodias del sistema.</div>
</div>
</div>
<div aria-labelledby="locationNoticeTitle" aria-modal="true" class="modal" id="locationNoticeModal" onclick="closeModalFromBackdrop(event,this)" role="dialog" style="z-index:10000!important">
<div class="modal-box" style="max-width:650px">
<div class="modal-head"><h2 id="locationNoticeTitle">Informar ubicación</h2><button class="btn secondary" onclick="closeLocationNotice()" type="button">Cerrar</button></div>
<div aria-live="polite" class="hidden" id="locationSuccess" role="status" style="padding:18px;margin:12px 0;background:#e6f5ea;border:2px solid #278047;border-radius:10px;color:#175c35">
<strong style="font-size:19px">✓ Ubicación comunicada al usuario</strong>
<p id="locationSuccessMessage"></p>
<button class="btn" id="locationSuccessClose" onclick="closeLocationNotice()" type="button">Entendido</button>
</div>
<p id="locationRecipient"></p>
<div id="v829LocationInfo" class="v829-email-help"><strong>Correo institucional al solicitante</strong> · Al confirmar la ubicación, el sistema registrará el aviso y preparará un correo con la <strong>misma estructura utilizada en las solicitudes y comunicaciones del sistema</strong>: asunto, saludo, datos de ubicación, <strong>cuadro de expedientes con encabezado azul</strong>, resultado de la verificación y cierre. El cuadro se incluirá dentro del mensaje, sin Excel adjunto. El envío no cambia la custodia ni atiende la solicitud.</div>
<fieldset style="border:1px solid #d7e0ea;border-radius:8px"><legend>Expedientes a comunicar</legend>
<button class="btn secondary small" id="locationSelectAll" onclick="selectAllLocationItems(true)" type="button">Seleccionar todos</button>
<button class="btn secondary small" id="locationSelectNone" onclick="selectAllLocationItems(false)" type="button">Desmarcar todos</button>
<p id="locationSelectionCount" role="status"></p>
<div id="locationItem" style="max-height:260px;overflow:auto" tabindex="-1"></div>
</fieldset>
<div class="field">
<label for="locationPlace">Ubicación verificada *</label>
<select id="locationPlace" onchange="syncLocationPlaceV359()">
<option value="">— Seleccione la ubicación —</option>
