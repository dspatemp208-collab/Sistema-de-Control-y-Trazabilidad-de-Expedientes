<div class="hidden v823-state-nav" id="v823StateSwitcher" aria-label="Cambiar estado de los expedientes">
  <div class="field v823-state-nav-field">
    <label for="v823OtherEstado">Estado de los expedientes</label>
    <select id="v823OtherEstado" aria-label="Seleccionar estado para cambiar de tarjeta" onchange="v823ChangeState(this.value)">
      <option value="PENDIENTE POR ATENDER">POR ATENDER</option>
      <option value="EN PRÉSTAMO">EN PRÉSTAMO</option>
      <option value="SOLICITUDES DE DEVOLUCIÓN">POR RECIBIR</option>
      <option value="DEVUELTOS AL ARCHIVO">DEVUELTOS AL ARCHIVO</option>
    </select>
  </div>
  <p id="v823StateHint" class="v823-state-hint">Cada estado muestra su bandeja y los filtros que corresponden a ella.</p>
  <button type="button" class="btn secondary small" id="v823ResetOther" onclick="v823ClearAllStateFilters()">Limpiar filtros</button>
</div>
<div id="v825UnifiedFilters" class="v825-unified" hidden aria-label="Filtros de la tarjeta activa">
 <div class="v825-fields">
  <div class="v825-field"><label for="v825Search">Buscar expediente</label><input id="v825Search" placeholder="Ej.: 968-2011 (sin ceros iniciales)" autocomplete="off" oninput="v825SetFilter('search',this.value)"></div>
  <div class="v825-field"><label for="v825Area">Área</label><select id="v825Area" onchange="v825SetFilter('area',this.value)"><option value="">TODAS LAS ÁREAS</option></select></div>
  <div class="v825-field"><label for="v825UserToggle">Usuario</label>
   <div id="v825UserPicker" class="v825-user-picker">
    <button type="button" id="v825UserToggle" aria-expanded="false" aria-controls="v825UserMenu" onclick="v825ToggleUsers()">TODOS LOS USUARIOS <span>▾</span></button>
    <div id="v825UserMenu" hidden>
     <input type="search" id="v825UserSearch" placeholder="Buscar trabajador..." oninput="v825RenderUsers()" aria-label="Buscar usuario" autocomplete="off">
     <div class="v825-user-list" id="v825UserList" role="group" aria-label="Usuarios de la tarjeta activa"></div>
     <div class="v825-menu-bottom"><span id="v825UserCount">Todos</span><button type="button" onclick="v825ClearUsers()">Quitar selección</button></div>
    </div>
   </div>
  </div>
  <div class="v825-field" id="v825ModeField"><label for="v825Mode">Modalidad</label><select id="v825Mode" onchange="v825SetFilter('mode',this.value)"><option value="">TODAS</option></select></div>
  <div class="v825-field" id="v825CommField"><label for="v825Comm">Comunicaciones</label><select id="v825Comm" onchange="v825SetFilter('comm',this.value)"><option value="">TODAS</option><option value="s:COMUNICADO">Con comunicación</option><option value="s:SIN">Sin comunicación</option><option value="s:LEIDO">Leída</option><option value="s:NO_LEIDO">Pendiente de lectura</option><option value="l:SAN LUIS">Ubicación San Luis</option></select></div>
  <div class="v825-field"><label for="v825State">Estado / tarjeta</label><select id="v825State" onchange="v825ChangeCard(this.value)"><option value="PENDIENTE POR ATENDER">POR ATENDER</option><option value="EN PRÉSTAMO">EN PRÉSTAMO</option><option value="REASIGNADOS">REASIGNADOS</option><option value="SOLICITUDES DE DEVOLUCIÓN">POR RECIBIR</option><option value="DEVUELTOS AL ARCHIVO">DEVUELTOS AL ARCHIVO</option></select></div>
  <div class="v825-field v825-date-field" id="v825DateFromField"><label for="v825DateFrom">Entrega desde</label><input type="date" id="v825DateFrom" onchange="v825SetFilter('dateFrom',this.value)"></div>
  <div class="v825-field v825-date-field" id="v825DateToField"><label for="v825DateTo">Entrega hasta</label><input type="date" id="v825DateTo" onchange="v825SetFilter('dateTo',this.value)"></div>
  <div class="v825-field v825-clear-field"><label aria-hidden="true"> </label><button type="button" id="v825Clear" onclick="v825ClearFilters()">Limpiar filtros</button></div>
 </div>
 <div class="v825-caption" id="v825ScopeNote">Los filtros consultan únicamente la tarjeta activa. Los permisos de cada perfil se mantienen.</div>
</div>
<div class="hidden" id="stateLoanFilters" style="padding:12px 14px 4px;border-top:1px solid #e5e7eb;background:#f8fafc">
<div class="filters" style="margin:0;padding:0;background:transparent;border:0;box-shadow:none;grid-template-columns:repeat(6,minmax(150px,1fr));gap:10px">
<div class="field">
<label>Expediente</label>
<input id="loanGlobalSearch" oninput="renderGlobalLoanRows()" placeholder="Ej.: 968-2011"/>
</div>
<div class="field">
<label>Responsable actual</label>
<div class="v824-picker" id="v824OwnerPicker">
  <button id="v824OwnerToggle" class="v824-owner-toggle" type="button" aria-controls="v824OwnerMenu" aria-expanded="false" onclick="v824ToggleOwnerMenu()">TODOS LOS USUARIOS <span aria-hidden="true">▾</span></button>
  <div id="v824OwnerMenu" class="v824-owner-menu" hidden>
    <label class="v824-small-label" for="v824OwnerSearch">Buscar trabajador</label>
