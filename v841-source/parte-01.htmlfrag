body.produce-user #panelTable .produce-record-details[open]{display:block}
body.produce-user #panelTable tbody td:last-child>div{display:inline-flex!important;margin-right:6px}
body.produce-user #panelTable .datetime-cell{display:flex!important;flex-direction:row!important;gap:6px!important;align-items:center!important;justify-content:center!important}
body.produce-user #panelTable .datetime-time{border:0!important;border-radius:0!important;background:none!important;padding:0!important}
body.produce-user #panelTable input[type=checkbox]{display:inline-block!important;width:13px!important;height:13px!important;vertical-align:middle!important;margin:0 4px 0 0!important}
body.produce-ui:not(.produce-user) .main-sticky-header{top:72px!important}
body.produce-ui:not(.produce-user) .sidebar{top:72px!important;height:calc(100vh - 72px)!important}
@media(max-width:1450px){body.produce-user .title{padding-right:0!important;padding-bottom:48px!important}.produce-clock{top:auto;bottom:0;left:0;right:auto;padding:9px 12px}body.produce-user .title h1{font-size:25px!important}body.produce-user .app.role-user #userPersonalKpis .kpi,body.produce-user .app.role-user #userPersonalKpis #userKpiAllCard{padding-left:70px!important}.produce-kpi-icon{left:12px;width:43px;height:43px}.produce-kpi-icon .p-icon{width:28px;height:28px}}
@media(max-width:1050px){.produce-org{font-size:12px;padding:0 14px}.produce-org strong{font-size:15px}.produce-account{gap:10px;padding:0 12px}.produce-brand{width:150px;font-size:25px}.produce-nav{width:200px}.produce-nav footer{width:199px}body.produce-user .app,body.produce-user .app.sidebar-collapsed{margin-left:200px!important;width:calc(100% - 200px)!important}body.produce-user .app.role-user #userPersonalKpis{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
@media(max-width:700px){.produce-top{height:64px}.produce-org{display:none}.produce-account small{display:none}.produce-account{gap:5px}.produce-account button{padding:9px}.produce-person strong{font-size:11px}.produce-brand{width:120px;font-size:22px}.produce-nav{position:relative;top:auto;width:100%;padding:8px;display:none!important}.produce-user .produce-nav{display:flex!important;overflow-x:auto;margin-top:64px;gap:6px}.produce-nav button{width:auto;white-space:nowrap;padding:8px 12px;gap:8px}.produce-nav footer{display:none}body.produce-user .app,body.produce-user .app.sidebar-collapsed{margin-left:0!important;width:100%!important;padding-top:0!important}body.produce-user .app .main{padding:14px 10px!important}body.produce-user #ownerDetailFilters{grid-template-columns:1fr!important;gap:10px!important}body.produce-user .title h1{font-size:23px!important}.produce-clock{font-size:11px;gap:8px}body.produce-user .app.role-user #userPersonalKpis .kpi .label{font-size:10px!important}body.produce-user .app.role-user #userPersonalKpis .kpi,body.produce-user .app.role-user #userPersonalKpis #userKpiAllCard{padding:12px!important;padding-top:57px!important}.produce-kpi-icon{top:9px;width:38px;height:38px}}

