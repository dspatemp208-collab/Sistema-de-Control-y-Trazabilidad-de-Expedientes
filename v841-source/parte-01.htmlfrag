body.produce-user .tabs{display:flex!important;gap:9px!important;overflow:auto!important;margin:12px 0 0!important;padding:0!important;background:none!important;border:0!important;box-shadow:none!important}
body.produce-user .tabs:after{display:none!important}
body.produce-user .main-sticky-header .tabs .tab:not(.hidden-by-role){min-width:210px!important;flex:0 0 auto!important;margin:0!important;padding:11px 28px!important;border:1px solid #cddff0!important;border-radius:7px!important;background:#f9fcff!important;color:#00308e!important;font-size:14px!important;text-align:center!important}
