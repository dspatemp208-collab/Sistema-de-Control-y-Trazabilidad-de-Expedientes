body.produce-user #panelTable .btn{background:#fafdff!important;color:#034b9c!important;border:1px solid #cbdff7!important;border-radius:6px!important;padding:5px 9px!important;font-size:12px!important}
body.produce-user .main-sticky-header>.section-fold-control{display:none!important}
