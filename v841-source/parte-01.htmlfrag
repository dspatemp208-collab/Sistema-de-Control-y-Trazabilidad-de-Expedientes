#requestsTable table td:nth-child(4){
  min-width:118px!important;
  width:118px!important;
  max-width:118px!important;
}
.v641-unattended-cell{
  display:inline-flex;align-items:center;justify-content:center;
  min-width:84px;padding:4px 7px;border-radius:999px;
  border:1px solid #bfd6ef;background:#edf6ff;color:#173b63;
  font-size:10px;font-weight:800;white-space:nowrap;
}
.v641-unattended-cell.warn{border-color:#f2cc67;background:#fff6d8;color:#805800}
.v641-unattended-cell.high{border-color:#ff9b8f;background:#fff0ee;color:#b42318}
.v641-unattended-cell.critical{border-color:#e5484d;background:#ffe5e7;color:#8f1020}
#requestAgeField,#requestAgeOrderField{min-width:175px}
@media(max-width:1100px){
  #requestAgeField,#requestAgeOrderField{min-width:150px}
}
</style>

