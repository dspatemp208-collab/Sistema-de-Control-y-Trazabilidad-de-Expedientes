  <div style="font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.02em;margin-bottom:8px">Filtrar personal y expedientes de mi área</div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:8px;align-items:end">
