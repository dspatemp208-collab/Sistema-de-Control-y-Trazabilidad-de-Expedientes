body.produce-user .app,body.produce-user .app.sidebar-collapsed{display:block!important;margin-left:239px!important;width:calc(100% - 239px)!important;grid-template-columns:none!important}
body.produce-user .app>.sidebar{display:none!important}
body.produce-user .app .main{width:100%!important;max-width:none!important;min-width:0!important;margin:0!important;padding:24px 24px 30px!important;background:radial-gradient(ellipse at bottom left,#deefff80,transparent 60%)}
body.produce-user .main-sticky-header{position:relative!important;top:auto!important;left:auto!important;right:auto!important;width:100%!important;margin:0!important;padding:0!important;box-shadow:none!important;border:0!important;background:transparent!important;z-index:10!important}
body.produce-user .main-sticky-header .topbar{display:flex!important;flex-wrap:wrap!important;align-items:center!important;gap:12px!important;margin:0 0 12px!important}
body.produce-user .title{width:100%!important;position:relative!important;padding-right:420px!important;min-height:62px}
body.produce-user .title h1{font-size:29px!important;line-height:1.2!important;font-weight:800!important;letter-spacing:-.7px!important;color:#080e49!important;margin:0 0 6px!important}
body.produce-user .title p{font-size:15px!important;color:#41628e!important;margin:0!important}
.produce-clock{display:flex;align-items:center;gap:13px;position:absolute;right:0;top:0;background:#f9fcff;border:1px solid #d6e6f7;border-radius:8px;padding:13px 16px;color:#112759;font-size:13px;box-shadow:0 4px 12px #32639909}.produce-clock strong{border-left:1px solid #dfebf6;padding-left:14px;white-space:nowrap}
body.produce-user #userOnlySessionTop{display:none!important}
body.produce-user .main-sticky-header .actions{display:flex!important;flex-wrap:wrap!important;gap:10px!important;width:100%!important;margin:0!important;padding:0!important}
body.produce-user .main-sticky-header .actions>.btn:not(.hidden-by-role){display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:12px!important;height:48px!important;padding:10px 14px!important;min-width:0!important;flex:1 1 auto!important;background:#fbfdff!important;color:#00308e!important;border:1px solid #cbdff5!important;border-radius:8px!important;font-size:14px!important;font-weight:700!important;white-space:nowrap!important;box-shadow:0 3px 9px #32639907!important}
body.produce-user .main-sticky-header .actions>#searchRequestBtn{background:#176bff!important;border-color:#1261ed!important;color:white!important;order:-1!important}
