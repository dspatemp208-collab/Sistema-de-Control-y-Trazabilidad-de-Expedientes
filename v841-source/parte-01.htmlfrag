/* source:v30-devueltos-archivo-gris */
/* =========================================================
   V30 · DEVUELTO AL ARCHIVO EN COLOR GRIS
   ========================================================= */

/* Badge / pill del estado */
#allTable .pill.status-devuelto,
#allTable .badge.status-devuelto,
#allTable .estado-devuelto-archivo,
#allTable .status-devuelto-archivo,
#allTable .status-devuelto,
#allTable .tag-devuelto-archivo{
  background:#d9dee5 !important;
  color:#374151 !important;
  border:1px solid #b7c0cc !important;
  box-shadow:none !important;
}

/* Coincidir por atributo/clase si el sistema genera el estado como texto */
#allTable [data-status="DEVUELTO AL ARCHIVO"],
#allTable [data-estado="DEVUELTO AL ARCHIVO"]{
  background:#d9dee5 !important;
  color:#374151 !important;
  border:1px solid #b7c0cc !important;
  box-shadow:none !important;
}

/* Fallback robusto: cualquier badge del registro maestro que contenga
   visualmente la clase usada para devuelto al archivo hereda el gris. */
#allTable table.master-v19 .pill,
#allTable table.master-v19 .badge{
  position:relative;
}

/* Fila completa en un gris muy suave si el registro está devuelto al archivo
   y la fila viene marcada con clase/atributo de estado */
#allTable tr.status-row-devuelto,
#allTable tr[data-status="DEVUELTO AL ARCHIVO"],
#allTable tr[data-estado="DEVUELTO AL ARCHIVO"]{
  background:#eef1f4 !important;
}

#allTable tr.status-row-devuelto td,
#allTable tr[data-status="DEVUELTO AL ARCHIVO"] td,
#allTable tr[data-estado="DEVUELTO AL ARCHIVO"] td{
  background:#eef1f4 !important;
}

