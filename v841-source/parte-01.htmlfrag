/* source:base */
#rqSelectedTable tbody tr:has(.request-cargo-check){cursor:pointer}
    #rqSelectedTable tbody tr:has(.request-cargo-check:checked) td{background:#dbeafe!important}
    #rqSelectedTable tbody tr:has(.request-cargo-check:checked) td:first-child{box-shadow:inset 4px 0 #1d4ed8}
    #rqSelectedTable .rq-col-ubicacion{min-width:210px;font-size:11px;line-height:1.45;white-space:normal}

/* source:base */
.section-folded{display:none!important}
    .section-fold-control{display:block;position:relative;flex:0 0 auto;box-sizing:border-box;z-index:1;width:100%;text-align:left;background:#eef4fb;color:#17365d;border:1px solid #cbd9e9;border-radius:7px;padding:7px 11px;margin:5px 0;font:inherit;font-size:12px;font-weight:700;cursor:pointer}
    .section-fold-control:hover{background:#dfeafa}
    .section-fold-control:focus-visible{outline:3px solid #2563eb;outline-offset:2px}
    @media print{.section-fold-control{display:none!important}}

/* source:base */
.location-alerts-section{padding:14px;border:1px solid #cbd9e9;border-radius:12px;background:#f8fbff}
    .location-alerts-title{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:10px}
    .location-alerts-title>div>strong{font-size:16px;color:#17365d}
    .location-alerts-title p{margin:5px 0 0;color:#526b87}
    .location-alerts-summary{padding:6px 10px;border-radius:999px;background:#e7eff9;color:#17365d;white-space:nowrap;font-size:12px}
    .location-alert-tools{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid #d7e2ee}
    .location-alert-tools .active{background:#1f5b8f!important;color:#fff!important;border-color:#1f5b8f!important}
    .location-alert-card{margin:8px 0;padding:13px;border:1px solid #cbd9e9;border-left:5px solid #8da4ba;border-radius:10px;background:#fff}
    .location-alert-card.is-unread{border-left-color:#e2a300;background:#fffaf0;box-shadow:0 2px 8px rgba(23,54,93,.07)}
    .location-alert-head,.location-alert-foot{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .location-alert-head strong{font-size:14px;color:#17365d}
    .location-pin{margin-right:5px}
    .location-read-state{padding:4px 8px;border-radius:999px;background:#e8eef5;color:#52677e;font-size:10px;font-weight:800;white-space:nowrap}
    .is-unread .location-read-state{background:#fff0bf;color:#805b00}
    .location-alert-meta{display:flex;gap:8px 18px;flex-wrap:wrap;margin:9px 0;color:#38536f;font-size:12px}
    .location-alert-observation{margin:8px 0;padding:9px 11px;border-radius:7px;background:#eef4fa;color:#17365d;white-space:pre-wrap}
    .location-alert-foot small{color:#5a7088;line-height:1.4}
    @media(max-width:700px){.location-alerts-title,.location-alert-head,.location-alert-foot{align-items:stretch;flex-direction:column}.location-alerts-summary{white-space:normal}.location-alert-foot .btn{align-self:flex-start}}

/* source:base */
#alertsModal .alert-format-toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;padding:9px 12px;border-bottom:1px solid #dce5ef;background:#f8fbff;color:#17365d;font-size:12px}
    #alertsModal .alert-format-toolbar>div{display:flex;gap:7px;flex-wrap:wrap}
    #alertsModal .alert-format-toolbar .active{background:#1f5b8f!important;color:#fff!important;border-color:#1f5b8f!important}
    #alertsModal .alerts-type-list .notification-item{margin:8px 0;padding:13px;border:1px solid #cbd9e9;border-left:5px solid #8da4ba;border-radius:10px;background:#fff}
    #alertsModal .alerts-type-list .notification-item.unread{border-left-color:#e2a300;background:#fffaf0;box-shadow:0 2px 8px rgba(23,54,93,.07)}
    #alertsModal>.modal-box>.location-alerts-section{margin:0 0 20px!important}
    @media(max-width:700px){#alertsModal .alert-format-toolbar{align-items:stretch;flex-direction:column}#alertsModal .alert-format-toolbar>button{align-self:flex-start}}

/* source:base */
.inventory-modal-box{max-width:1200px}.inventory-modal-box .modal-head p{margin:4px 0 0;color:#64748b}
    .inventory-search-row{display:flex;align-items:flex-end;gap:8px;padding:12px;border:1px solid #cbd9e9;border-radius:10px;background:#f7faff}.inventory-search-row .field{flex:1}
    .inventory-status{margin:10px 0;font-weight:700;color:#17365d}.inventory-table{max-height:58vh;overflow:auto;border:1px solid #cbd9e9;border-radius:10px}
    .inventory-table table{margin:0;min-width:950px}.inventory-table th{position:static;top:0;z-index:2}.inventory-table td{vertical-align:top;line-height:1.4}
    .inventory-match{display:inline-block;padding:4px 7px;border-radius:999px;font-size:10px;font-weight:800}.inventory-match.yes{background:#dcf3e4;color:#17623a}.inventory-match.no{background:#fff0bf;color:#805b00}
    .inventory-example-note{margin-top:12px}@media(max-width:700px){.inventory-search-row{align-items:stretch;flex-direction:column}.inventory-search-row>.btn{align-self:flex-start}}

/* source:base */
.request-cycle-rule{margin:0 0 12px;padding:11px 13px;border:1px solid #bfdbfe;border-left:5px solid #2563eb;border-radius:9px;background:#eff6ff;color:#17365d;font-size:12px;line-height:1.45}
.request-cycle-list{display:grid;gap:12px;margin-top:12px}
.request-cycle{border:1px solid #cbd5e1;border-radius:11px;background:#fff;overflow:hidden}
.request-cycle.current{border-color:#2563eb;box-shadow:0 0 0 2px rgba(37,99,235,.1)}
.request-cycle-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;padding:12px 14px;background:#f8fafc;border-bottom:1px solid #e2e8f0}
.request-cycle-title{font-weight:800;color:#17365d;font-size:14px}
.request-cycle-number{display:inline-flex;margin-left:7px;padding:3px 7px;border-radius:999px;background:#dbeafe;color:#1e3a8a;font-size:10px;vertical-align:middle}
.request-cycle-meta{display:grid;grid-template-columns:repeat(4,minmax(130px,1fr));gap:8px;padding:11px 14px;border-bottom:1px solid #e2e8f0;background:#fff}
.request-cycle-meta span{font-size:10px;color:#64748b;text-transform:uppercase;font-weight:700}
.request-cycle-meta b{display:block;margin-top:3px;color:#1f2937;font-size:12px;text-transform:none}
.request-cycle .timeline{margin:12px 14px}
.request-cycle-empty{padding:13px 14px;color:#64748b;font-size:12px}
.master-changes{margin-top:14px;padding-top:12px;border-top:1px solid #cbd5e1}
.master-changes summary{cursor:pointer;color:#17365d;font-weight:700}
@media(max-width:760px){.request-cycle-meta{grid-template-columns:1fr 1fr}.request-cycle-head{display:block}.request-cycle-head .req-state{display:inline-block;margin-top:7px}}

/* source:base */
/* PERFIL USUARIO · todas las tarjetas abren su listado */
#userPersonalKpis .kpi{
  cursor:pointer;
  transition:transform .12s ease,box-shadow .12s ease,border-color .12s ease;
}
#userPersonalKpis .kpi:hover{
  transform:translateY(-1px);
  box-shadow:0 5px 15px rgba(15,39,71,.08);
}
#userPersonalKpis .kpi.quick-active{
  box-shadow:0 0 0 2px #173f6b inset;
}
#userPersonalKpis .kpi:focus-visible{
  outline:2px solid #173f6b;
  outline-offset:2px;
}

/* source:v23-master-final-override */
