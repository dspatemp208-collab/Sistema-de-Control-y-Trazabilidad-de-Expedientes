body.produce-staff .app.role-user #userPersonalKpis #userKpiReassignedByCard,body.produce-staff .app.role-user #userPersonalKpis #userKpiReassignedToCard{background:#eae5ff!important;border-color:#dad3fd!important}#userKpiReassignedByCard .produce-kpi-icon,#userKpiReassignedToCard .produce-kpi-icon{background:#ddd3ff;color:#6214c9}
body.produce-staff .app.role-user #userPersonalKpis #userKpiReturnedCard{background:#dbfaec!important;border-color:#b9efda!important}#userKpiReturnedCard .produce-kpi-icon{background:#0ac66c;color:white}
body.produce-staff .app.role-user #userPersonalKpis #userKpiAlertCard{background:#ffe6e7!important;border-color:#ffcece!important}#userKpiAlertCard .produce-kpi-icon{background:#ffd2d9;color:#e6002e}
