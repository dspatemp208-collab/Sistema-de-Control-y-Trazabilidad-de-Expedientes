body.produce-user #tab-panel{padding-top:0!important;margin-top:0!important}
body.produce-user #ownerDetailFilters{display:grid!important;grid-template-columns:minmax(0,1.7fr) minmax(250px,1fr)!important;gap:20px!important;margin:0 0 10px!important;padding:10px 18px!important;border:1px solid #d9e7f6!important;border-radius:8px!important;background:#f8fbff!important;position:static!important}
body.produce-user #ownerSelectedUserField,body.produce-user #ownerBackWrap{display:none!important}
