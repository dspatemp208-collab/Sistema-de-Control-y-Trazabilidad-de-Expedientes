   ========================================================= */

/* En V32, DÍAS EN CUSTODIA corresponde a la columna 19 */
#allTable table.master-v19 th:nth-child(19),
#allTable table.master-v19 td:nth-child(19){
  min-width:72px !important;
  width:72px !important;
  max-width:72px !important;
  padding-left:4px !important;
  padding-right:4px !important;
  text-align:center !important;
  vertical-align:middle !important;
}

/* Encabezado más compacto */
#allTable table.master-v19 thead th:nth-child(19){
  font-size:9px !important;
  line-height:1.05 !important;
  white-space:normal !important;
  overflow-wrap:break-word !important;
  word-break:normal !important;
  padding-top:5px !important;
  padding-bottom:5px !important;
}

/* Valor numérico más compacto y centrado */
#allTable table.master-v19 td:nth-child(19){
  font-size:10px !important;
  font-weight:700 !important;
  white-space:nowrap !important;
}

/* Asegurar que la franja azul sticky conserve el mismo ancho */
#allTable table.master-v19 thead tr th:nth-child(19){
  min-width:72px !important;
  width:72px !important;
  max-width:72px !important;
}

/* source:v34-dias-custodia-como-dias-atencion */
/* =========================================================
   V34 · DÍAS EN CUSTODIA CON LAS MISMAS CARACTERÍSTICAS
   QUE DÍAS DE ATENCIÓN
   ========================================================= */

/* En V32/V33:
   col 14 = DÍAS DE ATENCIÓN
   col 19 = DÍAS EN CUSTODIA
*/

/* Igualar ancho real de DÍAS EN CUSTODIA al de DÍAS DE ATENCIÓN */
#allTable table.master-v19 th:nth-child(19),
#allTable table.master-v19 td:nth-child(19){
  min-width:85px !important;
  width:85px !important;
  max-width:85px !important;
  padding-left:4px !important;
  padding-right:4px !important;
  text-align:center !important;
  vertical-align:middle !important;
  box-sizing:border-box !important;
}

/* Encabezado con el mismo comportamiento compacto */
#allTable table.master-v19 thead th:nth-child(19){
  font-size:9px !important;
  line-height:1.05 !important;
  white-space:normal !important;
  overflow-wrap:break-word !important;
  word-break:normal !important;
  padding-top:5px !important;
  padding-bottom:5px !important;
}

/* Valor interno compacto, como el de DÍAS DE ATENCIÓN */
#allTable table.master-v19 td:nth-child(19){
  font-size:10px !important;
  font-weight:700 !important;
  white-space:nowrap !important;
}

/* Reforzar también en el encabezado sticky */
#allTable table.master-v19 thead tr th:nth-child(19){
  min-width:85px !important;
  width:85px !important;
  max-width:85px !important;
}

/* Uniformizar explícitamente DÍAS DE ATENCIÓN y DÍAS EN CUSTODIA */
#allTable table.master-v19 th:nth-child(14),
#allTable table.master-v19 td:nth-child(14),
#allTable table.master-v19 th:nth-child(19),
#allTable table.master-v19 td:nth-child(19){
  text-align:center !important;
  vertical-align:middle !important;
}

