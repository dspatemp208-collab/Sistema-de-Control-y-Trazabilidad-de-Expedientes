d=%22M4 17 C12 8,30 7,46 13 C53 15,58 17,65 17 C60 21,54 24,46 27 C31 32,12 29,4 21 Z%22 fill=%22#bfefff%22 fill-opacity=%220.35%22/%3E%0A    %3Cpath d=%22M63 17 L77 8 L74 17 L78 26 L63 21 Z%22 fill=%22#bfefff%22 fill-opacity=%220.35%22/%3E%0A  %3C/g%3E%0A%3C/defs%3E%0A%3Crect width=%221200%22 height=%22120%22 fill=%22none%22/%3E%0A%3Cg%3E%0A  %3Cuse href=%22#fishBig%22 x=%2260%22 y=%225%22/%3E%0A  %3Cuse href=%22#fishMed%22 x=%22318%22 y=%2240%22/%3E%0A  %3Cuse href=%22#fishSmall%22 x=%22454%22 y=%2220%22/%3E%0A  %3Cuse href=%22#fishSmall%22 x=%22525%22 y=%2256%22/%3E%0A  %3Cuse href=%22#fishBig%22 x=%22578%22 y=%2212%22/%3E%0A  %3Cuse href=%22#fishMed%22 x=%22889%22 y=%2216%22/%3E%0A  %3Cuse href=%22#fishSmall%22 x=%221028%22 y=%2255%22/%3E%0A  %3Cuse href=%22#fishMed%22 x=%221080%22 y=%2234%22/%3E%0A%3C/g%3E%0A%3Cg fill=%22#ffffff%22 fill-opacity=%220.18%22%3E%0A  %3Ccircle cx=%22286%22 cy=%2224%22 r=%225%22/%3E%0A  %3Ccircle cx=%22296%22 cy=%2212%22 r=%223%22/%3E%0A  %3Ccircle cx=%22744%22 cy=%2218%22 r=%226%22/%3E%0A  %3Ccircle cx=%22757%22 cy=%225%22 r=%223.5%22/%3E%0A  %3Ccircle cx=%221015%22 cy=%2222%22 r=%224%22/%3E%0A  %3Ccircle cx=%221030%22 cy=%2210%22 r=%222.5%22/%3E%0A%3C/g%3E%0A%3C/svg%3E");
  background-repeat:repeat-x;
  background-position:center center;
  background-size:900px 90px;
  opacity:1;
  filter:drop-shadow(0 0 8px rgba(255,255,255,.08));
  z-index:0;
  pointer-events:none;
}
.produce-top::after{
  content:"";
  position:absolute;
  left:193px;
  right:0;
  top:0;
  bottom:0;
  background:
    linear-gradient(180deg,rgba(255,255,255,.10),rgba(255,255,255,0) 42%),
    radial-gradient(circle at 72% 20%, rgba(255,255,255,.10), transparent 22%),
    radial-gradient(circle at 30% 74%, rgba(255,255,255,.07), transparent 18%);
  z-index:1;
  pointer-events:none;
}
.produce-top > *{position:relative;z-index:2}
.produce-brand{background:#ce0028 !important;z-index:3 !important}
.produce-org,.produce-account{position:relative;z-index:3}
@media(max-width:1050px){
  .produce-top::before,.produce-top::after{left:150px;}
}
@media(max-width:700px){
  .produce-top::before,.produce-top::after{left:120px;}
  .produce-top::before{background-size:760px 76px;}
}

/* source:v202-admin-solicitudes-abogado */
/* V202 · Solo Administrador */
body.produce-staff .app.role-admin #tab-requestsByLawyer .v202-lawyer-filters{
  grid-template-columns:minmax(280px,1.6fr) minmax(250px,.9fr) minmax(340px,1.2fr);
  align-items:end;
}

.v202-lawyer-toolbar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin:0 0 10px;
  flex-wrap:wrap;
}

.v202-lawyer-chip-wrap{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
}

.v202-lawyer-chip{
  border:1px solid #c8d8ea;
  border-radius:999px;
  background:#fff;
  color:#19446f;
  padding:7px 11px;
  font-size:11px;
  font-weight:800;
  cursor:pointer;
}

.v202-lawyer-chip.active{
  background:#145f9f;
  color:#fff;
  border-color:#145f9f;
}

.v202-lawyer-summary{
  color:#536b84;
  font-size:11px;
  padding:6px 10px;
  background:#f5f9fd;
  border:1px solid #d4e1ef;
  border-radius:8px;
}

body.produce-staff .app.role-admin #lawyerRequestsGrid{
  grid-template-columns:repeat(auto-fill,minmax(250px,1fr));
}

body.produce-staff .app.role-admin #lawyerRequestsGrid .lawyer-card{
  position:relative;
  transition:.15s ease;
}

body.produce-staff .app.role-admin #lawyerRequestsGrid .lawyer-card:hover{
  transform:translateY(-1px);
  box-shadow:0 7px 18px rgba(20,75,120,.10);
}

body.produce-staff .app.role-admin #lawyerRequestsGrid .v202-priority-pending{
  border-color:#efc66e;
  background:#fffaf0;
}

body.produce-staff .app.role-admin #lawyerRequestsGrid .v202-priority-high{
  border-color:#e69663;
  background:#fff5ee;
  box-shadow:inset 4px 0 0 #e6752f;
}

body.produce-staff .app.role-admin #lawyerRequestsGrid .v202-priority-partial{
  border-color:#d9c8ed;
  background:#fbf8ff;
}

.v202-priority-badge{
  position:absolute;
  top:8px;
  right:8px;
  padding:3px 7px;
  border-radius:999px;
  background:#fff0cf;
  color:#8a5900;
  border:1px solid #edc46d;
  font-size:8px;
  line-height:1;
  font-weight:900;
}

.v202-priority-high .v202-priority-badge{
  background:#ffe2d0;
  color:#9a3f0b;
  border-color:#efaa7f;
}

.v202-lawyer-card-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  padding-right:68px;
}

.v202-lawyer-card-head h3{
  margin-bottom:6px!important;
}

.v202-active-count{
  font-size:9px;
  font-weight:800;
  color:#587089;
  white-space:nowrap;
}

.v202-stat-alert{
  color:#8a5900!important;
}

.v202-stat-alert b{
  color:#a85e00!important;
}

.v202-stat-partial{
  color:#694596!important;
}

.v202-stat-partial b{
  color:#694596!important;
}

.v202-pending-btn{
  background:#145f9f!important;
}

@media(max-width:1050px){
  body.produce-staff .app.role-admin #tab-requestsByLawyer .v202-lawyer-filters{
    grid-template-columns:1fr 1fr;
  }
  body.produce-staff .app.role-admin #tab-requestsByLawyer .v202-lawyer-filters .note{
    grid-column:1 / -1;
  }
}

@media(max-width:700px){
  body.produce-staff .app.role-admin #tab-requestsByLawyer .v202-lawyer-filters{
    grid-template-columns:1fr;
  }
}

/* source:v203-admin-buscador-abogados-corregido */
/* V203 · Corrección exclusiva del perfil ADMINISTRADOR.
   El buscador de Solicitudes por abogado vuelve al flujo normal y
   deja de superponerse a las tarjetas al desplazarse. */
body.produce-staff .app.role-admin #tab-requestsByLawyer > .v202-lawyer-filters{
  position:relative!important;
  top:auto!important;
  z-index:auto!important;
  margin:0 0 10px!important;
  width:100%!important;
}

/* Los accesos rápidos quedan inmediatamente debajo del buscador. */
body.produce-staff .app.role-admin #tab-requestsByLawyer .v202-lawyer-toolbar{
  position:relative;
  z-index:1;
  margin:0 0 10px!important;
}

/* Las tarjetas comienzan siempre después del buscador y filtros. */
body.produce-staff .app.role-admin #tab-requestsByLawyer #lawyerRequestsGrid{
  position:relative;
  z-index:0;
  clear:both;
}

.v203-lawyer-search-wrap{
  position:relative;
}

.v203-lawyer-search-wrap input{
  padding-right:36px!important;
}

.v203-lawyer-clear{
  position:absolute;
  top:50%;
  right:7px;
  transform:translateY(-50%);
  width:25px;
  height:25px;
  padding:0;
  border:0;
  border-radius:6px;
  background:#eaf1f8;
  color:#244c73;
  font-size:18px;
  line-height:25px;
  cursor:pointer;
}

.v203-lawyer-clear:hover{
  background:#dce9f5;
}

/* Mantener todo compacto sin invadir las tarjetas. */
body.produce-staff .app.role-admin #tab-requestsByLawyer .v202-lawyer-filters{
  padding:9px 10px!important;
  gap:8px!important;
}

body.produce-staff .app.role-admin #tab-requestsByLawyer .v202-lawyer-filters .note{
  min-height:36px;
  display:flex;
  align-items:center;
}

/* En escritorio ancho: búsqueda y prioridad alineadas. */
@media(min-width:1051px){
  body.produce-staff .app.role-admin #tab-requestsByLawyer .v202-lawyer-filters{
    grid-template-columns:minmax(320px,1.5fr) minmax(240px,.7fr) minmax(360px,1fr)!important;
  }
}

/* source:v204-coordinador-piloto */
/* V204 · Perfil COORDINADOR (piloto)
   Durante la prueba, MARCELA ALONZO usa las mismas autorizaciones
   de ARCHIVO en Supabase/PostgreSQL, pero el sistema la identifica
   visualmente como COORDINADOR. */
.app.role-coordinator .main{
  background:
    linear-gradient(180deg,#f4f9ff 0,#edf5fb 46%,#e9f1f7 100%)!important;
}

.app.role-coordinator #currentRole{
  color:#0f5f93;
  font-weight:900;
}

.coordinator-pilot-note{
  display:inline-flex;
  align-items:center;
  gap:5px;
  margin-left:5px;
  padding:2px 7px;
  border-radius:999px;
  background:#e8f4ff;
  border:1px solid #b9d9ee;
  color:#0f5f93;
  font-size:9px;
  font-weight:900;
  white-space:nowrap;
}

/* source:v205-coordinador-gestion */
/* V205 · Restricciones visuales del Coordinador de Gestión */
.app.role-coordinator #tab-summary,
.app.role-coordinator #tab-all,
.app.role-coordinator #tab-cargos,
.app.role-coordinator #tab-history{
  display:none!important;
}

.app.role-coordinator #ownerCardsPanel .owner-cards-head{
  border-left:4px solid #2d78b3;
  padding-left:10px;
}

.app.role-coordinator #ownerCardsPanel .owner-user-card{
  background:linear-gradient(145deg,#fbfdff,#edf7ff)!important;
  border-color:#c9dff0!important;
}

.app.role-coordinator #ownerCardsPanel .owner-user-card::after{
  content:"GESTIÓN";
  display:inline-flex;
  margin-top:8px;
  padding:2px 7px;
  border-radius:999px;
  background:#e8f4ff;
  color:#0f5f93;
  font-size:8px;
  font-weight:900;
  width:max-content;
}

/* source:v206-coordinador-hibrido */
/* V206 · Coordinador híbrido:
   SELF = el mismo espacio personal de Marcela como USUARIO.
   TEAM = seguimiento exclusivo de Milton Diaz y Joan Valdivieso. */

.produce-nav .coordinator-team-nav-v206{
  border-left:3px solid transparent;
}

.produce-nav .coordinator-team-nav-v206.active{
  border-left-color:#7ec8ff;
}

body.produce-coordinator-self .app.role-coordinator #userPersonalKpis{
  display:grid!important;
}

body.produce-coordinator-self .app.role-coordinator #fullAccessKpis,
body.produce-coordinator-self .app.role-coordinator #ownerCardsPanel{
  display:none!important;
}

body.produce-coordinator-self .app.role-coordinator #panelDetailWrap,
body.produce-coordinator-self .app.role-coordinator #ownerDetailFilters{
  display:block;
}

body.produce-coordinator-self .app.role-coordinator #ownerDetailFilters{
  display:grid!important;
}

/* Reutiliza el lenguaje visual del perfil usuario también con role-coordinator. */
body.produce-coordinator-self #userPersonalKpis{
  grid-template-columns:repeat(4,minmax(0,1fr))!important;
  gap:10px!important;
  margin:0 0 12px!important;
}

body.produce-coordinator-self #userPersonalKpis .kpi{
  position:relative!important;
  min-height:100px!important;
  padding:14px 12px 10px 94px!important;
  border:1px solid #bcd9fc!important;
  border-radius:13px!important;
  background:#deeeff!important;
}

body.produce-coordinator-self #userPersonalKpis .kpi .label{
  font-size:12px!important;
  font-weight:800!important;
  color:#061650!important;
}

body.produce-coordinator-self #userPersonalKpis .kpi .value{
  font-size:34px!important;
  font-weight:800!important;
  color:#061541!important;
  margin-top:2px!important;
}

body.produce-coordinator-self #userPersonalKpis .kpi-view{
  font-size:13px!important;
  color:#0054ff!important;
  text-decoration:none!important;
}

body.produce-coordinator-self #userPersonalKpis #userKpiPendingAttentionCard{
  background:#fff8d9!important;
  border-color:#ffe7a8!important;
}

body.produce-coordinator-self #userPersonalKpis #userKpiReturnRequestedCard{
  background:#fff0df!important;
  border-color:#ffe0b9!important;
}

body.produce-coordinator-self #userPersonalKpis #userKpiReassignedByCard,
body.produce-coordinator-self #userPersonalKpis #userKpiReassignedToCard{
  background:#eae5ff!important;
  border-color:#dad3fd!important;
}

body.produce-coordinator-self #userPersonalKpis #userKpiReturnedCard{
  background:#dbfaec!important;
  border-color:#b9efda!important;
}

body.produce-coordinator-self #userPersonalKpis #userKpiAlertCard{
  background:#ffe6e7!important;
  border-color:#ffcece!important;
}

/* Identificación de la parte supervisora. */
body.produce-coordinator-team #ownerCardsPanel{
  border-top:3px solid #2d78b3;
}

body.produce-coordinator-team #ownerCardsPanel::before{
  content:"SEGUIMIENTO DEL EQUIPO · GESTIÓN";
  display:block;
  margin:0 0 9px;
  color:#0f5f93;
  font-size:10px;
  font-weight:900;
  letter-spacing:.04em;
}

/* En el espacio personal no mostrar controles de Archivo. */
body.produce-coordinator-self #custodyIncorporateBtn,
body.produce-coordinator-self #archiveNewRequestBtn,
body.produce-coordinator-self #cargoBtn{
  display:none!important;
}

@media(max-width:1050px){
  body.produce-coordinator-self #userPersonalKpis{
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
  }
}

@media(max-width:700px){
  body.produce-coordinator-self #userPersonalKpis{
    grid-template-columns:1fr!important;
  }
}

/* source:v207-coordinador-personal-corregido */
/* V207 · El espacio personal de Marcela mantiene la interfaz de USUARIO,
   pero las lecturas provienen del alcance ARCHIVO filtrado por su nombre. */
body.produce-coordinator-self #panelTable > .empty{
  color:#536b84;
  font-weight:600;
}

body.produce-coordinator-self .produce-nav button[data-destination="all"]{
  display:none!important;
}

/* source:v208-coordinador-solo-seguimiento */
/* V208 · Solicitudes del equipo: el Coordinador es supervisor,
   no operador de Archivo. */
body.produce-coordinator-team #requestsTable .btn{
  background:#f8fbff!important;
  color:#174c8a!important;
  border:1px solid #c8d9e8!important;
}

body.produce-coordinator-team #requestsTable .btn:hover{
  background:#edf5fc!important;
}

.v208-coordinator-readonly-note{
  display:block;
  width:100%;
  border-left:4px solid #2d78b3!important;
  background:#eef7ff!important;
  color:#36566f!important;
}

/* En modo equipo no mostrar controles de atención aunque quedara
   alguna referencia residual del perfil Archivo. */
body.produce-coordinator-team #rqAttentionSection{
  display:none!important;
}

/* source:v209-coordinador-solo-consulta */
/* V209 · COORDINADOR = consulta y seguimiento.
   No es operador de Archivo. */

body.produce-coordinator #requestsTable .btn{
  background:#f8fbff!important;
  color:#174c8a!important;
  border:1px solid #c8d9e8!important;
}

body.produce-coordinator .user-manage-action{
  display:none!important;
}

body.produce-coordinator #requestDetailModal input,
body.produce-coordinator #requestDetailModal select,
body.produce-coordinator #requestDetailModal textarea{
  pointer-events:none;
}

body.produce-coordinator #rqAttentionSection{
  display:none!important;
}

/* source:v210-coordinador-gestion-solo-conas */
/* V210 · Perfil Coordinador de Gestión:
   conserva CONAS, pero no Estados, DVC ni Instrucción. */
body.produce-coordinator .produce-nav button[data-destination="states"],
body.produce-coordinator .produce-nav button[data-destination="dvc"],
body.produce-coordinator .produce-nav button[data-destination="instruction"]{
  display:none!important;
}

.app.role-coordinator #tab-states,
.app.role-coordinator #tab-dvc,
.app.role-coordinator #tab-instruction{
  display:none!important;
}

/* source:v211-coordinador-multi-area */
/* V211 · administración de equipos */
.v211-team-modal-box{
  max-width:900px!important;
}

.v211-team-config,
.v211-team-add{
  display:grid;
  grid-template-columns:minmax(260px,1fr) auto;
  gap:10px;
  align-items:end;
  margin:12px 0;
  padding:12px;
  border:1px solid var(--line);
  border-radius:10px;
  background:#f8fbff;
}

body.produce-coordinator #conasSelectedCount,
body.produce-coordinator #conasReturnBtn{
  display:none!important;
}

body.produce-coordinator #tab-conas .note{
  border-left:4px solid #2d78b3;
}

body.produce-coordinator #tab-conas .note::after{
  content:" Perfil COORDINADOR: vista de consulta y seguimiento; no registra devoluciones.";
  font-weight:800;
  color:#0f5f93;
}


/* V336 · Usuarios del área GESTIÓN y su coordinador ven CONAS en modo consulta. */
body.produce-gestion-conas-readonly #conasSelectedCount,
body.produce-gestion-conas-readonly #conasReturnBtn{
  display:none!important;
}
body.produce-gestion-conas-readonly #tab-conas .conas-table-scroll table tbody tr{
  cursor:default!important;
}

/* El nombre del área viene ahora de Supabase; no se imprime una etiqueta fija. */
body.produce-coordinator-team #ownerCardsPanel::before{
  content:"SEGUIMIENTO DEL EQUIPO";
}

@media(max-width:700px){
  .v211-team-config,
  .v211-team-add{
    grid-template-columns:1fr;
  }
}

/* source:v214-coordinador-datos-equipo */
/* V214 · Evitar que una respuesta RPC mal formada se vea como una fila vacía. */
body.produce-coordinator-team #panelTable td:empty::after{
  content:"—";
  color:#8ba0b4;
}

body.produce-coordinator-team #panelTable .v214-data-warning{
  color:#b42318;
  font-weight:800;
}

/* source:v215-coordinador-total-custodia */
.v215-empty-state{
  padding:34px 20px!important;
}

.v215-empty-state > b{
  display:block;
  margin-bottom:6px;
  color:#35536f;
  font-size:15px;
}

.v215-empty-hint{
  max-width:720px;
  margin:5px auto 12px;
  color:#667f96;
  line-height:1.45;
}

body.produce-coordinator-team #ownerStateFilter{
  font-weight:700;
}

/* source:v216-numeros-expedientes */
.v216-exp-number-strip{
  display:flex;
  align-items:flex-start;
  gap:10px;
  flex-wrap:wrap;
  padding:10px 12px;
  margin:0 0 8px;
  border:1px solid #c9dced;
  border-radius:9px;
  background:#f8fbff;
}

.v216-exp-number-title{
  color:#193e65;
  font-size:11px;
  line-height:26px;
  white-space:nowrap;
}

.v216-exp-number-list{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
}

.v216-exp-chip{
  display:inline-flex;
  align-items:center;
  gap:5px;
  padding:4px 8px;
  border:1px solid #b8d2e8;
  border-radius:999px;
  background:#ffffff;
  color:#0a3764;
  font-size:11px;
  font-weight:800;
}

.v216-exp-index{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:18px;
  height:18px;
  border-radius:50%;
  background:#e2f1ff;
  color:#135f9c;
  font-size:9px;
}

body.produce-coordinator-team #panelTable table td:nth-child(2){
  font-size:12px;
  font-weight:900;
  color:#072f59;
}

/* source:v217-coordinador-carga-inmediata */
/* COORDINADOR: no ejecuta operaciones de Archivo. */
body.produce-coordinator #custodyIncorporateBtn{
  display:none!important;
}

.v217-coordinator-table-wrap{
  overflow:auto;
  max-height:520px;
  border:1px solid #d2e0ec;
  border-radius:8px;
  background:#fff;
}

.v217-coordinator-table{
  width:100%;
  border-collapse:collapse;
  min-width:1050px;
}

.v217-coordinator-table th{
  position:static;
  top:0;
  z-index:2;
  background:#e9f3fc;
  color:#173f67;
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:.02em;
}

.v217-coordinator-table th,
.v217-coordinator-table td{
  padding:8px 9px;
  border-bottom:1px solid #d9e5ef;
  border-right:1px solid #e3ebf3;
  vertical-align:middle;
}

.v217-coordinator-table td{
  font-size:11px;
  color:#16324d;
}

.v217-coordinator-table tbody tr:hover{
  background:#f6fbff;
}

.v217-state{
  display:inline-flex;
  padding:3px 7px;
  border-radius:999px;
  background:#eef4fa;
  font-size:9px;
  font-weight:900;
  white-space:nowrap;
}

.v217-timeout{
  padding:35px 20px!important;
}

.v217-timeout b{
  display:block;
  margin-bottom:6px;
  color:#9b3c2d;
}

.v217-timeout .btn{
  margin-top:12px;
}

/* source:v218-coordinador-rpc-directa */
body.produce-coordinator-team #panelTitle::after{
  content:" · consulta segura de custodia";
  margin-left:4px;
  color:#66839d;
  font-size:10px;
  font-weight:600;
}

.v218-source-note{
  margin-top:6px;
  color:#66839d;
  font-size:10px;
}

/* source:v219-coordinador-pendientes-equipo */
body.produce-coordinator-team #panelTable .v217-coordinator-table-wrap{
  margin-top:4px;
}

body.produce-coordinator-team #panelTitle{
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
}

body.produce-coordinator-team #panelTitle::after{
  content:"";
  display:none;
}

/* source:v220-pendientes-reales */
.v220-pending-table th:nth-child(2),
.v220-pending-table td:nth-child(2){
  min-width:125px;
}

.v220-pending-table th:nth-child(7),
.v220-pending-table td:nth-child(7){
  min-width:190px;
}

body.produce-coordinator-team .v220-pending-table tbody tr:hover{
  background:#f4f9fe;
}

/* source:v221-dias-custodia */
.v221-custody-days{
  display:inline-flex;
  align-items:baseline;
  gap:4px;
  min-width:74px;
  padding:4px 7px;
  border-radius:8px;
  background:#eef6ff;
  border:1px solid #cfe1f3;
  color:#173f67;
  white-space:nowrap;
}

.v221-custody-days b{
  font-size:14px;
  color:#052f5f;
}

.v221-custody-days span{
  font-size:9px;
  font-weight:700;
}

.v221-custody-days.over-30{
  background:#fff0f0;
  border-color:#ffc7c7;
  color:#b42318;
}

.v221-custody-days.over-30 b{
  color:#b42318;
}

/* En Usuario y Coordinador la columna debe quedar cerca del Estado. */
body.produce-user #panelTable th,
body.produce-coordinator-team #panelTable th{
  vertical-align:middle;
}

body.produce-user #panelTable td,
body.produce-coordinator-team #panelTable td{
  vertical-align:middle;
}

/* source:v222-coordinador-devueltos */
body.produce-coordinator-team .historical-returner-name b{
  color:#173f67;
}

body.produce-coordinator-team .historical-return-accepted-at{
  white-space:nowrap;
}

body.produce-coordinator-team .v222-return-empty{
  padding:36px 20px!important;
}

body.produce-coordinator-team .v222-return-empty > b{
  display:block;
  margin-bottom:7px;
  color:#9b3c2d;
  font-size:14px;
}

/* source:v223-coordinador-tarjetas-unificadas */
body.produce-coordinator-self #panelTable .empty,
body.produce-coordinator-team #panelTable .empty{
  line-height:1.45;
}

body.produce-coordinator-self #panelTable .v221-custody-days,
body.produce-coordinator-team #panelTable .v221-custody-days{
  min-width:82px;
}

/* source:v225-datos-completos-coordinador */
.v225-complete-wrap{
  width:100%;
  max-height:540px;
  overflow:auto;
  border:1px solid #cbddec;
  border-radius:9px;
  background:#fff;
}

.v225-complete-table{
  width:max-content;
  min-width:100%;
  border-collapse:collapse;
  table-layout:auto;
}

.v225-complete-table th{
  position:static;
  top:0;
  z-index:3;
  background:#e9f3fc;
  color:#173f67;
  font-size:9px;
  text-transform:uppercase;
  letter-spacing:.025em;
  white-space:nowrap;
  padding:8px 9px;
  border-right:1px solid #d6e3ee;
  border-bottom:1px solid #c5d8e7;
}

.v225-complete-table td{
  padding:8px 9px;
  border-right:1px solid #e0e9f1;
  border-bottom:1px solid #dce7f0;
  vertical-align:top;
  font-size:10px;
  color:#18354f;
  min-width:80px;
}

.v225-complete-table tbody tr:hover td{
  background:#f6fbff;
}

.v225-exp-number{
  min-width:105px;
  font-size:11px;
  color:#072f59;
}

.v225-wide{
  min-width:185px!important;
  max-width:260px;
}

.v225-wrap-text{
  white-space:normal;
  line-height:1.35;
  word-break:break-word;
}

.v225-stack{
  display:flex;
  flex-direction:column;
  gap:5px;
  min-width:120px;
  white-space:normal;
}

.v225-stack span{
  display:block;
  line-height:1.3;
}

.v225-stack small{
  display:block;
  color:#6d8297;
  font-size:8px;
  font-weight:800;
  text-transform:uppercase;
  margin-bottom:1px;
}

.v225-stack a{
  color:#0563c1;
  font-weight:800;
  text-decoration:none;
}

.v225-dates{
  min-width:145px;
}

body.produce-coordinator #panelTable{
  overflow:visible!important;
}

body.produce-coordinator .v225-complete-wrap .v221-custody-days{
  min-width:82px;
}

@media(max-width:900px){
  .v225-complete-wrap{
    max-height:500px;
  }
}

/* source:v226-fecha-ultimo-movimiento */
.v225-complete-table th:nth-child(11),
.v225-complete-table td:nth-child(11){
  min-width:145px;
  white-space:nowrap;
}

.v226-last-date{
  font-weight:800;
  color:#173f67!important;
}

/* source:v227-solo-tabla-expedientes */
/* V227 · En las vistas del Coordinador se omite el listado superior
   de chips con números de expediente. La información queda únicamente
   en el cuadro/tablero principal. */
body.produce-coordinator .v216-exp-number-strip{
  display:none!important;
}

body.produce-coordinator .v225-complete-wrap,
body.produce-coordinator .v217-coordinator-table-wrap{
  margin-top:0!important;
}

/* source:v228-cuadros-expedientes-mas-grandes */
/* =========================================================
   V228 · MÁS ALTURA PARA LOS LISTADOS DE EXPEDIENTES
   ========================================================= */

/* El contenedor general deja de recortar prematuramente la tabla. */
body.produce-coordinator #panelDetailWrap,
body.produce-user #panelDetailWrap{
  max-height:none!important;
  min-height:500px!important;
  overflow:hidden!important;
}

/* El área que realmente desplaza las filas ocupa una mayor parte de pantalla. */
body.produce-coordinator #panelTable,
body.produce-user #panelTable{
  height:clamp(480px,68vh,780px)!important;
  max-height:clamp(480px,68vh,780px)!important;
  min-height:480px!important;
  overflow:auto!important;
  scrollbar-gutter:stable both-edges;
  overscroll-behavior:contain;
}

/* Tablas completas del Coordinador: mismo alto que el panel principal. */
body.produce-coordinator .v225-complete-wrap,
body.produce-coordinator .v217-coordinator-table-wrap{
  height:clamp(450px,64vh,740px)!important;
  max-height:clamp(450px,64vh,740px)!important;
  min-height:450px!important;
  overflow:auto!important;
}

/* Cabecera de columnas siempre visible durante el desplazamiento. */
body.produce-coordinator #panelTable table thead th,
body.produce-user #panelTable table thead th,
body.produce-coordinator .v225-complete-table thead th,
body.produce-coordinator .v217-coordinator-table thead th{
  position:static!important;
  top:0!important;
  z-index:40!important;
}

/* Aprovechar un poco mejor el espacio vertical sin volver ilegible la tabla. */
body.produce-coordinator .v225-complete-table td{
  padding-top:7px!important;
  padding-bottom:7px!important;
}

/* Pantallas de altura media. */
@media(max-height:850px){
  body.produce-coordinator #panelTable,
  body.produce-user #panelTable{
    height:58vh!important;
    max-height:58vh!important;
    min-height:360px!important;
  }

  body.produce-coordinator .v225-complete-wrap,
  body.produce-coordinator .v217-coordinator-table-wrap{
    height:55vh!important;
    max-height:55vh!important;
    min-height:340px!important;
  }

  body.produce-coordinator #panelDetailWrap,
  body.produce-user #panelDetailWrap{
    min-height:390px!important;
  }
}

/* Pantallas pequeñas: mantener desplazamiento funcional sin ocupar
   más alto que la ventana. */
@media(max-height:700px){
  body.produce-coordinator #panelTable,
  body.produce-user #panelTable{
    height:54vh!important;
    max-height:54vh!important;
    min-height:300px!important;
  }

  body.produce-coordinator .v225-complete-wrap,
  body.produce-coordinator .v217-coordinator-table-wrap{
    height:51vh!important;
    max-height:51vh!important;
    min-height:280px!important;
  }
}

/* source:v229-buscador-ambito-coordinador */
