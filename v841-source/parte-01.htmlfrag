/* Institutional layout shared with administrator and archive. */
body.produce-staff .produce-nav{display:block}
.produce-nav button[hidden]{display:none!important}
body.produce-staff .main-sticky-header{position:relative!important;top:auto!important}
body.produce-ui.produce-staff .main-sticky-header{position:relative!important;top:0!important;left:auto!important;right:auto!important}
body.produce-ui.produce-staff .main-sticky-header .actions>.btn:not(.hidden-by-role){flex:0 1 auto!important;height:42px!important;padding:9px 13px!important;font-size:13px!important}
body.produce-staff .app>.sidebar{display:none!important}
body.produce-staff .main-sticky-header .actions .btn{flex:0 1 auto!important;height:42px!important;padding:9px 13px!important;font-size:13px!important}
body.produce-staff .main-sticky-header .actions #newRecordBtn,body.produce-staff .main-sticky-header .actions #custodyIncorporateBtn{background:#176bff!important;color:white!important;border-color:#1261ed!important}
body.produce-staff #toolbarLogoutBtn,body.produce-staff #alertsBtn,body.produce-staff #sidebarToggleBtn{display:none!important}
body.produce-staff .main-sticky-header .actions #configBtn:not(.hidden-by-role){display:inline-flex!important;align-items:center;gap:5px}
body.produce-staff #selectedCount{display:inline-flex!important;align-items:center;font-size:12px;background:#e7f2ff;border:1px solid #c6dcf5;border-radius:7px;padding:8px 12px;color:#12497d}
body.produce-staff .main-sticky-header .tabs .tab:not(.hidden-by-role){min-width:0!important;width:auto!important;padding:10px 16px!important;font-size:13px!important}
body.produce-staff #ownerDetailFilters{grid-template-columns:minmax(150px,1fr) minmax(220px,1.8fr) minmax(180px,1fr) auto!important}
body.produce-staff #ownerDetailFilters.hidden{display:none!important}
body.produce-staff #ownerSelectedUserField:not(.hidden-by-role){display:block!important}
body.produce-staff #ownerBackWrap:not(.hidden){display:flex!important}
body.produce-staff #ownerSelectedUserField.hidden-by-role,body.produce-staff #ownerBackWrap.hidden{display:none!important}
body.produce-staff .main section .card{border-color:#d0e2f5!important;box-shadow:none!important;border-radius:10px!important}
body.produce-staff .main .table-head{background:#f9fcff!important;color:#102f69!important;border-bottom:1px solid #dbe8f6!important;padding:12px 16px!important}
body.produce-staff .main .table-head strong{font-size:17px!important}
body.produce-staff .owner-cards-grid{gap:15px!important;grid-template-columns:repeat(3,minmax(0,1fr))!important}
body.produce-staff .owner-user-card{border:1px solid #cbdff5!important;border-radius:13px!important;background:linear-gradient(145deg,#fafdff,#eaf4ff)!important;box-shadow:0 4px 12px #164f8508!important;overflow:hidden}
body.produce-staff .state-grid{gap:12px!important;grid-template-columns:repeat(4,minmax(0,1fr))!important}
body.produce-staff .state-card{padding:16px!important;border:1px solid #c7def8!important;border-radius:13px!important;background:#e2efff!important;color:#09275f!important;box-shadow:none!important}
body.produce-staff .state-card:nth-child(2){background:#def8eb!important;border-color:#bdebd7!important}
body.produce-staff .state-card:nth-child(3){background:#fff6d8!important;border-color:#ffe3a2!important}
body.produce-staff .state-card:nth-child(4){background:#fff0df!important;border-color:#ffe0b9!important}
body.produce-staff .state-card.selected{outline:2px solid #1c64bb!important;outline-offset:-2px!important}
body.produce-staff #fullAccessKpis.owner-user-kpis,body.produce-staff .summary-grid{gap:12px!important}
body.produce-staff #fullAccessKpis .kpi{background:#e3f0ff!important;border:1px solid #c5dcf7!important;border-radius:12px!important;padding:16px!important;color:#09275f!important}
body.produce-staff #fullAccessKpis .card-pending{background:#fff6d8!important}
body.produce-staff #fullAccessKpis .card-returned{background:#def8eb!important}
body.produce-staff #fullAccessKpis .kpi .value{font-size:32px!important;line-height:1.1!important}
body.produce-staff .main section table:not(.master-v19) thead th{background:#eaf3fd!important;color:#365b8e!important;border-color:#d5e5f5!important;font-size:12px!important;padding:10px!important;line-height:1.35!important}
body.produce-staff .main section table:not(.master-v19) tbody td{border-color:#dbe7f5!important;font-size:12px!important;padding:9px!important;line-height:1.35!important}
body.produce-staff .main section table:not(.master-v19) tbody tr:nth-child(even)>td{background:#f1f7ff!important}
