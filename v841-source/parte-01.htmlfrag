}

.v229-search-table{
  width:max-content;
  min-width:100%;
  border-collapse:collapse;
}

.v229-search-table th{
  position:static;
  top:0;
  z-index:5;
  padding:8px 9px;
  border-right:1px solid #d7e3ed;
  border-bottom:1px solid #c8d9e7;
  background:#e9f3fc;
  color:#173f67;
  font-size:9px;
  text-transform:uppercase;
  white-space:nowrap;
}

.v229-search-table td{
  padding:8px 9px;
  border-right:1px solid #e0e9f1;
  border-bottom:1px solid #dce7f0;
  vertical-align:middle;
  font-size:10px;
  color:#18354f;
}

.v229-search-table tbody tr:hover td{
