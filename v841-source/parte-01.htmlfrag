body.produce-staff .main-sticky-header .actions>.btn:not(.hidden-by-role){display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:12px!important;height:48px!important;padding:10px 14px!important;min-width:0!important;flex:1 1 auto!important;background:#fbfdff!important;color:#00308e!important;border:1px solid #cbdff5!important;border-radius:8px!important;font-size:14px!important;font-weight:700!important;white-space:nowrap!important;box-shadow:0 3px 9px #32639907!important}
