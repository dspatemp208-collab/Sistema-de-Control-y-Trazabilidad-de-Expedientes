body.produce-staff #selectedCount{display:none!important}
body.produce-staff .statusbar,body.produce-staff #connectionBar{padding:8px 16px!important;border:1px solid #d4e6f8!important;border-radius:6px!important;min-height:32px!important;font-size:12px!important;margin:8px 0!important;background:#ffffff80!important}
body.produce-staff .tabs{display:flex!important;gap:9px!important;overflow:auto!important;margin:12px 0 0!important;padding:0!important;background:none!important;border:0!important;box-shadow:none!important}
body.produce-staff .tabs:after{display:none!important}
body.produce-staff .main-sticky-header .tabs .tab:not(.hidden-by-role){min-width:210px!important;flex:0 0 auto!important;margin:0!important;padding:11px 28px!important;border:1px solid #cddff0!important;border-radius:7px!important;background:#f9fcff!important;color:#00308e!important;font-size:14px!important;text-align:center!important}
