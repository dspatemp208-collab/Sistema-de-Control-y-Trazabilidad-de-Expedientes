body.produce-staff .sidebar .brand,body.produce-staff .sidebar .side-title{color:#17385e!important}
body.produce-staff .sidebar .side-item{color:#123b69!important;background:#fff!important;border:1px solid #d6e5f5!important;margin-bottom:5px!important;border-radius:7px!important}
body.produce-staff .sidebar .side-item.active{background:#d9ebff!important;border-color:#548bca!important}
@media(max-width:1450px){body.produce-staff .owner-cards-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}body.produce-staff #ownerDetailFilters{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
@media(max-width:1050px){body.produce-staff .state-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}body.produce-staff.produce-directory-open .app>.sidebar{left:200px!important}}
@media(max-width:700px){body.produce-staff .produce-nav{display:flex!important}body.produce-staff .owner-cards-grid,body.produce-staff #ownerDetailFilters{grid-template-columns:1fr!important}body.produce-staff .main-sticky-header .tabs .tab:not(.hidden-by-role){min-width:140px!important}body.produce-staff.produce-directory-open .app>.sidebar{left:0!important;width:280px!important;top:64px!important;height:calc(100vh - 64px)!important}}

/* source:user-sidebar-v152 */
/* Solo USUARIO: navegación y acciones agrupadas en el lateral. */
body.produce-ui.produce-user .app.limited-user .main-sticky-header .tabs{display:none!important}
body.produce-user .produce-selection-actions{display:block;margin:15px 0 0;padding-top:13px;border-top:1px solid #ccdef1}
.produce-selection-actions[hidden]{display:none!important}
body.produce-user .produce-selection-heading{font-size:11px;letter-spacing:.4px;font-weight:700;text-transform:uppercase;color:#547393;padding:0 12px 9px}
body.produce-user .produce-nav .produce-selection-actions #selectedCount{display:block!important;margin:0 9px 10px;padding:8px 10px;border:1px solid #d2e2f3;border-radius:7px;background:#e7f1ff;color:#234d7e;font-size:12px}
body.produce-user .produce-nav .produce-selection-actions button.btn{display:flex!important;width:100%!important;min-height:54px!important;height:auto!important;gap:12px!important;padding:11px 12px!important;margin:4px 0!important;text-align:left!important;justify-content:flex-start!important;white-space:normal!important;background:#fafdff!important;border:1px solid #d3e3f5!important;border-radius:8px!important;color:#06457f!important;font-size:14px!important;line-height:1.35!important;box-shadow:none!important}
body.produce-user .produce-nav .produce-selection-actions button.btn:disabled{opacity:.5!important;cursor:not-allowed!important}
body.produce-user .produce-nav .produce-selection-actions button.btn:not(:disabled):hover{background:#e1eeff!important;border-color:#8fb7e8!important}
body.produce-user #ownerDetailFilters{margin-top:12px!important}
@media(max-width:700px){
  body.produce-user .produce-nav{flex-wrap:wrap!important;overflow:visible!important}
  body.produce-user .produce-nav>button{flex:1 1 40%;min-width:0;white-space:normal}
  body.produce-user .produce-selection-actions{width:100%;display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;margin:6px 0 0;padding-top:10px}
  body.produce-user .produce-selection-heading,body.produce-user .produce-selection-actions #selectedCount{grid-column:1/-1}
  body.produce-user .produce-nav .produce-selection-actions button.btn{margin:0!important;font-size:12px!important}
}

/* source:v154-sin-pestanas-centrales-staff */
/* =========================================================
   V154 · NAVEGACIÓN SOLO LATERAL PARA PERSONAL
   ADMINISTRADOR y ARCHIVO: se oculta por completo la fila
   central de pestañas. Los módulos se abren desde el menú
   lateral izquierdo. Los botones originales permanecen en el
   DOM para conservar la lógica de navegación existente.
   ========================================================= */
body.produce-ui.produce-staff .main-sticky-header > .tabs,
body.produce-ui.produce-staff .main-sticky-header .tabs,
.app.role-admin .main-sticky-header > .tabs,
.app.role-archive .main-sticky-header > .tabs{
  display:none !important;
}

/* Recuperar el espacio que ocupaba la fila central. */
body.produce-ui.produce-staff .main-sticky-header{
  padding-bottom:10px !important;
}

/* Nueva solicitud queda como opción lateral para ADMIN y ARCHIVO. */
body.produce-ui.produce-staff .produce-nav .produce-new-request-side{
  display:flex !important;
}
body.produce-ui.produce-staff .produce-nav .produce-new-request-side[hidden]{
  display:none !important;
}

/* source:v157-mantener-menu-lateral-staff */
/* V157 · ADMINISTRADOR / ARCHIVO
   Mantener exactamente el formato lateral existente.
   No trasladar ni duplicar las acciones de expedientes al menú lateral. */
body.produce-staff .produce-nav .produce-selection-actions{
  display:none !important;
}

/* source:v170-task-layer-style */
#v170TaskCenter{margin:0 0 16px;border:1px solid #c9dcf0;border-radius:12px;background:#f8fbff;overflow:hidden}
#v170TaskCenter .v170-task-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;background:#edf5ff;border-bottom:1px solid #d5e4f3}
#v170TaskCenter .v170-task-head strong{color:#173f70;font-size:14px}
#v170TaskCenter .v170-task-head small{display:block;color:#607995;margin-top:3px}
#v170TaskCenter .v170-task-summary{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
#v170TaskCenter .v170-task-count{display:inline-flex;align-items:center;justify-content:center;min-width:30px;height:28px;padding:0 9px;border-radius:999px;background:#174b7e;color:#fff;font-weight:800}
#v170TaskList{padding:10px 12px;max-height:390px;overflow:auto}
#v170TaskList .v170-task-item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;padding:11px 12px;margin:7px 0;border:1px solid #d5e2ef;border-left:5px solid #2f6fa7;border-radius:9px;background:#fff}
#v170TaskList .v170-task-item[data-priority="ALTA"],#v170TaskList .v170-task-item[data-priority="URGENTE"]{border-left-color:#cf7b00;background:#fffaf0}
#v170TaskList .v170-task-item.is-unread{box-shadow:0 2px 9px rgba(23,54,93,.08)}
#v170TaskList .v170-task-title{font-weight:800;color:#17365d;font-size:13px}
#v170TaskList .v170-task-meta{margin-top:4px;color:#536d89;font-size:11px;line-height:1.45}
#v170TaskList .v170-task-message{margin-top:7px;color:#243f5c;font-size:12px;line-height:1.45}
#v170TaskList .v170-task-actions{display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:flex-end}
#v170TaskList .v170-task-type{display:inline-block;margin-top:7px;padding:3px 7px;border-radius:999px;background:#e9f1fb;color:#28557f;font-size:10px;font-weight:800}
body.v170-task-layer #backgroundReviewText::after{content:" · V170";font-weight:700;color:#28557f}
@media(max-width:700px){#v170TaskList .v170-task-item{grid-template-columns:1fr}#v170TaskList .v170-task-actions{justify-content:flex-start}#v170TaskCenter .v170-task-head{align-items:flex-start;flex-direction:column}}

/* source:v172-archivo-expedientes-por-usuario */
/* =========================================================
   V172 · ARCHIVO: EXPEDIENTES POR USUARIO
   - Habilita el módulo desde el menú lateral.
   - La fila central continúa oculta para perfiles de personal.
   - No habilita Resumen ni Solicitudes por abogado en ARCHIVO.
   ========================================================= */
body.produce-ui .app.role-archive .tabs .tab[data-tab="panel"],
body.produce-ui .app.role-archive .main-sticky-header .tabs .tab[data-tab="panel"]{
  display:inline-flex !important;
}

/* source:v173-ajustes-owner-cards-y-solicitudes */
/* =========================================================
   V173
   - Tarjetas "Expedientes por usuario" más compactas
   - Botón "Por atender" abre expedientes pendientes
   - Tabla de Solicitudes: Expedientes primero, luego Solicitud
   ========================================================= */
.owner-cards-grid{
  grid-template-columns:repeat(auto-fill,minmax(205px,1fr)) !important;
  gap:8px !important;
  margin-bottom:10px !important;
}
.owner-user-card{
  padding:10px 12px !important;
  border-radius:12px !important;
}
.owner-user-name{
  font-size:12px !important;
  margin:0 0 4px !important;
}
.owner-user-total{
  font-size:18px !important;
  margin:2px 0 6px !important;
}
.owner-user-summary-box{
  margin:6px 0 8px !important;
  padding:6px 8px !important;
  font-size:11px !important;
  min-height:auto !important;
}
.owner-user-stats{
  gap:4px 10px !important;
  font-size:10px !important;
}
.owner-user-stat span{
  font-size:10px !important;
  line-height:1.15 !important;
}
.owner-user-stat b{
  font-size:14px !important;
  margin-top:1px !important;
}
.owner-user-actions{
  margin-top:8px !important;
  gap:5px !important;
}
.owner-user-options{
  margin-top:8px !important;
  padding-top:8px !important;
  gap:5px !important;
}
.owner-user-actions .btn,
.owner-user-options .btn{
  padding:6px 9px !important;
  font-size:11px !important;
  line-height:1.15 !important;
}
@media (max-width:900px){
  .owner-cards-grid{
    grid-template-columns:repeat(auto-fill,minmax(185px,1fr)) !important;
  }
}
@media (max-width:640px){
  .owner-cards-grid{
    grid-template-columns:1fr !important;
  }
}

/* source:v174-owner-cards-horizontal */
/* =========================================================
   V174
   Expedientes por usuario:
   - tarjetas más pequeñas
   - diseño más compacto
   - mejor aprovechamiento horizontal
   ========================================================= */
.owner-cards-grid{
  display:grid !important;
  grid-template-columns:repeat(auto-fill,minmax(290px,1fr)) !important;
  gap:8px !important;
  margin-bottom:10px !important;
}

.owner-user-card{
  padding:10px 12px !important;
  border-radius:12px !important;
  min-height:auto !important;
}

.owner-user-name{
  font-size:12px !important;
  margin:0 0 2px !important;
  line-height:1.15 !important;
}

.owner-user-total{
  font-size:14px !important;
  margin:0 0 6px !important;
  line-height:1 !important;
}

.owner-user-summary-box{
  margin:4px 0 8px !important;
  padding:5px 8px !important;
  border-radius:7px !important;
  font-size:10px !important;
  line-height:1.2 !important;
}

.owner-user-stats{
  display:grid !important;
  grid-template-columns:repeat(3,minmax(0,1fr)) !important;
  gap:6px 10px !important;
  margin-top:0 !important;
  padding-top:0 !important;
  font-size:10px !important;
}

.owner-user-stat{
  min-width:0 !important;
}

.owner-user-stat span{
  display:block !important;
  font-size:10px !important;
  line-height:1.05 !important;
  margin-bottom:1px !important;
}

.owner-user-stat b{
  display:block !important;
  font-size:14px !important;
  line-height:1 !important;
  margin-top:0 !important;
}

.owner-user-actions{
  margin-top:8px !important;
  gap:5px !important;
}

.owner-user-options{
  display:flex !important;
  flex-wrap:wrap !important;
  gap:5px !important;
  margin-top:8px !important;
  padding-top:8px !important;
}

.owner-user-actions .btn,
.owner-user-options .btn{
  padding:5px 8px !important;
  min-height:auto !important;
  font-size:10px !important;
  line-height:1.15 !important;
  border-radius:8px !important;
}

.owner-user-options .btn.small,
.owner-user-actions .btn.small{
  padding:5px 8px !important;
  font-size:10px !important;
}

@media (max-width:1200px){
  .owner-cards-grid{
    grid-template-columns:repeat(auto-fill,minmax(260px,1fr)) !important;
  }
}

@media (max-width:760px){
  .owner-user-stats{
    grid-template-columns:repeat(2,minmax(0,1fr)) !important;
  }
}

@media (max-width:560px){
  .owner-cards-grid{
    grid-template-columns:1fr !important;
  }
  .owner-user-stats{
    grid-template-columns:repeat(2,minmax(0,1fr)) !important;
  }
}

/* source:v176-archivo-acciones-superiores */
/* =========================================================
   V176
   PERFIL ARCHIVO
   - Retira acciones superiores no solicitadas
   - Agrega Nueva solicitud al costado de Incorporar a custodia
   ========================================================= */
#archiveNewRequestBtn{
  order: 2;
}
.app.role-archive #archiveNewRequestBtn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
}

/* source:v177-ajustes-admin-archivo */
/* =========================================================
   V177
   - ADMIN: retira Solicitar seleccionados, Buscar para solicitar,
            Derivar a CONAS, Derivar a DVC y Derivar a Instrucción.
            Nueva solicitud pasa a la barra superior.
   - ARCHIVO: retira Nueva solicitud del menú lateral.
   ========================================================= */

/* source:v179-transiciones-rapidas */
/* V179 · Las vistas cambian sin modal de carga global.
   La tabla anterior/caché permanece visible mientras se revalida en segundo plano. */
#panelTable{
  transition:opacity .12s ease;
}

/* source:v180-master-search-fast */
#allSearch.v180-searching{
  box-shadow:0 0 0 2px rgba(37,99,235,.10) !important;
}

/* source:v181-owner-cards-fast */
.owner-metric-loading{
  display:inline-block;
  min-width:14px;
  opacity:.55;
  animation:v181Pulse .9s ease-in-out infinite alternate;
}
@keyframes v181Pulse{
  from{opacity:.35}
  to{opacity:.9}
}

/* source:v182-usuario-sin-detalle-mis-expedientes */
/* V182 · Perfil USUARIO: ocultar cualquier Detalle heredado en Mis expedientes */
body.produce-user #panelTable .produce-record-details{
  display:none !important;
}

/* source:v183-tablas-usuario-ajustadas */
/* Perfil USUARIO · tablas compactas sin columna Año */
body.produce-user #panelTable table{
  table-layout:auto;
}
body.produce-user #panelTable th,
body.produce-user #panelTable td{
  vertical-align:middle;
}
body.produce-user #panelTable th:nth-last-child(-n+4),
body.produce-user #panelTable td:nth-last-child(-n+4){
  white-space:nowrap;
}

/* Pendientes que todavía están con otro usuario */
body.produce-user .pending-attention-table .v183-other-holder-note{
  display:block;
  margin-top:4px;
  font-size:9px;
  line-height:1.2;
  font-weight:700;
  color:#835600;
  white-space:normal;
}

/* source:v184-usuario-busqueda-global */
/* Quitar desplegable "Estado de mis expedientes" */
body.produce-user .app.role-user #ownerStateField{
  display:none!important;
}

/* El buscador pasa a ocupar todo el ancho */
body.produce-user .app.role-user #ownerDetailFilters{
  grid-template-columns:minmax(0,1fr)!important;
  gap:0!important;
}
body.produce-user .app.role-user #ownerDetailFilters .field{
  width:100%!important;
}
body.produce-user .app.role-user #searchInput{
  width:100%!important;
}

/* Resultados de búsqueda global */
.v184-global-search-table th,
.v184-global-search-table td{
  vertical-align:middle;
}
.v184-global-search-table .v184-search-materia{
  min-width:220px;
  white-space:normal;
}
.v184-activity-pill{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  border-radius:999px;
  padding:4px 8px;
  font-size:9px;
  font-weight:900;
  white-space:nowrap;
}
.v184-activity-pill.v184-loan{
  background:#fff0c2;
  color:#775000;
}
.v184-activity-pill.v184-pending{
  background:#fff7d7;
  color:#805600;
}
.v184-activity-pill.v184-return{
  background:#ffe5c8;
  color:#914900;
}
.v184-activity-pill.v184-reassigned{
  background:#eee5ff;
  color:#6530a6;
}
.v184-activity-pill.v184-returned{
  background:#def5e7;
  color:#176337;
}
.v184-activity-pill.v184-alert{
  background:#ffe1e3;
  color:#a31225;
}

/* source:v185-busqueda-ultimo-estado */
.v185-latest-search-group{
  margin:0 0 12px;
  border:1px solid #d4e1f0;
  border-radius:10px;
  overflow:hidden;
  background:#fff;
}
.v185-latest-search-heading{
  display:flex;
  align-items:center;
  gap:9px;
  padding:8px 12px;
  background:#f3f8fe;
  border-bottom:1px solid #d4e1f0;
}
.v185-latest-search-heading span{
  font-size:10px;
  color:#58708f;
  font-weight:700;
}
.v185-latest-search-heading b{
  font-size:12px;
  color:#103c72;
}
.v185-latest-search-heading small{
  margin-left:auto;
  font-size:10px;
  color:#60738c;
}
.v185-latest-state-table th,
.v185-latest-state-table td{
  vertical-align:middle;
}
.v185-latest-state-table .v185-search-materia{
  min-width:220px;
  white-space:normal;
}

/* source:v186-fecha-hora-peru */
body.produce-staff .datetime-cell{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:2px;
}
body.produce-staff .datetime-date{
  font-weight:800;
}
body.produce-staff .datetime-time{
  font-size:10px;
  opacity:.78;
}

/* source:v187-request-search-fast */
#requestLookupResults .v187-fast-search-note{
  padding:10px 12px;
  font-size:11px;
  color:#58708f;
}

/* source:v188-fast-path-search */
#requestLookupResults .v188-verifying{
  background:#e8f1ff!important;
  color:#174f9d!important;
  border-color:#bfd4f5!important;
}
#requestLookupResults .v188-verifying::before{
  content:'•';
  display:inline-block;
  margin-right:4px;
  animation:v188Pulse .7s ease-in-out infinite alternate;
}
@keyframes v188Pulse{
  from{opacity:.25}
  to{opacity:1}
}

/* source:v190-reasignacion-directa */
.internal-reassign-state.selected .pill.returned{
  background:#e7f4ff;
  color:#124d80;
  border:1px solid #b8d7f0;
}
.notification-actions .btn{
  white-space:nowrap;
}

/* source:v191-reasignacion-seleccionable */
#requestLookupResults .request-custody-warning b{font-weight:900}
#requestLookupResults tr:has(.pill.returned) input[type="checkbox"]:not(:disabled){
  outline:2px solid rgba(30,115,216,.18);
  outline-offset:2px;
}

/* source:v193-fila-seleccionable-reasignacion */
#requestLookupResults tbody tr.request-lookup-row-v193.selectable{
  cursor:pointer;
  transition:
    background-color .12s ease,
    box-shadow .12s ease;
}

#requestLookupResults tbody tr.request-lookup-row-v193.selectable:hover td{
  background:#edf6ff!important;
}

#requestLookupResults tbody tr.request-lookup-row-v193.selected td{
  background:#dceeff!important;
  box-shadow:
    inset 0 1px 0 #78afe8,
    inset 0 -1px 0 #78afe8;
}

#requestLookupResults tbody tr.request-lookup-row-v193.selected td:first-child{
  box-shadow:
    inset 4px 0 0 #0f65b5,
    inset 0 1px 0 #78afe8,
    inset 0 -1px 0 #78afe8;
}

#requestLookupResults tbody tr.request-lookup-row-v193.direct-reassign.selected td{
  background:#e5f3ff!important;
}

#requestLookupResults tbody tr.request-lookup-row-v193.not-selectable{
  cursor:default;
}

#requestLookupContinueBtn{
  min-width:210px;
}

/* source:v196-solicitudes-reasignacion-card */
body.produce-user .app.role-user #userKpiReassignRequestsCard{
  background:#e7f4ff!important;
  border-color:#b6d9f7!important;
}

body.produce-user .app.role-user #userKpiReassignRequestsCard.v196-has-pending{
  background:#dff1ff!important;
  border-color:#67afe8!important;
  box-shadow:inset 0 0 0 1px #2a87d2!important;
}

body.produce-user .app.role-user #userKpiReassignRequestsCard .label{
  color:#0c4f84!important;
}

body.produce-user .app.role-user #userKpiReassignRequestsCard .value{
  color:#073861!important;
}

.v196-card-caption{
  margin-top:2px;
  font-size:9px;
  line-height:1.2;
  color:#4f6d89;
}

.v196-reassign-table th,
.v196-reassign-table td{
  vertical-align:middle;
}

.v196-reassign-table .v196-time{
  margin-top:2px;
  font-size:10px;
  color:#61758d;
}

.v196-reassign-actions{
  display:flex;
  gap:5px;
  align-items:center;
  justify-content:center;
  flex-wrap:wrap;
  white-space:nowrap;
}

.v196-reassign-actions .btn{
  min-height:28px;
}

/* source:v197-reasignaciones-solicitadas-por-mi */
body.produce-user .app.role-user #userKpiReassignSentCard{
  background:#f0ebff!important;
  border-color:#d2c4f5!important;
}

body.produce-user .app.role-user #userKpiReassignSentCard.v197-has-pending{
  background:#e9e1ff!important;
  border-color:#9776e5!important;
  box-shadow:inset 0 0 0 1px #7452c8!important;
}

body.produce-user .app.role-user #userKpiReassignSentCard .label{
  color:#51329b!important;
}

body.produce-user .app.role-user #userKpiReassignSentCard .value{
  color:#321c74!important;
}

.v197-card-caption{
  margin-top:2px;
  font-size:9px;
  line-height:1.2;
  color:#655b7f;
}

.v197-reassign-sent-table th,
.v197-reassign-sent-table td{
  vertical-align:middle;
}

.v197-reassign-sent-table .v197-time{
  margin-top:2px;
  font-size:10px;
  color:#61758d;
}

.v197-reassign-actions{
  display:flex;
  gap:5px;
  align-items:center;
  justify-content:center;
  flex-wrap:wrap;
  white-space:nowrap;
}

/* source:v198-seguimiento-reasignaciones */
.v198-track-kpis{
  display:grid;
  grid-template-columns:repeat(5,minmax(150px,1fr));
  gap:8px;
  margin-bottom:10px;
}

.v198-track-kpi{
  min-height:92px;
  cursor:pointer;
}

.v198-track-kpi.quick-active{
  outline:2px solid #184f83;
  outline-offset:-2px;
}

.v198-track-filter-card{
  margin-bottom:10px;
}

.v198-track-filter-grid{
  display:grid;
  grid-template-columns:minmax(220px,2fr) minmax(170px,1fr) minmax(170px,1fr) minmax(170px,1fr) auto;
  gap:8px;
  align-items:end;
}

.v198-track-filter-actions{
  display:flex;
  align-items:flex-end;
}

.v198-track-table th,
.v198-track-table td{
  vertical-align:middle;
}

.v198-track-table .v198-overdue-row td{
  background:#fff8df;
}

.v198-track-actions{
  display:flex;
  gap:5px;
  align-items:center;
  justify-content:center;
  white-space:nowrap;
}

.v198-detail-card{
  width:min(900px,94vw);
  max-height:88vh;
  overflow:auto;
}

.v198-detail-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:10px;
}

.v198-detail-grid>div,
.v198-detail-observation{
  border:1px solid #d7e3f0;
  border-radius:8px;
  padding:10px;
  background:#f8fbff;
}

.v198-detail-grid small,
.v198-detail-observation small{
  display:block;
  color:#60758f;
  font-size:10px;
  font-weight:800;
  margin-bottom:4px;
  text-transform:uppercase;
}

.v198-detail-observation{
  margin-top:10px;
}

@media(max-width:1200px){
  .v198-track-kpis{
    grid-template-columns:repeat(3,minmax(150px,1fr));
  }
  .v198-track-filter-grid{
    grid-template-columns:repeat(2,minmax(180px,1fr));
  }
}

@media(max-width:760px){
  .v198-track-kpis,
  .v198-track-filter-grid,
  .v198-detail-grid{
    grid-template-columns:1fr;
  }
}

/* source:v201-encabezado-marino-visible */
/* V201 · Encabezado marino con peces mucho más visibles. */
.produce-top{
  position:fixed;
  inset:0 0 auto;
  background:linear-gradient(135deg,#0e3965 8%,#2a5f96 56%,#0a3560 56%) !important;
  overflow:hidden;
}
.produce-top::before{
  content:"";
  position:absolute;
  left:193px;
  right:0;
  top:0;
  bottom:0;
