/* source:v37-columnas-compactas-contenido-ajustado */
/* =========================================================
   V37 · COLUMNAS MÁS COMPACTAS SIN REDUCIR LETRAS
   ========================================================= */

/* Base general: menos padding horizontal, misma legibilidad */
#allTable table.master-v19 th,
#allTable table.master-v19 td{
  padding-left:4px !important;
  padding-right:4px !important;
  box-sizing:border-box !important;
}

/* Mantener tamaño de letra normal en la tabla */
#allTable table.master-v19 th,
#allTable table.master-v19 td,
#allTable table.master-v19 td:nth-child(12),
#allTable table.master-v19 th:nth-child(12){
  font-size:inherit !important;
}

/* Columnas compactadas por contenido
   1 selección
   2 ítem
   3 fecha/hora solicitud
   4 expediente
   5 extensión
   6 última RD
   7 folios
   8 asunto
   9 fecha/hora entrega
   10 solicitante
   11 modalidad
   12 cargo
   13 profesional atención
   14 días atención
   15 reasignación
   16 fecha/hora reasignación
   17 estado
   18 ubicación
   19 días custodia
   20 fecha devolución
   21 profesional devuelve
   22 profesional recibe
   23 folios devolución
   24 listado
   25 sede
   26 fecha envío San Luis
   27 digitalizado
   28 alerta
   29 acciones
*/

/* 1-2 */
#allTable table.master-v19 th:nth-child(1),
#allTable table.master-v19 td:nth-child(1){ width:30px !important; min-width:30px !important; max-width:30px !important; }

#allTable table.master-v19 th:nth-child(2),
#allTable table.master-v19 td:nth-child(2){ width:48px !important; min-width:48px !important; max-width:48px !important; }

/* 3 Fecha/hora solicitud */
#allTable table.master-v19 th:nth-child(3),
#allTable table.master-v19 td:nth-child(3){ width:110px !important; min-width:110px !important; max-width:110px !important; }

/* 4 Expediente */
#allTable table.master-v19 th:nth-child(4),
#allTable table.master-v19 td:nth-child(4){ width:84px !important; min-width:84px !important; max-width:84px !important; }

/* 5 Extensión */
#allTable table.master-v19 th:nth-child(5),
#allTable table.master-v19 td:nth-child(5){ width:82px !important; min-width:82px !important; max-width:82px !important; }

/* 6 Última RD */
#allTable table.master-v19 th:nth-child(6),
#allTable table.master-v19 td:nth-child(6){ width:78px !important; min-width:78px !important; max-width:78px !important; }

/* 7 N° folios */
#allTable table.master-v19 th:nth-child(7),
#allTable table.master-v19 td:nth-child(7){ width:68px !important; min-width:68px !important; max-width:68px !important; }

/* 8 Asunto del requerimiento */
#allTable table.master-v19 th:nth-child(8),
#allTable table.master-v19 td:nth-child(8){ width:170px !important; min-width:170px !important; max-width:170px !important; }

#allTable table.master-v19 .v28-asunto-text{
  display:block !important;
  overflow:visible !important;
  max-height:none !important;
  max-width:168px !important;
  margin:0 auto !important;
  text-align:center !important;
  line-height:1.18 !important;
  font-size:9px !important;
  white-space:normal !important;
  overflow-wrap:anywhere !important;
}

/* 9 Fecha/hora entrega */
#allTable table.master-v19 th:nth-child(9),
#allTable table.master-v19 td:nth-child(9){ width:110px !important; min-width:110px !important; max-width:110px !important; }

/* 10 Solicitante */
#allTable table.master-v19 th:nth-child(10),
#allTable table.master-v19 td:nth-child(10){ width:136px !important; min-width:136px !important; max-width:136px !important; }

/* 11 Modalidad */
#allTable table.master-v19 th:nth-child(11),
#allTable table.master-v19 td:nth-child(11){ width:86px !important; min-width:86px !important; max-width:86px !important; }

/* 12 Cargo */
#allTable table.master-v19 th:nth-child(12),
#allTable table.master-v19 td:nth-child(12){ width:74px !important; min-width:74px !important; max-width:74px !important; }

/* 13 Responsable atención */
#allTable table.master-v19 th:nth-child(13),
#allTable table.master-v19 td:nth-child(13){ width:138px !important; min-width:138px !important; max-width:138px !important; }

/* 14 Días atención */
#allTable table.master-v19 thead tr.master-v19-groups th.g-time,
#allTable table.master-v19 th:nth-child(14),
#allTable table.master-v19 td:nth-child(14){ width:72px !important; min-width:72px !important; max-width:72px !important; }

/* 15 Reasignación */
#allTable table.master-v19 th:nth-child(15),
#allTable table.master-v19 td:nth-child(15){ width:160px !important; min-width:160px !important; max-width:160px !important; }

/* 16 Fecha/hora reasignación */
#allTable table.master-v19 th:nth-child(16),
#allTable table.master-v19 td:nth-child(16){ width:108px !important; min-width:108px !important; max-width:108px !important; }

/* 17 Estado */
#allTable table.master-v19 th:nth-child(17),
#allTable table.master-v19 td:nth-child(17){ width:112px !important; min-width:112px !important; max-width:112px !important; }

/* 18 Ubicación */
#allTable table.master-v19 th:nth-child(18),
#allTable table.master-v19 td:nth-child(18){ width:122px !important; min-width:122px !important; max-width:122px !important; }

/* 19 Días en custodia */
#allTable table.master-v19 thead tr.master-v19-groups th.g-custody,
#allTable table.master-v19 th:nth-child(19),
#allTable table.master-v19 td:nth-child(19){ width:72px !important; min-width:72px !important; max-width:72px !important; }

/* 20 Fecha devolución */
#allTable table.master-v19 th:nth-child(20),
#allTable table.master-v19 td:nth-child(20){ width:96px !important; min-width:96px !important; max-width:96px !important; }

/* 21 Profesional que devuelve */
#allTable table.master-v19 th:nth-child(21),
#allTable table.master-v19 td:nth-child(21){ width:126px !important; min-width:126px !important; max-width:126px !important; }

/* 22 Profesional que recibe */
#allTable table.master-v19 th:nth-child(22),
#allTable table.master-v19 td:nth-child(22){ width:126px !important; min-width:126px !important; max-width:126px !important; }

/* 23 N° folios devolución */
#allTable table.master-v19 th:nth-child(23),
#allTable table.master-v19 td:nth-child(23){ width:72px !important; min-width:72px !important; max-width:72px !important; }

/* 24 Listado */
#allTable table.master-v19 th:nth-child(24),
#allTable table.master-v19 td:nth-child(24){ width:88px !important; min-width:88px !important; max-width:88px !important; }

/* 25 Sede */
#allTable table.master-v19 th:nth-child(25),
#allTable table.master-v19 td:nth-child(25){ width:108px !important; min-width:108px !important; max-width:108px !important; }

/* 26 Fecha envío San Luis */
#allTable table.master-v19 th:nth-child(26),
#allTable table.master-v19 td:nth-child(26){ width:118px !important; min-width:118px !important; max-width:118px !important; }

/* 27 Digitalizado */
#allTable table.master-v19 th:nth-child(27),
#allTable table.master-v19 td:nth-child(27){ width:98px !important; min-width:98px !important; max-width:98px !important; }

/* 28 Alerta */
#allTable table.master-v19 th:nth-child(28),
#allTable table.master-v19 td:nth-child(28){ width:90px !important; min-width:90px !important; max-width:90px !important; }

/* 29 Acciones */
#allTable table.master-v19 th:nth-child(29),
#allTable table.master-v19 td:nth-child(29){ width:118px !important; min-width:118px !important; max-width:118px !important; }

/* En columnas cortas, impedir crecimiento horizontal innecesario */
#allTable table.master-v19 td:nth-child(2),
#allTable table.master-v19 td:nth-child(4),
#allTable table.master-v19 td:nth-child(6),
#allTable table.master-v19 td:nth-child(7),
#allTable table.master-v19 td:nth-child(11),
#allTable table.master-v19 td:nth-child(12),
#allTable table.master-v19 td:nth-child(14),
#allTable table.master-v19 td:nth-child(19),
#allTable table.master-v19 td:nth-child(20),
#allTable table.master-v19 td:nth-child(23),
#allTable table.master-v19 td:nth-child(24){
  white-space:nowrap !important;
}

/* Encabezados compactos sin bajar tamaño de letra */
#allTable table.master-v19 thead th{
  line-height:1.1 !important;
}

/* source:v38-reasignacion-nombre-visible */
/* =========================================================
   V38 · REASIGNACIÓN CON NOMBRE VISIBLE
   ========================================================= */

/* Columna 15 = Reasignación (De → A) */
#allTable table.master-v19 th:nth-child(15),
#allTable table.master-v19 td:nth-child(15){
  width:210px !important;
  min-width:210px !important;
  max-width:210px !important;
  padding-left:6px !important;
  padding-right:6px !important;
  text-align:center !important;
  vertical-align:middle !important;
  box-sizing:border-box !important;
}

/* Mostrar el contenido completo, sin recorte horizontal */
#allTable table.master-v19 td:nth-child(15),
#allTable table.master-v19 td:nth-child(15) .v19-reassignment-single,
#allTable table.master-v19 .v19-reassignment-single{
  white-space:normal !important;
  overflow:visible !important;
  text-overflow:clip !important;
  word-break:normal !important;
  overflow-wrap:anywhere !important;
  line-height:1.2 !important;
}

/* Mantener el nombre centrado dentro de la celda */
#allTable table.master-v19 td:nth-child(15) .v19-reassignment-single,
#allTable table.master-v19 .v19-reassignment-single{
  display:block !important;
  max-width:198px !important;
  margin:0 auto !important;
  text-align:center !important;
}

/* source:v39-reasignacion-desfase-color-corregido */
/* =========================================================
   V39 · CORRECCIÓN DEL DESFASE DE COLORES EN REASIGNACIÓN
   ========================================================= */

/* La celda debe seguir siendo una celda de tabla */
#allTable table.master-v19 td.v19-reassignment-single{
  display:table-cell !important;
  width:210px !important;
  min-width:210px !important;
  max-width:210px !important;
  padding-left:6px !important;
  padding-right:6px !important;
  text-align:center !important;
  vertical-align:middle !important;
  white-space:normal !important;
  overflow:visible !important;
  background:inherit !important;
}

/* El encabezado conserva el mismo ancho */
#allTable table.master-v19 th:nth-child(15){
  width:210px !important;
  min-width:210px !important;
  max-width:210px !important;
}

/* Solo el contenido interno se comporta como bloque */
#allTable table.master-v19 td.v19-reassignment-single .master-v18-reassign-main{
  display:block !important;
  max-width:198px !important;
  margin:0 auto !important;
  text-align:center !important;
  line-height:1.2 !important;
  white-space:normal !important;
  overflow-wrap:anywhere !important;
  word-break:normal !important;
  background:transparent !important;
}

/* Evitar que reglas anteriores conviertan cualquier elemento asociado en bloque incorrecto */
#allTable table.master-v19 .v19-reassignment-single{
  background:inherit !important;
}

/* Cuando no hay reasignación, mantener el guion centrado sin alterar la fila */
#allTable table.master-v19 td.v19-reassignment-single:empty::before{
  content:'—';
}

/* source:v40-reasignacion-continua-color-fila */
/* =========================================================
   V40 · REASIGNACIÓN CONTINÚA CON EL COLOR DE LA FILA
   ========================================================= */

/* Mantener la celda como table-cell, pero SIN heredar fondo del tr */
#allTable table.master-v19 td.v19-reassignment-single{
  display:table-cell !important;
  width:210px !important;
  min-width:210px !important;
  max-width:210px !important;
  padding-left:6px !important;
  padding-right:6px !important;
  text-align:center !important;
  vertical-align:middle !important;
  white-space:normal !important;
  overflow:visible !important;
}

/* Aplicar el mismo color zebra de la fila a la celda Reasignación */
#allTable table.master-v19 tbody tr:nth-child(odd) td.v19-reassignment-single{
  background:#ffffff !important;
}

#allTable table.master-v19 tbody tr:nth-child(even) td.v19-reassignment-single{
  background:#edf3f9 !important;
}

/* Hover */
#allTable table.master-v19 tbody tr:hover td.v19-reassignment-single{
  background:#e1ecf8 !important;
}

/* Selección */
#allTable table.master-v19 tbody tr.selected-row td.v19-reassignment-single,
#allTable table.master-v19 tbody tr.is-selected td.v19-reassignment-single,
#allTable table.master-v19 tbody tr[aria-selected="true"] td.v19-reassignment-single,
#allTable table.master-v19 tbody tr.record-selected-row td.v19-reassignment-single{
  background:#d8e9fb !important;
}

/* El contenido interno sigue transparente */
#allTable table.master-v19 td.v19-reassignment-single .master-v18-reassign-main{
  display:block !important;
  max-width:198px !important;
  margin:0 auto !important;
  text-align:center !important;
  line-height:1.2 !important;
  white-space:normal !important;
  overflow-wrap:anywhere !important;
  word-break:normal !important;
  background:transparent !important;
}

/* source:v41-filas-color-uniforme */
/* =========================================================
   V41 · MANTENER EL COLOR QUE CORRESPONDE A CADA FILA
   ========================================================= */

/* Zebra uniforme en TODAS las celdas del Registro Maestro */
#allTable table.master-v19 tbody tr:nth-child(odd) > td{
  background:#ffffff !important;
}

#allTable table.master-v19 tbody tr:nth-child(even) > td{
  background:#edf3f9 !important;
}

/* Hover uniforme */
#allTable table.master-v19 tbody tr:hover > td{
  background:#e1ecf8 !important;
}

/* Selección uniforme */
#allTable table.master-v19 tbody tr.selected-row > td,
#allTable table.master-v19 tbody tr.is-selected > td,
#allTable table.master-v19 tbody tr[aria-selected="true"] > td,
#allTable table.master-v19 tbody tr.record-selected-row > td{
  background:#d8e9fb !important;
}

/* Ningún contenedor interno debe "cortar" el color de la fila */
#allTable table.master-v19 tbody td > div:not(.master-actions-inline):not(.req-actions):not(.actions),
#allTable table.master-v19 tbody td > span:not(.pill):not(.badge):not(.master-cycle-badge):not(.master-cycle-readonly),
#allTable table.master-v19 tbody td > b,
#allTable table.master-v19 tbody td > strong,
#allTable table.master-v19 tbody td > small,
#allTable table.master-v19 tbody td > a,
#allTable table.master-v19 tbody td .master-v18-reassign-main,
#allTable table.master-v19 tbody td .v28-asunto-text,
#allTable table.master-v19 tbody td .v19-small{
  background:transparent !important;
}

/* Celdas especiales que venían siendo tocadas en versiones previas */
#allTable table.master-v19 tbody td.v19-reassignment-single,
#allTable table.master-v19 tbody td.v19-person,
#allTable table.master-v19 tbody td.v19-date,
#allTable table.master-v19 tbody td.v19-time,
#allTable table.master-v19 tbody td.v19-area,
#allTable table.master-v19 tbody td.v19-asunto,
#allTable table.master-v19 tbody td.v19-block-end{
  background:transparent;
}

/* Reaplicar el color real de la fila a esas celdas especiales */
#allTable table.master-v19 tbody tr:nth-child(odd) > td.v19-reassignment-single,
#allTable table.master-v19 tbody tr:nth-child(odd) > td.v19-person,
#allTable table.master-v19 tbody tr:nth-child(odd) > td.v19-date,
#allTable table.master-v19 tbody tr:nth-child(odd) > td.v19-time,
#allTable table.master-v19 tbody tr:nth-child(odd) > td.v19-area,
#allTable table.master-v19 tbody tr:nth-child(odd) > td.v19-asunto,
#allTable table.master-v19 tbody tr:nth-child(odd) > td.v19-block-end{
  background:#ffffff !important;
}

#allTable table.master-v19 tbody tr:nth-child(even) > td.v19-reassignment-single,
#allTable table.master-v19 tbody tr:nth-child(even) > td.v19-person,
#allTable table.master-v19 tbody tr:nth-child(even) > td.v19-date,
#allTable table.master-v19 tbody tr:nth-child(even) > td.v19-time,
#allTable table.master-v19 tbody tr:nth-child(even) > td.v19-area,
#allTable table.master-v19 tbody tr:nth-child(even) > td.v19-asunto,
#allTable table.master-v19 tbody tr:nth-child(even) > td.v19-block-end{
  background:#edf3f9 !important;
}

#allTable table.master-v19 tbody tr:hover > td.v19-reassignment-single,
#allTable table.master-v19 tbody tr:hover > td.v19-person,
#allTable table.master-v19 tbody tr:hover > td.v19-date,
#allTable table.master-v19 tbody tr:hover > td.v19-time,
#allTable table.master-v19 tbody tr:hover > td.v19-area,
#allTable table.master-v19 tbody tr:hover > td.v19-asunto,
#allTable table.master-v19 tbody tr:hover > td.v19-block-end{
  background:#e1ecf8 !important;
}

#allTable table.master-v19 tbody tr.selected-row > td.v19-reassignment-single,
#allTable table.master-v19 tbody tr.selected-row > td.v19-person,
#allTable table.master-v19 tbody tr.selected-row > td.v19-date,
#allTable table.master-v19 tbody tr.selected-row > td.v19-time,
#allTable table.master-v19 tbody tr.selected-row > td.v19-area,
#allTable table.master-v19 tbody tr.selected-row > td.v19-asunto,
#allTable table.master-v19 tbody tr.selected-row > td.v19-block-end,
#allTable table.master-v19 tbody tr.is-selected > td.v19-reassignment-single,
#allTable table.master-v19 tbody tr.is-selected > td.v19-person,
#allTable table.master-v19 tbody tr.is-selected > td.v19-date,
#allTable table.master-v19 tbody tr.is-selected > td.v19-time,
#allTable table.master-v19 tbody tr.is-selected > td.v19-area,
#allTable table.master-v19 tbody tr.is-selected > td.v19-asunto,
#allTable table.master-v19 tbody tr.is-selected > td.v19-block-end,
#allTable table.master-v19 tbody tr.record-selected-row > td.v19-reassignment-single,
#allTable table.master-v19 tbody tr.record-selected-row > td.v19-person,
#allTable table.master-v19 tbody tr.record-selected-row > td.v19-date,
#allTable table.master-v19 tbody tr.record-selected-row > td.v19-time,
#allTable table.master-v19 tbody tr.record-selected-row > td.v19-area,
#allTable table.master-v19 tbody tr.record-selected-row > td.v19-asunto,
#allTable table.master-v19 tbody tr.record-selected-row > td.v19-block-end{
  background:#d8e9fb !important;
}

/* Las píldoras de estado mantienen su color propio, pero sin afectar la celda */
#allTable table.master-v19 tbody td .pill,
#allTable table.master-v19 tbody td .badge,
#allTable table.master-v19 tbody td .master-cycle-badge,
#allTable table.master-v19 tbody td .master-cycle-readonly{
  position:relative;
  z-index:1;
}

/* source:v42-fila-devuelto-archivo-gris */
/* =========================================================
   V42 · FILA ESPECIAL PARA DEVUELTO AL ARCHIVO
   ========================================================= */

/* Fila devuelta al archivo: gris suave */
#allTable table.master-v19 tbody tr.master-row-returned-archive > td{
  background:#ececec !important;
}

/* Hover sobre fila devuelta */
#allTable table.master-v19 tbody tr.master-row-returned-archive:hover > td{
  background:#e2e2e2 !important;
}

/* Selección sobre fila devuelta */
#allTable table.master-v19 tbody tr.master-row-returned-archive.selected-row > td,
#allTable table.master-v19 tbody tr.master-row-returned-archive.is-selected > td,
#allTable table.master-v19 tbody tr.master-row-returned-archive[aria-selected="true"] > td,
#allTable table.master-v19 tbody tr.master-row-returned-archive.record-selected-row > td{
  background:#d7dee7 !important;
}

/* Los contenedores internos deben respetar el color de la fila */
#allTable table.master-v19 tbody tr.master-row-returned-archive > td > div:not(.master-actions-inline):not(.req-actions):not(.actions),
#allTable table.master-v19 tbody tr.master-row-returned-archive > td > span:not(.pill):not(.badge):not(.master-cycle-badge):not(.master-cycle-readonly),
#allTable table.master-v19 tbody tr.master-row-returned-archive > td .master-v18-reassign-main,
#allTable table.master-v19 tbody tr.master-row-returned-archive > td .v28-asunto-text,
#allTable table.master-v19 tbody tr.master-row-returned-archive > td .v19-small{
  background:transparent !important;
}

/* source:v43-color-uniforme-toda-fila */
/* =========================================================
   V43 · TODA LA FILA CONSERVA EXACTAMENTE EL MISMO COLOR
   ========================================================= */

/* Color base por fila */
#allTable table.master-v19 tbody tr{
  --master-row-bg:#ffffff;
}

/* Zebra normal */
#allTable table.master-v19 tbody tr:nth-child(odd){
  --master-row-bg:#ffffff;
}

#allTable table.master-v19 tbody tr:nth-child(even){
  --master-row-bg:#edf3f9;
}

/* DEVUELTO AL ARCHIVO: toda la fila gris */
#allTable table.master-v19 tbody tr.master-row-returned-archive{
  --master-row-bg:#e3e3e3;
}

/* Hover */
#allTable table.master-v19 tbody tr:hover{
  --master-row-bg:#e1ecf8;
}

#allTable table.master-v19 tbody tr.master-row-returned-archive:hover{
  --master-row-bg:#d8d8d8;
}

/* Selección */
#allTable table.master-v19 tbody tr.selected-row,
#allTable table.master-v19 tbody tr.is-selected,
#allTable table.master-v19 tbody tr[aria-selected="true"],
#allTable table.master-v19 tbody tr.record-selected-row{
  --master-row-bg:#d8e9fb;
}

/* REGLA DEFINITIVA:
   todas las celdas directas usan exactamente el color de su fila */
#allTable table.master-v19 tbody tr > td{
  background-color:var(--master-row-bg) !important;
  background-image:none !important;
}

/* Neutralizar cualquier estilo antiguo específico de columnas/ciclos */
#allTable table.master-v19 tbody tr.master-cycle-row-closed > td,
#allTable table.master-v19 tbody tr.master-cycle-row-active > td,
#allTable table.master-v19 tbody tr > td.v19-reassignment-single,
#allTable table.master-v19 tbody tr > td.v19-person,
#allTable table.master-v19 tbody tr > td.v19-date,
#allTable table.master-v19 tbody tr > td.v19-time,
#allTable table.master-v19 tbody tr > td.v19-area,
#allTable table.master-v19 tbody tr > td.v19-asunto,
#allTable table.master-v19 tbody tr > td.v19-block-end{
  background-color:var(--master-row-bg) !important;
  background-image:none !important;
}

/* Los contenedores de texto no crean un rectángulo de otro color */
#allTable table.master-v19 tbody td .master-v18-reassign-main,
#allTable table.master-v19 tbody td .v28-asunto-text,
#allTable table.master-v19 tbody td .v19-small{
  background:transparent !important;
}

/* Los badges y estados mantienen su propio color */
#allTable table.master-v19 tbody td .pill,
#allTable table.master-v19 tbody td .badge,
#allTable table.master-v19 tbody td .master-cycle-badge,
#allTable table.master-v19 tbody td .master-cycle-readonly,
#allTable table.master-v19 tbody td .datetime-time{
  background-image:none;
}

/* source:v44-uniformidad-total-fila-forzada */
/* =========================================================
   V44 · FORZAR QUE TODA LA FILA TENGA EL MISMO COLOR
   ========================================================= */

/* Variable única por fila */
#allTable table.master-v19 tbody tr{
  --master-row-bg:#ffffff;
}

#allTable table.master-v19 tbody tr:nth-child(odd){
  --master-row-bg:#ffffff;
}

#allTable table.master-v19 tbody tr:nth-child(even){
  --master-row-bg:#edf3f9;
}

#allTable table.master-v19 tbody tr.master-row-returned-archive{
  --master-row-bg:#e3e3e3;
}

#allTable table.master-v19 tbody tr:hover{
  --master-row-bg:#e1ecf8;
}

#allTable table.master-v19 tbody tr.master-row-returned-archive:hover{
  --master-row-bg:#d8d8d8;
}

#allTable table.master-v19 tbody tr.selected-row,
#allTable table.master-v19 tbody tr.is-selected,
#allTable table.master-v19 tbody tr[aria-selected="true"],
#allTable table.master-v19 tbody tr.record-selected-row{
  --master-row-bg:#d8e9fb;
}

/* Aplicar a TODAS las celdas, sean td o th */
#allTable table.master-v19 tbody tr > *{
  background:var(--master-row-bg) !important;
  background-color:var(--master-row-bg) !important;
  background-image:none !important;
}

/* Y a los contenedores internos comunes, para que no aparezcan "bloques" */
#allTable table.master-v19 tbody tr > * > div,
#allTable table.master-v19 tbody tr > * > span,
#allTable table.master-v19 tbody tr > * > small,
#allTable table.master-v19 tbody tr > * > strong,
#allTable table.master-v19 tbody tr > * > b,
#allTable table.master-v19 tbody tr > * > a,
#allTable table.master-v19 tbody tr > * .master-v18-reassign-main,
#allTable table.master-v19 tbody tr > * .v28-asunto-text,
#allTable table.master-v19 tbody tr > * .v19-small{
  background:transparent !important;
  background-color:transparent !important;
  background-image:none !important;
}

/* Mantener visibles los badges con su color propio */
#allTable table.master-v19 tbody tr > * .pill,
#allTable table.master-v19 tbody tr > * .badge,
#allTable table.master-v19 tbody tr > * .master-cycle-badge,
#allTable table.master-v19 tbody tr > * .master-cycle-readonly,
#allTable table.master-v19 tbody tr > * .datetime-time{
  background-image:none !important;
}

/* Reforzar algunas celdas especiales que antes generaban cortes */
#allTable table.master-v19 tbody tr > *.v19-reassignment-single,
#allTable table.master-v19 tbody tr > *.v19-person,
#allTable table.master-v19 tbody tr > *.v19-date,
#allTable table.master-v19 tbody tr > *.v19-time,
#allTable table.master-v19 tbody tr > *.v19-area,
#allTable table.master-v19 tbody tr > *.v19-asunto,
#allTable table.master-v19 tbody tr > *.v19-block-end{
  background:var(--master-row-bg) !important;
  background-color:var(--master-row-bg) !important;
}

/* source:v51-lineas-negras-scroll-real */
/* =========================================================
   V51 · CSS APLICADO EN EL HEAD REAL
   LÍNEAS NEGRAS + SCROLL HORIZONTAL MÁS GRUESO
   ========================================================= */

/* ===== REGISTRO MAESTRO: LÍNEAS NEGRAS ===== */
#allTable table.master-v19{
  border-collapse:separate !important;
  border-spacing:0 !important;
  border-top:2px solid #000 !important;
  border-left:2px solid #000 !important;
}

#allTable table.master-v19 thead th{
  border-right:2px solid #000 !important;
  border-bottom:2px solid #000 !important;
  box-shadow:none !important;
}

#allTable table.master-v19 tbody td{
  border-right:2px solid #000 !important;
  border-bottom:2px solid #000 !important;
  box-shadow:none !important;
}

#allTable table.master-v19 thead th:last-child,
#allTable table.master-v19 tbody td:last-child{
  border-right:2px solid #000 !important;
}

#allTable table.master-v19 tbody tr:last-child td{
  border-bottom:2px solid #000 !important;
}

/* Separaciones entre bloques */
#allTable table.master-v19 .v19-block-end{
  border-right:3px solid #000 !important;
}

/* Encabezados de grupo */
#allTable table.master-v19 thead tr.master-v19-groups th{
  border-bottom:2px solid #000 !important;
}

/* ===== SCROLL HORIZONTAL DEL REGISTRO MAESTRO ===== */
#tab-all .table-wrap{
  scrollbar-width:auto !important;
  scrollbar-color:#6b7280 #d9e0e8 !important;
}

/* Chrome / Edge / Safari */
#tab-all .table-wrap::-webkit-scrollbar{
  width:18px !important;
  height:22px !important;
}

#tab-all .table-wrap::-webkit-scrollbar-track{
  background:#d9e0e8 !important;
  border-radius:10px !important;
}

#tab-all .table-wrap::-webkit-scrollbar-thumb{
  background:#6b7280 !important;
  border-radius:10px !important;
  border:3px solid #d9e0e8 !important;
  min-width:60px !important;
}

#tab-all .table-wrap::-webkit-scrollbar-thumb:hover{
  background:#4b5563 !important;
}

/* Evitar que reglas generales antiguas vuelvan a hacerla delgada */
#tab-all .table-wrap{
  overflow:auto !important;
}

/* source:v52-lineas-negras-mas-delgadas */
/* =========================================================
   V52 · LÍNEAS NEGRAS UN POCO MÁS DELGADAS
   Mantiene el scroll horizontal grueso.
   ========================================================= */

#allTable table.master-v19{
  border-top:1.5px solid #000 !important;
  border-left:1.5px solid #000 !important;
}

#allTable table.master-v19 thead th{
  border-right:1.5px solid #000 !important;
  border-bottom:1.5px solid #000 !important;
}

#allTable table.master-v19 tbody td{
  border-right:1.25px solid #000 !important;
  border-bottom:1.25px solid #000 !important;
}

#allTable table.master-v19 thead th:last-child,
#allTable table.master-v19 tbody td:last-child{
  border-right:1.5px solid #000 !important;
}

#allTable table.master-v19 tbody tr:last-child td{
  border-bottom:1.5px solid #000 !important;
}

/* Separaciones entre bloques: visibles pero menos pesadas */
#allTable table.master-v19 .v19-block-end{
  border-right:2px solid #000 !important;
}

#allTable table.master-v19 thead tr.master-v19-groups th{
  border-bottom:1.5px solid #000 !important;
}

/* source:v53-expedientes-acumulados */
/* =========================================================
   V53 · EXPEDIENTES ACUMULADOS
   ========================================================= */

.accum-inline{
  margin-top:4px;
  font-size:10px;
  line-height:1.35;
}

.accum-inline details{
  display:block;
}

.accum-inline summary{
  cursor:pointer;
  color:#315b98;
  font-weight:800;
  list-style:none;
  user-select:none;
}

.accum-inline summary::-webkit-details-marker{
  display:none;
}

.accum-inline-list{
  margin-top:4px;
  padding:5px 6px;
  border:1px solid #c9d4e0;
  border-radius:7px;
  background:rgba(255,255,255,.55);
}

.accum-inline-item{
  display:block;
  margin:2px 0;
  white-space:normal;
}

.accum-inline-action{
  margin-top:5px;
}

.accum-add-btn{
  margin-top:5px;
  padding:3px 7px !important;
  font-size:9px !important;
}

.accum-search-note{
  display:block;
  margin-top:4px;
  color:#6b4b11;
  font-size:10px;
  font-weight:750;
}

#acumuladosModal .modal-box{
  max-width:760px;
}

.accum-principal-box{
  padding:10px 12px;
  border:1px solid #cbd5e1;
  border-radius:9px;
  background:#f8fafc;
  margin-bottom:12px;
}

.accum-form-grid{
  display:grid;
  grid-template-columns:1.4fr .8fr;
  gap:10px;
}

.accum-list{
  margin-top:14px;
  border:1px solid #d7e0ea;
  border-radius:9px;
  overflow:hidden;
}

.accum-list-row{
  display:grid;
  grid-template-columns:minmax(0,1fr) 120px 105px;
  align-items:center;
  gap:8px;
  padding:9px 10px;
  border-bottom:1px solid #d7e0ea;
}

.accum-list-row:last-child{
  border-bottom:0;
}

.accum-list-num{
  font-weight:850;
  color:#173f6b;
}

.accum-list-meta{
  font-size:10px;
  color:#64748b;
}

@media(max-width:680px){
  .accum-form-grid{grid-template-columns:1fr}
  .accum-list-row{grid-template-columns:1fr}
}

/* source:v56-expediente-extension-identity */
.accum-principal-box{
  border-left:4px solid #315b98 !important;
}
.accum-inline-item{
  font-weight:700;
}
.accum-inline-item span{
  color:#475569;
  font-weight:800;
}

/* source:v62-colores-excel-reales */
/* V62 · Paleta exacta del formato de referencia */
#allTable table.master-v19 tbody tr:nth-child(odd){
  --master-row-bg:#ffffff !important;
}
#allTable table.master-v19 tbody tr:nth-child(even){
  --master-row-bg:#cfe2f3 !important;
}
#allTable table.master-v19 tbody tr.master-row-returned-archive{
  --master-row-bg:#f4cccc !important;
}
#allTable table.master-v19 tbody tr:hover{
  --master-row-bg:#d9eaf7 !important;
}
#allTable table.master-v19 tbody tr.master-row-returned-archive:hover{
  --master-row-bg:#efb8b8 !important;
}
#allTable table.master-v19 .v28-asunto-text{
  display:block !important;
  overflow:visible !important;
  max-height:none !important;
  max-width:168px !important;
  margin:0 auto !important;
  text-align:center !important;
  line-height:1.18 !important;
  font-size:9px !important;
  white-space:normal !important;
  overflow-wrap:anywhere !important;
}

/* source:v63-buscador-expedientes */
/* =========================================================
   V63 · BUSCADOR DE EXPEDIENTES
   ========================================================= */

.exp-search-shell{
  display:grid;
  gap:12px;
}

.exp-search-toolbar{
  display:grid;
  grid-template-columns:minmax(220px,1.4fr) minmax(170px,.8fr) auto;
  gap:10px;
  align-items:end;
}

.exp-search-status{
  margin-top:8px;
  min-height:18px;
  color:#52677f;
  font-size:11px;
}

.exp-search-choices{
  display:grid;
  gap:8px;
  margin-top:10px;
}

.exp-search-choice{
  border:1px solid #b9c9da;
  border-left:4px solid #315b98;
  border-radius:8px;
  padding:10px 12px;
  background:#f7fbff;
  cursor:pointer;
  transition:.15s ease;
}

.exp-search-choice:hover{
  background:#eaf4fd;
  transform:translateY(-1px);
}

.exp-search-choice .main{
  font-size:14px;
  font-weight:850;
  color:#173f6b;
}

.exp-search-choice .sub{
  margin-top:3px;
  font-size:10px;
  color:#60758d;
}

.exp-search-summary-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(150px,1fr));
  gap:8px;
}

.exp-search-kv{
  border:1px solid #c7d4e2;
  border-radius:8px;
  padding:9px 10px;
  min-height:60px;
  background:#f8fbfe;
}

.exp-search-kv span{
  display:block;
  margin-bottom:4px;
  font-size:9px;
  font-weight:800;
  color:#61768d;
  text-transform:uppercase;
}

.exp-search-kv b{
  display:block;
  color:#173f6b;
  font-size:12px;
  line-height:1.25;
  overflow-wrap:anywhere;
}

.exp-search-kv.emphasis{
  background:#eaf4fd;
  border-color:#a9c3dc;
}

.exp-search-kv.listed{
  background:#eef8ee;
  border-color:#a9cba9;
}

.exp-search-kv.san-luis{
  background:#fff4d9;
  border-color:#ddc47d;
}

.exp-search-headline{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:12px;
  flex-wrap:wrap;
  margin-bottom:10px;
}

.exp-search-title{
  font-size:18px;
  font-weight:900;
  color:#173f6b;
}

.exp-search-subtitle{
  margin-top:3px;
  color:#667b91;
  font-size:10px;
}

.exp-search-accumulated{
  margin-top:10px;
  padding:9px 10px;
  border:1px solid #c7d4e2;
  border-radius:8px;
  background:#f8fbfe;
}

.exp-search-accumulated summary{
  cursor:pointer;
  font-weight:850;
  color:#315b98;
}

.exp-search-accumulated-list{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin-top:8px;
}

.exp-search-accumulated-tag{
  padding:5px 8px;
  border:1px solid #bfd0e0;
  border-radius:999px;
  background:#fff;
  font-size:10px;
  font-weight:750;
  color:#244160;
}

.exp-search-cycles{
  display:grid;
  gap:12px;
}

.exp-search-cycle{
  border:1px solid #b9c9da;
  border-radius:10px;
  overflow:hidden;
  background:#fff;
}

.exp-search-cycle.current{
  border:2px solid #315b98;
}

.exp-search-cycle.closed{
  border-color:#c4b7a6;
}

.exp-search-cycle-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:10px;
  padding:10px 12px;
  background:#e8f2fb;
  border-bottom:1px solid #b9c9da;
}

.exp-search-cycle.closed .exp-search-cycle-head{
  background:#eee8df;
}

.exp-search-cycle-head .asunto{
  margin-top:4px;
  font-size:12px;
  line-height:1.25;
  font-weight:850;
  color:#173f6b;
}

.exp-search-cycle-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(150px,1fr));
  gap:0;
}

.exp-search-cycle-grid .exp-search-kv{
  border:0;
  border-right:1px solid #d4dee9;
  border-bottom:1px solid #d4dee9;
  border-radius:0;
  background:transparent;
}

.exp-search-cycle-grid .exp-search-kv:nth-child(4n){
  border-right:0;
}

.exp-search-movements{
  padding:10px 12px;
}

.exp-search-movements summary{
  cursor:pointer;
  color:#315b98;
  font-weight:850;
}

.exp-search-empty{
  padding:24px;
  text-align:center;
  color:#60758d;
}

.exp-search-origin{
  display:inline-block;
  margin-top:5px;
  padding:4px 7px;
  border-radius:999px;
  background:#fff4d9;
  color:#785d0c;
  font-size:10px;
  font-weight:800;
}

@media(max-width:1200px){
  .exp-search-summary-grid,
  .exp-search-cycle-grid{
    grid-template-columns:repeat(2,minmax(150px,1fr));
  }
  .exp-search-cycle-grid .exp-search-kv:nth-child(4n){
    border-right:1px solid #d4dee9;
  }
  .exp-search-cycle-grid .exp-search-kv:nth-child(2n){
    border-right:0;
  }
}

@media(max-width:700px){
  .exp-search-toolbar,
  .exp-search-summary-grid,
  .exp-search-cycle-grid{
    grid-template-columns:1fr;
  }
  .exp-search-cycle-grid .exp-search-kv{
    border-right:0;
  }
}

/* source:v69-cambios-solo-perfil-usuario */
/* =========================================================
   V69 · CAMBIOS EXCLUSIVOS DEL PERFIL USUARIO
   ADMINISTRADOR Y ARCHIVO CONSERVAN EL DISEÑO V65.
   ========================================================= */

.user-only-session-top{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:7px;
  flex-wrap:wrap;
}

/* Solo cuando el perfil es USUARIO se reorganiza la cabecera */
.app.role-user .topbar{
  display:grid !important;
  grid-template-columns:minmax(0,1fr) auto !important;
  align-items:start !important;
  column-gap:14px !important;
  row-gap:9px !important;
}

.app.role-user .topbar > .title{
  grid-column:1 !important;
  grid-row:1 !important;
}

.app.role-user .topbar > .user-only-session-top{
  grid-column:2 !important;
  grid-row:1 !important;
}

.app.role-user .topbar > .actions{
  grid-column:1 / -1 !important;
  grid-row:2 !important;
  width:100% !important;
}

.user-only-session-name{
  display:inline-flex;
  align-items:center;
  gap:6px;
  min-height:34px;
  padding:0 10px;
  border:1px solid #c7d4e2;
  border-radius:8px;
  background:#f8fbfe;
  color:#173f6b;
  font-size:11px;
  font-weight:850;
}

.user-only-alerts-btn{
  background:#c62828 !important;
  color:#fff !important;
  border:1px solid #a91f1f !important;
  box-shadow:0 2px 6px rgba(198,40,40,.20) !important;
}

.user-only-alerts-btn:hover{
  background:#ad2020 !important;
  color:#fff !important;
}

.user-only-alerts-btn .alerts-badge,
.user-only-alerts-btn .alerts-badge.zero{
  background:#fff !important;
  color:#b91c1c !important;
  border:1px solid #fff !important;
}

/* Eliminar el espacio dejado por "Usuario seleccionado" solo en Usuario */
.app.role-user #ownerDetailFilters{
  grid-template-columns:minmax(280px,1.4fr) minmax(220px,1fr) !important;
}

@media(max-width:900px){
  .app.role-user .topbar{
    grid-template-columns:1fr !important;
  }

  .app.role-user .topbar > .title{
    grid-column:1 !important;
    grid-row:1 !important;
  }

  .app.role-user .topbar > .user-only-session-top{
    grid-column:1 !important;
    grid-row:2 !important;
    justify-content:flex-end !important;
  }

  .app.role-user .topbar > .actions{
    grid-column:1 !important;
    grid-row:3 !important;
  }
}

@media(max-width:700px){
  .app.role-user #ownerDetailFilters{
    grid-template-columns:1fr !important;
  }
}

/* source:v70-usuario-buscador-superior */
/* =========================================================
   V70 · PERFIL USUARIO
   El Buscador se abre desde la barra superior.
   Se elimina su botón duplicado de la fila de pestañas.
   ========================================================= */

.app.role-user #tabBtnExpSearch{
  display:none !important;
}

/* source:v72-usuario-buscador-total-custodia-corregidos */
/* =========================================================
   V72 · CAMBIOS SOLO PERFIL USUARIO
   - Botón "Buscador de expedientes" más grande
   - Tarjeta "Total en custodia" más grande, pero sin desbordes
   ========================================================= */

/* Botón superior Buscador de expedientes */
.app.role-user #searchRequestBtn{
  min-height:44px !important;
  padding:10px 18px !important;
  font-size:14px !important;
  font-weight:850 !important;
  border-radius:9px !important;
  min-width:220px !important;
  justify-content:center !important;
}

/* Ajuste del contenedor de KPIs para que la primera tarjeta respire mejor */
.app.role-user #userPersonalKpis{
  align-items:stretch !important;
}

/* Tarjeta principal TOTAL EN CUSTODIA */
.app.role-user #userPersonalKpis #userKpiAllCard{
  min-width:0 !important;
  min-height:96px !important;
  padding:12px 16px !important;
  grid-column:span 2 !important;
  border:2px solid #315b98 !important;
  box-shadow:0 4px 12px rgba(23,63,107,.10) !important;
  display:grid !important;
  grid-template-columns:minmax(0,1fr) auto !important;
  grid-template-areas:
    "label value"
    "action action" !important;
  column-gap:12px !important;
  row-gap:8px !important;
  overflow:hidden !important;
}

/* Reordenar contenido interno */
.app.role-user #userKpiAllCard .label{
  grid-area:label !important;
  font-size:14px !important;
  font-weight:900 !important;
  color:#173f6b !important;
  line-height:1.15 !important;
  white-space:normal !important;
  align-self:start !important;
}

.app.role-user #userKpiAllCard .value{
  grid-area:value !important;
  font-size:48px !important;
  font-weight:900 !important;
  line-height:.95 !important;
  color:#173f6b !important;
  justify-self:end !important;
  align-self:start !important;
  text-align:right !important;
  min-width:34px !important;
}

.app.role-user #userKpiAllCard .kpi-view{
  grid-area:action !important;
  font-size:12px !important;
  font-weight:800 !important;
  margin-top:0 !important;
  align-self:end !important;
}

/* Mantener las demás tarjetas en tamaño normal */
.app.role-user #userPersonalKpis .kpi:not(#userKpiAllCard){
  min-height:62px !important;
}

/* En pantallas medianas, la tarjeta principal vuelve a ocupar una columna */
@media(max-width:1100px){
  .app.role-user #userPersonalKpis #userKpiAllCard{
    grid-column:span 1 !important;
  }
}

@media(max-width:760px){
  .app.role-user #searchRequestBtn{
    min-width:190px !important;
    width:auto !important;
  }

  .app.role-user #userPersonalKpis #userKpiAllCard{
    width:100% !important;
    min-width:0 !important;
    grid-column:span 1 !important;
  }
}

@media(max-width:520px){
  .app.role-user #searchRequestBtn{
    width:100% !important;
  }
}

/* source:v73-numero-total-custodia */
/* V73 · Solo perfil USUARIO */
.app.role-user #userKpiAllCard .value{
  font-size:48px !important;
  font-weight:900 !important;
  line-height:.95 !important;
  min-width:52px !important;
  letter-spacing:-1px !important;
}

/* source:v78-fechas-panel-usuario */
/* =========================================================
   V78 · FECHA/HORA DE SOLICITUD + FECHA/HORA DEL ÚLTIMO ESTADO
   Aplicado a las tablas de expedientes fuera del Registro Maestro.
   ========================================================= */

#panelTable table .datetime-cell{
  align-items:center !important;
  justify-content:center !important;
  min-width:92px !important;
}

#panelTable table .datetime-date{
  font-weight:800 !important;
  white-space:nowrap !important;
}

#panelTable table .datetime-time{
  margin-top:2px !important;
  white-space:nowrap !important;
}

/* source:v81-cargo-horizontal-solicitudes */
/* =========================================================
   V81 · SOLICITUDES
   - Sin columnas de ingreso a atención
   - Cargo en una sola línea horizontal
   ========================================================= */

#requestsTable .rq-cargo-col{
  min-width:105px !important;
  width:105px !important;
  max-width:120px !important;
  white-space:nowrap !important;
  text-align:center !important;
}

#requestsTable .rq-cargo-inline{
  display:inline-block !important;
  white-space:nowrap !important;
  word-break:normal !important;
  overflow-wrap:normal !important;
  font-weight:800 !important;
}

/* V456 · Solicitudes: Asunto es texto nativo del TD, sin DIV/SPAN ni line-clamp. */
#requestsTable table th:nth-child(6),
#requestsTable table td:nth-child(6){
  min-width:280px !important;
  width:360px !important;
  max-width:430px !important;
  white-space:normal !important;
  overflow-wrap:anywhere !important;
  word-break:normal !important;
  line-height:1.3 !important;
  overflow:visible !important;
  contain:none !important;
  content-visibility:visible !important;
  transform:none !important;
  will-change:auto !important;
}

/* V456: eliminado source:v86-asuntos-largos-ajustados; Asunto ya no usa capa -webkit-box. */

/* source:v88-responsable-atencion-devueltos */
/* V88 · Devueltos al Archivo */
#panelTable table th:nth-child(4),
#panelTable table td:nth-child(4){
  min-width:150px !important;
  white-space:normal !important;
  text-align:center !important;
}

/* source:v89-buscador-misma-logica-agregar */
/* =========================================================
   V89 · BUSCADOR DE EXPEDIENTES
   Mismo contexto operativo que "Agregar expediente".
   ========================================================= */

.exp-search-choice-context{
  display:grid;
  grid-template-columns:repeat(3,minmax(150px,1fr));
  gap:6px;
  margin-top:7px;
}

.exp-search-choice-context span{
  display:block;
  padding:5px 7px;
  border:1px solid #d4e0ec;
  border-radius:6px;
  background:#ffffff;
  color:#405873;
  font-size:10px;
  line-height:1.25;
}

.exp-search-choice-context b{
  color:#173f6b;
}

@media(max-width:900px){
  .exp-search-choice-context{
    grid-template-columns:1fr;
  }
}

/* source:v101-asunto-expedientes */
/* V452 · Asunto renderizado como texto normal dentro de la celda.
   Se elimina -webkit-line-clamp/-webkit-box porque generaba capas de pintura
   obsoletas al reemplazar tablas dinámicamente en Chrome/Edge. */
@media(max-width:1100px){
  }

.state-detail-native-table{
  width:100% !important;
  border-collapse:collapse !important;
  table-layout:auto !important;
}
#tab-states:not(.hidden),
#tab-states #stateDetailBox,
#tab-states #stateDetailTable,
#tab-states .returned-table-scroll{
  height:auto !important;
  max-height:none !important;
  overflow-y:visible !important;
  contain:none !important;
  content-visibility:visible !important;
}
#tab-states #stateDetailTable{overflow-x:auto !important;}
#tab-states .returned-table-scroll{overflow-x:auto !important;}
#tab-states table thead th{position:static !important;}

/* source:v106-devolucion-aceptacion */
/* =========================================================
   V106 · DEVOLUCIÓN
   Fecha/hora = momento de aceptación física por Archivo/Admin.
   ========================================================= */

#panelTable .historical-return-accepted-at{
  min-width:120px !important;
  text-align:center !important;
  white-space:nowrap !important;
}

#panelTable .historical-return-accepted-by{
  min-width:150px !important;
  max-width:190px !important;
  text-align:center !important;
  white-space:normal !important;
}

#panelTable .historical-return-accepted-by b{
  color:#173f6b !important;
}

/* source:v107-horas-pendientes-devolucion */
/* V107 · Fecha + hora en pendientes y devoluciones */
.return-request-datetime .datetime-cell{
  min-width:105px !important;
  justify-content:center !important;
  align-items:center !important;
}

/* source:v108-registro-maestro-negrita */
/* =========================================================
   V108 · REGISTRO MAESTRO
   Todo el contenido textual de las filas en negrita.
   ========================================================= */

#allTable table.master-v19 tbody td{
  font-weight:700 !important;
}

/* Asegurar que textos internos no vuelvan a peso normal */
#allTable table.master-v19 tbody td span,
#allTable table.master-v19 tbody td div,
#allTable table.master-v19 tbody td small,
#allTable table.master-v19 tbody td a{
  font-weight:700 !important;
}

/* Los elementos principales quedan un poco más marcados */
#allTable table.master-v19 tbody td b,
#allTable table.master-v19 tbody td strong,
#allTable table.master-v19 tbody td .pill,
#allTable table.master-v19 tbody td .list-status,
#allTable table.master-v19 tbody td .sede-badge{
  font-weight:800 !important;
}

/* Encabezados se mantienen claramente diferenciados */
#allTable table.master-v19 thead th{
  font-weight:800 !important;
}

/* source:v109-ultimo-folio-compacto */
/* =========================================================
   V109 · PENDIENTES POR ATENDER
   Columna "Último folio" más compacta sin reducir la letra.
   ========================================================= */

#panelTable table.pending-attention-table th.pending-folio-col,
#panelTable table.pending-attention-table td.pending-folio-col{
  width:82px !important;
  min-width:72px !important;
  max-width:88px !important;
  padding-left:6px !important;
  padding-right:6px !important;
  white-space:nowrap !important;
  text-align:center !important;
}

/* El espacio liberado queda disponible principalmente para Asunto */
#panelTable table.pending-attention-table th:nth-child(6),
#panelTable table.pending-attention-table td:nth-child(6){
  width:auto !important;
}

/* source:v112-ultimo-movimiento-reasignacion */
/* V112 · Último movimiento */
#panelTable td:nth-child(8){
  white-space:normal !important;
  overflow-wrap:break-word !important;
  min-width:165px !important;
}

/* source:v113-devuelto-por-solo-nombre */
/* V113 · Devuelto por: únicamente nombre de la persona */
#panelTable .historical-returner-name{
  min-width:135px !important;
  text-align:center !important;
  white-space:normal !important;
}
#panelTable .historical-returner-name b{
  font-weight:800 !important;
  color:#173f6b !important;
}

/* source:v114-registro-maestro-ultimo-traslado */
/* V114 · Reasignación / último traslado del ciclo */
#allTable table.master-v19 td.v19-reassignment-single .master-v18-reassign-main{
  font-weight:800 !important;
}

/* source:v116-listados-por-ciclo */
/* V116 · Campos adicionales / Listados por ciclo */
.list-destination{
  line-height:1.15 !important;
}

/* source:base */
#requestDetailLoading{display:none;padding:28px 12px;color:#334155;font-size:16px}
#requestDetailModal.detail-loading .modal-box>:not(.modal-head):not(#requestDetailLoading){display:none!important}
#requestDetailModal.detail-loading #requestDetailLoading{display:block}

/* source:base */
.active-request-brief{display:block;max-width:290px;white-space:normal;line-height:1.4;margin-top:4px;color:#92400e;font-size:12px;font-weight:500}

/* source:v134-perfil-usuario-solo-dos-modulos */
/* =========================================================
   V134 · PERFIL USUARIO: SOLO MIS EXPEDIENTES Y MIS SOLICITUDES
   Las demás actividades quedan reservadas a ARCHIVO / ADMINISTRADOR.
   Esta regla corrige además el display:flex de V133, que podía volver
   visibles pestañas marcadas como hidden-by-role.
   ========================================================= */
.tabs .tab.hidden-by-role,
.main-sticky-header .tabs .tab.hidden-by-role{
  display:none !important;
}

/* Refuerzo visual exclusivo del perfil USUARIO. */
.app.limited-user .tabs .tab:not([data-tab="panel"]):not([data-tab="requests"]){
  display:none !important;
}

/* Con solo dos módulos, ambos aprovechan el ancho disponible. */
.app.limited-user .main-sticky-header .tabs,
.app.limited-user .tabs{
  grid-template-columns:repeat(2,minmax(0,1fr)) !important;
}

.app.limited-user .main-sticky-header .tabs .tab[data-tab="panel"],
.app.limited-user .main-sticky-header .tabs .tab[data-tab="requests"],
.app.limited-user .tabs .tab[data-tab="panel"],
.app.limited-user .tabs .tab[data-tab="requests"]{
  display:flex !important;
}

@media(max-width:520px){
  .app.limited-user .main-sticky-header .tabs,
  .app.limited-user .tabs{
    grid-template-columns:1fr 1fr !important;
  }
}

/* source:v135-usuario-acciones-y-tabs-compactas */
/* =========================================================
   V135 · PERFIL USUARIO
   1) Mantiene arriba: Reasignar, Devolver, CONAS, DVC e Instrucción.
   2) Mis expedientes y Mis solicitudes quedan alineadas a la izquierda
      y ya no ocupan todo el ancho de la fila.
   ========================================================= */

/* Las dos actividades del perfil USUARIO se comportan como botones
   compactos, no como columnas que rellenan toda la franja. */
.app.limited-user .main-sticky-header .tabs,
.app.limited-user .tabs{
  display:flex !important;
  grid-template-columns:none !important;
  flex-wrap:wrap !important;
  justify-content:flex-start !important;
  align-items:center !important;
  align-content:flex-start !important;
  gap:6px !important;
  width:100% !important;
  max-width:100% !important;
  overflow:visible !important;
  white-space:normal !important;
}

.app.limited-user .main-sticky-header .tabs .tab[data-tab="panel"],
.app.limited-user .main-sticky-header .tabs .tab[data-tab="requests"],
.app.limited-user .tabs .tab[data-tab="panel"],
.app.limited-user .tabs .tab[data-tab="requests"]{
  display:inline-flex !important;
  flex:0 0 auto !important;
  width:auto !important;
  min-width:160px !important;
  max-width:220px !important;
  justify-content:center !important;
  text-align:center !important;
  padding:9px 18px !important;
  white-space:nowrap !important;
}

/* La botonera operativa del usuario puede bajar de línea cuando la
   pantalla se reduce, sin ocultar las acciones de derivación. */
.app.limited-user .topbar .actions{
  display:flex !important;
  flex-wrap:wrap !important;
  justify-content:flex-start !important;
  align-items:center !important;
  gap:7px !important;
  width:100% !important;
}

.app.limited-user #bulkReassignBtn,
.app.limited-user #bulkReturnBtn,
.app.limited-user #bulkConasBtn,
.app.limited-user #bulkDvcBtn,
.app.limited-user #bulkInstructionBtn{
  flex:0 0 auto !important;
  white-space:nowrap !important;
}

@media(max-width:700px){
  .app.limited-user .main-sticky-header .tabs .tab[data-tab="panel"],
  .app.limited-user .main-sticky-header .tabs .tab[data-tab="requests"],
  .app.limited-user .tabs .tab[data-tab="panel"],
  .app.limited-user .tabs .tab[data-tab="requests"]{
    min-width:140px !important;
    max-width:none !important;
    padding:8px 13px !important;
  }
}

@media(max-width:420px){
  .app.limited-user .main-sticky-header .tabs .tab[data-tab="panel"],
  .app.limited-user .main-sticky-header .tabs .tab[data-tab="requests"],
  .app.limited-user .tabs .tab[data-tab="panel"],
  .app.limited-user .tabs .tab[data-tab="requests"]{
    min-width:0 !important;
    width:auto !important;
    padding:8px 11px !important;
    font-size:10px !important;
  }
}

/* source:v139-role-tabs-hardening */
/* =========================================================
   V139 · REFUERZO DE VISIBILIDAD POR ROL
   ARCHIVO: sin Expedientes por usuario, Resumen,
            Solicitudes por abogado ni Buscador de expedientes.
   ADMINISTRADOR: sin Buscador de expedientes.
   ========================================================= */
.app.role-archive .tabs .tab[data-tab="panel"],
.app.role-archive .tabs .tab[data-tab="summary"],
.app.role-archive .tabs .tab[data-tab="requestsByLawyer"],
.app.role-archive .tabs .tab[data-tab="expSearch"],
.app.role-archive .main-sticky-header .tabs .tab[data-tab="panel"],
.app.role-archive .main-sticky-header .tabs .tab[data-tab="summary"],
.app.role-archive .main-sticky-header .tabs .tab[data-tab="requestsByLawyer"],
.app.role-archive .main-sticky-header .tabs .tab[data-tab="expSearch"]{
  display:none !important;
}

.app.role-admin .tabs .tab[data-tab="expSearch"],
.app.role-admin .main-sticky-header .tabs .tab[data-tab="expSearch"]{
  display:none !important;
}

/* source:v140-tabs-letras-mas-grandes-y-negritas */
/* =========================================================
   V140 · TABS SUPERIORES CON LETRAS MÁS GRANDES Y MÁS NEGRITAS
   - Aplica a Estados, Solicitudes, Registro maestro y demás pestañas.
   - Mantiene el comportamiento adaptable de las versiones previas.
   ========================================================= */
.main-sticky-header .tab,
.tabs .tab,
.tab{
  font-size:12.5px !important;
  font-weight:800 !important;
  line-height:1.15 !important;
  letter-spacing:0 !important;
}

.main-sticky-header .tab.active,
.tabs .tab.active,
.tab.active{
  font-weight:800 !important;
}

@media (max-width: 1200px){
  .main-sticky-header .tab,
  .tabs .tab,
  .tab{
    font-size:11.5px !important;
    font-weight:800 !important;
  }
}

@media (max-width: 700px){
  .main-sticky-header .tab,
  .tabs .tab,
  .tab{
    font-size:10.5px !important;
    font-weight:800 !important;
  }
}

/* source:v141-filtros-solicitudes-carga-visible */
/* =========================================================
   V141 · FILTROS DE SOLICITUDES MÁS RÁPIDOS + CARGA VISIBLE
   ========================================================= */
.request-filter-status{
  display:inline-flex;
  align-items:center;
  gap:6px;
  min-height:26px;
  padding:4px 9px;
  border:1px solid #c7d6e5;
  border-radius:999px;
  background:#f7fbff;
  color:#45627f;
  font-size:10px;
  font-weight:800;
  white-space:nowrap;
}
.request-filter-status.loading{
  background:#eef6ff;
  border-color:#bdd4ea;
  color:#174c7a;
}
.request-filter-status.ready{
  background:#edf8f1;
  border-color:#c6e3d0;
  color:#21613a;
}
.request-filter-spinner{
  width:11px;
  height:11px;
  border:2px solid #bad0e4;
  border-top-color:#255784;
  border-radius:50%;
  animation:requestFilterSpin .65s linear infinite;
}
@keyframes requestFilterSpin{to{transform:rotate(360deg)}}
#requestsTable.request-filter-loading{
  opacity:.58;
  pointer-events:none;
  transition:opacity .12s ease;
}
@media(prefers-reduced-motion:reduce){
  .request-filter-spinner{animation:none}
}

/* source:v142-solicitudes-sin-bloque-de-filtros */
/* =========================================================
   V142 · SOLICITUDES SIN BLOQUE DE FILTROS SUPERIOR
   - Se oculta el bloque "Buscar solicitud / Etapa de atención / Origen / Limpiar filtros".
   - La navegación en Solicitudes queda apoyada en las tarjetas superiores.
   - Se conserva la lógica interna para no romper funciones existentes.
   ========================================================= */
#tab-requests > .card.filters{
  display:none !important;
}

/* source:v147-cargo-observacion-individual */
/* =========================================================
   V147 · OBSERVACIÓN INDIVIDUAL POR EXPEDIENTE EN CARGOS
   ========================================================= */
#cargoSelectedList table{
  width:100%;
  table-layout:auto;
}
#cargoSelectedList th,
#cargoSelectedList td{
  text-align:center;
  vertical-align:middle;
}
#cargoSelectedList th:last-child,
#cargoSelectedList td:last-child{
  min-width:230px;
  text-align:left;
}
.cargo-item-observation{
  width:100%;
  min-width:210px;
  min-height:54px;
  box-sizing:border-box;
  resize:vertical;
  border:1px solid var(--line);
  border-radius:7px;
  padding:7px 8px;
  font:inherit;
  line-height:1.25;
  background:#fff;
}
.cargo-item-observation:focus{
  outline:2px solid #bfdbfe;
  border-color:#2f6da3;
}

/* source:v148-estado-cache-rapido */
/* V148: transición entre tarjetas de Estados más fluida; el contenido cacheado
   se pinta inmediatamente y los datos complementarios se actualizan en segundo plano. */
.state-card.selected{transition:border-color .12s ease,box-shadow .12s ease,background .12s ease;}

/* source:produce-v150 */
body.produce-ui{font-family:Arial,Helvetica,sans-serif;background:#eff7ff;color:#091746}
.produce-top{height:72px;position:fixed;inset:0 0 auto;z-index:45;display:flex;align-items:center;background:linear-gradient(135deg,#10385f 10%,#285b92 62%,#09335e 62%);color:#fff;box-shadow:0 1px 6px #16365520}
.produce-brand{align-self:stretch;width:193px;flex-shrink:0;display:grid;place-items:center;background:#ce0028;color:white;font-weight:800;font-size:29px;letter-spacing:-.7px}
.produce-org{padding:0 26px;line-height:1.5;font-size:15px}.produce-org strong{display:block;font-size:18px}
.produce-account{margin-left:auto;display:flex;align-items:center;gap:22px;padding:0 28px;font-size:14px}.produce-person{display:flex;align-items:center;gap:12px}.produce-avatar{background:#6196d0;border-radius:50%;display:grid;place-items:center;width:33px;height:33px}.produce-account small{display:block;margin-top:4px;font-size:12px}.produce-account button{cursor:pointer;border:1px solid #dbe6f3;border-radius:6px;background:#f8fbff;color:#071747;font-size:14px;font-weight:700;padding:12px 20px;display:flex;gap:12px;align-items:center}
.produce-bell{position:relative!important;background:none!important;color:#fff!important;border:0!important;padding:8px!important}.produce-bell b{position:absolute;right:0;top:-3px;background:#e50025;color:#fff;border-radius:20px;min-width:20px;padding:3px;font-size:12px}
.p-icon{width:22px;height:22px;flex-shrink:0;display:inline-block;vertical-align:middle;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.produce-nav{display:none;position:fixed;top:72px;bottom:0;left:0;width:239px;z-index:35;padding:18px 12px 95px;background:linear-gradient(155deg,#f7fbff,#edf7ff);border-right:1px solid #e2edf9;overflow-y:auto}
.produce-nav button{display:flex;width:100%;align-items:center;gap:16px;padding:14px 16px;min-height:49px;margin-bottom:2px;background:none;border:1px solid transparent;color:#091954;text-align:left;border-radius:7px;font:15px/1.4 Arial;cursor:pointer}
.produce-nav button.active{background:linear-gradient(135deg,#075cae,#03498c);color:#fff;font-weight:700;border-color:#4583bd}.produce-nav button:disabled{opacity:.56;cursor:not-allowed}.produce-nav button:focus-visible{outline:3px solid #6397ed}
.produce-nav footer{position:fixed;bottom:0;left:0;width:238px;background:#edf7ff;padding:20px 26px;font-size:11px;line-height:1.7;color:#3b6290}.produce-nav footer strong{display:block;color:#071c58}
body.produce-ui .app{padding-top:72px!important}
