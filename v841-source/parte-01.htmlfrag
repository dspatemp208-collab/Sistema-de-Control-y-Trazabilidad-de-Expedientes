<meta content="no-cache, no-store, must-revalidate" http-equiv="Cache-Control"/>
<meta content="no-cache" http-equiv="Pragma"/>
<meta content="0" http-equiv="Expires"/>
<title>Sistema de Control y Trazabilidad de Expedientes</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<!-- ESTADO REASIGNADO ACTIVO -->
<!-- TARJETAS SOLICITUDES COMPACTAS -->
<!-- CORRECCIÓN ESTADOS SIN TARJETAS SUPERIORES -->
<!-- REGISTRO MAESTRO V5: PENDIENTE POR ATENDER INTEGRADO -->
<!-- SELECCION Y DESELECCION DEVUELTOS -->
<!-- REGISTRO MAESTRO Y EN PRESTAMO INMOVILIZADOS -->
<!-- V246: BÚSQUEDA · LISTADO DE DEVOLUCIÓN + UBICACIÓN BARRENECHEA / SAN LUIS -->
<!-- V311: DESTINO DEL LISTADO Y UBICACIÓN FÍSICA ACTUAL DIFERENCIADOS -->
<!-- V247: DEVUELTOS AL ARCHIVO · FILTROS Y SELECCIÓN PERSISTEN DURANTE ACTUALIZACIONES -->
<!-- V663 · CONAS / DVC / Instrucción: derivación masiva por Excel, varios memorandos y un correo -->
<!-- V655 · Gestión múltiple usa la misma plantilla oficial que Nueva solicitud -->
<!-- V657 · Devolución al Archivo sincroniza estado, ubicación y búsqueda -->
<!-- V264 FINAL · Gestión múltiple por Excel
     - Conserva respaldo de Solicitudes para Administrador/Archivo.
     - Conserva filtros persistentes de Devueltos al Archivo.
     - Conserva mejoras de estados, cargos, historial, ubicaciones y perfiles.
     - Elimina todos los módulos y accesos de simulación/prueba.
-->
<style id="v453-css-consolidado">

/* source:base */
:root{--navy:#17365d;--blue:#1f4e78;--sky:#d9eaf7;--bg:#f4f7fb;--line:#d7e0ea;--text:#1f2937;--muted:#64748b;--ok:#e2f0d9;--warn:#fff2cc;--danger:#f4cccc;--white:#fff;--shadow:0 8px 24px rgba(23,54,93,.08);--block:#fbfcff;--block-soft:#f8fbff;--block-muted:#f8fafc;--block-warm:#fffaf3;--block-danger:#fff7f7}
*{box-sizing:border-box}body{margin:0;font-family:Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--text)}
.app{display:grid;grid-template-columns:285px 1fr;min-height:100vh}
.sidebar{background:var(--navy);color:white;padding:18px 14px;overflow:auto;position:sticky;top:0;height:100vh}
.brand{font-weight:800;font-size:18px;line-height:1.25;padding:5px 8px 16px;border-bottom:1px solid rgba(255,255,255,.18);margin-bottom:14px}.brand small{display:block;font-size:11px;font-weight:500;opacity:.75;margin-top:5px}
.side-title{font-size:11px;text-transform:uppercase;letter-spacing:.08em;opacity:.65;margin:16px 8px 7px}.side-item{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 10px;border-radius:8px;cursor:pointer;font-size:12px;margin:2px 0}.side-item:hover,.side-item.active{background:rgba(255,255,255,.14)}.badge{background:rgba(255,255,255,.17);padding:2px 7px;border-radius:999px;font-size:11px;min-width:24px;text-align:center}
.main{padding:22px;min-width:0}.topbar{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:16px;flex-wrap:wrap}.title h1{margin:0;font-size:24px;color:var(--navy)}.title p{margin:4px 0 0;color:var(--muted);font-size:13px}
.actions{display:flex;gap:8px;flex-wrap:wrap}.btn{border:0;border-radius:8px;padding:9px 13px;font-weight:650;cursor:pointer;background:var(--blue);color:white}.btn.secondary{background:white;color:var(--navy);border:1px solid var(--line)}.btn.small{padding:6px 9px;font-size:12px}.btn:disabled{opacity:.55;cursor:not-allowed}
.tabs{display:flex;gap:7px;margin-bottom:14px;flex-wrap:wrap}.tab{border:1px solid var(--line);background:white;color:var(--muted);padding:8px 13px;border-radius:8px;cursor:pointer;font-weight:650}.tab.active{background:var(--navy);color:white;border-color:var(--navy)}
.card{background:var(--block);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow)}.filters{display:grid;grid-template-columns:minmax(260px,2fr) minmax(220px,1fr) auto;gap:12px;padding:14px;margin-bottom:14px;background:var(--block-soft)}
.field label{display:block;font-size:11px;font-weight:700;color:var(--muted);margin-bottom:5px;text-transform:uppercase}.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:7px;padding:9px 10px;font:inherit;background:white}.field textarea{min-height:72px;resize:vertical}
.kpis{display:grid;grid-template-columns:repeat(4,minmax(150px,1fr));gap:12px;margin-bottom:14px}
.kpi-view{margin-top:9px;border:0;background:transparent;padding:0;color:var(--navy);font:inherit;font-size:12px;font-weight:750;cursor:pointer;text-decoration:underline;text-underline-offset:2px}
.kpi-view:hover{opacity:.75}
.kpi.quick-active{outline:2px solid var(--navy);outline-offset:1px}
.kpi.quick-active.warn{outline-color:#a15c00}
.kpi.quick-active.danger{outline-color:#a61b1b}.kpi{padding:14px 16px;background:var(--block-soft)}.kpi .label{font-size:11px;text-transform:uppercase;font-weight:800;color:var(--muted)}.kpi .value{font-size:28px;font-weight:800;color:var(--navy);margin-top:4px}.kpi.warn{background:var(--block-warm)}.kpi.danger{background:var(--block-danger)}.kpi.warn .value{color:#a15c00}.kpi.danger .value{color:#a61b1b}
.table-wrap{overflow-x:auto;overflow-y:visible}.table-head{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-bottom:1px solid var(--line);gap:10px}.table-head strong{color:var(--navy)}table{border-collapse:collapse;width:100%;font-size:12px}th{position:static;top:0;background:var(--navy);color:white;text-align:left;padding:9px 8px;white-space:nowrap}td{padding:8px;border-bottom:1px solid #edf1f5;vertical-align:top}tr:hover td{background:#f8fbff}
.pill{display:inline-block;padding:3px 7px;border-radius:999px;font-weight:700;font-size:10px;background:#e8eef6}.pill.loan{background:var(--warn)}.pill.returned{background:var(--ok)}.pill.alert{background:var(--danger);color:#8a1414}.empty{padding:30px;text-align:center;color:var(--muted)}
.summary-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:10px}.summary-card{padding:12px 14px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;background:var(--block-soft)}.summary-card h3{margin:0;font-size:13px}.summary-card small{display:block;color:var(--muted);margin-top:3px}.summary-num{font-size:22px;font-weight:800;color:var(--navy)}
.modal{display:none;position:fixed;inset:0;background:rgba(15,23,42,.60);z-index:30;align-items:center;justify-content:center;padding:18px}.modal.show{display:flex}.modal-box{background:white;border-radius:14px;max-width:1050px;width:100%;max-height:92vh;overflow:auto;padding:18px;box-shadow:0 24px 80px rgba(0,0,0,.25)}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.modal-head h2{margin:0;color:var(--navy)}.form-grid{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:10px}.span2{grid-column:span 2}.span4{grid-column:span 4}.modal-foot{display:flex;justify-content:flex-end;gap:8px;margin-top:14px;border-top:1px solid var(--line);padding-top:13px}
.note{font-size:12px;color:var(--muted);padding:10px 12px;background:var(--block-muted);border:1px solid var(--line);border-radius:8px}.hidden{display:none!important}.toast{position:fixed;right:22px;bottom:22px;z-index:60;background:var(--navy);color:#fff;padding:11px 15px;border-radius:9px;box-shadow:0 8px 24px rgba(23,54,93,.22);font-size:12px;font-weight:700;opacity:0;transform:translateY(8px);pointer-events:none;transition:.18s}.toast.show{opacity:1;transform:translateY(0)}
.statusbar{font-size:12px;color:var(--muted);padding:8px 12px;margin-bottom:12px;background:var(--block-muted);border:1px solid var(--line);border-radius:8px}.pager{display:flex;align-items:center;gap:7px}.pager span{font-size:12px;color:var(--muted)}
.history-summary{display:grid;grid-template-columns:repeat(4,minmax(130px,1fr));gap:10px;margin-bottom:14px}.history-summary .mini{background:var(--block-soft);border:1px solid var(--line);border-radius:9px;padding:10px 12px}.history-summary .mini span{display:block;font-size:10px;text-transform:uppercase;font-weight:800;color:var(--muted);margin-bottom:4px}.history-summary .mini b{color:var(--navy);font-size:14px}
.timeline{position:relative;margin:12px 0 4px;padding-left:24px}.timeline:before{content:"";position:absolute;left:8px;top:4px;bottom:4px;width:2px;background:#cbd5e1}.timeline-item{position:relative;background:var(--block-soft);border:1px solid var(--line);border-radius:10px;padding:11px 13px;margin-bottom:10px}.timeline-item:before{content:"";position:absolute;left:-21px;top:16px;width:10px;height:10px;border-radius:50%;background:var(--blue);border:2px solid #fff;box-shadow:0 0 0 2px #cbd5e1}.timeline-item .t-date{font-size:11px;color:var(--muted);font-weight:700}.timeline-item .t-action{font-size:13px;color:var(--navy);font-weight:800;margin:3px 0}.timeline-item .t-detail{font-size:12px;color:var(--text);line-height:1.45}.timeline-item .t-meta{font-size:11px;color:var(--muted);margin-top:5px}
.auth-box{max-width:470px}.auth-logo{font-size:22px;color:var(--navy);font-weight:850;margin-bottom:3px}.config-help{font-size:11px;color:var(--muted);line-height:1.5;margin-top:7px}
@media(max-width:980px){.app{grid-template-columns:1fr}.sidebar{position:relative;height:auto}.main{padding:14px}.kpis{grid-template-columns:repeat(2,1fr)}.form-grid{grid-template-columns:repeat(2,1fr)}.span4{grid-column:span 2}}
@media(max-width:600px){.filters{grid-template-columns:1fr}.kpis{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.span2,.span4{grid-column:span 1}.history-summary{grid-template-columns:repeat(2,1fr)}}

.sel-count{font-size:12px;font-weight:750;color:var(--navy);padding:7px 10px;border:1px solid var(--line);border-radius:8px;background:#fff}
.cargo-preview-note{font-size:12px;color:var(--muted);margin-top:7px;line-height:1.45}
.cargo-list{max-height:260px;overflow:auto;border:1px solid var(--line);border-radius:9px;margin-top:10px}
.cargo-list table{font-size:11px}.cargo-list th{position:static;top:0}

.people-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr .7fr auto;gap:8px;align-items:end}
.people-table{margin-top:14px;border:1px solid var(--line);border-radius:9px;overflow:auto;max-height:420px}
.people-table table{font-size:12px}.people-actions{display:flex;gap:5px;white-space:nowrap}
.status-active{color:#1f6b35;font-weight:800}.status-inactive{color:#9b1c1c;font-weight:800}
@media(max-width:760px){.people-grid{grid-template-columns:1fr}.people-actions{flex-wrap:wrap}}

.record-mode{display:flex;gap:8px;margin:0 0 14px;flex-wrap:wrap}
.record-mode .mode-btn{border:1px solid var(--line);background:#fff;color:var(--navy);padding:8px 12px;border-radius:8px;font-weight:750;cursor:pointer}
.record-mode .mode-btn.active{background:var(--navy);color:#fff;border-color:var(--navy)}
.batch-box{border:1px solid var(--line);border-radius:10px;padding:12px;margin-top:12px;background:var(--block-soft)}
.batch-head{display:grid;grid-template-columns:1.2fr .65fr .85fr .7fr 1.2fr 44px;gap:6px;font-size:10px;font-weight:800;color:var(--muted);text-transform:uppercase;margin-bottom:5px}
.batch-row{display:grid;grid-template-columns:1.2fr .65fr .85fr .7fr 1.2fr 44px;gap:6px;margin-bottom:6px;align-items:center}
.batch-row input{width:100%;border:1px solid var(--line);border-radius:7px;padding:8px;font:inherit;background:white}
.batch-remove{height:36px;border:1px solid #efcaca;background:#fff;color:#9b1c1c;border-radius:7px;cursor:pointer;font-weight:800}
.batch-summary{font-size:12px;color:var(--muted);margin-top:8px}
.batch-cargo-info{font-size:12px;margin-top:7px;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:#f8fafc;color:var(--muted)}
@media(max-width:850px){
  .batch-head{display:none}
  .batch-row{grid-template-columns:1fr 1fr}
  .batch-row input:nth-child(5){grid-column:span 2}
  .batch-remove{width:44px}
}


.states-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px}
.state-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(245px,1fr));gap:10px;margin-bottom:14px}
.state-card{padding:14px;cursor:pointer;transition:.15s ease;border:1px solid var(--line);background:var(--block-soft)}
.state-card:hover{transform:translateY(-1px)}
.state-card.selected{outline:2px solid var(--navy);outline-offset:-2px}
.state-card .state-name{font-size:12px;font-weight:850;color:var(--navy);min-height:30px}
.state-card .state-count{font-size:28px;font-weight:900;margin-top:5px}
.state-card .state-meta{font-size:11px;color:var(--muted);margin-top:4px}
.state-progress{height:6px;background:#e9eef5;border-radius:999px;overflow:hidden;margin-top:9px}
.state-progress span{display:block;height:100%;background:var(--navy);border-radius:999px}
.state-detail-head{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
@media(max-width:760px){.states-kpis{grid-template-columns:1fr}.state-grid{grid-template-columns:1fr}}


.req-kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:12px}
.req-state{font-size:10px;font-weight:850;padding:4px 8px;border-radius:999px;display:inline-block;white-space:nowrap}
.req-solicitado{background:#fff4cc;color:#6d5100}
.req-atencion{background:#e9f2ff;color:#174c8a}
.req-aceptado{background:#e9f2ff;color:#174c8a}
.req-prestamo{background:#fee8d5;color:#8a4100}
.req-devuelto{background:#e6f5ea;color:#21613a}
.req-devolucion-solicitada{background:#f4eaff;color:#6b2c91}
.req-cancelado{background:#f2f2f2;color:#555}
.req-cerrado-admin{background:#f1f1f1;color:#2f3b4b;border:1px solid #cdd4dd}
.admin-close-summary{padding:10px 12px;border:1px solid #d8e0ea;border-radius:10px;background:#f8fafc;font-size:12px;line-height:1.55;max-height:180px;overflow:auto}
.admin-close-warning{padding:10px 12px;border:1px solid #f0d7a2;border-radius:10px;background:#fffaf0;color:#6b4c12;font-size:12px}

.req-summary{display:grid;grid-template-columns:repeat(4,minmax(120px,1fr));gap:8px;margin:10px 0}
.req-summary .mini{border:1px solid var(--line);border-radius:8px;padding:9px;background:var(--block-soft)}
.req-summary .mini b{display:block;font-size:18px;margin-top:3px}
.req-actions{display:flex;gap:6px;flex-wrap:wrap}
.req-detail-controls{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:12px 0}
.req-detail-controls .span3{grid-column:span 3}
.req-movements{max-height:230px;overflow:auto;border:1px solid var(--line);border-radius:8px;margin-top:10px}
@media(max-width:800px){
  .req-kpis,.req-summary{grid-template-columns:1fr 1fr}
  .req-detail-controls{grid-template-columns:1fr}
  .req-detail-controls .span3{grid-column:span 1}
}
@media(max-width:480px){.req-kpis,.req-summary{grid-template-columns:1fr}}


.app.limited-user{grid-template-columns:1fr}
.app.limited-user .sidebar{display:none}
.role-chip{display:inline-block;padding:3px 8px;border-radius:999px;font-size:10px;font-weight:850;background:#eef2f7;color:#334155}
.role-chip.admin{background:#e9e5ff;color:#4338ca}
.role-chip.archive{background:#e6f5ea;color:#21613a}
.role-chip.coordinator{background:#e8f4ff;color:#0f5f93;border:1px solid #b9d9ee}
.role-chip.user{background:#e9f2ff;color:#174c8a}
.user-perm-table{max-height:430px;overflow:auto;border:1px solid var(--line);border-radius:9px;margin-top:12px}
.user-perm-table select,.user-perm-table input{font-size:12px}
.permission-note{padding:9px 11px;border:1px solid var(--line);border-radius:8px;background:#f8fafc;font-size:12px;color:var(--muted)}
.request-search-results{max-height:360px;overflow:auto;border:1px solid var(--line);border-radius:8px;margin-top:10px}
.hidden-by-role{display:none!important}


.lawyer-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px;margin-bottom:14px}
.lawyer-card{border:1px solid var(--line);border-radius:10px;padding:14px;background:var(--block-soft)}
.lawyer-card h3{font-size:13px;color:var(--navy);margin:0 0 8px}
.lawyer-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:6px;font-size:11px;color:var(--muted)}
.lawyer-stats b{display:block;font-size:17px;color:var(--text);margin-top:2px}
.lawyer-total{font-size:27px;font-weight:900;color:var(--navy);margin:4px 0 8px}
.lawyer-actions{margin-top:10px;display:flex;gap:6px;flex-wrap:wrap}


.request-draft-box{margin-top:10px;border:1px solid var(--line);border-radius:9px;overflow:hidden}
.request-draft-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 11px;background:var(--block-muted);border-bottom:1px solid var(--line)}
.request-draft-box table{margin:0}
.request-draft-empty{padding:18px;text-align:center;color:var(--muted)}


.status-attn{font-size:10px;font-weight:850;padding:4px 8px;border-radius:999px;display:inline-block;white-space:nowrap}
.status-attn.requested{background:#fff4cc;color:#6d5100}
.status-attn.accepted{background:#e9f2ff;color:#174c8a}
.status-attn.partial{background:#f4eaff;color:#6b2c91}
.status-attn.total{background:#e6f5ea;color:#21613a}
.status-attn.returning{background:#fee8d5;color:#8a4100}
.status-attn.received{background:#dff4e6;color:#175c35}


.pill.reassigned{background:#f4eaff;color:#6b2c91}
.pill.reassign-requested{background:#fff0d9;color:#7a4a00;border:1px solid #e7c47f}
.pill.return-requested{background:#fee8d5;color:#8a4100}
.pill.archive-requested{background:#fff0e8;color:#984514;border:1px solid #f1c7ae}
.pill.returned-archive{background:#e6f5ea;color:#21613a}


.cargo-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.cargo-selected-row{background:#f7fbff}

/* Expediente seleccionado: resaltar toda la fila con alto contraste. */
.record-selected-row td{
  background:#dbeafe!important;
  color:#102f54!important;
  box-shadow:inset 0 1px 0 rgba(29,78,216,.10),inset 0 -1px 0 rgba(29,78,216,.10);
}
.record-selected-row td:first-child{
  box-shadow:inset 5px 0 0 #1d4ed8,inset 0 1px 0 rgba(29,78,216,.10),inset 0 -1px 0 rgba(29,78,216,.10);
}
.record-selected-row:hover td{
  background:#cfe2ff!important;
}
.record-selected-row input[type=checkbox]{
  accent-color:#1d4ed8;
}
.record-selectable-row{
  cursor:pointer;
}
.record-selectable-row:hover td{
  background:#f1f6fc;
}
.record-selectable-row.record-selected-row:hover td{
  background:#cfe2ff!important;
}
.record-selectable-row button,
.record-selectable-row a,
.record-selectable-row input,
.record-selectable-row select,
.record-selectable-row textarea,
.record-selectable-row label{
  cursor:auto;
}


.alerts-btn{position:relative}
.alerts-badge{
  display:inline-flex;align-items:center;justify-content:center;
  min-width:21px;height:21px;padding:0 6px;margin-left:5px;
  border-radius:999px;background:#b91c1c;color:#fff;
  font-size:11px;font-weight:800;line-height:1
}
.alerts-badge.zero{background:#64748b}
.notification-list{display:flex;flex-direction:column;gap:9px;margin-top:12px}
.notification-item{
  border:1px solid #d8e1ec;border-radius:10px;padding:12px;background:var(--block-soft)
}
.notification-item.unread{border-left:5px solid #173f6b;background:#eef6ff}
.notification-head{
  display:flex;align-items:flex-start;justify-content:space-between;gap:12px
}
.notification-title{font-weight:800;color:#163a63}
.notification-meta{font-size:11px;color:#64748b;margin-top:3px}
.notification-message{font-size:13px;margin-top:8px;line-height:1.45}
.notification-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}


.user-personal-kpis{
  display:grid;
  grid-template-columns:repeat(6,minmax(140px,1fr));
  gap:12px;
  margin-bottom:14px
}
@media(max-width:1200px){
  .user-personal-kpis{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:760px){
  .user-personal-kpis{grid-template-columns:1fr 1fr}
}
@media(max-width:480px){
  .user-personal-kpis{grid-template-columns:1fr}
}


.req-card-click{cursor:pointer;transition:.15s ease}
.req-card-click:hover{transform:translateY(-1px);box-shadow:0 4px 14px rgba(15,23,42,.08)}
.req-card-click.selected{
  border-color:#173f6b;
  box-shadow:0 0 0 2px rgba(23,63,107,.10)
}
.req-card-click .kpi-view{margin-top:8px}
.user-request-kpis{
  display:grid;
  grid-template-columns:repeat(4,minmax(160px,1fr));
  gap:12px;
  margin-bottom:14px
}
@media(max-width:900px){.user-request-kpis{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.user-request-kpis{grid-template-columns:1fr}}


.req-origin{
  display:inline-flex;align-items:center;justify-content:center;
  padding:3px 7px;border-radius:999px;font-size:10px;font-weight:800;
  white-space:nowrap;border:1px solid #d8e1ec
}
.req-origin.admin{background:#e8f0fb;color:#173f6b;border-color:#b9cce3}
.req-origin.user{background:#f2f6fa;color:#334155}
.req-origin.archive{background:#eef8f1;color:#166534;border-color:#c9e8d0}
.req-origin.unknown{background:#fff7ed;color:#9a3412;border-color:#fed7aa}
.req-origin-summary{
  margin-top:8px;padding-top:8px;border-top:1px solid #e5eaf1;
  font-size:11px;display:flex;gap:6px;flex-wrap:wrap
}


.excel-import-box{
  margin-top:10px;padding:12px;border:1px solid var(--line);
  border-radius:10px;background:#fbfdff
}
.excel-import-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.excel-import-summary{
  display:grid;grid-template-columns:repeat(5,minmax(110px,1fr));
  gap:8px;margin-top:10px
}
.excel-stat{
  border:1px solid var(--line);border-radius:8px;padding:9px 10px;background:#fff
}
.excel-stat span{
  display:block;font-size:9px;text-transform:uppercase;font-weight:800;color:var(--muted)
}
.excel-stat b{display:block;font-size:20px;color:var(--navy);margin-top:2px}
.excel-stat.warn b{color:#a15c00}.excel-stat.danger b{color:#a61b1b}
.excel-result-table{max-height:260px;overflow:auto;border:1px solid var(--line);border-radius:8px;margin-top:10px}
.excel-result-table table{font-size:11px}
.excel-result-table th{position:static;top:0}
@media(max-width:760px){.excel-import-summary{grid-template-columns:repeat(2,1fr)}}


#fullAccessKpis.owner-user-kpis{
  grid-template-columns:repeat(3,minmax(180px,1fr))
}
@media(max-width:1180px){
  #fullAccessKpis.owner-user-kpis{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:760px){
  #fullAccessKpis.owner-user-kpis{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:520px){
  #fullAccessKpis.owner-user-kpis{grid-template-columns:1fr}
}

.owner-cards-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(250px,1fr));
  gap:14px
}
.owner-user-card{
  border:1px solid var(--line);
  border-radius:12px;
  padding:15px;
  background:#fff
}
.owner-user-card:hover{
  box-shadow:0 4px 16px rgba(15,23,42,.07)
}
.owner-user-name{
  font-weight:900;
  color:var(--navy);
  font-size:14px;
  margin-bottom:8px
}
.owner-user-total{
  font-size:28px;
  line-height:1;
  font-weight:900;
  color:var(--navy)
}
.owner-user-caption{
  margin-top:5px;
  font-size:11px;
  color:var(--muted)
}
.owner-user-stats{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:8px 14px;
  margin-top:12px;
  padding-top:10px;
  border-top:1px solid var(--line)
}
.owner-user-stat span{
  display:block;
  font-size:9px;
  text-transform:uppercase;
  color:var(--muted)
}
.owner-user-stat b{
  display:block;
  margin-top:2px;
  font-size:18px;
  color:#0f2747
}
.owner-user-actions{
  display:flex;
  gap:7px;
  flex-wrap:wrap;
  margin-top:12px
}
.owner-cards-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:12px
}
@media(max-width:1200px){
  .owner-cards-grid{grid-template-columns:repeat(2,minmax(230px,1fr))}
}
@media(max-width:720px){
  .owner-cards-grid{grid-template-columns:1fr}
}


.kpi-state-info{
  margin-top:7px;
  min-height:34px;
  font-size:10px;
  line-height:1.45;
  color:var(--muted)
}
.kpi-state-info .state-summary-title{
  font-weight:800;
  color:#41556f;
  margin-right:3px
}
.kpi-state-chip{
  display:inline-flex;
  align-items:center;
  gap:3px;
  margin:2px 4px 2px 0;
  padding:2px 6px;
  border:1px solid #dce5ef;
  border-radius:999px;
  background:#f7f9fc;
  color:#263c58;
  font-weight:700;
  white-space:nowrap
}
.kpi-state-chip b{
  color:#0f2747;
  font-size:10px
}


.request-custody-warning{
  display:block;
  margin-top:4px;
  padding:5px 7px;
  border:1px solid #f3c5c5;
  border-radius:7px;
  background:#fff5f5;
  color:#8f1d1d;
  font-size:10px;
  line-height:1.35;
  font-weight:700
}
.request-owner-current{
  font-weight:800;
  color:#173f6b
}


/* ===== Tarjetas de expediente por usuario: versión mejorada ===== */
#fullAccessKpis.owner-user-kpis .kpi.user-status-card{
  position:relative;
  cursor:pointer;
  min-height:185px;
  transition:transform .12s ease,box-shadow .12s ease,border-color .12s ease;
  overflow:hidden
}
#fullAccessKpis.owner-user-kpis .kpi.user-status-card:hover{
  transform:translateY(-1px);
  box-shadow:0 6px 18px rgba(15,39,71,.09)
}
#fullAccessKpis.owner-user-kpis .kpi.user-status-card:focus-visible{
  outline:2px solid #173f6b;
  outline-offset:2px
}
#fullAccessKpis.owner-user-kpis .kpi.user-status-card::before{
  content:"";
  position:absolute;
  left:0;
  top:0;
  width:5px;
  height:100%;
  background:#bdc8d7
}
#fullAccessKpis.owner-user-kpis .kpi.card-custody::before{background:#234f7d}
#fullAccessKpis.owner-user-kpis .kpi.card-loan::before{background:#b16b00}
#fullAccessKpis.owner-user-kpis .kpi.card-reassigned::before{background:#7151a8}
#fullAccessKpis.owner-user-kpis .kpi.card-pending-attention::before{background:#1f5d8f}
#fullAccessKpis.owner-user-kpis .kpi.card-return-pending::before{background:#b54848}
#fullAccessKpis.owner-user-kpis .kpi.card-returned::before{background:#3c7b5a}
#fullAccessKpis.owner-user-kpis .kpi.card-alert::before{background:#a71919}

.user-card-caption{
  margin-top:7px;
  font-size:11px;
  line-height:1.35;
  color:var(--muted);
  min-height:30px
}
.user-card-breakdown{
  margin-top:10px;
  display:flex;
  gap:6px;
  flex-wrap:wrap
}
.user-card-breakdown .kpi-state-chip{
  margin:0
}
.user-card-footer{
  margin-top:auto;
  padding-top:12px
}
#fullAccessKpis.owner-user-kpis .kpi.user-status-card{
  display:flex;
  flex-direction:column
}
#fullAccessKpis.owner-user-kpis .kpi.user-status-card .kpi-view{
  align-self:flex-start;
  border:0;
  background:transparent;
  padding:0;
  font-size:11px;
  font-weight:800;
  color:#173f6b;
  text-decoration:none;
  cursor:pointer
}
#fullAccessKpis.owner-user-kpis .kpi.user-status-card .kpi-view:hover{
  text-decoration:underline
}
#fullAccessKpis.owner-user-kpis .kpi.quick-active{
  box-shadow:0 0 0 2px #173f6b inset
}
.owner-context-banner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:10px;
  padding:9px 12px;
  border:1px solid var(--line);
  border-radius:9px;
  background:#f8fafc;
  font-size:11px;
  color:var(--muted)
}
.owner-context-banner b{color:var(--navy)}
@media(max-width:760px){
  #fullAccessKpis.owner-user-kpis .kpi.user-status-card{min-height:160px}
}



/* ===== Tarjetas compactas en vista TODOS LOS USUARIOS ===== */
.owner-cards-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(210px,1fr));
  gap:10px
}
.owner-user-card{
  border:1px solid var(--line);
  border-radius:10px;
  padding:12px 14px;
  background:#fff
}
.owner-user-name{
  font-size:13px;
  margin-bottom:6px
}
.owner-user-total{
  font-size:22px;
  line-height:1;
  margin-bottom:2px
}
.owner-user-caption{
  margin-top:2px;
  font-size:10px;
  color:var(--muted)
}
.owner-user-stats{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:5px 10px;
  margin-top:10px;
  padding-top:8px;
  border-top:1px solid var(--line)
}
.owner-user-stat span{
  font-size:8px;
  letter-spacing:.1px
}
.owner-user-stat b{
  margin-top:1px;
  font-size:14px;
  line-height:1.1
}
.owner-user-actions{
  gap:6px;
  margin-top:10px
}
.owner-user-actions .btn,
.owner-user-actions .btn.small{
  padding:5px 9px;
  font-size:11px;
  min-height:auto
}
.owner-cards-head{
  margin-bottom:10px
}
.owner-cards-head strong{
  font-size:13px
}
.owner-cards-head .note{
  font-size:10px
}
@media(max-width:1400px){
  .owner-cards-grid{grid-template-columns:repeat(3,minmax(210px,1fr))}
}
@media(max-width:980px){
  .owner-cards-grid{grid-template-columns:repeat(2,minmax(210px,1fr))}
}
@media(max-width:720px){
  .owner-cards-grid{grid-template-columns:1fr}
}


.owner-user-card.selected-user-card{
  border-color:#173f6b;
  box-shadow:0 0 0 2px #173f6b inset
}
.owner-user-card{
  cursor:pointer
}
.owner-user-card:focus-visible{
  outline:2px solid #173f6b;
  outline-offset:2px
}
.owner-user-card .owner-user-actions{
  pointer-events:none
}
.owner-user-card .owner-user-actions button{
  pointer-events:auto
}
.owner-detail-separator{
  margin:12px 0 10px;
  padding-top:10px;
  border-top:1px solid var(--line);
  font-size:12px;
  font-weight:800;
  color:var(--navy)
}


/* Expedientes por usuario con el mismo formato de Solicitudes por abogado */
.owner-cards-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px;margin-bottom:14px}
.owner-user-card{border:1px solid var(--line);border-radius:10px;padding:14px;background:#fff;box-shadow:none}
.owner-user-card:hover{box-shadow:none}
.owner-user-name{font-size:13px;color:var(--navy);margin:0 0 8px;font-weight:800}
.owner-user-total{font-size:27px;font-weight:900;color:var(--navy);margin:4px 0 8px;line-height:1}
.owner-user-caption{font-size:12px;color:var(--muted);margin:0 0 10px}
.owner-user-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:6px;font-size:11px;color:var(--muted);margin-top:0;padding-top:0;border-top:none}
.owner-user-stat span{display:block;font-size:11px;text-transform:none;color:var(--muted)}
.owner-user-stat b{display:block;font-size:17px;color:var(--text);margin-top:2px}
.owner-user-actions{margin-top:10px;display:flex;gap:6px;flex-wrap:wrap}
.owner-user-summary-box{margin:8px 0 10px;padding:9px 11px;border:1px solid var(--line);border-radius:8px;background:#fbfcfe;font-size:12px;color:var(--muted)}
.owner-user-card.selected-user-card{border-color:#173f6b;box-shadow:0 0 0 2px #173f6b inset}


.owner-user-options{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
  margin-top:10px;
  padding-top:10px;
  border-top:1px solid var(--line)
}
.owner-user-options .btn{
  padding:5px 8px;
  font-size:10px;
  min-height:auto
}


/* ===== Flujo Expedientes por usuario: seleccionar tarjeta -> filtrar detalle ===== */
#ownerDetailFilters{
  display:grid;
  grid-template-columns:minmax(190px,.75fr) minmax(300px,1.4fr) minmax(220px,.8fr) auto;
  gap:10px;
  align-items:end;
  margin-top:12px;
  margin-bottom:12px
}
#ownerDetailFilters .selected-owner-readonly{
  font-weight:850;
  color:var(--navy);
  background:#f8fafc
}
#ownerDetailFilters select,#ownerDetailFilters input{width:100%}
.owner-detail-title{
  margin-top:12px;
  margin-bottom:6px;
  font-size:12px;
  font-weight:850;
  color:var(--navy)
}
@media(max-width:1000px){
  #ownerDetailFilters{grid-template-columns:1fr 1fr}
}
@media(max-width:650px){
  #ownerDetailFilters{grid-template-columns:1fr}
}


.master-search-grid{
  display:grid;
  grid-template-columns:minmax(320px,1fr) auto;
  gap:10px;
  align-items:end
}
.master-advanced{
  display:grid;
  grid-template-columns:repeat(3,minmax(180px,1fr)) auto auto;
  gap:10px;
  align-items:end;
  margin-top:10px;
  padding-top:10px;
  border-top:1px solid var(--line)
}
.master-actions{
  display:flex;
  gap:7px;
  flex-wrap:wrap;
  align-items:end
}
.master-table-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  flex-wrap:wrap
}
.master-page-controls{
  display:flex;
  align-items:center;
  gap:7px;
  flex-wrap:wrap
}
.master-page-info{
  font-size:11px;
  color:var(--muted);
  white-space:nowrap
}
.master-summary{
  margin-top:8px;
  font-size:11px;
  color:var(--muted)
}
.master-date-summary{
  display:flex;
  align-items:center;
  gap:6px;
  flex-wrap:nowrap;
  overflow-x:auto;
  overflow-y:hidden;
  -webkit-overflow-scrolling:touch;
  margin-top:10px;
  padding:9px 10px;
  border:1px solid var(--line);
  border-radius:8px;
  background:#f8fafc;
  font-size:11px;
  color:var(--muted);
  scrollbar-width:thin;
  scrollbar-color:#a8bbcf #eef3f8
}
.master-date-summary::-webkit-scrollbar{
  height:8px;
}
.master-date-summary::-webkit-scrollbar-track{
  background:#eef3f8;
  border-radius:10px;
}
.master-date-summary::-webkit-scrollbar-thumb{
  background:#a8bbcf;
  border-radius:10px;
}
.master-date-summary strong{
  flex:0 0 auto;
}
.master-date-summary strong{color:var(--navy);margin-right:2px}
.master-date-chip{
  display:inline-flex;
  gap:5px;
  align-items:center;
  padding:4px 7px;
  border:1px solid #d9e2ec;
  border-radius:999px;
  background:#fff;
  color:#334155;
  white-space:nowrap
}
.master-date-chip b{color:var(--navy)}
.master-state-field{
  position:relative;
  overflow:visible!important;
}
.master-multi-trigger{
  width:100%;
  min-height:40px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  border:1px solid var(--line);
  border-radius:8px;
  padding:8px 11px;
  background:#fff;
  color:var(--text);
  font:inherit;
  text-align:left;
  cursor:pointer;
  transition:border-color .15s ease,box-shadow .15s ease,background .15s ease
}
.master-multi-trigger:hover{
  background:#f8fbfe;
  border-color:#9eb7ce
}
.master-multi-trigger:focus{
  outline:none;
  border-color:#6e9bc3;
  box-shadow:0 0 0 3px rgba(37,87,132,.10)
}
.master-multi-trigger.has-selection{
  background:#f4f8fc;
  border-color:#bfd1e3;
  color:#244867;
}
.master-multi-trigger.has-selection:hover{
  background:#eef5fb;
  border-color:#aac3da;
}

/* Desplegable flotante: ya no crea un gran espacio vacío debajo. */
.master-multi-panel{
  position:absolute;
  left:0;
  top:calc(100% + 6px);
  z-index:160;
  width:min(405px,calc(100vw - 28px));
  padding:0;
  border:1px solid #c8d6e3;
  border-radius:10px;
  background:#fff;
  box-shadow:0 10px 24px rgba(15,23,42,.14);
  overflow:hidden
}
#allAdvancedFilters.state-panel-open{
  padding-bottom:0!important;
}
#allAdvancedFilters{
  overflow:visible!important;
}

.master-multi-head{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
  padding:9px 10px 8px;
  background:#f7fafc;
  border-bottom:1px solid var(--line)
}
.master-multi-head strong{
  display:block;
  color:var(--navy);
  font-size:11.5px
}
.master-multi-head small{
  display:block;
  margin-top:2px;
  color:var(--muted);
  font-size:9.5px
}
.master-multi-close{
  width:26px;
  height:26px;
  flex:0 0 26px;
  display:grid;
  place-items:center;
  padding:0;
  border:1px solid #d4deea;
  border-radius:7px;
  background:#fff;
  color:#60758a;
  font-size:17px;
  line-height:1;
  cursor:pointer
}
.master-multi-close:hover{
  background:#f0f6fb;
  color:var(--navy)
}

.master-multi-tools{
  display:flex;
  gap:6px;
  padding:7px 9px;
  margin:0;
  background:#fff;
  border-bottom:1px solid var(--line)
}
.master-multi-tools .btn{
  min-height:28px;
  padding:4px 9px
}

.master-state-options{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:5px;
  max-height:225px;
  overflow-y:auto;
  overscroll-behavior:contain;
  padding:7px;
  background:#fff
}
.master-state-check{
  display:flex;
  align-items:center;
  gap:6px;
  min-height:34px;
  padding:7px 8px;
  border:1px solid #e2e9f0;
  border-radius:7px;
  background:#fbfdff;
  color:#3d556d;
  font-size:10.5px;
  line-height:1.2;
  cursor:pointer;
  transition:background .12s ease,border-color .12s ease,box-shadow .12s ease
}
.master-state-check:hover{
  background:#f2f7fb;
  border-color:#c8d8e7
}
.master-state-check:has(input:checked){
  background:#f5f9fc;
  border-color:#c8d9e8;
  box-shadow:inset 2px 0 0 #a8c4da;
  color:#294a67;
  font-weight:700
}
.master-state-check input{
  width:15px;
  height:15px;
  flex:0 0 auto;
  margin-top:0;
  accent-color:#255784
}
.master-state-check span{
  min-width:0;
  overflow-wrap:anywhere
}
.master-filter-count{
  display:inline-flex;
  align-items:center;
  margin-left:4px;
  padding:2px 5px;
  border-radius:999px;
  background:#e8eef5;
  color:#526b83;
  font-size:9px;
  font-weight:800
}

@media(max-height:760px){
  .master-state-options{max-height:190px}
}
@media(max-width:760px){
  .master-state-options{grid-template-columns:1fr}
}
@media(max-width:700px){
  .master-multi-panel{
    width:min(360px,calc(100vw - 18px))
  }
  .master-state-options{
    grid-template-columns:1fr;
    max-height:210px
  }
}
@media(max-width:1000px){
  .master-advanced{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:700px){
  .master-search-grid,.master-advanced{grid-template-columns:1fr}
}


.request-item-edit{
  width:100%;
  min-width:85px;
  padding:6px 7px;
  border:1px solid var(--line);
  border-radius:7px;
  background:#fff;
  font:inherit;
  font-size:11px
}
.request-item-edit.folio{min-width:80px}
.request-item-edit.rd{min-width:110px}
.request-item-edit.extension{min-width:80px}
.request-edit-help{
  display:block;
  margin-top:5px;
  font-size:10px;
  color:var(--muted)
}


.prepare-delivery-panel{
  margin-top:12px;
  padding:12px;
  border:1px solid var(--line);
  border-radius:10px;
  background:#f8fafc
}
.prepare-delivery-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px
}
.prepare-delivery-title{
  display:flex;
  justify-content:space-between;
  gap:10px;
  align-items:center;
  margin-bottom:9px
}
.prepare-delivery-title strong{color:var(--navy)}
.cargo-select-count{
  font-size:11px;
  color:var(--muted);
  white-space:nowrap
}
.request-cargo-check{
  width:16px;
  height:16px
}
@media(max-width:760px){
  .prepare-delivery-grid{grid-template-columns:1fr}
}


/* Corrección de ayudas dentro de formularios */
.field > .note{
  display:block;
  box-sizing:border-box;
  width:100%;
  margin-top:6px;
  padding:6px 8px;
  line-height:1.35;
  font-size:10px;
  border-radius:6px;
  position:static;
}
#rqAsunto{
  display:block;
  width:100%;
}


/* Mejora visual de fecha y hora en tablas de historial */
.datetime-cell{display:flex;flex-direction:column;align-items:flex-start;gap:4px;min-width:112px}
.datetime-date{font-weight:700;color:var(--navy);line-height:1.15;white-space:nowrap}
.datetime-time{display:inline-flex;align-items:center;justify-content:center;padding:4px 8px;border-radius:999px;background:#eef4ff;border:1px solid #cddcf7;color:var(--navy);font-size:11px;font-weight:700;line-height:1;white-space:nowrap}



/* Vista ordenada de expedientes solicitados / reasignación interna */
#newRequestModal .modal-box{
  max-width:1280px;
  width:min(96vw,1280px)
}
#newRequestModal .request-selected-wrap{
  overflow-x:auto;
  border:1px solid #dbe4ef;
  border-radius:11px;
  background:#fff
}
#newRequestModal .request-selected-wrap .table-head{
  padding:12px 14px;
  background:#fbfdff
}
#rqSelectedTable{min-width:0}
#rqSelectedTable table{
  table-layout:auto;
  width:100%;
  min-width:1080px
}
#rqSelectedTable th,
#rqSelectedTable td{
  box-sizing:border-box;
  vertical-align:middle
}
#rqSelectedTable th{
  padding:10px 9px;
  white-space:nowrap
}
#rqSelectedTable td{
  padding:10px 9px;
  white-space:normal;
  overflow-wrap:normal;
  word-break:normal
}
#rqSelectedTable .rq-col-num{width:46px;min-width:46px;text-align:center}
#rqSelectedTable .rq-col-select{width:44px;min-width:44px;text-align:center}
#rqSelectedTable .rq-col-exp{width:120px;min-width:120px;white-space:nowrap}
#rqSelectedTable .rq-col-ext{width:92px;min-width:92px}
#rqSelectedTable .rq-col-rd{width:132px;min-width:132px}
#rqSelectedTable .rq-col-folio{width:110px;min-width:110px}
#rqSelectedTable .rq-col-tipo{width:105px;min-width:105px;white-space:nowrap}
#rqSelectedTable .rq-col-estado{min-width:270px}
#rqSelectedTable .rq-col-actions{width:110px;min-width:110px;text-align:center}
#rqSelectedTable .request-item-edit{
  display:block;
  width:100%;
  min-width:0;
  box-sizing:border-box
}
#rqSelectedTable .rq-col-exp b{
  display:inline-block;
  white-space:nowrap;
  font-size:12px;
  color:var(--navy)
}
#rqSelectedTable .rq-col-estado:not(:empty){line-height:1.3}
.internal-reassign-state{display:flex;flex-direction:column;align-items:flex-start;gap:6px;min-width:0}
.internal-reassign-state .pill{white-space:normal;line-height:1.2;text-align:left}
.internal-reassign-note{display:block;color:var(--muted);font-size:10px;line-height:1.35;max-width:100%}
.internal-reassign-note b{color:var(--navy)}
.request-item-actions{min-width:0}
.request-item-actions .btn{max-width:100%}
.internal-reassign-btn{display:block;width:100%;margin:0 0 7px 0!important;white-space:normal;line-height:1.2;padding:7px 9px}
.request-remove-btn{display:inline-flex;justify-content:center;white-space:nowrap}
.internal-reassign-bulkbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:10px 12px;padding:10px 12px;border:1px solid #cddcf7;border-radius:9px;background:#f7faff}
.internal-reassign-bulkbar .left{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
.internal-reassign-bulkbar label{display:inline-flex;align-items:center;gap:6px;margin:0;font-size:11px;font-weight:700;color:var(--navy);cursor:pointer}
.internal-reassign-bulkbar .note{margin:0}
.internal-reassign-check{width:17px;height:17px;cursor:pointer;vertical-align:middle}
.internal-reassign-number{display:flex;align-items:center;justify-content:center;gap:5px;flex-wrap:nowrap}

/* Preparación del cargo: separada visualmente del listado */
#newRequestModal .prepare-delivery-panel{
  margin-top:16px;
  padding:16px;
  border:1px solid #cddcf7;
  border-radius:12px;
  background:#f8fbff;
  box-shadow:0 2px 8px rgba(15,39,71,.04)
}
#newRequestModal .prepare-delivery-title{
  display:flex;
  justify-content:space-between;
  gap:12px;
  align-items:flex-start;
  margin-bottom:12px;
  padding-bottom:10px;
  border-bottom:1px solid #dbe4ef
}
#newRequestModal .prepare-delivery-title strong{
  display:block;
  color:var(--navy);
  font-size:14px
}

/* Compacta la cabecera de SOLICITUDES para que hasta el bloque de filtros permanezca visible */
#tab-requests .workflow-intro{
  margin-bottom:10px;
  padding:10px 12px;
}
#tab-requests .workflow-intro .note{
  margin-top:4px !important;
  font-size:12px;
  line-height:1.35;
}
#tab-requests .workflow-steps{
  margin-top:6px;
  gap:6px;
}
#tab-requests .workflow-step{
  padding:4px 7px;
  font-size:9px;
}
#tab-requests .request-workflow-kpis{
  grid-template-columns:repeat(3,minmax(180px,1fr));
  gap:10px;
  margin-bottom:10px;
}
#tab-requests .request-workflow-kpis .kpi{
  min-height:82px;
  padding:10px 12px;
}
#tab-requests .request-workflow-kpis .kpi .label{
  font-size:10px;
  line-height:1.2;
}
#tab-requests .request-workflow-kpis .kpi .value{
  font-size:20px;
  margin-top:3px;
}
#tab-requests .request-workflow-kpis .note-mini{
  margin-top:3px;
  font-size:9px;
  line-height:1.25;
}
#tab-requests .filters{
  padding:12px;
  margin-bottom:10px;
}
#tab-requests .table-wrap{
  max-height:calc(100vh - 300px);
}
@media(max-width:900px){
  #tab-requests .request-workflow-kpis{grid-template-columns:1fr}
}
#newRequestModal .prepare-delivery-grid{
  display:grid;
  grid-template-columns:minmax(320px,1.15fr) minmax(280px,1fr);
  gap:14px
}
#newRequestModal .prepare-delivery-grid .field{min-width:0}
#newRequestModal .prepare-delivery-grid select,
#newRequestModal .prepare-delivery-grid input{
  width:100%;
  min-height:42px
}
#newRequestModal .cargo-select-count{
  padding-top:2px;
  font-size:11px;
  color:var(--muted);
  white-space:nowrap
}
#newRequestModal .modal-foot{
  align-items:center;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:10px
}
#newRequestModal #rqSaveStatus{
  flex:1 1 260px;
  min-width:220px
}
#newRequestModal .modal-foot > div{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  justify-content:flex-end
}
#newRequestModal .modal-foot .btn{white-space:nowrap}


/* V493 · Nueva solicitud sin superposición en pantalla dividida / media pantalla */
#newRequestModal{
  z-index:2400;
  align-items:flex-start;
  overflow:auto;
  overscroll-behavior:contain;
}
#newRequestModal .modal-box{
  box-sizing:border-box;
  width:min(1280px,calc(100vw - 28px));
  max-width:calc(100vw - 28px);
  margin:14px auto;
}

/* En anchos intermedios (pantalla dividida), anticipar el layout responsivo */
@media(max-width:1380px){
  #newRequestModal{padding:10px}
  #newRequestModal .modal-box{
    width:min(1140px,calc(100vw - 20px));
    max-width:calc(100vw - 20px);
    padding:14px;
    max-height:96vh;
  }
  #newRequestModal .modal-head{
    position:sticky;
    top:0;
    z-index:2;
    background:#fff;
    padding-bottom:8px;
  }
  #newRequestModal .form-grid{grid-template-columns:repeat(2,minmax(220px,1fr));}
  #newRequestModal .span2,
  #newRequestModal .span4{grid-column:span 2}
  #newRequestModal #rqModalNote,
  #newRequestModal .note{overflow-wrap:anywhere}
}

@media(max-width:1100px){
  #newRequestModal .modal-box{
    width:calc(100vw - 16px);
    max-width:calc(100vw - 16px);
    padding:12px;
  }
  #newRequestModal .form-grid{grid-template-columns:1fr}
  #newRequestModal .span2,
  #newRequestModal .span4{grid-column:span 1}
}

/* Los bloques principales nunca deben empujar el modal fuera del viewport */
#newRequestModal .card,
#newRequestModal .field,
#newRequestModal .request-draft-box,
#newRequestModal .request-selected-wrap,
#newRequestModal .batch-box{
  min-width:0;
}
#newRequestModal .table-wrap,
#newRequestModal .request-selected-wrap{
  max-width:100%;
}


/* V494 · Ningún modal debe superponerse en pantallas chicas */
@media(max-width:1200px){
  body.modal-responsive-active{overflow:hidden}
  body.modal-responsive-active .app{grid-template-columns:1fr!important}
  body.modal-responsive-active .sidebar{display:none!important}
  body.modal-responsive-active .main{padding:12px!important}
  body.modal-responsive-active .modal{
    inset:0!important;
    padding:8px!important;
    align-items:flex-start!important;
    justify-content:center!important;
    overflow:auto!important;
  }
  body.modal-responsive-active .modal .modal-box,
  body.modal-responsive-active .modal .alerts-modal-box,
  body.modal-responsive-active .modal .archive-lists-modal-box,
  body.modal-responsive-active .modal .inventory-modal-box,
  body.modal-responsive-active .modal .v488-digital-modal-box,
  body.modal-responsive-active .modal .auth-box,
  body.modal-responsive-active .modal .v211-team-modal-box{
    box-sizing:border-box!important;
    width:min(1120px,calc(100vw - 16px))!important;
    max-width:calc(100vw - 16px)!important;
    max-height:calc(100vh - 16px)!important;
    margin:0 auto!important;
    border-radius:14px!important;
  }
  body.modal-responsive-active .modal .modal-head,
  body.modal-responsive-active .modal .alerts-modal-head{
    position:sticky;
    top:0;
    z-index:5;
    background:inherit;
  }
  body.modal-responsive-active .modal .table-wrap,
  body.modal-responsive-active .modal .request-selected-wrap{
    max-width:100%!important;
    overflow:auto!important;
  }
  body.modal-responsive-active .modal .filters,
  body.modal-responsive-active .modal .form-grid,
  body.modal-responsive-active .modal .history-summary,
  body.modal-responsive-active .modal .request-workflow-kpis,
  body.modal-responsive-active .modal .cargo-kpis,
  body.modal-responsive-active .modal .cargo-flow-bar{
    min-width:0!important;
  }
}

@media(max-width:900px){
  body.modal-responsive-active .modal{padding:6px!important}
  body.modal-responsive-active .modal .modal-box,
  body.modal-responsive-active .modal .alerts-modal-box,
  body.modal-responsive-active .modal .archive-lists-modal-box,
  body.modal-responsive-active .modal .inventory-modal-box,
  body.modal-responsive-active .modal .v488-digital-modal-box,
  body.modal-responsive-active .modal .auth-box,
  body.modal-responsive-active .modal .v211-team-modal-box{
    width:calc(100vw - 12px)!important;
    max-width:calc(100vw - 12px)!important;
    max-height:calc(100vh - 12px)!important;
    padding:12px!important;
    border-radius:12px!important;
  }
  body.modal-responsive-active .modal .form-grid,
  body.modal-responsive-active .modal .accum-form-grid,
  body.modal-responsive-active .modal .prepare-delivery-grid,
  body.modal-responsive-active .modal .history-summary,
  body.modal-responsive-active .modal .request-workflow-kpis,
  body.modal-responsive-active .modal .cargo-kpis,
  body.modal-responsive-active .modal .cargo-flow-bar{
    grid-template-columns:1fr!important;
  }
  body.modal-responsive-active .modal .span2,
  body.modal-responsive-active .modal .span4{grid-column:span 1!important}
}

@media(max-width:900px){
  #newRequestModal{padding:8px}
  #newRequestModal .modal-box{padding:12px;max-height:96vh;width:98vw}
  #rqSelectedTable table{min-width:980px}
  #newRequestModal .prepare-delivery-grid{grid-template-columns:1fr}
  #newRequestModal .modal-foot{align-items:stretch}
  #newRequestModal #rqSaveStatus{min-width:100%;flex-basis:100%}
  #newRequestModal .modal-foot > div{width:100%;justify-content:flex-end}
}

.workflow-intro{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;padding:12px 14px;border:1px solid var(--line);border-radius:10px;background:#f8fafc}.workflow-intro strong{color:var(--navy)}.workflow-steps{display:flex;gap:7px;flex-wrap:wrap;margin-top:7px}.workflow-step{display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border-radius:999px;background:#fff;border:1px solid var(--line);color:var(--muted);font-size:10px;font-weight:700}.workflow-step b{color:var(--navy)}.request-workflow-kpis{display:grid;grid-template-columns:repeat(4,minmax(150px,1fr));gap:10px;margin-bottom:12px}.request-workflow-kpis .kpi{cursor:pointer;min-height:110px;transition:.12s ease}.request-workflow-kpis .kpi:hover{transform:translateY(-1px);box-shadow:0 5px 15px rgba(15,39,71,.08)}.request-workflow-kpis .kpi.selected{box-shadow:0 0 0 2px #173f6b inset}.request-workflow-kpis .kpi .label{font-size:10px;line-height:1.25}.request-workflow-kpis .kpi .value{margin-top:5px}.note-mini{margin-top:5px;font-size:9px;line-height:1.25;color:var(--muted)}.cargo-kpis{display:grid;grid-template-columns:repeat(4,minmax(160px,1fr));gap:10px;margin-bottom:12px}.cargo-kpis .kpi{cursor:pointer;min-height:105px}.cargo-kpis .kpi.selected{box-shadow:0 0 0 2px #173f6b inset}.cargo-flow-bar{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0 0}.cargo-flow-step{padding:9px 10px;border:1px solid var(--line);border-radius:8px;background:#fff;font-size:10px;color:var(--muted)}.cargo-flow-step b{display:block;margin-bottom:3px;color:var(--navy);font-size:11px}@media(max-width:1050px){.request-workflow-kpis,.cargo-kpis{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.request-workflow-kpis,.cargo-kpis,.cargo-flow-bar{grid-template-columns:1fr}}

/* Corrección de vista de Solicitudes para perfil USUARIO */
.app.limited-user #tab-requests{width:100%;min-width:0}
.app.limited-user #tab-requests .workflow-intro,
.app.limited-user #tab-requests .user-request-kpis,
.app.limited-user #tab-requests .filters,
.app.limited-user #tab-requests .table-wrap{width:100%;box-sizing:border-box}
.app.limited-user #tab-requests .table-wrap{overflow-x:auto}
.app.limited-user #tab-requests #requestsTable{min-width:100%}
.app.limited-user #tab-requests #requestsTable table{min-width:1180px}
.app.limited-user #userRequestKpis .req-card-click{cursor:pointer}


/* ===== Tarjetas de estado por usuario: estilo compacto como Solicitudes ===== */
#fullAccessKpis.owner-user-kpis{
  grid-template-columns:repeat(4,minmax(220px,1fr));
  gap:10px;
  margin-bottom:12px;
}
#fullAccessKpis.owner-user-kpis .kpi.user-status-card{
  min-height:104px;
  padding:12px 14px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}
#fullAccessKpis.owner-user-kpis .kpi.user-status-card .label{
  font-size:12px;
  line-height:1.15;
  color:var(--muted);
}
#fullAccessKpis.owner-user-kpis .kpi.user-status-card .value{
  font-size:20px;
  margin-top:4px;
  line-height:1.05;
}
#fullAccessKpis.owner-user-kpis .user-card-caption{
  margin-top:4px;
  min-height:0;
  font-size:11px;
  line-height:1.25;
  color:var(--muted);
}
#fullAccessKpis.owner-user-kpis .user-card-breakdown{
  margin-top:5px;
  gap:4px;
}
#fullAccessKpis.owner-user-kpis .user-card-breakdown .chip{
  font-size:10px;
  padding:2px 6px;
}
#fullAccessKpis.owner-user-kpis .user-card-footer{
  padding-top:6px;
}
#fullAccessKpis.owner-user-kpis .kpi.user-status-card .kpi-view{
  font-size:11px;
  font-weight:800;
  text-decoration:none;
}
@media(max-width:1200px){
  #fullAccessKpis.owner-user-kpis{
    grid-template-columns:repeat(3,minmax(210px,1fr));
  }
}
@media(max-width:760px){
  #fullAccessKpis.owner-user-kpis{
    grid-template-columns:repeat(2,minmax(170px,1fr));
  }
  #fullAccessKpis.owner-user-kpis .kpi.user-status-card{
    min-height:98px;
    padding:10px 12px;
  }
  #fullAccessKpis.owner-user-kpis .kpi.user-status-card .label{
    font-size:11px;
  }
  #fullAccessKpis.owner-user-kpis .kpi.user-status-card .value{
    font-size:18px;
  }
  #fullAccessKpis.owner-user-kpis .user-card-caption,
  #fullAccessKpis.owner-user-kpis .kpi.user-status-card .kpi-view{
    font-size:10px;
  }
}



/* =========================================================
   PERFIL USUARIO: VISTA A ANCHO COMPLETO Y TARJETAS LEGIBLES
   ========================================================= */
.app.limited-user{
  grid-template-columns:minmax(0,1fr);
  width:100%;
}
.app.limited-user .main{
  width:100%;
  max-width:none;
  min-width:0;
  padding-left:20px;
  padding-right:20px;
  box-sizing:border-box;
}
/* Al ocultarse la barra lateral, la cabecera fija debe comenzar en x=0. */
.app.limited-user .main-sticky-header{
  left:0 !important;
  width:100%;
  box-sizing:border-box;
}
.app.limited-user .main-sticky-header .topbar,
.app.limited-user .main-sticky-header .tabs,
.app.limited-user .main-sticky-header .statusbar{
  width:100%;
  max-width:none;
}
.app.limited-user #tab-panel,
.app.limited-user #tab-requests{
  width:100%;
  max-width:none;
  min-width:0;
}

/* Tarjetas de Mis expedientes: mini, compactas, sin estirarse de extremo a extremo. */
.app.limited-user .user-personal-kpis{
  grid-template-columns:repeat(auto-fill,minmax(210px,280px));
  gap:7px;
  width:100%;
  margin-bottom:8px;
  justify-content:start;
}
.app.limited-user .user-personal-kpis .kpi{
  min-height:62px;
  padding:8px 10px;
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  grid-template-areas:
    "label value"
    "action action";
  align-items:start;
  row-gap:3px;
  column-gap:8px;
}
.app.limited-user .user-personal-kpis .kpi .label{
  grid-area:label;
  font-size:11px;
  line-height:1.12;
  margin:0;
  min-width:0;
}
.app.limited-user .user-personal-kpis .kpi .value{
  grid-area:value;
  font-size:19px;
  margin:0;
  line-height:1;
  justify-self:end;
  align-self:start;
  white-space:nowrap;
}
.app.limited-user .user-personal-kpis .kpi-view{
  grid-area:action;
  margin-top:0;
  font-size:11px;
  line-height:1.05;
  text-decoration:none;
  justify-self:start;
}

/* Mis solicitudes: mismo formato compacto y ancho controlado. */
.app.limited-user .user-request-kpis{
  width:100%;
  grid-template-columns:repeat(auto-fill,minmax(210px,280px));
  gap:7px;
  justify-content:start;
  margin-bottom:8px;
}
.app.limited-user .user-request-kpis .kpi{
  min-height:62px;
  padding:8px 10px;
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  grid-template-areas:
    "label value"
    "action action";
  align-items:start;
  row-gap:4px;
  column-gap:8px;
}
.app.limited-user .user-request-kpis .kpi .label{
  grid-area:label;
  font-size:11px;
  line-height:1.12;
  margin:0;
}
.app.limited-user .user-request-kpis .kpi .value{
  grid-area:value;
  font-size:19px;
  margin:0;
  line-height:1;
  justify-self:end;
  white-space:nowrap;
}
.app.limited-user .user-request-kpis .kpi-view{
  grid-area:action;
  margin-top:0;
  font-size:11px;
  line-height:1.05;
  text-decoration:none;
  justify-self:start;
}
.app.limited-user #tab-requests .filters{
  width:100%;
  grid-template-columns:minmax(260px,2fr) minmax(220px,1fr);
}
.app.limited-user #tab-requests .table-wrap{
  width:100%;
  max-width:100%;
}

@media(max-width:900px){
  .app.limited-user .user-personal-kpis,
  .app.limited-user .user-request-kpis{
    grid-template-columns:repeat(auto-fill,minmax(190px,250px));
  }
}
@media(max-width:680px){
  .app.limited-user .main{
    padding-left:12px;
    padding-right:12px;
  }
  .app.limited-user .user-personal-kpis,
  .app.limited-user .user-request-kpis{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
  .app.limited-user .user-personal-kpis .kpi{
    min-height:58px;
    padding:7px 9px;
  }
  .app.limited-user .user-personal-kpis .kpi .value{
    font-size:16px;
  }
  .app.limited-user #tab-requests .filters{
    grid-template-columns:1fr;
  }
}
@media(max-width:430px){
  .app.limited-user .user-personal-kpis,
  .app.limited-user .user-request-kpis{grid-template-columns:1fr}
}


/* Último folio obligatorio para movimientos realizados por el USUARIO */
.request-item-edit.user-required-folio{
  min-width:105px;
  border-color:#c58b19;
  background:#fffdf5;
  font-weight:700;
}
.request-item-edit.user-required-folio:focus{
  outline:2px solid rgba(197,139,25,.22);
  border-color:#9a6900;
}


/* ===== Piloto: devolución múltiple del usuario ===== */
.bulk-return-table{overflow:auto;max-height:48vh;border:1px solid var(--line);border-radius:9px;margin-top:10px}
.bulk-return-table table{min-width:760px}
.bulk-return-table th{top:0;z-index:2}
.bulk-return-input{width:100%;min-width:120px;border:1px solid var(--line);border-radius:7px;padding:7px 8px;font:inherit;background:#fff}
.bulk-return-input.required{border-color:#c58b19;background:#fffdf5}
.bulk-return-input.required:focus{outline:2px solid rgba(197,139,25,.18);border-color:#9a6900}
.bulk-return-source{display:inline-block;padding:3px 7px;border-radius:999px;font-size:10px;font-weight:800;background:#e8eef6;color:var(--navy)}
.bulk-return-source.archive{background:#fff0e8;color:#984514}
.bulk-return-summary{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.bulk-return-summary .mini{padding:6px 9px;border:1px solid var(--line);border-radius:8px;background:#f8fafc;font-size:11px;color:var(--muted)}


/* Seguridad visual por rol: ningún perfil USUARIO muestra Gestionar en filas */
.app.limited-user .user-manage-action{display:none!important}

/* ===== LISTADOS DE EXPEDIENTES DEVUELTOS ===== */
.returned-list-toolbar{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin:10px 0 12px;padding:12px;border:1px solid #dbe4ee;border-radius:12px;background:#f8fafc}
.returned-list-toolbar .field{min-width:170px;flex:1}
.returned-list-toolbar .field.search{min-width:240px;flex:2}
.returned-list-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.dest-badge{display:inline-flex;align-items:center;padding:4px 8px;border-radius:999px;font-size:11px;font-weight:800;white-space:nowrap;border:1px solid #cbd5e1;background:#fff}
.dest-badge.san-luis{background:#eef2ff;border-color:#c7d2fe;color:#3730a3}
.dest-badge.barrenechea{background:#ecfdf5;border-color:#a7f3d0;color:#065f46}
.dest-badge.revisar{background:#fff7ed;border-color:#fed7aa;color:#9a3412}
.list-status{display:inline-flex;align-items:center;padding:4px 8px;border-radius:999px;font-size:11px;font-weight:800;white-space:nowrap}
.list-status.unlisted{background:#f1f5f9;color:#475569}
.list-status.prep{background:#fef3c7;color:#92400e}
.list-status.generated{background:#dcfce7;color:#166534}
.archive-list-summary{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 10px}
.archive-list-summary .mini{padding:7px 10px;background:#fff;border:1px solid #e2e8f0;border-radius:9px;font-size:12px}
.archive-list-modal-grid{
  display:grid;
  grid-template-columns:minmax(560px,1.05fr) minmax(580px,1fr);
  gap:12px
}
.archive-list-panel{
  border:1px solid #e2e8f0;
  border-radius:12px;
  overflow:auto;
  max-height:68vh
}
.archive-list-panel-head{
  position:static;
  top:0;
  background:#fff;
  padding:10px;
  border-bottom:1px solid #e2e8f0;
  z-index:1
}
.archive-lists-modal-box{
  max-height:95vh!important;
}
#archiveListsTable table{
  width:100%;
  table-layout:auto;
}
#archiveListsTable th,
#archiveListsTable td{
  font-size:10px;
  padding:7px 6px;
  vertical-align:middle;
}
#archiveListsTable .archive-list-main-cell{
  min-width:125px;
}
#archiveListsTable .archive-list-main-actions{
  display:flex;
  align-items:center;
  gap:5px;
  flex-wrap:wrap;
  margin-top:5px;
}
#archiveListsTable .archive-list-main-actions .btn{
  padding:4px 7px;
  font-size:9.5px;
}
#archiveListsTable .archive-send-date{
  white-space:nowrap;
  font-size:9.5px;
  font-weight:700;
  color:#475569;
}
@media(max-width:1180px){
  .archive-list-modal-grid{
    grid-template-columns:minmax(500px,1fr) minmax(480px,1fr);
  }
}
@media(max-width:980px){
  .archive-list-modal-grid{grid-template-columns:1fr}
  .archive-list-panel{max-height:62vh}
}
/* ===== FIN LISTADOS DE EXPEDIENTES DEVUELTOS ===== */


/* ===== REGISTRO MAESTRO: CABECERA DE BÚSQUEDA FIJA ===== */
#tab-all{
  position:relative;
}
#tab-all > .card.master-fold-filters{
  position:static;
  top:0;
  z-index:28;
  margin-bottom:10px !important;
  background:var(--block);
  box-shadow:0 6px 16px rgba(23,54,93,.10);
}
#tab-all > .table-wrap{
  max-height:calc(100vh - 250px);
  overflow:auto;
}
#tab-all > .table-wrap .table-head{
  position:static;
  top:0;
  z-index:24;
  background:var(--block);
}
@media(max-height:700px){
  #tab-all > .table-wrap{max-height:52vh}
}
/* ===== FIN REGISTRO MAESTRO FIJO ===== */


/* Compactar tarjetas en pestaña Estados */
#tab-states .states-kpis{grid-template-columns:repeat(3,minmax(180px,1fr));gap:8px;margin-bottom:10px}
#tab-states .states-kpis .kpi{padding:10px 12px;min-height:92px}
#tab-states .states-kpis .kpi .label{font-size:10px;line-height:1.2}
#tab-states .states-kpis .kpi .value{font-size:20px;margin-top:2px;line-height:1.05}
#tab-states .states-kpis .kpi .note{font-size:11px;margin-top:4px}
#tab-states .state-grid{grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:8px;margin-bottom:10px}
#tab-states .state-card{padding:11px 12px;border-radius:12px;cursor:pointer;transition:transform .12s ease,box-shadow .12s ease,border-color .12s ease}
#tab-states .state-card:hover{transform:translateY(-1px);box-shadow:0 8px 18px rgba(15,23,42,.08)}
#tab-states .state-card.selected{border-width:2px;box-shadow:0 0 0 2px rgba(37,99,235,.10),0 10px 22px rgba(15,23,42,.09)}
#tab-states .state-card .state-name{font-size:11px;min-height:auto;line-height:1.2;margin-bottom:6px;text-transform:uppercase;letter-spacing:.02em}
#tab-states .state-card .state-count{font-size:30px;margin-top:0;line-height:1.05;font-weight:850}
#tab-states .state-card .state-meta{font-size:10px;margin-top:3px;line-height:1.25;display:none!important}
#tab-states .state-progress{height:5px;margin-top:7px;display:none!important}
#tab-states .state-card .btn.small,
#tab-states .state-card .btn.secondary.small{padding:6px 10px;font-size:11px}
#tab-states .state-card-actions{display:none!important}
#tab-states .state-card-actions .btn{margin:0}
#tab-states .state-export-btn{background:#f8fafc}
#tab-states .table-wrap{margin-top:10px}
#tab-states .state-detail-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;flex-wrap:wrap}
#tab-states .state-detail-head-main{display:flex;flex-direction:column;gap:4px;min-width:0}
#tab-states #stateDetailMeta{font-size:12px;color:#64748b}
#tab-states #stateDetailActions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}

#tab-states .v504-return-tools{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:10px 12px;border-bottom:1px solid var(--line);background:#f8fafc}
#tab-states .v504-return-tools .field{min-width:180px;flex:1 1 210px}
#tab-states .v504-return-tools .field label{margin-bottom:4px}
#tab-states .v504-return-tools .v504-return-actions{display:flex;align-items:end;gap:8px;flex-wrap:wrap}
#tab-states .v504-return-tools select{min-width:180px}
@media(max-width:760px){#tab-states .v504-return-tools{align-items:stretch}.v504-return-actions{width:100%}}

@media(max-width:900px){
  #tab-states .states-kpis{grid-template-columns:1fr}
  #tab-states .state-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:600px){
  #tab-states .state-grid{grid-template-columns:1fr}
  #tab-states .state-card .state-count{font-size:26px}
  #tab-states .state-detail-head{flex-direction:column;align-items:stretch}
  #tab-states #stateDetailActions{justify-content:flex-start}
}


/* =========================================================
   MÁS ESPACIO PARA LISTADOS + SELECCIÓN VISUAL EN FILAS
   ========================================================= */
/* Compactar la zona superior de los módulos sin reducir la legibilidad. */
.module-sticky-piece.filters{
  padding:9px 10px!important;
  margin-bottom:7px!important;
  gap:8px!important;
}
.module-sticky-piece.filters .field label{font-size:10px;margin-bottom:3px}
.module-sticky-piece.filters .field input,
.module-sticky-piece.filters .field select{padding:7px 9px}

/* Estados: buscador y tarjetas más bajos para dejar más tabla visible. */
#tab-states > .filters{
  padding:8px 10px!important;
  margin-bottom:6px!important;
  gap:8px!important;
}
#tab-states > .filters .note{padding:7px 9px;font-size:10px;line-height:1.25}
#tab-states > .filters .btn{padding:7px 10px}
#tab-states .state-grid{
  grid-template-columns:repeat(auto-fill,minmax(190px,1fr));
  gap:6px;
  margin-bottom:6px!important;
}
#tab-states .state-card{padding:8px 10px 7px;border-radius:10px}
#tab-states .state-card .state-name{font-size:10.5px;min-height:18px;line-height:1.15}
#tab-states .state-card .state-count{font-size:17px;margin-top:2px;line-height:1}
#tab-states .state-card .state-meta{font-size:9px;margin-top:2px;line-height:1.15}
#tab-states .state-progress{height:4px;margin-top:5px}
#tab-states .state-card-actions{gap:5px;margin-top:5px}
#tab-states .state-card .btn.small,
#tab-states .state-card .btn.secondary.small{padding:5px 8px;font-size:10px}
#tab-states .table-wrap{margin-top:6px}

/* Solicitudes y cargos: reducir altura de resúmenes para priorizar filas. */
#tab-requests .workflow-intro{padding:8px 10px;margin-bottom:7px}
#tab-requests .request-workflow-kpis{gap:7px;margin-bottom:7px}
#tab-requests .request-workflow-kpis .kpi{min-height:70px;padding:8px 10px}
#tab-cargos .workflow-intro{padding:8px 10px;margin-bottom:7px}
#tab-cargos .cargo-kpis{gap:7px;margin-bottom:7px}
#tab-cargos .cargo-kpis .kpi{min-height:76px;padding:8px 10px}
#tab-cargos .cargo-kpis .kpi .value{font-size:20px;margin-top:2px}

/* Cualquier fila operativamente seleccionable usa el mismo lenguaje visual. */
.row-click-select{cursor:pointer}
.row-click-select:hover td{background:#f1f6fc}
.row-click-select.record-selected-row:hover td{background:#cfe2ff!important}

/* ===== Ajuste compacto: Expedientes por usuario ===== */
#fullAccessKpis.owner-user-kpis{
  grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
  gap:8px;
  margin-bottom:10px;
}
#fullAccessKpis.owner-user-kpis .kpi.user-status-card{
  min-height:78px;
  padding:10px 12px 9px 14px;
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  grid-template-areas:
    "label value"
    "footer footer";
  align-items:start;
  row-gap:6px;
}
#fullAccessKpis.owner-user-kpis .kpi.user-status-card .label{
  grid-area:label;
  font-size:11px;
  line-height:1.15;
  margin:0;
  padding-right:8px;
}
#fullAccessKpis.owner-user-kpis .kpi.user-status-card .value{
  grid-area:value;
  font-size:18px;
  line-height:1;
  margin:0;
  text-align:right;
  white-space:nowrap;
}
#fullAccessKpis.owner-user-kpis .user-card-caption,
#fullAccessKpis.owner-user-kpis .user-card-breakdown{
  display:none !important;
}
#fullAccessKpis.owner-user-kpis .user-card-footer{
  grid-area:footer;
  margin:0;
  padding-top:0;
}
#fullAccessKpis.owner-user-kpis .kpi.user-status-card .kpi-view{
  font-size:11px;
}
@media(max-width:900px){
  #fullAccessKpis.owner-user-kpis{
    grid-template-columns:repeat(2,minmax(170px,1fr));
  }
}
@media(max-width:560px){
  #fullAccessKpis.owner-user-kpis{
    grid-template-columns:1fr;
  }
}


/* ===== DERIVADOS AL CONAS ===== */
.conas-toolbar{
  display:flex;align-items:flex-end;justify-content:space-between;
  gap:10px;flex-wrap:wrap;margin-bottom:10px
}
.conas-toolbar .field{min-width:260px;flex:1}
.conas-summary{
  display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px
}
.conas-summary .mini{
  border:1px solid var(--line);background:#fff;border-radius:9px;
  padding:8px 11px;font-size:11px;color:var(--muted)
}
.conas-summary .mini b{font-size:17px;color:var(--navy);margin-left:4px}
.conas-table-scroll{
  max-height:calc(100vh - var(--main-fixed-header-h) - 190px);
  overflow:auto;overscroll-behavior:contain
}
.conas-table-scroll th{
  position:static;top:0;z-index:35;background:var(--navy);color:#fff
}
.pill.conas{background:#ede9fe;color:#5b21b6}
.conas-row-selected td{background:#ede9fe!important}
@media(max-width:800px){
  .conas-toolbar{align-items:stretch}
  .conas-toolbar .field{min-width:100%}
}

/* ===== BLOQUEO SEGURO CUANDO NO HAY SESIÓN ===== */
body.session-locked .app{visibility:hidden;pointer-events:none}
body.session-locked #loginModal{visibility:visible}


/* =========================================================
   PALETA VISUAL 2026 · FONDOS MEJORADOS PARA TODOS LOS PERFILES
   Mantiene el azul institucional y mejora separación/lectura.
   ========================================================= */
:root{
  --navy:#173a63;
  --blue:#255784;
  --sky:#dcecf8;
  --bg:#edf3f8;
  --line:#cfdbe7;
  --text:#203044;
  --muted:#60748c;
  --white:#ffffff;

  --block:#ffffff;
  --block-soft:#f5f9fd;
  --block-muted:#eef4f9;
  --block-warm:#fff8ea;
  --block-danger:#fff2f2;

  --ok:#e3f3e8;
  --warn:#fff0c9;
  --danger:#f9dede;
  --shadow:0 5px 16px rgba(30,58,95,.075);
}

/* Fondo base */
body{
  background:#edf3f8;
}

/* Cada perfil tiene una tonalidad suave para identificar el espacio,
   sin cambiar la lógica ni los colores institucionales. */
.app.role-admin .main{
  background:
    linear-gradient(180deg,#f5f9ff 0,#edf4fb 46%,#eaf1f7 100%);
}
.app.role-archive .main{
  background:
    linear-gradient(180deg,#f7f9fc 0,#eef3f8 46%,#e9f0f6 100%);
}
.app.role-user .main,
.app.limited-user .main{
  background:
    linear-gradient(180deg,#f4faf8 0,#edf6f4 46%,#e9f2f2 100%);
}

/* Barra superior: bloque limpio y separado del contenido */
.topbar{
  background:rgba(255,255,255,.88);
  border:1px solid rgba(207,219,231,.92);
  border-radius:12px;
  padding:10px 12px;
  box-shadow:0 3px 12px rgba(30,58,95,.055);
}
.title h1{color:#173a63}
.title p{color:#64778d}

/* Barra de usuario/base */
.statusbar{
  background:#f8fbfe;
  border-color:#d3deea;
  box-shadow:0 2px 8px rgba(30,58,95,.035);
}

/* Pestañas */
.tabs{
  background:rgba(244,248,252,.78);
  border:1px solid #d5e0ea;
  border-radius:11px;
  padding:5px;
}
.tab{
  background:#ffffff;
  color:#556a82;
  border-color:#d3deea;
  box-shadow:0 1px 3px rgba(30,58,95,.035);
}
.tab:hover{
  background:#edf4fb;
  color:#173a63;
}
.tab.active{
  background:#173a63;
  color:#fff;
  border-color:#173a63;
  box-shadow:0 3px 8px rgba(23,58,99,.18);
}

/* Tarjetas y bloques */
.card{
  background:#ffffff;
  border-color:#cfdae6;
  box-shadow:0 4px 14px rgba(30,58,95,.06);
}
.filters{
  background:#f4f8fc;
  border-color:#cfdae6;
}
.table-head{
  background:#f8fbfe;
}
.table-head strong{
  color:#173a63;
}

/* Inputs */
.field input,
.field select,
.field textarea{
  background:#ffffff;
  border-color:#cbd8e5;
  color:#24364b;
}
.field input:focus,
.field select:focus,
.field textarea:focus{
  outline:none;
  border-color:#6e9bc3;
  box-shadow:0 0 0 3px rgba(37,87,132,.10);
}

/* KPI: fondos más diferenciados pero suaves */
.kpi{
  background:#f7fafe;
  border-color:#cfdae6;
}
.kpis .kpi:nth-child(4n+1):not(.warn):not(.danger){
  background:#f3f8fd;
}
.kpis .kpi:nth-child(4n+2):not(.warn):not(.danger){
  background:#f5f9fc;
}
.kpis .kpi:nth-child(4n+3):not(.warn):not(.danger){
  background:#f2f7fb;
}
.kpis .kpi:nth-child(4n+4):not(.warn):not(.danger){
  background:#f6f9fd;
}
.kpi.warn{
  background:#fff8e9;
}
.kpi.danger{
  background:#fff3f3;
}

/* Tarjetas resumen */
.summary-card{
  background:#f7fafe;
  border-color:#d2deea;
}
.summary-card:hover{
  background:#edf5fc;
}

/* Tablas: filas más fáciles de seguir */
table{
  background:#ffffff;
}
th{
  background:#183f6b;
}
tbody tr:nth-child(odd) td{
  background:#ffffff;
}
tbody tr:nth-child(even) td{
  background:#f8fafc;
}
tbody tr:hover td,
.record-selectable-row:hover td{
  background:#edf5fc!important;
}

/* La selección continúa teniendo alto contraste */
.record-selected-row td,
.conas-row-selected td{
  background:#dcecff!important;
  color:#153657!important;
}
.record-selected-row:hover td,
.record-selectable-row.record-selected-row:hover td,
.conas-row-selected:hover td{
  background:#cfe4fb!important;
}

/* Módulos operativos específicos */
#tab-requests .card,
#tab-all .card,
#tab-cargos .card,
#tab-conas .card{
  border-color:#ccd9e5;
}
#tab-requests .table-wrap,
#tab-all .table-wrap,
#tab-cargos .table-wrap,
#tab-conas .table-wrap{
  background:#ffffff;
}

/* Notas y ayudas */
.note{
  background:#f5f8fb;
  border-color:#d4dee8;
  color:#5f7288;
}

/* Botones secundarios menos blancos/planos */
.btn.secondary{
  background:#f9fbfd;
  border-color:#cbd8e5;
}
.btn.secondary:hover{
  background:#edf4fa;
}

/* Modales */
.modal-box{
  background:#fdfefe;
  border:1px solid #d5e0ea;
}

/* CONAS */
.conas-summary .mini{
  background:#f7fafe;
  border-color:#d0dce8;
}

/* Scrollbar discreto en navegadores compatibles */
.main *{
  scrollbar-color:#aebfd0 #edf2f7;
  scrollbar-width:thin;
}
.main *::-webkit-scrollbar{
  width:10px;
  height:10px;
}
.main *::-webkit-scrollbar-track{
  background:#edf2f7;
}
.main *::-webkit-scrollbar-thumb{
  background:#b1c1d1;
  border-radius:999px;
  border:2px solid #edf2f7;
}
.main *::-webkit-scrollbar-thumb:hover{
  background:#8fa5ba;
}


/* Contexto de custodia en búsqueda de expedientes */
.request-custody-date{
  min-width:145px;
  white-space:normal;
}
.request-date-context{
  display:inline-block;
  padding:4px 6px;
  border-radius:6px;
  background:#f2f6fa;
  color:#48627c;
  font-size:10px;
  line-height:1.3;
}
.request-date-context b{
  color:#173a63;
}
.request-date-context.conas-date{
  background:#eee9fb;
  color:#5b3b91;
}
.request-date-context.dvc-date{
  background:#e0f2fe;
  color:#075985;
}

/* ===== DERIVADOS A LA DVC ===== */
.dvc-toolbar{
  display:flex;align-items:flex-end;justify-content:space-between;
  gap:10px;flex-wrap:wrap;margin-bottom:10px
}
.dvc-toolbar .field{min-width:260px;flex:1}
.dvc-summary{
  display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px
}
.dvc-summary .mini{
  border:1px solid var(--line);background:#fff;border-radius:9px;
  padding:8px 11px;font-size:11px;color:var(--muted)
}
.dvc-summary .mini b{font-size:17px;color:var(--navy);margin-left:4px}
.dvc-table-scroll{
  max-height:calc(100vh - var(--main-fixed-header-h) - 190px);
  overflow:auto;overscroll-behavior:contain
}
.dvc-table-scroll th{
  position:static;top:0;z-index:35;background:var(--navy);color:#fff
}
.pill.dvc{background:#e0f2fe;color:#075985}
.dvc-row-selected td{background:#dbeafe!important}

@media(max-width:800px){
  .dvc-toolbar{align-items:stretch}
  .dvc-toolbar .field{min-width:100%}
}

.master-multi-trigger.has-selection{
  background:#f2f7fc;
  border-color:#7ea8ca;
  box-shadow:inset 3px 0 0 #255784
}


.master-state-check span{
  display:flex;
  align-items:center;
  gap:4px;
  min-width:0;
}
/* Sin punto decorativo: queda checkbox + estado */

/* ===== DÍA DE SOLICITUD · SELECCIÓN MÚLTIPLE ===== */
.master-day-field{
  position:relative;
  overflow:visible!important;
}
.master-day-multi-panel{
  left:0;
  top:calc(100% + 6px);
  width:min(405px,calc(100vw - 28px));
  max-width:none;
}
.master-day-options{
  display:flex;
  flex-direction:column;
  gap:5px;
  max-height:190px;
  overflow-y:auto;
  overflow-x:hidden;
  overscroll-behavior:contain;
  -webkit-overflow-scrolling:touch;
  touch-action:pan-y;
  padding:6px;
  background:#fff;
  scrollbar-width:thin;
  scrollbar-color:#9eb7ce #eef3f8;
}
.master-day-options::-webkit-scrollbar{
  width:10px;
}
.master-day-options::-webkit-scrollbar-track{
  background:#eef3f8;
  border-radius:10px;
}
.master-day-options::-webkit-scrollbar-thumb{
  background:#9eb7ce;
  border-radius:10px;
  border:2px solid #eef3f8;
}
.master-day-options::-webkit-scrollbar-thumb:hover{
  background:#88a6c2;
}
.master-day-check{
  display:flex;
  align-items:center;
  gap:8px;
  width:100%;
  min-height:32px;
  padding:6px 9px;
  border:1px solid #e2e9f0;
  border-radius:7px;
  background:#fbfdff;
  color:#3d556d;
  font-size:10.5px;
  line-height:1.15;
  cursor:pointer;
  user-select:none;
}
.master-day-check:hover{
  background:#f2f7fb;
  border-color:#c8d8e7;
}
.master-day-check:has(input:checked){
  background:#f5f9fc;
  border-color:#c8d9e8;
  box-shadow:inset 2px 0 0 #a8c4da;
  color:#294a67;
  font-weight:700;
}
.master-day-check input{
  width:15px;
  height:15px;
  flex:0 0 auto;
  accent-color:#7fa8c7;
}
.master-day-check span:first-of-type{
  flex:1 1 auto;
  min-width:0;
}
.master-day-check .day-count{
  margin-left:6px;
  padding:2px 6px;
  border-radius:999px;
  background:#edf2f7;
  color:#60758a;
  font-size:9px;
  font-weight:800;
}
.master-date-chip.selected{
  background:#eef5fb!important;
  border-color:#bfd1e3!important;
  color:#244867!important;
}
@media(max-width:760px){
  .master-day-options{
    grid-template-columns:1fr;
  }
}
@media(max-width:600px){
  .master-day-multi-panel{
    width:min(360px,calc(100vw - 16px));
  }
}

/* Registro maestro · indicador de listado de devueltos */
#tab-all table th:nth-child(7){
  white-space:nowrap;
}
#tab-all .list-status{
  font-size:9.5px;
  padding:3px 6px;
}

/* Registro maestro · persona que devuelve el expediente */
.returned-by-person{
  display:inline-block;
  max-width:150px;
  white-space:normal;
  line-height:1.15;
  font-size:9.5px;
  font-weight:700;
  color:#294a67;
}
.returned-by-person.empty{
  color:#8a99a8;
  font-weight:600;
}
.master-send-date{
  display:inline-flex;
  align-items:center;
  padding:3px 8px;
  border-radius:999px;
  font-size:10px;
  font-weight:700;
  background:#ecfeff;
  border:1px solid #bae6fd;
  color:#0f4c81;
  white-space:nowrap;
}
.master-send-date.pending{
  background:#fff7ed;
  border-color:#fed7aa;
  color:#9a3412;
}


.list-status.sent{background:#dcfce7;color:#166534}
.list-location-note{
  display:block;
  margin-top:3px;
  font-size:9px;
  line-height:1.15;
  font-weight:700;
  white-space:normal;
}
.list-location-note.barrenechea{color:#9a6700}
.list-location-note.san-luis{color:#166534}

.list-destination{
  display:block;
  margin-top:3px;
  font-size:9px;
  line-height:1.1;
  font-weight:800;
  color:#526b83;
}
.sede-badge{
  display:inline-block;
  padding:3px 6px;
  border-radius:999px;
  font-size:9px;
  font-weight:800;
  white-space:nowrap;
}
.sede-badge.barrenechea{
  background:#fff4dc;
  color:#8a5b00;
}
.sede-badge.san-luis{
  background:#dcfce7;
  color:#166534;
}
.sede-note{
  display:block;
  margin-top:3px;
  max-width:130px;
  font-size:8.5px;
  line-height:1.15;
  font-weight:700;
  white-space:normal;
}
.sede-note.pending{color:#946200}
.sede-note.sent{color:#166534}

/* Listados SAN LUIS · envío múltiple */
.archive-list-bulk-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
}
.archive-list-bulk-actions{
  display:flex;
  align-items:center;
  gap:6px;
  flex-wrap:wrap;
}
.archive-list-bulk-status{
  margin:6px 8px 4px;
  min-height:18px;
}
.archive-list-selectable{
  cursor:pointer;
}
.archive-list-selectable:hover td{
  background:#f4f8fc;
}
.archive-list-selected td{
  background:#edf6fd!important;
}
.archive-list-selected td:first-child{
  box-shadow:inset 3px 0 0 #86aac7;
}
.archive-list-disabled{
  opacity:.72;
}
.archive-list-checkbox{
  width:15px;
  height:15px;
  accent-color:#6f9fc4;
  cursor:pointer;
}
.archive-list-checkbox:disabled{
  cursor:not-allowed;
}

.archive-list-search-row{
  display:flex;
  align-items:flex-end;
  gap:7px;
  padding:8px 8px 5px;
  border-top:1px solid var(--line);
  background:#fbfdff;
}
.archive-list-search-field{
  flex:1 1 auto;
  min-width:180px;
}
.archive-list-search-field label{
  font-size:9px;
  margin-bottom:3px;
}
.archive-list-search-field input{
  min-height:34px;
  padding:6px 9px;
  font-size:11px;
}
.archive-list-search-clear{
  min-height:34px;
  flex:0 0 auto;
}
.archive-list-search-count{
  flex:0 0 auto;
  align-self:center;
  padding:4px 7px;
  border-radius:999px;
  background:#edf3f8;
  color:#536b84;
  font-size:9px;
  font-weight:800;
  white-space:nowrap;
}
@media(max-width:700px){
  .archive-list-search-row{
    flex-wrap:wrap;
  }
  .archive-list-search-field{
    min-width:100%;
  }
}


/* ===== Mejora responsive: evitar que la vista se vea demasiado compacta ===== */
#allTable table{
  min-width:1750px;
}
#allTable th,
#allTable td{
  white-space:nowrap;
}
#allTable td:nth-child(4),
#allTable td:nth-child(18){
  white-space:normal;
}
.master-table-head,
.table-head{
  flex-wrap:wrap;
}
.master-page-controls{
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
}
@media (max-width: 1400px){
  .main{
    padding:16px;
  }
  .main-sticky-header{
    padding:14px 16px 8px;
  }
  .topbar{
    align-items:flex-start;
  }
  .actions{
    width:100%;
    align-items:center;
    gap:8px;
  }
  .actions .btn,
  .actions .sel-count{
    flex:0 0 auto;
  }
  .filters{
    grid-template-columns:1fr 1fr;
  }
}
@media (max-width: 1100px){
  :root{--main-fixed-header-h:340px}
  .main-sticky-header{
    left:0;
    padding:12px 14px 8px;
  }
  .tabs{
    gap:6px;
  }
  .tab{
    padding:8px 11px;
  }
  .filters{
    grid-template-columns:1fr;
    gap:10px;
  }
  .table-wrap{
    overflow-x:auto;
    overflow-y:visible;
  }
  #allTable table{
    min-width:1650px;
  }
}
@media (max-width: 820px){
  :root{--main-fixed-header-h:390px}
  .title h1{
    font-size:20px;
    line-height:1.2;
  }
  .title p{
    font-size:12px;
  }
  .actions{
    gap:6px;
  }
  .btn{
    padding:8px 11px;
    font-size:12px;
  }
  .statusbar,
  .tabs{
    overflow-x:auto;
    white-space:nowrap;
    padding-bottom:4px;
  }
  .statusbar::-webkit-scrollbar,
  .tabs::-webkit-scrollbar,
  .table-wrap::-webkit-scrollbar{
    height:8px;
  }
  #allTable table{
    min-width:1550px;
  }
}


/* ===== Registro maestro · mejor aprovechamiento del ancho =====
   Los textos largos se parten en 2 o más líneas en vez de comprimir
   toda la tabla o exigir demasiado desplazamiento horizontal. */
#allTable{
  overflow-x:auto;
  overflow-y:visible;
}
#allTable table{
  min-width:1380px!important;
  width:100%;
  table-layout:auto;
  font-size:11px;
}
#allTable th{
  white-space:normal!important;
  overflow-wrap:anywhere;
  word-break:normal;
  line-height:1.15;
  padding:8px 6px;
  vertical-align:middle;
}
#allTable td{
  white-space:normal!important;
  overflow-wrap:anywhere;
  word-break:normal;
  line-height:1.2;
  padding:7px 6px;
  vertical-align:middle;
}

/* Datos breves que conviene mantener en una sola línea */
#allTable th:nth-child(2),
#allTable td:nth-child(2),   /* Expediente */
#allTable th:nth-child(3),
#allTable td:nth-child(3),   /* Extensión */
#allTable th:nth-child(4),
#allTable td:nth-child(4),   /* R.D. */
#allTable th:nth-child(11),
#allTable td:nth-child(11),  /* Fecha solicitud */
#allTable th:nth-child(14),
#allTable td:nth-child(14),  /* F. devolución */
#allTable th:nth-child(16),
#allTable td:nth-child(16),  /* Días háb. */
#allTable th:nth-child(17),
#allTable td:nth-child(17),  /* Modalidad */
#allTable th:nth-child(18),
#allTable td:nth-child(18),  /* Último folio */
#allTable th:nth-child(19),
#allTable td:nth-child(19),  /* Digitalizado */
#allTable th:nth-child(20),
#allTable td:nth-child(20){  /* Cargo */
  white-space:nowrap!important;
}

/* Columnas largas: limitar ancho para obligar salto de línea útil */
#allTable th:nth-child(5),
#allTable td:nth-child(5){   /* Responsable / ubicación */
  min-width:130px;
  max-width:165px;
}
#allTable th:nth-child(6),
#allTable td:nth-child(6){   /* Estado */
  min-width:92px;
  max-width:120px;
}
#allTable th:nth-child(7),
#allTable td:nth-child(7){   /* Listado */
  min-width:95px;
  max-width:120px;
}
#allTable th:nth-child(8),
#allTable td:nth-child(8){   /* Sede */
  min-width:95px;
  max-width:125px;
}
#allTable th:nth-child(9),
#allTable td:nth-child(9){   /* Fecha envío a San Luis */
  min-width:100px;
  max-width:115px;
}
#allTable th:nth-child(10),
#allTable td:nth-child(10){  /* Solicitante */
  min-width:105px;
  max-width:140px;
}
#allTable th:nth-child(12),
#allTable td:nth-child(12){  /* Fecha entrega expediente */
  min-width:105px;
  max-width:120px;
}
#allTable th:nth-child(15),
#allTable td:nth-child(15){  /* Devuelto por */
  min-width:100px;
  max-width:135px;
}
#allTable th:nth-child(22),
#allTable td:nth-child(22){  /* Observación */
  min-width:110px;
  max-width:170px;
}

/* Badges también pueden partirse sin deformar la tabla */
#allTable .pill,
#allTable .list-status,
#allTable .sede-badge,
#allTable .sede-note,
#allTable .returned-by-person,
#allTable .master-send-date{
  white-space:normal!important;
  text-align:center;
  line-height:1.15;
  max-width:100%;
}

/* Los botones de acción se mantienen utilizables y pueden bajar de línea */
#allTable td:last-child{
  min-width:128px;
  white-space:normal!important;
}
#allTable td:last-child .btn{
  margin:2px 2px 2px 0;
}

/* Pantallas medianas: en vez de reducir demasiado el texto,
   se conserva legibilidad y se permite un scroll horizontal moderado. */
@media(max-width:1400px){
  #allTable table{
    min-width:1280px!important;
  }
}
@media(max-width:1100px){
  #allTable table{
    min-width:1180px!important;
    font-size:10.5px;
  }
  #allTable th,
  #allTable td{
    padding:6px 5px;
  }
}
@media(max-width:820px){
  #allTable table{
    min-width:1120px!important;
  }
}



/* =========================================================
   V12 · LÍNEAS VERTICALES EN TODAS LAS TABLAS DEL SISTEMA
   Aplicado a Registro Maestro, Solicitudes, Expedientes por
   usuario, Cargos, Historial, Derivados, modales y demás tablas.
   ========================================================= */
table{
  border-left:1px solid #cbd7e6;
  border-right:1px solid #cbd7e6;
}

table th,
table td{
  border-right:1px solid #d7e0eb !important;
}

table th:last-child,
table td:last-child{
  border-right:0 !important;
}

/* Encabezados: separador un poco más marcado */
table thead th{
  border-right-color:#8fa9c7 !important;
}

/* Mantener una lectura limpia al pasar el mouse */
table tbody tr:hover td{
  border-right-color:#c2cfdf !important;
}

/* Tablas dentro de modales: misma separación visual */
.modal table th,
.modal table td,
.modal-box table th,
.modal-box table td{
  border-right:1px solid #d7e0eb !important;
}

.modal table thead th,
.modal-box table thead th{
  border-right-color:#8fa9c7 !important;
}

/* Última columna siempre sin línea sobrante */
.modal table th:last-child,
.modal table td:last-child,
.modal-box table th:last-child,
.modal-box table td:last-child{
  border-right:0 !important;
}



/* =========================================================
   V14 · TODAS LAS TABLAS DEL SISTEMA CENTRADAS
   Aplica a Registro Maestro, Solicitudes, Expedientes por
   usuario, Cargos, Historial, Derivados y tablas en modales.
   ========================================================= */
table th,
table td{
  text-align:center !important;
  vertical-align:middle !important;
}

/* Elementos internos centrados */
table th > *,
table td > *{
  margin-left:auto;
  margin-right:auto;
}

/* Contenedores flex dentro de celdas */
table td > div,
table td .actions,
table td .req-actions,
table td .row-actions,
table td .action-group{
  justify-content:center !important;
  align-items:center !important;
}

/* Etiquetas y badges */
table .pill,
table .badge,
table .cycle-badge,
table .sede-badge,
table .sede-note,
table .status-badge{
  text-align:center !important;
}

/* Checkboxes */
table input[type="checkbox"]{
  display:block;
  margin-left:auto !important;
  margin-right:auto !important;
}

/* Inputs y selects dentro de tablas */
table input:not([type="checkbox"]),
table select{
  text-align:center;
}

/* Historial y tablas dentro de modales */
.modal table th,
.modal table td,
.modal-box table th,
.modal-box table td{
  text-align:center !important;
  vertical-align:middle !important;
}

/* =========================================================
   V13 · REGISTRO MAESTRO CENTRADO
   Centra encabezados y contenido de todas las columnas.
   ========================================================= */
#allTable table th,
#allTable table td{
  text-align:center !important;
  vertical-align:middle !important;
}

#allTable table th > *,
#allTable table td > *{
  margin-left:auto;
  margin-right:auto;
}

/* Contenedores internos y acciones */
#allTable table td > div,
#allTable table td .actions,
#allTable table td .req-actions{
  justify-content:center !important;
  align-items:center !important;
}

/* Badges, pills y textos multilínea centrados */
#allTable .pill,
#allTable .sede-badge,
#allTable .sede-note,
#allTable .cycle-badge,
#allTable .badge{
  text-align:center !important;
}

/* Inputs/checkboxes de selección centrados */
#allTable input[type="checkbox"]{
  display:block;
  margin-left:auto;
  margin-right:auto;
}

/* ===== V11 · Registro Maestro · líneas verticales de columnas =====
   Se marcan suavemente para facilitar la lectura horizontal sin
   recargar visualmente la tabla. */
#allTable table{
  border-collapse:separate;
  border-spacing:0;
  border-left:1px solid #cbd7e6;
  border-right:1px solid #cbd7e6;
}

#allTable th,
#allTable td{
  border-right:1px solid #d7e0eb;
}

#allTable th:last-child,
#allTable td:last-child{
  border-right:0;
}

/* Encabezado: separador un poco más visible */
#allTable thead th{
  border-right-color:#8fa9c7;
}

/* Separadores de bloques relevantes */
#allTable th:nth-child(6),
#allTable td:nth-child(6),   /* Último estado */
#allTable th:nth-child(9),
#allTable td:nth-child(9),   /* Sede / bloque de ubicación */
#allTable th:nth-child(15),
#allTable td:nth-child(15),  /* Devuelto por */
#allTable th:nth-child(20),
#allTable td:nth-child(20){  /* Cargo */
  border-right:2px solid #b7c7d9;
}

/* La selección y los colores de estado siguen siendo los protagonistas. */
#allTable tbody tr:hover td{
  border-right-color:#c2cfdf;
}

/* ===== Registro maestro · corregir columna ALERTA ===== */
#allTable th:nth-child(21),
#allTable td:nth-child(21){
  min-width:58px!important;
  width:58px;
  max-width:70px;
  white-space:nowrap!important;
  overflow-wrap:normal!important;
  word-break:keep-all!important;
  text-align:center;
}

/* Evitar que el encabezado ALERTA se parta letra por letra */
#allTable th:nth-child(21){
  line-height:1.1;
}

/* Mantener Observación flexible para compensar el ancho */
#allTable th:nth-child(22),
#allTable td:nth-child(22){
  min-width:105px;
  max-width:165px;
  white-space:normal!important;
  overflow-wrap:anywhere;
}

/* =========================================================
   PANTALLA DIVIDIDA / VENTANA ANGOSTA
   Evita superposición de tarjetas, filtros y tablas.
   ========================================================= */
@media(max-width:1050px){

  /* Dentro de los módulos, los controles dejan de apilarse como sticky.
     Solo la cabecera principal del sistema permanece fija. */
  .module-sticky-piece{
    position:relative!important;
    top:auto!important;
    left:auto!important;
    right:auto!important;
    z-index:auto!important;
  }

  .module-sticky-piece.card,
  .module-sticky-piece.filters,
  .module-sticky-piece.workflow-intro,
  .module-sticky-piece.kpis,
  .module-sticky-piece.state-grid,
  .module-sticky-piece.request-workflow-kpis,
  .module-sticky-piece.cargo-kpis{
    box-shadow:none;
  }

  /* SOLICITUDES: todo sigue el flujo normal. */
  #tab-requests:not(.hidden){
    height:auto!important;
    min-height:0!important;
    overflow:visible!important;
    display:block!important;
  }

  #tab-requests .workflow-intro{
    position:relative!important;
    top:auto!important;
    display:flex;
    flex-wrap:wrap;
    align-items:flex-start;
    gap:8px;
    margin-bottom:8px;
  }

  #tab-requests .workflow-intro > div:first-child{
    flex:1 1 520px;
    min-width:0;
  }

  #tab-requests .workflow-intro #requestNewRequestBtn{
    flex:0 0 auto;
  }

  #tab-requests .workflow-steps{
    overflow-x:auto;
    flex-wrap:nowrap;
    padding-bottom:4px;
    max-width:100%;
    scrollbar-width:thin;
  }
  #tab-requests .workflow-step{
    flex:0 0 auto;
  }

  /* Tarjetas: 2 por fila en pantalla dividida. */
  #tab-requests .request-workflow-kpis,
  .app.limited-user #tab-requests .user-request-kpis{
    position:relative!important;
    top:auto!important;
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
    width:100%;
    gap:8px;
    margin-bottom:8px;
  }

  /* Filtros debajo de las tarjetas, sin superposición. */
  #tab-requests .filters,
  .app.limited-user #tab-requests .filters{
    position:relative!important;
    top:auto!important;
    width:100%;
    grid-template-columns:minmax(0,1.7fr) minmax(180px,1fr)!important;
    gap:8px;
    margin-bottom:8px;
  }

  /* La tabla conserva un área propia y desplazable. */
  #tab-requests .table-wrap,
  .app.limited-user #tab-requests .table-wrap{
    position:relative!important;
    top:auto!important;
    width:100%;
    max-width:100%;
    max-height:52vh!important;
    min-height:220px!important;
    overflow:auto!important;
    overscroll-behavior:contain;
    margin-top:0!important;
  }

  #tab-requests #requestsTable{
    min-width:100%;
  }

  .app.limited-user #tab-requests #requestsTable table{
    min-width:1050px!important;
  }

  #tab-requests .table-wrap th{
    position:static!important;
    top:0!important;
    z-index:22!important;
  }

  /* Mis expedientes también respeta flujo normal en ventana dividida. */
  .app.limited-user #tab-panel .module-sticky-piece{
    position:relative!important;
    top:auto!important;
  }

  .app.limited-user .user-personal-kpis{
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
    width:100%;
  }

  .app.limited-user #panelDetailWrap{
    max-height:52vh!important;
    min-height:220px!important;
    overflow:auto!important;
  }

  /* Cabecera superior: permitir que botones y pestañas ocupen varias filas
     sin desbordarse. */
  .main-sticky-header .topbar{
    align-items:flex-start;
  }
  .main-sticky-header .actions{
    width:100%;
    display:flex;
    flex-wrap:wrap;
    gap:7px;
  }
  .main-sticky-header .tabs{
    overflow-x:auto;
    overflow-y:hidden;
    white-space:nowrap;
    flex-wrap:nowrap;
    padding-bottom:4px;
    scrollbar-width:thin;
  }
  .main-sticky-header .tab{
    flex:0 0 auto;
  }
}

/* Pantallas aún más angostas: tarjetas y filtros en una columna. */
@media(max-width:650px){
  #tab-requests .request-workflow-kpis,
  .app.limited-user #tab-requests .user-request-kpis,
  .app.limited-user .user-personal-kpis{
    grid-template-columns:1fr!important;
  }

  #tab-requests .filters,
  .app.limited-user #tab-requests .filters{
    grid-template-columns:1fr!important;
  }

  #tab-requests .workflow-intro #requestNewRequestBtn{
    width:100%;
  }

  .app.limited-user .main{
    padding-left:8px;
    padding-right:8px;
  }
}

/* =========================================================
   VISTA ANGOSTA · PANEL DE USUARIOS/ÁREAS ARRIBA
   Evita que el menú lateral comprima Registro maestro.
   ========================================================= */
@media(max-width:1280px){

  .app{
    display:block!important;
    min-height:100vh;
  }

  .sidebar{
    position:relative!important;
    top:auto!important;
    left:auto!important;
    width:100%!important;
    height:auto!important;
    max-height:215px;
    padding:9px 12px!important;
    overflow:auto!important;
    border-bottom:1px solid rgba(255,255,255,.15);
  }

  .sidebar .brand{
    display:none;
  }

  .sidebar .side-title{
    margin:8px 4px 5px;
    font-size:9px;
  }

  .sidebar > #sideAll{
    display:inline-flex;
    width:auto;
    min-width:120px;
    margin:0 4px 6px 0;
  }

  #sidePersonal,
  #sideAreas{
    display:grid!important;
    grid-template-columns:repeat(4,minmax(145px,1fr));
    gap:4px 6px;
  }

  #sidePersonal .side-item,
  #sideAreas .side-item{
    min-width:0;
    margin:0!important;
    padding:7px 9px;
    font-size:10px;
  }

  #sidePersonal .side-item span:first-child,
  #sideAreas .side-item span:first-child{
    min-width:0;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }

  /* La cabecera deja de ser fixed: queda en el flujo y se pega arriba
     al comenzar a recorrer el contenido principal. */
  .main{
    padding:10px 12px 18px!important;
    min-width:0;
  }

  .main-sticky-header{
    position:relative!important;
    top:auto!important;
    left:auto!important;
    right:auto!important;
    width:100%!important;
    margin:0 0 10px!important;
    padding:10px 0 8px!important;
    box-shadow:0 4px 10px rgba(23,54,93,.07);
  }

  .main-sticky-header .topbar{
    gap:8px;
    margin-bottom:8px;
  }

  .main-sticky-header .title{
    min-width:0;
  }

  .main-sticky-header .title h1{
    font-size:20px;
    line-height:1.15;
  }

  .main-sticky-header .title p{
    font-size:10px;
  }

  .main-sticky-header .actions{
    width:100%;
    gap:6px;
  }

  .main-sticky-header .actions .btn{
    padding:7px 10px;
    font-size:10.5px;
  }

  .main-sticky-header .tabs{
    overflow-x:auto;
    overflow-y:hidden;
    flex-wrap:nowrap!important;
    white-space:nowrap;
    gap:5px;
    padding-bottom:4px;
  }

  .main-sticky-header .tab{
    flex:0 0 auto;
    padding:7px 10px;
    font-size:10.5px;
  }

  /* Registro maestro: filtros con más aire y sin quedar apretados. */
  .master-search-grid{
    grid-template-columns:minmax(0,1fr) auto!important;
    gap:8px;
  }

  .master-advanced{
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
    gap:8px!important;
  }

  .master-advanced .field{
    min-width:0;
  }

  .master-advanced .field label{
    white-space:normal;
    line-height:1.15;
  }

  /* Tabla: ancho moderado + texto en varias líneas.
     Se conserva desplazamiento horizontal local, no de toda la página. */
  #tab-all,
  #allTable,
  #tab-all .table-wrap{
    max-width:100%;
    min-width:0;
  }

  #allTable{
    overflow:auto!important;
  }

  #allTable table{
    min-width:1220px!important;
  }

  #allTable th,
  #allTable td{
    line-height:1.15;
  }

  /* El encabezado y las acciones del Registro maestro se acomodan
     en más de una línea si hace falta. */
  .master-table-head,
  .table-head{
    gap:7px;
    flex-wrap:wrap!important;
  }

  .master-page-controls{
    gap:6px;
    flex-wrap:wrap!important;
  }
}

@media(max-width:900px){
  .sidebar{
    max-height:190px;
  }

  #sidePersonal,
  #sideAreas{
    grid-template-columns:repeat(3,minmax(130px,1fr));
  }

  .master-advanced{
    grid-template-columns:1fr!important;
  }

  #allTable table{
    min-width:1120px!important;
  }
}

@media(max-width:620px){
  #sidePersonal,
  #sideAreas{
    grid-template-columns:repeat(2,minmax(120px,1fr));
  }

  .master-search-grid{
    grid-template-columns:1fr!important;
  }
}

/* Registro maestro · Fecha último estado */
#allTable th:nth-child(13),
#allTable td:nth-child(13){
  min-width:98px;
  max-width:112px;
  white-space:nowrap!important;
  text-align:center;
}
#allTable th:nth-child(13){
  white-space:normal!important;
  line-height:1.1;
}

/* ===== Registro maestro · fechas consolidadas ===== */
#allTable table{
  min-width:1180px!important;
  width:100%;
}
#allTable th,
#allTable td{
  vertical-align:middle;
  line-height:1.15;
}

/* Fechas principales: solicitud, entrega y último estado */
#allTable th:nth-child(10),
#allTable td:nth-child(10),
#allTable th:nth-child(11),
#allTable td:nth-child(11),
#allTable th:nth-child(12),
#allTable td:nth-child(12){
  min-width:92px;
  max-width:112px;
}

#allTable th:nth-child(12){
  white-space:normal!important;
  line-height:1.1;
}

#allTable .master-current-state-date{
  white-space:nowrap!important;
}

/* Devuelto por */
#allTable th:nth-child(13),
#allTable td:nth-child(13){
  min-width:105px;
  max-width:145px;
  white-space:normal!important;
}

/* Alerta */
#allTable th:nth-child(19),
#allTable td:nth-child(19){
  min-width:55px!important;
  white-space:nowrap!important;
  word-break:keep-all!important;
  text-align:center;
}

/* ===== Registro maestro · columnas alineadas ===== */
#allTable table{
  min-width:1240px!important;
  width:100%;
}
#allTable th,
#allTable td{
  vertical-align:middle!important;
  line-height:1.15!important;
}

/* 1 Selección */
#allTable th:nth-child(1),
#allTable td:nth-child(1){
  width:28px;
  min-width:28px;
  text-align:center;
  white-space:nowrap!important;
}

/* 2 Expediente · 3 Extensión · 4 R.D. */
#allTable th:nth-child(2), #allTable td:nth-child(2){min-width:78px;white-space:nowrap!important}
#allTable th:nth-child(3), #allTable td:nth-child(3){min-width:55px;white-space:nowrap!important}
#allTable th:nth-child(4), #allTable td:nth-child(4){min-width:55px;white-space:nowrap!important}

/* 5 Responsable actual / ubicación */
#allTable th:nth-child(5),
#allTable td:nth-child(5){
  min-width:125px;
  max-width:160px;
  white-space:normal!important;
  overflow-wrap:anywhere;
}

/* 6 Último estado */
#allTable th:nth-child(6),
#allTable td:nth-child(6){
  min-width:92px;
  max-width:120px;
  white-space:normal!important;
  text-align:center;
}

/* 7 Listado · 8 Sede */
#allTable th:nth-child(7), #allTable td:nth-child(7){
  min-width:92px;
  max-width:120px;
  white-space:normal!important;
}
#allTable th:nth-child(8), #allTable td:nth-child(8){
  min-width:92px;
  max-width:120px;
  white-space:normal!important;
}

/* 9 Solicitante */
#allTable th:nth-child(9),
#allTable td:nth-child(9){
  min-width:105px;
  max-width:140px;
  white-space:normal!important;
}

/* 10 Fecha solicitud · 11 Fecha entrega · 12 Fecha último estado */
#allTable th:nth-child(10), #allTable td:nth-child(10),
#allTable th:nth-child(11), #allTable td:nth-child(11),
#allTable th:nth-child(12), #allTable td:nth-child(12){
  min-width:94px;
  max-width:112px;
}
#allTable th:nth-child(10),
#allTable th:nth-child(11),
#allTable th:nth-child(12){
  white-space:normal!important;
  text-align:center;
}
#allTable td:nth-child(10),
#allTable td:nth-child(11),
#allTable td:nth-child(12){
  white-space:nowrap!important;
}

/* 13 Devuelto por */
#allTable th:nth-child(13),
#allTable td:nth-child(13){
  min-width:105px;
  max-width:145px;
  white-space:normal!important;
  text-align:center;
}

/* 14 Días háb. */
#allTable th:nth-child(14),
#allTable td:nth-child(14){
  min-width:55px;
  white-space:nowrap!important;
  text-align:center;
}

/* 15 Modalidad */
#allTable th:nth-child(15),
#allTable td:nth-child(15){
  min-width:72px;
  white-space:nowrap!important;
  text-align:center;
}

/* 16 Últ. folio */
#allTable th:nth-child(16),
#allTable td:nth-child(16){
  min-width:62px;
  white-space:nowrap!important;
  text-align:center;
}

/* 17 Digitalizado */
#allTable th:nth-child(17),
#allTable td:nth-child(17){
  min-width:72px;
  white-space:nowrap!important;
  text-align:center;
}

/* 18 Cargo */
#allTable th:nth-child(18),
#allTable td:nth-child(18){
  min-width:78px;
  white-space:normal!important;
  text-align:center;
}

/* 19 Alerta */
#allTable th:nth-child(19),
#allTable td:nth-child(19){
  min-width:58px!important;
  max-width:72px;
  white-space:nowrap!important;
  word-break:keep-all!important;
  overflow-wrap:normal!important;
  text-align:center;
}

/* 20 Observación */
#allTable th:nth-child(20),
#allTable td:nth-child(20){
  min-width:105px;
  max-width:165px;
  white-space:normal!important;
  overflow-wrap:anywhere;
}

/* 21 Acciones */
#allTable th:nth-child(21),
#allTable td:nth-child(21){
  min-width:150px;
  white-space:normal!important;
  text-align:center;
}
#allTable td:nth-child(21)>div{
  justify-content:center;
  flex-wrap:wrap;
  white-space:normal!important;
}

/* ===== Registro maestro · acciones simplificadas ===== */
#allTable th:nth-child(21),
#allTable td:nth-child(21){
  min-width:170px!important;
  width:170px;
  max-width:190px;
  white-space:nowrap!important;
  text-align:center;
}

#allTable .master-actions-inline{
  display:flex!important;
  flex-direction:row!important;
  align-items:center;
  justify-content:center;
  gap:6px;
  flex-wrap:nowrap!important;
  white-space:nowrap!important;
}

#allTable .master-actions-inline .btn{
  flex:0 0 auto;
  margin:0!important;
  white-space:nowrap!important;
  padding:6px 9px;
  font-size:10px;
}


/* =========================================================
   V9 · GESTIÓN UNIFORMIZADA DE SOLICITUD
   Registro Maestro = gestión rápida por expediente.
   Nueva solicitud = gestión completa.
   Ambos comparten nombres, bloques y reglas.
   ========================================================= */
#requestDetailModal .modal-box{
  max-width:1280px;
  width:min(96vw,1280px);
}

#requestDetailModal .request-quick-intro{
  margin:10px 0 12px;
  padding:9px 11px;
  border:1px solid #cddcf7;
  border-left:4px solid var(--blue);
  border-radius:8px;
  background:#f5f9ff;
  color:var(--navy);
  font-size:11px;
  line-height:1.4;
}

#requestDetailModal .request-unified-section{
  margin:12px 0;
  padding:14px;
  border:1px solid #cddcf7;
  border-radius:11px;
  background:#f8fbff;
  box-shadow:0 2px 8px rgba(15,39,71,.04);
}

#requestDetailModal .request-unified-title{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
  margin-bottom:10px;
  padding-bottom:9px;
  border-bottom:1px solid #dbe4ef;
}

#requestDetailModal .request-unified-title strong{
  display:block;
  color:var(--navy);
  font-size:14px;
}

#requestDetailModal .request-unified-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(220px,1fr));
  gap:10px;
}

#requestDetailModal .request-unified-observation{
  margin-top:10px;
}

#requestDetailModal .request-location-section{
  margin-top:12px;
  padding:10px 12px;
  border:1px solid #dbe4ef;
  border-radius:9px;
  background:#fbfdff;
}

#requestDetailModal .request-location-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:10px;
  flex-wrap:wrap;
}

#requestDetailModal .request-location-head strong{
  color:var(--navy);
}

#requestDetailModal .request-items-card{
  overflow:visible;
}
#requestDetailModal .request-items-head{
  align-items:center;
}
#requestDetailModal .request-items-head-note{
  margin-top:3px;
  font-size:10px;
}
#requestDetailModal #rqItemPrimaryActions{
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
  padding:10px 12px;
  margin:0;
  border-top:1px solid #e5edf5;
  border-bottom:1px solid #dbe4ef;
  background:#f8fbff;
}
#requestDetailModal #rqItemPrimaryActions.hidden{
  display:none!important;
}
#requestDetailModal #rqItemPrimaryActions .request-primary-label{
  font-size:10px;
  font-weight:900;
  color:#52677d;
  text-transform:uppercase;
  letter-spacing:.04em;
  margin-right:2px;
}
#requestDetailModal #rqItemPrimaryActions .request-primary-note{
  flex-basis:100%;
  margin-top:0;
  font-size:10px;
  line-height:1.35;
  color:#64748b;
}
#requestDetailModal #rqItemPrimaryActions .btn{
  min-height:34px;
}
@media(max-width:760px){
  #requestDetailModal #rqItemPrimaryActions .btn{
    flex:1 1 210px;
  }
}


/* V613 · La atención pertenece al cuadro de expedientes seleccionados. */
#requestDetailModal .v613-attention-inside{
  margin:0;
  padding:0;
  background:#f8fbff;
  border-bottom:1px solid #dbe4ef;
}
#requestDetailModal .v613-attention-inside:empty{display:none}
#requestDetailModal .request-items-card #rqAttentionSection,
#requestDetailModal .request-items-card #rqObservationSection{
  margin:0!important;
  border:0!important;
  border-radius:0!important;
  box-shadow:none!important;
  background:transparent!important;
}
#requestDetailModal .request-items-card #rqAttentionSection{
  padding:12px 12px 8px!important;
}
#requestDetailModal .request-items-card #rqObservationSection{
  padding:4px 12px 10px!important;
  border-top:1px dashed #dbe4ef!important;
}
#requestDetailModal .request-items-card #rqAttentionSection .request-unified-title{
  margin-bottom:9px;
  padding-bottom:7px;
}
#requestDetailModal .request-items-card #rqAttentionSection .request-unified-title strong::after{
  content:' · expedientes seleccionados';
  margin-left:5px;
  font-size:10px;
  color:#64748b;
  font-weight:800;
}
#requestDetailModal .request-items-card #rqItemPrimaryActions{
  border-top:1px solid #dbe4ef;
  border-bottom:0;
  background:#eef5ff;
}
#requestDetailModal .request-items-card #rqItemPrimaryActions .btn{
  min-height:36px;
}
@media(max-width:760px){
  #requestDetailModal .request-items-card #rqAttentionSection,
  #requestDetailModal .request-items-card #rqObservationSection{padding-left:9px!important;padding-right:9px!important}
}

#requestDetailModal #rqWorkflowActions{
  padding:10px 0 2px;
  align-items:center;
}

#requestDetailModal #rqWorkflowActions .note{
  flex-basis:100%;
  margin-top:2px;
}

@media(max-width:760px){
  #requestDetailModal .request-unified-grid{
    grid-template-columns:1fr;
  }
}

/* Solicitudes entre áreas · espera de devolución */
.status-attn.wait-return,
.req-state.req-wait-return{
  background:#fff0d8;
  color:#8b4f00;
  border-color:#f2cf94;
}
.cross-area-wait-note{
  display:block;
  margin-top:4px;
  font-size:9px;
  line-height:1.2;
  color:#8a5a13;
  font-weight:700;
}
.cross-area-wait-inline{
  margin-top:4px;
  padding:5px 7px;
  border:1px solid #f0d49e;
  border-radius:7px;
  background:#fffaf0;
  font-size:10px;
  line-height:1.3;
  color:#6e4a11;
}

/* Flujo entre áreas · recepción por Archivo */
.req-state.req-wait-return + .cross-area-wait-note{
  margin-top:4px;
}
#rqWorkflowActions .btn{
  align-self:center;
}

/* =========================================================
   PANEL LATERAL OCULTABLE
   ========================================================= */
.app.sidebar-collapsed{
  grid-template-columns:1fr!important;
}

.app.sidebar-collapsed .sidebar{
  display:none!important;
}

.sidebar-toggle-btn{
  white-space:nowrap;
}

/* El perfil USUARIO ya no utiliza la franja azul. */
.app.limited-user #sidebarToggleBtn{
  display:none!important;
}

/* En pantalla angosta, al ocultar el panel superior azul también
   se recupera inmediatamente todo el espacio vertical. */
@media(max-width:1280px){
  .app.sidebar-collapsed{
    display:block!important;
  }

  .app.sidebar-collapsed .main{
    width:100%!important;
    max-width:none!important;
  }
}

/* =========================================================
   PANEL OCULTO · CABECERA SIN DEFORMACIÓN
   Al desaparecer la barra de 285px, la cabecera fija también
   debe recuperar exactamente ese espacio.
   ========================================================= */
@media(min-width:1281px){
  .app.sidebar-collapsed .main-sticky-header{
    left:0!important;
    right:0!important;
    width:auto!important;
  }

  .app.sidebar-collapsed .main{
    width:100%!important;
    max-width:none!important;
  }

  /* Mantener la misma estructura interna de la cabecera.
     Solo cambia el ancho disponible. */
  .app.sidebar-collapsed .main-sticky-header .topbar{
    width:100%;
  }

  .app.sidebar-collapsed .main-sticky-header .statusbar{
    width:100%;
  }

  .app.sidebar-collapsed .main-sticky-header .tabs{
    width:100%;
  }
}

/* En pantalla angosta la cabecera ya trabaja en flujo normal,
   por lo que solo aseguramos ancho completo. */
@media(max-width:1280px){
  .app.sidebar-collapsed .main-sticky-header{
    left:auto!important;
    right:auto!important;
    width:100%!important;
  }
}

/* =========================================================
   SOLICITUDES · CABECERA SIMPLIFICADA
   ========================================================= */
#tab-requests .requests-list-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  flex-wrap:wrap;
}

#tab-requests .requests-list-head-actions{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:8px;
  flex-wrap:wrap;
}

#tab-requests #requestNewRequestBtn{
  flex:0 0 auto;
  white-space:nowrap;
}

/* Al eliminar la bandeja operativa, recuperar el espacio vertical. */
#tab-requests .request-workflow-kpis{
  margin-top:0!important;
}

#tab-requests .table-wrap{
  max-height:calc(100vh - 245px);
}

@media(max-width:650px){
  #tab-requests .requests-list-head{
    align-items:stretch;
  }

  #tab-requests .requests-list-head-actions{
    width:100%;
    justify-content:space-between;
  }

  #tab-requests #requestNewRequestBtn{
    flex:0 0 auto!important;
    width:auto!important;
  }
}

/* ===== DERIVADOS A INSTRUCCIÓN ===== */
.instruction-toolbar{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:10px;
  flex-wrap:wrap;
  margin-bottom:10px;
}
.instruction-toolbar .field{
  min-width:260px;
  flex:1;
}
.instruction-summary{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-bottom:10px;
}
.instruction-summary .mini{
  border:1px solid var(--line);
  background:#fff;
  border-radius:9px;
  padding:8px 11px;
  font-size:11px;
  color:var(--muted);
}
.instruction-summary .mini b{
  font-size:17px;
  color:var(--navy);
  margin-left:4px;
}
.instruction-table-scroll{
  max-height:calc(100vh - var(--main-fixed-header-h) - 190px);
  overflow:auto;
  overscroll-behavior:contain;
}
.instruction-table-scroll th{
  position:static;
  top:0;
  z-index:35;
  background:var(--navy);
  color:#fff;
}
.pill.instruction{
  background:#f3e8ff;
  color:#6b21a8;
}
.pill.instruction-return{
  background:#dcfce7;
  color:#166534;
}
.instruction-row-selected td{
  background:#ede9fe!important;
}
#tab-instruction .card{
  border-color:#ccd9e5;
}
#tab-instruction .table-wrap{
  background:#fff;
}

.instruction-return-input{
  width:100%;
  min-width:100px;
  padding:7px 8px;
  border:1px solid var(--line);
  border-radius:7px;
  background:#fff;
  font:inherit;
}
.instruction-return-input.required{
  border-color:#d69a2d;
}

@media(max-width:800px){
  .instruction-toolbar{
    align-items:stretch;
  }
  .instruction-toolbar .field{
    min-width:100%;
  }
}

/* Retorno de Instrucción directamente desde Nueva solicitud */
.instruction-request-return-layer{
  z-index:95!important;
}

.instruction-return-from-request-btn{
  margin-top:6px;
  width:100%;
  white-space:normal!important;
}

.request-date-context.instruction-date{
  background:#f4ecff;
  border-color:#dcc7f6;
  color:#653294;
}

#instructionRequestReturnModal .modal-box{
  box-shadow:0 28px 90px rgba(15,23,42,.36);
}

/* Registro maestro · retorno directo de CONAS */
#allTable .master-actions-inline{
  display:flex!important;
  flex-direction:row!important;
  align-items:center;
  justify-content:center;
  gap:5px;
  flex-wrap:nowrap!important;
  white-space:nowrap!important;
}

#allTable .master-conas-return-btn{
  flex:0 0 auto;
  white-space:nowrap!important;
  background:#5b21b6;
  border-color:#5b21b6;
}

#allTable .master-conas-return-btn:hover{
  filter:brightness(.96);
}

#allTable th:last-child,
#allTable td:last-child{
  min-width:255px!important;
}

/* Búsqueda de solicitud · fecha del último estado */
.request-custody-date{
  min-width:170px;
  white-space:normal!important;
}

.request-custody-date .request-date-context{
  display:inline-block;
  line-height:1.25;
  white-space:normal!important;
}

/* =========================================================
   CENTRO DE ALERTAS · SEPARADO POR TIPO
   ========================================================= */
#alertsModal .alerts-modal-box{
  max-width:1120px;
  padding:18px;
  background:#f7fafc;
}

#alertsModal .alerts-modal-head{
  margin-bottom:12px;
  padding-bottom:12px;
  border-bottom:1px solid #cbd8e6;
}

#alertsModal .alerts-modal-subtitle{
  margin-top:3px;
  font-size:12px;
  color:#64748b;
}

#alertsModal .alerts-total-card{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:16px;
  padding:10px 12px;
  border:1px solid #cbd8e6;
  border-radius:10px;
  background:#fff;
}

#alertsModal .alerts-total-card>div:first-child{
  display:flex;
  align-items:center;
  gap:8px;
}

#alertsModal .alerts-total-label{
  font-size:11px;
  font-weight:800;
  color:#64748b;
  letter-spacing:.04em;
}

#alertsModal #alertsUnreadText{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width:28px;
  height:25px;
  padding:0 8px;
  border-radius:999px;
  background:#173f6b;
  color:#fff;
  font-size:13px;
}

#alertsModal .alerts-total-help{
  font-size:11px;
  color:#64748b;
  text-align:right;
}

#alertsModal .alerts-group{
  margin:0 0 20px;
  padding:0;
  border:1px solid #cbd8e6;
  border-radius:12px;
  overflow:hidden;
  background:#fff;
  box-shadow:0 3px 10px rgba(15,23,42,.04);
}

#alertsModal .alerts-group-title{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:10px 12px;
  border-bottom:1px solid #cbd8e6;
  background:#edf4fb;
}

#alertsModal .alerts-group-title>div:first-child{
  display:flex;
  align-items:center;
  gap:8px;
}

#alertsModal .alerts-group-title strong{
  font-size:12px;
  color:#163a63;
  letter-spacing:.02em;
}

#alertsModal .alerts-group-number{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:23px;
  height:23px;
  border-radius:50%;
  background:#173f6b;
  color:#fff;
  font-size:11px;
  font-weight:800;
}

#alertsModal .alerts-group-hint{
  font-size:10px;
  color:#64748b;
  text-align:right;
}

#alertsModal .alerts-type-card{
  margin:12px;
  border:1px solid #d7e1ec;
  border-radius:10px;
  background:#fff;
  overflow:hidden;
}

#alertsModal .alerts-type-card + .alerts-type-card{
  margin-top:16px;
}

#alertsModal .alerts-type-head{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:12px;
  padding:11px 12px;
  border-bottom:1px solid #e2e8f0;
  background:#f9fbfd;
}

#alertsModal .alerts-type-head strong{
  display:block;
  color:#173f6b;
  font-size:13px;
}

#alertsModal .alerts-type-description{
  margin-top:3px;
  max-width:780px;
  font-size:10.5px;
  line-height:1.35;
  color:#64748b;
}

#alertsModal .alerts-type-list{
  margin-top:0;
  padding:10px 12px 12px;
  min-height:62px;
  background:#fff;
}

#alertsModal .alerts-type-list>.empty{
  margin:0;
  padding:16px 10px;
  border:0;
  background:transparent;
}

#alertsModal .alerts-type-actions{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:7px;
  flex-wrap:wrap;
}

#alertsModal .alerts-group-loans{
  border-left:4px solid #d97706;
}

#alertsModal .alerts-group-returns{
  border-left:4px solid #2563a8;
}

#alertsModal .alerts-group-reassign{
  border-left:4px solid #6d4bb5;
}

#alertsModal .alerts-group-loans .alerts-group-title{
  background:#fff8e8;
}

#alertsModal .alerts-group-returns .alerts-group-title{
  background:#edf6ff;
}

#alertsModal .alerts-group-reassign .alerts-group-title{
  background:#f5f0ff;
}

#alertsModal .notification-item,
#alertsModal .alert-item,
#alertsModal .cross-area-wait-alert{
  border-radius:9px;
}

@media(max-width:720px){
  #alertsModal .alerts-modal-box{
    padding:12px;
  }

  #alertsModal .alerts-total-card,
  #alertsModal .alerts-group-title,
  #alertsModal .alerts-type-head{
    align-items:flex-start;
    flex-direction:column;
  }

  #alertsModal .alerts-total-help,
  #alertsModal .alerts-group-hint{
    text-align:left;
  }

  #alertsModal .alerts-type-actions{
    justify-content:flex-start;
  }
}

/* =========================================================
   DEVOLUCIONES HISTÓRICAS POR USUARIO
   ========================================================= */
.historical-return-label{
  display:inline-block;
  margin-top:3px;
  padding:2px 6px;
  border-radius:999px;
  background:#dcfce7;
  color:#166534;
  font-size:9px;
  font-weight:800;
  white-space:nowrap;
}

.historical-return-date{
  display:inline-block;
  padding:3px 7px;
  border-radius:999px;
  background:#e0f2fe;
  color:#075985;
  font-weight:800;
  white-space:nowrap;
}

.historical-current-note{
  margin-top:2px;
  font-size:9px;
  color:var(--muted);
  font-weight:700;
}

#panelTable .historical-return-label + *{
  margin-top:2px;
}

/* ===== LISTADOS DEVUELTOS · MULTISELECCIÓN MEJORADA ===== */
.archive-list-bulk-actions{
  display:flex;
  gap:6px;
  align-items:center;
  flex-wrap:wrap;
}
.archive-list-bulk-actions .btn{
  white-space:nowrap;
}
.archive-list-selected{
  background:#eef7ff!important;
  box-shadow:inset 3px 0 0 #1d6fa5;
}
.archive-list-selectable{
  cursor:pointer;
}
.archive-list-selectable:hover{
  background:#f4f9fd;
}
.archive-list-checkbox{
  width:15px;
  height:15px;
  cursor:pointer;
}
.archive-list-selection-summary{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
  margin-top:6px;
}
.archive-list-selection-summary .mini{
  padding:4px 7px;
  border:1px solid #d8e3ed;
  border-radius:8px;
  background:#f8fafc;
  font-size:9px;
  font-weight:800;
  color:#48657d;
}
.list-generated-by{
  display:inline-block;
  max-width:150px;
  white-space:normal;
  line-height:1.15;
  font-size:9.5px;
  font-weight:800;
  color:#294a67;
}
.list-generated-by.empty{
  color:#8a99a8;
  font-weight:600;
}
.archive-multi-list-tag{
  display:inline-block;
  padding:3px 6px;
  border-radius:999px;
  background:#eef2ff;
  color:#3730a3;
  font-size:9px;
  font-weight:900;
  white-space:nowrap;
}

/* ============================================================
   INCORPORAR EXPEDIENTES EN CUSTODIA
   ============================================================ */
.custody-import-box{
  border:1px solid #d6e2ed;
  border-radius:12px;
  background:#f8fbfe;
  padding:12px;
}
.custody-mode{
  display:flex;
  gap:7px;
  flex-wrap:wrap;
  margin-bottom:10px;
}
.custody-mode .mode-btn{
  border:1px solid #bfd0df;
  background:#fff;
  color:#294a67;
  border-radius:8px;
  padding:7px 12px;
  font-weight:800;
  cursor:pointer;
}
.custody-mode .mode-btn.active{
  background:#173f6b;
  border-color:#173f6b;
  color:#fff;
}
.custody-summary{
  display:grid;
  grid-template-columns:repeat(4,minmax(110px,1fr));
  gap:8px;
  margin:10px 0;
}
.custody-summary .mini{
  border:1px solid #d6e2ed;
  border-radius:10px;
  padding:8px 10px;
  background:#fff;
}
.custody-summary .mini span{
  display:block;
  font-size:9px;
  font-weight:900;
  color:#6b7f91;
  text-transform:uppercase;
}
.custody-summary .mini b{
  display:block;
  margin-top:2px;
  font-size:19px;
  color:#163f69;
}
.custody-preview{
  max-height:320px;
  overflow:auto;
  border:1px solid #d8e3ed;
  border-radius:10px;
  background:#fff;
}
.custody-preview table{
  width:100%;
  border-collapse:collapse;
  font-size:10px;
}
.custody-preview th{
  position:static;
  top:0;
  z-index:2;
  background:#173f6b;
  color:#fff;
  padding:7px;
  text-align:left;
}
.custody-preview td{
  padding:7px;
  border-bottom:1px solid #edf2f7;
  vertical-align:top;
}
.custody-status{
  display:inline-block;
  padding:3px 7px;
  border-radius:999px;
  font-size:9px;
  font-weight:900;
  white-space:nowrap;
}
.custody-status.nuevo{background:#dcfce7;color:#166534}
.custody-status.existe{background:#fef3c7;color:#92400e}
.custody-status.error{background:#fee2e2;color:#991b1b}
.custody-rule{
  margin:8px 0 0;
  padding:9px 11px;
  border-left:4px solid #0284c7;
  border-radius:8px;
  background:#eff6ff;
  color:#334155;
  font-size:10px;
  line-height:1.4;
}
@media(max-width:800px){
  .custody-summary{grid-template-columns:repeat(2,minmax(100px,1fr))}
}

/* ============================================================
   BÚSQUEDA DE SOLICITUD POR EXPEDIENTE + EXTENSIÓN
   ============================================================ */
.request-extension-match{
  display:inline-block;
  padding:3px 7px;
  border-radius:999px;
  background:#e0f2fe;
  color:#075985;
  font-size:9px;
  font-weight:900;
  white-space:nowrap;
}
.request-extension-help{
  margin-top:4px;
  font-size:9px;
  color:#64748b;
  line-height:1.35;
}
.request-extension-warning{
  margin-top:7px;
  padding:7px 9px;
  border-left:4px solid #d97706;
  border-radius:7px;
  background:#fffbeb;
  color:#92400e;
  font-size:10px;
  line-height:1.35;
}

/* ============================================================
   REGISTRO MAESTRO · CICLOS DE SOLICITUD
   ============================================================ */
.master-cycle-row-closed td{
  background:#f8fafc!important;
  color:#526273;
}
.master-cycle-row-closed:hover td{
  background:#f4f6f8!important;
}
.master-cycle-row-active td:first-child{
  box-shadow:inset 3px 0 0 #2f6fa5;
}
.master-cycle-row-closed td:first-child{
  box-shadow:inset 3px 0 0 #94a3b8;
}
.master-cycle-badge{
  display:inline-flex;
  align-items:center;
  margin-top:4px;
  padding:2px 6px;
  border-radius:999px;
  font-size:8.5px;
  line-height:1.15;
  font-weight:900;
  white-space:nowrap;
}


/* =========================================================
   V21 · CENTRADO REAL DE TODO EL CONTENIDO DEL REGISTRO MAESTRO
   ========================================================= */

/* Celdas */
#allTable table.master-v19 tbody td{
  text-align:center !important;
  vertical-align:middle !important;
}

/* Cualquier elemento interno, aunque tenga estilos anteriores */
#allTable table.master-v19 tbody td *,
#allTable table.master-v19 tbody td div,
#allTable table.master-v19 tbody td span,
#allTable table.master-v19 tbody td b,
#allTable table.master-v19 tbody td strong,
#allTable table.master-v19 tbody td small,
#allTable table.master-v19 tbody td a,
#allTable table.master-v19 tbody td label{
  text-align:center !important;
}

/* Bloques internos ocupan el ancho de su celda para que el texto
   se centre respecto de la columna y no respecto de su propio ancho */
#allTable table.master-v19 tbody td > div,
#allTable table.master-v19 tbody td > span:not(.pill):not(.badge):not(.master-cycle-badge):not(.master-cycle-readonly),
#allTable table.master-v19 tbody td > b,
#allTable table.master-v19 tbody td > strong{
  width:100%;
  box-sizing:border-box;
}

/* Flexbox internos */
#allTable table.master-v19 tbody td .master-actions-inline,
#allTable table.master-v19 tbody td .req-actions,
#allTable table.master-v19 tbody td .actions,
#allTable table.master-v19 tbody td [style*="display:flex"],
#allTable table.master-v19 tbody td [style*="display: flex"]{
  justify-content:center !important;
  align-items:center !important;
}

/* Asunto y observación también centrados */
#allTable table.master-v19 tbody td.v19-asunto,
#allTable table.master-v19 tbody td.v19-observation,
#allTable table.master-v19 tbody td.v19-person,
#allTable table.master-v19 tbody td.v19-area,
#allTable table.master-v19 tbody td.v19-date{
  text-align:center !important;
}

/* Solicitud / ciclo */
#allTable table.master-v19 .v19-small,
#allTable table.master-v19 .master-cycle-badge,
#allTable table.master-v19 .master-cycle-readonly,
#allTable table.master-v19 .master-cycle-request-number{
  display:flex !important;
  justify-content:center !important;
  align-items:center !important;
  width:max-content !important;
  max-width:100%;
  margin-left:auto !important;
  margin-right:auto !important;
  text-align:center !important;
}

/* Estados y badges */
#allTable table.master-v19 .pill,
#allTable table.master-v19 .badge,
#allTable table.master-v19 .sede-badge,
#allTable table.master-v19 .status-badge{
  display:inline-flex !important;
  justify-content:center !important;
  align-items:center !important;
  text-align:center !important;
  margin-left:auto !important;
  margin-right:auto !important;
}

/* Checkboxes */
#allTable table.master-v19 tbody input[type="checkbox"]{
  display:block !important;
  margin-left:auto !important;
  margin-right:auto !important;
}

/* Links */
#allTable table.master-v19 tbody td a{
  display:inline-block;
  margin-left:auto !important;
  margin-right:auto !important;
}

/* Evita que un ancho interno desplace visualmente el texto */
#allTable table.master-v19 tbody td{
  padding-left:6px !important;
  padding-right:6px !important;
}

/* =========================================================
   V20 · AJUSTE DE ENCABEZADOS Y CENTRADO DEL REGISTRO MAESTRO
   ========================================================= */

#allTable .master-v19{
  table-layout:fixed;
}

#allTable .master-v19 thead th{
  text-align:center !important;
  vertical-align:middle !important;
  white-space:normal !important;
  word-break:break-word;
  overflow-wrap:anywhere;
  line-height:1.12 !important;
  padding:8px 6px !important;
}

#allTable .master-v19 thead tr.master-v19-groups th{
  min-height:42px;
  font-size:10px;
}

#allTable .master-v19 thead tr.master-v19-columns th{
  min-height:58px;
  font-size:10px;
  font-weight:800;
}

#allTable .master-v19 tbody td{
  text-align:center !important;
  vertical-align:middle !important;
  word-break:break-word;
  overflow-wrap:anywhere;
  padding:7px 6px !important;
}

#allTable .master-v19 tbody td > *,
#allTable .master-v19 thead th > *{
  margin-left:auto !important;
  margin-right:auto !important;
}

#allTable .master-v19 .master-actions-inline{
  display:flex;
  justify-content:center !important;
  align-items:center !important;
  flex-wrap:wrap;
  gap:6px;
}

#allTable .master-v19 .master-cycle-readonly{
  display:inline-flex !important;
  justify-content:center;
  align-items:center;
  text-align:center !important;
  margin:0 auto !important;
}

#allTable .master-v19 .v19-small,
#allTable .master-v19 .master-cycle-badge,
#allTable .master-v19 .master-cycle-readonly,
#allTable .master-v19 .pill,
#allTable .master-v19 .badge{
  text-align:center !important;
}

#allTable .master-v19 .v19-item{width:52px; min-width:52px; max-width:52px;}
#allTable .master-v19 .v19-exp{width:120px; min-width:120px; max-width:120px;}
#allTable .master-v19 .v19-priority{width:92px; min-width:92px; max-width:92px;}
#allTable .master-v19 .v19-asunto{width:240px; min-width:240px; max-width:240px;}
#allTable .master-v19 .v19-person{width:150px; min-width:150px; max-width:150px;}
#allTable .master-v19 .v19-area{width:145px; min-width:145px; max-width:145px;}
#allTable .master-v19 .v19-date{width:95px; min-width:95px; max-width:95px;}
#allTable .master-v19 .v19-observation{width:210px; min-width:210px; max-width:210px;}
#allTable .master-v19 .v19-actions{width:155px; min-width:155px; max-width:155px;}
#allTable .master-v19 .v19-time{width:72px; min-width:72px; max-width:72px;}

#allTable .master-v19 th:first-child,
#allTable .master-v19 td:first-child{
  width:34px !important;
  min-width:34px !important;
  max-width:34px !important;
}

#allTable .master-v19 input[type="checkbox"]{
  display:block;
  margin:0 auto !important;
}

/* Encabezados particularmente extensos */
#allTable .master-v19 thead th:nth-child(6),   /* nivel prioridad */
#allTable .master-v19 thead th:nth-child(7),   /* descripción */
#allTable .master-v19 thead th:nth-child(11),  /* asunto */
#allTable .master-v19 thead th:nth-child(14),  /* nombre profesional solicitante */
#allTable .master-v19 thead th:nth-child(17),  /* profesional responsable atención */
#allTable .master-v19 thead th:nth-child(38),  /* profesional devuelve */
#allTable .master-v19 thead th:nth-child(39),  /* profesional recibe */
#allTable .master-v19 thead th:nth-child(42){  /* observaciones */
  line-height:1.08 !important;
}

/* Columna acciones más limpia */
#allTable .master-v19 td:last-child{
  padding-top:10px !important;
  padding-bottom:10px !important;
}

/* =========================================================
   V19 · REGISTRO MAESTRO AJUSTADO AL ORDEN DEL EXCEL
   El orden principal replica:
   Inicio del requerimiento → Atención → Otra área/sede →
   Tiempo de atención → Reasignación → Días en custodia →
   Devolución → Estado / Ubicación / Observaciones.
   Campos propios del sistema quedan al final.
   ========================================================= */

#allTable .master-v19{
  min-width:6100px;
  table-layout:auto;
}

#allTable .master-v19 thead tr.master-v19-groups th{
  color:#fff !important;
  font-size:10px;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.2px;
  padding:9px 5px !important;
}

#allTable .master-v19 .g-init{background:#355d99 !important;}
#allTable .master-v19 .g-att{background:#355d99 !important;}
#allTable .master-v19 .g-other{background:#644aa7 !important;}
#allTable .master-v19 .g-time{background:#355d99 !important;}
#allTable .master-v19 .g-reas{background:#4e91d4 !important;}
#allTable .master-v19 .g-custody{background:#aeb4bb !important;color:#102033 !important;}
#allTable .master-v19 .g-return{background:#7396cf !important;}
#allTable .master-v19 .g-final{background:#6c89b3 !important;}
#allTable .master-v19 .g-system{background:#4e5e70 !important;}

#allTable .master-v19 thead tr.master-v19-columns th{
  min-width:90px;
  white-space:normal;
  line-height:1.1;
  padding:7px 5px !important;
}

#allTable .master-v19 td{
  line-height:1.2;
  white-space:normal;
}

#allTable .master-v19 .v19-item{min-width:48px}
#allTable .master-v19 .v19-exp{min-width:100px}
#allTable .master-v19 .v19-priority{min-width:80px}
#allTable .master-v19 .v19-asunto{min-width:260px;max-width:330px}
#allTable .master-v19 .v19-person{min-width:145px;max-width:205px}
#allTable .master-v19 .v19-area{min-width:145px;max-width:210px}
#allTable .master-v19 .v19-date{min-width:102px}
#allTable .master-v19 .v19-observation{min-width:210px;max-width:320px}
#allTable .master-v19 .v19-actions{min-width:150px}
#allTable .master-v19 .v19-block-end{border-right:2px solid #98abc0 !important;}

#allTable .master-v19 .v19-time{
  font-weight:800;
  color:#173f6b;
}

#allTable .master-v19 .v19-small{
  display:block;
  margin-top:2px;
  color:#687c91;
  font-size:9px;
}

#allTable .master-v19 .v19-reassign{
  font-weight:800;
  color:#173f6b;
}

/* =========================================================
   V18 · REGISTRO MAESTRO ORGANIZADO POR ETAPAS DEL PROCESO
   Inicio → Atención → Otra área/sede → Reasignación →
   Devolución → Situación actual.
   ========================================================= */

#allTable .master-v18{
  min-width:3900px;
  table-layout:auto;
}

#allTable .master-v18 thead tr.master-v18-groups th{
  font-size:10px;
  letter-spacing:.15px;
  text-transform:uppercase;
  color:#fff !important;
  padding:9px 6px !important;
  border-bottom:2px solid #6d87a4 !important;
}

#allTable .master-v18 .g-start{
  background:#315b98 !important;
}

#allTable .master-v18 .g-attention{
  background:#315b98 !important;
}

#allTable .master-v18 .g-location{
  background:#634aa5 !important;
}

#allTable .master-v18 .g-reassign{
  background:#4e91d4 !important;
}

#allTable .master-v18 .g-return{
  background:#7396cf !important;
}

#allTable .master-v18 .g-current{
  background:#5d6979 !important;
}

#allTable .master-v18 thead tr.master-v18-columns th{
  white-space:normal;
  min-width:84px;
  line-height:1.15;
  padding:7px 6px !important;
}

#allTable .master-v18 td{
  white-space:normal;
  line-height:1.25;
}

#allTable .master-v18 .col-item{min-width:48px}
#allTable .master-v18 .col-exp{min-width:95px}
#allTable .master-v18 .col-date{min-width:105px}
#allTable .master-v18 .col-asunto{min-width:250px;max-width:310px}
#allTable .master-v18 .col-person{min-width:145px;max-width:205px}
#allTable .master-v18 .col-location{min-width:180px;max-width:250px}
#allTable .master-v18 .col-reassign{min-width:220px;max-width:280px}
#allTable .master-v18 .col-observation{min-width:200px;max-width:300px}
#allTable .master-v18 .col-actions{min-width:155px}

#allTable .master-v18 .master-v18-priority{
  display:inline-flex;
  justify-content:center;
  align-items:center;
  min-width:54px;
  padding:3px 7px;
  border-radius:999px;
  background:#eef3f8;
  color:#40556d;
  font-size:10px;
  font-weight:800;
}

#allTable .master-v18 .master-v18-priority.high{
  background:#fff0d8;
  color:#995300;
}

#allTable .master-v18 .master-v18-priority.urgent{
  background:#ffe1e1;
  color:#a31d1d;
}

#allTable .master-v18 .master-v18-muted{
  color:#6b7c90;
  font-size:10px;
}

#allTable .master-v18 .master-v18-reassign-main{
  font-weight:800;
  color:#173f6b;
}

#allTable .master-v18 .master-v18-count{
  display:inline-flex;
  min-width:26px;
  justify-content:center;
  padding:3px 7px;
  border-radius:999px;
  background:#e8f1fb;
  color:#173f6b;
  font-weight:800;
}

#allTable .master-v18 .master-v18-sent-date{
  font-weight:800;
  color:#2f6c50;
}

#allTable .master-v18 .master-v18-request{
  display:block;
  margin-top:3px;
  font-size:9px;
  color:#63778c;
}

#allTable .master-v18 .master-v18-block-end{
  border-right:2px solid #9db0c5 !important;
}

/* La primera columna se mantiene compacta y claramente separada. */
#allTable .master-v18 th:first-child,
#allTable .master-v18 td:first-child{
  min-width:34px;
  max-width:34px;
}

/* =========================================================
   V17 · COLORES DE FILAS MÁS VISIBLES EN TODAS LAS TABLAS
   ========================================================= */

/* Zebra suave y uniforme */
table tbody tr:nth-child(odd) td{
  background:#ffffff !important;
}

table tbody tr:nth-child(even) td{
  background:#f2f6fb !important;
}

/* Hover: seguir visualmente toda la fila */
table tbody tr:hover td{
  background:#e7f0fb !important;
}

/* Fila seleccionada: contraste claro */
table tbody tr.selected-row td,
table tbody tr.is-selected td,
table tbody tr[aria-selected="true"] td{
  background:#d8e9fb !important;
}

/* Registro Maestro: un poco más marcado por la cantidad de columnas */
#allTable table tbody tr:nth-child(odd) td{
  background:#ffffff !important;
}

#allTable table tbody tr:nth-child(even) td{
  background:#edf3f9 !important;
}

#allTable table tbody tr:hover td{
  background:#e1ecf8 !important;
}

#allTable table tbody tr.selected-row td,
#allTable table tbody tr.is-selected td,
#allTable table tbody tr[aria-selected="true"] td{
  background:#cfe3f8 !important;
}

/* Ciclos cerrados / solo lectura: tono neutro suave */
#allTable table tbody tr:has(.master-cycle-badge.closed) td,
#allTable table tbody tr:has(.master-cycle-readonly) td{
  background:#f5f5f5 !important;
}

/* Ciclo activo: conservar una lectura limpia */
#allTable table tbody tr:has(.master-cycle-badge.active):hover td{
  background:#e1ecf8 !important;
}

/* Tablas dentro de modales e historial */
.modal table tbody tr:nth-child(even) td,
.modal-box table tbody tr:nth-child(even) td{
  background:#f3f7fb !important;
}

.modal table tbody tr:hover td,
.modal-box table tbody tr:hover td{
  background:#e8f1fb !important;
}

/* =========================================================
   V16 · LÍNEAS HORIZONTALES MÁS MARCADAS EN TODAS LAS TABLAS
   ========================================================= */

/* Separación horizontal general entre filas */
table tbody td{
  border-bottom:1.35px solid #c6d2e0 !important;
}

/* Última fila: cierre limpio de la tabla */
table tbody tr:last-child td{
  border-bottom:1.5px solid #aebfd1 !important;
}

/* Encabezado claramente separado del cuerpo */
table thead th{
  border-bottom:2px solid #7f9bb8 !important;
}

/* Filas alternas mantienen su fondo, pero con línea visible */
table tbody tr:nth-child(even) td{
  border-bottom-color:#bdcad8 !important;
}

/* Hover: línea un poco más marcada para seguir la fila */
table tbody tr:hover td{
  border-bottom-color:#9fb3c8 !important;
}

/* Fila seleccionada: separación más notoria */
table tbody tr.selected-row td,
table tbody tr.is-selected td,
table tbody tr[aria-selected="true"] td{
  border-top:1.5px solid #8ea8c4 !important;
  border-bottom:1.5px solid #8ea8c4 !important;
}

/* Registro Maestro: un poco más marcado para lectura extensa */
#allTable table tbody td{
  border-bottom:1.45px solid #bcc9d8 !important;
}

#allTable table thead th{
  border-bottom:2px solid #6f8dab !important;
}

/* Tablas en modales e historial */
.modal table tbody td,
.modal-box table tbody td{
  border-bottom:1.3px solid #c5d1de !important;
}

.modal table thead th,
.modal-box table thead th{
  border-bottom:2px solid #829db9 !important;
}

/* Historial del ciclo: reforzar separación de cada movimiento */
.history-table tbody td,
.timeline table tbody td,
#requestDetailModal table tbody td{
  border-bottom:1.4px solid #b9c8d8 !important;
}

/* =========================================================
   V15 · CENTRADO DE CICLO ACTIVO / CICLO CERRADO · SOLO LECTURA
   ========================================================= */
.master-cycle-badge{
  display:flex !important;
  width:max-content;
  max-width:100%;
  justify-content:center;
  align-items:center;
  margin:4px auto 0 !important;
  text-align:center !important;
}

.master-cycle-request-number{
  text-align:center !important;
}

.master-cycle-readonly{
  display:flex !important;
  width:max-content;
  max-width:100%;
  justify-content:center;
  align-items:center;
  margin-left:auto !important;
  margin-right:auto !important;
  text-align:center !important;
}

.master-cycle-badge.active{
  background:#e0f2fe;
  color:#075985;
}
.master-cycle-badge.closed{
  background:#e2e8f0;
  color:#475569;
}
.master-cycle-readonly{
  display:inline-flex;
  align-items:center;
  padding:4px 7px;
  border-radius:7px;
  background:#f1f5f9;
  color:#64748b;
  font-size:9px;
  font-weight:850;
  white-space:nowrap;
}
.master-cycle-request-number{
  display:block;
  margin-top:3px;
  color:var(--muted);
  font-size:9.5px;
  line-height:1.15;
}
.master-cycle-physical-note{
  display:block;
  margin-top:3px;
  color:#64748b;
  font-size:8.5px;
  line-height:1.2;
}

/* ============================================================
   DEVOLUCIÓN MÚLTIPLE · VÁLIDOS Y EXCLUIDOS
   ============================================================ */
.bulk-return-valid-title,
.bulk-return-excluded-title{
  margin:10px 0 6px;
  font-size:11px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.02em;
}
.bulk-return-valid-title{color:#166534}
.bulk-return-excluded-title{color:#9a3412}
.bulk-return-excluded-box{
  margin-top:12px;
  border:1px solid #fed7aa;
  background:#fff7ed;
  border-radius:9px;
  padding:9px;
}
.bulk-return-excluded-box table{
  min-width:680px;
  background:#fff;
}
.bulk-return-excluded-row{
  opacity:.78;
}
.bulk-return-excluded-badge{
  display:inline-flex;
  align-items:center;
  padding:3px 7px;
  border-radius:999px;
  background:#fee2e2;
  color:#991b1b;
  font-size:9px;
  font-weight:900;
  white-space:nowrap;
}
/* V314: mover Base y Conexión debajo de la fecha */
.main-sticky-header .topbar > .statusbar,
.main-sticky-header .topbar > .improvement-bar,
.main-sticky-header .topbar > #locationUnreadBanner{
  width:100%;
  flex:0 0 100%;
}
.main-sticky-header .topbar > .statusbar{
  margin-top:2px;
  margin-bottom:0;
}
.main-sticky-header .topbar > .improvement-bar{
  margin:8px 0 0;
}
.main-sticky-header .topbar > #locationUnreadBanner{
  margin:8px 0 0 !important;
}

/* =========================================================
   V321 · ALTA DE EXPEDIENTES SOLO ARCHIVO / ADMINISTRADOR
   ========================================================= */
.record-entry-v321{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin:0 0 12px;
  padding:10px 12px;
  border:1px solid #c9d8e6;
  border-radius:9px;
  background:#f4f9fd;
}
.record-entry-v321 strong{display:block;color:var(--navy);font-size:12px}
.record-entry-v321 small{display:block;margin-top:3px;color:var(--muted);font-size:10px;line-height:1.35}
.record-entry-actions-v321{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
.record-entry-v321.active-conas{
  background:#f5f0ff;
  border-color:#cfc1ef;
  box-shadow:inset 4px 0 0 #6d4bb5;
}
@media(max-width:760px){
  .record-entry-v321{align-items:stretch;flex-direction:column}
  .record-entry-actions-v321{justify-content:flex-start}
}

/* source:base */
:focus-visible{outline:3px solid #2563eb;outline-offset:3px}
.improvement-bar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:9px 12px;border:1px solid var(--line);border-radius:8px;background:#fff;margin:8px 0;font-size:12px}
.connection-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#15803d;margin-right:6px}
.improvement-bar[data-offline="true"]{background:#fff7ed;color:#9a3412}
.improvement-bar[data-offline="true"] .connection-dot{background:#c2410c}
.version-notice{position:fixed;bottom:18px;left:18px;max-width:440px;z-index:70;background:#fff;border:1px solid #93c5fd;box-shadow:var(--shadow);border-radius:12px;padding:16px;font-size:13px}
.version-notice p{line-height:1.5;margin:8px 0 12px}
.csv-review-summary{display:flex;gap:12px;flex-wrap:wrap;padding:12px 0;font-weight:700}
.csv-review-table{max-height:48vh;overflow:auto;border:1px solid var(--line);border-radius:8px}
.csv-review-table td{overflow-wrap:anywhere;max-width:360px}
.csv-error{color:#991b1b}.csv-ok{color:#166534}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation:none!important;transition:none!important}}

/* source:base */
#allTable table.master-record-table td:nth-child(4),#allTable table.master-record-table td:nth-child(19){
  white-space:normal;
}
#allTable table.master-record-table th:nth-child(2),#allTable table.master-record-table td:nth-child(2),#allTable table.master-record-table th:nth-child(3),#allTable table.master-record-table td:nth-child(3),#allTable table.master-record-table th:nth-child(4),#allTable table.master-record-table td:nth-child(4),#allTable table.master-record-table th:nth-child(12),#allTable table.master-record-table td:nth-child(12),#allTable table.master-record-table th:nth-child(15),#allTable table.master-record-table td:nth-child(15),#allTable table.master-record-table th:nth-child(17),#allTable table.master-record-table td:nth-child(17),#allTable table.master-record-table th:nth-child(18),#allTable table.master-record-table td:nth-child(18),#allTable table.master-record-table th:nth-child(19),#allTable table.master-record-table td:nth-child(19),#allTable table.master-record-table th:nth-child(20),#allTable table.master-record-table td:nth-child(20),#allTable table.master-record-table th:nth-child(21),#allTable table.master-record-table td:nth-child(21){  /* Cargo */
  white-space:nowrap!important;
}
#allTable table.master-record-table th:nth-child(5),#allTable table.master-record-table td:nth-child(5){   /* Responsable / ubicación */
  min-width:130px;
  max-width:165px;
}
#allTable table.master-record-table th:nth-child(6),#allTable table.master-record-table td:nth-child(6){   /* Estado */
  min-width:92px;
  max-width:120px;
}
#allTable table.master-record-table th:nth-child(8),#allTable table.master-record-table td:nth-child(8){   /* Listado */
  min-width:95px;
  max-width:120px;
}
#allTable table.master-record-table th:nth-child(9),#allTable table.master-record-table td:nth-child(9){   /* Sede */
  min-width:95px;
  max-width:125px;
}
#allTable table.master-record-table th:nth-child(10),#allTable table.master-record-table td:nth-child(10){   /* Fecha envío a San Luis */
  min-width:100px;
  max-width:115px;
}
#allTable table.master-record-table th:nth-child(11),#allTable table.master-record-table td:nth-child(11){  /* Solicitante */
  min-width:105px;
  max-width:140px;
}
#allTable table.master-record-table th:nth-child(13),#allTable table.master-record-table td:nth-child(13){  /* Fecha entrega expediente */
  min-width:105px;
  max-width:120px;
}
#allTable table.master-record-table th:nth-child(16),#allTable table.master-record-table td:nth-child(16){  /* Devuelto por */
  min-width:100px;
  max-width:135px;
}
#allTable table.master-record-table th:nth-child(23),#allTable table.master-record-table td:nth-child(23){  /* Observación */
  min-width:110px;
