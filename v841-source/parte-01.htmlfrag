body.produce-staff .app.role-user #userPersonalKpis{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:10px!important;margin:0 0 12px!important;padding:0!important;position:static!important}
body.produce-staff .app.role-user #userPersonalKpis .kpi,body.produce-staff .app.role-user #userPersonalKpis #userKpiAllCard{display:block!important;position:relative!important;min-height:100px!important;height:auto!important;grid-column:auto!important;width:auto!important;max-width:none!important;margin:0!important;padding:14px 12px 10px 94px!important;border:1px solid #bcd9fc!important;border-radius:13px!important;background:#deeeff!important;box-shadow:none!important;overflow:visible!important}
body.produce-staff .app.role-user #userPersonalKpis .kpi .label{font-size:12px!important;line-height:1.25!important;text-transform:uppercase!important;font-weight:800!important;color:#061650!important;margin:0 0 3px!important}
body.produce-staff .app.role-user #userPersonalKpis .kpi .value,body.produce-staff .app.role-user #userKpiAllCard .value{font-size:34px!important;line-height:1!important;font-weight:800!important;letter-spacing:-1px!important;color:#061541!important;margin:0!important}
body.produce-staff .app.role-user #userPersonalKpis .kpi .kpi-view{font-size:13px!important;line-height:1.25!important;font-weight:500!important;color:#0054ff!important;margin:4px 0 0!important;padding:0!important;border:0!important;background:transparent!important;display:block!important}
.produce-kpi-icon{position:absolute;left:17px;top:13px;width:55px;height:55px;border-radius:50%;display:grid;place-items:center;background:#c3e0ff;color:#0757fb}.produce-kpi-icon .p-icon{width:33px;height:33px;stroke-width:2.4}
body.produce-staff .app.role-user #userPersonalKpis #userKpiPendingAttentionCard{background:#fff8d9!important;border-color:#ffe7a8!important}#userKpiPendingAttentionCard .produce-kpi-icon{background:#ffbb00;color:white}
