}

.v229-exp{
  min-width:105px;
  color:#052f5f!important;
}

.v229-wide{
  min-width:190px;
  max-width:260px;
  white-space:normal;
}

.v229-state-stack{
  display:flex;
  flex-direction:column;
  gap:4px;
