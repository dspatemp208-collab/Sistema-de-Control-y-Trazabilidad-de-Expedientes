body.produce-user #ownerDetailFilters input,body.produce-user #ownerDetailFilters select{height:37px!important;min-height:37px!important;border:1px solid #c8dcf2!important;border-radius:7px!important;padding:7px 12px!important;font-size:14px!important;color:#142958!important;background:#fff!important}
body.produce-user .app.role-user #userPersonalKpis{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:10px!important;margin:0 0 12px!important;padding:0!important;position:static!important}
body.produce-user .app.role-user #userPersonalKpis .kpi,body.produce-user .app.role-user #userPersonalKpis #userKpiAllCard{display:block!important;position:relative!important;min-height:100px!important;height:auto!important;grid-column:auto!important;width:auto!important;max-width:none!important;margin:0!important;padding:14px 12px 10px 94px!important;border:1px solid #bcd9fc!important;border-radius:13px!important;background:#deeeff!important;box-shadow:none!important;overflow:visible!important}
body.produce-user .app.role-user #userPersonalKpis .kpi .label{font-size:12px!important;line-height:1.25!important;text-transform:uppercase!important;font-weight:800!important;color:#061650!important;margin:0 0 3px!important}
body.produce-user .app.role-user #userPersonalKpis .kpi .value,body.produce-user .app.role-user #userKpiAllCard .value{font-size:34px!important;line-height:1!important;font-weight:800!important;letter-spacing:-1px!important;color:#061541!important;margin:0!important}
body.produce-user .app.role-user #userPersonalKpis .kpi .kpi-view{font-size:13px!important;line-height:1.25!important;font-weight:500!important;color:#0054ff!important;margin:4px 0 0!important;padding:0!important;border:0!important;background:transparent!important;display:block!important}
.produce-kpi-icon{position:absolute;left:17px;top:13px;width:55px;height:55px;border-radius:50%;display:grid;place-items:center;background:#c3e0ff;color:#0757fb}.produce-kpi-icon .p-icon{width:33px;height:33px;stroke-width:2.4}
body.produce-user .app.role-user #userPersonalKpis #userKpiPendingAttentionCard{background:#fff8d9!important;border-color:#ffe7a8!important}#userKpiPendingAttentionCard .produce-kpi-icon{background:#ffbb00;color:white}
body.produce-user .app.role-user #userPersonalKpis #userKpiReturnRequestedCard{background:#fff0df!important;border-color:#ffe0b9!important}#userKpiReturnRequestedCard .produce-kpi-icon{background:#ffe4bd;color:#f08b00}
body.produce-user .app.role-user #userPersonalKpis #userKpiReassignedByCard,body.produce-user .app.role-user #userPersonalKpis #userKpiReassignedToCard{background:#eae5ff!important;border-color:#dad3fd!important}#userKpiReassignedByCard .produce-kpi-icon,#userKpiReassignedToCard .produce-kpi-icon{background:#ddd3ff;color:#6214c9}
body.produce-user .app.role-user #userPersonalKpis #userKpiReturnedCard{background:#dbfaec!important;border-color:#b9efda!important}#userKpiReturnedCard .produce-kpi-icon{background:#0ac66c;color:white}
body.produce-user .app.role-user #userPersonalKpis #userKpiAlertCard{background:#ffe6e7!important;border-color:#ffcece!important}#userKpiAlertCard .produce-kpi-icon{background:#ffd2d9;color:#e6002e}
body.produce-user #panelDetailWrap{border:1px solid #ccdef3!important;border-radius:10px!important;overflow:hidden!important;box-shadow:none!important;background:#fff!important;margin:0!important}
body.produce-user #panelDetailWrap .table-head{background:#fafdff!important;padding:10px 16px!important;min-height:48px!important;border-bottom:1px solid #dce8f5!important;position:static!important}
body.produce-user #panelTitle{font-size:18px!important;color:#08266c!important}
body.produce-user #panelTable{overflow-x:auto!important;overflow-y:visible!important;max-height:none!important}
body.produce-user #panelTable table{border-collapse:collapse!important;width:100%!important;font-size:12px!important}
body.produce-user #panelTable table thead th{background:#eaf3fd!important;color:#365b8e!important;font-size:11px!important;text-transform:uppercase!important;padding:9px 10px!important;border:1px solid #dce8f5!important;line-height:1.3!important}
body.produce-user #panelTable table tbody td{padding:7px 10px!important;border:1px solid #e0eaf7!important;color:#102b61!important;font-size:12px!important;line-height:1.3!important;background:#fff!important}
