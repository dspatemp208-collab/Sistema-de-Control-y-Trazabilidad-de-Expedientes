/* source:v230-buscador-por-perfil */
.v230-inline-search,
.v230-admin-search-line{
  display:grid;
  grid-template-columns:minmax(0,1fr) auto auto;
  gap:8px;
  align-items:center;
}

.v230-inline-search input,
.v230-admin-search-line input{
  width:100%;
}

.v230-search-btn{
  white-space:nowrap;
}

.v230-admin-search{
  margin-bottom:12px!important;
  padding:12px 14px!important;
  border:1px solid #bcd7ee!important;
  background:#f7fbff!important;
}

.v230-admin-search-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:12px;
  margin-bottom:10px;
}

.v230-admin-search-head strong{
  display:block;
  color:#073866;
  font-size:13px;
  text-transform:uppercase;
}

.v230-scope-pill{
  display:inline-flex;
  align-items:center;
  padding:5px 9px;
  border-radius:999px;
  background:#e3effb;
  color:#13568f;
  font-size:9px;
  font-weight:900;
  white-space:nowrap;
}

.v230-admin-results{
  margin-bottom:14px!important;
}

.v230-admin-table-wrap{
  width:100%;
  height:auto;
  max-height:min(60vh,720px);
  overflow:auto;
  border:1px solid #cbddec;
  border-radius:8px;
}

.v230-admin-table{
  width:max-content;
  min-width:100%;
  border-collapse:collapse;
}

.v230-admin-table th{
  position:static;
  top:0;
  z-index:5;
  background:#e9f3fc;
  color:#173f67;
  padding:8px 9px;
  border-right:1px solid #d5e2ed;
  border-bottom:1px solid #c7d9e7;
  font-size:9px;
  text-transform:uppercase;
  white-space:nowrap;
}

.v230-admin-table td{
  padding:8px 9px;
  border-right:1px solid #e0e9f1;
  border-bottom:1px solid #dce7f0;
  vertical-align:middle;
  font-size:10px;
}

.v230-admin-table tbody tr:hover td{
  background:#f6fbff;
}

.v230-exp{
  min-width:105px;
  color:#062f5f;
}

.v230-wide{
  min-width:190px;
  max-width:260px;
  white-space:normal;
}

.v230-date{
  min-width:140px;
  white-space:nowrap;
  font-weight:800;
}

.v230-move{
  display:flex;
  flex-direction:column;
  gap:3px;
  min-width:150px;
  white-space:normal;
}

.v230-move small{
  color:#6c8297;
}

.v230-admin-empty{
  padding:40px 20px!important;
}

body.produce-user #searchInputLabelV229,
body.produce-coordinator-self #searchInputLabelV229{
  color:#0a3764!important;
  font-weight:900!important;
}

@media(max-width:900px){
  .v230-inline-search,
  .v230-admin-search-line{
    grid-template-columns:1fr;
  }

  .v230-admin-search-head{
    flex-direction:column;
  }
}

