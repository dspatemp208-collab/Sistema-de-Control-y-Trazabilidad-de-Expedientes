<script>
  // Mantiene reservado exactamente el espacio que ocupa la cabecera fija,
  // aun cuando los botones se distribuyen en varias filas.
  (function(){
    const syncFixedHeaderHeight=()=>{
      const header=document.querySelector('.main-sticky-header');
      if(!header)return;

      // En ventana angosta la cabecera es sticky y ocupa espacio normal
      // dentro del documento; no hay que reservar altura adicional.
      if(window.matchMedia('(max-width:1280px)').matches){
        document.documentElement.style.setProperty('--main-fixed-header-h','0px');
        return;
      }

      const h=Math.ceil(header.getBoundingClientRect().height);
      document.documentElement.style.setProperty('--main-fixed-header-h',h+'px');
    };
    window.addEventListener('load',syncFixedHeaderHeight);
    window.addEventListener('resize',syncFixedHeaderHeight);
    document.addEventListener('DOMContentLoaded',()=>{
      syncFixedHeaderHeight();
      const header=document.querySelector('.main-sticky-header');
      if(header && 'ResizeObserver' in window){
        new ResizeObserver(syncFixedHeaderHeight).observe(header);
      }
    });
  })();
  </script>
