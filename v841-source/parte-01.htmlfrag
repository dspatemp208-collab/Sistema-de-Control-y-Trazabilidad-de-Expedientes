/* source:v243-reasignaciones-coordinador */
body.produce-coordinator #kpiReassignReceivedCard .hint::after{
  content:" · incluye solicitudes recibidas como custodio";
}
body.produce-coordinator #kpiReassignSentCard .hint::after{
  content:" · incluye solicitudes enviadas desde mi custodia";
}

/* source:v244-fast-card-switching */
#panelDetailWrap{
  position:relative;
}

#panelDetailWrap.v244-panel-switching::before{
  content:"";
  position:absolute;
  z-index:30;
  top:0;
  left:0;
  width:32%;
  height:3px;
  border-radius:999px;
  background:linear-gradient(90deg,#0d62a8,#55a4e5,#0d62a8);
  animation:v244-fast-progress .75s ease-in-out infinite alternate;
  pointer-events:none;
}

#panelDetailWrap.v244-panel-switching #panelTable{
  opacity:.78;
  transition:opacity .12s ease;
}

@keyframes v244-fast-progress{
  from{left:0;width:24%}
  to{left:68%;width:32%}
}

/* La vista en caché conserva el DOM normal para evitar artefactos de pintado. */

/* source:v246-search-archive-list */
.v246-list-box{
  display:flex;
  flex-direction:column;
  gap:3px;
  align-items:flex-start;
}
.v246-list-number{
  display:inline-flex;
  padding:3px 7px;
  border-radius:999px;
  border:1px solid #b9d6ee;
  background:#eef7ff;
  color:#0c568c;
  font-weight:900;
  white-space:nowrap;
}
.v246-list-state{
  max-width:190px;
  font-size:9px;
  line-height:1.25;
  color:#60758b;
  font-weight:800;
  white-space:normal;
}
.v246-list-state b{
  color:#36536f;
}
.v246-archive-location{
  display:flex;
  flex-direction:column;
  gap:3px;
  align-items:flex-start;
}
.v246-location-badge{
  display:inline-flex;
  padding:4px 8px;
  border-radius:999px;
  font-weight:900;
  white-space:nowrap;
}
.v246-location-badge.san-luis{
  background:#e8f3ff;
  border:1px solid #acd1ef;
  color:#0b5d91;
}
.v246-location-badge.barrenechea{
  background:#ecfdf5;
  border:1px solid #a7f3d0;
  color:#065f46;
}
.v246-location-note{
  max-width:180px;
  font-size:9px;
  line-height:1.25;
  color:#6b7e90;
}
.v246-location-note.pending{
  color:#9a6700;
  font-weight:800;
}
.v246-location-note.sent{
  color:#0b5d91;
  font-weight:800;
}

/* source:v311-list-destination-location */
.list-destination{
  display:block;
  margin-top:3px;
  font-size:9px;
  line-height:1.2;
  font-weight:800;
  color:#526b83;
  white-space:normal;
}
.list-destination b{color:#36536f}

/* source:v247-persistent-returned-filters */
.returned-list-toolbar::after{
  content:"Los filtros se conservan aunque el sistema actualice la información.";
  grid-column:1 / -1;
  color:#60758b;
  font-size:9px;
  font-weight:700;
  padding-top:2px;
}

/* source:v257-version-label */
body.v170-task-layer #backgroundReviewText::after{content:" · V420 TARJETAS · CANTIDADES COHERENTES"!important;font-weight:700;color:#28557f}

/* source:v265-request-extension-required */
#requestLookupExtension:required,#newReqExtension:required{border-color:#c58b19!important;background:#fffdf5!important;font-weight:700}
.request-extension-help b{color:#8a5b00}

/* source:v277-dashboard-style */
/* =========================================================
   V277 · DASHBOARD Y REPORTES POR PERFIL
   ========================================================= */
.dashboard-v277-shell{display:flex;flex-direction:column;gap:10px;min-width:0}
.dashboard-v277-head{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;padding:13px 14px;background:#fff}
.dashboard-v277-title-block{min-width:220px;flex:1 1 auto}
.dashboard-v277-title{font-size:18px;font-weight:900;color:var(--navy)}
.dashboard-v277-scope{margin-top:4px;font-size:11px;line-height:1.35;color:var(--muted)}
.dashboard-v277-controls{display:flex;align-items:flex-end;justify-content:flex-end;gap:8px;flex-wrap:wrap;flex:1 1 680px}
.dashboard-v277-controls .field{min-width:150px}
.dashboard-v277-area-field{flex:0 1 210px}
.dashboard-v277-search-field{flex:1 1 220px;max-width:300px}
.dashboard-v277-controls .btn{min-height:39px;white-space:nowrap}
.dashboard-v277-livebar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:5px 8px;font-size:10px;color:var(--muted)}
.dashboard-v277-live{display:inline-flex;align-items:center;gap:5px;padding:3px 8px;border:1px solid #b9ddca;border-radius:999px;background:#eef9f2;color:#26734a;font-weight:850}
.dashboard-v277-live.refreshing{border-color:#ead6a7;background:#fff9e9;color:#8a6200}
.dashboard-v277-live.offline{border-color:#efcaca;background:#fff4f4;color:#9b2c2c}
.dashboard-v277-kpis{display:grid;grid-template-columns:repeat(9,minmax(110px,1fr));gap:8px}
.dashboard-v277-kpi{padding:11px 12px;min-height:78px;background:#f8fbfe}
.dashboard-v277-kpi span{display:block;font-size:9.5px;line-height:1.2;text-transform:uppercase;font-weight:850;color:var(--muted)}
.dashboard-v277-kpi b{display:block;margin-top:6px;font-size:25px;line-height:1;color:var(--navy)}
.dashboard-v277-alert{background:#fff7f1}.dashboard-v277-alert b{color:#a04e13}
.dashboard-v277-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
.dashboard-v277-panel{padding:12px;min-height:290px;background:#fff}
.dashboard-v277-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid var(--line)}
.dashboard-v277-panel-head strong{display:block;color:var(--navy);font-size:12px}
.dashboard-v277-panel-head small{display:block;margin-top:3px;color:var(--muted);font-size:9.5px;line-height:1.3}
.dashboard-v277-bars{display:flex;flex-direction:column;gap:7px;max-height:255px;overflow:auto;padding-right:3px}
.dashboard-v277-bar-row{display:grid;grid-template-columns:minmax(95px,1fr) minmax(90px,2fr) 38px;gap:8px;align-items:center;font-size:10px}
.dashboard-v277-bar-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#3e536a;font-weight:750}
.dashboard-v277-bar-track{height:9px;border-radius:999px;background:#e8eef5;overflow:hidden}
.dashboard-v277-bar-fill{height:100%;min-width:0;border-radius:999px;background:#315f8d;transition:width .2s ease}
.dashboard-v277-bars.alert-bars .dashboard-v277-bar-fill{background:#b45b2a}
.dashboard-v277-bar-value{text-align:right;font-weight:900;color:var(--navy)}
.dashboard-v277-table-card{min-height:240px;overflow:hidden;background:#fff}
.dashboard-v277-table-head{align-items:flex-start}
.dashboard-v277-count{margin-top:3px;font-size:10px;color:var(--muted);font-weight:700}
.dashboard-v277-table-wrap{max-height:calc(100vh - var(--main-fixed-header-h) - 455px);min-height:190px;overflow:auto}
.dashboard-v277-table-wrap table{min-width:1020px;font-size:10.5px}
.dashboard-v277-table-wrap th{position:static!important;top:0!important;z-index:25!important;background:var(--navy)!important;color:#fff!important}
.dashboard-v277-table-wrap td,.dashboard-v277-table-wrap th{padding:7px 6px!important}
.dashboard-v277-person{font-weight:850;color:var(--navy)}
.dashboard-v277-role{display:inline-flex;padding:2px 6px;border-radius:999px;background:#eef3f8;color:#475d75;font-size:8.5px;font-weight:850}
.dashboard-v277-zero{color:#94a3b8}.dashboard-v277-danger{color:#a61b1b;font-weight:900}
.dashboard-v277-loading{opacity:.6;pointer-events:none}

/* V285 · Dashboard de gestión: solo Administrador, Archivo y Coordinador. */
.app.limited-user:not(.role-coordinator) .tabs .tab[data-tab="dashboard"],
.app.limited-user:not(.role-coordinator) .main-sticky-header .tabs .tab[data-tab="dashboard"]{display:none!important}
.app.limited-user:not(.role-coordinator) .main-sticky-header .tabs,
.app.limited-user:not(.role-coordinator) .tabs{grid-template-columns:repeat(2,minmax(0,1fr))!important}
.dashboard-v285-days-panel .dashboard-v277-bar-fill{background:#4b7d63}
.dashboard-v285-age-panel .dashboard-v277-bar-fill{background:#7a5aa6}
.dashboard-v285-days-note{font-size:9.5px;color:var(--muted);line-height:1.3;margin-top:4px}

@media(max-width:1350px){.dashboard-v277-kpis{grid-template-columns:repeat(4,minmax(120px,1fr))}.dashboard-v277-grid{grid-template-columns:1fr 1fr}.dashboard-v277-status-panel{grid-column:1/-1}}
@media(max-width:900px){.dashboard-v277-head{align-items:stretch;flex-direction:column}.dashboard-v277-controls{justify-content:flex-start;flex-basis:auto}.dashboard-v277-grid{grid-template-columns:1fr}.dashboard-v277-status-panel{grid-column:auto}.dashboard-v277-table-wrap{max-height:48vh}.dashboard-v277-kpis{grid-template-columns:repeat(2,minmax(115px,1fr))}}
@media(max-width:600px){.dashboard-v277-kpis{grid-template-columns:1fr 1fr}.dashboard-v277-controls .field{min-width:100%;max-width:none}.dashboard-v277-controls .btn{flex:1 1 auto}.app.limited-user .main-sticky-header .tabs,.app.limited-user .tabs{grid-template-columns:1fr!important}.dashboard-v277-bar-row{grid-template-columns:minmax(85px,1fr) minmax(70px,1.4fr) 34px}}

/* source:v290-coordinador-operativo-propio */
/* V290 · COORDINADOR: operación sobre expedientes propios.
   SELF = puede reasignar/devolver su propia custodia.
   TEAM = solo seguimiento del personal a cargo. */
body.produce-coordinator-self .user-manage-action{
  display:inline-flex!important;
}
body.produce-coordinator-self #requestDetailModal input,
body.produce-coordinator-self #requestDetailModal select,
body.produce-coordinator-self #requestDetailModal textarea{
  pointer-events:auto!important;
}
body.produce-coordinator-team .user-manage-action{
  display:none!important;
}
body.produce-coordinator-team #bulkReassignBtn,
body.produce-coordinator-team #bulkReturnBtn{
  display:none!important;
}
.v290-coordinator-own-note{
  border-left:4px solid #2f7d5a;
  background:#eef9f3;
  color:#235b43;
}

/* source:v318-cabecera-superior-compacta */
/* =========================================================
   V318 · CABECERA SUPERIOR COMPACTA · USUARIO + COORDINADOR
   Reduce altura sin cambiar la lógica ni el orden definido en V314.
   ========================================================= */

/* Solo la experiencia de Mis expedientes de Usuario/Coordinador. */
.app.role-user .main-sticky-header{
  padding-top:8px !important;
  padding-bottom:5px !important;
}

.app.role-user .main-sticky-header .topbar{
  gap:5px 8px !important;
  margin-bottom:5px !important;
  padding:6px 8px !important;
}

.app.role-user .main-sticky-header .title{
  min-height:44px !important;
  padding-top:0 !important;
  padding-bottom:0 !important;
}

.app.role-user .main-sticky-header .title h1{
  font-size:22px !important;
  line-height:1.08 !important;
  margin:0 !important;
}

.app.role-user .main-sticky-header .title p{
  font-size:10.5px !important;
  line-height:1.15 !important;
  margin:2px 0 0 !important;
}

/* Fecha y hora más compactas, conservando su posición superior derecha. */
.app.role-user .produce-clock{
  gap:8px !important;
  padding:7px 10px !important;
  min-height:34px !important;
  font-size:10.5px !important;
  border-radius:7px !important;
}
.app.role-user .produce-clock strong{
  padding-left:9px !important;
}
.app.role-user .produce-clock .p-icon{
  width:16px !important;
  height:16px !important;
}

/* Base / usuario / perfil. */
.app.role-user .main-sticky-header .topbar > .statusbar{
  min-height:27px !important;
  padding:4px 9px !important;
  margin:2px 0 0 !important;
  font-size:10px !important;
  line-height:1.2 !important;
  border-radius:6px !important;
}

/* Conexión y última revisión. */
.app.role-user .main-sticky-header .topbar > .improvement-bar{
  min-height:27px !important;
  padding:4px 9px !important;
  margin:3px 0 0 !important;
  gap:9px !important;
  font-size:10px !important;
  line-height:1.2 !important;
  border-radius:6px !important;
}
.app.role-user .main-sticky-header .topbar > .improvement-bar .connection-dot{
  width:7px !important;
  height:7px !important;
  margin-right:5px !important;
}

/* Aviso eventual de ubicación: compacto cuando aparezca. */
.app.role-user .main-sticky-header .topbar > #locationUnreadBanner:not(.hidden){
  min-height:28px !important;
  padding:5px 8px !important;
  margin:3px 0 0 !important;
  font-size:10px !important;
}

/* Acciones principales: menos altura y menos separación. */
.app.role-user .main-sticky-header .topbar > .actions{
  gap:6px !important;
  margin-top:2px !important;
}
.app.role-user .main-sticky-header .topbar > .actions .btn,
.app.role-user .main-sticky-header .topbar > .actions .sel-count{
  min-height:34px !important;
  padding:6px 11px !important;
  font-size:11px !important;
  border-radius:7px !important;
}

/* La barra de pestañas, cuando esté visible, también ocupa menos altura. */
.app.role-user .main-sticky-header > .tabs{
  padding:3px !important;
  gap:4px !important;
}
.app.role-user .main-sticky-header > .tabs .tab{
  padding:6px 9px !important;
  font-size:10.5px !important;
}

/* En pantallas medianas no volver a reservar 48 px debajo del título:
   la fecha conserva una franja compacta. */
@media(max-width:1450px){
  body.produce-user .app.role-user .title,
  body.produce-staff .app.role-user .title{
    padding-bottom:38px !important;
  }
  body.produce-user .app.role-user .produce-clock,
  body.produce-staff .app.role-user .produce-clock{
    padding:6px 9px !important;
    min-height:32px !important;
  }
}

@media(max-width:700px){
  .app.role-user .main-sticky-header .title h1{
    font-size:19px !important;
  }
  .app.role-user .main-sticky-header .title p,
  .app.role-user .main-sticky-header .topbar > .statusbar,
  .app.role-user .main-sticky-header .topbar > .improvement-bar{
    font-size:9.5px !important;
  }
}

/* source:v319-staff-personal-options */
/* V320 · Accesos personales de ARCHIVO y ADMINISTRADOR */
.produce-nav .staff-personal-nav-v319{
  border-left:3px solid #7aa6ce;
  background:transparent;
  color:#091954;
}
.produce-nav .staff-personal-nav-v319.active{
  border-left-color:#fff;
  background:linear-gradient(135deg,#075cae,#03498c)!important;
  color:#fff!important;
  font-weight:700;
  border-color:#4583bd;
}

/* source:base */
/* =========================================================
   V323 · EXPEDIENTES POR USUARIO
   Los usuarios con expedientes pendientes por atender
   permanecen visibles aunque no tengan custodia actual y
   se muestran primero en ADMINISTRADOR / ARCHIVO.
   ========================================================= */
.owner-user-card.has-pending-attention{
  border-left:4px solid #d97706!important;
  background:#fffdf7!important;
}
.owner-user-card.has-pending-attention .owner-user-name{
  color:#173f6b;
}
.owner-pending-user-badge{
  display:inline-flex;
  align-items:center;
  margin-left:6px;
  padding:2px 6px;
  border-radius:999px;
  background:#fff0c9;
  color:#8a4b00;
  border:1px solid #f0cf8b;
  font-size:8.5px;
  font-weight:900;
  vertical-align:middle;
  white-space:nowrap;
}

/* source:base */
/* V330 · selector desplegable de extensión en búsqueda */
#requestSearchModal #requestLookupExtension{
  width:100%;
  min-height:38px;
  border:1px solid var(--line);
  border-radius:7px;
  padding:8px 34px 8px 10px;
  background:#fff;
  color:var(--text);
  font:inherit;
  cursor:pointer;
}
#requestSearchModal #requestLookupExtension:focus{
  outline:none;
  border-color:#6e9bc3;
  box-shadow:0 0 0 3px rgba(37,87,132,.10);
}

/* source:v345-nav-click-fix-style */
/* V345 · Los accesos del menú lateral siempre reciben clic.
   El resaltado activo lo administra la lógica nativa del sistema (.active). */
body.produce-staff .produce-nav > button{pointer-events:auto!important}
body.produce-staff .produce-nav > button.active{
  background:linear-gradient(135deg,#075cae,#03498c)!important;
  color:#fff!important;
  font-weight:700!important;
  border-color:#4583bd!important;
}

/* source:v346-personal-menu-style */
/* =========================================================
   V346 · ESPACIO PERSONAL ARCHIVO / ADMINISTRADOR
   Cuando se ingresa a Mis expedientes o Mis solicitudes,
   el menú lateral muestra únicamente Inicio + esas dos
   opciones personales. Las acciones de expedientes se
   mantienen disponibles debajo.
   ========================================================= */
body.v346-staff-personal-menu .produce-nav > button{
  display:none!important;
}
body.v346-staff-personal-menu .produce-nav > button[data-destination="panel"][data-nav-index="0"],
body.v346-staff-personal-menu .produce-nav > #staffMyExpedientesV319,
body.v346-staff-personal-menu .produce-nav > #staffMySolicitudesV319{
  display:flex!important;
}
body.v346-staff-personal-menu .produce-nav > #staffMyExpedientesV319{
  margin-top:8px!important;
}
body.v346-staff-personal-menu .produce-nav > #staffMySolicitudesV319{
  margin-bottom:10px!important;
}

/* source:v364-alert-center-style */
/* ============================================================
   V364 · CENTRO DE ALERTAS SIMPLIFICADO
   ============================================================ */
#alertsModal .alerts-modal-box{
  width:min(960px,94vw)!important;
  max-width:960px!important;
  max-height:88vh!important;
  overflow:auto!important;
  padding:16px!important;
}
#alertsModal .alerts-modal-head{
  margin-bottom:10px!important;
  padding-bottom:10px!important;
}
#alertsModal .alerts-modal-subtitle{
  color:#60758e!important;
}

/* Ocultar completamente la interfaz antigua. */
#alertsModal .alerts-total-card,
#alertsModal #v170TaskCenter,
#alertsModal .alerts-group,
#alertsModal .location-alerts-section{
  display:none!important;
}

/* Vista V364 */
#alertsModal .v364-alert-center{
  display:block!important;
}
#alertsModal .v364-summary{
  display:grid!important;
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
  gap:8px!important;
  margin-bottom:10px!important;
}
#alertsModal .v364-summary-card{
  appearance:none!important;
  border:1px solid #cbdbea!important;
  border-radius:10px!important;
  background:#f8fbff!important;
  min-height:58px!important;
  padding:8px 10px!important;
  display:grid!important;
  grid-template-columns:auto minmax(0,1fr) auto!important;
  align-items:center!important;
  gap:8px!important;
  cursor:pointer!important;
  color:#17365d!important;
  text-align:left!important;
}
#alertsModal .v364-summary-card:hover{
  border-color:#7faad4!important;
  background:#f1f7fd!important;
}
#alertsModal .v364-summary-card.is-new{
  border-left:4px solid #1670b8!important;
  background:#f2f8ff!important;
}
#alertsModal .v364-summary-card.is-action{
  border-left:4px solid #d18a00!important;
  background:#fffaf0!important;
}
#alertsModal .v364-summary-card.is-notice{
  border-left:4px solid #6955c9!important;
  background:#f8f6ff!important;
}
#alertsModal .v364-summary-icon{
  font-size:18px!important;
}
#alertsModal .v364-summary-text{
  font-size:10px!important;
  font-weight:900!important;
  letter-spacing:.025em!important;
}
#alertsModal .v364-summary-card strong{
  font-size:22px!important;
  line-height:1!important;
  color:#123e6b!important;
}

#alertsModal .v364-toolbar{
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
  gap:8px!important;
  flex-wrap:wrap!important;
  padding:7px 8px!important;
  margin-bottom:7px!important;
  border:1px solid #d8e4ef!important;
  border-radius:9px!important;
  background:#f8fbff!important;
}
#alertsModal .v364-tabs{
  display:flex!important;
  gap:5px!important;
  flex-wrap:wrap!important;
}
#alertsModal [data-v364-filter].active{
  background:#1f5b8f!important;
  border-color:#1f5b8f!important;
  color:#fff!important;
}
#alertsModal .v364-status{
  min-height:18px!important;
  margin:0 2px 7px!important;
  font-size:10.5px!important;
  color:#667b92!important;
}

#alertsModal .v364-section{
  margin-bottom:9px!important;
  border:1px solid #d3dfeb!important;
  border-radius:10px!important;
  background:#fff!important;
  overflow:hidden!important;
}
#alertsModal .v364-section.hidden{
  display:none!important;
}
#alertsModal .v364-section-head{
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
  gap:10px!important;
  padding:8px 10px!important;
  background:#f2f6fb!important;
  border-bottom:1px solid #dbe5ef!important;
}
#alertsModal .v364-section.is-new .v364-section-head{
  background:#edf6ff!important;
}
#alertsModal .v364-section.is-notice .v364-section-head{
  background:#f7f5ff!important;
}
#alertsModal .v364-section-head strong{
  display:block!important;
  color:#17365d!important;
  font-size:12.5px!important;
}
#alertsModal .v364-section-head small{
  display:block!important;
  margin-top:1px!important;
  color:#647a91!important;
  font-size:9.5px!important;
}
#alertsModal .v364-count{
  min-width:27px!important;
  height:27px!important;
  padding:0 7px!important;
  border-radius:999px!important;
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  background:#17365d!important;
  color:#fff!important;
  font-size:11px!important;
  font-weight:900!important;
}
#alertsModal .v364-head-actions{
  display:flex!important;
  align-items:center!important;
  gap:6px!important;
}
#alertsModal .v364-head-actions .hidden{
  display:none!important;
}
#alertsModal .v364-list{
  display:flex!important;
  flex-direction:column!important;
  max-height:260px!important;
  overflow:auto!important;
}
#alertsModal .v364-row{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto!important;
  align-items:center!important;
  gap:10px!important;
  padding:9px 10px!important;
  border-bottom:1px solid #e6edf4!important;
  background:#fff!important;
}
#alertsModal .v364-row:last-child{
  border-bottom:0!important;
}
#alertsModal .v364-row.is-new{
  border-left:4px solid #1670b8!important;
  background:#f8fbff!important;
}
#alertsModal .v364-row.is-unread{
  border-left:4px solid #d99a00!important;
  background:#fffbf1!important;
}
#alertsModal .v364-row-main{
  min-width:0!important;
}
#alertsModal .v364-row-title{
  display:flex!important;
  align-items:center!important;
  gap:6px!important;
  flex-wrap:wrap!important;
  color:#17365d!important;
  font-size:12px!important;
  font-weight:900!important;
}
#alertsModal .v364-badge{
  padding:2px 6px!important;
  border-radius:999px!important;
  background:#e6f0fa!important;
  color:#245b8c!important;
  font-size:8.5px!important;
  font-weight:900!important;
  white-space:nowrap!important;
}
#alertsModal .v364-badge.new{
  background:#dceeff!important;
  color:#075c9e!important;
}
#alertsModal .v364-row-meta{
  margin-top:3px!important;
  color:#587089!important;
  font-size:10px!important;
  line-height:1.3!important;
}
#alertsModal .v364-row-message{
  margin-top:3px!important;
  color:#2f465f!important;
  font-size:10.5px!important;
  line-height:1.3!important;
}
#alertsModal .v364-row-actions{
  display:flex!important;
  align-items:center!important;
  gap:5px!important;
  flex-wrap:wrap!important;
  justify-content:flex-end!important;
  max-width:230px!important;
}
#alertsModal .v364-row-actions .btn{
  min-height:30px!important;
  padding:5px 9px!important;
  font-size:10px!important;
}
#alertsModal .v364-empty{
  padding:24px 12px!important;
  border:1px dashed #ccd9e6!important;
  border-radius:10px!important;
  text-align:center!important;
  color:#667b92!important;
  background:#f8fbff!important;
}
#alertsModal .v364-empty.hidden{
  display:none!important;
}
@media(max-width:720px){
  #alertsModal .v364-summary{
    grid-template-columns:1fr!important;
  }
  #alertsModal .v364-row{
    grid-template-columns:1fr!important;
  }
  #alertsModal .v364-row-actions{
    justify-content:flex-start!important;
    max-width:none!important;
  }
}

/* source:v382-global-results-compact-style */
#adminGlobalResultsV230.v230-admin-results{
  min-height:0!important;
  height:auto!important;
  max-height:none!important;
  overflow:visible!important;
}
#adminGlobalResultsTableV230{
  min-height:0!important;
  height:auto!important;
  max-height:none!important;
}
#adminGlobalResultsTableV230 > .v230-admin-table-wrap{
  min-height:0!important;
  height:auto!important;
  max-height:min(60vh,720px)!important;
  overflow-x:auto!important;
  overflow-y:auto!important;
  scrollbar-gutter:auto!important;
}
#adminGlobalResultsTableV230 .v230-admin-table{
  margin-bottom:0!important;
}

/* source:v384-sidebar-edge-quarantine */
/* ============================================================
   V384 · CUARENTENA VISUAL DEL BORDE DEL MENÚ
   El área principal tiene 24 px de padding. Esta máscara ocupa solamente
   ese margen vacío y evita que cualquier artefacto nativo del navegador
   llegue a verse junto al borde derecho de la navegación.
   ============================================================ */
body.produce-staff::after{
  content:"";
  position:fixed;
  top:72px;
  bottom:0;
  left:239px;
  width:24px;
  z-index:44;
  display:block;
  background:#eff7ff;
  pointer-events:none;
}

/* El cajón adicional de usuarios necesita ocupar esa zona cuando se abre. */
body.produce-staff.produce-directory-open::after{
  display:none;
}

@media(max-width:1050px) and (min-width:701px){
  body.produce-staff::after{
    left:200px;
    width:24px;
  }
}

/* En móvil la navegación deja de ser lateral. */
@media(max-width:700px){
  body.produce-staff::after{
    display:none;
  }
}


/* source:v392-owner-card-click-reliability */
/* ============================================================
   V392 · TARJETAS DE USUARIO SIEMPRE INTERACTIVAS
   ============================================================ */
#ownerCardsPanel,
#ownerCardsGrid{
  position:relative!important;
  isolation:isolate!important;
}

#ownerCardsGrid .owner-user-card{
  position:relative!important;
  z-index:1!important;
  pointer-events:auto!important;
  cursor:pointer!important;
}

#ownerCardsGrid .owner-user-card:hover{
  z-index:2!important;
}

/* Etiquetas COORDINADOR / PERSONAL A CARGO / GESTIÓN son decorativas. */
#ownerCardsGrid .owner-user-card::before,
#ownerCardsGrid .owner-user-card::after{
  pointer-events:none!important;
}

/* Todos los botones de cada tarjeta pueden recibir clic. */
#ownerCardsGrid .owner-user-card button,
#ownerCardsGrid .owner-user-actions,
#ownerCardsGrid .owner-user-options,
#ownerCardsGrid .owner-user-actions button,
#ownerCardsGrid .owner-user-options button{
  pointer-events:auto!important;
  position:relative!important;
  z-index:3!important;
}

#ownerCardsGrid .owner-user-card.v392-opening{
  opacity:.72!important;
  cursor:progress!important;
}

#ownerCardsGrid .owner-user-card.v392-opening button{
  pointer-events:none!important;
}

/* Ningún heading de equipo puede extender una capa invisible sobre tarjetas. */
#ownerCardsGrid .v307-team-heading{
  position:relative!important;
  z-index:0!important;
  pointer-events:none!important;
}

/* source:v393-user-search-stability */
/* ============================================================
   V393 · BUSCADOR DEL PERFIL USUARIO
   - foco/caret estable
   - input y botones siempre clicables
   - sin capas transparentes encima
   ============================================================ */
body.produce-user #searchInput,
body.produce-user .v349-toolbar-search,
body.produce-user .v349-toolbar-search .v230-inline-search,
body.produce-user .v349-toolbar-search .v230-search-btn,
body.produce-user .v349-toolbar-search .v230-clear-btn{
  position:relative!important;
  z-index:80!important;
  pointer-events:auto!important;
}

body.produce-user #searchInput{
  cursor:text!important;
  user-select:text!important;
  -webkit-user-select:text!important;
  touch-action:manipulation!important;
  opacity:1!important;
  visibility:visible!important;
}

body.produce-user #searchInput:focus{
  outline:none!important;
  border-color:#176bb4!important;
  box-shadow:0 0 0 3px rgba(23,107,180,.15)!important;
}

/* El contenedor no puede tener un pseudo-elemento encima del campo. */
body.produce-user .v349-toolbar-search::before,
body.produce-user .v349-toolbar-search::after,
body.produce-user .v230-inline-search::before,
body.produce-user .v230-inline-search::after{
  pointer-events:none!important;
}

/* Estado de búsqueda. */
.v393-user-search-status{
  display:none;
  margin-top:3px;
  font-size:9px;
  line-height:1.2;
  color:#5b6f84;
}
body.produce-user .v349-toolbar-search .v393-user-search-status{
  display:block;
  grid-column:1 / -1;
}
.v393-user-search-status.searching{
  color:#8a5c00;
  font-weight:750;
}
.v393-user-search-status.error{
  color:#b42318;
  font-weight:750;
}
.v393-user-search-status.ready{
  color:#17613a;
  font-weight:750;
}

/* source:v394-live-user-search-style */
/* ============================================================
   V394 · BÚSQUEDA EN VIVO DEL PERFIL USUARIO
   ============================================================ */

/* El buscador queda en un bloque estable: no se mueve mientras se escribe. */
body.produce-user.v394-search-locked .v349-toolbar-search{
  position:relative!important;
  z-index:90!important;
  pointer-events:auto!important;
}

body.produce-user.v394-search-locked #searchInput{
  position:relative!important;
  z-index:92!important;
  pointer-events:auto!important;
  cursor:text!important;
  user-select:text!important;
  -webkit-user-select:text!important;
  touch-action:manipulation!important;
  caret-color:auto!important;
}

body.produce-user.v394-search-locked #searchInput:focus{
  outline:none!important;
  border-color:#176bb4!important;
  box-shadow:0 0 0 3px rgba(23,107,180,.16)!important;
}

/* Ninguna capa decorativa del toolbar puede capturar el clic. */
body.produce-user.v394-search-locked .v349-toolbar-search::before,
body.produce-user.v394-search-locked .v349-toolbar-search::after,
body.produce-user.v394-search-locked .v230-inline-search::before,
body.produce-user.v394-search-locked .v230-inline-search::after{
  pointer-events:none!important;
}

/* Mensaje debajo de Buscar/Limpiar. */
.v394-live-search-status{
  grid-column:1 / -1;
  min-height:13px;
  margin-top:1px;
  font-size:9px;
  line-height:1.15;
  color:#64748b;
}

.v394-live-search-status.detecting{
  color:#175a8f;
}

.v394-live-search-status.searching{
  color:#8a5c00;
  font-weight:800;
}

.v394-live-search-status.ready{
  color:#17613a;
  font-weight:800;
}

.v394-live-search-status.error{
  color:#b42318;
  font-weight:800;
}

/* source:v395-fast-search-style */
.v395-fast-hit{
  display:inline-flex;
  align-items:center;
  gap:5px;
  margin-left:6px;
  padding:2px 7px;
  border-radius:999px;
  background:#eaf8ef;
  color:#17613a;
  font-size:9px;
  font-weight:800;
}

.v395-fast-loading{
  display:inline-flex;
  align-items:center;
  gap:5px;
  margin-left:6px;
  padding:2px 7px;
  border-radius:999px;
  background:#fff4d8;
  color:#8a5c00;
  font-size:9px;
  font-weight:800;
}

/* source:v396-coordinator-new-request-style */
/* ============================================================
   V396 · NUEVA SOLICITUD EN PERFIL COORDINADOR
   ============================================================ */

body.produce-coordinator #coordinatorNewRequestBtnV396{
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  gap:7px!important;
  min-width:175px!important;
  min-height:40px!important;
  padding:8px 15px!important;
  background:#176bff!important;
  border-color:#1261ed!important;
  color:#fff!important;
  font-weight:800!important;
  white-space:nowrap!important;
  pointer-events:auto!important;
  position:relative!important;
  z-index:95!important;
}

/* En el espacio personal del coordinador: Nueva solicitud + buscador. */
body.produce-coordinator-self.v349-personal-compact-panel
.main-sticky-header .actions{
  display:grid!important;
  grid-template-columns:max-content minmax(360px,1fr)!important;
  gap:8px!important;
  align-items:end!important;
  width:100%!important;
}

body.produce-coordinator-self.v349-personal-compact-panel
.main-sticky-header .actions > #coordinatorNewRequestBtnV396{
  grid-column:1!important;
  grid-row:1!important;
  order:0!important;
}

body.produce-coordinator-self.v349-personal-compact-panel
.main-sticky-header .actions > .v349-toolbar-search{
  grid-column:2!important;
  grid-row:1!important;
  order:1!important;
  width:100%!important;
  min-width:0!important;
}

/* El botón reutilizado del perfil USUARIO no se duplica en COORDINADOR. */
body.produce-coordinator #searchRequestBtn{
  display:none!important;
}

/* Menú lateral */
body.produce-coordinator #produceSideNewRequest{
  display:flex!important;
  align-items:center!important;
  gap:10px!important;
  width:100%!important;
  pointer-events:auto!important;
}

@media(max-width:900px){
  body.produce-coordinator-self.v349-personal-compact-panel
  .main-sticky-header .actions{
    display:flex!important;
    flex-wrap:wrap!important;
  }

  body.produce-coordinator-self.v349-personal-compact-panel
  .main-sticky-header .actions > .v349-toolbar-search{
    flex:1 1 100%!important;
  }
}

/* source:v403-classic-access-request-layout */
/* ============================================================
   V403
   - Acceso clásico de V396: SIN pantalla "Preparando el sistema".
   - Nueva solicitud del COORDINADOR dentro de Mis solicitudes.
   ============================================================ */

/* El botón superior V396 ya no se usa en Mis expedientes. */
body.produce-coordinator #coordinatorNewRequestBtnV396{
  display:none!important;
}

/* El acceso lateral independiente también se oculta. */
body.produce-coordinator #produceSideNewRequest{
  display:none!important;
}

/* Mis expedientes: el buscador ocupa todo el ancho. */
body.produce-coordinator-self.v349-personal-compact-panel
.main-sticky-header .actions{
  display:block!important;
  width:100%!important;
}

body.produce-coordinator-self.v349-personal-compact-panel
.main-sticky-header .actions > .v349-toolbar-search{
  display:block!important;
  width:100%!important;
  max-width:none!important;
  min-width:0!important;
  margin:0!important;
}

body.produce-coordinator-self.v349-personal-compact-panel
.main-sticky-header .actions > .v349-toolbar-search .v230-inline-search{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto auto!important;
  gap:7px!important;
  width:100%!important;
  align-items:center!important;
}

body.produce-coordinator-self.v349-personal-compact-panel
.main-sticky-header .actions > .v349-toolbar-search #searchInput{
  width:100%!important;
  min-width:0!important;
}

/* Nueva solicitud dentro de MIS SOLICITUDES del coordinador. */
body.produce-coordinator-self #tab-requests:not(.hidden) #requestNewRequestBtn{
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  min-height:34px!important;
  padding:6px 13px!important;
  background:#176bff!important;
  border-color:#1261ed!important;
  color:#fff!important;
  font-weight:800!important;
  white-space:nowrap!important;
  pointer-events:auto!important;
}

/* En Solicitudes del equipo no mostrar la solicitud personal. */
body.produce-coordinator-team #requestNewRequestBtn{
  display:none!important;
}

/* source:v404-team-tracking-style */
body.produce-coordinator-team #ownerCardsPanel::before{
  content:"SEGUIMIENTO DEL EQUIPO · Consulta de custodia, préstamos, reasignaciones, pendientes, devoluciones e historial";
  display:block;
  margin:0 0 8px;
  padding:7px 10px;
  border:1px solid #bdd5e8;
  border-radius:8px;
  background:#eef7fd;
  color:#234f73;
  font-size:10px;
  font-weight:800;
  letter-spacing:.01em;
}

body.produce-coordinator-team #ownerCardsGrid .owner-user-card{
  cursor:pointer!important;
}

body.produce-coordinator-team #ownerCardsGrid .owner-user-card button{
  pointer-events:auto!important;
}

/* source:v406-team-state-consistency-style */
body.produce-coordinator-team #ownerDetailFilters::after{
  content:"El Coordinador puede consultar el detalle de los expedientes de los integrantes asignados a su equipo; la autorización se valida en Supabase.";
  display:block;
  grid-column:1 / -1;
  margin-top:4px;
  color:#597189;
  font-size:9px;
  line-height:1.25;
}

/* source:v408-coordinator-team-access-style */
body.produce-coordinator-team #ownerCardsPanel::before{
  content:"SEGUIMIENTO DEL EQUIPO · El Coordinador puede revisar los expedientes de los integrantes asignados a su grupo";
}

body.produce-coordinator-team #ownerDetailFilters::after{
  content:"Los contadores y el detalle del Coordinador se obtienen del mismo control que usa Administración/Archivo para el integrante seleccionado.";
}

/* source:v431-hide-lawyer-module-admin-safe */
/* V431 · Ocultar Solicitudes por abogado únicamente en ADMINISTRADOR.
   Corrección visual segura: no altera el JavaScript principal. */
body.produce-staff .app.role-admin #tabBtnRequestsByLawyer,
body.produce-staff .app.role-admin .tabs .tab[data-tab="requestsByLawyer"],
body.produce-staff .produce-nav button[data-destination="requestsByLawyer"]{
  display:none!important;
}
body.produce-staff .app.role-admin #tab-requestsByLawyer{
  display:none!important;
}

/* =========================================================
   V453 · LAYOUT CANÓNICO ÚNICO
   Reemplaza reglas históricas de sticky/fixed/scroll que competían.
   La página se desplaza normalmente; las tablas solo conservan scroll horizontal.
   ========================================================= */
html,body{min-height:100%;overflow-x:hidden;overflow-y:auto}
.main{min-width:0;padding-top:18px!important}
.main-sticky-header{
  position:relative!important;inset:auto!important;left:auto!important;right:auto!important;top:auto!important;
  width:auto!important;max-width:100%!important;margin:0 0 12px!important;
  padding:0!important;background:transparent!important;box-shadow:none!important;border:0!important;z-index:auto!important
}
#tab-panel:not(.hidden),#tab-states:not(.hidden),#tab-requests:not(.hidden),#tab-all:not(.hidden),
#tab-cargos:not(.hidden),#tab-history:not(.hidden),#tab-conas:not(.hidden),#tab-dvc:not(.hidden),#tab-instruction:not(.hidden){
  display:block!important;position:relative!important;height:auto!important;min-height:0!important;max-height:none!important;
  overflow:visible!important;contain:none!important;content-visibility:visible!important
}
.table-wrap,#panelDetailWrap,#panelTable,#stateDetailBox,#stateDetailTable,#allTable,#requestsTable,
#returnRequestsTable,.returned-table-scroll,.state-loan-table-scroll,.conas-table-scroll,#conasTable{
  position:relative!important;height:auto!important;min-height:0!important;max-height:none!important;
  overflow-x:auto!important;overflow-y:visible!important;contain:none!important;content-visibility:visible!important;
  transform:none!important;will-change:auto!important
}
#tab-panel table,#tab-states table,#tab-all table,#tab-requests table,#tab-cargos table,#tab-history table,
#tab-conas table,#tab-dvc table,#tab-instruction table{
  position:relative!important;contain:none!important;content-visibility:visible!important;transform:none!important;will-change:auto!important
}
#tab-panel tbody,#tab-states tbody,#tab-all tbody,#tab-requests tbody,#tab-cargos tbody,#tab-history tbody,
#tab-conas tbody,#tab-dvc tbody,#tab-instruction tbody,
#tab-panel tr,#tab-states tr,#tab-all tr,#tab-requests tr,#tab-cargos tr,#tab-history tr,
#tab-conas tr,#tab-dvc tr,#tab-instruction tr,
#tab-panel td,#tab-states td,#tab-all td,#tab-requests td,#tab-cargos td,#tab-history td,
#tab-conas td,#tab-dvc td,#tab-instruction td{
  position:static!important;contain:none!important;content-visibility:visible!important;transform:none!important;will-change:auto!important
}
#tab-panel th,#tab-states th,#tab-all th,#tab-requests th,#tab-cargos th,#tab-history th,
#tab-conas th,#tab-dvc th,#tab-instruction th{
  position:static!important;top:auto!important;left:auto!important;right:auto!important;z-index:auto!important;transform:none!important
}
.exp-asunto-col,.hidden{display:none!important}
@media(max-width:1280px){
  .main{padding:12px!important}
  .sidebar{position:relative!important;height:auto!important;max-height:none!important}
  .app{display:grid!important;grid-template-columns:220px minmax(0,1fr)!important}
}
@media(max-width:760px){
  .app{display:block!important}
  .sidebar{width:100%!important}
}



/* =========================================================
   V455 · ASUNTO COMO TEXTO NATIVO DE CELDA
   El asunto ya no usa SPAN, -webkit-box, line-clamp, overflow de bloque
   ni ninguna caja hija independiente. El texto pertenece directamente al TD.
   ========================================================= */
.subject-cell-v455{
  width:260px!important;
  min-width:200px!important;
  max-width:340px!important;
  position:static!important;
  white-space:normal!important;
  overflow-wrap:anywhere!important;
  word-break:normal!important;
  line-height:1.25!important;
  font-size:10.5px!important;
  font-weight:700!important;
  color:#23415f!important;
  vertical-align:middle!important;
  text-align:center!important;
  transform:none!important;
  will-change:auto!important;
  contain:none!important;
  content-visibility:visible!important;
}
@media(max-width:1100px){
  .subject-cell-v455{width:220px!important;min-width:180px!important;max-width:280px!important}
}

/* V638 · Asuntos largos compactos y legibles */
.subject-cell-v455{
  padding:8px 10px!important;
}
.subject-cell-v455 .subject-text-v638{
  display:-webkit-box!important;
  -webkit-box-orient:vertical!important;
  -webkit-line-clamp:3!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
  white-space:normal!important;
  overflow-wrap:anywhere!important;
  word-break:break-word!important;
  line-height:1.22!important;
  font-size:11px!important;
  font-weight:700!important;
  color:#173b63!important;
  text-align:left!important;
  max-width:100%!important;
  margin:0!important;
}
.subject-cell-v455:hover .subject-text-v638{
  color:#0f2d4a!important;
}

</style>

<style id="v462-archive-attendant-clarity">
/* V462 · La atención de solicitudes pertenece exclusivamente al perfil ARCHIVO. */
#rqPrepareAtiende,#rqDAtiende,#fAtiende,#bAtiende,#cAtiende{
  border-color:#6f9fc8;
}
</style>


<style id="v507-fast-ui-style">
/* V507 · respuesta visual inmediata al cambiar de tarjeta */
.v507-fast-switch{position:relative}
.v507-fast-switch::after{
  content:"Actualizando…";
  position:absolute;right:12px;top:10px;z-index:3;
  padding:4px 8px;border:1px solid #d7e0ea;border-radius:999px;
  background:rgba(255,255,255,.94);color:#64748b;font-size:10px;font-weight:700;
  pointer-events:none
}
#panelDetailWrap.v507-fast-switch #panelTable,
#stateDetailBox.v507-fast-switch #stateDetailTable{opacity:.92}
</style>

<style id="v511-stable-request-colors-style">
/* =========================================================
   V511 · COLORES ESTABLES EN BANDEJA DE SOLICITUDES
   ========================================================= */
#requestsTable tbody tr,
#requestsTable tbody tr td{
  transition:none!important;
}
#requestsTable tbody tr.v500-digital-total-row>td,
#requestsTable tbody tr.v500-digital-total-row:nth-child(even)>td,
#requestsTable tbody tr.v500-digital-total-row:nth-child(odd)>td{
  background:#eef8f0!important;
  color:#1f5131!important;
}
#requestsTable tbody tr.v500-digital-total-row:hover>td{
  background:#e4f3e8!important;
}
#requestsTable tbody tr:not(.v500-digital-total-row):nth-child(odd)>td{
  background:#fff!important;
}
#requestsTable tbody tr:not(.v500-digital-total-row):nth-child(even)>td{
  background:#f1f7ff!important;
}
#requestsTable tbody tr:not(.v500-digital-total-row):hover>td{
  background:#eaf2fb!important;
}
</style>


<!-- V521: COPIA DIGITAL ATENDIDA = FILA GRIS COMO DEVUELTO AL ARCHIVO + CICLO CERRADO -->
<style id="v521-digital-delivered-master-row">
/* V521 · La atención digital cerrada usa exactamente el color de DEVUELTO AL ARCHIVO. */
#allTable table.master-v19 tbody tr.master-row-returned-archive > td{
  background:#e3e3e3!important;
}
#allTable table.master-v19 tbody tr.master-row-returned-archive:hover > td{
  background:#d8d8d8!important;
}
</style>


<style id="v526-state-card-redesign">
/* V526 · NUEVO MODELO DE TARJETAS - ESTADOS */
#tab-states .state-grid,
body.produce-staff #tab-states .state-grid{
  display:grid!important;
  grid-template-columns:repeat(5,minmax(155px,1fr))!important;
  gap:10px!important;
  margin:8px 0 10px!important;
}
#tab-states .state-card,
body.produce-staff #tab-states .state-card{
  position:relative!important;
  display:grid!important;
  grid-template-columns:38px minmax(0,1fr) auto!important;
  grid-template-areas:"icon title count"!important;
  align-items:center!important;
  column-gap:10px!important;
  min-height:72px!important;
  padding:10px 13px 10px 10px!important;
  margin:0!important;
  background:#f3f7fb!important;
  border:1px solid #cedbe8!important;
  border-left:4px solid #3f78b2!important;
  border-radius:12px!important;
  box-shadow:0 2px 7px rgba(15,39,71,.05)!important;
  color:#17385e!important;
  overflow:hidden!important;
  transform:none!important;
  transition:border-color .12s ease,box-shadow .12s ease,background .12s ease!important;
}
#tab-states .state-card::before,
body.produce-staff #tab-states .state-card::before{
  grid-area:icon!important;
  content:"◷";
  width:34px!important;
  height:34px!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  border-radius:50%!important;
  background:#e5eef8!important;
  color:#245b91!important;
  font-size:18px!important;
  font-weight:900!important;
  line-height:1!important;
}
#tab-states .state-card .state-name,
body.produce-staff #tab-states .state-card .state-name{
  grid-area:title!important;
  min-width:0!important;
  min-height:0!important;
  margin:0!important;
  padding:0!important;
  font-size:10.5px!important;
  line-height:1.25!important;
  font-weight:850!important;
  letter-spacing:.015em!important;
  text-transform:uppercase!important;
  color:#17385e!important;
  overflow-wrap:anywhere!important;
}
#tab-states .state-card .state-count,
body.produce-staff #tab-states .state-card .state-count{
  grid-area:count!important;
  margin:0!important;
  padding:0 0 0 6px!important;
  font-size:24px!important;
  line-height:1!important;
  font-weight:900!important;
  color:#0f3764!important;
  text-align:right!important;
  white-space:nowrap!important;
}
#tab-states .state-card .state-meta,
#tab-states .state-card .state-progress,
#tab-states .state-card .state-card-actions,
body.produce-staff #tab-states .state-card .state-meta,
body.produce-staff #tab-states .state-card .state-progress,
body.produce-staff #tab-states .state-card .state-card-actions{display:none!important}
#tab-states .state-card:hover,
body.produce-staff #tab-states .state-card:hover{
  transform:none!important;
  border-color:#9dbbd8!important;
  box-shadow:0 5px 13px rgba(15,39,71,.09)!important;
  background:#f7fafe!important;
}
#tab-states .state-card.selected,
body.produce-staff #tab-states .state-card.selected{
  outline:none!important;
  border-color:#2563a6!important;
  border-left-width:5px!important;
  background:#edf5fd!important;
  box-shadow:0 0 0 2px rgba(37,99,166,.12),0 5px 13px rgba(15,39,71,.08)!important;
}
#tab-states .state-card:nth-child(1),body.produce-staff #tab-states .state-card:nth-child(1){border-left-color:#e0a000!important}
#tab-states .state-card:nth-child(1)::before,body.produce-staff #tab-states .state-card:nth-child(1)::before{content:"◷";background:#fff3cd!important;color:#9b6a00!important}
#tab-states .state-card:nth-child(2),body.produce-staff #tab-states .state-card:nth-child(2){border-left-color:#2c8a68!important}
#tab-states .state-card:nth-child(2)::before,body.produce-staff #tab-states .state-card:nth-child(2)::before{content:"▣";background:#dff4ec!important;color:#226c53!important}
#tab-states .state-card:nth-child(3),body.produce-staff #tab-states .state-card:nth-child(3){border-left-color:#7452b5!important}
#tab-states .state-card:nth-child(3)::before,body.produce-staff #tab-states .state-card:nth-child(3)::before{content:"⇄";background:#eee8fb!important;color:#64449e!important}
#tab-states .state-card:nth-child(4),body.produce-staff #tab-states .state-card:nth-child(4){border-left-color:#d78428!important}
#tab-states .state-card:nth-child(4)::before,body.produce-staff #tab-states .state-card:nth-child(4)::before{content:"↩";background:#fff0df!important;color:#a15b10!important}
#tab-states .state-card:nth-child(5),body.produce-staff #tab-states .state-card:nth-child(5){border-left-color:#27835d!important}
#tab-states .state-card:nth-child(5)::before,body.produce-staff #tab-states .state-card:nth-child(5)::before{content:"✓";background:#dff4e9!important;color:#1f704d!important}
@media(max-width:1500px){#tab-states .state-grid,body.produce-staff #tab-states .state-grid{grid-template-columns:repeat(3,minmax(170px,1fr))!important}}
@media(max-width:980px){#tab-states .state-grid,body.produce-staff #tab-states .state-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
@media(max-width:620px){
  #tab-states .state-grid,body.produce-staff #tab-states .state-grid{grid-template-columns:1fr!important}
  #tab-states .state-card,body.produce-staff #tab-states .state-card{min-height:64px!important}
}
</style>


