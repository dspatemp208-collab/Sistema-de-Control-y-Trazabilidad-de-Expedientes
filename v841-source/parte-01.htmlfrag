<style id="v632-hide-help-texts">
/* V632 · Limpieza global de microtextos de ayuda.
   Se conservan estados, alertas, errores, fechas, conteos y trazabilidad. */
.title p,
.modal-head p,
.brand small,
.config-help,
.cargo-preview-note,
.permission-note,
.user-card-caption,
.owner-user-caption,
.request-extension-help,
.request-quick-intro,
.request-items-head-note,
.workflow-intro,
.note-mini,
.alerts-group-hint,
.alerts-total-help,
.alerts-type-description,
.dashboard-v277-scope,
.dashboard-v285-days-note,
.dashboard-v277-panel-head small,
.internal-reassign-note,
.coordinator-pilot-note,
.v202-admin-only,
.v208-coordinator-readonly-note,
.v215-empty-hint,
.v218-source-note,
.v229-search-hint,
.v234-fast-note,
.v235-delete-audit-note,
.v280-area-help,
.v290-coordinator-own-note,
.v196-card-caption,
.v197-card-caption,
.v549-foot-note,
.v588-digital-mail-note,
.v595-conas-mail-note,
.v185-latest-search-heading small,
.v187-fast-search-note,
.accum-search-note,
.master-multi-head small,
.record-entry-v321 small,
#alertsModal .v364-section-head small,
#ownerTeamFilterStatusV538,
.owner-cards-head .note,
.field > .note,
.filters > .note,
.note.inventory-example-note,
.summary-card small {
  display:none!important;
}

/* Notas auxiliares generadas en flujos concretos. */
#tab-requests .workflow-intro,
#tab-requests .request-workflow-kpis .note-mini,
#tab-states > .filters .note,
#tab-conas > .note,
#tab-dvc > .note,
#tab-instruction > .note {
  display:none!important;
}

/* Reducir espacios que quedaban reservados únicamente para ayudas ocultas. */
.field:has(> .note) { gap:0!important; }
.workflow-intro + * { margin-top:0!important; }
</style>

<style id="v633-hide-all-helper-microtexts">
/* V633 · Regla global:
   - Ocultar ayudas, instrucciones y explicaciones pequeñas en TODOS los flujos.
   - Conservar estados/resultados dinámicos necesarios para operar. */

/* La clase .note se usa mayormente para microayudas. */
.note { display:none!important; }

/* Rehabilitar únicamente salidas operativas dinámicas. */
.note[id*="Status"],
.note[id*="status"],
#locationUnreadBanner,
#returnBulkStatus,
#rqSaveStatus,
#rqActionStatus,
#accumStatus,
#adminCloseStatus,
#adminDeleteStatusV235,
#usersStatus,
#coordinatorTeamStatusV211,
#requestLookupStatus,
#archiveListBulkStatus,
#archiveListStatus,
#panelBulkReturnStatus,
#masterBulkReturnStatus,
#v595ConasMailStatus,
#bulkConasStatus,
#conasReturnStatus,
#bulkDvcStatus,
#dvcReturnStatus,
#bulkInstructionStatus,
#instructionReturnStatus,
#instructionRequestReturnStatus,
#v560MailAdminStatus,
#v566ConfirmStatus,
#v572AttentionMailStatus,
#v626ReitStatus,
.v588-digital-mail-status,
.v595-conas-mail-status {
  display:block!important;
}

/* Bloques explicativos que no usan .note. */
[id$="Help"],
[id$="Hint"],
[id*="HelpText"],
[class*="-help"],
[class*="-hint"],
.request-cycle-rule,
.request-extension-help,
.request-quick-intro,
.request-items-head-note,
.workflow-intro,
.note-mini,
.config-help,
.permission-note,
.cargo-preview-note,
.user-card-caption,
.owner-user-caption,
.alerts-group-hint,
.alerts-total-help,
.alerts-type-description,
.dashboard-v277-scope,
.dashboard-v285-days-note,
.internal-reassign-note,
.coordinator-pilot-note,
.v202-admin-only,
.v208-coordinator-readonly-note,
.v215-empty-hint,
.v218-source-note,
.v229-search-hint,
.v234-fast-note,
.v235-delete-audit-note,
.v280-area-help,
.v290-coordinator-own-note,
.v196-card-caption,
.v197-card-caption,
.v549-foot-note,
.v588-digital-mail-note,
.v595-conas-mail-note,
.v584-routing-note,
.v596-mail-note,
.v565-note,
.cross-area-wait-note,
.historical-current-note,
.v183-other-holder-note,
.v246-location-note,
.list-location-note,
.accum-search-note,
.v517-digital-nonblocking-note,
.request-primary-note,
.sede-note,
.v629-readonly-note,
#ownerTeamFilterStatusV538,
#rqModalNote,
#rqSolicitanteHelp,
#v560RequestMailHint,
#rqPrepareDeliveryNote,
#newExpRequestNote,
#recordModeNote,
#instructionRequestReturnContext,
#v198ReassignDetailSubtitle,
#rqInternalReassignBulkCount,
#requestLookupCount,
#custodyCsvFileName,
#stateDetailMeta,
#ownerCardsCount,
#rqSelectedTable > .empty,
#requestDraftTable.request-draft-empty,
.request-draft-empty,
.request-search-results > .empty,
.modal-head [style*="font-size:12px"],
.modal-head [style*="font-size: 12px"],
.modal-head [style*="font-size:11px"],
.modal-head [style*="font-size: 11px"] {
  display:none!important;
}

/* Textos de ayuda insertados dentro de encabezados / filtros. */
.table-head small,
.filters small,
.field small,
.form-grid small,
.people-grid small,
.master-multi-head small,
.owner-cards-head small,
.summary-card small,
.record-entry-v321 small {
  display:none!important;
}

/* Evitar espacios vacíos dejados por ayudas ocultas. */
.field:has(> .note),
.table-head:has(.note),
.modal-head:has(.note) {
  gap:0!important;
}
.request-cycle-rule,
.request-draft-empty {
  min-height:0!important;
  margin:0!important;
  padding:0!important;
  border:0!important;
}
</style>


<style id="v639-subject-unified-all-flows">
/* V639 · ASUNTO uniforme en todos los cuadros de los flujos */
td.subject-cell-v639,
th.subject-cell-v639,
td.subject-cell-v455,
th.subject-cell-v455{
  min-width:190px!important;
  width:240px!important;
  max-width:300px!important;
  vertical-align:middle!important;
  padding:8px 10px!important;
}
.subject-text-v639,
.subject-cell-v455 .subject-text-v638{
  display:-webkit-box!important;
  -webkit-box-orient:vertical!important;
  -webkit-line-clamp:3!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
  white-space:normal!important;
  overflow-wrap:anywhere!important;
  word-break:break-word!important;
  line-height:1.22!important;
  font-size:11px!important;
  font-weight:700!important;
  color:#173b63!important;
  text-align:left!important;
  max-width:100%!important;
  margin:0!important;
}
@media(max-width:1200px){
  td.subject-cell-v639,th.subject-cell-v639,
  td.subject-cell-v455,th.subject-cell-v455{
    min-width:170px!important;
    width:210px!important;
    max-width:250px!important;
  }
}
</style>

<style id="v641-request-aging-style">
