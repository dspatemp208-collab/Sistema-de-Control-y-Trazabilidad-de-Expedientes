#newRequestModal #rqSelectedTable{
  overflow-x:auto!important;
}

/* La tabla puede desplazarse horizontalmente sin ensanchar el modal. */
#newRequestModal #rqSelectedTable table{
  width:max(100%,1080px)!important;
  min-width:1080px!important;
}

/* Evitar que el pie se desborde horizontalmente. */
#newRequestModal .modal-foot{
  width:100%!important;
  box-sizing:border-box!important;
}

@media(max-width:900px){
  #newRequestModal.show{
    padding:8px!important;
  }

  #newRequestModal .modal-box{
    width:calc(100vw - 16px)!important;
    max-width:none!important;
    max-height:calc(100vh - 16px)!important;
    max-height:calc(100dvh - 16px)!important;
    padding:12px!important;
  }

  #newRequestModal > .modal-box > .form-grid{
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
  }

  #newRequestModal > .modal-box > .form-grid .span2{
    grid-column:span 2!important;
  }
}

@media(max-width:600px){
  #newRequestModal > .modal-box > .form-grid{
    grid-template-columns:1fr!important;
  }

  #newRequestModal > .modal-box > .form-grid .span2,
  #newRequestModal > .modal-box > .form-grid .span4{
    grid-column:span 1!important;
  }
}
</style>


<style id="v482-reassignment-corner-alert-style">
/* ============================================================
   V482 · AVISOS DE REASIGNACIÓN EN ESQUINA INFERIOR DERECHA
   - No dependen del permiso de notificaciones de Windows.
   - Permanecen visibles hasta Ver o Cerrar.
   - Avisan:
       1. Nueva solicitud de reasignación recibida.
       2. Expediente reasignado / notificación de reasignación.
   ============================================================ */
#v482ReassignCornerStack{
  position:fixed;
  right:18px;
  bottom:18px;
  z-index:200500;
  width:min(390px,calc(100vw - 28px));
  max-height:min(58vh,520px);
  overflow:auto;
  display:flex;
  flex-direction:column;
  gap:9px;
  padding:2px;
  scrollbar-gutter:stable;
  pointer-events:none;
}
#v482ReassignCornerStack.v482-hidden{
  display:none!important;
}
.v482-corner-alert{
  pointer-events:auto;
  border:1px solid #91afd0;
  border-left:6px solid #1f6aa5;
  border-radius:13px;
  background:#fff;
  box-shadow:0 14px 36px rgba(12,39,70,.28);
  overflow:hidden;
  animation:v482CornerIn .22s ease-out;
}
.v482-corner-alert.is-request{
  border-left-color:#d99a00;
}
.v482-corner-alert.is-completed{
  border-left-color:#1b8b60;
}
@keyframes v482CornerIn{
  from{opacity:0;transform:translateY(14px)}
  to{opacity:1;transform:translateY(0)}
}
.v482-corner-head{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
  padding:9px 11px 8px;
  background:#f6f9fc;
  border-bottom:1px solid #e0e8f0;
}
.v482-corner-alert.is-request .v482-corner-head{
  background:#fff8e8;
  border-bottom-color:#f0dfb6;
}
.v482-corner-alert.is-completed .v482-corner-head{
  background:#eef9f4;
  border-bottom-color:#cde9dd;
}
.v482-corner-title{
  min-width:0;
  display:flex;
  align-items:center;
  gap:7px;
  color:#17365d;
  font-size:13px;
  font-weight:900;
  line-height:1.25;
}
.v482-corner-badge{
  display:inline-flex;
  align-items:center;
  padding:3px 7px;
  border-radius:999px;
  background:#d92727;
  color:#fff;
  font-size:9px;
  font-weight:900;
  letter-spacing:.03em;
  flex:0 0 auto;
}
.v482-corner-alert.is-completed .v482-corner-badge{
  background:#157458;
}
.v482-corner-close{
  width:28px;
  height:28px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  border:1px solid #cad8e6;
  border-radius:8px;
  background:#fff;
  color:#445d75;
  font-size:17px;
  font-weight:800;
  cursor:pointer;
  flex:0 0 auto;
}
.v482-corner-body{
  padding:10px 12px 8px;
}
.v482-corner-exp{
  color:#113f6d;
  font-size:16px;
  font-weight:900;
  margin-bottom:5px;
}
.v482-corner-message{
  color:#3c5873;
  font-size:11px;
  line-height:1.45;
  white-space:normal;
}
.v482-corner-message b{
  color:#17365d;
}
.v482-corner-actions{
  display:flex;
  justify-content:flex-end;
  gap:7px;
  padding:0 12px 11px;
}
.v482-corner-summary{
  pointer-events:auto;
  border:1px solid #b9cde2;
  border-radius:10px;
  background:#eef6ff;
  color:#17365d;
  padding:8px 11px;
  box-shadow:0 9px 25px rgba(15,45,78,.18);
  font-size:11px;
  font-weight:800;
}
.v482-corner-test{
  border-left-color:#7357b5!important;
}
@media(max-width:900px){
  #v482ReassignCornerStack{
    right:8px;
    bottom:8px;
    width:calc(100vw - 16px);
    max-height:46vh;
  }
}
</style>


<style id="v483-native-persistent-style">
#desktopNotifyBtnV467.v483-native-ok{
  background:#eaf8ef!important;
  border-color:#79bd96!important;
  color:#145a37!important;
}
#desktopNotifyBtnV467.v483-native-warn{
  background:#fff7e6!important;
  border-color:#dfbd67!important;
  color:#725000!important;
}
</style>


<style id="v486-request-responsive-subject-style">
/* ============================================================
   V486 · NUEVA SOLICITUD
   1) El modal ocupa el viewport real y queda sobre toda la UI.
   2) El menú lateral no puede quedar visualmente sobre el modal.
   3) El ASUNTO deja de usar el desplegable nativo gigante.
      Se utiliza un selector propio, buscable y con altura limitada.
   ============================================================ */

body.v486-request-open{
  overflow:hidden!important;
}

/* Mientras Nueva solicitud está abierta, el menú lateral no compite
   visualmente con el modal, especialmente en media pantalla. */
body.v486-request-open .produce-nav,
body.v486-request-open .app > .sidebar{
  visibility:hidden!important;
  pointer-events:none!important;
}

/* Capa del modal siempre por encima de cabecera, menú y paneles. */
#newRequestModal{
  position:fixed!important;
  inset:0!important;
  left:0!important;
  top:0!important;
  right:0!important;
  bottom:0!important;
  width:100vw!important;
  width:100dvw!important;
  height:100vh!important;
  height:100dvh!important;
  margin:0!important;
  padding:10px!important;
  z-index:2147483000!important;
  background:rgba(9,30,53,.68)!important;
  overflow:auto!important;
  box-sizing:border-box!important;
  isolation:isolate!important;
}

#newRequestModal.show{
  display:flex!important;
  align-items:flex-start!important;
  justify-content:center!important;
}

#newRequestModal > .modal-box{
  position:relative!important;
  z-index:2!important;
  width:min(1180px,calc(100dvw - 20px))!important;
  max-width:1180px!important;
  min-width:0!important;
  max-height:calc(100dvh - 20px)!important;
  margin:0 auto!important;
  padding:15px!important;
  overflow-y:auto!important;
  overflow-x:hidden!important;
  box-sizing:border-box!important;
  border-radius:14px!important;
  scrollbar-gutter:stable;
}

/* Encabezado más compacto para aprovechar altura en media pantalla. */
#newRequestModal .modal-head{
  position:sticky!important;
  top:-1px!important;
  z-index:40!important;
  display:flex!important;
  align-items:flex-start!important;
  gap:10px!important;
  background:#fff!important;
  padding:5px 4px 10px!important;
  margin:-4px -4px 10px!important;
  border-bottom:1px solid #d7e2ee!important;
}

#newRequestModal .modal-head > div{
  min-width:0!important;
  flex:1 1 auto!important;
}

#newRequestModal .modal-head h2{
  font-size:21px!important;
  line-height:1.15!important;
}

/* El formulario se adapta sin depender del ancho reservado por el menú. */
#newRequestModal > .modal-box > .form-grid{
  display:grid!important;
  grid-template-columns:repeat(2,minmax(0,1fr))!important;
  gap:10px 12px!important;
  width:100%!important;
  min-width:0!important;
}

#newRequestModal > .modal-box > .form-grid > .field{
  grid-column:span 1!important;
  min-width:0!important;
}

/* El SELECT original sigue existiendo para toda la lógica del sistema,
   pero no se muestra: evita el desplegable nativo que se extendía por
   casi toda la pantalla por los asuntos de nombre largo. */
#rqAsunto.v486-native-subject-select{
  position:absolute!important;
  width:1px!important;
  height:1px!important;
  padding:0!important;
  margin:-1px!important;
  overflow:hidden!important;
  clip:rect(0 0 0 0)!important;
  clip-path:inset(50%)!important;
  white-space:nowrap!important;
  border:0!important;
  opacity:0!important;
  pointer-events:none!important;
}

/* Selector visual de asuntos */
#rqAsuntoPickerV486{
  position:relative;
  width:100%;
  min-width:0;
}

#rqAsuntoTriggerV486{
  width:100%;
  min-height:40px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:8px 11px;
  border:1px solid #bfd1e4;
  border-radius:7px;
  background:#fff;
  color:#142f4f;
  font:inherit;
  text-align:left;
  cursor:pointer;
  box-sizing:border-box;
}

#rqAsuntoTriggerV486:hover{
  border-color:#6d99c5;
  background:#fbfdff;
}

#rqAsuntoTriggerV486:focus-visible{
  outline:3px solid #9dc5ee;
  outline-offset:1px;
}

#rqAsuntoTriggerV486:disabled{
  cursor:not-allowed;
  opacity:.68;
  background:#f3f6f9;
}

#rqAsuntoTriggerTextV486{
  min-width:0;
  flex:1 1 auto;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

#rqAsuntoTriggerArrowV486{
  flex:0 0 auto;
  color:#476987;
  font-size:12px;
}

#rqAsuntoDropdownV486{
  position:absolute;
  top:calc(100% + 5px);
  left:0;
  right:0;
  z-index:2147483100;
  overflow:hidden;
  border:1px solid #9db9d5;
  border-radius:10px;
  background:#fff;
  box-shadow:0 16px 38px rgba(11,45,78,.24);
}

#rqAsuntoDropdownV486[hidden]{
  display:none!important;
}

.v486-subject-search-bar{
  position:sticky;
  top:0;
  z-index:2;
  padding:8px;
  background:#f4f8fc;
  border-bottom:1px solid #d9e5f0;
}

#rqAsuntoSearchV486{
  width:100%;
  height:38px;
  box-sizing:border-box;
  border:1px solid #b7cce0;
  border-radius:7px;
  padding:7px 10px;
  font-size:13px;
  background:#fff;
}

.v486-subject-meta{
  display:flex;
  justify-content:space-between;
  gap:8px;
  padding:6px 9px 4px;
  font-size:10px;
  color:#627b94;
}

#rqAsuntoListV486{
  max-height:min(300px,42vh);
  overflow-y:auto;
  overscroll-behavior:contain;
  padding:4px;
}

.v486-subject-option{
  width:100%;
  display:block;
  padding:9px 10px;
  margin:0 0 3px;
  border:1px solid transparent;
  border-radius:7px;
  background:#fff;
  color:#112f50;
  text-align:left;
  white-space:normal;
  overflow-wrap:anywhere;
  word-break:normal;
  font-size:12px;
  line-height:1.3;
  cursor:pointer;
}

.v486-subject-option:hover,
.v486-subject-option:focus-visible{
  background:#edf6ff;
  border-color:#b9d6f0;
  outline:none;
}

.v486-subject-option.is-selected{
  background:#dfefff;
  border-color:#75a9d7;
  font-weight:800;
}

.v486-subject-empty{
  padding:18px 12px;
  text-align:center;
  color:#6a7e91;
  font-size:12px;
}

/* Media pantalla: un campo por fila. Con esto ningún texto largo
   invade la columna vecina y se gana legibilidad. */
@media(max-width:1100px){
  #newRequestModal{
    padding:7px!important;
  }

  #newRequestModal > .modal-box{
    width:calc(100dvw - 14px)!important;
    max-width:none!important;
    max-height:calc(100dvh - 14px)!important;
    padding:12px!important;
    border-radius:11px!important;
  }

  #newRequestModal > .modal-box > .form-grid{
    grid-template-columns:1fr!important;
    gap:8px!important;
  }

  #newRequestModal > .modal-box > .form-grid > .field,
  #newRequestModal > .modal-box > .form-grid .span2,
  #newRequestModal > .modal-box > .form-grid .span4{
    grid-column:1!important;
  }

  #rqAsuntoListV486{
    max-height:min(270px,38vh);
  }

  #newRequestModal .request-cycle-rule,
  #newRequestModal .note{
    font-size:10px!important;
    line-height:1.3!important;
  }
}

@media(max-width:620px){
  #newRequestModal{
    padding:4px!important;
  }

  #newRequestModal > .modal-box{
    width:calc(100dvw - 8px)!important;
    max-height:calc(100dvh - 8px)!important;
    padding:9px!important;
    border-radius:9px!important;
  }

  #newRequestModal .modal-head h2{
    font-size:18px!important;
  }

  #rqAsuntoListV486{
    max-height:240px;
  }

  .v486-subject-option{
    font-size:11px;
    padding:8px;
  }
}
</style>


<style id="v503-state-cards-minimal">
/* =========================================================
   V503 · ESTADOS · TARJETAS MÍNIMAS
   Solo nombre + número. Las acciones viven en el detalle.
   ========================================================= */
#tab-states .state-grid{
  grid-template-columns:repeat(5,minmax(145px,1fr))!important;
  gap:8px!important;
  margin-bottom:8px!important;
}
#tab-states .state-card{
  min-height:64px!important;
  padding:10px 13px!important;
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
  gap:12px!important;
  border-radius:11px!important;
}
#tab-states .state-card .state-name{
  flex:1 1 auto!important;
  min-width:0!important;
  min-height:0!important;
  margin:0!important;
  font-size:10.5px!important;
  line-height:1.15!important;
  font-weight:850!important;
  white-space:nowrap!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
}
#tab-states .state-card .state-count{
  flex:0 0 auto!important;
  margin:0!important;
  font-size:28px!important;
  line-height:1!important;
  font-weight:900!important;
}
#tab-states .state-card .state-meta,
#tab-states .state-card .state-progress,
#tab-states .state-card .state-card-actions{
  display:none!important;
}
#tab-states .state-card.selected{
  box-shadow:0 0 0 2px rgba(37,99,235,.18)!important;
}
@media(max-width:1250px){
  #tab-states .state-grid{grid-template-columns:repeat(3,minmax(150px,1fr))!important}
}
@media(max-width:850px){
  #tab-states .state-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
}
@media(max-width:520px){
  #tab-states .state-grid{grid-template-columns:1fr!important}
  #tab-states .state-card{min-height:58px!important}
}
</style>

<style id="v588-digital-mail-style">
.v588-digital-mail-panel{margin-top:12px;padding:11px;border:1px solid #cbd9e8;border-radius:10px;background:#f8fbff}
.v588-digital-mail-head{display:flex;align-items:center;justify-content:space-between;gap:10px;color:#0b3565}
.v588-mail-toggle{display:flex!important;align-items:center;gap:7px;font-weight:800;font-size:12px;white-space:nowrap}
.v588-mail-toggle input{width:17px;height:17px}
.v588-digital-mail-note{margin-top:7px;padding:7px 9px;border:1px solid #dbe6f1;border-radius:8px;background:#fff;font-size:10px;line-height:1.4;color:#516b86}
.v588-digital-mail-grid{display:grid;grid-template-columns:1fr 1.15fr;gap:12px;margin-top:10px}
.v588-mail-search-row{display:flex;align-items:center;gap:8px}
.v588-mail-search-row input{flex:1}
.v588-mail-search-row span,#v588DigitalMailSelectedCount{font-size:10px;font-weight:850;color:#173f6b;white-space:nowrap}
.v588-mail-recipient-list{margin-top:7px;max-height:165px;overflow:auto;border:1px solid #d7e1ec;border-radius:8px;background:#fff}
.v588-mail-recipient{display:grid;grid-template-columns:20px 1fr;gap:7px;align-items:center;padding:7px 8px;border-bottom:1px solid #edf2f7;cursor:pointer}
.v588-mail-recipient:last-child{border-bottom:0}
.v588-mail-recipient input{width:15px;height:15px}
.v588-mail-recipient b{display:block;font-size:11px;color:#123d6b}
.v588-mail-recipient small{display:block;font-size:9px;color:#58708a;margin-top:1px}
.v588-mail-selected-box{margin-top:8px;border:1px solid #d7e1ec;border-radius:8px;background:#fff;overflow:hidden}
.v588-mail-selected-head{display:flex;justify-content:space-between;gap:8px;padding:7px 9px;background:#edf5fb;border-bottom:1px solid #d7e1ec;font-size:9px;color:#234d77}
#v588DigitalMailSelected{padding:7px;display:grid;gap:6px;max-height:160px;overflow:auto}
.v588-mail-selected-item{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:6px 7px;border:1px solid #dbe5ef;border-radius:7px}
.v588-mail-selected-item b{font-size:10px;color:#173f6b}
.v588-mail-selected-item small{display:block;font-size:9px;color:#5c7188}
.v588-mail-role{display:inline-flex;margin-left:5px;padding:1px 6px;border-radius:999px;font-size:8px;font-weight:900;vertical-align:1px}
.v588-mail-role-to{background:#e7f1ff;border:1px solid #9fc4f2;color:#0b4f91}
.v588-mail-role-cc{background:#f3f5f7;border:1px solid #cbd5df;color:#425466}
.v588-mail-role-me{background:#e8f2fb;color:#245d8d}
.v588-mail-remove{border:1px solid #d4deea;background:#fff;border-radius:7px;width:28px;height:28px;cursor:pointer;color:#355474}
.v588-digital-mail-status{margin-top:7px}
@media(max-width:760px){.v588-digital-mail-grid{grid-template-columns:1fr}}
</style>


<style id="v605-health-monitor-style">
.v605-health-pill{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border:1px solid #d9e4f0;border-radius:999px;background:#fff;color:#173f6b;font-weight:800;font-size:12px;box-shadow:0 1px 2px rgba(15,23,42,.04)}
.v605-health-pill .v605-dot{width:10px;height:10px;border-radius:999px;background:#94a3b8;display:inline-block}
.v605-health-pill[data-state="NORMAL"] .v605-dot,.v605-health-status[data-state="NORMAL"] .v605-dot,.v607-chip[data-state="NORMAL"]::before{background:#16a34a}
.v605-health-pill[data-state="PRECAUCION"] .v605-dot,.v605-health-status[data-state="PRECAUCION"] .v605-dot,.v607-chip[data-state="PRECAUCION"]::before{background:#f59e0b}
.v605-health-pill[data-state="ALTA_CARGA"] .v605-dot,.v605-health-status[data-state="ALTA_CARGA"] .v605-dot,.v607-chip[data-state="ALTA_CARGA"]::before{background:#ea580c}
.v605-health-pill[data-state="PROTECCION"] .v605-dot,.v605-health-status[data-state="PROTECCION"] .v605-dot,.v607-chip[data-state="PROTECCION"]::before{background:#dc2626}
.v605-health-pill[data-state="SIN_DATOS"] .v605-dot,.v607-chip[data-state="SIN_DATOS"]::before{background:#94a3b8}
.v607-health-modal-box{max-width:980px}
.v607-health-hero{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin:8px 0 12px;padding:14px;border:1px solid #dbe4ee;border-radius:14px;background:linear-gradient(180deg,#f8fbff 0%,#f2f7fc 100%)}
.v607-health-overview{flex:1;min-width:0}
.v607-chip{display:inline-flex;align-items:center;gap:8px;padding:7px 12px;border-radius:999px;border:1px solid #dbe4ee;background:#fff;color:#173f6b;font-weight:900;font-size:12px}
.v607-chip::before{content:"";display:inline-block;width:10px;height:10px;border-radius:999px;background:#94a3b8}
.v607-health-overview h3{margin:10px 0 6px;color:#173f6b;font-size:22px;line-height:1.15}
.v607-health-overview p{margin:0;color:#52677d;font-size:13px;line-height:1.45}
.v607-minirow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:14px}
.v607-mini{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:10px 12px}
.v607-mini span{display:block;font-size:11px;font-weight:800;color:#64748b;text-transform:uppercase;letter-spacing:.04em}
.v607-mini b{display:block;margin-top:4px;color:#173f6b;font-size:14px}
.v607-actions-panel{display:flex;flex-direction:column;gap:8px;min-width:210px}
.v607-actions-panel .btn{width:100%;justify-content:center}
.v607-health-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:12px 0}
.v607-health-card{border:1px solid #dbe4ee;border-radius:14px;background:#fff;padding:13px;box-shadow:0 1px 2px rgba(15,23,42,.04)}
.v607-health-card .eyebrow{font-size:11px;font-weight:900;color:#64748b;text-transform:uppercase;letter-spacing:.05em}
.v607-health-card .big{font-size:26px;line-height:1.1;font-weight:900;color:#173f6b;margin:6px 0 4px}
.v607-health-card .sub{font-size:12px;line-height:1.45;color:#52677d}
.v607-health-card .state-chip{display:inline-flex;align-items:center;gap:6px;margin-top:8px;padding:4px 9px;border-radius:999px;font-size:11px;font-weight:900;border:1px solid #e2e8f0;background:#f8fafc;color:#173f6b}
.v607-health-card .state-chip::before{content:"";display:inline-block;width:8px;height:8px;border-radius:999px;background:#94a3b8}
.v607-health-card .state-chip[data-state="NORMAL"]::before{background:#16a34a}
.v607-health-card .state-chip[data-state="PRECAUCION"]::before{background:#f59e0b}
.v607-health-card .state-chip[data-state="ALTA_CARGA"]::before{background:#ea580c}
.v607-health-card .state-chip[data-state="PROTECCION"]::before{background:#dc2626}
.v607-health-tips{margin:12px 0;border:1px solid #dbe4ee;border-radius:14px;background:#fff;padding:14px}
.v607-health-tips strong{display:block;font-size:13px;color:#173f6b;margin-bottom:8px}
.v607-health-tips ul{margin:0;padding-left:18px;color:#52677d;font-size:13px;line-height:1.5}
.v607-health-tips li+li{margin-top:4px}
.v607-health-details{margin-top:12px;border:1px solid #dbe4ee;border-radius:14px;background:#fff;overflow:hidden}
.v607-health-details>summary{list-style:none;cursor:pointer;padding:12px 14px;font-weight:900;color:#173f6b;background:#eef4fa;display:flex;align-items:center;justify-content:space-between}
.v607-health-details>summary::-webkit-details-marker{display:none}
.v607-health-details>summary::after{content:"Mostrar detalle técnico";font-size:12px;color:#64748b;font-weight:700}
.v607-health-details[open]>summary::after{content:"Ocultar detalle técnico"}
.v607-health-detail-body{padding:12px}
.v605-health-section{margin-top:12px;border:1px solid #dbe4ee;border-radius:12px;overflow:hidden}
.v605-health-section-head{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 11px;background:#eef4fa;border-bottom:1px solid #dbe4ee}
.v605-health-section-head strong{font-size:12px;color:#173f6b}
.v605-health-table{width:100%;border-collapse:collapse}
.v605-health-table th,.v605-health-table td{padding:8px 10px;border-bottom:1px solid #edf1f5;font-size:12px;text-align:left}
.v605-health-table th{background:#f8fafc;color:#53687d;width:26%}
.v605-health-table tr:last-child td,.v605-health-table tr:last-child th{border-bottom:0}
.v605-health-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:14px;align-items:center;flex-wrap:wrap}.v605-health-stamp{margin-right:auto;font-size:11px;color:#64748b}
.v605-health-banner{padding:9px 11px;border-radius:10px;font-size:12px;margin-top:10px;background:#f8fafc;border:1px solid #dbe4ee;color:#334155;line-height:1.45}.v605-health-banner.warn{background:#fff7ed;border-color:#fed7aa;color:#9a3412}.v605-health-banner.bad{background:#fef2f2;border-color:#fecaca;color:#991b1b}
@media(max-width:900px){.v607-health-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.v607-health-hero{flex-direction:column}.v607-actions-panel{width:100%}.v607-minirow{grid-template-columns:1fr}}
@media(max-width:600px){.v607-health-grid{grid-template-columns:1fr}.v605-health-table th,.v605-health-table td{font-size:11px;padding:7px 8px}.v605-health-actions{flex-direction:column;align-items:stretch}.v605-health-stamp{margin-right:0}}

/* V608 · Ahorro adaptativo: menos trabajo de layout para elementos fuera de pantalla. */
#ownerCardsGrid .owner-user-card,#tab-states .state-card,.notification-item,.v170-task-item{content-visibility:auto;contain-intrinsic-size:80px;contain:layout paint style;}
body.v608-saving-soft #connectionBar::after,body.v608-saving-local #connectionBar::after,body.v608-saving-protection #connectionBar::after{font-size:10px;font-weight:800;margin-left:8px;padding:3px 7px;border-radius:999px;border:1px solid #dbe4ee;background:#fff;color:#52677d;}
body.v608-saving-soft #connectionBar::after{content:"Ahorro suave";}
body.v608-saving-local #connectionBar::after{content:"Ahorro local";}
body.v608-saving-protection #connectionBar::after{content:"Ahorro intensivo";}
