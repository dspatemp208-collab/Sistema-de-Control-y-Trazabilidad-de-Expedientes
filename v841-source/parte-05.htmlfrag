  inset:auto!important;
  width:auto!important;
  margin:14px 4px 0!important;
  padding:14px 12px 8px!important;
  border-top:1px solid #c9d9ea!important;
  background:transparent!important;
  z-index:auto!important;
}

/* Mantener el bloque operativo compacto para que entren más opciones. */
body.produce-staff .produce-nav > button{
  min-height:44px!important;
  padding-top:10px!important;
  padding-bottom:10px!important;
  margin-bottom:2px!important;
}

/* Separación clara entre espacio personal y funciones generales. */
body.produce-staff .produce-nav #staffMySolicitudesV319{
  margin-bottom:18px!important;
}

/* Evita que el pseudo-separador tape el botón siguiente. */
body.produce-staff .produce-nav #staffMySolicitudesV319::after{
  pointer-events:none!important;
}
</style>
<script id="v355-sidebar-footer-last-script">
(function(){
  function normalizeSidebarV355(){
    const nav=document.querySelector('.produce-nav');
    if(!nav)return;

    const footer=nav.querySelector(':scope > footer');
    if(footer && footer !== nav.lastElementChild){
      nav.appendChild(footer);
    }

    // Mantener el orden principal definido desde V341/V342.
    try{ window.reorderStaffNavV342?.(); }catch(_){}

    // El reordenamiento anterior puede mover botones, pero el pie
    // institucional siempre debe terminar al final.
    if(footer && footer !== nav.lastElementChild){
      nav.appendChild(footer);
    }
  }

  function scheduleV355(){
    requestAnimationFrame(()=>setTimeout(normalizeSidebarV355,0));
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',()=>{
      normalizeSidebarV355();
      setTimeout(normalizeSidebarV355,300);
      setTimeout(normalizeSidebarV355,1000);
    },{once:true});
  }else{
    normalizeSidebarV355();
  }

  window.addEventListener('load',scheduleV355,{once:true});
  document.addEventListener('click',scheduleV355,true);

  const startObserver=()=>{
    const nav=document.querySelector('.produce-nav');
    if(!nav)return;
    let queued=false;
    new MutationObserver(()=>{
      if(queued)return;
      queued=true;
      requestAnimationFrame(()=>{
        queued=false;
        normalizeSidebarV355();
      });
    }).observe(nav,{childList:true,subtree:false});
  };

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',startObserver,{once:true});
  }else{
    startObserver();
  }

  window.normalizeSidebarV355=normalizeSidebarV355;
})();
</script>
<script id="v357-request-action-unified">
/* =========================================================
   V357 · SOLICITUDES
   ARCHIVO / ADMINISTRADOR:
   - Se elimina la doble acción "Atender solicitud" + "Gestionar solicitud".
   - Toda solicitud activa entra por un único botón: "Gestionar solicitud".
   - Dentro del detalle ya existen las acciones operativas según el estado:
     guardar, generar cargo, vincular cargo, aceptar devolución, etc.
   - Estados concluidos conservan "Ver entrega" / "Ver historial".
   ========================================================= */

function requestWorkflowAction(r){
  const st=norm(r?.estado_atencion||r?.estado||'');
  const id=String(r?.id||'');
  const modality=v497NormalizeModality(r?.modalidad||'PRÉSTAMO');

  // COORDINADOR: en el espacio personal puede reiterar sus propias solicitudes,
  // pero conserva el seguimiento sin acciones de Archivo.
  if(isCoordinator()){
    const reiterar=(typeof window.v626ReiterationButton==='function')
      ?window.v626ReiterationButton(r)
      :'';
    if(st==='EN ESPERA DE DEVOLUCIÓN'){
      return `<div class="v626-action-stack"><button class="btn secondary small" onclick="openRequestDetail('${id}')">Ver seguimiento</button>${reiterar}</div>`;
    }
    return reiterar?`<div class="v626-action-stack">${reiterar}</div>`:'';
  }

  // USUARIO: mantiene vista de consulta y puede reiterar cuando cumpla el plazo.
  if(!hasFullAccess()){
    const reiterar=(typeof window.v626ReiterationButton==='function')
      ?window.v626ReiterationButton(r)
      :'';
    return `<div class="v626-action-stack"><button class="btn secondary small" onclick="openRequestDetail('${id}')">Ver solicitud</button>${reiterar}</div>`;
  }

  // ARCHIVO / ADMINISTRADOR:
  // una sola puerta de entrada para toda gestión operativa.
  const activeStatesV357 = new Set([
    'REGISTRADA',
    'REGISTRADA POR ARCHIVO',
    'SOLICITADO',
    'ACEPTADO',
    'PENDIENTE POR ATENDER',
    'EN ESPERA DE DEVOLUCIÓN',
    'CARGO PENDIENTE DE ENTREGA',
    'ENTREGA PARCIAL',
    'PENDIENTE DE CIERRE',
    'DEVOLUCIÓN SOLICITADA'
  ]);

  if(activeStatesV357.has(st)){
    const label=modality==='COPIA DIGITAL'
      ?'Atender copia'
      :(modality==='LECTURA EN SALA'
        ?'Atender lectura'
        :(st==='PENDIENTE POR ATENDER'?'Preparar / gestionar':'Gestionar solicitud'));
    return `<button class="btn small request-manage-btn-v357"
                    onclick="openRequestDetail('${id}')">
              ${esc(label)}
            </button>`;
  }

  if(st==='COPIA DIGITAL ENTREGADA'){
    return `<button class="btn secondary small"
                    onclick="openRequestDetail('${id}')">
              Ver copia
            </button>`;
  }

  if(st==='ENTREGA TOTAL'){
    return `<button class="btn secondary small"
                    onclick="openRequestDetail('${id}')">
              Ver entrega
            </button>`;
  }

  if(
    st==='DEVUELTO' ||
    st==='CERRADA POR ARCHIVO' ||
    st==='CERRADA POR ADMINISTRADOR' ||
    st==='CERRADO POR ADMINISTRADOR' ||
    st==='CANCELADA' ||
    st==='CANCELADO' ||
    st==='ANULADA' ||
    st==='ANULADO'
  ){
    return `<button class="btn secondary small"
                    onclick="openRequestDetail('${id}')">
              Ver historial
            </button>`;
  }

  return `<button class="btn secondary small request-manage-btn-v357"
                  onclick="openRequestDetail('${id}')">
            Gestionar solicitud
          </button>`;
}
</script>
<style id="v357-request-action-style">
/* Un único botón operativo por fila para reducir ruido visual. */
#requestsTable .request-manage-btn-v357{
  min-width:118px;
  white-space:normal;
  line-height:1.15;
}
</style>
<script id="v361-alert-center-script">
/* ============================================================
   V361 · CENTRO DE ALERTAS COMPACTO Y PRIORIZADO
   - Tareas pendientes + avisos informativos.
   - Oculta secciones con 0 registros.
   - Las tareas desaparecen cuando dejan de existir en sus fuentes.
   - Los avisos leídos pasan al filtro "Leídas".
   - Abre el modal inmediatamente y actualiza en paralelo.
   ============================================================ */
let v361AlertFilter='all';
let v361AlertRefreshing=false;
let v361LastRenderSignature='';

function v361DateValue(value){
  const t=value?new Date(value).getTime():0;
  return Number.isFinite(t)?t:0;
}

function v361EscJs(value){
  return String(value??'')
    .replace(/\\/g,'\\\\')
    .replace(/'/g,"\\'");
}

function v361TaskPriority(row){
  const p=norm(row?.prioridad||'');
  if(['CRITICA','CRÍTICA','ALTA','URGENTE'].includes(p))return 'ALTA';
  if(v170NormalizeTaskType(row?.tipo)==='PRESTAMO_MAYOR_30_DIAS')return 'ALTA';
  return 'NORMAL';
}

function v361BuildV170Tasks(){
  return (v170TaskRows||[]).map(r=>({
    kind:'action',
    id:'v170:'+String(r.id||''),
    title:r.titulo||v170TaskTypeLabel(r.tipo),
    type:v170TaskTypeLabel(r.tipo),
    expediente:r.expediente||'',
    solicitud:r.solicitud_numero||'',
    person:r.solicitante||r.responsable_actual||'',
    message:r.mensaje||'',
    date:r.created_at||r.updated_at||null,
    unread:!r.leida_at,
    high:v361TaskPriority(r)==='ALTA',
    actionLabel:v170TaskActionLabel(r),
    action:`openV170Task('${v361EscJs(r.id)}')`
  }));
}

function v361BuildLegacyTasks(){
  const rows=[];

  (operationalAlertRows||[]).forEach(r=>{
    rows.push({
      kind:'action',
      id:'loan:'+String(r.id||''),
      title:`${r.expediente||'Expediente'} · más de 30 días sin movimiento`,
      type:'CONTROL DE PRÉSTAMOS',
      expediente:r.expediente||'',
      person:r.responsable||'',
      message:`${Number(r._dias_alerta||0)} días hábiles sin movimiento.`,
      date:r._ultima_fecha_alerta||r.fecha_entrega||null,
      unread:true,
      high:true,
      actionLabel:'Gestionar expediente',
      action:`closeAlertsModal();manageExpedienteFromPanel('${v361EscJs(r.id)}')`
    });
  });

  (archiveDeliveryRows||[]).forEach(r=>{
    const mine=!hasFullAccess();
    const canConfirm=!!r._can_confirm;
    let label='Gestionar expediente';
    let action='';

    if(mine && norm(r.estado)!=='PREPARADA'){
      action=`openArchiveDeliveryReturnInRequest('${v361EscJs(r.id)}')`;
    }else if(hasFullAccess() && canConfirm){
      label='Confirmar recepción';
      action=`confirmArchiveDeliveryReceived('${v361EscJs(r.id)}')`;
    }else if(hasFullAccess() && r.expediente_id){
      action=`closeAlertsModal();manageExpedienteFromPanel('${v361EscJs(r.expediente_id)}')`;
    }

    rows.push({
      kind:'action',
      id:'return:'+String(r.id||''),
      title:`${r.expediente||'Expediente'} · entrega a Archivo`,
      type:'DEVOLUCIÓN / RECEPCIÓN',
      expediente:r.expediente||'',
      solicitud:r.solicitud_numero||'',
      person:r.responsable_solicitado||'',
      message:norm(r.estado)==='PREPARADA'
        ?'La devolución fue registrada y está pendiente de recepción física por Archivo.'
        :'Existe una solicitud de entrega a Archivo pendiente.',
      date:r.fecha_solicitud||null,
      unread:true,
      high:false,
      actionLabel:label,
      action
    });
  });

  (crossAreaWaitRows||[]).forEach(r=>{
    const returning=norm(r.estado)==='DEVOLUCIÓN SOLICITADA';
    let label='Revisar';
    let action='';

    if(hasFullAccess() && returning){
      label='Recibir y continuar';
      action=`openCrossAreaReturnAcceptance('${v361EscJs(r.espera_id)}',null)`;
    }else if(r.es_responsable_actual || hasFullAccess()){
      label=r.es_responsable_actual?'Gestionar y devolver':'Gestionar expediente';
      action=`manageCrossAreaWaitFromAlert('${v361EscJs(r.espera_id)}',null)`;
    }

    rows.push({
      kind:'action',
      id:'cross:'+String(r.espera_id||r.id||''),
      title:`${r.expediente||'Expediente'} · ${returning?'devolución solicitada':'esperando devolución'}`,
      type:'SOLICITUD ENTRE ÁREAS',
      expediente:r.expediente||'',
      solicitud:r.solicitud_numero||'',
      person:r.responsable_actual||'',
      message:returning
        ?'El responsable ya registró la devolución. Falta la recepción de Archivo.'
        :'El expediente debe retornar a Archivo antes de continuar con la nueva solicitud.',
      date:r.created_at||r.fecha_solicitud||null,
      unread:true,
      high:false,
      actionLabel:label,
      action
    });
  });

  (internalReassignRows||[])
    .filter(r=>norm(r.estado)==='PENDIENTE')
    .forEach(r=>{
      const received=norm(r.direccion)==='RECIBIDA';
      const sent=norm(r.direccion)==='ENVIADA';
      const legacy=!!r._derived_custodian_alert;
      let label='Ver expediente';
      let action=r.expediente_id
        ?`closeAlertsModal();manageExpedienteFromPanel('${v361EscJs(r.expediente_id)}')`
        :'';

      if(legacy && r.puede_responder){
        label='Gestionar devolución';
        action=`openInternalReturnFromAlert('${v361EscJs(r.id)}',null)`;
      }else if(received && r.puede_responder){
        label='Gestionar reasignación';
        action=`closeAlertsModal();manageExpedienteFromPanel('${v361EscJs(r.expediente_id)}')`;
      }else if(sent){
        label='Ver expediente';
      }

      rows.push({
        kind:'action',
        id:'reassign:'+String(r.id||''),
        title:`${r.expediente||'Expediente'} · reasignación pendiente`,
        type:'REASIGNACIÓN',
        expediente:r.expediente||'',
        person:received?r.solicitante_nombre:r.responsable_actual_nombre,
        message:received
          ?`${r.solicitante_nombre||'Otro usuario'} solicita recibir el expediente.`
          :`Solicitud enviada a ${r.responsable_actual_nombre||'otro usuario'}; pendiente de confirmación.`,
        date:r.created_at||null,
        unread:true,
        high:false,
        actionLabel:label,
        action
      });
    });

  return rows;
}

function v361BuildTasks(){
  const source=v170TaskLayerAvailable===true
    ?v361BuildV170Tasks()
    :v361BuildLegacyTasks();

  return source.sort((a,b)=>{
    if(Number(b.high)!==Number(a.high))return Number(b.high)-Number(a.high);
    return v361DateValue(b.date)-v361DateValue(a.date);
  });
}

function v361BuildNotices(){
  const rows=[];

  (locationAlertsRows||[]).forEach(r=>{
    const unread=r.destinatario_id===session?.user?.id&&!r.leida_at;
    rows.push({
      kind:'notice',
      id:'location:'+String(r.id||''),
      source:'location',
      title:`Expediente ${r.expediente||'—'} · ubicación verificada`,
      type:'UBICACIÓN',
      expediente:r.expediente||'',
      solicitud:r.solicitud_numero||'',
      message:`Ubicación: ${r.sede||'UBICACIÓN VERIFICADA'}. ${r.observacion||''}`.trim(),
      date:r.created_at||null,
      unread,
      read:!unread,
      primaryLabel:r.solicitud_id?'Ver solicitud':'',
      primaryAction:r.solicitud_id
        ?`closeAlertsModal();openRequestDetail('${v361EscJs(r.solicitud_id)}')`
        :'',
      secondaryLabel:unread?'Marcar como leído':'',
      secondaryAction:unread
        ?`markLocationNoticeRead('${v361EscJs(r.id)}',event.currentTarget)`
        :''
    });
  });

  (notificationRows||[]).forEach(n=>{
    rows.push({
      kind:'notice',
      id:'notification:'+String(n.id||''),
      source:'reassignment',
      title:n.titulo||'Expediente reasignado',
      type:'REASIGNACIÓN',
      expediente:n.expediente||'',
      message:n.mensaje||'',
      date:n.created_at||null,
      unread:!n.leida,
      read:!!n.leida,
      primaryLabel:n.expediente_id?'Ver expediente':'',
      primaryAction:n.expediente_id
        ?`openNotificationExpediente('${v361EscJs(n.id)}','${v361EscJs(n.expediente_id)}')`
        :'',
      secondaryLabel:!n.leida?'Marcar como leída':'',
      secondaryAction:!n.leida
        ?`markNotificationRead('${v361EscJs(n.id)}')`
        :''
    });
  });

  return rows.sort((a,b)=>v361DateValue(b.date)-v361DateValue(a.date));
}

function v361Meta(item){
  const parts=[];
  if(item.expediente)parts.push(`Expediente: <b>${esc(item.expediente)}</b>`);
  if(item.solicitud)parts.push(`Solicitud: <b>${esc(item.solicitud)}</b>`);
  if(item.person)parts.push(`Responsable / solicitante: <b>${esc(item.person)}</b>`);
  if(item.date)parts.push(`${fmtDate(item.date)}${masterValueHasExplicitTime(item.date)?' · '+fmtTime(item.date):''}`);
  return parts.join(' · ');
}

function v361ActionItemHtml(item){
  return `<article class="v361-alert-item ${item.high?'is-high':''}">
    <div class="v361-alert-main">
      <div class="v361-alert-title">
        <span>${esc(item.title||'Tarea pendiente')}</span>
        <span class="v361-type">${esc(item.type||'TAREA')}</span>
        ${item.high?'<span class="v361-priority">PRIORIDAD ALTA</span>':''}
      </div>
      ${v361Meta(item)?`<div class="v361-alert-meta">${v361Meta(item)}</div>`:''}
      ${item.message?`<div class="v361-alert-message">${esc(item.message)}</div>`:''}
    </div>
    <div class="v361-alert-actions">
      ${item.action
        ?`<button class="btn small" type="button" onclick="${item.action}">${esc(item.actionLabel||'Gestionar')}</button>`
        :'<span class="note">Sin acción pendiente disponible.</span>'}
    </div>
  </article>`;
}

function v361NoticeItemHtml(item){
  return `<article class="v361-alert-item ${item.unread?'is-unread':''}">
    <div class="v361-alert-main">
      <div class="v361-alert-title">
        <span>${esc(item.title||'Aviso')}</span>
        <span class="v361-type">${esc(item.type||'AVISO')}</span>
        ${item.unread?'<span class="v361-priority" style="background:#fff0c7;color:#8a5a00">NUEVO</span>':''}
      </div>
      ${v361Meta(item)?`<div class="v361-alert-meta">${v361Meta(item)}</div>`:''}
      ${item.message?`<div class="v361-alert-message">${esc(item.message)}</div>`:''}
    </div>
    <div class="v361-alert-actions">
      ${item.secondaryAction
        ?`<button class="btn secondary small" type="button" onclick="${item.secondaryAction}">${esc(item.secondaryLabel)}</button>`
        :''}
      ${item.primaryAction
        ?`<button class="btn small" type="button" onclick="${item.primaryAction}">${esc(item.primaryLabel)}</button>`
        :''}
    </div>
  </article>`;
}

function setV361AlertFilter(filter){
  v361AlertFilter=['all','action','notice','read'].includes(filter)?filter:'all';
  renderV361Alerts(true);
}

function renderV361Alerts(force=false){
  if(!el('v361AlertsCenter'))return;

  const tasks=v361BuildTasks();
  const notices=v361BuildNotices();
  const unreadNotices=notices.filter(x=>x.unread);
  const readNotices=notices.filter(x=>x.read);
  const highTasks=tasks.filter(x=>x.high);

  if(el('v361ActionCount'))el('v361ActionCount').textContent=String(tasks.length);
  if(el('v361UnreadCount'))el('v361UnreadCount').textContent=String(unreadNotices.length);
  if(el('v361HighCount'))el('v361HighCount').textContent=String(highTasks.length);

  document.querySelectorAll('[data-v361-alert-filter]').forEach(btn=>{
    const active=btn.dataset.v361AlertFilter===v361AlertFilter;
    btn.classList.toggle('active',active);
    btn.setAttribute('aria-pressed',String(active));
  });

  let visibleTasks=[];
  let visibleNotices=[];

  if(v361AlertFilter==='all'){
    visibleTasks=tasks;
    visibleNotices=unreadNotices;
  }else if(v361AlertFilter==='action'){
    visibleTasks=tasks;
  }else if(v361AlertFilter==='notice'){
    visibleNotices=unreadNotices;
  }else if(v361AlertFilter==='read'){
    visibleNotices=readNotices;
  }

  const signature=JSON.stringify({
    filter:v361AlertFilter,
    tasks:visibleTasks.map(x=>x.id),
    notices:visibleNotices.map(x=>[x.id,x.unread]),
    totals:[tasks.length,unreadNotices.length,highTasks.length]
  });

  if(!force && signature===v361LastRenderSignature)return;
  v361LastRenderSignature=signature;

  const actionSection=el('v361ActionSection');
  const noticeSection=el('v361NoticeSection');
  const empty=el('v361AlertEmpty');

  if(el('v361ActionSectionCount'))el('v361ActionSectionCount').textContent=String(visibleTasks.length);
  if(el('v361NoticeSectionCount'))el('v361NoticeSectionCount').textContent=String(visibleNotices.length);

  if(el('v361ActionList'))el('v361ActionList').innerHTML=visibleTasks.map(v361ActionItemHtml).join('');
  if(el('v361NoticeList'))el('v361NoticeList').innerHTML=visibleNotices.map(v361NoticeItemHtml).join('');

  actionSection?.classList.toggle('hidden',visibleTasks.length===0);
  noticeSection?.classList.toggle('hidden',visibleNotices.length===0);
  empty?.classList.toggle('hidden',(visibleTasks.length+visibleNotices.length)!==0);

  if(el('v361AlertStatus') && !v361AlertRefreshing){
    const total=tasks.length+unreadNotices.length;
    el('v361AlertStatus').textContent=total
      ?`${tasks.length} tarea(s) pendiente(s) · ${unreadNotices.length} aviso(s) sin leer.`
      :'No hay tareas ni avisos pendientes.';
  }
}

async function refreshV361Alerts(manual=false){
  if(v361AlertRefreshing||!sb||!session)return;
  v361AlertRefreshing=true;

  const btn=el('v361RefreshBtn');
  if(btn){
    btn.disabled=true;
    btn.textContent='Actualizando…';
  }
  if(el('v361AlertStatus')){
    el('v361AlertStatus').textContent=manual?'Actualizando alertas…':'Consultando alertas…';
  }

  // El modal no espera a una consulta antes de mostrarse.
  const jobs=[
    loadV170Tasks(true,true),
    loadLocationAlerts(),
    loadNotifications(true),
    loadOperationalAlerts(true),
    loadArchiveDeliveryRequests(true),
    loadInternalReassignRequests(true),
    loadCrossAreaWaits(true)
  ];

  await Promise.allSettled(jobs);

  v361AlertRefreshing=false;
  if(btn){
    btn.disabled=false;
    btn.textContent='Actualizar';
  }
  updateAlertsBadge();
  renderV361Alerts(true);
}

window.openAlertsModal=async function(){
  if(!session)return;

  el('alertsModal')?.classList.add('show');
  v361AlertFilter='all';
  v361LastRenderSignature='';
  renderV361Alerts(true);

  // La ventana aparece inmediatamente; la información se refresca en paralelo.
  refreshV361Alerts(false);
};

window.closeAlertsModal=function(){
  el('alertsModal')?.classList.remove('show');
};

/* Mantener sincronizada la vista compacta cuando cambian los arrays existentes,
   sin reconstruir el modal continuamente. */
setInterval(()=>{
  if(el('alertsModal')?.classList.contains('show') && !v361AlertRefreshing){
    renderV361Alerts(false);
  }
},1000);
</script>
<div aria-label="Nuevas solicitudes recibidas" aria-live="assertive" class="v362-request-alert-stack hidden" id="v362RequestAlertStack">
</div>
<script id="v362-request-alert-script">
/* ============================================================
   V362 · ALERTA PERSISTENTE POR NUEVA SOLICITUD
   Requiere instalar V362_SQL_ALERTA_PERSISTENTE_NUEVA_SOLICITUD.sql
   ============================================================ */
let v362RequestAlertRows=[];
let v362RequestAlertTimer=null;
let v362RequestAlertLoading=false;
let v362RequestAlertsAvailable=true;
let v362AudioContext=null;

function v362CanReceiveRequestAlerts(){
  const role=norm(currentProfile?.rol||'');
  return role==='ARCHIVO' || role==='ADMINISTRADOR';
}

function v362SoundedIds(){
  try{
    const raw=sessionStorage.getItem('v362_request_alert_sounded')||'[]';
    const arr=JSON.parse(raw);
    return new Set(Array.isArray(arr)?arr:[]);
  }catch(_){
    return new Set();
  }
}

function v362SaveSoundedIds(set){
  try{
    sessionStorage.setItem(
      'v362_request_alert_sounded',
      JSON.stringify([...set].slice(-250))
    );
  }catch(_){}
}

function v362EnableAudio(){
  try{
    const AudioCtx=window.AudioContext||window.webkitAudioContext;
    if(!AudioCtx)return;
    if(!v362AudioContext)v362AudioContext=new AudioCtx();
    if(v362AudioContext.state==='suspended')v362AudioContext.resume().catch(()=>{});
  }catch(_){}
}

function v362PlayRequestSound(){
  try{
    v362EnableAudio();
    const ctx=v362AudioContext;
    if(!ctx || ctx.state!=='running')return;

    const now=ctx.currentTime;
    [0,.18].forEach((offset,index)=>{
      const osc=ctx.createOscillator();
      const gain=ctx.createGain();
      osc.type='sine';
      osc.frequency.setValueAtTime(index===0?880:1040,now+offset);
      gain.gain.setValueAtTime(.0001,now+offset);
      gain.gain.exponentialRampToValueAtTime(.10,now+offset+.015);
      gain.gain.exponentialRampToValueAtTime(.0001,now+offset+.13);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now+offset);
      osc.stop(now+offset+.15);
    });
  }catch(_){}
}

function v362RequestAlertDate(row){
  const value=row?.solicitud_created_at||row?.created_at||null;
  if(!value)return '—';
  const d=fmtDate(value)||'—';
  const t=masterValueHasExplicitTime(value)?fmtTime(value):'';
  return t?`${d} · ${t}`:d;
}

function v362RenderRequestAlerts(){
  const host=el('v362RequestAlertStack');
  if(!host)return;

  // V484 · En modo nativo no duplicar el aviso dentro de la página.
  if(typeof window.nativeOnlyActiveV484==='function' &&
     window.nativeOnlyActiveV484()){
    host.innerHTML='';
    host.classList.add('hidden');
    return;
  }

  if(!v362CanReceiveRequestAlerts() || !v362RequestAlertRows.length){
    host.innerHTML='';
    host.classList.add('hidden');
    return;
  }

  const rows=v362RequestAlertRows.slice().sort((a,b)=>
    String(b?.solicitud_created_at||b?.created_at||'')
      .localeCompare(String(a?.solicitud_created_at||a?.created_at||''))
  );

  const visible=rows.slice(0,5);
  const remaining=Math.max(0,rows.length-visible.length);

  host.innerHTML=visible.map(row=>{
    const alertaId=String(row.alerta_id||'');
    const solicitudId=String(row.solicitud_id||'');
    return `<article class="v362-request-alert-card"
                     data-alerta-id="${esc(alertaId)}">
      <div class="v362-request-alert-head">
        <div class="v362-request-alert-title">
          <span class="v362-request-alert-bell">🔔</span>
          <span>Nueva solicitud recibida</span>
        </div>
        <span class="v362-request-alert-new">NUEVA</span>
      </div>
      <div class="v362-request-alert-body">
        <div class="v362-request-alert-number">${esc(row.numero||'SOLICITUD')}</div>
        <div class="v362-request-alert-meta">
          <div>Solicitante: <b>${esc(row.solicitante||'—')}</b></div>
          <div>${Number(row.total_expedientes||0)} expediente(s) · <b>${esc(row.modalidad||'PRÉSTAMO')}</b></div>
          ${row.asunto?`<div>Asunto: <b>${esc(row.asunto)}</b></div>`:''}
          <div>Recibida: <b>${esc(v362RequestAlertDate(row))}</b></div>
        </div>
      </div>
      <div class="v362-request-alert-actions">
        <button class="btn small v362-request-alert-open"
                type="button"
                onclick="openV362RequestAlert('${v362Esc(alertaId)}','${v362Esc(solicitudId)}')">
          Ver / gestionar
        </button>
      </div>
    </article>`;
  }).join('') +
  (remaining>0
    ?`<div class="v362-request-alert-summary">
        + ${remaining} solicitud(es) nueva(s) adicional(es). Abra las alertas mostradas para continuar.
      </div>`
    :'');

  host.classList.remove('hidden');
}

function v362Esc(value){
  return String(value??'')
    .replace(/\\/g,'\\\\')
    .replace(/'/g,"\\'");
}

async function loadV362RequestAlerts({silent=false}={}){
  if(!sb||!session||v362RequestAlertLoading||!v362CanReceiveRequestAlerts())return;
  if(!v362RequestAlertsAvailable)return;

  v362RequestAlertLoading=true;
  try{
    const {data,error}=await sb.rpc('mis_alertas_nuevas_solicitudes_v362');

    if(error){
      // SQL todavía no instalado: no romper el resto del sistema.
      if(['PGRST202','42883'].includes(error?.code||'')){
        v362RequestAlertsAvailable=false;
        console.warn('V362 · falta instalar el SQL de alertas persistentes.');
        return;
      }
      throw error;
    }

    const previousIds=new Set(v362RequestAlertRows.map(r=>String(r.alerta_id||'')));
    const next=Array.isArray(data)?data:[];

    v362RequestAlertRows=next;
    v362RenderRequestAlerts();

    const sounded=v362SoundedIds();
    const newIds=next
      .map(r=>String(r.alerta_id||''))
      .filter(id=>id && !sounded.has(id));

    if(newIds.length){
      // El sonido se reproduce una sola vez por alerta y por sesión del navegador.
      v362PlayRequestSound();
      newIds.forEach(id=>sounded.add(id));
      v362SaveSoundedIds(sounded);

      // V484 · El aviso visual ya no se muestra como toast dentro
      // de la página. Cuando Avisos PC está activo, la comunicación
      // visible se realiza mediante la notificación nativa de Windows.
      // El sonido y el contador interno se conservan.
    }

    // Mantener el título de la pestaña como señal secundaria.
    const baseTitle='Sistema de Control y Trazabilidad de Expedientes';
    document.title=next.length
      ?`(${next.length}) 🔔 ${baseTitle}`
      :baseTitle;

  }catch(error){
    console.warn('V362 · alertas de nuevas solicitudes:',error?.message||error);
  }finally{
    v362RequestAlertLoading=false;
  }
}

async function openV362RequestAlert(alertaId,solicitudId){
  if(!sb||!session||!alertaId)return;

  const card=document.querySelector(
    `.v362-request-alert-card[data-alerta-id="${CSS.escape(String(alertaId))}"]`
  );
  const button=card?.querySelector('.v362-request-alert-open');
  if(button){
    button.disabled=true;
    button.textContent='Abriendo…';
  }

  try{
    const {error}=await sb.rpc('marcar_alerta_nueva_solicitud_vista_v362',{
      p_alerta_id:alertaId
    });
    if(error)throw error;

    v362RequestAlertRows=v362RequestAlertRows.filter(
      row=>String(row.alerta_id||'')!==String(alertaId)
    );
    v362RenderRequestAlerts();

    if(solicitudId){
      // Abre la gestión de la solicitud. La alerta ya queda registrada como vista.
      await openRequestDetail(solicitudId);
    }

    // Sincronización silenciosa por si hay más alertas.
    loadV362RequestAlerts({silent:true});

  }catch(error){
    alert(error?.message||String(error));
    if(button){
      button.disabled=false;
      button.textContent='Ver / gestionar';
    }
  }
}

function startV362RequestAlertPolling(){
  clearInterval(v362RequestAlertTimer);
  v362RequestAlertTimer=null;

  if(!v362CanReceiveRequestAlerts())return;

  // Consulta inmediata al iniciar sesión/perfil.
  loadV362RequestAlerts({silent:true});

  // V602: sin polling propio. La revisión inmediata se conserva y, después,
  // el gestor central V602 vuelve a consultar esta fuente solo si V170 detecta cambios.
  // El valor -1 funciona como centinela para que el listener global no reinicie el sondeo.
  v362RequestAlertTimer=-1;
}

/* Los navegadores exigen una interacción previa para permitir sonido.
   Cualquier primer clic habilita el audio; la alerta visual funciona siempre. */
document.addEventListener('pointerdown',v362EnableAudio,{once:true,capture:true});
document.addEventListener('keydown',v362EnableAudio,{once:true,capture:true});

/* Arrancar después de que la sesión y el perfil hayan tenido tiempo de cargar.
   También se reintenta si el perfil se resolvió unos instantes después. */
window.addEventListener('load',()=>{
  setTimeout(startV362RequestAlertPolling,1200);
  setTimeout(()=>{
    if(!v362RequestAlertTimer)startV362RequestAlertPolling();
  },3500);
},{once:true});

/* Si la sesión/perfil cambia por alguna acción interna, sincronizar al siguiente clic. */
document.addEventListener('click',()=>{
  if(v362CanReceiveRequestAlerts() && !v362RequestAlertTimer){
    startV362RequestAlertPolling();
  }
},true);

window.loadV362RequestAlerts=loadV362RequestAlerts;
window.openV362RequestAlert=openV362RequestAlert;
window.startV362RequestAlertPolling=startV362RequestAlertPolling;
</script>
<script id="v364-alert-center-script">
let v364AlertFilter='all';
let v364ShowAllTasks=false;
let v364Refreshing=false;

function v364DateText(value){
  if(!value)return '';
  const d=fmtDate(value)||'';
  const t=masterValueHasExplicitTime(value)?fmtTime(value):'';
  return [d,t].filter(Boolean).join(' · ');
}

function v364BuildNewRequests(){
  if(!v362CanReceiveRequestAlerts?.())return [];
  return (v362RequestAlertRows||[])
    .map(r=>({
      id:String(r.alerta_id||''),
      solicitudId:String(r.solicitud_id||''),
      numero:r.numero||'SOLICITUD',
      solicitante:r.solicitante||'—',
      asunto:r.asunto||'',
      modalidad:r.modalidad||'PRÉSTAMO',
      total:Number(r.total_expedientes||0),
      date:r.solicitud_created_at||r.created_at||null
    }))
    .sort((a,b)=>String(b.date||'').localeCompare(String(a.date||'')));
}

function v364TaskRows(){
  const rows=typeof v361BuildTasks==='function'?v361BuildTasks():[];
  return rows.filter(x=>x && x.kind==='action');
}

function v364NoticeRows(){
  return typeof v361BuildNotices==='function'?v361BuildNotices():[];
}

function v364NewRequestHtml(r){
  const alerta=v362Esc(r.id);
  const solicitud=v362Esc(r.solicitudId);
  return `<article class="v364-row is-new">
    <div class="v364-row-main">
      <div class="v364-row-title">
        <span>${esc(r.numero)}</span>
        <span class="v364-badge new">NUEVA SOLICITUD</span>
      </div>
      <div class="v364-row-meta">
        ${esc(r.solicitante)} · ${r.total} expediente(s) · ${esc(r.modalidad)}
        ${r.date?' · '+esc(v364DateText(r.date)):''}
      </div>
      ${r.asunto?`<div class="v364-row-message">${esc(r.asunto)}</div>`:''}
    </div>
    <div class="v364-row-actions">
      <button class="btn small" type="button"
              onclick="openV364NewRequest('${alerta}','${solicitud}')">
        Ver / gestionar
      </button>
    </div>
  </article>`;
}

function v364TaskHtml(item){
  return `<article class="v364-row">
    <div class="v364-row-main">
      <div class="v364-row-title">
        <span>${esc(item.title||'Tarea pendiente')}</span>
        <span class="v364-badge">${esc(item.type||'TAREA')}</span>
      </div>
      <div class="v364-row-meta">
        ${item.expediente?`Exp. ${esc(item.expediente)}`:''}
        ${item.solicitud?` · ${esc(item.solicitud)}`:''}
        ${item.person?` · ${esc(item.person)}`:''}
        ${item.date?` · ${esc(v364DateText(item.date))}`:''}
      </div>
      ${item.message?`<div class="v364-row-message">${esc(item.message)}</div>`:''}
    </div>
    <div class="v364-row-actions">
      ${item.action
        ?`<button class="btn small" type="button" onclick="${item.action}">${esc(item.actionLabel||'Gestionar')}</button>`
        :''}
    </div>
  </article>`;
}

function v364NoticeHtml(item){
  return `<article class="v364-row ${item.unread?'is-unread':''}">
    <div class="v364-row-main">
      <div class="v364-row-title">
        <span>${esc(item.title||'Aviso')}</span>
        <span class="v364-badge">${esc(item.type||'AVISO')}</span>
        ${item.unread?'<span class="v364-badge new">NUEVO</span>':''}
      </div>
      <div class="v364-row-meta">
        ${item.expediente?`Exp. ${esc(item.expediente)}`:''}
        ${item.solicitud?` · ${esc(item.solicitud)}`:''}
        ${item.date?` · ${esc(v364DateText(item.date))}`:''}
      </div>
      ${item.message?`<div class="v364-row-message">${esc(item.message)}</div>`:''}
    </div>
    <div class="v364-row-actions">
      ${item.secondaryAction
        ?`<button class="btn secondary small" type="button" onclick="${item.secondaryAction};setTimeout(()=>renderV364Alerts(true),250)">${esc(item.secondaryLabel)}</button>`
        :''}
      ${item.primaryAction
        ?`<button class="btn small" type="button" onclick="${item.primaryAction}">${esc(item.primaryLabel)}</button>`
        :''}
    </div>
  </article>`;
}

function setV364AlertFilter(filter){
  v364AlertFilter=['all','new','tasks','notices','read'].includes(filter)?filter:'all';
  renderV364Alerts(true);
}

function toggleV364AllTasks(){
  v364ShowAllTasks=!v364ShowAllTasks;
  renderV364Alerts(true);
}

function renderV364Alerts(force=false){
  const root=el('v361AlertsCenter');
  if(!root)return;

  const newRequests=v364BuildNewRequests();
  const tasks=v364TaskRows();
  const notices=v364NoticeRows();
  const unread=notices.filter(x=>x.unread);
  const read=notices.filter(x=>x.read);

  if(el('v364NewCount'))el('v364NewCount').textContent=String(newRequests.length);
  if(el('v364TaskCount'))el('v364TaskCount').textContent=String(tasks.length);
  if(el('v364NoticeCount'))el('v364NoticeCount').textContent=String(unread.length);

  document.querySelectorAll('[data-v364-filter]').forEach(btn=>{
    const active=btn.dataset.v364Filter===v364AlertFilter;
    btn.classList.toggle('active',active);
    btn.setAttribute('aria-pressed',String(active));
  });

  let showNew=[];
  let showTasks=[];
  let showNotices=[];

  if(v364AlertFilter==='all'){
    showNew=newRequests;
    showTasks=tasks;
    showNotices=unread;
  }else if(v364AlertFilter==='new'){
    showNew=newRequests;
  }else if(v364AlertFilter==='tasks'){
    showTasks=tasks;
  }else if(v364AlertFilter==='notices'){
    showNotices=unread;
  }else if(v364AlertFilter==='read'){
    showNotices=read;
  }

  const maxTasks=6;
  const taskRows=v364ShowAllTasks?showTasks:showTasks.slice(0,maxTasks);

  if(el('v364NewList'))el('v364NewList').innerHTML=showNew.map(v364NewRequestHtml).join('');
  if(el('v364TaskList'))el('v364TaskList').innerHTML=taskRows.map(v364TaskHtml).join('');
  if(el('v364NoticeList'))el('v364NoticeList').innerHTML=showNotices.map(v364NoticeHtml).join('');

  if(el('v364NewSectionCount'))el('v364NewSectionCount').textContent=String(showNew.length);
  if(el('v364TaskSectionCount'))el('v364TaskSectionCount').textContent=String(showTasks.length);
  if(el('v364NoticeSectionCount'))el('v364NoticeSectionCount').textContent=String(showNotices.length);

  el('v364NewSection')?.classList.toggle('hidden',showNew.length===0);
  el('v364TaskSection')?.classList.toggle('hidden',showTasks.length===0);
  el('v364NoticeSection')?.classList.toggle('hidden',showNotices.length===0);

  const toggleBtn=el('v364ToggleTasksBtn');
  if(toggleBtn){
    toggleBtn.classList.toggle('hidden',showTasks.length<=maxTasks);
    toggleBtn.textContent=v364ShowAllTasks
      ?'Ver menos'
      :`Ver todas (${showTasks.length})`;
  }

  const totalVisible=showNew.length+showTasks.length+showNotices.length;
  el('v364Empty')?.classList.toggle('hidden',totalVisible!==0);

  if(el('v364Status')&&!v364Refreshing){
    const totalPending=newRequests.length+tasks.length+unread.length;
    el('v364Status').textContent=totalPending
      ?`${newRequests.length} nueva(s) solicitud(es) · ${tasks.length} tarea(s) · ${unread.length} aviso(s) sin leer.`
      :'No hay alertas pendientes.';
  }

  // El contador general del encabezado debe incluir también nuevas solicitudes.
  if(el('alertsUnreadText')){
    el('alertsUnreadText').textContent=String(newRequests.length+tasks.length); // V790: novedades fuera del contador de acciones
  }
}

async function refreshV364Alerts(manual=false){
  if(v364Refreshing||!sb||!session)return;
  v364Refreshing=true;

  const btn=el('v364RefreshBtn');
  if(btn){
    btn.disabled=true;
    btn.textContent='Actualizando…';
  }
  if(el('v364Status')){
    el('v364Status').textContent=manual?'Actualizando alertas…':'Consultando alertas…';
  }

  const jobs=[
    typeof loadV362RequestAlerts==='function'
      ?loadV362RequestAlerts({silent:true})
      :Promise.resolve(),
    typeof loadV170Tasks==='function'
      ?loadV170Tasks(true,true)
      :Promise.resolve(),
    typeof loadLocationAlerts==='function'
      ?loadLocationAlerts()
      :Promise.resolve(),
    typeof loadNotifications==='function'
      ?loadNotifications(true)
      :Promise.resolve(),
    typeof loadOperationalAlerts==='function'
      ?loadOperationalAlerts(true)
      :Promise.resolve(),
    typeof loadArchiveDeliveryRequests==='function'
      ?loadArchiveDeliveryRequests(true)
      :Promise.resolve(),
    typeof loadInternalReassignRequests==='function'
      ?loadInternalReassignRequests(true)
      :Promise.resolve(),
    typeof loadCrossAreaWaits==='function'
      ?loadCrossAreaWaits(true)
      :Promise.resolve()
  ];

  await Promise.allSettled(jobs);

  v364Refreshing=false;
  if(btn){
    btn.disabled=false;
    btn.textContent='Actualizar';
  }
  renderV364Alerts(true);
}

async function openV364NewRequest(alertaId,solicitudId){
  if(typeof openV362RequestAlert!=='function')return;
  await openV362RequestAlert(alertaId,solicitudId);
  setTimeout(()=>renderV364Alerts(true),100);
}

/* Sustituir la apertura V361 por la vista V364. */
window.openAlertsModal=async function(){
  if(!session)return;

  el('alertsModal')?.classList.add('show');
  v364AlertFilter='all';
  v364ShowAllTasks=false;
  renderV364Alerts(true);

  // La ventana abre primero y consulta después.
  refreshV364Alerts(false);
};

window.closeAlertsModal=function(){
  el('alertsModal')?.classList.remove('show');
};

/* Compatibilidad con el intervalo V361 existente. */
window.renderV361Alerts=renderV364Alerts;
window.refreshV361Alerts=refreshV364Alerts;

setInterval(()=>{
  if(el('alertsModal')?.classList.contains('show')&&!v364Refreshing){
    renderV364Alerts(false);
  }
},1200);
</script>
<script id="v392-owner-cards-reliable-actions">
(function(){
  'use strict';

  let opening=false;

  function clean(v){
    return String(v??'').trim();
  }

  function actionFromButton(button){
    const declared=clean(button?.dataset?.ownerAction);
    if(declared)return declared;

    const label=clean(button?.textContent).toUpperCase();

    if(label.startsWith('POR ATENDER'))return 'pending_attention';
    if(label.startsWith('EN PRÉSTAMO') || label.startsWith('EN PRESTAMO'))return 'loan';
    if(label.startsWith('REASIGNADOS'))return 'reassigned';
    if(label.startsWith('SOLICITUDES DEVOLUCIÓN') || label.startsWith('SOLICITUDES DEVOLUCION'))return 'pending';
    if(label.startsWith('DEVUELTOS'))return 'returns';
    if(label.startsWith('VER EXPEDIENTES'))return 'custody';

    return '';
  }

  function canonical(name){
    try{
      if(typeof canonicalOwnerNameV392==='function'){
        return canonicalOwnerNameV392(name);
      }
    }catch(_){}

    return clean(name);
  }

  async function openOwnerV392(rawName,action='custody',card=null){
    const nombre=canonical(rawName);
    if(!nombre || opening)return;

    opening=true;
    card?.classList.add('v392-opening');

    try{
      // Revalidar el nombre contra todas las fuentes que forman las tarjetas.
      if(
        typeof ownerNameIsSelectableV392==='function' &&
        !ownerNameIsSelectableV392(nombre)
      ){
        throw new Error(`El usuario ${nombre} aparece en la tarjeta, pero no está disponible para consulta.`);
      }

      const filter=[
        'custody',
        'pending_attention',
        'loan',
        'reassigned',
        'pending',
        'returns'
      ].includes(action)
        ?action
        :'custody';

      // Limpiar búsqueda para que un filtro anterior no deje la tabla vacía.
      const search=document.getElementById('searchInput');
      if(search)search.value='';

      if(typeof selectedIds!=='undefined' && selectedIds?.clear){
        selectedIds.clear();
      }

      if(typeof updateSelectionUI==='function'){
        updateSelectionUI();
      }

      /*
        Se usa setOwner directamente como ruta única.
        Así TODAS las tarjetas pasan por la misma validación y no dependen
        de handlers inline de versiones anteriores.
      */
      if(typeof window.setOwner!=='function'){
        throw new Error('No está disponible la función para abrir expedientes por usuario.');
      }

      await window.setOwner(nombre,filter);

      // Sincronizar explícitamente el filtro solicitado.
      if(typeof panelQuickFilter!=='undefined'){
        panelQuickFilter=filter;
      }

      const stateFilter=document.getElementById('ownerStateFilter');
      if(stateFilter){
        stateFilter.value=filter;
      }

      if(typeof updateKpiQuickUI==='function'){
        updateKpiQuickUI();
      }

      // Verificación final: la vista individual debe haberse activado.
      if(
        typeof selectedOwner!=='undefined' &&
        norm(String(selectedOwner||''))!==norm(nombre)
      ){
        selectedOwner=nombre;
      }

      if(typeof updateOwnerPanelVisibility==='function'){
        updateOwnerPanelVisibility();
      }

      // Si el panel no se cargó por una condición transitoria, forzar una vez.
      const detail=document.getElementById('panelDetailWrap');
      const table=document.getElementById('panelTable');

      if(
        detail &&
        !detail.classList.contains('hidden') &&
        table &&
        !clean(table.textContent)
      ){
        if(typeof loadPanel==='function'){
          await loadPanel({
            forceFresh:true,
            refreshCards:false
          });
        }
      }

      // Colocar la vista en el inicio de filtros/detalle sin animación.
      document.getElementById('ownerDetailFilters')?.scrollIntoView({
        behavior:'auto',
        block:'start'
      });

      try{
        window.scheduleStableLayoutV389?.(0);
        window.scheduleStableStatesMasterV390?.(0);
      }catch(_){}

    }catch(error){
      console.error('V392 · abrir tarjeta de usuario:',error);

      const message=error?.message||String(error);

      if(typeof showToast==='function'){
        showToast(message);
      }else if(typeof toast==='function'){
        toast(message);
      }else{
        alert(message);
      }
    }finally{
      opening=false;
      card?.classList.remove('v392-opening');
    }
  }

  function handleCardClick(event){
    const grid=event.target?.closest?.('#ownerCardsGrid');
    if(!grid)return;

    const card=event.target.closest('.owner-user-card');
    if(!card)return;

    const nombre=clean(card.dataset.ownerName);
    if(!nombre)return;

    const button=event.target.closest('button');
    const action=button
      ?actionFromButton(button)
      :'custody';

    /*
      Captura central:
      evita que onclick inline y onclick de la tarjeta se ejecuten dos veces.
    */
    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();

    openOwnerV392(nombre,action||'custody',card);
  }

  function handleCardKey(event){
    if(event.key!=='Enter' && event.key!==' ')return;

    const card=event.target?.closest?.(
      '#ownerCardsGrid .owner-user-card'
    );

    if(!card)return;

    // Los botones ya procesan teclado mediante click.
    if(event.target.closest('button'))return;

    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();

    openOwnerV392(
      clean(card.dataset.ownerName),
      'custody',
      card
    );
  }

  function auditCards(){
    const cards=[
      ...document.querySelectorAll(
        '#ownerCardsGrid .owner-user-card'
      )
    ];

    cards.forEach(card=>{
      const nombre=clean(card.dataset.ownerName);

      card.dataset.v392Ready=nombre?'1':'0';

      card.querySelectorAll('button').forEach(button=>{
        button.type='button';

        if(!button.dataset.ownerAction){
          const inferred=actionFromButton(button);
          if(inferred){
            button.dataset.ownerAction=inferred;
          }
        }
      });
    });

    return cards.length;
  }

  function install(){
    const grid=document.getElementById('ownerCardsGrid');
    if(!grid)return;

    /*
      CAPTURE=true: V392 recibe el evento antes que los onclick inline
      de cada tarjeta/botón.
    */
    grid.addEventListener(
      'click',
      handleCardClick,
      true
    );

    grid.addEventListener(
      'keydown',
      handleCardKey,
      true
    );

    auditCards();

    if('MutationObserver' in window){
      const observer=new MutationObserver(()=>{
        auditCards();
      });

      observer.observe(grid,{
        childList:true,
        subtree:true
      });

      window.__v392OwnerCardsObserver=observer;
    }
  }

  window.openOwnerV392=openOwnerV392;
  window.auditOwnerCardsV392=auditCards;

  if(document.readyState==='loading'){
    document.addEventListener(
      'DOMContentLoaded',
      install,
      {once:true}
    );
  }else{
    install();
  }
})();
</script>
<script id="v393-user-search-controller">
(function(){
  'use strict';

  let running=false;

  function E(id){
    return document.getElementById(id);
  }

  function input(){
    return E('searchInput');
  }

  function normalizeValue(value){
    return String(value??'')
      .trim()
      .replace(/\s+/g,'')
      .replace(/[–—]/g,'-');
  }

  function valid(value){
    return /^\d+-\d{4}$/.test(
      normalizeValue(value)
    );
  }

  function isUserProfile(){
    try{
      return typeof isLimitedUser==='function' && isLimitedUser();
    }catch(_){
      return false;
    }
  }

  function ensureStatus(){
    const inp=input();
    const row=inp?.closest('.v230-inline-search');
    if(!row)return null;

    let status=row.querySelector('.v393-user-search-status');

    if(!status){
      status=document.createElement('div');
      status.className='v393-user-search-status';
      status.setAttribute('aria-live','polite');
      row.appendChild(status);
    }

    return status;
  }

  function setStatus(message='',type=''){
    const status=ensureStatus();
    if(!status)return;

    status.textContent=message;
    status.className=
      `v393-user-search-status ${type}`.trim();
  }

  function preserveCaret(callback){
    const inp=input();
    if(!inp)return callback();

    const focused=document.activeElement===inp;
    const start=inp.selectionStart;
    const end=inp.selectionEnd;
    const value=inp.value;

    const result=callback();

    if(focused){
      requestAnimationFrame(()=>{
        if(!inp.isConnected)return;

        inp.value=value;
        inp.focus({preventScroll:true});

        try{
          inp.setSelectionRange(
            start??value.length,
            end??value.length
          );
        }catch(_){}
      });
    }

    return result;
  }

  window.v393PersonalSearchInput=function(event){
    const inp=event?.target||input();
    if(!inp)return;

    // Normalizar solo guiones especiales; no reconstruir panel.
    const caret=inp.selectionStart;
    const before=inp.value;
    const after=String(before).replace(/[–—]/g,'-');

    if(before!==after){
      inp.value=after;
      try{inp.setSelectionRange(caret,caret)}catch(_){}
    }

    inp.classList.remove('v258-search-invalid');

    if(!isUserProfile()){
      // ADMIN/ARCHIVO en detalle de usuario conserva debounce histórico.
      if(typeof debouncePanel==='function'){
        debouncePanel();
      }
      return;
    }

    const q=normalizeValue(inp.value);

    if(!q){
      setStatus('');
      return;
    }

    if(valid(q)){
      setStatus(
        'Listo para buscar. Presione Buscar o Enter.',
        'ready'
      );
    }else{
      setStatus(
        'Complete el expediente con N.° y año. Ej.: 0045-2020.',
        ''
      );
    }
  };

  window.v393PersonalSearchKeydown=function(event){
    if(event.key!=='Enter')return;

    event.preventDefault();
    event.stopPropagation();

    window.v393RunPersonalSearch();
  };

  window.v393RunPersonalSearch=async function(){
    const inp=input();
    if(!inp || running)return;

    const q=normalizeValue(inp.value);

    if(!q){
      inp.focus({preventScroll:true});
      setStatus(
        'Ingrese un N.° de expediente. Ej.: 0045-2020.',
        'error'
      );
      return;
    }

    if(!valid(q)){
      inp.classList.add('v258-search-invalid');
      inp.focus({preventScroll:true});

      setStatus(
        'Formato requerido: número-año. Ej.: 0045-2020.',
        'error'
      );

      return;
    }

    inp.value=q;
    inp.classList.remove('v258-search-invalid');

    running=true;
    setStatus('Buscando expediente…','searching');

    try{
      /*
        Para USUARIO, runPersonalScopeSearchV230 termina en
        searchAllUserActivitiesV184(), que consulta únicamente sus
        propios movimientos y devuelve el último estado.
      */
      if(typeof runPersonalScopeSearchV230!=='function'){
        throw new Error(
          'La función de búsqueda del perfil usuario no está disponible.'
        );
      }

      await runPersonalScopeSearchV230();

      const count=Number(
        String(E('pageInfo')?.textContent||'')
          .match(/de\s+(\d+)/i)?.[1]||0
      );

      setStatus(
        count
          ?`Búsqueda terminada: ${count} coincidencia${count===1?'':'s'}.`
          :'Búsqueda terminada.',
        'ready'
      );

    }catch(error){
      console.error(
        'V393 · búsqueda usuario:',
        error
      );

      setStatus(
        error?.message||'No se pudo realizar la búsqueda.',
        'error'
      );

      if(typeof showToast==='function'){
        showToast(
          error?.message||'No se pudo realizar la búsqueda.'
        );
      }

    }finally{
      running=false;

      // Mantener el foco para poder corregir o hacer otra búsqueda.
      requestAnimationFrame(()=>{
        if(!inp.isConnected)return;

        inp.focus({preventScroll:true});

        try{
          const end=inp.value.length;
          inp.setSelectionRange(end,end);
        }catch(_){}
      });
    }
  };

  window.v393ClearPersonalSearch=async function(){
    const inp=input();
    if(!inp || running)return;

    running=true;

    try{
      inp.value='';
      inp.classList.remove('v258-search-invalid');
      setStatus('');

      /*
        No usar el onclick antiguo directamente: se restaura la vista
        personal sin que el campo sea movido mientras está enfocado.
      */
      if(typeof clearPersonalScopeSearchV230==='function'){
        await clearPersonalScopeSearchV230();
      }

    }catch(error){
      console.error(
        'V393 · limpiar búsqueda usuario:',
        error
      );
    }finally{
      running=false;

      requestAnimationFrame(()=>{
        inp.focus({preventScroll:true});
      });
    }
  };

  function stabilize(){
    const inp=input();
    if(!inp)return;

    inp.removeAttribute('disabled');
    inp.removeAttribute('readonly');
    inp.setAttribute('autocomplete','off');

    const field=inp.closest('.field');
    if(field){
      field.style.pointerEvents='auto';
    }

    ensureStatus();
  }

  if(document.readyState==='loading'){
    document.addEventListener(
      'DOMContentLoaded',
      ()=>{
        stabilize();
        setTimeout(stabilize,300);
        setTimeout(stabilize,900);
      },
      {once:true}
    );
  }else{
    stabilize();
  }

  window.addEventListener(
    'load',
    stabilize,
    {once:true}
  );

  /*
    Si cambia perfil o vista, verificar una vez; NO mover el input
    mientras el usuario interactúa con él.
  */
  document.addEventListener('click',event=>{
    if(event.target?.closest?.(
      '#searchInput,.v349-toolbar-search'
    )){
      return;
    }

    setTimeout(stabilize,0);
  },true);

  window.stabilizeUserSearchV393=stabilize;
})();
</script>
<script id="v394-live-user-search-controller">
(function(){
  'use strict';

  const COMPLETE_RE=/^\d+-\d{4}$/;
  const DEBOUNCE_MS=90;

  let timer=0;
  let running=false;
  let lastRequestedKey='';
  let searchToken=0;

  function E(id){
    return document.getElementById(id);
  }

  function inp(){
    return E('searchInput');
  }

  function clean(value){
    return String(value??'')
      .trim()
      .replace(/\s+/g,'')
      .replace(/[–—]/g,'-');
  }

  /*
    Clave lógica SIN ceros iniciales.
    45-2020, 045-2020 y 0045-2020 => 45-2020.
  */
  function logicalKey(value){
    const q=clean(value);
    if(!COMPLETE_RE.test(q))return '';

    const [raw,year]=q.split('-');
    const num=String(Number(raw));

    if(!/^\d+$/.test(num))return '';

    return `${num}-${year}`;
  }

  function isLimited(){
    try{
      return typeof isLimitedUser==='function' && isLimitedUser();
    }catch(_){
      return false;
    }
  }

  function statusNode(){
    const input=inp();
    const row=input?.closest('.v230-inline-search');
    if(!row)return null;

    let status=row.querySelector('.v394-live-search-status');

    if(!status){
      status=document.createElement('div');
      status.className='v394-live-search-status';
      status.setAttribute('aria-live','polite');
      row.appendChild(status);
    }

    return status;
  }

  function status(text='',type=''){
    const node=statusNode();
    if(!node)return;

    node.textContent=text;
    node.className=
      `v394-live-search-status ${type}`.trim();
  }

  /*
    Colocar el buscador UNA SOLA VEZ.
    Después se añade v394-search-locked y ninguna versión anterior
    vuelve a mover el elemento.
  */
  function lockToolbar(){
    const body=document.body;
    const input=inp();
    const field=input?.closest('.field');
    const actions=document.querySelector(
      '.main-sticky-header .actions'
    );
    const newRequest=E('searchRequestBtn');

    if(
      !body ||
      !input ||
      !field ||
      !actions ||
      !body.classList.contains('produce-user')
    ){
      return false;
    }

    body.classList.add(
      'v349-personal-compact-panel'
    );

    field.classList.add(
      'v349-toolbar-search'
    );

    /*
      Solo si todavía no está en el toolbar.
      Este es el ÚNICO reparentado permitido por V394.
    */
    if(field.parentNode!==actions){
      if(newRequest?.parentNode===actions){
        newRequest.after(field);
      }else{
        actions.appendChild(field);
      }
    }

    input.placeholder=
      'Buscar por N.° de expediente · Ej.: 45-2020';

    input.setAttribute(
      'aria-label',
      'Buscar expediente; no es necesario escribir ceros iniciales'
    );

    input.setAttribute(
      'autocomplete',
      'off'
    );

    input.removeAttribute('readonly');
    input.removeAttribute('disabled');

    /*
      Bloquear DESPUÉS de colocarlo.
      V349/V350/V351 detectan esta clase y dejan de mover el nodo.
    */
    body.classList.add(
      'v394-search-locked'
    );

    statusNode();

    return true;
  }

  function keepFocus(position=null){
    const input=inp();
    if(!input?.isConnected)return;

    requestAnimationFrame(()=>{
      input.focus({preventScroll:true});

      try{
        const p=position==null
          ?input.value.length
          :Math.min(position,input.value.length);

        input.setSelectionRange(p,p);
      }catch(_){}
    });
  }

  async function executeLiveSearch({
    force=false,
    preservePosition=null
  }={}){
    const input=inp();

    if(!input || running)return;

    const typed=clean(input.value);
    const key=logicalKey(typed);

    if(!key){
      if(force){
        input.classList.add(
          'v258-search-invalid'
        );

        status(
          'Escriba número-año. Ej.: 45-2020 o 0045-2020.',
          'error'
        );

        keepFocus(
          preservePosition
        );
      }
      return;
    }

    /*
      Si la misma búsqueda ya fue ejecutada automáticamente,
      no volver a consultar cada vez que se agrega/quita un cero inicial.
    */
    if(!force && key===lastRequestedKey){
      status(
        `Expediente detectado: ${key}`,
        'ready'
      );
      return;
    }

    running=true;
    const myToken=++searchToken;
    lastRequestedKey=key;

    input.classList.remove(
      'v258-search-invalid'
    );

    status(
      `Detectando ${key}…`,
      'searching'
    );

    const caret=
      preservePosition ??
      input.selectionStart ??
      input.value.length;

    try{
      /*
        Se conserva lo escrito por el usuario.
        No se obliga a mostrar 0045 si escribió 45.
        Las capas V258/V259 comparan numéricamente y canonicalizan
        para la consulta a Supabase.
      */
      input.value=typed;

      if(
        typeof runPersonalScopeSearchV230!=='function'
      ){
        throw new Error(
          'La búsqueda del perfil usuario no está disponible.'
        );
      }

      if(typeof window.v395FastUserSearch!=='function'){
        throw new Error('El buscador rápido V395 no está disponible.');
      }

      await window.v395FastUserSearch(
        typed,
        key,
        myToken
      );

      if(myToken!==searchToken)return;

      status(
        `Expediente ${key} detectado.`,
        'ready'
      );

    }catch(error){
      if(myToken!==searchToken)return;

      console.error(
        'V394 · búsqueda en vivo:',
        error
      );

      status(
        error?.message ||
        'No se pudo realizar la búsqueda.',
        'error'
      );

    }finally{
      if(myToken===searchToken){
        running=false;

        /*
          runPersonalScopeSearch puede volver a pintar la tabla,
          pero el input ya NO cambia de padre.
        */
        keepFocus(caret);
      }
    }
  }

  function scheduleLive(caret){
    clearTimeout(timer);

    const input=inp();
    if(!input)return;

    const typed=clean(input.value);
    const key=logicalKey(typed);

    if(!typed){
      lastRequestedKey='';
      status('');
      return;
    }

    if(!key){
      status(
        'Escribiendo… complete número-año.',
        'detecting'
      );
      return;
    }

    status(
      `Número detectado: ${key}`,
      'detecting'
    );

    timer=setTimeout(()=>{
      executeLiveSearch({
        preservePosition:caret
      });
    },DEBOUNCE_MS);
  }

  window.v394PersonalSearchInput=function(event){
    const input=event?.target||inp();
    if(!input)return;

    lockToolbar();

    /*
      Solo sustituir guiones tipográficos.
      NO modificar ceros, NO mover el cursor.
    */
    const caret=
      input.selectionStart ??
      input.value.length;

    const before=input.value;
    const after=String(before)
      .replace(/[–—]/g,'-');

    if(before!==after){
      input.value=after;

      try{
        input.setSelectionRange(
          caret,
          caret
        );
      }catch(_){}
    }

    input.classList.remove(
      'v258-search-invalid'
    );

    if(!isLimited()){
      /*
        Para ADMIN/ARCHIVO/COORDINADOR se conserva la lógica
        existente de su ámbito.
      */
      if(typeof debouncePanel==='function'){
        debouncePanel();
      }
      return;
    }

    scheduleLive(caret);
  };

  window.v394PersonalSearchKeydown=function(event){
    if(event.key!=='Enter')return;

    event.preventDefault();
    event.stopPropagation();

    clearTimeout(timer);

    executeLiveSearch({
      force:true,
      preservePosition:
        event.target?.selectionStart ??
        null
    });
  };

  window.v394RunPersonalSearch=function(){
    clearTimeout(timer);

    return executeLiveSearch({
      force:true,
      preservePosition:
        inp()?.selectionStart ??
        null
    });
  };

  window.v394ClearPersonalSearch=async function(){
    clearTimeout(timer);
    searchToken++;
    running=false;
    lastRequestedKey='';

    const input=inp();
    if(!input)return;

    input.value='';
    input.classList.remove(
      'v258-search-invalid'
    );
    status('');

    try{
      if(
        typeof clearPersonalScopeSearchV230==='function'
      ){
        await clearPersonalScopeSearchV230();
      }
    }catch(error){
      console.warn(
        'V394 · limpiar búsqueda:',
        error
      );
    }

    keepFocus(0);
  };

  /*
    Protección adicional:
    mientras el input tiene foco, ninguna rutina V349/V350/V351
    necesita hacer un nuevo layout.
  */
  function onFocus(){
    lockToolbar();
    document.body.classList.add(
      'v394-search-editing'
    );
  }

  function onBlur(){
    document.body.classList.remove(
      'v394-search-editing'
    );
  }

  function install(){
    if(!lockToolbar()){
      setTimeout(install,100);
      return;
    }

    const input=inp();

    input.addEventListener(
      'focus',
      onFocus
    );

    input.addEventListener(
      'blur',
      onBlur
    );

    /*
      No alterar input.value durante la instalación.
      El usuario puede empezar a escribir inmediatamente con un solo clic.
    */
  }

  if(document.readyState==='loading'){
    document.addEventListener(
      'DOMContentLoaded',
      install,
      {once:true}
    );
  }else{
    install();
  }

  window.addEventListener(
    'load',
    ()=>{
      lockToolbar();
    },
    {once:true}
  );

  window.lockPersonalSearchV394=lockToolbar;
})();
</script>
<script id="v395-fast-user-search-engine">
(function(){
  'use strict';

  const CACHE_TTL=120000;
  const exactCache=new Map();
  const localIndex=new Map();

  let preloadFlight=null;
  let activeRequest=0;

  function clean(value){
    return String(value??'')
      .trim()
      .replace(/\s+/g,'')
      .replace(/[–—]/g,'-');
  }

  function logicalKey(value){
    const q=clean(value);
    const m=q.match(/^(\d+)-(\d{4})$/);
    if(!m)return '';

    return `${Number(m[1])}-${m[2]}`;
  }

  function rowExp(row){
    const r=row||{};

    try{
      if(typeof coordinatorExpNumberV216==='function'){
        const value=coordinatorExpNumberV216(r);
        if(value)return String(value).trim();
      }
    }catch(_){}

    return String(
      r.expediente||
      r.numero_expediente||
      r.nro_expediente||
      r.expediente_numero||
      r.n_expediente||
      r.codigo_expediente||
      ''
    ).trim();
  }

  function rowsExact(rows,key){
    if(!key)return [];

    return (Array.isArray(rows)?rows:[]).filter(row=>
      logicalKey(rowExp(row))===key
    );
  }

  function currentProfileLabel(){
    return currentProfile?.nombre_personal||
      'Mi espacio personal';
  }

  function renderResult(rows,{
    preliminary=false,
    key=''
  }={}){
    const list=Array.isArray(rows)?rows:[];

    page=0;
    panelCount=list.length;
    panelRows=list.slice(
      0,
      typeof PAGE_SIZE==='number'
        ?PAGE_SIZE
        :20
    );

    document.querySelectorAll(
      '#userPersonalKpis .kpi'
    ).forEach(card=>
      card.classList.remove('quick-active')
    );

    if(el('panelTitle')){
      el('panelTitle').innerHTML=
        `Resultado de búsqueda · último estado del expediente · `+
        `${esc(currentProfileLabel())}`+
        (
          preliminary
            ?'<span class="v395-fast-loading">resultado rápido</span>'
            :'<span class="v395-fast-hit">actualizado</span>'
        );
    }

    if(el('pageInfo')){
      el('pageInfo').textContent=
        list.length
          ?`1 - ${Math.min(panelRows.length,list.length)} de ${list.length} coincidencia${list.length===1?'':'s'}`
          :'0 coincidencias';
    }

    if(el('panelTable')){
      if(!list.length){
        el('panelTable').innerHTML=`
          <div class="empty">
            No se encontró el expediente <b>${esc(key||'')}</b>
            en sus movimientos.
          </div>`;
      }else if(
        !preliminary &&
        typeof renderUserGlobalSearchV184==='function'
      ){
        el('panelTable').innerHTML=
          renderUserGlobalSearchV184(panelRows);
      }else{
        /*
          Primera pintura rápida:
          usar la tabla estándar porque los datos de la precarga todavía
          no tienen todos los enriquecimientos del historial.
        */
        el('panelTable').innerHTML=
          typeof recordTable==='function'
            ?recordTable(panelRows,false,'panel')
            :`<div class="empty">Expediente detectado.</div>`;
      }
    }

    try{
      window.scheduleStableLayoutV389?.(0);
    }catch(_){}
  }

  function cacheGet(key){
    const item=exactCache.get(key);

    if(
      !item ||
      Date.now()-item.savedAt>CACHE_TTL
    ){
      if(item)exactCache.delete(key);
      return null;
    }

    return Array.isArray(item.rows)
      ?item.rows.map(row=>({...row}))
      :[];
  }

  function cacheSet(key,rows){
    exactCache.set(key,{
      savedAt:Date.now(),
      rows:(rows||[]).map(row=>({...row}))
    });
  }

  function addToLocalIndex(rows){
    (rows||[]).forEach(row=>{
      const key=logicalKey(rowExp(row));
      if(!key)return;

      if(!localIndex.has(key)){
        localIndex.set(key,[]);
      }

      const arr=localIndex.get(key);

      const id=String(
        row.expediente_id||
        row.id||
        `${rowExp(row)}|${row.extension||''}|${row.categoria_usuario||''}`
      );

      if(!arr.some(x=>
        String(
          x.expediente_id||
          x.id||
          `${rowExp(x)}|${x.extension||''}|${x.categoria_usuario||''}`
        )===id
      )){
        arr.push({...row});
      }
    });
  }

  async function preload(){
    if(preloadFlight)return preloadFlight;

    preloadFlight=(async()=>{
      try{
        if(
          typeof isLimitedUser==='function' &&
          !isLimitedUser()
        ){
          return;
        }

        if(
          typeof isCoordinatorSelfWorkspaceV206==='function' &&
          isCoordinatorSelfWorkspaceV206()
        ){
          return;
        }

        if(typeof loadAllMyExpedientes!=='function'){
          return;
        }

        const rows=await loadAllMyExpedientes('');
        addToLocalIndex(rows||[]);

      }catch(error){
        console.warn(
          'V395 · precarga de índice:',
          error?.message||error
        );
      }
    })();

    try{
      await preloadFlight;
    }finally{
      preloadFlight=null;
    }
  }

  async function fullExactSearch(typed,key,requestId){
    /*
      searchAllUserActivitiesV184 ya consulta actividades en paralelo.
      V395 la llama DIRECTAMENTE, evitando:
      - invalidar todo el panel,
      - refrescar tarjetas,
      - loadPanel completo.
    */
    const rows=await searchAllUserActivitiesV184(typed);

    if(requestId!==activeRequest){
      return rows;
    }

    const exact=rowsExact(rows,key);

    cacheSet(key,exact);
    addToLocalIndex(exact);

    renderResult(exact,{
      preliminary:false,
      key
    });

    return exact;
  }

  async function fastSearch(typed,keyFromCaller){
    const key=keyFromCaller||logicalKey(typed);
    if(!key)return [];

    const requestId=++activeRequest;

    // 1. Cache exacto: prácticamente instantáneo.
    const cached=cacheGet(key);

    if(cached){
      renderResult(cached,{
        preliminary:false,
        key
      });

      return cached;
    }

    // 2. Índice local de la sesión.
    const local=localIndex.get(key);

    if(local?.length){
      renderResult(local,{
        preliminary:true,
        key
      });
    }else{
      /*
        Aprovechar también filas que ya estén en memoria por la tarjeta
        que el usuario estaba viendo.
      */
      const memory=rowsExact(
        [
          ...(Array.isArray(panelRows)?panelRows:[]),
          ...(Array.isArray(window.ownerCardsRows)?window.ownerCardsRows:[])
        ],
        key
      );

      if(memory.length){
        renderResult(memory,{
          preliminary:true,
          key
        });
      }
    }

    // 3. Consulta completa directa.
    const promise=fullExactSearch(
      typed,
      key,
      requestId
    );

    /*
      Si la precarga aún no terminó, dejarla trabajando en paralelo.
      No bloquea la búsqueda actual.
    */
    preload().catch(()=>{});

    return promise;
  }

  function invalidateKey(value){
    const key=logicalKey(value);
    if(key)exactCache.delete(key);
  }

  function install(){
    /*
      Precargar poco después de que la vista inicial terminó de abrir.
      El usuario suele tener pocas decenas de expedientes; cuatro RPC
      en paralelo dejan un índice útil para las búsquedas siguientes.
    */
    setTimeout(()=>{
      preload().catch(()=>{});
    },350);

    /*
      Las filas visibles al iniciar sirven como índice inmediato,
      incluso antes de terminar la precarga.
    */
    try{
      addToLocalIndex(
        Array.isArray(panelRows)
          ?panelRows
          :[]
      );
    }catch(_){}
  }

  window.v395LogicalKey=logicalKey;
  window.v395FastUserSearch=fastSearch;
  window.v395PreloadUserIndex=preload;
  window.v395InvalidateSearchKey=invalidateKey;

  if(document.readyState==='loading'){
    document.addEventListener(
      'DOMContentLoaded',
      install,
      {once:true}
    );
  }else{
    install();
  }
})();
</script>
<script id="v396-coordinator-new-request-controller">
(function(){
  'use strict';

  let opening=false;

  window.openCoordinatorNewRequestV396=async function(){
    if(opening)return;

    try{
      if(
        typeof isCoordinator!=='function' ||
        !isCoordinator()
      ){
        if(typeof openNewRequestModal==='function'){
          return openNewRequestModal();
        }
        return;
      }

      opening=true;

      /*
        Si el coordinador estaba revisando "Personal de mi área",
        regresar primero a SELF. Así Nueva solicitud siempre pertenece
        al propio coordinador y no habilita selección de terceros.
      */
      if(
        typeof isCoordinatorTeamWorkspaceV206==='function' &&
        isCoordinatorTeamWorkspaceV206()
      ){
        await setCoordinatorWorkspaceV206('SELF','panel');
      }

      /*
        En SELF, isLimitedUser() es true para el COORDINADOR.
        openNewRequestModal completa automáticamente rqSolicitante
        con currentProfile.nombre_personal.
      */
      if(typeof openNewRequestModal!=='function'){
        throw new Error('No está disponible el formulario Nueva solicitud.');
      }

      await openNewRequestModal();

    }catch(error){
      console.error(
        'V396 · Nueva solicitud coordinador:',
        error
      );

      const message=
        error?.message||
        'No se pudo abrir Nueva solicitud.';

      if(typeof showToast==='function'){
        showToast(message);
      }else{
        alert(message);
      }

    }finally{
      opening=false;
    }
  };

  function syncCoordinatorNewRequestV396(){
    const coordinator=
      typeof isCoordinator==='function' &&
      isCoordinator();

    const top=document.getElementById(
      'coordinatorNewRequestBtnV396'
    );

    if(top){
      top.classList.toggle(
        'hidden-by-role',
        !coordinator
      );

      top.hidden=!coordinator;
      top.style.setProperty(
        'display',
        coordinator?'inline-flex':'none',
        'important'
      );
    }

    const side=document.getElementById(
      'produceSideNewRequest'
    );

    if(side && coordinator){
      side.hidden=false;
      side.disabled=false;
      side.onclick=()=>{
        window.openCoordinatorNewRequestV396();
      };
    }
  }

  function install(){
    syncCoordinatorNewRequestV396();

    setTimeout(
      syncCoordinatorNewRequestV396,
      150
    );

    setTimeout(
      syncCoordinatorNewRequestV396,
      600
    );

    setTimeout(
      syncCoordinatorNewRequestV396,
      1500
    );
  }

  if(document.readyState==='loading'){
    document.addEventListener(
      'DOMContentLoaded',
      install,
      {once:true}
    );
  }else{
    install();
  }

  window.addEventListener(
    'load',
    syncCoordinatorNewRequestV396,
    {once:true}
  );

  document.addEventListener(
    'click',
    event=>{
      if(
        event.target?.closest?.(
          '.staff-personal-nav-v319,'+
          '.coordinator-team-nav-v206,'+
          '.side-item,.tab'
        )
      ){
        setTimeout(
          syncCoordinatorNewRequestV396,
          0
        );
      }
    },
    true
  );

  window.syncCoordinatorNewRequestV396=
    syncCoordinatorNewRequestV396;
})();
</script>
<script id="v403-coordinator-request-placement">
(function(){
  'use strict';

  function isCoordinatorProfileV403(){
    try{
      return typeof isCoordinator==='function' && isCoordinator();
    }catch(_){
      return false;
    }
  }

  function isSelfV403(){
    if(!isCoordinatorProfileV403())return false;

    try{
      if(typeof isCoordinatorSelfWorkspaceV206==='function'){
        return isCoordinatorSelfWorkspaceV206();
      }
    }catch(_){}

    return true;
  }

  function activeTabV403(){
    try{
      return typeof currentVisibleTabName==='function'
        ?currentVisibleTabName()
        :'';
    }catch(_){
      return '';
    }
  }

  function syncV403(){
    const coordinator=isCoordinatorProfileV403();
    const selfMode=isSelfV403();
    const active=activeTabV403();

    const top=document.getElementById('coordinatorNewRequestBtnV396');
    const side=document.getElementById('produceSideNewRequest');
    const requestBtn=document.getElementById('requestNewRequestBtn');

    if(top){
      top.hidden=true;
      top.style.setProperty('display','none','important');
    }

    if(side){
      side.hidden=true;
      side.style.setProperty('display','none','important');
    }

    if(requestBtn){
      const show=
        coordinator &&
        selfMode &&
        active==='requests';

      requestBtn.hidden=!show;
      requestBtn.style.setProperty(
        'display',
        show?'inline-flex':'none',
        'important'
      );

      requestBtn.onclick=()=>{
        if(typeof openCoordinatorNewRequestV396==='function'){
          openCoordinatorNewRequestV396();
        }else if(typeof openNewRequestModal==='function'){
          openNewRequestModal();
        }
      };

      requestBtn.textContent='+ Nueva solicitud';
      requestBtn.title='Registrar una nueva solicitud personal';
    }
  }

  function install(){
    syncV403();

    setTimeout(syncV403,120);
    setTimeout(syncV403,500);

    document.addEventListener('click',event=>{
      if(event.target?.closest?.(
        '.produce-nav,.side-item,.tab,'+
        '#staffMySolicitudesV319,'+
        '#coordinatorTeamRequestsBtnV206'
      )){
        setTimeout(syncV403,0);
        setTimeout(syncV403,100);
      }
    },true);
  }

  window.syncCoordinatorRequestPlacementV403=syncV403;

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',install,{once:true});
  }else{
    install();
  }

  window.addEventListener('load',syncV403,{once:true});
})();
</script>
<script id="v404-coordinator-team-tracking-controller">
(function(){
  'use strict';

  let lastOwner='';

  function sync(){
    if(
      typeof isCoordinatorTeamWorkspaceV206!=='function' ||
      !isCoordinatorTeamWorkspaceV206()
    ){
      lastOwner='';
      return;
    }

    const current=String(
      typeof selectedOwner!=='undefined'
        ?selectedOwner
        :''
    ).trim();

    if(
      current &&
      current!==lastOwner &&
      typeof invalidateCoordinatorPendingCacheV310==='function'
    ){
      invalidateCoordinatorPendingCacheV310(current);
    }

    lastOwner=current;
  }

  document.addEventListener('click',event=>{
    if(event.target?.closest?.(
      '#ownerCardsGrid .owner-user-card,'+
      '#ownerCardsGrid button,'+
      '#ownerStateFilter'
    )){
      setTimeout(sync,0);
    }
  },true);

  window.syncCoordinatorTeamTrackingV404=sync;
})();
</script>
<script id="v407-team-source-consistency">
(function(){
  'use strict';

  window.v407TeamSourceInfo=function(){
    return {
      source:'listar_tarjeta_usuario_admin_v5',
      securedBy:'v409_coordinador_tarjeta_equipo',
      teamValidation:'v211_listar_mi_equipo'
    };
  };
})();
</script>
<script id="v411-admin-parity-info">
(function(){
  'use strict';

  window.v411CoordinatorParityInfo=function(){
    return {
      summary:'resumen_tarjetas_usuario_admin_v5',
      detail:'listar_tarjeta_usuario_admin_v5',
      secureSummary:'v409_coordinador_resumen_equipo',
      secureDetail:'v409_coordinador_tarjeta_equipo',
      authorization:'v211_listar_mi_equipo',
      consistencyFallback:'V411 · CUSTODIA + clasificador V406 -> PRESTAMO / REASIGNADOS_A_MI'
    };
  };
})();
</script>
<script id="v412-coordinator-real-detail">
(function(){
  'use strict';

  // ==========================================================
  // V412 · FUENTE REAL PARA EL COORDINADOR
  //
  // Corrige dos síntomas observados en V411:
  //   A) Mis expedientes: los contadores del Coordinador tenían valor,
  //      pero el detalle quedaba vacío (incluidos Devueltos al Archivo).
  //   B) Personal de mi área: el resumen del integrante reconocía custodia,
  //      préstamos o reasignados, pero la tabla podía devolver 0 filas.
  //
  // La solución ya no intenta inferir el detalle únicamente desde V409.
  // Para custodia y devoluciones usa la RPC segura V412, que valida el
  // equipo en PostgreSQL y reconstruye el detalle desde las tablas reales.
  // ==========================================================

  const originalTeamRowsV412=window.coordinatorTeamRowsV218;
  const originalSelfRowsV412=window.coordinatorSelfCardRowsV207;

  function v412Type(type){
    const raw=String(type||'').toUpperCase();
    const map={
      TODOS:'CUSTODIA',
      CUSTODIA:'CUSTODIA',
      PRESTAMO:'PRESTAMO',
      'PRÉSTAMO':'PRESTAMO',
      REASIGNADOS_A_MI:'REASIGNADOS_A_MI',
      DEVOLUCION_SOLICITADA:'DEVOLUCION_SOLICITADA',
      DEVUELTOS:'DEVUELTOS_AL_ARCHIVO',
      DEVUELTOS_AL_ARCHIVO:'DEVUELTOS_AL_ARCHIVO'
    };
    return map[raw]||raw;
  }

  function v412UsesSecureDetail(type){
    return [
      'CUSTODIA',
      'PRESTAMO',
      'REASIGNADOS_A_MI',
      'DEVOLUCION_SOLICITADA',
      'DEVUELTOS_AL_ARCHIVO'
    ].includes(v412Type(type));
  }

  function v412SqlError(error){
    const message=String(error?.message||error?.details||error||'');
    if(/PGRST202|could not find the function|v412_coordinador_detalle_equipo/i.test(message)){
      const err=new Error(
        'Falta instalar la corrección V412 en Supabase. '+
        'Ejecute V412_SQL_COORDINADOR_DETALLE_REAL_EQUIPO.sql y vuelva a abrir la tarjeta.'
      );
      err.code='V412_SQL_REQUIRED';
      err.original=error;
      return err;
    }
    return error instanceof Error?error:new Error(message||'No se pudo consultar el detalle V412.');
  }

  async function coordinatorRowsV412(nombre,type,search=''){
    if(!sb||!session)return [];

    const target=String(nombre||'').trim();
    if(!target)return [];

    const response=await sb.rpc(
      'v412_coordinador_detalle_equipo',
      {
        p_nombre:target,
        p_tipo:v412Type(type),
        p_busqueda:cleanSearch(search||'')||null
      }
    );

    if(response?.error)throw v412SqlError(response.error);

    const rows=typeof v211JsonRows==='function'
      ?v211JsonRows(response?.data)
      :(Array.isArray(response?.data)?response.data:[]);

    return (rows||[]).map(row=>({
      ...row,
      _v412_detail:true
    }));
  }

  // Personal de mi área: la custodia, préstamos, reasignados,
  // solicitudes de devolución y devueltos salen de V412.
  window.coordinatorTeamRowsV218=async function(nombre,type,search=''){
    if(v412UsesSecureDetail(type)){
      return coordinatorRowsV412(nombre,type,search);
    }

    if(typeof originalTeamRowsV412==='function'){
      return originalTeamRowsV412(nombre,type,search);
    }

    return [];
  };

  // Mis expedientes del Coordinador: exactamente la misma fuente segura.
  window.coordinatorSelfCardRowsV207=async function(type,search=''){
    if(
      typeof isCoordinatorSelfWorkspaceV206==='function' &&
      isCoordinatorSelfWorkspaceV206() &&
      v412UsesSecureDetail(type)
    ){
      const nombre=String(currentProfile?.nombre_personal||'').trim();
      return coordinatorRowsV412(nombre,type,search);
    }

    if(typeof originalSelfRowsV412==='function'){
      return originalSelfRowsV412(type,search);
    }

    return [];
  };

  // Forzar una lectura nueva al entrar a las vistas afectadas, evitando
  // snapshots de V409/V411 que pudieran conservar una tabla vacía.
  function invalidateV412View(){
    try{
      if(typeof invalidatePanelViewCacheV179==='function'){
        invalidatePanelViewCacheV179();
      }
    }catch(_){}

    try{
      if(typeof invalidateCoordinatorPendingCacheV310==='function'){
        invalidateCoordinatorPendingCacheV310();
      }
    }catch(_){}
  }

  document.addEventListener('click',event=>{
    if(event.target?.closest?.(
      '#userPersonalKpis .kpi,'+
      '#ownerCardsGrid .owner-user-card,'+
      '#ownerStateFilter,'+
      '.owner-user-options button'
    )){
      invalidateV412View();
    }
  },true);

  window.v412CoordinatorDetailInfo=function(){
    return {
      rpc:'v412_coordinador_detalle_equipo',
      scope:'COORDINADOR PROPIO + PERSONAL AUTORIZADO V211',
      custodySource:'expedientes.responsable + último movimiento',
      historicalReturns:'movimientos_prestamo + solicitud_expedientes'
    };
  };
})();
</script>
<script id="v413-coordinator-team-pending-visible">
(function(){
  'use strict';

  // ==========================================================
  // V413 · PENDIENTES POR ATENDER DEL EQUIPO
  //
  // Síntoma corregido:
  //   Administración/Archivo mostraba, por ejemplo:
  //      MILTON DIAZ      -> 14 pendientes por atender
  //      JOAN VALDIVIESO  ->  2 pendientes por atender
  //   mientras que el perfil COORDINADOR mostraba 0.
  //
  // Causa:
  //   V409 redirigió el conteo del Coordinador a la bandeja administrativa
  //   segura, pero PENDIENTES_POR_ATENDER tiene una fuente inclusiva distinta:
  //   solicitudes listas para Archivo + expedientes que todavía deben retornar
  //   desde otro usuario. Esa lógica ya existe en V310 y replica el perfil
  //   USUARIO por cada integrante autorizado.
  //
  // Solución:
  //   1) tarjeta y detalle usan exactamente loadCoordinatorPendingRowsV310;
  //   2) el número de la tarjeta = cantidad de filas que se abrirán;
  //   3) se fuerza lectura fresca al entrar para no conservar ceros previos.
  // ==========================================================

  const teamRowsBeforeV413=window.coordinatorTeamRowsV218;
  const pendingCountBeforeV413=window.loadCoordinatorPendingCountMapV409;

  function isPendingTypeV413(type){
    const value=String(type||'').toUpperCase();
    return [
      'PENDIENTES_POR_ATENDER',
      'PENDIENTE POR ATENDER',
      'PENDIENTES POR ATENDER'
    ].includes(value);
  }

  async function pendingRowsV413(nombre,search=''){
    if(typeof window.loadCoordinatorPendingRowsV310!=='function'){
      const err=new Error(
        'La fuente segura de pendientes del Coordinador no está disponible. '+
        'Revise que la función V310 se encuentre instalada en Supabase.'
      );
      err.code='V310_SQL_REQUIRED';
      throw err;
    }

    // Evitar que una lectura anterior con cero permanezca en memoria.
    try{
      if(typeof window.invalidateCoordinatorPendingCacheV310==='function'){
        window.invalidateCoordinatorPendingCacheV310(nombre);
      }
    }catch(_){ }

    const rows=await window.loadCoordinatorPendingRowsV310(nombre,search||'');
    return Array.isArray(rows)?rows:[];
  }

  // DETALLE: al pulsar "Por atender", usar la misma fuente inclusiva V310.
  window.coordinatorTeamRowsV218=async function(nombre,type,search=''){
    if(
      typeof window.isCoordinatorTeamWorkspaceV206==='function' &&
      window.isCoordinatorTeamWorkspaceV206() &&
      isPendingTypeV413(type)
    ){
      return pendingRowsV413(nombre,search);
    }

    if(typeof teamRowsBeforeV413==='function'){
      return teamRowsBeforeV413(nombre,type,search);
    }

    return [];
  };

  // CONTADORES: contar exactamente las mismas filas que abrirá el detalle.
  window.loadCoordinatorPendingCountMapV409=async function(names=[]){
    if(
      typeof window.isCoordinatorTeamWorkspaceV206!=='function' ||
      !window.isCoordinatorTeamWorkspaceV206()
    ){
      if(typeof pendingCountBeforeV413==='function'){
        return pendingCountBeforeV413(names);
      }
      return new Map();
    }

    const result=new Map();

    await Promise.all((names||[]).map(async nombre=>{
      try{
        const rows=await pendingRowsV413(nombre,'');
        result.set(nombre,rows.length);
      }catch(error){
        console.warn(
          `V413 · pendientes por atender de ${nombre}:`,
          error?.message||error
        );

        // Respaldo: conservar la lectura anterior si la fuente V310 falla.
        try{
          if(typeof teamRowsBeforeV413==='function'){
            const rows=await teamRowsBeforeV413(
              nombre,
              'PENDIENTES_POR_ATENDER',
              ''
            );
            result.set(nombre,Array.isArray(rows)?rows.length:0);
            return;
          }
        }catch(fallbackError){
          console.warn(
            `V413 · respaldo de pendientes de ${nombre}:`,
            fallbackError?.message||fallbackError
          );
        }

        result.set(nombre,0);
      }
    }));

    return result;
  };

  // Los snapshots V181/V233 pueden contener el cero calculado por V412.
  // Se eliminan una sola vez al cargar V413 para que las tarjetas se reconstruyan.
  try{
    for(let i=sessionStorage.length-1;i>=0;i--){
      const key=sessionStorage.key(i)||'';
      if(key.startsWith('v233_owner_cards_')){
        sessionStorage.removeItem(key);
      }
    }
  }catch(_){ }

  // Al entrar a Personal de mi área, invalidar también la caché corta V310.
  document.addEventListener('click',event=>{
    if(event.target?.closest?.(
      '[data-owner-action="pending_attention"],'+
      '#sideAreas .side-item,'+
      '#ownerCardsGrid .owner-user-card'
    )){
      try{
        if(typeof window.invalidateCoordinatorPendingCacheV310==='function'){
          window.invalidateCoordinatorPendingCacheV310();
        }
      }catch(_){ }
    }
  },true);

  window.v413CoordinatorPendingInfo=function(){
    return {
      countSource:'loadCoordinatorPendingRowsV310',
      detailSource:'loadCoordinatorPendingRowsV310',
      secureRpc:'v310_coordinador_fuentes_pendientes_usuario',
      rule:'contador y detalle usan exactamente la misma colección de expedientes'
    };
  };
})();
</script>
<script id="v414-real-pending-attention-only">
(function(){
  'use strict';

  // ==========================================================
  // V414 · PENDIENTES POR ATENDER = SOLO EXPEDIENTES LISTOS
  //
  // Regla funcional:
  //   "Pendiente por atender" cuenta únicamente expedientes que ya
  //   están disponibles para que Archivo prepare/atienda la solicitud.
  //
  // NO se cuentan aquí los expedientes que todavía permanecen con otro
  // usuario y están "esperando devolución". Esos casos continúan en la
  // trazabilidad, solicitudes y alertas, pero no inflan esta tarjeta.
  //
  // Caso validado visualmente:
  //   JOAN VALDIVIESO = 2 pendientes reales, no 8.
  // ==========================================================

  const myPendingBeforeV414=window.loadMyPendingAttentionRows;
  const teamRowsBeforeV414=window.coordinatorTeamRowsV218;
  const teamPendingCountBeforeV414=window.loadCoordinatorPendingCountMapV409;

  function isPendingTypeV414(type){
    const value=String(type||'').toUpperCase();
    return [
      'PENDIENTES_POR_ATENDER',
      'PENDIENTE POR ATENDER',
      'PENDIENTES POR ATENDER',
      'PENDING_ATTENTION'
    ].includes(value);
  }

  function pendingKeyV414(r){
    return [
      String(r?.solicitud_id||r?.solicitud_numero||''),
      String(r?.expediente_id||r?.id||r?.expediente||'')
    ].join('::');
  }

  async function finishPendingRowsV414(rows,search=''){
    const merged=new Map();

    for(const raw of (Array.isArray(rows)?rows:[])){
      const row={...raw,_v414_pending_source:'LISTO_PARA_ATENDER'};
      const key=pendingKeyV414(row);
      if(!merged.has(key))merged.set(key,row);
    }

    let result=[...merged.values()];
    const q=typeof norm==='function' ? norm(search||'') : String(search||'').trim().toUpperCase();

    if(q){
      result=result.filter(r=>[
        r.expediente,
        r.extension,
        r.rd,
        r.ultimo_folio,
        r.solicitud_numero,
        r.asunto,
        r.observacion,
        r.solicitante,
        r.responsable_actual
      ].some(v=>{
        const value=typeof norm==='function' ? norm(v||'') : String(v||'').toUpperCase();
        return value.includes(q);
      }));
    }

    try{
      if(typeof enrichPendingAttentionRequestTimes==='function'){
        result=await enrichPendingAttentionRequestTimes(result);
      }
    }catch(error){
      console.warn('V414 · fecha/hora de pendientes:',error?.message||error);
    }

    try{
      if(typeof enrichPendingAttentionMasterFieldsV148==='function'){
        result=await enrichPendingAttentionMasterFieldsV148(result);
      }
    }catch(error){
      console.warn('V414 · datos maestros de pendientes:',error?.message||error);
    }

    return typeof sortPendingAttentionByDateDesc==='function'
      ?sortPendingAttentionByDateDesc(result)
      :result;
  }

  async function directPendingForOrdinaryUserV414(search=''){
    const me=String(currentProfile?.nombre_personal||'').trim();
    if(!me || !sb)return [];

    const {data,error}=await sb.rpc('listar_pendientes_por_atender_inclusivo');
    if(error)throw error;

    const targetNorm=typeof norm==='function' ? norm(me) : me.toUpperCase();
    const rows=(Array.isArray(data)?data:[]).filter(r=>{
      const applicant=typeof norm==='function'
        ?norm(r?.solicitante||'')
        :String(r?.solicitante||'').toUpperCase();
      return applicant===targetNorm;
    });

    return finishPendingRowsV414(rows,search);
  }

  async function coordinatorPendingSourceRawV414(nombre){
    const target=String(nombre||'').trim();
    if(!target || !sb)return {pendingRows:[],waitRows:[]};

    const {data,error}=await sb.rpc(
      'v310_coordinador_fuentes_pendientes_usuario',
      {p_nombre:target}
    );
    if(error)throw error;

    let payload=data;
    if(typeof payload==='string'){
      try{payload=JSON.parse(payload);}catch(_){payload={};}
    }
    if(Array.isArray(payload) && payload.length===1 && payload[0] && typeof payload[0]==='object'){
      payload=payload[0];
    }
    if(!payload || typeof payload!=='object')payload={};

    return {
      pendingRows:Array.isArray(payload.pending_rows)?payload.pending_rows:[],
      waitRows:Array.isArray(payload.wait_rows)?payload.wait_rows:[]
    };
  }

  async function coordinatorDirectPendingRowsV414(nombre,search=''){
    const target=String(nombre||'').trim();
    const targetNorm=typeof norm==='function' ? norm(target) : target.toUpperCase();
    const source=await coordinatorPendingSourceRawV414(target);

    // IMPORTANTE: SOLO pending_rows.
    // wait_rows corresponde a "esperando devolución" y no debe formar parte
    // de la tarjeta PENDIENTES POR ATENDER.
    const rows=(source.pendingRows||[]).filter(r=>{
      const applicant=typeof norm==='function'
        ?norm(r?.solicitante||'')
        :String(r?.solicitante||'').toUpperCase();
      return !applicant || applicant===targetNorm;
    });

    return finishPendingRowsV414(rows,search);
  }

  // ----------------------------------------------------------
  // PERFIL USUARIO
  // Joan: deja de mezclar los expedientes que están con otro usuario.
  // ----------------------------------------------------------
  window.loadMyPendingAttentionRows=async function(search=''){
    if(!sb||!session||!isLimitedUser())return [];

    // Para un Coordinador en su espacio personal usamos la RPC segura V310,
    // que valida en PostgreSQL el nombre del propio Coordinador.
    if(typeof isCoordinatorSelfWorkspaceV206==='function' && isCoordinatorSelfWorkspaceV206()){
      try{
        return await coordinatorDirectPendingRowsV414(
          String(currentProfile?.nombre_personal||'').trim(),
          search
        );
      }catch(error){
        console.warn('V414 · pendientes propios del coordinador:',error?.message||error);
        if(typeof myPendingBeforeV414==='function')return myPendingBeforeV414(search);
        return [];
      }
    }

    // Archivo/Administrador en espacio personal conservan su fuente previa.
    if(typeof isStaffPersonalWorkspaceV319==='function' && isStaffPersonalWorkspaceV319()){
      if(typeof myPendingBeforeV414==='function')return myPendingBeforeV414(search);
      return [];
    }

    // Usuario normal: solo filas realmente listas para atención.
    try{
      return await directPendingForOrdinaryUserV414(search);
    }catch(error){
      console.warn('V414 · pendientes reales del usuario:',error?.message||error);
      // No volver a la colección inclusiva si falla: evitar mostrar una cifra
      // incorrecta. La tarjeta quedará en 0 hasta recuperar conexión/datos.
      return [];
    }
  };

  // ----------------------------------------------------------
  // COORDINADOR · PERSONAL DE MI ÁREA
  // Contador y detalle usan pending_rows y excluyen wait_rows.
  // ----------------------------------------------------------
  window.coordinatorTeamRowsV218=async function(nombre,type,search=''){
    if(
      typeof isCoordinatorTeamWorkspaceV206==='function' &&
      isCoordinatorTeamWorkspaceV206() &&
      isPendingTypeV414(type)
    ){
      return coordinatorDirectPendingRowsV414(nombre,search);
    }

    if(typeof teamRowsBeforeV414==='function'){
      return teamRowsBeforeV414(nombre,type,search);
    }

    return [];
  };

  window.loadCoordinatorPendingCountMapV409=async function(names=[]){
    if(
      typeof isCoordinatorTeamWorkspaceV206!=='function' ||
      !isCoordinatorTeamWorkspaceV206()
    ){
      if(typeof teamPendingCountBeforeV414==='function'){
        return teamPendingCountBeforeV414(names);
      }
      return new Map();
    }

    const result=new Map();

    await Promise.all((names||[]).map(async nombre=>{
      try{
        const rows=await coordinatorDirectPendingRowsV414(nombre,'');
        result.set(nombre,rows.length);
      }catch(error){
        console.warn(`V414 · pendientes reales de ${nombre}:`,error?.message||error);
        result.set(nombre,0);
      }
    }));

    return result;
  };

  // ----------------------------------------------------------
  // Eliminar snapshots que todavía pueden conservar 8 en Joan.
  // ----------------------------------------------------------
  try{
    for(let i=sessionStorage.length-1;i>=0;i--){
      const key=sessionStorage.key(i)||'';
      if(
        key.startsWith('v207_user_summary_') ||
        key.startsWith('v637_user_summary_') ||
        key.startsWith('v233_owner_cards_')
      ){
        sessionStorage.removeItem(key);
      }
    }
  }catch(_){ }

  try{
    if(typeof invalidateCoordinatorPendingCacheV310==='function'){
      invalidateCoordinatorPendingCacheV310();
    }
    if(typeof invalidatePanelViewCacheV179==='function'){
      invalidatePanelViewCacheV179();
    }
  }catch(_){ }

  window.v414PendingRuleInfo=function(){
    return {
      pending_attention:'solo expedientes realmente disponibles para atención',
      excluded:'expedientes con otro usuario esperando devolución',
      coordinatorSource:'v310_coordinador_fuentes_pendientes_usuario.pending_rows',
      expectedJoan:2
    };
  };
})();
</script>
<script id="v415-unified-real-pending-all-profiles">
(function(){
  'use strict';

  // ==========================================================
  // V415 · REGLA ÚNICA DE "PENDIENTES POR ATENDER"
  //
  // Se verificaron las rutas de Usuario, Coordinador, Archivo y
  // Administrador. A partir de esta versión, el indicador de
  // EXPEDIENTES PENDIENTES POR ATENDER representa únicamente los
  // expedientes que YA están disponibles para atención.
  //
  // Los expedientes que todavía están con otro custodio y esperan
  // devolución siguen visibles en Solicitudes / Alertas / Trazabilidad,
  // pero NO incrementan este indicador.
  // ==========================================================

  const pendingMapBeforeV415=window.loadPendingItemCountMapBySolicitanteV165;
  const loadAllMineBeforeV415=window.loadAllMyExpedientes;
  const loadAllOwnerBeforeV415=window.loadAllExpedientesForSelectedUser;
  const loadPanelBeforeV415=window.loadPanel;

  function textV415(v){
    return String(v??'').trim();
  }

  function normV415(v){
    if(typeof norm==='function')return norm(v||'');
    return textV415(v).toUpperCase();
  }

  function pendingKeyV415(r){
    return [
      textV415(r?.solicitud_id||r?.solicitud_numero||''),
      textV415(r?.expediente_id||r?.id||r?.expediente||'')
    ].join('::');
  }

  function isPendingCategoryV415(row){
    const value=textV415(row?.categoria_usuario).toUpperCase();
    return value==='PENDIENTES_POR_ATENDER' || value==='PENDIENTE_POR_ATENDER';
  }

  async function readyPendingBaseV415(){
    if(!sb||!session)return [];

    const {data,error}=await sb.rpc('listar_pendientes_por_atender_inclusivo');
    if(error)throw error;

    const map=new Map();
    for(const raw of (Array.isArray(data)?data:[])){
      const row={...raw,_v415_pending_source:'LISTO_PARA_ATENDER'};
      const key=pendingKeyV415(row);
      if(!map.has(key))map.set(key,row);
    }
    return [...map.values()];
  }

  async function readyPendingRowsForNameV415(nombre,search=''){
    const target=textV415(nombre);
    const targetNorm=normV415(target);
    if(!targetNorm)return [];

    let rows=(await readyPendingBaseV415()).filter(r=>
      normV415(r?.solicitante||'')===targetNorm
    );

    const q=normV415(search||'');
    if(q){
      rows=rows.filter(r=>[
        r.expediente,
        r.extension,
        r.rd,
        r.ultimo_folio,
        r.solicitud_numero,
        r.asunto,
        r.observacion,
        r.solicitante,
        r.responsable_actual
      ].some(v=>normV415(v||'').includes(q)));
    }

    try{
      if(typeof enrichPendingAttentionRequestTimes==='function'){
        rows=await enrichPendingAttentionRequestTimes(rows);
      }
    }catch(error){
      console.warn('V415 · fecha/hora pendientes:',error?.message||error);
    }

    try{
      if(typeof enrichPendingAttentionMasterFieldsV148==='function'){
        rows=await enrichPendingAttentionMasterFieldsV148(rows);
      }
    }catch(error){
      console.warn('V415 · datos maestros pendientes:',error?.message||error);
    }

    return typeof sortPendingAttentionByDateDesc==='function'
      ?sortPendingAttentionByDateDesc(rows)
      :rows;
  }

  // ----------------------------------------------------------
  // ADMINISTRADOR / ARCHIVO · contadores por usuario.
  // Se elimina el respaldo antiguo que completaba el total de una
  // solicitud con ítems que todavía podían estar esperando devolución.
  // ----------------------------------------------------------
  window.loadPendingItemCountMapBySolicitanteV165=async function(){
    if(!sb||!session)return new Map();

    // El Coordinador conserva su RPC segura por integrante.
    if(
      typeof isCoordinatorTeamWorkspaceV206==='function' &&
      isCoordinatorTeamWorkspaceV206()
    ){
      if(typeof pendingMapBeforeV415==='function'){
        return pendingMapBeforeV415();
      }
      return new Map();
    }

    try{
      const rows=await readyPendingBaseV415();
      const counts=new Map();

      for(const row of rows){
        const solicitante=textV415(row?.solicitante);
        if(!solicitante)continue;
        counts.set(solicitante,Number(counts.get(solicitante)||0)+1);
      }

      return counts;
    }catch(error){
      console.warn('V415 · conteo real de pendientes por usuario:',error?.message||error);
      return new Map();
    }
  };

  // ----------------------------------------------------------
  // "TODOS MIS EXPEDIENTES" · reemplazar únicamente la categoría
  // pendiente por la misma fuente usada por su tarjeta individual.
  // ----------------------------------------------------------
  window.loadAllMyExpedientes=async function(search=''){
    if(typeof loadAllMineBeforeV415!=='function')return [];

    const base=await loadAllMineBeforeV415(search);
    if(!isLimitedUser())return base;

    let pending=[];
    try{
      pending=await window.loadMyPendingAttentionRows(search||'');
    }catch(error){
      console.warn('V415 · pendientes en Todos mis expedientes:',error?.message||error);
      pending=[];
    }

    const merged=[
      ...(Array.isArray(base)?base:[]).filter(r=>!isPendingCategoryV415(r)),
      ...(Array.isArray(pending)?pending:[]).map(r=>({
        ...r,
        categoria_usuario:'PENDIENTES_POR_ATENDER'
      }))
    ];

    return typeof userAllRowsUnique==='function'
      ?userAllRowsUnique(merged)
      :merged;
  };

  // ----------------------------------------------------------
  // ADMINISTRADOR / ARCHIVO · "Todos los expedientes" del usuario.
  // El bloque pendiente se obtiene de la misma fuente real.
  // ----------------------------------------------------------
  window.loadAllExpedientesForSelectedUser=async function(nombre,search=''){
    if(typeof loadAllOwnerBeforeV415!=='function')return [];

    // Coordinador ya usa V414 + RPC V310 segura.
    if(
      typeof isCoordinatorTeamWorkspaceV206==='function' &&
      isCoordinatorTeamWorkspaceV206()
    ){
      return loadAllOwnerBeforeV415(nombre,search);
    }

    const base=await loadAllOwnerBeforeV415(nombre,search);
    if(!hasFullAccess() || isLimitedUser())return base;

    let pending=[];
    try{
      pending=await readyPendingRowsForNameV415(nombre,search||'');
    }catch(error){
      console.warn(`V415 · pendientes reales de ${nombre}:`,error?.message||error);
      pending=[];
    }

    const merged=[
      ...(Array.isArray(base)?base:[]).filter(r=>!isPendingCategoryV415(r)),
      ...pending.map(r=>({...r,categoria_usuario:'PENDIENTES_POR_ATENDER'}))
    ];

    return typeof userAllRowsUnique==='function'
      ?userAllRowsUnique(merged)
      :merged;
  };

  async function renderFullAccessPendingPanelV415(options={}){
    const ownerSnapshot=textV415(selectedOwner);
    const filterSnapshot=textV415(panelQuickFilter);
    if(!ownerSnapshot)return;

    const search=typeof cleanSearch==='function'
      ?cleanSearch(document.getElementById('searchInput')?.value||'')
      :textV415(document.getElementById('searchInput')?.value||'');

    let all=[];
    try{
      all=await readyPendingRowsForNameV415(ownerSnapshot,search);
    }catch(error){
      panelRows=[];
      panelCount=0;
      if(el('pageInfo'))el('pageInfo').textContent='0 registros';
      if(el('panelTable'))el('panelTable').innerHTML=`
        <div class="empty">
          <b>No se pudo consultar los pendientes por atender.</b><br>
          ${typeof esc==='function'?esc(error?.message||String(error)):textV415(error?.message||error)}
        </div>`;
      return;
    }

    // La persona/filtro pudo cambiar mientras respondía Supabase.
    if(
      normV415(selectedOwner)!==normV415(ownerSnapshot) ||
