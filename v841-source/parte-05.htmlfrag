</style>
<script id="v351-final-personal-layout-script">
(function(){
  function syncV351(){
    const body=document.body;
    if(!body?.classList.contains('produce-user') ||
       !body.classList.contains('v349-personal-compact-panel')) return;

    // V394: impedir cualquier reparentado después de fijar el toolbar.
    if(body.classList.contains('v394-search-locked'))return;

    const actions=document.querySelector('.main-sticky-header .actions');
    const exportBtn=document.getElementById('exportScopeBtnV270');
    const newRequestBtn=document.getElementById('searchRequestBtn');
    const searchField=document.getElementById('searchInput')?.closest('.field');

    if(!actions)return;

    // Reubicar por DOM, no solo por CSS.
    // De este modo ninguna regla histórica puede dejar Exportar en el centro.
    if(exportBtn){
      if(exportBtn.parentNode!==actions){
        actions.insertBefore(exportBtn,actions.firstElementChild);
      }else if(actions.firstElementChild!==exportBtn){
        actions.insertBefore(exportBtn,actions.firstElementChild);
      }
    }

    if(newRequestBtn){
      if(newRequestBtn.parentNode!==actions){
        exportBtn ? exportBtn.after(newRequestBtn) : actions.prepend(newRequestBtn);
      }else if(exportBtn && exportBtn.nextElementSibling!==newRequestBtn){
        exportBtn.after(newRequestBtn);
      }
    }

    if(searchField){
      searchField.classList.add('v349-toolbar-search');

      const searchInput=document.getElementById('searchInput');
      const searchFocused=document.activeElement===searchInput;

      if(!searchFocused){
        if(searchField.parentNode!==actions){
          if(newRequestBtn) newRequestBtn.after(searchField);
          else actions.appendChild(searchField);
        }else if(newRequestBtn && newRequestBtn.nextElementSibling!==searchField){
          newRequestBtn.after(searchField);
        }
      }
    }

    const searchInput=document.getElementById('searchInput');
    if(searchInput){
      searchInput.placeholder='Buscar por N.° de expediente';
      searchInput.setAttribute('aria-label','Buscar por número de expediente');
    }
  }

  function scheduleV351(){
    requestAnimationFrame(()=>setTimeout(syncV351,0));
  }

  document.addEventListener('DOMContentLoaded',()=>{
    syncV351();
    setTimeout(syncV351,250);
    setTimeout(syncV351,800);
    setTimeout(syncV351,1600);
  },{once:true});

  window.addEventListener('load',scheduleV351,{once:true});
  document.addEventListener('click',event=>{
    // V393: preservar foco/caret del buscador personal.
    if(event.target?.closest?.('#searchInput,.v349-toolbar-search'))return;
    scheduleV351();
  },true);

  const startObserver=()=>{
    const actions=document.querySelector('.main-sticky-header .actions');
    if(!actions)return;
    new MutationObserver(()=>scheduleV351())
      .observe(actions,{childList:true});
  };
  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',startObserver,{once:true});
  }else{
    startObserver();
  }

  window.syncPersonalLayoutV351=syncV351;
})();
</script>
<style id="v352-sidebar-export-kpi-fix">
/* V352 · Exportar al lateral izquierdo + KPIs compactos y legibles */
body.produce-user.v349-personal-compact-panel .produce-nav #exportScopeBtnV270,
body.produce-staff.v349-personal-compact-panel .produce-nav #exportScopeBtnV270,
body.produce-coordinator-self.v349-personal-compact-panel .produce-nav #exportScopeBtnV270{
  width:calc(100% - 24px)!important;
  margin:10px 12px 0!important;
  justify-content:flex-start!important;
  text-align:left!important;
  white-space:normal!important;
  min-height:56px!important;
  font-size:14px!important;
