}

/* El buscador original deja de reservar una fila independiente. */
body.produce-user.v349-personal-compact-panel #ownerDetailFilters{
  display:none!important;
}

/* Tarjetas compactas */
body.produce-user.v349-personal-compact-panel .app.role-user #userPersonalKpis{
  display:grid!important;
