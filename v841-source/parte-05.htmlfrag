<script id="v354-sidebar-stable-script">
(function(){
  let exportAnchorV354=null;
  let exportHomeParentV354=null;
  let scheduledV354=false;

  function moveExportStableV354(){
    scheduledV354=false;
    const btn=document.getElementById('exportScopeBtnV270');
    if(!btn)return;

    if(!exportAnchorV354){
      exportHomeParentV354=btn.parentNode;
      exportAnchorV354=document.createComment('v354-export-home');
      if(exportHomeParentV354)exportHomeParentV354.insertBefore(exportAnchorV354,btn);
    }

    const limited=typeof isLimitedUser==='function'&&isLimitedUser();
    const nav=document.querySelector('.produce-nav');
    const conasBtn=nav?.querySelector('button[data-destination="conas"]');
    const selectionMenu=nav?.querySelector('.produce-selection-actions');
    const shouldMove=!!(limited&&nav&&conasBtn);

    if(shouldMove){
      btn.classList.add('sidebar-export-btn-v352');
      if(btn.textContent!=='⬇ Exportar mis expedientes')btn.textContent='⬇ Exportar mis expedientes';

      // Mover solo si realmente está fuera de su posición final.
      const desiredNext=selectionMenu||conasBtn.nextSibling;
      if(btn.parentNode!==nav || (desiredNext&&btn.nextSibling!==desiredNext)){
        if(desiredNext)nav.insertBefore(btn,desiredNext);
        else nav.appendChild(btn);
      }
    }else if(exportAnchorV354?.parentNode){
      btn.classList.remove('sidebar-export-btn-v352');
      if(btn.textContent!=='⬇ Exportar expedientes')btn.textContent='⬇ Exportar expedientes';
      if(btn.parentNode!==exportAnchorV354.parentNode || btn.previousSibling!==exportAnchorV354){
        exportAnchorV354.parentNode.insertBefore(btn,exportAnchorV354.nextSibling);
      }
    }
  }

  function scheduleV354(){
    if(scheduledV354)return;
    scheduledV354=true;
    requestAnimationFrame(moveExportStableV354);
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',()=>{
      moveExportStableV354();
      setTimeout(moveExportStableV354,300);
      setTimeout(moveExportStableV354,900);
    },{once:true});
  }else{
    moveExportStableV354();
  }

  window.addEventListener('load',scheduleV354,{once:true});
  document.addEventListener('click',scheduleV354,true);

  // Cuando cambian permisos/perfil, reubicar una vez. No observar todo el DOM.
  try{
    const previousApplyRoleUIV354=applyRoleUI;
    applyRoleUI=function(...args){
      const result=previousApplyRoleUIV354.apply(this,args);
      setTimeout(moveExportStableV354,0);
      return result;
    };
  }catch(_){ }

  try{
    const previousSwitchTabV354=switchTab;
    switchTab=function(...args){
      const result=previousSwitchTabV354.apply(this,args);
      setTimeout(moveExportStableV354,0);
      return result;
    };
  }catch(_){ }

  window.syncSidebarExportV354=moveExportStableV354;
})();
</script>
<style id="v354-sidebar-no-flicker-style">
/* V354 · estabilidad visual del menú lateral */
.produce-nav,
.produce-nav > button,
.produce-nav .produce-selection-actions,
.produce-nav .produce-selection-actions > *{
  animation:none!important;
}
.produce-nav > button,
.produce-nav .produce-selection-actions button{
  transition:background-color .08s linear,border-color .08s linear,color .08s linear!important;
}
/* Evita saltos de ancho/alto mientras se actualizan contadores en segundo plano. */
body.produce-user .produce-nav,
body.produce-staff .produce-nav{
  contain:none;
}
</style>
<style id="v355-sidebar-order-fix">
/* =========================================================
   V355 · MENÚ LATERAL ARCHIVO / ADMINISTRADOR
   Corrige la superposición del pie institucional.
   Todo el menú queda dentro del mismo desplazamiento vertical.
   ========================================================= */

body.produce-staff .produce-nav{
