<script id="v623-owner-cards-stability">
(function(){
  'use strict';
  let rendering=false;
  const clean=v=>String(v??'').trim();

  function sanitizeRows(){
    try{
      if(typeof ownerCardsRows!=='undefined' && Array.isArray(ownerCardsRows)){
        const cleaned=ownerCardsRows.filter(row=>clean(row?.nombre));
        if(cleaned.length!==ownerCardsRows.length){
          ownerCardsRows=cleaned;
        }
      }
    }catch(_){ }
  }

  function installRenderGuard(){
    const current=window.renderOwnerCards;
    if(typeof current!=='function' || current.__v622StableWrapped)return false;
    const wrapped=function(){
      if(rendering){
        try{console.warn('V623 · repintado recursivo de tarjetas bloqueado');}catch(_){ }
        return;
      }
      rendering=true;
      try{
        sanitizeRows();
        return current.apply(this,arguments);
      }finally{
        rendering=false;
      }
    };
    wrapped.__v622StableWrapped=true;
    wrapped.__v622Original=current;
    window.renderOwnerCards=wrapped;
    return true;
  }

  function install(){
    installRenderGuard();
    sanitizeRows();
    const timer=setInterval(()=>{installRenderGuard();sanitizeRows();},1500);
    setTimeout(()=>clearInterval(timer),12000);
  }

  window.v622StabilityInfo=()=>({
    version:'V623',
    owner_cards_reentry_guard:true,
    blank_owner_cards_filtered:true,
    reception_mail_rpc_monkeypatch:false
  });

  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install,{once:true});
  else install();
})();
</script>

