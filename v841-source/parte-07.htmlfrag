<script id="v695-pending-user-location-script">
(function(){
  'use strict';

  let seq=0;
  let cacheKey='';
  let noticeMap=new Map();
  let observerQueued=false;

  function pendingContextActive(){
    try{
      if(typeof userPanelMode!=='undefined' && String(userPanelMode||'')==='PENDIENTES_POR_ATENDER')return true;
      if(typeof panelQuickFilter!=='undefined' && String(panelQuickFilter||'')==='pending_attention')return true;
    }catch(_){ }
    return false;
  }

  function locationHtml(n){
    if(!n)return '<span style="color:var(--muted);font-size:10px">—</span>';
    const sede=String(n.sede||'UBICACIÓN VERIFICADA').trim();
    const note=String(n.observacion||'').replace(/\s+/g,' ').trim();
    const short=note.length>68?note.slice(0,67).trimEnd()+'…':note;
    const read=n.leida_at?'Leído':'Pendiente de lectura';
    return `<span class="pill returned" title="Ubicación comunicada; no modifica la custodia física">📍 ${esc(sede)}</span>
      <span class="v695-pending-location-meta">${fmtDate(n.created_at)} ${fmtTime(n.created_at)} · ${esc(n.verificado_nombre||'—')}</span>
      ${short?`<span class="v695-pending-location-note" title="${esc(note)}">${esc(short)}</span>`:''}
      <span class="v695-pending-location-meta">${esc(read)}</span>`;
  }

  function paint(){
    document.querySelectorAll('#panelTable [data-v695-pending-location]').forEach(cell=>{
      const key=String(cell.dataset.v695PendingLocation||'')+'|'+String(cell.dataset.v695Request||'');
      cell.innerHTML=locationHtml(noticeMap.get(key));
      cell.removeAttribute('aria-busy');
    });
  }

  function clientV695(){
    try{return (typeof sb!=='undefined'&&sb)?sb:window.sb;}catch(_){return window.sb||null;}
  }
  function sessionV695(){
    try{return (typeof session!=='undefined'&&session)?session:window.session;}catch(_){return window.session||null;}
  }

  async function load(force=false){
    const client=clientV695();
    const current=sessionV695();
    if(!pendingContextActive()||!client||!current)return;
    const cells=[...document.querySelectorAll('#panelTable [data-v695-pending-location]')];
    if(!cells.length)return;
    const uid=String(current?.user?.id||'');
    if(!uid)return;
    const pairs=[...new Set(cells.map(c=>String(c.dataset.v695PendingLocation||'')+'|'+String(c.dataset.v695Request||'')))].sort();
    const expIds=[...new Set(cells.map(c=>String(c.dataset.v695PendingLocation||'')).filter(Boolean))].sort();
    const nextKey=uid+'|'+pairs.join(',');
    if(!force && cacheKey===nextKey){paint();return;}
    const mySeq=++seq;
    const latest=new Map();
    try{
      for(let i=0;i<expIds.length;i+=100){
        for(let offset=0;;offset+=500){
          const {data,error}=await client.from('avisos_ubicacion_verificada')
            .select('id,expediente_id,solicitud_id,sede,observacion,verificado_nombre,created_at,leida_at')
            .in('expediente_id',expIds.slice(i,i+100))
            .order('created_at',{ascending:false})
            .order('id')
            .range(offset,offset+499);
          if(mySeq!==seq||String(sessionV695()?.user?.id||'')!==uid)return;
          if(error)throw error;
          for(const n of data||[]){
            const k=String(n.expediente_id||'')+'|'+String(n.solicitud_id||'');
            if(!latest.has(k))latest.set(k,n);
          }
          if(!data||data.length<500)break;
        }
      }
      if(mySeq!==seq||String(sessionV695()?.user?.id||'')!==uid)return;
      noticeMap=latest;
      cacheKey=nextKey;
      paint();
    }catch(error){
      if(mySeq!==seq)return;
      document.querySelectorAll('#panelTable [data-v695-pending-location]').forEach(cell=>{
        cell.innerHTML='<span style="color:var(--muted);font-size:10px">No disponible</span>';
        cell.title=typeof locationNoticeError==='function'?locationNoticeError(error):(error?.message||String(error));
        cell.removeAttribute('aria-busy');
      });
      console.warn('V695 ubicación en Pendientes de Mis expedientes:',error);
    }
  }
  window.loadPanelPendingLocationNoticesV695=load;

  function injectColumn(html,rows){
    const template=document.createElement('template');
    template.innerHTML=html;
    const table=template.content.querySelector('table');
    const head=table?.tHead?.rows?.[0];
    const body=table?.tBodies?.[0];
    if(!table||!head||!body)return html;
    if(head.querySelector('.v695-pending-location-head'))return html;

    const headers=[...head.cells];
    let stateIndex=headers.findIndex(th=>/^(ESTADO|ESTADO SOLICITUD)$/i.test(String(th.textContent||'').trim()));
    if(stateIndex<0)stateIndex=headers.findIndex(th=>/ESTADO/i.test(String(th.textContent||'').trim()));
    if(stateIndex<0)return html;

    const th=document.createElement('th');
    th.className='v695-pending-location-head';
    th.textContent='Ubicación / comunicación';
    head.insertBefore(th,head.cells[stateIndex+1]||null);

    [...body.rows].forEach((tr,index)=>{
      const r=rows?.[index]||{};
      const expId=String(r.expediente_id||r.id||'').trim();
      const reqId=String(r.solicitud_id||r.solicitud_activa_id||'').trim();
      const td=document.createElement('td');
      td.className='v695-pending-location-col';
      if(expId&&reqId){
        td.dataset.v695PendingLocation=expId;
        td.dataset.v695Request=reqId;
        td.setAttribute('aria-busy','true');
        td.innerHTML='<span style="color:var(--muted);font-size:10px">Consultando…</span>';
      }else{
        td.innerHTML='<span style="color:var(--muted);font-size:10px">—</span>';
      }
      tr.insertBefore(td,tr.cells[stateIndex+1]||null);
    });

    queueMicrotask(()=>{try{load(false);}catch(_){ }});
    return template.innerHTML;
  }

  const prevUser=window.renderUserPendingAttentionRows;
  if(typeof prevUser==='function'&&!prevUser.__v695LocationWrapped){
    const wrapped=function(rows,canManage=false){
      return injectColumn(prevUser.apply(this,arguments),Array.isArray(rows)?rows:[]);
    };
    wrapped.__v695LocationWrapped=true;
    window.renderUserPendingAttentionRows=wrapped;
  }

  const prevCoordinator=window.renderCoordinatorCompleteTableV225;
  if(typeof prevCoordinator==='function'&&!prevCoordinator.__v695LocationWrapped){
    const wrapped=function(rows,context=''){
      const html=prevCoordinator.apply(this,arguments);
      if(!/PENDIENT/i.test(String(context||'')))return html;
      return injectColumn(html,Array.isArray(rows)?rows:[]);
    };
    wrapped.__v695LocationWrapped=true;
    window.renderCoordinatorCompleteTableV225=wrapped;
  }

  function scheduleFromDom(){
    if(observerQueued)return;
    observerQueued=true;
    requestAnimationFrame(()=>{
      observerQueued=false;
      if(document.querySelector('#panelTable [data-v695-pending-location][aria-busy="true"]')){
        load(false);
      }
    });
  }
  const panel=document.getElementById('panelTable');
  if(panel)new MutationObserver(scheduleFromDom).observe(panel,{childList:true,subtree:true});
  window.addEventListener('focus',()=>{
    if(pendingContextActive()&&document.querySelector('#panelTable [data-v695-pending-location]'))load(true);
  },{passive:true});
})();
</script>
<!-- V695 · Ubicación comunicada visible también en Pendientes por atender de Mis expedientes -->

<!-- V696 · Menú lateral: "Estados" renombrado a "Estado de los expedientes" -->

<!-- V697 · Solicitudes: columna Ubicación / comunicación visible también para Archivo, Administrador y Coordinador -->

<!-- V698 · En préstamo: se elimina la columna Ubicación para evitar confusión con la custodia física vigente.
     La comunicación permanece en Total en custodia, Pendientes por atender, Mis solicitudes e Historial. -->

<!-- V699 · Ubicación / comunicación visible únicamente en Expedientes pendientes por atender.
     Se retira de Mis solicitudes y de las demás tarjetas de Mis expedientes.
     Los avisos siguen conservados en Supabase y en el Historial. -->

<script id="v700-location-only-pending-guard">
(function(){
  'use strict';

  function normV700(v){
    return String(v||'')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .trim()
      .toUpperCase();
  }

  function isPendingAttentionPanelV700(){
    try{
      const mode=normV700(typeof userPanelMode!=='undefined'?userPanelMode:'');
      const quick=normV700(typeof panelQuickFilter!=='undefined'?panelQuickFilter:'');
      if(mode==='PENDIENTES_POR_ATENDER')return true;
      if(quick==='PENDING_ATTENTION')return true;

      const title=normV700(document.getElementById('panelTitle')?.textContent||'');
      return title.includes('PENDIENTES POR ATENDER');
    }catch(_){
      return false;
    }
  }

  function stripLocationColumnV700(){
    const root=document.getElementById('panelTable');
    if(!root || isPendingAttentionPanelV700())return;

    const tables=[...root.querySelectorAll('table')];
    for(const table of tables){
      const head=table.tHead?.rows?.[0];
      if(!head)continue;

      const heads=[...head.cells];
      let index=-1;

      for(let i=0;i<heads.length;i++){
        const label=normV700(heads[i].textContent||'');
        if(label==='UBICACION' || label==='UBICACION / COMUNICACION'){
          index=i;
          break;
        }
      }

      if(index<0)continue;

      // Eliminar la celda en todas las filas antes de quitar la cabecera.
      for(const body of [...table.tBodies]){
        for(const row of [...body.rows]){
          if(row.cells[index])row.deleteCell(index);
        }
      }
      if(head.cells[index])head.deleteCell(index);
    }
  }

  window.v700StripNonPendingLocationColumn=stripLocationColumnV700;

  let queued=false;
  function schedule(){
    if(queued)return;
    queued=true;
    queueMicrotask(()=>{
      queued=false;
      stripLocationColumnV700();
    });
  }

  function start(){
    const panel=document.getElementById('panelTable');
    if(!panel)return;

    const observer=new MutationObserver(schedule);
    observer.observe(panel,{childList:true,subtree:true});

    schedule();
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',start,{once:true});
  }else{
    start();
  }

  // Refuerzo después de los renderizadores principales si están disponibles.
  const originalRecordTable=window.recordTable;
  if(typeof originalRecordTable==='function'){
    window.recordTable=function(...args){
      const html=originalRecordTable.apply(this,args);
      queueMicrotask(stripLocationColumnV700);
      return html;
    };
  }

  const originalRenderUserPending=window.renderUserPendingAttentionRows;
  if(typeof originalRenderUserPending==='function'){
    // Pendientes conserva Ubicación / comunicación. Solo revalidamos después.
    window.renderUserPendingAttentionRows=function(...args){
      return originalRenderUserPending.apply(this,args);
    };
  }
})();
</script>

<!-- V700 · Protección definitiva:
     Ubicación / comunicación solo permanece en Expedientes pendientes por atender.
     Total en custodia y las demás tarjetas de Mis expedientes no pueden mostrarla. -->

<!-- V701 · CONAS: selección acumulada entre búsquedas.
     Buscar un nuevo expediente no elimina los seleccionados anteriores.
     El modal y el retorno usan todos los expedientes acumulados.
     Incluye acción Limpiar selección. -->

<!-- V702 · Expedientes con número de longitud variable.
     Formato general: uno o más dígitos + guion + año de 4 dígitos.
     Los números con menos de 4 dígitos se completan con ceros;
     los de 5, 6 o más dígitos se conservan íntegros.
     Aplica a registro manual, Excel/CSV, búsquedas y Registro maestro. -->

<!-- V703 · Reasignación en espacio personal:
     ARCHIVO (ej. Jaime Grados) y ADMINISTRADOR también pueden reasignar
     expedientes que estén realmente bajo su propia responsabilidad.
     La validación canónica permanece en Supabase mediante v687_preparar_reasignacion. -->

<!-- V704 · Expedientes acumulados dentro de la misma solicitud:
     - expediente solicitado identificado como PRINCIPAL;
     - acumulados identificados como ACUMULADO;
     - Archivo/Administrador puede vincular desde Gestionar solicitud;
     - el acumulado no genera préstamo/cargo/custodia independiente. -->

<!-- V705 · Gestionar solicitud:
     los expedientes acumulados se muestran directamente debajo del expediente PRINCIPAL.
     Los vinculados al ciclo abierto se identifican con MISMA SOLICITUD.
     No tienen checkbox, estado, cargo ni custodia independientes. -->

<style id="v706-acumulados-colapsados">
#requestDetailModal .v706-request-accumulated{
  margin-top:4px;
  text-align:center;
}
#requestDetailModal .v706-accumulated-toggle{
  appearance:none;
  border:1px solid #c6d7e7;
  background:#f4f8fc;
  color:#174a78;
  border-radius:6px;
  padding:2px 7px;
  font-size:8.5px;
  line-height:1.15;
  font-weight:850;
  cursor:pointer;
  white-space:nowrap;
}
#requestDetailModal .v706-accumulated-toggle:hover{
  background:#eaf3fb;
}
#requestDetailModal .v706-request-accumulated-list{
  margin:4px auto 0;
  width:max-content;
  max-width:100%;
  padding:3px 6px;
  border-radius:6px;
  background:#fffaf0;
  border:1px solid #ead9a9;
  text-align:left;
}
#requestDetailModal .v706-request-accumulated-list[hidden]{
  display:none !important;
}
#requestDetailModal .v706-request-accumulated-item{
  display:flex;
  align-items:center;
  gap:4px;
  padding:1px 0;
  font-size:9px;
  line-height:1.15;
}
#requestDetailModal .v706-request-accumulated-arrow{
  color:#8a6500;
  font-weight:900;
}
#requestDetailModal .v706-request-accumulated-number{
  color:#0b3766;
  font-weight:900;
}
</style>

<!-- V706 · Acumulados compactos:
     - ocultos por defecto debajo del expediente PRINCIPAL;
     - se despliegan con "N acumulados";
     - solo muestran el número del expediente acumulado;
     - no muestran extensión, etiqueta ACUMULADO ni MISMA SOLICITUD;
     - solo se incluyen acumulados del ciclo/solicitud abierta. -->

<!-- V707 · Cancelación de solicitudes de COPIA DIGITAL:
     - Administrador puede cancelar la solicitud mientras ninguna copia haya sido entregada;
     - usa el mismo cierre administrativo e historial del préstamo físico;
     - no modifica la custodia física del expediente;
     - una solicitud ya atendida digitalmente no puede cancelarse como no atendida;
     - el detalle diferencia COPIA DIGITAL ENTREGADA de CERRADA POR ADMINISTRADOR. -->

<script id="v708-export-owner-card">
(function(){
  'use strict';

  const TYPE_MAP_V708={
    custody:'CUSTODIA',
    loan:'PRESTAMO',
    reassigned:'REASIGNADOS_A_MI',
    pending_attention:'PENDIENTES_POR_ATENDER',
    pending:'DEVOLUCION_SOLICITADA',
    returns:'DEVUELTOS_AL_ARCHIVO',
    alert:'ALERTAS_30'
  };

  const LABEL_MAP_V708={
    custody:'TOTAL EN CUSTODIA',
    loan:'PRÉSTAMOS',
    reassigned:'REASIGNADOS',
    pending_attention:'EXPEDIENTES PENDIENTES POR ATENDER',
    pending:'SOLICITUDES DE DEVOLUCIÓN',
    returns:'DEVUELTOS AL ARCHIVO',
    alert:'ALERTAS > 30 DÍAS'
  };

  function cleanV708(v){
    return String(v??'').trim();
  }

  function safePartV708(v){
    return cleanV708(v)
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .replace(/[^A-Za-z0-9_-]+/g,'_')
      .replace(/^_+|_+$/g,'')
      .slice(0,70)||'EXPORTACION';
  }

  function dateKeyV708(){
    const d=new Date();
    return `${d.getFullYear()}${String(d.getMonth()+1).padStart(2,'0')}${String(d.getDate()).padStart(2,'0')}`;
  }

  function displayDateV708(v){
    if(v===null||v===undefined||v==='')return '';
    try{
      if(typeof masterDateTimeText==='function'){
        const x=masterDateTimeText(v);
        if(x && x!=='—')return x;
      }
    }catch(_){}
    try{
      if(typeof fmtDate==='function'){
        const x=fmtDate(v);
        if(x && x!=='—')return x;
      }
    }catch(_){}
    return String(v);
  }

  function stateV708(row,filter){
    if(filter==='pending_attention')return 'PENDIENTE POR ATENDER';
    if(filter==='pending')return 'DEVOLUCIÓN SOLICITADA';
    if(filter==='returns')return 'DEVUELTO AL ARCHIVO';
    if(filter==='alert')return 'ALERTA > 30 DÍAS';
    try{
      if(typeof rowStatus==='function'){
        const x=rowStatus(row);
        if(x)return x;
      }
    }catch(_){}
    return cleanV708(
      row?.estado_operativo||
      row?.estado_actual_db||
      row?.estado_actual||
      row?.estado_item||
      row?.ultimo_estado||
      row?.estado
    );
  }

  function responsibleV708(row,filter){
    if(filter==='returns')return 'ARCHIVO';
    try{
      if(typeof currentResponsibleDisplay==='function'){
        const x=currentResponsibleDisplay(row);
        if(x && x!=='—')return x;
      }
    }catch(_){}
    return cleanV708(
      row?.responsable_actual||
      row?.responsable_actual_db||
      row?.responsable||
      row?.ubicacion_actual
    );
  }

  function asuntoV708(row){
    try{
      if(typeof expedienteAsuntoValue==='function'){
        return cleanV708(expedienteAsuntoValue(row));
      }
    }catch(_){}
    return cleanV708(v732AsuntoValor(row));
  }

  function daysCustodyV708(row){
    try{
      if(typeof custodyDaysV221==='function'){
        const x=custodyDaysV221(row);
        if(x!==null&&x!==undefined)return x;
      }
    }catch(_){}
    return cleanV708(row?.dias_en_custodia||row?.dias_custodia);
  }

  function daysPendingV708(row){
    const direct=
      row?.dias_habiles_sin_atender??
      row?.dias_sin_atender??
      row?.dias_habiles_pendiente;

    if(direct!==null&&direct!==undefined&&direct!=='')return direct;

    try{
      if(typeof businessDaysSince==='function'){
        const d=row?.solicitud_created_at||row?.created_at||row?.fecha_solicitud;
        if(d)return businessDaysSince(d);
      }
    }catch(_){}
    return '';
  }

  async function sourceRowsV708(owner,filter){
    const tipo=TYPE_MAP_V708[filter];
    if(!tipo)throw new Error('Tarjeta no reconocida.');

    let rows=[];

    if(
      typeof isCoordinatorTeamWorkspaceV206==='function' &&
      isCoordinatorTeamWorkspaceV206()
    ){
      rows=await coordinatorTeamRowsV218(owner,tipo,'');
    }else{
      const {data,error}=await sb.rpc(
        'listar_tarjeta_usuario_admin_v5',
        {
          p_nombre:owner,
          p_tipo:tipo,
          p_busqueda:null
        }
      );
      if(error)throw error;
      rows=Array.isArray(data)?data:[];
    }

    if(filter==='pending_attention'){
      try{
        rows=await enrichPendingAttentionRequestTimes(rows||[]);
        rows=sortPendingAttentionByDateDesc(rows||[]);
      }catch(_){}
    }

    try{
      rows=await enrichPanelRowsFastV179(
        rows||[],
        {
          canonical:['custody','loan','reassigned','pending'].includes(filter)
        }
      );
    }catch(_){}

    if(filter==='returns'){
      try{rows=await enrichHistoricalReturnAcceptance(rows||[]);}catch(_){}
      try{rows=await enrichRowsWithExpedienteAsunto(rows||[]);}catch(_){}
    }

    return Array.isArray(rows)?rows:[];
  }

  function exportMatrixV708(owner,filter,rows){
    const headers=[
      'N.°',
      'USUARIO',
      'TARJETA',
      'EXPEDIENTE',
      'EXTENSIÓN',
      'R.D.',
      'ÚLTIMO FOLIO',
      'ASUNTO',
      'ESTADO',
      'RESPONSABLE ACTUAL / UBICACIÓN',
      'REASIGNADO DESDE',
      'REASIGNADO HACIA',
      'CARGO',
      'SOLICITUD',
      'MODALIDAD',
      'FECHA / HORA SOLICITUD',
      'FECHA / HORA ÚLTIMO ESTADO',
      'FECHA DEVOLUCIÓN',
      'DÍAS EN CUSTODIA',
      'DÍAS SIN ATENDER',
      'OBSERVACIÓN'
    ];

    const label=LABEL_MAP_V708[filter]||filter;

    const data=rows.map((r,index)=>[
      index+1,
      owner,
      label,
      cleanV708(r?.expediente),
      cleanV708(r?.extension),
      cleanV708(r?.rd),
      cleanV708(r?.ultimo_folio),
      asuntoV708(r),
      stateV708(r,filter),
      responsibleV708(r,filter),
      cleanV708(r?.reasignado_desde||r?.ultimo_movimiento_desde),
      cleanV708(r?.reasignado_hacia||r?.ultimo_movimiento_hacia),
      cleanV708(r?.cargo_numero||r?.cargo||r?.cargo_devolucion_usuario),
      cleanV708(r?.solicitud_numero||r?.numero_solicitud),
      cleanV708(r?.modalidad),
      displayDateV708(r?.solicitud_created_at||r?.created_at||r?.fecha_solicitud),
      displayDateV708(r?.fecha_ultimo_estado||r?.ultimo_movimiento_fecha||r?.updated_at),
      displayDateV708(r?.fecha_aceptacion_devolucion||r?.fecha_devolucion),
      daysCustodyV708(r),
      daysPendingV708(r),
      cleanV708(r?.observacion||r?.observaciones)
    ]);

    return {headers,data,label};
  }

  function workbookV708(owner,filter,rows){
    if(!window.XLSX)throw new Error('No se pudo cargar el componente de Excel (XLSX).');

    const {headers,data,label}=exportMatrixV708(owner,filter,rows);
    const wb=XLSX.utils.book_new();

    const info=[
      ['EXPORTACIÓN DE EXPEDIENTES POR USUARIO Y TARJETA'],
      [],
      ['Usuario',owner],
      ['Tarjeta',label],
      ['Total exportado',rows.length],
      ['Fecha de exportación',new Date().toLocaleString('es-PE')],
      ['Generado por',cleanV708(currentProfile?.nombre_personal||session?.user?.email)],
      ['Perfil que exporta',typeof role==='function'?role():'']
    ];

    const wsInfo=XLSX.utils.aoa_to_sheet(info);
    wsInfo['!cols']=[{wch:25},{wch:45}];
    XLSX.utils.book_append_sheet(wb,wsInfo,'Resumen');

    const ws=XLSX.utils.aoa_to_sheet([headers,...data]);
    ws['!cols']=[
      {wch:7},{wch:28},{wch:30},{wch:18},{wch:15},{wch:18},{wch:14},
      {wch:42},{wch:24},{wch:28},{wch:24},{wch:24},{wch:18},{wch:18},
      {wch:16},{wch:22},{wch:22},{wch:20},{wch:16},{wch:16},{wch:45}
    ];
    if(headers.length){
      ws['!autofilter']={
        ref:`A1:${XLSX.utils.encode_col(headers.length-1)}${Math.max(1,data.length+1)}`
      };
    }
    XLSX.utils.book_append_sheet(wb,ws,'Expedientes');

    return {wb,label};
  }

  window.exportOwnerCardV708=async function(filter,btn){
    // V727: bloquear tambien llamadas directas; no basta con ocultar los botones.
    // ARCHIVO y ADMINISTRADOR conservan las exportaciones de estas tarjetas.
    if(typeof hasFullAccess!=='function' || !hasFullAccess()){
      if(typeof showToast==='function')showToast('Exportación disponible solo para Archivo y Administrador.');
      return;
    }
    const owner=cleanV708(typeof selectedOwner!=='undefined'?selectedOwner:'');
    if(!owner){
      if(typeof showToast==='function')showToast('Seleccione primero un usuario.');
      else alert('Seleccione primero un usuario.');
      return;
    }

    if(!sb || !session){
      alert('Debe iniciar sesión antes de exportar.');
      return;
    }

    if(!window.XLSX){
      alert('No se pudo cargar el componente de Excel.');
      return;
    }

    const original=btn?.textContent||'⬇ Exportar';

    if(btn){
      btn.disabled=true;
      btn.textContent='Exportando...';
    }

    try{
      const rows=await sourceRowsV708(owner,filter);

      if(!rows.length){
        if(typeof showToast==='function')showToast('Esta tarjeta no tiene expedientes para exportar.');
        else alert('Esta tarjeta no tiene expedientes para exportar.');
        return;
      }

      const {wb,label}=workbookV708(owner,filter,rows);

      const filename=
        `EXPEDIENTES_${safePartV708(owner)}_${safePartV708(label)}_${dateKeyV708()}.xlsx`;

      XLSX.writeFile(wb,filename,{compression:true});

      if(typeof showToast==='function'){
        showToast(`${rows.length} expediente${rows.length===1?'':'s'} exportado${rows.length===1?'':'s'} de ${label}.`);
      }
    }catch(error){
      console.error('V708 · exportación por tarjeta:',error);
      alert('No se pudo exportar esta tarjeta.\n\n'+(error?.message||String(error)));
    }finally{
      if(btn){
        btn.disabled=false;
        btn.textContent=original;
      }
    }
  };
})();
</script>

<!-- V708 · Expedientes por usuario:
     cada tarjeta permite exportar todos sus expedientes a Excel,
     independientemente de la paginación del detalle. -->

<script id="v709-reassignment-card-fix">
(function(){
  'use strict';

  function clearStoredReassignmentPanelsV709(){
    try{
      for(let i=sessionStorage.length-1;i>=0;i--){
        const key=sessionStorage.key(i)||'';
        if(
          key.startsWith('v353_panel_snapshot_') &&
          (
            key.includes('REASIGNADOS_POR_MI') ||
            key.includes('REASIGNADOS_A_MI')
          )
        ){
          sessionStorage.removeItem(key);
        }

        if(key.startsWith('v637_user_summary_')){
          sessionStorage.removeItem(key);
        }
      }
    }catch(_){}

    try{
      if(
        typeof v179PanelViewCache!=='undefined' &&
        v179PanelViewCache &&
        typeof v179PanelViewCache.clear==='function'
      ){
        v179PanelViewCache.clear();
      }
    }catch(_){}
  }

  clearStoredReassignmentPanelsV709();

  window.v709ReassignmentInfo=function(){
    return {
      reasignadosPorMi:
        'Expedientes cuyo último movimiento operativo relevante fue una reasignación realizada desde el usuario hacia otra persona.',
      reasignadosAMi:
        'Expedientes que actualmente permanecen bajo custodia del usuario en estado REASIGNADO.'
    };
  };
})();
</script>

<!-- V709 · Reasignaciones:
     - REASIGNADOS POR MÍ: detalle alineado con el contador vigente;
     - REASIGNADOS A MÍ: solo custodia actual en estado REASIGNADO;
     - V409 devuelve una fila JSONB por expediente;
     - frontend desenvuelve y aplana correctamente la respuesta del Coordinador;
     - se invalidan snapshots antiguos que podían conservar 0 registros. -->

<script id="v710-selective-modality-script">
(function(){
  'use strict';

  let ctxV710=null;
  let seqV710=0;

  const $=id=>document.getElementById(id);
  const up=v=>String(v??'').trim().toUpperCase();

  function reasonV710(){
    const type=String($('v669ReasonType')?.value||'').trim();
    const detail=String($('v669ReasonDetail')?.value||'').trim();
    if(!type)return '';
    if(type==='OTRO')return detail?`OTRO: ${detail}`:'';
    return detail?`${type}: ${detail}`:type;
  }

  function itemsV710(){
    return Array.isArray(ctxV710?.items)?ctxV710.items:[];
  }

  function byIdV710(){
    return new Map(itemsV710().map(x=>[String(x.expediente_id||''),x]));
  }

  function selectedItemsV710(){
    const map=byIdV710();
    return [...requestSelectedIds]
      .map(id=>map.get(String(id)))
      .filter(Boolean);
  }

  function summarizeModesV710(list,field='modalidad_actual'){
    const counts=new Map();
    (list||[]).forEach(x=>{
      const m=up(x?.[field]||'PRÉSTAMO')||'PRÉSTAMO';
      counts.set(m,(counts.get(m)||0)+1);
    });

    const active=[...counts.entries()].filter(([,n])=>n>0);
    if(!active.length)return '—';
    if(active.length===1)return `${active[0][0]} · ${active[0][1]}`;

    return 'MIXTA · '+active
      .map(([m,n])=>`${m}: ${n}`)
      .join(' · ');
  }

  window.v710ModalityBadge=function(value){
    const m=up(value||'PRÉSTAMO')||'PRÉSTAMO';
    const cls=m==='COPIA DIGITAL'
      ?'digital'
      :(m==='LECTURA EN SALA'?'reading':(m==='MIXTA'?'mixed':'loan'));
    return `<span class="v710-modality-badge ${cls}">${typeof esc==='function'?esc(m):m}</span>`;
  };

  function attachModesToRowsV710(){
    const map=byIdV710();
    (requestDetailRows||[]).forEach(row=>{
      const x=map.get(String(row?.expediente_id||''));
      if(!x)return;
      row.modalidad_original=x.modalidad_original;
      row.modalidad_actual=x.modalidad_actual;
      row.modalidad_atencion=x.modalidad_actual;
      row._v710_puede_cambiar_modalidad=x.puede_cambiar===true;
      row._v710_motivo_bloqueo=x.motivo_bloqueo||'';
    });
  }

  function renderPanelV710(){
    const panel=$('v669ModalitySection');
    if(!panel)return;

    const full=
      typeof hasFullAccess==='function' &&
      hasFullAccess() &&
      !(typeof isCoordinator==='function' && isCoordinator());

    if(!full || !currentRequest){
      panel.classList.add('hidden');
      return;
    }

    panel.classList.remove('hidden');

    const all=itemsV710();
    const selected=selectedItemsV710();
    const blocked=selected.filter(x=>x.puede_cambiar!==true);

    if($('v669OriginalMode')){
      $('v669OriginalMode').textContent=summarizeModesV710(all,'modalidad_original');
    }

    if($('v669CurrentMode')){
      $('v669CurrentMode').textContent=summarizeModesV710(all,'modalidad_actual');
    }

    if($('v669LastChange')){
      const n=selected.length;
      $('v669LastChange').textContent=
        `${n} seleccionado${n===1?'':'s'}${blocked.length?` · ${blocked.length} bloqueado${blocked.length===1?'':'s'}`:''}`;
    }

    ['v669NewMode','v669ReasonType','v669ReasonDetail'].forEach(id=>{
      if($(id))$(id).disabled=false;
    });

    const rule=$('v669ModeRule');
    if(rule){
      if(!selected.length){
        rule.innerHTML='<span class="v710-selection-note">Seleccione uno o varios expedientes en la tabla.</span> Los no seleccionados conservarán su modalidad actual.';
      }else if(blocked.length){
        const names=blocked.map(x=>x.expediente).filter(Boolean).slice(0,6).join(', ');
        rule.innerHTML=`<b>No se puede aplicar todavía.</b> ${blocked.length} expediente${blocked.length===1?'':'s'} seleccionado${blocked.length===1?'':'s'} ya inició o cerró su atención${names?`: ${names}`:''}.`;
      }else{
        const next=up($('v669NewMode')?.value);
        const changing=next
          ?selected.filter(x=>up(x.modalidad_actual)!==next)
          :[];
        const restoringOriginal=
          changing.length>0 &&
          changing.every(x=>up(x.modalidad_original)===next);

        if(restoringOriginal){
          rule.innerHTML=`<b>Restauración de modalidad original.</b> Se devolverá ${changing.length===1?'el expediente seleccionado':'los expedientes seleccionados'} a <b>${next}</b>. Esta corrección no exige que el expediente físico ya esté disponible en Archivo, siempre que todavía no tenga cargo, entrega física ni copia digital entregada.`;
        }else{
          rule.innerHTML=`El cambio se aplicará únicamente a <b>${selected.length} expediente${selected.length===1?'':'s'} seleccionado${selected.length===1?'':'s'}</b>. La solicitud puede quedar con modalidades mixtas.`;
        }
      }
    }

    syncV710();
  }

  function syncV710(){
    const btn=$('v669ChangeModeBtn');
    if(!btn)return;

    const selected=selectedItemsV710();
    const blocked=selected.filter(x=>x.puede_cambiar!==true);
    const next=up($('v669NewMode')?.value);
    const reason=reasonV710();

    const changing=next
      ?selected.filter(x=>up(x.modalidad_actual)!==next)
      :[];

    btn.disabled=!(
      selected.length &&
      !blocked.length &&
      next &&
      reason &&
      changing.length
    );

    const restoringOriginal=
      changing.length>0 &&
      changing.every(x=>up(x.modalidad_original)===next);

    btn.textContent=selected.length
      ?(
        restoringOriginal
          ?`Restaurar ${changing.length} a ${next}`
          :`Aplicar a ${selected.length} seleccionado${selected.length===1?'':'s'}`
       )
      :'Aplicar a seleccionados';
  }

  window.v669SyncChangeButton=function(){
    renderPanelV710();
  };

  window.v710SyncSelectiveModality=renderPanelV710;

  window.v669LoadModeContext=async function(requestId){
    const seq=++seqV710;
    const panel=$('v669ModalitySection');
    const full=
      typeof hasFullAccess==='function' &&
      hasFullAccess() &&
      !(typeof isCoordinator==='function' && isCoordinator());

    if(!full || !requestId){
      if(panel)panel.classList.add('hidden');
      return null;
    }

    panel.classList.remove('hidden');
    if($('v669ModeStatus')){
      $('v669ModeStatus').textContent='Consultando modalidad por expediente…';
    }

    try{
      const {data,error}=await sb.rpc(
        'v710_contexto_modalidad_items',
        {
          p_solicitud_id:requestId,
          p_expediente_ids:null
        }
      );

      if(error)throw error;
      if(seq!==seqV710 || String(currentRequestId||'')!==String(requestId))return null;

      ctxV710=data||{items:[]};
      attachModesToRowsV710();

      if($('v669ModeStatus'))$('v669ModeStatus').textContent='';

      // Volver a pintar la tabla con la modalidad individual.
      if(typeof window.renderRequestDetailItems==='function'){
        window.renderRequestDetailItems();
      }

      // Si una solicitud inicialmente digital quedó mixta (o viceversa),
      // recalcular qué renderer corresponde.
      if(typeof window.renderDigitalRequestDetailV488==='function'){
        try{await window.renderDigitalRequestDetailV488(requestId,true);}catch(_){}
      }

      if(typeof window.renderRequestActions==='function'){
        try{window.renderRequestActions();}catch(_){}
      }

      renderPanelV710();

      // El wrapper antiguo V669 programa un render con setTimeout(0).
      // Reafirmar esta vista después de ese ciclo evita que vuelva a mostrar
      // la modalidad de toda la solicitud.
      setTimeout(renderPanelV710,30);

      return data;
    }catch(error){
      ctxV710=null;
      if($('v669ModeStatus')){
        $('v669ModeStatus').textContent=error?.message||String(error);
      }
      renderPanelV710();
      return null;
    }
  };

  window.v669SubmitModeChange=async function(){
    if(!(typeof hasFullAccess==='function' && hasFullAccess()))return;

    const id=currentRequestId;
    const selected=selectedItemsV710();
    const blocked=selected.filter(x=>x.puede_cambiar!==true);
    const next=up($('v669NewMode')?.value);
    const reason=reasonV710();
    const btn=$('v669ChangeModeBtn');
    const status=$('v669ModeStatus');

    if(!id){
      if(status)status.textContent='No se pudo identificar la solicitud.';
      return;
    }

    if(!selected.length){
      if(status)status.textContent='Seleccione uno o más expedientes en la tabla.';
      return;
    }

    if(blocked.length){
      if(status)status.textContent='La selección contiene expedientes que ya iniciaron o cerraron su atención.';
      return;
    }

    if(!next){
      if(status)status.textContent='Seleccione la nueva modalidad.';
      return;
    }

    if(!reason){
      if(status)status.textContent='Seleccione e indique el motivo del cambio.';
      return;
    }

    const changing=selected.filter(x=>up(x.modalidad_actual)!==next);
    if(!changing.length){
      if(status)status.textContent='Todos los expedientes seleccionados ya tienen esa modalidad.';
      return;
    }

    if(btn){
      btn.disabled=true;
      btn.textContent=`Aplicando a ${changing.length}…`;
    }

    const restoringOriginal=
      changing.length>0 &&
      changing.every(x=>up(x.modalidad_original)===next);

    if(status){
      status.textContent=restoringOriginal
        ?`Restaurando la modalidad original de ${changing.length} expediente${changing.length===1?'':'s'}…`
        :`Actualizando ${changing.length} expediente${changing.length===1?'':'s'} y registrando trazabilidad…`;
    }

    try{
      const {data,error}=await sb.rpc(
        'v710_cambiar_modalidad_items',
        {
          p_solicitud_id:id,
          p_expediente_ids:selected.map(x=>x.expediente_id),
          p_modalidad:next,
          p_motivo:reason
        }
      );

      if(error)throw error;

      if(typeof requestDetailCacheV358!=='undefined' && requestDetailCacheV358?.delete){
        requestDetailCacheV358.delete(String(id));
      }
      try{if(typeof requestViewCache!=='undefined')requestViewCache=null;}catch(_){}

      if(typeof showToast==='function'){
        const changedCount=Number(data?.cambiados||changing.length);
        showToast(
          restoringOriginal
            ?`${changedCount} expediente${changedCount===1?'':'s'} restaurado${changedCount===1?'':'s'} a su modalidad original: ${next}`
            :`${changedCount} expediente${changedCount===1?'':'s'} actualizado${changedCount===1?'':'s'} a ${next}`
        );
      }

      requestSelectedIds.clear();

      if($('v669NewMode'))$('v669NewMode').value='';
      if($('v669ReasonType'))$('v669ReasonType').value='';
      if($('v669ReasonDetail'))$('v669ReasonDetail').value='';
      $('v669ReasonDetailBox')?.classList.add('hidden');

      const jobs=[];
      if(typeof loadSummary==='function')jobs.push(loadSummary());
      if(typeof loadRequests==='function')jobs.push(loadRequests());
      if(typeof loadAll==='function')jobs.push(loadAll());
      if(typeof loadStates==='function')jobs.push(loadStates());
      await Promise.allSettled(jobs);

      await window.openRequestDetail(id);
    }catch(error){
      if(status)status.textContent=error?.message||String(error);
    }finally{
      if(btn)btn.textContent='Aplicar a seleccionados';
      setTimeout(renderPanelV710,20);
    }
  };

  // Mantener el botón sincronizado con cada selección/deselección.
  const baseRenderItemsV710=window.renderRequestDetailItems;
  if(typeof baseRenderItemsV710==='function'){
    window.renderRequestDetailItems=function(){
      const result=baseRenderItemsV710.apply(this,arguments);
      setTimeout(renderPanelV710,0);
      return result;
    };
  }

  const baseRenderActionsV710=window.renderRequestActions;
  if(typeof baseRenderActionsV710==='function'){
    window.renderRequestActions=function(){
      const result=baseRenderActionsV710.apply(this,arguments);
      setTimeout(renderPanelV710,20);
      return result;
    };
  }

  // Protección visual antes de llamar al backend de cargo.
  const baseNewCargoV710=window.assignNewCargoToAccepted;
  if(typeof baseNewCargoV710==='function'){
    window.assignNewCargoToAccepted=async function(){
      const selected=new Set([...requestSelectedIds].map(String));
      const bad=(requestDetailRows||[]).filter(
        r=>selected.has(String(r.expediente_id||'')) &&
           up(r.modalidad_atencion||r.modalidad_actual||currentRequest?.modalidad)!=='PRÉSTAMO'
      );
      if(bad.length){
        if($('rqActionStatus')){
          $('rqActionStatus').textContent=
            'El cargo físico solo puede incluir expedientes cuya modalidad actual sea PRÉSTAMO. Retire de la selección: '+
            bad.map(r=>r.expediente).filter(Boolean).join(', ');
        }
        return;
      }
      return await baseNewCargoV710.apply(this,arguments);
    };
  }

  const baseExistingCargoV710=window.assignExistingCargoToAccepted;
  if(typeof baseExistingCargoV710==='function'){
    window.assignExistingCargoToAccepted=async function(){
      const selected=new Set([...requestSelectedIds].map(String));
      const bad=(requestDetailRows||[]).filter(
        r=>selected.has(String(r.expediente_id||'')) &&
           up(r.modalidad_atencion||r.modalidad_actual||currentRequest?.modalidad)!=='PRÉSTAMO'
      );
      if(bad.length){
        if($('rqActionStatus')){
          $('rqActionStatus').textContent=
            'Un cargo existente solo puede vincularse a expedientes con modalidad PRÉSTAMO. Retire de la selección: '+
            bad.map(r=>r.expediente).filter(Boolean).join(', ');
        }
        return;
      }
      return await baseExistingCargoV710.apply(this,arguments);
    };
  }

  window.v710ModalityInfo=function(){
    return {
      version:'V710',
      regla:'Archivo/Admin cambia modalidad por expediente seleccionado; una misma solicitud puede contener PRÉSTAMO, COPIA DIGITAL y LECTURA EN SALA.'
    };
  };
})();
</script>

<!-- V710 · Modalidad selectiva por expedientes:
     - 1, varios o todos los seleccionados;
     - modalidad individual dentro de una misma solicitud;
     - cambio auditado por expediente;
     - COPIA DIGITAL selectiva aparece en la bandeja digital;
     - cargo físico bloqueado para ítems que no sean PRÉSTAMO. -->

<!-- V711 · Restauración de modalidad original:
     - si un expediente fue cambiado por error, puede volver a su modalidad original;
     - no se exige disponibilidad física en Archivo para una restauración;
     - sigue bloqueado si ya existe cargo, entrega física, devolución o copia digital entregada;
     - el cambio conserva motivo, usuario, fecha e historial. -->

<script id="v712-panel-cache-reset">
(function(){
  'use strict';

  try{
    const resetKey='v712_panel_cache_reset';
    if(sessionStorage.getItem(resetKey)!=='1'){
      for(let i=sessionStorage.length-1;i>=0;i--){
        const key=sessionStorage.key(i)||'';
        if(
          key.startsWith('v353_panel_snapshot_') ||
          key.startsWith('v637_user_summary_')
        ){
          sessionStorage.removeItem(key);
        }
      }
      sessionStorage.setItem(resetKey,'1');
    }
  }catch(_){}

  try{
    if(
      typeof v179PanelViewCache!=='undefined' &&
      v179PanelViewCache &&
      typeof v179PanelViewCache.clear==='function'
    ){
      v179PanelViewCache.clear();
    }
  }catch(_){}
})();
</script>

<!-- V712 · Consistencia tarjeta ↔ detalle:
     - los clics en tarjetas consultan datos frescos;
     - snapshots con cantidad distinta al contador se descartan;
     - se limpian snapshots heredados de versiones anteriores;
     - aplica a perfiles personales y Expedientes por usuario. -->
<!-- V715 · Recuperación de tarjetas + préstamos vigentes; base estable V712 -->
<script id="v715-recovery-loans" >
(function(){
  'use strict';
  const E=id=>document.getElementById(id);
  const n=v=>String(v??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toUpperCase();
  const ttl=45000;
  const safeItems=new Map();
  const flights=new Map();
  let lastError='';
  const inOther=()=>typeof v629IsOtherUser==='function'&&v629IsOtherUser();
  function sessionId(){try{return String(session?.user?.id||'');}catch(_){return '';}}
  function context(){
    try{
      if(!sessionId()||!sb)return null;
      if(inOther())return null; // V629 ya se actualiza por una sola consulta consolidada.
      if(isLimitedUser()){
        if(!currentProfile?.nombre_personal || isCoordinatorSelfWorkspaceV206() || isStaffPersonalWorkspaceV319())return null;
        return {kind:'own',name:String(currentProfile.nombre_personal),key:sessionId()+'|OWN'};
      }
      if(hasFullAccess()&&selectedOwnerIsUser()&&selectedOwner){
        return {kind:'admin',name:String(selectedOwner),key:sessionId()+'|ADMIN|'+n(selectedOwner)};
      }
    }catch(_){ }
    return null;
  }
  function isCurrent(c){const now=context();return !!c&&!!now&&now.key===c.key;}
  function cache(c){const r=c&&safeItems.get(c.key);return r&&Date.now()-r.at<ttl?r:null;}
  function paint(c, count){
    if(!isCurrent(c))return;
    const id=c.kind==='own'?'uKLoan':'kLoan';
    if(E(id))E(id).textContent=String(count);
    if(c.kind==='own'){
      userPanelSummary={...(userPanelSummary||{}),en_prestamo:count};
      // V715 no graba un número provisional ni destruye otros resúmenes.
    }else{
      ownerUserKpiSummary={...(ownerUserKpiSummary||{}),en_prestamo:count};
      const row=(Array.isArray(ownerCardsRows)?ownerCardsRows:[])
        .find(x=>n(x?.nombre)===n(c.name));
      if(row)row.en_prestamo=count;
    }
  }
  async function verify(c,force=false){
    if(!c||!isCurrent(c))return null;
    const stored=!force&&cache(c);
    if(stored){paint(c,stored.count);return stored.count;}
    if(flights.has(c.key))return flights.get(c.key);
    const work=(async()=>{
      const response=c.kind==='own'
        ?await sb.rpc('listar_mi_tarjeta_v5',{p_tipo:'PRESTAMO',p_busqueda:null})
        :await sb.rpc('listar_tarjeta_usuario_admin_v5',{p_nombre:c.name,p_tipo:'PRESTAMO',p_busqueda:null});
      if(response.error)throw response.error;
      if(!Array.isArray(response.data))throw new Error('La respuesta del préstamo no es una lista válida.');
      if(!isCurrent(c))return null;
      const matching=response.data.filter(r=>
        n(r?.estado_operativo||r?.estado_solicitud_item||r?.estado)==='EN PRESTAMO'&&
        n(r?.modalidad)!=='COPIA DIGITAL');
      if(matching.length!==response.data.length)throw new Error('La relación de préstamos contiene estados incoherentes.');
      const result={count:matching.length,at:Date.now()};
      safeItems.set(c.key,result);
      paint(c,result.count);
      return result.count;
    })().catch(e=>{
      lastError=String(e?.message||e);
      console.warn('V715 · no se confirmó la tarjeta de préstamos:',lastError);
      return null; // Jamás convertir un error a 0.
    }).finally(()=>flights.delete(c.key));
    flights.set(c.key,work);
    return work;
  }
  const loadSummary=window.loadUserPersonalSummary;
  if(typeof loadSummary==='function'){
    window.loadUserPersonalSummary=async function(){
      const result=await loadSummary.apply(this,arguments);
      const c=context();
      if(c?.kind==='own')verify(c,false).catch(()=>{});
      return result;
    };
  }
  const applySummary=window.applyUserSummaryV184;
  if(typeof applySummary==='function'){
    window.applyUserSummaryV184=function(value){
      const c=context();
      const stored=c?.kind==='own'?cache(c):null;
      const corrected=stored?{...(value||{}),en_prestamo:stored.count}:value;
      const result=applySummary.call(this,corrected);
      if(stored)paint(c,stored.count);
      return result;
    };
  }
  const adminKpis=window.syncSelectedOwnerKpisFromCards;
  if(typeof adminKpis==='function'){
    window.syncSelectedOwnerKpisFromCards=function(){
      const result=adminKpis.apply(this,arguments);
      const c=context();
      if(c?.kind==='admin')verify(c,false).catch(()=>{});
      return result;
    };
  }
  const oldPanel=window.loadPanel;
  if(typeof oldPanel==='function'){
    window.loadPanel=async function(options={}){
      let loan=false;
      let c=context();
      try{
        loan=!String(E('searchInput')?.value||'').trim()&&(
          (inOther()&&String(panelQuickFilter||'').toLowerCase()==='loan')||
          (c?.kind==='own'&&n(userPanelMode)==='PRESTAMO')||
          (c?.kind==='admin'&&String(panelQuickFilter||'').toLowerCase()==='loan')
        );
      }catch(_){ }
      // Solo esta tarjeta requiere evitar un snapshot anterior.
      const safe=options&&typeof options==='object'?options:{};
      const result=await oldPanel.call(this,loan?{...safe,forceFresh:true,refreshCards:false}:safe);
      if(loan&&!String(E('searchInput')?.value||'').trim()&&c&&isCurrent(c)){
        const text=String(E('panelTable')?.textContent||'');
        const isError=/no se pudo|error de consulta|consulta no disponible/i.test(text);
        if(!isError&&Number.isInteger(panelCount)&&panelCount>=0&&
            (panelCount===0||(Array.isArray(panelRows)&&panelRows.length))){
          safeItems.set(c.key,{count:panelCount,at:Date.now()});
          paint(c,panelCount);
        }
      }
      return result;
    };
  }
  window.v715Info=()=>({version:'V715',consultasCacheadas:safeItems.size,ultimaAdvertencia:lastError});
})();
</script>
<!-- V716 · Coordinador usa V409 (misma fuente de Archivo/Admin), no V412 histórico -->
<script id="v716-coordinador-detalle-fuente-vigente">
(function(){
  'use strict';
  // V412 consulta e.responsable, que puede quedar en ARCHIVO DE GESTIÓN
  // aun cuando la relación activa registre EN PRÉSTAMO con otro responsable.
  // V409 está protegida por la autorización del Coordinador/Equipo en Supabase
  // y reutiliza listar_tarjeta_usuario_admin_v5 / v_custodia_usuario_v5.
  const E=id=>document.getElementById(id);
  const U=v=>String(v??'').trim().normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase();
  const types=new Map([
    ['TODOS','CUSTODIA'],
    ['CUSTODIA','CUSTODIA'],
    ['TOTAL EN CUSTODIA','CUSTODIA'],
    ['PRESTAMO','PRESTAMO'],
    ['EN PRESTAMO','PRESTAMO'],
    ['REASIGNADOS A MI','REASIGNADOS_A_MI'],
    ['REASIGNADO','REASIGNADOS_A_MI'],
    ['DEVOLUCION SOLICITADA','DEVOLUCION_SOLICITADA']
  ]);
  const normalType=type=>types.get(U(type).replaceAll('_',' '))||null;
  let latestError='';
  let lastFetch=null;

  async function fetchCurrentCycle(nombre,type,search){
    const p_tipo=normalType(type);
    if(!p_tipo)throw new Error('La tarjeta no corresponde al detalle de custodia vigente.');
    if(!sb||!session)throw new Error('No hay una sesión activa en Supabase.');
    const name=String(nombre||'').trim();
    if(!name)throw new Error('No se indicó un usuario para consultar.');
    // Esta RPC valida identidad, rol y pertenencia del equipo; no consultar
    // _listar_tarjeta_usuario_core_v5 directamente desde el navegador.
    const result=await coordinatorCardRpcV404({
      p_nombre:name,
      p_tipo,
      p_busqueda:typeof cleanSearch==='function'
        ?cleanSearch(search||'')||null
        :String(search||'').trim()||null
    });
    if(result?.error){
      latestError=String(result.error.message||result.error);
      throw result.error;
    }
    if(!Array.isArray(result?.data)){
      latestError='La consulta V409 no devolvió una lista válida.';
      throw new Error(latestError);
    }
    let rows=typeof v211JsonRows==='function'
      ?v211JsonRows(result.data)
      :result.data;
    if(!Array.isArray(rows))throw new Error('La consulta devolvió un detalle no válido.');
    if((p_tipo==='PRESTAMO'||p_tipo==='CUSTODIA') &&
       typeof enrichArchiveAttendantV686==='function'){
      try{rows=await enrichArchiveAttendantV686(rows);}catch(error){
        console.warn('V716 · No se pudo enriquecer el personal que atendió:',error);
      }
    }
    lastFetch={nombre:name,tipo:p_tipo,cantidad:rows.length,fecha:new Date().toISOString()};
    latestError='';
    return rows;
  }

  // Solo coordinadores en su espacio personal: resto de roles sin cambios.
  const previousSelf=window.coordinatorSelfCardRowsV207;
  if(typeof previousSelf==='function'){
    window.coordinatorSelfCardRowsV207=async function(type,search=''){
      if(typeof isCoordinatorSelfWorkspaceV206==='function'&&
         isCoordinatorSelfWorkspaceV206()&&normalType(type)){
        return fetchCurrentCycle(currentProfile?.nombre_personal,type,search);
      }
      return previousSelf.apply(this,arguments);
    };
  }

  // Para integrantes del equipo, la misma ruta segura valida permisos.
  const previousTeam=window.coordinatorTeamRowsV218;
  if(typeof previousTeam==='function'){
    window.coordinatorTeamRowsV218=async function(nombre,type,search=''){
      if(typeof isCoordinatorTeamWorkspaceV206==='function'&&
         isCoordinatorTeamWorkspaceV206()&&normalType(type)){
        return fetchCurrentCycle(nombre,type,search);
      }
      return previousTeam.apply(this,arguments);
    };
  }

  // Al consultar Préstamos, reflejar el tamaño de esa MISMA respuesta en su
  // tarjeta, pero sin confundir un error de red con una lista vacía.
  const previousLoadPanel=window.loadPanel;
  if(typeof previousLoadPanel==='function'){
    window.loadPanel=async function(options={}){
      const source=lastFetch;
      const result=await previousLoadPanel.apply(this,arguments);
      try{
        if(typeof isCoordinatorSelfWorkspaceV206==='function'&&
           isCoordinatorSelfWorkspaceV206()&&
           U(userPanelMode)==='PRESTAMO'&&
           !String(E('searchInput')?.value||'').trim()&&
           latestError===''&&
           lastFetch&&lastFetch!==source&&
           lastFetch.tipo==='PRESTAMO'&&
           U(lastFetch.nombre)===U(currentProfile?.nombre_personal)&&
           Number.isInteger(panelCount)&&panelCount===lastFetch.cantidad){
          userPanelSummary={...(userPanelSummary||{}),en_prestamo:panelCount};
          if(E('uKLoan'))E('uKLoan').textContent=String(panelCount);
        }
      }catch(error){console.warn('V716 · contador del panel:',error);}
      return result;
    };
  }

  // La V712 ejecutaba la limpieza una sola vez y podía dejar snapshots en 0.
  // Se limpia SOLO el cache visual de la sesión; ninguna tabla Supabase.
  try{
    const resetKey='v716_current_cycle_cache_reset';
    if(sessionStorage.getItem(resetKey)!=='1'){
      for(let i=sessionStorage.length-1;i>=0;i--){
        const k=sessionStorage.key(i)||'';
        if(k.startsWith('v353_panel_snapshot_')||
           k.startsWith('v637_user_summary_')||
           k.startsWith('v207_user_summary_')){
          sessionStorage.removeItem(k);
        }
      }
      if(typeof invalidatePanelViewCacheV179==='function')
        invalidatePanelViewCacheV179();
      sessionStorage.setItem(resetKey,'1');
    }
  }catch(error){console.warn('V716 · limpieza de cache visual:',error);}

  window.v716CoordinatorLoanInfo=()=>({
    version:'V716',
    vista:'v_custodia_usuario_v5 vía V409',
    rpc:'v409_coordinador_tarjeta_equipo',
    ultimoResultado:lastFetch,
    ultimoError:latestError
  });
})();
</script>

