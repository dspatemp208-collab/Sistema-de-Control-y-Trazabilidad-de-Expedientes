/* V809: lista compacta de contactos. Neutraliza la cuadrícula heredada de V807,
   que estiraba una sola coincidencia hasta la altura completa del panel. */
#v804Overlay .v808-mail-panel #v804Recipients.v807-recipient-list {
  display:block;
  box-sizing:border-box;
  height:272px;
  min-height:0;
  max-height:272px;
  margin:0;
  padding:3px 5px;
  overflow-y:auto;
  overflow-x:hidden;
  overscroll-behavior:contain;
  grid-template-columns:none;
  gap:0;
  background:#fff;
}
