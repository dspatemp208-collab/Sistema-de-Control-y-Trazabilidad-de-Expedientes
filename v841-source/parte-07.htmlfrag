<script id="v694-user-location-script">
(function(){
  'use strict';

  // Render compacto: se conserva la información, pero sin ensanchar la tabla.
  window.userLocationHtml=function(notice){
    if(!notice)return '<span style="color:var(--muted)">—</span>';
    const sede=String(notice.sede||'UBICACIÓN VERIFICADA').trim();
    const note=String(notice.observacion||'').replace(/\s+/g,' ').trim();
    const short=note.length>62?note.slice(0,61).trimEnd()+'…':note;
    return `<span class="pill returned" title="Ubicación comunicada; no reemplaza la custodia física actual">📍 ${esc(sede)}</span>
      <span class="v694-location-date">${fmtDate(notice.created_at)} ${fmtTime(notice.created_at)}</span>
      ${short?`<span class="v694-location-note" title="${esc(note)}">${esc(short)}</span>`:''}`;
  };

  function markHeader(){
    const table=document.querySelector('#panelTable table');
    if(!table?.tHead?.rows?.[0])return;
    [...table.tHead.rows[0].cells].forEach(th=>{
      if(String(th.textContent||'').trim()==='Ubicación')th.classList.add('v694-user-location-head');
    });
  }

  const observer=new MutationObserver(()=>{
    markHeader();
  });
  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',()=>{
      const panel=document.getElementById('panelTable');
      if(panel)observer.observe(panel,{childList:true,subtree:true});
      markHeader();
    },{once:true});
  }else{
    const panel=document.getElementById('panelTable');
    if(panel)observer.observe(panel,{childList:true,subtree:true});
    markHeader();
  }
})();
</script>
