<script id="v629-owner-switcher">
(function(){
  'use strict';

  const ownerDirectory=[];
  let directoryLoadedAt=0;
  let kpiSeq=0;
  const summaryCache=new Map();
  const SUMMARY_TTL=60000;

  const key=v=>String(v??'').trim().normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase();
  const escAttr=v=>String(v??'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

  function selfName(){ return String(currentProfile?.nombre_personal||'').trim(); }

  window.v629IsOtherUser=function(){
    const self=selfName();
    const target=String(selectedOwner||'').trim();
    return !!(isLimitedUser() && self && target && key(target)!==key(self));
  };

  function mergeOwner(rows){
    (Array.isArray(rows)?rows:[]).forEach(row=>{
      const nombre=String(row?.nombre_personal||row?.nombre||'').trim();
      if(!nombre)return;
      const k=key(nombre);
      if(!k)return;
      const existing=ownerDirectory.find(x=>key(x.nombre)===k);
      if(existing){
        existing.rol=existing.rol||row?.rol||'';
        existing.area=existing.area||row?.area_coordinacion||row?.area_trabajo||row?.area||'';
        return;
      }
      ownerDirectory.push({
        nombre,
        rol:String(row?.rol||'USUARIO').trim().toUpperCase(),
        area:String(row?.area_coordinacion||row?.area_trabajo||row?.area||'').trim()
      });
    });
  }

  function mergeLocalOwners(){
    mergeOwner(typeof userProfiles!=='undefined'?userProfiles:[]);
    mergeOwner(typeof abogadoProfiles!=='undefined'?abogadoProfiles:[]);
    try{
      mergeOwner((catalogo||[])
        .filter(x=>x?.activo!==false && norm(x?.tipo)==='PERSONAL')
        .map(x=>({nombre:x.nombre,rol:'USUARIO',area:x.area_trabajo||''})));
    }catch(_){ }
    const self=selfName();
    if(self)mergeOwner([{nombre:self,rol:currentProfile?.rol||'USUARIO'}]);
  }

  function paintDirectory(){
    const list=document.getElementById('v629OwnerOptions');
    if(!list)return;
    ownerDirectory.sort((a,b)=>a.nombre.localeCompare(b.nombre,'es'));
    list.innerHTML=ownerDirectory.map(x=>
      `<option value="${escAttr(x.nombre)}">${escAttr([x.rol,x.area].filter(Boolean).join(' · '))}</option>`
    ).join('');
  }

  window.v629RefreshOwnerOptions=async function(force=false){
    mergeLocalOwners();
    const fresh=(Date.now()-directoryLoadedAt)<900000 && ownerDirectory.length>1;
    if(!force && fresh){ paintDirectory(); return ownerDirectory; }

    if(sb&&session){
      try{
        const {data,error}=await sb.rpc('listar_usuarios_abogados');
        if(!error)mergeOwner(data||[]);
      }catch(error){
        console.warn('V629 · directorio de usuarios:',error?.message||error);
      }
    }
    directoryLoadedAt=Date.now();
    paintDirectory();
    return ownerDirectory;
  };

  function resolveOwner(raw){
    const value=String(raw||'').trim();
    if(!value)return '';
    const found=ownerDirectory.find(x=>key(x.nombre)===key(value));
    if(found)return found.nombre;
    try{
      const canonical=canonicalOwnerNameV392(value);
      if(canonical && ownerNameIsSelectableV392(canonical))return canonical;
    }catch(_){ }
    return '';
  }

  window.v629OwnerInputChanged=async function(){
    await v629RefreshOwnerOptions(false);
    const input=el('selectedOwnerDisplay');
    const target=resolveOwner(input?.value||'');
    if(!target){
      if(input)input.value=selectedOwner||selfName();
      toast('Seleccione un usuario de la lista.');
      return;
    }
    await v629ActivateOwner(target,'custody');
  };

  window.v629OwnerInputKeydown=function(event){
    if(event.key==='Enter'){
      event.preventDefault();
      v629OwnerInputChanged();
    }else if(event.key==='Escape'){
      event.preventDefault();
      if(el('selectedOwnerDisplay'))el('selectedOwnerDisplay').value=selfName();
      v629ActivateOwner(selfName(),'custody');
    }
  };

  window.v629SyncOwnerMode=function(){
    const other=v629IsOtherUser();
    document.body.classList.toggle('v629-other-user-view',other);
    document.querySelector('.app')?.classList.toggle('v629-other-user-view',other);

    if(el('selectedOwnerDisplay') && document.activeElement!==el('selectedOwnerDisplay')){
      el('selectedOwnerDisplay').value=(typeof isCoordinatorTeamWorkspaceV206==='function'&&isCoordinatorTeamWorkspaceV206()&&!selectedOwner)?'':(selectedOwner||selfName());
    }

    if(!isLimitedUser())return;

    if(el('ownerSelectedUserField'))el('ownerSelectedUserField').classList.remove('hidden-by-role');
    if(el('userPersonalKpis')){
      el('userPersonalKpis').classList.toggle('hidden-by-role',other);
      el('userPersonalKpis').classList.toggle('hidden',other);
    }
    if(el('fullAccessKpis')){
      el('fullAccessKpis').classList.toggle('hidden-by-role',!other);
      el('fullAccessKpis').classList.toggle('hidden',!other);
    }
    if(el('ownerStateField'))el('ownerStateField').classList.toggle('hidden',!other);
    if(el('ownerBackWrap'))el('ownerBackWrap').classList.toggle('hidden',!other);

    ['bulkReassignBtn','bulkReturnBtn'].forEach(id=>{
      if(el(id))el(id).classList.toggle('hidden-by-role',other);
    });
    if(other){ selectedIds.clear(); updateSelectionUI(); }
  };

  window.v629ActivateOwner=async function(rawName,initialFilter='custody'){
    await v629RefreshOwnerOptions(false);
    const target=resolveOwner(rawName);
    if(!target){ toast('No se encontró el usuario seleccionado.'); return; }

    const self=selfName();
    selectedIds.clear();
    page=0;
    selectedAreaFilter='';

    if(key(target)===key(self)){
      selectedOwner=self;
      panelQuickFilter='';
      userPanelMode='TODOS';
      if(el('searchInput'))el('searchInput').value='';
      applyRoleUI();
      updateOwnerPanelVisibility();
      v629SyncOwnerMode();
      await loadUserPersonalSummary();
      await loadPanel({refreshCards:false});
      return;
    }

    selectedOwner=target;
    panelQuickFilter=['custody','loan','reassigned','pending_attention','pending','returns','alert'].includes(initialFilter)
      ?initialFilter:'custody';
    userPanelMode='TODOS';
    if(el('searchInput'))el('searchInput').value='';
    if(el('ownerStateFilter'))el('ownerStateFilter').value=panelQuickFilter;

    applyRoleUI();
    updateOwnerPanelVisibility();
    v629SyncOwnerMode();
    renderKpis();
    await loadPanel({refreshCards:false});
  };

  function coreType(filter){
    return ({
      custody:'CUSTODIA',
      loan:'PRESTAMO',
      reassigned:'REASIGNADOS_A_MI',
      pending_attention:'PENDIENTES_POR_ATENDER',
      pending:'DEVOLUCION_SOLICITADA',
      returns:'DEVUELTOS_AL_ARCHIVO',
      alert:'CUSTODIA'
    })[filter]||'CUSTODIA';
  }

  async function enrichCustodyDates(rows){
    const list=Array.isArray(rows)?rows:[];
    const ids=[...new Set(list.map(r=>String(r?.id||r?.expediente_id||'').trim()).filter(Boolean))];
    if(!ids.length)return list;
    try{
      const {data,error}=await sb.rpc('v627_fechas_custodia_actual',{p_expediente_ids:ids});
      if(error)throw error;
      const map=new Map((data||[]).map(x=>[String(x.expediente_id),x]));
      return list.map(r=>{
        const id=String(r?.id||r?.expediente_id||'');
        const f=map.get(id)||{};
        return {...r,
          fecha_inicio_custodia:f.fecha_inicio_custodia||r.fecha_inicio_custodia||null,
          fecha_inicio_custodia_vigente:f.fecha_inicio_custodia||r.fecha_inicio_custodia_vigente||null,
          movimiento_inicio_custodia:f.movimiento_custodia||r.movimiento_inicio_custodia||'',
          custodia_desde:f.desde||r.custodia_desde||'',
          custodia_hacia:f.hacia||r.custodia_hacia||'',
          dias_custodia:Number(f.dias_habiles??r.dias_custodia??0),
          _v629_solo_lectura:true
        };
      });
    }catch(error){
      console.warn('V629 · fecha de custodia:',error?.message||error);
      return list.map(r=>({...r,_v629_solo_lectura:true}));
    }
  }

  window.v629FetchOtherRows=async function(name,filter='custody',search=''){
    const type=coreType(filter);
    const {data,error}=await sb.rpc('_listar_tarjeta_usuario_core_v5',{
      p_nombre:name,
      p_tipo:type,
      p_busqueda:cleanSearch(search||'')||null
    });
    if(error)throw error;

    let rows=Array.isArray(data)?data:[];
    rows=window.v745FilterCardRows(rows,search);
    rows=await enrichCustodyDates(rows);

    if(filter==='alert')rows=rows.filter(r=>Number(r?.dias_custodia||0)>30);
    if(filter==='pending_attention'){
      try{ rows=await enrichPendingAttentionRequestTimes(rows); }catch(_){ }
    }
    return rows;
  };

  async function otherSummary(name){
    const cacheKey=key(name);
    const cached=summaryCache.get(cacheKey);
    if(cached && Date.now()-cached.savedAt<SUMMARY_TTL)return cached.data;

    const {data,error}=await sb.rpc('v646_resumen_usuarios_agrupado',{p_nombres:[name]});
    if(error)throw error;
    const rows=Array.isArray(data)?data:[];
    const result=rows.find(x=>key(x?.nombre||'')===key(name))||rows[0]||{};
    summaryCache.set(cacheKey,{savedAt:Date.now(),data:result});
    return result;
  }

  // V715 · Los resultados parciales NO se interpretan como base vacía.
  // El resumen de otro perfil es independiente del detalle de custodia.
  // El préstamo se cuenta a partir de la misma relación que abrirá la tarjeta.
  window.v629RefreshOtherKpis=async function(name){
    if(!v629IsOtherUser() || !name || !sb || !session)return;
    const seq=++kpiSeq;
    const current=key(name);
    const ids=['kTotal','kLoan','kReassigned','kPendingAttention','kPending','kReturnedHistory','kAlert'];
    ids.forEach(id=>{if(el(id))el(id).textContent='…';});

    const [summaryResult,custodyResult]=await Promise.allSettled([
      otherSummary(name),
      v629FetchOtherRows(name,'custody','')
    ]);
    if(seq!==kpiSeq || !v629IsOtherUser() || key(selectedOwner)!==current)return;

    const summaryOk=summaryResult.status==='fulfilled';
    const custodyOk=custodyResult.status==='fulfilled' && Array.isArray(custodyResult.value);
    const summary=summaryOk?(summaryResult.value||{}):{};
    const rows=custodyOk?custodyResult.value:[];
    if(summaryOk){
      if(el('kPendingAttention'))el('kPendingAttention').textContent=Number(summary.pendientes_por_atender||0);
      if(el('kReturnedHistory'))el('kReturnedHistory').textContent=Number(summary.devueltos_al_archivo||0);
      if(el('kAlert'))el('kAlert').textContent=Number(summary.alertas_30||0);
    }
    if(custodyOk){
      const physical=rows.filter(r=>key(r?.modalidad)!=='COPIA DIGITAL');
      const status=r=>key(r?.estado_operativo||r?.estado_solicitud_item||r?.estado||'');
      const count=state=>physical.filter(r=>status(r)===state).length;
      const loans=count('EN PRESTAMO');
      const reassigned=count('REASIGNADO');
      const returning=count('DEVOLUCION SOLICITADA');
      const countByState=loans+reassigned+returning;
      if(el('kTotal'))el('kTotal').textContent=String(countByState);
      if(el('kLoan'))el('kLoan').textContent=String(loans);
      if(el('kReassigned'))el('kReassigned').textContent=String(reassigned);
      if(el('kPending'))el('kPending').textContent=String(returning);
      renderKpiStateSummary('kTotalStates',physical);
      // Los 4 valores anteriores salen de las MISMAS filas, sin inventar registros.
    }else if(summaryOk){
      // Si falla la lectura detallada, se conserva el resumen real, no se pone cero.
      if(el('kTotal'))el('kTotal').textContent=Number(summary.total_custodia||0);
      if(el('kLoan'))el('kLoan').textContent=Number(summary.en_prestamo||0);
      if(el('kReassigned'))el('kReassigned').textContent=Number(summary.reasignados_a_mi||0);
      if(el('kPending'))el('kPending').textContent=Number(summary.devolucion_solicitada||0);
    }
    if(!summaryOk || !custodyOk){
      console.warn('V715 · una fuente de tarjetas no respondió:',
        !summaryOk?summaryResult.reason:'',!custodyOk?custodyResult.reason:'');
      ids.forEach(id=>{if(el(id) && el(id).textContent==='…')el(id).textContent='—';});
    }
    updateKpiQuickUI();
  };

  function readOnlyTable(rows){
    if(!rows.length)return '<div class="empty">No hay expedientes para esta selección.</div>';
    const v681Filter=String(typeof panelQuickFilter!=='undefined'?panelQuickFilter:'').toLowerCase();
    const v675ShowReassignment=(
      v681Filter==='reassigned'
        ? rows.length>0
        : v681Filter==='custody'
    );
    return `<div class="v629-readonly-note">👁 Consulta de otro usuario · solo lectura</div>
      <table class="v629-readonly-table">
        <thead><tr>
          <th>Expediente</th><th>Extensión</th><th>R.D.</th><th class="subject-cell-v639">Asunto</th>
          <th>Responsable actual / ubicación</th><th>Estado</th>${v675ShowReassignment?'<th>Reasignación (De → A)</th>':''}<th>Días en custodia</th>
          <th>Inicio de custodia vigente</th><th>Último folio</th><th>Cargo</th><th></th>
        </tr></thead>
        <tbody>${rows.map(r=>`<tr>
          <td><b>${esc(r.expediente||'—')}</b></td>
          <td>${esc(r.extension||'—')}</td>
          <td>${esc(r.rd||'—')}</td>
          <td class="subject-cell-v455 subject-cell-v639" title="${esc(expedienteAsuntoValue(r)||'')}"><div class="subject-text-v639">${esc(expedienteAsuntoValue(r)||'—')}</div></td>
          <td><b>${esc(currentResponsibleDisplay(r)||'—')}</b></td>
          <td>${rowStatus(r)}</td>
          ${v675ShowReassignment?`<td>${v681Filter==='custody'?reassignmentRouteCustodyV683(r):reassignmentRouteHtmlV675(r)}</td>`:''}
          <td>${custodyDaysHtmlV221(r)||'0'}</td>
          <td>${r.fecha_inicio_custodia_vigente?masterDateTimeHtml(r.fecha_inicio_custodia_vigente):'—'}
            ${r.movimiento_inicio_custodia?`<span class="v629-owner-sub">${esc(r.movimiento_inicio_custodia)}</span>`:''}
          </td>
          <td>${esc(r.ultimo_folio||'—')}</td>
          <td>${esc(r.cargo_numero||r.cargo||'—')}</td>
          <td>${cycleHistoryButton(r.id||r.expediente_id,r)}</td>
        </tr>`).join('')}</tbody>
      </table>`;
  }

  window.v629LoadOtherPanel=async function({from=0,to=9,panelLoadIsCurrent=()=>true}={}){
    const owner=String(selectedOwner||'').trim();
    const filter=['custody','loan','reassigned','pending_attention','pending','returns','alert'].includes(panelQuickFilter)
      ?panelQuickFilter:'custody';
    const search=cleanSearch(el('searchInput')?.value||'');

    if(el('panelTitle'))el('panelTitle').textContent=`Expedientes de ${owner} · ${ownerPanelLoadingLabel(filter)}`;
    if(el('pageInfo'))el('pageInfo').textContent='Consultando...';

    try{
      const all=await v629FetchOtherRows(owner,filter,search);
      if(!panelLoadIsCurrent())return;
      panelCount=all.length;
      panelRows=all.slice(from,to+1);
      const first=panelCount?from+1:0;
      const last=Math.min(to+1,panelCount);
      if(el('panelTitle'))el('panelTitle').textContent=`Expedientes de ${owner} · ${panelQuickLabel()||'Total en custodia'}`;
      if(el('pageInfo'))el('pageInfo').textContent=`${first} - ${last} de ${panelCount} registros`;

      if(filter==='pending_attention'){
        el('panelTable').innerHTML=renderUserPendingAttentionRows(panelRows,false);
      }else if(filter==='returns'){
        el('panelTable').innerHTML=renderOwnerHistoricalReturnsTable(panelRows,owner);
      }else{
        el('panelTable').innerHTML=readOnlyTable(panelRows);
      }
      updateKpiQuickUI();
    }catch(error){
      if(!panelLoadIsCurrent())return;
      // V715: error de acceso/red != 0 expedientes: no borrar totales ni presentar ausencia falsa.
      if(el('pageInfo'))el('pageInfo').textContent='Consulta no disponible · reintentar';
      if(el('panelTable'))el('panelTable').innerHTML=`<div class="empty"><b>No se pudo actualizar la consulta de ${esc(owner)}.</b><br>${esc(error?.message||String(error))}<br><button class="btn secondary small" onclick="loadPanel({forceFresh:true,refreshCards:false})">Reintentar</button></div>`;
    }
  };

  function install(){
    v629RefreshOwnerOptions(false).catch(()=>{});
    v629SyncOwnerMode();
    const input=el('selectedOwnerDisplay');
    if(input){
      input.removeAttribute('readonly');
      input.setAttribute('placeholder','Escriba el nombre del usuario');
      input.title='Escriba un nombre y seleccione una opción para consultar sus tarjetas.';
    }
  }

  window.v629OwnerSwitcherInfo=()=>({
    version:'V629',
    perfiles:'TODOS',
    selector_escribible:true,
    consulta_otro_usuario:'SOLO_LECTURA',
    acciones_sobre_terceros:false,
    polling_adicional:false
  });

  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install,{once:true});
  else install();
})();
</script>

<!-- V629 · Selector de usuario para todos los perfiles en modo consulta de solo lectura. -->


<style id="v631-direct-owner-style">
body.v631-direct-owner #ownerCardsPanel{display:none!important}
body.v631-direct-owner #ownerDetailFilters{display:grid!important}
body.v631-direct-owner #ownerSelectedUserField{display:block!important}
body.v631-direct-owner.v631-no-owner #fullAccessKpis,
body.v631-direct-owner.v631-no-owner #userPersonalKpis{display:none!important}
.v631-owner-help{margin-top:5px;font-size:10px;color:var(--muted);font-weight:650;line-height:1.35}
.v631-empty-owner{padding:34px 18px;text-align:center;border:1px dashed #bfd2e8;border-radius:10px;background:#f8fbff;color:#486785}
.v631-empty-owner strong{display:block;color:#173f70;font-size:16px;margin-bottom:6px}
</style>
<script id="v631-direct-owner-explorer">
(function(){
  'use strict';
  let directMode=false;
  // V749: invalidar aperturas asíncronas del explorador individual al cambiar a área.
  let explorerEpochV749=0;
  const storageKey='v631_last_owner';
  const key=v=>String(v??'').trim().normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase();
  const selfName=()=>String(currentProfile?.nombre_personal||'').trim();

  function remember(name){
    const v=String(name||'').trim();
    if(!v)return;
    try{sessionStorage.setItem(storageKey,v);}catch(_){ }
  }
  function remembered(){
    try{return String(sessionStorage.getItem(storageKey)||'').trim();}catch(_){return '';}
  }
  function isKnown(name){
    const v=String(name||'').trim();
    if(!v)return false;
    try{
      if(typeof ownerNameIsSelectableV392==='function' && ownerNameIsSelectableV392(v))return true;
    }catch(_){ }
    return key(v)===key(selfName());
  }
  function ensureHelp(){
    const input=document.getElementById('selectedOwnerDisplay');
    if(!input)return;
    input.removeAttribute('readonly');
    input.placeholder='Escriba el nombre del usuario';
    input.title='Escriba parte del nombre y seleccione un usuario para consultar sus tarjetas y expedientes.';
    if(!document.getElementById('v631OwnerHelp')){
      const note=document.createElement('div');
      note.id='v631OwnerHelp';
      note.className='v631-owner-help';
      note.textContent='Escriba parte del nombre y seleccione al usuario. La consulta de terceros es solo lectura.';
      input.insertAdjacentElement('afterend',note);
    }
  }
  function emptyState(){
    document.body.classList.add('v631-no-owner');
    const detail=document.getElementById('panelDetailWrap');
    if(detail){detail.classList.remove('hidden','hidden-by-role');detail.style.removeProperty('display');}
    const title=document.getElementById('panelTitle');
    if(title)title.textContent='Expedientes por usuario';
    const info=document.getElementById('pageInfo');
    if(info)info.textContent='Seleccione un usuario';
    const table=document.getElementById('panelTable');
    if(table)table.innerHTML='<div class="v631-empty-owner"><strong>Seleccione un usuario</strong>Escriba el nombre en el campo superior para cargar sus tarjetas y expedientes.</div>';
  }
  function syncShell(){
    document.body.classList.toggle('v631-direct-owner',directMode);
    document.querySelector('.app')?.classList.toggle('v631-direct-owner',directMode);
    ensureHelp();
    if(!directMode)return;

    const cards=document.getElementById('ownerCardsPanel');
    if(cards){cards.classList.add('hidden','hidden-by-role');cards.style.setProperty('display','none','important');}
    const filters=document.getElementById('ownerDetailFilters');
    if(filters){filters.classList.remove('hidden','hidden-by-role');filters.style.setProperty('display','grid','important');}

    const selected=String(selectedOwner||'').trim();
    document.body.classList.toggle('v631-no-owner',!selected);
    if(!selected)emptyState();

    const back=document.getElementById('ownerBackWrap');
    const btn=back?.querySelector('button');
    if(back){back.classList.remove('hidden','hidden-by-role');}
    if(btn){
      if(typeof isLimitedUser==='function' && isLimitedUser()){
        btn.textContent='← Volver a mi usuario';
        btn.onclick=async()=>{
          const me=selfName();
          if(me && typeof window.v629ActivateOwner==='function')await window.v629ActivateOwner(me,'custody');
          syncShell();
        };
      }else{
        btn.textContent='← Directorio de usuarios';
        btn.onclick=async()=>{
          directMode=false;
          document.body.classList.remove('v631-direct-owner','v631-no-owner');
          document.querySelector('.app')?.classList.remove('v631-direct-owner');
          const cards=document.getElementById('ownerCardsPanel');
          if(cards){cards.style.removeProperty('display');cards.classList.remove('hidden','hidden-by-role');}
          if(typeof clearPanelFilters==='function')await clearPanelFilters();
        };
      }
    }
  }

  // V748: salir correctamente del modo de usuario individual cuando se abre
  // el directorio por áreas, sin dejar CSS ni flags privados bloqueando tarjetas.
  window.v748ExitDirectOwnerExplorer=function(){
    explorerEpochV749++;
    if(!directMode && !document.body.classList.contains('v631-direct-owner'))return;
    directMode=false;
    document.body.classList.remove('v631-direct-owner','v631-no-owner');
    document.querySelector('.app')?.classList.remove('v631-direct-owner');
    const cards=document.getElementById('ownerCardsPanel');
    if(cards){
      cards.style.removeProperty('display');
      cards.classList.remove('hidden','hidden-by-role');
    }
    const filters=document.getElementById('ownerDetailFilters');
    if(filters)filters.style.removeProperty('display');
  };

  window.v631OpenUserExplorer=async function(){
    const epoch=++explorerEpochV749;
    directMode=true;
    const tab=document.querySelector('.tabs .tab[data-tab="panel"]');
    if(typeof switchTab==='function')switchTab('panel',tab);
    try{if(typeof window.v629RefreshOwnerOptions==='function')await window.v629RefreshOwnerOptions(false);}catch(_){ }
    if(epoch!==explorerEpochV749)return;

    let target=String(selectedOwner||'').trim();
    const last=remembered();
    if(!isKnown(target))target='';
    if(!target && isKnown(last))target=last;
    if(!target && typeof isLimitedUser==='function' && isLimitedUser() && isKnown(selfName()))target=selfName();

    if(target && typeof window.v629ActivateOwner==='function'){
      remember(target);
      await window.v629ActivateOwner(target,'custody');
      if(epoch!==explorerEpochV749)return;
    }else{
      selectedOwner='';
      panelQuickFilter='custody';
      page=0;
      const input=document.getElementById('selectedOwnerDisplay');
      if(input)input.value='';
    }
    syncShell();
    if(!target)document.getElementById('selectedOwnerDisplay')?.focus({preventScroll:true});
  };

  function wrapActivation(){
    const prev=window.v629ActivateOwner;
    if(typeof prev!=='function'||prev.__v631Wrapped)return;
    const wrapped=async function(){
      const result=await prev.apply(this,arguments);
      if(String(selectedOwner||'').trim())remember(selectedOwner);
      if(directMode)syncShell();
      return result;
    };
    wrapped.__v631Wrapped=true;
    window.v629ActivateOwner=wrapped;
  }

  function install(){
    wrapActivation();
    ensureHelp();
  }
  window.v631UserExplorerInfo=()=>({version:'V631',observer_menu:false,acceso_directo:true,selector_en_detalle:true,solo_lectura_terceros:true});
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install,{once:true});
  else install();
})();
</script>
