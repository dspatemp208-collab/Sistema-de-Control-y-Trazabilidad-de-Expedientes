<!-- V680 · BUSCADOR POR PERFIL: NO USAR MOTOR PERSONAL V395 EN ADMIN/ARCHIVO -->
<style id="v680-profile-search-style">
.v680-profile-search-status{font-size:10px;font-weight:750;margin-top:5px;min-height:14px;color:#58718b}
.v680-profile-search-status.searching{color:#125aa5}
.v680-profile-search-status.ok{color:#1d6a42}
.v680-profile-search-status.empty{color:#8b5b00}
.v680-profile-search-status.error{color:#a12d2d}
</style>
<style id="v682-profile-search-clean-style">
/* V682 · El buscador por perfil comunica el resultado solo en la tabla. */
#ownerDetailFilters .field:has(#searchInput)::after{
  content:none!important;
  display:none!important;
}
.v680-profile-search-status:empty{
  display:none!important;
  min-height:0!important;
  margin:0!important;
}
</style>
<script id="v680-profile-search-controller">
(function(){
  'use strict';

  let requestSeq=0;
  let busy=false;

  const E=id=>document.getElementById(id);
  const clean=v=>String(v??'').trim().replace(/\s+/g,'').replace(/[–—]/g,'-');
  const valid=v=>/^\d+-\d{4}$/.test(clean(v));

  function isPersonalProfile(){
    try{return typeof isLimitedUser==='function' && isLimitedUser();}catch(_){return false;}
  }

  function ownerName(){
    try{return String(selectedOwner||'').trim();}catch(_){return '';}
  }

  function ownerSelected(){
    try{
      return !!(
        ownerName() &&
        typeof selectedOwnerIsUser==='function' &&
        selectedOwnerIsUser()
      );
    }catch(_){return false;}
  }

  function statusNode(){
    const input=E('searchInput');
    const row=input?.closest?.('.v230-inline-search');
    if(!row)return null;
    let n=row.querySelector('.v680-profile-search-status');
    if(!n){
      n=document.createElement('div');
      n.className='v680-profile-search-status';
      n.setAttribute('aria-live','polite');
      row.appendChild(n);
    }
    return n;
  }

  function setStatus(text='',tone=''){
    const n=statusNode();
    if(!n)return;
    n.textContent=text;
    n.className=`v680-profile-search-status ${tone}`.trim();
  }

  function currentFilterLabel(){
    const select=E('ownerStateFilter');
    if(select?.selectedOptions?.[0]?.textContent){
      return String(select.selectedOptions[0].textContent).trim();
    }
    try{return String(typeof panelQuickLabel==='function'?(panelQuickLabel()||'TOTAL EN CUSTODIA'):'TOTAL EN CUSTODIA');}catch(_){return 'TOTAL EN CUSTODIA';}
  }

  async function runOwnerSearch(){
    const input=E('searchInput');
    if(!input || busy)return;

    const q=clean(input.value);
    if(!q){
      input.focus({preventScroll:true});
      setStatus('Ingrese un N.° de expediente. Ej.: 0045-2020.','error');
      return;
    }
    if(!valid(q)){
      input.classList.add('v258-search-invalid');
      input.focus({preventScroll:true});
      setStatus('Formato requerido: número-año. Ej.: 0045-2020.','error');
      return;
    }

    input.value=q;
    input.classList.remove('v258-search-invalid');

    const owner=ownerName();
    const filter=currentFilterLabel();
    const mySeq=++requestSeq;
    busy=true;
    setStatus('');

    try{
      // V680: cada búsqueda de otro perfil es una consulta nueva e independiente.
      // Nunca reutiliza V395, cuyo ámbito es el perfil propio.
      page=0;
      panelRows=[];
      panelCount=0;

      try{if(typeof invalidatePanelViewCacheV179==='function')invalidatePanelViewCacheV179();}catch(_){ }
      try{if(typeof v230AdminSearchCache!=='undefined' && v230AdminSearchCache?.clear)v230AdminSearchCache.clear();}catch(_){ }

      if(typeof loadPanel!=='function')throw new Error('No está disponible la consulta por perfil.');

      await loadPanel({forceFresh:true,refreshCards:false});
      if(mySeq!==requestSeq)return;

      // V682: el resultado se comunica exclusivamente en la tabla inferior.
      // No mostrar textos auxiliares para búsquedas válidas, tengan o no coincidencias.
      setStatus('');
    }catch(error){
      if(mySeq!==requestSeq)return;
      console.error('V680 · búsqueda por perfil:',error);
      setStatus(error?.message||'No se pudo realizar la búsqueda.','error');
    }finally{
      if(mySeq===requestSeq){
        busy=false;
        requestAnimationFrame(()=>{
          if(!input.isConnected)return;
          input.focus({preventScroll:true});
          try{input.setSelectionRange(input.value.length,input.value.length);}catch(_){ }
        });
      }
    }
  }

  async function clearOwnerSearch(){
    const input=E('searchInput');
    requestSeq++;
    busy=false;
    if(input){
      input.value='';
      input.classList.remove('v258-search-invalid');
    }
    setStatus('');
    page=0;
    panelRows=[];
    panelCount=0;
    try{if(typeof invalidatePanelViewCacheV179==='function')invalidatePanelViewCacheV179();}catch(_){ }
    if(typeof loadPanel==='function'){
      await loadPanel({forceFresh:true,refreshCards:false});
    }
    input?.focus({preventScroll:true});
  }

  const previousRun=window.v394RunPersonalSearch;
  const previousKeydown=window.v394PersonalSearchKeydown;
  const previousClear=window.v394ClearPersonalSearch;

  window.v394RunPersonalSearch=function(){
    // USUARIO/COORDINADOR en su espacio personal conserva V395/V530.
    if(isPersonalProfile() || !ownerSelected()){
      return typeof previousRun==='function' ? previousRun.apply(this,arguments) : undefined;
    }
    return runOwnerSearch();
  };

  window.v394PersonalSearchKeydown=function(event){
    if(event?.key!=='Enter'){
      return typeof previousKeydown==='function' ? previousKeydown.apply(this,arguments) : undefined;
    }
    if(isPersonalProfile() || !ownerSelected()){
      return typeof previousKeydown==='function' ? previousKeydown.apply(this,arguments) : undefined;
    }
    event.preventDefault();
    event.stopPropagation();
    return runOwnerSearch();
  };

  window.v394ClearPersonalSearch=function(){
    if(isPersonalProfile() || !ownerSelected()){
      return typeof previousClear==='function' ? previousClear.apply(this,arguments) : undefined;
    }
    return clearOwnerSearch();
  };

  // Si se cambia de usuario, un resultado 0 del usuario anterior no debe quedar visible.
  const previousSetOwner=window.setOwner;
  if(typeof previousSetOwner==='function'){
    window.setOwner=async function(){
      requestSeq++;
      busy=false;
      setStatus('');
      return previousSetOwner.apply(this,arguments);
    };
  }

  window.v680ProfileSearchInfo=()=>({
    version:'V680',
    motor_perfil_propio:'V395/V530',
    motor_otro_usuario:'loadPanel + tarjeta del usuario seleccionado',
    resultado_cero_persistente:false,
    cache_entre_busquedas:false
  });

  try{console.info('V680 · búsqueda por perfil aislada del motor personal V395');}catch(_){ }
})();
</script>


<!-- =========================================================
     V681 · COLUMNAS DE REASIGNACIÓN Y ESTADOS POR TARJETA
     - Préstamos: sin columna Reasignación (De → A).
