    <div class="modal-foot">
      <span class="note" id="v626ReitStatus"></span>
      <button class="btn secondary" type="button" onclick="closeV626Reiteration()">Cancelar</button>
      <button class="btn" id="v626ReitSubmit" type="button" onclick="submitV626Reiteration()">🔔 Registrar reiteración</button>
    </div>
  </div>
</div>

