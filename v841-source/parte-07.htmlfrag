<!-- =========================================================
     V686 · QUIÉN ATENDIÓ · FUENTE ÚNICA POR CARGO/EXPEDIENTE
     ---------------------------------------------------------
     Problema corregido:
       - solicitudes con un solo cargo podían mostrar quién atendió;
       - solicitudes parciales con cabecera "VARIOS" podían mostrar —,
         aunque el cargo específico sí registrara atiende_requerimiento.

     Regla V686:
       cargo específico del expediente -> solicitud -> historial/fallback.
       La autorización real vive en public.v686_atencion_cargos().
     ========================================================= -->
<script>
(function(){
  async function enrichArchiveAttendantV686(rows){
    const list=Array.isArray(rows)?rows:[];
    if(!list.length || !sb || !session)return list;

    const items=[];
    const seen=new Set();

    list.forEach(r=>{
      const expedienteId=String(r?.expediente_id||r?.id||'').trim();
      const cargoNumero=String(
        r?._v183_cargo||
        r?.cargo_numero||
        r?.cargo||
        r?.cargo_actual||
        ''
      ).trim();

      if(!expedienteId || !cargoNumero || cargoNumero==='—' || norm(cargoNumero)==='VARIOS')return;

      const key=`${cargoNumero}|${expedienteId}`;
      if(seen.has(key))return;
      seen.add(key);
      items.push({cargo_numero:cargoNumero,expediente_id:expedienteId});
    });

    if(!items.length)return list;

    try{
      const {data,error}=await sb.rpc('v686_atencion_cargos',{p_items:items});
      if(error){
        console.warn('V686 · personal que atendió por cargo:',error.message);
        return list;
      }

      const result=Array.isArray(data)?data:[];
      const map=new Map();

      result.forEach(x=>{
        const cargo=String(x?.cargo_numero||'').trim();
        const exp=String(x?.expediente_id||'').trim();
        const staff=String(x?.atiende_requerimiento||'').trim();
        if(cargo && exp && staff)map.set(`${cargo}|${exp}`,staff);
      });

      return list.map(r=>{
        const expedienteId=String(r?.expediente_id||r?.id||'').trim();
        const cargoNumero=String(
          r?._v183_cargo||r?.cargo_numero||r?.cargo||r?.cargo_actual||''
        ).trim();
        const staff=map.get(`${cargoNumero}|${expedienteId}`)||String(
          r?._v183_archive_staff||
          r?.atendido_por_archivo||
          r?.atiende_requerimiento||
          r?.atiende||
          r?.aceptado_por||
          ''
        ).trim();

        if(!staff)return r;

        return {
          ...r,
          _v183_archive_staff:staff,
          atendido_por_archivo:staff,
          atiende_requerimiento:staff,
          atiende:staff
        };
      });
    }catch(error){
      console.warn('V686 · personal que atendió por cargo:',error?.message||error);
      return list;
    }
  }

  window.enrichArchiveAttendantV686=enrichArchiveAttendantV686;

  // USUARIO: completar la tarjeta Préstamos incluso cuando la solicitud
  // fue atendida parcialmente y la cabecera quedó con cargo "VARIOS".
  const oldUserLoanEnrich=window.enrichUserLoansForCompactViewV183;
  if(typeof oldUserLoanEnrich==='function'){
    window.enrichUserLoansForCompactViewV183=async function(rows){
      let result=await oldUserLoanEnrich.apply(this,arguments);
      result=await enrichArchiveAttendantV686(result);
      return result;
    };
  }

  // Enriquecimiento general usado por ADMINISTRADOR / ARCHIVO y por
  // varias vistas secundarias del perfil Usuario.
  const oldPanelEnrich=window.enrichPanelRowsFastV179;
  if(typeof oldPanelEnrich==='function'){
    window.enrichPanelRowsFastV179=async function(rows,options={}){
      let result=await oldPanelEnrich.apply(this,arguments);
      result=await enrichArchiveAttendantV686(result);
      return result;
    };
  }

  // COORDINADOR · espacio personal.
  const oldCoordinatorSelf=window.coordinatorSelfCardRowsV207;
  if(typeof oldCoordinatorSelf==='function'){
    window.coordinatorSelfCardRowsV207=async function(type,search=''){
      let result=await oldCoordinatorSelf.apply(this,arguments);
      result=Array.isArray(result)?result:[];
      if(['PRESTAMO','CUSTODIA','TODOS'].includes(norm(type||''))){
        result=await enrichArchiveAttendantV686(result);
      }
      return result;
    };
  }

  // COORDINADOR · seguimiento del equipo.
  const oldCoordinatorTeam=window.coordinatorTeamRowsV218;
  if(typeof oldCoordinatorTeam==='function'){
    window.coordinatorTeamRowsV218=async function(nombre,type,search=''){
      let result=await oldCoordinatorTeam.apply(this,arguments);
      result=Array.isArray(result)?result:[];
      if(['PRESTAMO','CUSTODIA','TODOS'].includes(norm(type||''))){
        result=await enrichArchiveAttendantV686(result);
      }
      return result;
    };
  }

  window.v686AttendantDiagnostics=()=>({
    version:'V686',
    fuente:'public.v686_atencion_cargos',
    prioridad:['cargo específico del expediente','solicitud','fallback existente'],
    perfiles:['ADMINISTRADOR','ARCHIVO','COORDINADOR','USUARIO'],
    soporta_cabecera_varios:true
  });

  try{console.info('V686 · Atendido por Archivo unificado por cargo específico');}catch(_){ }
})();
</script>


