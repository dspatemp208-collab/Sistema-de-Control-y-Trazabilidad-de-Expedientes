<script id="v656-request-response-excel">
(function(){
  'use strict';

  function normHeader(v){
    return String(v??'')
      .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
      .toUpperCase().trim().replace(/\s+/g,' ');
  }

  function normExp(v){
    const raw=String(v??'').trim();
    if(!raw)return '';
    try{
      const fromCell=typeof excelExpedienteFromValue==='function'?excelExpedienteFromValue(raw):'';
      if(fromCell)return fromCell;
      return typeof normalizeRequestExpediente==='function'?normalizeRequestExpediente(raw):raw.toUpperCase();
    }catch(_){ return raw.toUpperCase(); }
  }

  function normExt(v){
    const raw=String(v??'').trim();
    try{return typeof canonicalRequestExtension==='function'?canonicalRequestExtension(raw):raw.toUpperCase();}
    catch(_){return raw.toUpperCase();}
  }

  function extKey(v){
    const x=normExt(v);
    try{return typeof requestExtensionKey==='function'?requestExtensionKey(x):normHeader(x);}
    catch(_){return normHeader(x);}
  }

  function pendingRows(){
    return (requestDetailRows||[]).filter(x=>
      String(x?.estado_item||'').trim().toUpperCase()==='ACEPTADO' && !x?._cross_wait
    );
  }

  function safeFilePart(v){
    return String(v||'SOLICITUD').trim().replace(/[^A-Za-z0-9_-]+/g,'_').replace(/^_+|_+$/g,'')||'SOLICITUD';
  }

  window.v656DownloadPendingResponseExcel=function(){
    if(typeof hasFullAccess==='function' && !hasFullAccess())return;
    if(typeof XLSX==='undefined'){
      if(typeof showToast==='function')showToast('No se pudo cargar el generador de Excel.');
      return;
    }
    const rows=pendingRows();
    if(!rows.length){
      if(typeof el==='function'&&el('rqActionStatus'))el('rqActionStatus').textContent='No hay expedientes pendientes por atender para descargar.';
      return;
    }
    const data=[['Expediente','Extensión','R.D.','Último folio']];
    rows.forEach(x=>data.push([
      String(x.expediente||''),
      String(x.extension||''),
      String(x.rd||''),
      String(x.ultimo_folio||'')
    ]));
    const ws=XLSX.utils.aoa_to_sheet(data);
    ws['!cols']=[{wch:18},{wch:18},{wch:18},{wch:18}];
    const wb=XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb,ws,'Solicitud');
    const sol=safeFilePart(currentRequest?.numero||currentRequestId||'SOLICITUD');
    XLSX.writeFile(wb,`RESPUESTA_${sol}.xlsx`);
    if(typeof el==='function'&&el('rqActionStatus'))el('rqActionStatus').textContent=`Plantilla generada con ${rows.length} expediente(s) pendientes.`;
  };

  window.v656OpenResponseExcelPicker=function(){
    if(typeof hasFullAccess==='function' && !hasFullAccess())return;
    const rows=pendingRows();
    if(!rows.length){
      if(typeof el==='function'&&el('rqActionStatus'))el('rqActionStatus').textContent='No hay expedientes pendientes por atender en esta solicitud.';
      return;
    }
    const input=typeof el==='function'?el('v656ResponseExcelFile'):null;
    if(input)input.click();
  };

  function readRowsFromWorkbook(wb){
    if(!wb?.SheetNames?.length)throw new Error('El archivo no contiene hojas.');
    const preferred=wb.SheetNames.find(n=>normHeader(n)==='SOLICITUD')||wb.SheetNames[0];
    const ws=wb.Sheets[preferred];
    const rows=XLSX.utils.sheet_to_json(ws,{header:1,raw:false,defval:''});
    if(!rows.length)throw new Error('La hoja está vacía.');

    let header=-1, expCol=-1, extCol=-1, rdCol=-1, folioCol=-1;
    for(let i=0;i<Math.min(15,rows.length);i++){
      const h=(rows[i]||[]).map(normHeader);
      const e=h.findIndex(x=>x==='EXPEDIENTE'||x.includes('NUMERO EXPEDIENTE')||x.includes('NRO EXPEDIENTE')||x.includes('N° EXPEDIENTE'));
      if(e<0)continue;
      header=i;expCol=e;
      extCol=h.findIndex(x=>x==='EXTENSION'||x==='EXT.'||x==='EXT');
      rdCol=h.findIndex(x=>x==='R.D.'||x==='R.D'||x==='RD'||x==='R D'||x.includes('RESOLUCION DIRECTORAL'));
      folioCol=h.findIndex(x=>x==='ULTIMO FOLIO'||x==='ULT. FOLIO'||x==='ULT FOLIO'||x.includes('FOLIO FINAL'));
      break;
    }
    if(header<0||expCol<0)throw new Error('No se encontró la columna Expediente.');
    if(extCol<0||rdCol<0||folioCol<0){
      throw new Error('Use la plantilla oficial: Expediente | Extensión | R.D. | Último folio.');
    }

    const out=[];
    for(let i=header+1;i<rows.length;i++){
      const row=rows[i]||[];
      const rawExp=String(row[expCol]??'').trim();
      if(!rawExp)continue;
      out.push({
        expediente:normExp(rawExp),
        extension:normExt(row[extCol]),
        rd:String(row[rdCol]??'').trim(),
        ultimo_folio:String(row[folioCol]??'').trim(),
        fila:i+1
      });
    }
    return out;
  }

  function matchPending(excelRow,pending){
    const sameExp=pending.filter(x=>normExp(x.expediente)===excelRow.expediente);
    if(sameExp.length===0)return {kind:'outside'};
    if(sameExp.length===1)return {kind:'ok',row:sameExp[0]};
    if(excelRow.extension){
      const k=extKey(excelRow.extension);
      const exact=sameExp.filter(x=>extKey(x.extension)===k);
      if(exact.length===1)return {kind:'ok',row:exact[0]};
    }
    return {kind:'ambiguous'};
  }

  window.v656ImportResponseExcel=async function(file){
    if(!file)return;
    if(typeof hasFullAccess==='function' && !hasFullAccess())return;
    if(typeof XLSX==='undefined'){
      if(typeof el==='function'&&el('rqActionStatus'))el('rqActionStatus').textContent='No se pudo cargar el lector de Excel.';
      return;
    }
    if(!/\.(xlsx|xls|csv)$/i.test(String(file.name||''))){
      if(typeof el==='function'&&el('rqActionStatus'))el('rqActionStatus').textContent='Seleccione un archivo XLSX, XLS o CSV.';
      return;
    }
    const pending=pendingRows();
    if(!pending.length){
      if(typeof el==='function'&&el('rqActionStatus'))el('rqActionStatus').textContent='No hay expedientes pendientes por atender.';
      return;
    }

    if(typeof el==='function'&&el('rqActionStatus'))el('rqActionStatus').textContent='Leyendo respuesta Excel...';
    try{
      const buffer=await file.arrayBuffer();
      const wb=XLSX.read(buffer,{type:'array'});
      const excelRows=readRowsFromWorkbook(wb);
      if(!excelRows.length)throw new Error('El Excel no contiene expedientes para aplicar.');

      const matched=[];
      const outside=[];
      const ambiguous=[];
      const invalid=[];
      const seenIds=new Set();

      excelRows.forEach(x=>{
        if(!x.expediente){invalid.push(x);return;}
        const m=matchPending(x,pending);
        if(m.kind==='outside'){outside.push(x);return;}
        if(m.kind==='ambiguous'){ambiguous.push(x);return;}
        const id=String(m.row.expediente_id||'');
        if(!id||seenIds.has(id)){invalid.push(x);return;}
        seenIds.add(id);
        matched.push({excel:x,row:m.row});
      });

      if(!matched.length){
        const detail=[];
        if(outside.length)detail.push(`${outside.length} no pertenecen a los pendientes de esta solicitud`);
        if(ambiguous.length)detail.push(`${ambiguous.length} requieren Extensión para identificar la variante`);
        if(invalid.length)detail.push(`${invalid.length} filas inválidas o duplicadas`);
        throw new Error('No hay filas válidas para aplicar'+(detail.length?': '+detail.join(' · '):'.'));
      }

      const warnings=[];
      if(outside.length)warnings.push(`${outside.length} fuera de la solicitud`);
      if(ambiguous.length)warnings.push(`${ambiguous.length} ambiguas`);
      if(invalid.length)warnings.push(`${invalid.length} inválidas/duplicadas`);

      const message=`Se aplicarán ${matched.length} expediente(s) a esta solicitud.`+
        (warnings.length?`\n\nNo se aplicarán: ${warnings.join(' · ')}.`:'')+
        '\n\nEl Excel no genera cargo ni guarda todavía en Supabase. Los expedientes válidos quedarán seleccionados para que Archivo revise y luego use Guardar cambios o Generar cargo.';
      if(!window.confirm(message)){
        if(typeof el==='function'&&el('rqActionStatus'))el('rqActionStatus').textContent='Carga Excel cancelada. No se realizaron cambios.';
        return;
      }

      requestSelectedIds.clear();
      matched.forEach(({excel,row})=>{
        if(excel.extension)row.extension=excel.extension;
        if(excel.rd)row.rd=excel.rd;
        if(excel.ultimo_folio)row.ultimo_folio=excel.ultimo_folio;
        requestSelectedIds.add(row.expediente_id);
      });

      if(typeof renderRequestDetailItems==='function')renderRequestDetailItems();
      if(typeof renderRequestActions==='function')renderRequestActions();
      if(typeof forceEnableRequestAttendant==='function')setTimeout(forceEnableRequestAttendant,0);

      const missingFolio=matched.filter(({row})=>!String(row.ultimo_folio||'').trim()).length;
      let status=`Excel aplicado: ${matched.length} expediente(s) actualizados y seleccionados.`;
      if(missingFolio)status+=` ${missingFolio} quedaron sin Último folio.`;
      if(warnings.length)status+=` Omitidos: ${warnings.join(' · ')}.`;
      status+=' Revise los datos y continúe con Guardar cambios o Generar cargo.';
      if(typeof el==='function'&&el('rqActionStatus'))el('rqActionStatus').textContent=status;
      if(typeof showToast==='function')showToast(`${matched.length} expediente(s) cargados desde Excel`);
    }catch(err){
      console.error('V656 respuesta Excel:',err);
      if(typeof el==='function'&&el('rqActionStatus'))el('rqActionStatus').textContent=err?.message||'No se pudo procesar el Excel.';
    }
  };

  try{console.info('V657 · devolución y ubicación sincronizadas · respuesta Excel activa');}catch(_){ }
})();
</script>



<!-- =========================================================
     V661 · CIERRE ADMINISTRATIVO GENERALIZADO
     La regla ya no depende de un expediente de prueba concreto.
     Para TODO expediente cerrado por ADMINISTRADOR:
       1) el cierre queda como antecedente histórico terminal;
       2) se consulta nuevamente la existencia de solicitudes activas;
       3) se evalúa la custodia física real;
       4) si está en Archivo y no existe un ciclo activo, se permite una
          nueva solicitud independiente conservando el historial anterior;
       5) préstamo, reasignación, devolución solicitada o derivación vigente
          continúan bloqueando / redirigiendo el flujo según corresponda.
     Se aplica tanto a búsqueda manual como a carga Excel.
     ========================================================= -->
<script id="v661-admin-close-generalized-script">
(function(){
  'use strict';

  function n(v){
    try{return typeof norm==='function'?norm(v):String(v??'').trim().toUpperCase();}
    catch(_){return String(v??'').trim().toUpperCase();}
  }

  function isAdminClosedState(v){
    const s=n(v);
    return s==='CERRADO POR ADMINISTRADOR' || s==='CERRADA POR ADMINISTRADOR';
  }

  function requestHasAdminClosedState(req){
    if(!req)return false;
    const values=[
      req.estado_item,
      req.estado,
      req.estado_atencion,
      req.estado_solicitud,
      req.solicitud_estado,
      req.estado_ciclo
    ];
    return values.some(isAdminClosedState) || !!req.cerrado_admin;
  }

  function rowHasAdminClosedHistory(row){
    if(!row)return false;
    if(row._closedAdminHistoryV324 || row._v661_admin_closed_history)return true;

    if([
      row.estado_solicitud_item,
      row.solicitud_estado,
      row.estado_atencion,
      row.estado_ciclo,
      row.ultimo_estado
    ].some(isAdminClosedState))return true;

    const closed=Array.isArray(row._closedRequestsV322)?row._closedRequestsV322:[];
    return closed.some(requestHasAdminClosedState);
  }

  function physicalState(row){
    return n(
      row?.estado_operativo ||
      row?.ultimo_estado ||
      (typeof operationalStatus==='function'?operationalStatus(row):'') ||
      row?.estado ||
      ''
    );
  }

  function masterPhysicalState(row){
    return n(
      row?.estado_actual_db ||
      row?.estado_actual ||
      row?.situacion_operativa ||
      row?.estado ||
      ''
    );
  }

  function ownerState(row){
    return n(row?.responsable_actual || row?.responsable || row?.ubicacion_actual || '');
  }

  function physicallyOutsideArchive(row){
    const s=physicalState(row);
    return [
      'EN PRÉSTAMO','EN PRESTAMO',
      'REASIGNADO','REASIGNADOS',
      'DEVOLUCIÓN SOLICITADA','DEVOLUCION SOLICITADA',
      'DERIVADO AL CONAS','DERIVADO A CONAS',
      'DERIVADO A LA DVC','DERIVADO A DVC',
      'DERIVADO A INSTRUCCIÓN','DERIVADO A INSTRUCCION'
    ].includes(s);
  }

  function physicallyInArchive(row){
    if(!row)return false;

    // Mantener la misma comprobación física que ya se utilizaba en V660.
    try{
      if(typeof isReturnedToArchiveForNewRequestV422==='function' &&
         isReturnedToArchiveForNewRequestV422(row))return true;
    }catch(_){ }

    const p=physicalState(row);
    const m=masterPhysicalState(row);
    const owner=ownerState(row);
    const archiveOwner=owner==='ARCHIVO' || owner.includes('ARCHIVO');

    if(['DEVUELTO','DEVUELTO AL ARCHIVO'].includes(p))return true;
    if(p==='CUSTODIA' && archiveOwner)return true;
    if(m==='CUSTODIA' && archiveOwner)return true;

    return false;
  }

  function activeRequests(row){
    return (Array.isArray(row?._activeRequests)?row._activeRequests:[])
      .filter(req=>{
        if(requestHasAdminClosedState(req))return false;
        try{
          if(typeof requestIsTerminalForNewCycleV324==='function' &&
             requestIsTerminalForNewCycleV324(req,null))return false;
        }catch(_){ }
        return true;
      });
  }

  function normalizeRow(row){
    const next={...(row||{})};
    if(!rowHasAdminClosedHistory(next))return next;

    next._v661_admin_closed_history=true;
    next._closedAdminHistoryV324=true;

    const active=activeRequests(next);
    next._activeRequests=active;

    // Una solicitud realmente vigente siempre tiene prioridad sobre el cierre histórico.
    if(active.length){
      next._v661_admin_closed_resolicitable=false;
      return next;
    }

    // Derivaciones o retornos especiales conservan su flujo específico.
    if(next._referralDestination || next._instruction_active || next._existingPendingReassignV481){
      next._v661_admin_closed_resolicitable=false;
      return next;
    }

    // El cierre administrativo no puede convertir en disponible un expediente
    // que físicamente continúa fuera de Archivo.
    if(physicallyOutsideArchive(next)){
      next._v661_admin_closed_resolicitable=false;
      return next;
    }

    // Regla universal: cierre administrativo + custodia física de Archivo
    // + ausencia de solicitud activa = nuevo ciclo independiente permitido.
    if(physicallyInArchive(next)){
      next.disponible=true;
      next.solicitud_interna=false;
      next.solicitud_otra_area=false;
      next.usar_reasignacion_interna=false;
      next._v324_resolicitable=true;
      next._v329_resolicitable=true;
      next._v661_admin_closed_resolicitable=true;
      next._activeLookupFailed=false;
      next.responsable_actual='ARCHIVO';
      next.area_trabajo=null;
      next.motivo='La solicitud anterior fue cerrada por el Administrador. El expediente se encuentra físicamente en Archivo y puede generar una nueva solicitud independiente.';
    }

    return next;
  }

  async function attachAdminClosedEvidence(rows){
    const source=Array.isArray(rows)?rows:[];
    if(!source.length || !window.sb)return source.map(normalizeRow);

    const ids=[...new Set(source
      .map(r=>String(r?.id||r?.expediente_id||'').trim())
      .filter(Boolean))];

    if(!ids.length)return source.map(normalizeRow);

    try{
      // V667 · La evidencia del cierre administrativo se obtiene mediante
      // una RPC segura. La lectura directa de solicitud_expedientes podía
      // quedar vacía por RLS y hacer que un cierre válido siguiera apareciendo
      // como PENDIENTE POR ATENDER / POR VERIFICAR.
      const {data,error}=await sb.rpc(
        'v667_cierres_admin_busqueda',
        {p_expediente_ids:ids}
      );

      if(error)throw error;

      const closedByExp=new Map();
      (Array.isArray(data)?data:[]).forEach(x=>{
        const id=String(x?.expediente_id||'').trim();
        if(id && !closedByExp.has(id))closedByExp.set(id,x);
      });

      return source.map(raw=>{
        const id=String(raw?.id||raw?.expediente_id||'').trim();
        const evidence=closedByExp.get(id)||null;
        const row=evidence
          ?{
              ...raw,
              _v661_admin_closed_history:true,
              _v667_admin_closed_history:true,
              _v661_admin_closed_at:evidence.cerrado_at||null,
              _v661_admin_closed_request_id:evidence.solicitud_id||null,
              _v667_closed_before_delivery:evidence.sin_entrega_fisica!==false
            }
          :raw;
        return normalizeRow(row);
      });
    }catch(error){
      // RLS o una instalación anterior no deben romper la búsqueda. Se conserva
      // la evidencia que ya haya llegado por V324/V327/Registro maestro.
      console.warn('V661 · verificación general de cierre administrativo:',error?.message||error);
      return source.map(normalizeRow);
    }
  }

  window.v661NormalizeAdminClosedRows=function(rows){
    return (Array.isArray(rows)?rows:[]).map(normalizeRow);
  };
  window.v661AttachAdminClosedEvidence=attachAdminClosedEvidence;

  // Búsqueda manual y Excel pasan por esta función. La envolvemos al final
  // de todas las validaciones anteriores para que el cierre del Administrador
  // se analice siempre con el estado físico ya enriquecido.
  if(typeof validateRequestRowsFastV188==='function'){
    const baseValidateV661=validateRequestRowsFastV188;
    validateRequestRowsFastV188=async function(){
      const rows=await baseValidateV661.apply(this,arguments);
      return attachAdminClosedEvidence(rows);
    };
    window.validateRequestRowsFastV188=validateRequestRowsFastV188;
  }

  // El caché y la normalización de expedientes devueltos tampoco deben borrar
  // la decisión de V661.
  if(typeof v506NormalizeReturnedAvailability==='function'){
    const baseReturnedV661=v506NormalizeReturnedAvailability;
    v506NormalizeReturnedAvailability=function(rows){
      const normalized=baseReturnedV661.call(this,rows);
      return (Array.isArray(normalized)?normalized:[]).map(normalizeRow);
    };
    window.v506NormalizeReturnedAvailability=v506NormalizeReturnedAvailability;
  }

  // La etiqueta visual específica permite identificar que se aplicó la regla
  // general de cierre administrativo, sin cambiar el resto de la interfaz.
  if(typeof requestLookupRowCanSelectV193==='function'){
    const baseCanSelectV661=requestLookupRowCanSelectV193;
    requestLookupRowCanSelectV193=function(row){
      const normalized=normalizeRow(row);
      return baseCanSelectV661.call(this,normalized);
    };
    window.requestLookupRowCanSelectV193=requestLookupRowCanSelectV193;
  }

  try{console.info('V661 · cierre administrativo generalizado para todos los expedientes');}catch(_){ }
})();
</script>



<!-- =========================================================
     V667 · CIERRE ADMINISTRATIVO = NUEVO CICLO SOLICITABLE
     - Supabase sincroniza el maestro a CUSTODIA / ARCHIVO cuando el cierre
       administrativo corresponde a un trámite pendiente sin entrega física.
     - La búsqueda usa v667_cierres_admin_busqueda en lugar de lectura directa
       de solicitud_expedientes, evitando falsos NO DISPONIBLE por RLS.
     - Una solicitud posterior activa o una derivación vigente conserva prioridad.
     ========================================================= -->
<!-- =========================================================
     V662 · PARIDAD OPERATIVA DE DERIVADOS
     - CONAS conserva su flujo vigente.
     - DVC e Instrucción obtienen retorno directo desde Registro Maestro.
     - Se reutilizan las carpetas y RPC vigentes para evitar doble lógica.
     - Instrucción conserva RETORNO DE INSTRUCCIÓN / NUEVO INGRESO.
     ========================================================= -->
<style id="v662-derived-parity-style">
#allTable .master-dvc-return-btn{
  flex:0 0 auto;
  white-space:nowrap!important;
  background:#0b6d9b;
  border-color:#0b6d9b;
}
#allTable .master-dvc-return-btn:hover{filter:brightness(.96)}
#allTable .master-instruction-return-btn{
  flex:0 0 auto;
  white-space:nowrap!important;
  background:#6b21a8;
  border-color:#6b21a8;
}
#allTable .master-instruction-return-btn:hover{filter:brightness(.96)}
</style>

<script id="v662-derived-parity-script">
(function(){
  'use strict';

  function currentDerivedStateV662(row){
    return norm(
      typeof operationalStatus==='function'
        ?operationalStatus(row)
        :(row?.estado_operativo||row?.ultimo_estado||row?.estado||'')
    );
  }

  function canDvc(row){
    if(!hasFullAccess())return false;
    const state=currentDerivedStateV662(row);
    const owner=norm(row?.responsable||row?.responsable_actual||'');
    return (
      state==='DERIVADO A LA DVC' ||
      state==='DERIVADO A DVC' ||
      owner==='DVC'
    );
  }

  function canInstruction(row){
    if(!hasFullAccess())return false;
    const state=currentDerivedStateV662(row);
    const owner=norm(row?.responsable||row?.responsable_actual||'');
    return (
      state==='DERIVADO A INSTRUCCIÓN' ||
      state==='DERIVADO A INSTRUCCION' ||
      owner==='INSTRUCCIÓN' ||
      owner==='INSTRUCCION'
    );
  }

  async function active(destination,expedienteId){
    const rpc=destination==='DVC'
      ?'listar_derivados_dvc'
      :'listar_derivados_instruccion';

    const {data,error}=await sb.rpc(rpc,{p_busqueda:null});
    if(error)throw error;

    const rows=Array.isArray(data)?data:[];
    const current=rows.find(
      row=>String(row?.expediente_id||'')===String(expedienteId||'')
    );
    return {rows,current};
  }

  async function openDvc(expedienteId,button=null){
    if(!hasFullAccess()){
      alert('Solo Archivo o Administrador puede registrar el retorno de DVC.');
      return;
    }

    expedienteId=String(expedienteId||'').trim();
    if(!expedienteId){
      alert('No se pudo identificar el expediente.');
      return;
    }

    const oldText=button?.textContent||'✓ Retorno DVC';
    if(button){button.disabled=true;button.textContent='Verificando...';}

    try{
      const {rows,current}=await active('DVC',expedienteId);
      if(!current){
        alert(
          'El expediente ya no figura como derivado activo a la DVC. '+
          'Actualice el Registro Maestro para ver su último estado.'
        );
        await Promise.all([loadAll(),loadHistory()]);
        return;
      }

      dvcRows=rows;
      dvcSelectedIds.clear();
      dvcSelectedIds.add(current.expediente_id);
      openDvcReturnModal();

      if(el('dvcReturnStatus')){
        el('dvcReturnStatus').innerHTML=
          `<b>${esc(current.expediente||'Expediente')}</b> seleccionado. `+
          `Confirme que retornó físicamente de la DVC, revise la ubicación `+
          `de retorno y pulse <b>CONFIRMAR RETORNO DE DVC</b>.`;
      }
    }catch(error){
      alert(error?.message||String(error));
    }finally{
      if(button){button.disabled=false;button.textContent=oldText;}
    }
  }

  async function openInstruction(expedienteId,button=null){
    if(!hasFullAccess()){
      alert('Solo Archivo o Administrador puede registrar el retorno de Instrucción.');
      return;
    }

    expedienteId=String(expedienteId||'').trim();
    if(!expedienteId){
      alert('No se pudo identificar el expediente.');
      return;
    }

    const oldText=button?.textContent||'✓ Retorno Instrucción';
    if(button){button.disabled=true;button.textContent='Verificando...';}

    try{
      const {rows,current}=await active('INSTRUCCION',expedienteId);
      if(!current){
        alert(
          'El expediente ya no figura como derivado activo a Instrucción. '+
          'Actualice el Registro Maestro para ver su último estado.'
        );
        await Promise.all([loadAll(),loadHistory()]);
        return;
      }

      instructionRows=rows;
      instructionSelectedIds.clear();
      instructionSelectedIds.add(current.expediente_id);
      openInstructionReturnModal();

      if(el('instructionReturnStatus')){
        el('instructionReturnStatus').innerHTML=
          `<b>${esc(current.expediente||'Expediente')}</b> seleccionado. `+
          `Confirme la recepción física, revise Extensión, R.D. y Último folio. `+
          `Al confirmar se registrará como <b>RETORNO DE INSTRUCCIÓN / NUEVO INGRESO</b>.`;
      }
    }catch(error){
      alert(error?.message||String(error));
    }finally{
      if(button){button.disabled=false;button.textContent=oldText;}
    }
  }

  window.masterCanRegisterDvcReturnV662=canDvc;
  window.masterCanRegisterInstructionReturnV662=canInstruction;
  window.openMasterDvcReturnV662=openDvc;
  window.openMasterInstructionReturnV662=openInstruction;

  try{
    console.info('V662 · DVC e Instrucción alineados con CONAS para retorno directo desde Registro Maestro');
  }catch(_){}
})();
</script>


<style id="v663-derivaciones-excel-varios-memos-style">
.v663-excel-panel{margin:8px 0 10px;padding:10px;border:1px solid #cbd9e8;border-radius:10px;background:#f7fbff}
.v663-excel-tools{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:7px}
.v663-excel-status{font-size:10.5px;color:#536d89;font-weight:700;flex:1;min-width:240px}
.v663-common-memo-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:7px;align-items:center}
.v663-memo-summary{display:flex;gap:7px;flex-wrap:wrap;margin:0 0 10px}
.v663-memo-summary .v663-chip{display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border:1px solid #cbd9e8;border-radius:999px;background:#f7fbff;color:#234d77;font-size:9.5px;font-weight:800}
.v663-memo-summary .v663-chip b{font-size:10.5px;color:#103b68}
.v663-memo-summary .v663-chip.bad{border-color:#f0b4b4;background:#fff2f2;color:#a62323}
.v663-memo-summary .v663-chip.total{border-color:#a9c9e8;background:#eaf4ff}
.v663-memo-input{min-width:210px;width:100%;padding:6px 8px;border:1px solid #b9cbe0;border-radius:7px;background:#fff;font:inherit;font-size:10.5px}
.v663-memo-input.missing{border-color:#e09a32;background:#fffaf0}
.v663-error-box{margin-top:8px;padding:8px 10px;border:1px solid #e5aaaa;border-radius:8px;background:#fff4f4;color:#8d2525;font-size:10px;line-height:1.45}
.v663-excel-open{white-space:nowrap}
@media(max-width:760px){.v663-common-memo-row{grid-template-columns:1fr}.v663-excel-tools{align-items:stretch}.v663-excel-status{min-width:100%}}
</style>
<!-- V822 · Habilitación específica de CONAS a Marcela Alonzo en su espacio personal. -->
<script id="v839-legacy-conas-permission-hook">
(function(){
 'use strict';
 window.v822MarcelaConasAllowed=function(){
   return typeof window.v839CanDerive==='function' && window.v839CanDerive('CONAS')===true;
 };
})();
</script>
<script id="v663-derivaciones-excel-varios-memos">
(function(){
  'use strict';
  const E=id=>document.getElementById(id);
  const clean=v=>String(v??'').trim();
  const up=v=>clean(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().replace(/\s+/g,' ').trim();
  const safe=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
  const canonExp=v=>{let s=clean(v).replace(/\s+/g,'').replace(/[–—]/g,'-');const m=s.match(/^(\d+)[\-\/](\d{4})$/);return m?`${((m[1].replace(/^0+(?=\d)/,'')||'0').length<4?(m[1].replace(/^0+(?=\d)/,'')||'0').padStart(4,'0'):(m[1].replace(/^0+(?=\d)/,'')||'0'))}-${m[2]}`:s.toUpperCase()};
  const canonExt=v=>up(v).replace(/\s+/g,'');
  const errors={CONAS:[],DVC:[],INSTRUCCION:[]};
  const subjectLast={CONAS:'',DVC:'',INSTRUCCION:''};

  const C={
    CONAS:{
      label:'CONAS', phrase:'al CONAS', modal:'bulkConasModal', table:'bulkConasTable', memo:'bulkConasMemo', obs:'bulkConasObservation', status:'bulkConasStatus', submit:'bulkConasSubmitBtn',
      file:'v663ConasExcelFile',excelStatus:'v663ConasExcelStatus',summary:'v663ConasMemoSummary',sheet:'CONAS',folder:()=>typeof loadConasFolder==='function'?loadConasFolder():Promise.resolve(),
      rows:()=>bulkConasRows,setRows:v=>{bulkConasRows=v;}
    },
    DVC:{
      label:'DVC', phrase:'a la DVC', modal:'bulkDvcModal', table:'bulkDvcTable', memo:'bulkDvcMemo', obs:'bulkDvcObservation', status:'bulkDvcStatus', submit:'bulkDvcSubmitBtn',
      file:'v663DvcExcelFile',excelStatus:'v663DvcExcelStatus',summary:'v663DvcMemoSummary',sheet:'DVC',folder:()=>typeof loadDvcFolder==='function'?loadDvcFolder():Promise.resolve(),
      rows:()=>bulkDvcRows,setRows:v=>{bulkDvcRows=v;}
    },
    INSTRUCCION:{
      label:'Instrucción', phrase:'a Instrucción', modal:'bulkInstructionModal', table:'bulkInstructionTable', memo:'bulkInstructionMemo', obs:'bulkInstructionObservation', status:'bulkInstructionStatus', submit:'bulkInstructionSubmitBtn',
      file:'v663InstructionExcelFile',excelStatus:'v663InstructionExcelStatus',summary:'v663InstructionMemoSummary',sheet:'INSTRUCCION',folder:()=>typeof loadInstructionFolder==='function'?loadInstructionFolder():Promise.resolve(),
      rows:()=>bulkInstructionRows,setRows:v=>{bulkInstructionRows=v;}
    }
  };

  function role(){return up(currentProfile?.rol||'');}
  function allowed(dest){return typeof window.v839CanDerive==='function' && window.v839CanDerive(dest)===true;}
  function cfg(dest){return C[dest];}
  function rows(dest){return cfg(dest).rows()||[];}
  function setRows(dest,v){cfg(dest).setRows(v||[]);}
  function uniqueMemos(dest){
    const m=new Map();
    rows(dest).forEach(r=>{const x=clean(r.numero_memorando);if(x)m.set(x,(m.get(x)||0)+1);});
    return m;
  }
  function defaultSubject(dest){
    const actor=clean(currentProfile?.nombre_personal||currentProfile?.email)||'USUARIO';
    const n=rows(dest).length,m=uniqueMemos(dest).size,c=cfg(dest);
    return `Derivación ${c.phrase} de ${actor} - ${n} expediente${n===1?'':'s'} - ${m} memorando${m===1?'':'s'}`;
  }
  function mailIds(dest){const p='v596'+dest[0]+dest.slice(1).toLowerCase();return {enabled:p+'Enabled',recips:p+'Recipients',subject:p+'Subject'};}
  function syncSubject(dest,force=false){
    const id=mailIds(dest).subject,input=E(id);if(!input)return;
    const next=defaultSubject(dest),prev=subjectLast[dest];
    if(force||!clean(input.value)||input.value===prev||/^Derivación /i.test(input.value))input.value=next;
    subjectLast[dest]=next;
  }
  function renderSummary(dest){
    const box=E(cfg(dest).summary);if(!box)return;
    const memos=uniqueMemos(dest),missing=rows(dest).filter(r=>!clean(r.numero_memorando)).length;
    let html=`<span class="v663-chip total"><b>${rows(dest).length}</b> expedientes</span><span class="v663-chip total"><b>${memos.size}</b> memorandos</span><span class="v663-chip total"><b>1</b> correo</span>`;
    [...memos.entries()].sort((a,b)=>a[0].localeCompare(b[0],'es',{numeric:true})).forEach(([memo,n])=>html+=`<span class="v663-chip"><b>${safe(memo)}</b> · ${n}</span>`);
    if(missing)html+=`<span class="v663-chip bad"><b>${missing}</b> sin memorando</span>`;
    box.innerHTML=html;
  }
  function syncState(dest){
    const list=rows(dest),missingMemo=list.filter(r=>!clean(r.numero_memorando)),missingFolio=list.filter(r=>!clean(r.ultimo_folio)),btn=E(cfg(dest).submit);
    const excluded=errors[dest].length;
    // V666: las observaciones del Excel son exclusiones por fila, no bloquean
    // los expedientes que sí fueron validados correctamente.
    if(btn){
      btn.disabled=!list.length||missingMemo.length>0||missingFolio.length>0;
      btn.textContent=list.length?`DERIVAR ${list.length} EXPEDIENTE${list.length===1?'':'S'} ${cfg(dest).phrase.toUpperCase()}`:`DERIVAR ${cfg(dest).phrase.toUpperCase()}`;
    }
    let msg=list.length?'Datos completos. Puede registrar la derivación física.':'No hay expedientes válidos cargados.';
    if(missingMemo.length)msg=`Falta el N.º de Memorando en ${missingMemo.length} expediente${missingMemo.length===1?'':'s'} válido${missingMemo.length===1?'':'s'}.`;
    else if(missingFolio.length)msg=`Falta el Último folio en ${missingFolio.length} expediente${missingFolio.length===1?'':'s'} válido${missingFolio.length===1?'':'s'}.`;
    else if(list.length && excluded)msg=`${list.length} expediente${list.length===1?'':'s'} válido${list.length===1?'':'s'} listo${list.length===1?'':'s'} para derivar. ${excluded} observación${excluded===1?'':'es'} quedó${excluded===1?'':'aron'} excluida${excluded===1?'':'s'} del bloque.`;
    if(E(cfg(dest).status))E(cfg(dest).status).textContent=msg;
    renderSummary(dest);syncSubject(dest,false);
  }
  function renderRows(dest){
    const box=E(cfg(dest).table);if(!box)return;
    const list=rows(dest);
    if(!list.length){box.innerHTML=`<div class="empty">No hay expedientes cargados para derivar ${safe(cfg(dest).phrase)}.</div>`;syncState(dest);return;}
    box.innerHTML=`<table><thead><tr><th>N°</th><th>Expediente</th><th>Ext.</th><th>Responsable actual</th><th>Cargo</th><th>R.D. (opcional)</th><th>Último folio *</th><th>N.º Memorando *</th></tr></thead><tbody>${list.map((r,i)=>`<tr><td>${i+1}</td><td><b>${safe(r.expediente||'—')}</b></td><td>${safe(r.extension||'—')}</td><td>${safe(r.responsable||'—')}</td><td>${safe(r.cargo||'—')}</td><td><input class="bulk-return-input" value="${safe(r.rd||'')}" placeholder="R.D. (opcional)" oninput="v663UpdateDerivationRow('${dest}','${r.id}','rd',this.value)"></td><td><input class="bulk-return-input required" value="${safe(r.ultimo_folio||'')}" placeholder="Último folio" oninput="v663UpdateDerivationRow('${dest}','${r.id}','ultimo_folio',this.value)"></td><td><input class="v663-memo-input ${clean(r.numero_memorando)?'':'missing'}" value="${safe(r.numero_memorando||'')}" placeholder="N.º Memorando" oninput="v663UpdateDerivationRow('${dest}','${r.id}','numero_memorando',this.value);this.classList.toggle('missing',!this.value.trim())"></td></tr>`).join('')}</tbody></table>`;
    syncState(dest);
  }
  window.v663UpdateDerivationRow=function(dest,id,field,value){const r=rows(dest).find(x=>String(x.id)===String(id));if(!r)return;r[field]=clean(value);syncState(dest);};
  window.v663ApplyCommonMemo=function(dest){const memo=clean(E(cfg(dest).memo)?.value);if(!memo){showToast?.('Ingrese primero el memorando común.');return;}rows(dest).forEach(r=>r.numero_memorando=memo);renderRows(dest);showToast?.(`Memorando aplicado a ${rows(dest).length} expediente(s)`);};

  function headerIndex(headers,aliases){const n=headers.map(up),s=new Set(aliases.map(up));return n.findIndex(x=>s.has(x));}
  async function parseExcel(file){
    if(!window.XLSX)throw new Error('No se encontró el componente XLSX.');
    const wb=XLSX.read(await file.arrayBuffer(),{type:'array',raw:false});
    const ws=wb.Sheets[wb.SheetNames[0]],aoa=XLSX.utils.sheet_to_json(ws,{header:1,raw:false,defval:'',blankrows:false});
    let hr=-1,idx=null;
    for(let i=0;i<Math.min(12,aoa.length);i++){
      const h=aoa[i]||[],x={exp:headerIndex(h,['EXPEDIENTE','N EXPEDIENTE','N° EXPEDIENTE','NUMERO EXPEDIENTE']),ext:headerIndex(h,['EXTENSION','EXTENSIÓN','EXT','EXT.']),rd:headerIndex(h,['RD','R.D.','R D','RESOLUCION DIRECTORAL']),folio:headerIndex(h,['ULTIMO FOLIO','ÚLTIMO FOLIO','ULT FOLIO','FOLIO FINAL']),memo:headerIndex(h,['N MEMORANDO','N° MEMORANDO','N.º MEMORANDO','NUMERO MEMORANDO','MEMORANDO','NRO MEMORANDO'])};
      if(x.exp>=0&&x.folio>=0&&x.memo>=0){hr=i;idx=x;break;}
    }
    if(hr<0)throw new Error('La plantilla debe contener Expediente, Último folio y N.º Memorando.');
    const out=[];
    for(let i=hr+1;i<aoa.length;i++){const r=aoa[i]||[],exp=canonExp(r[idx.exp]),ext=idx.ext>=0?clean(r[idx.ext]):'',rd=idx.rd>=0?clean(r[idx.rd]):'',folio=clean(r[idx.folio]),memo=clean(r[idx.memo]);if(!exp&&!ext&&!rd&&!folio&&!memo)continue;out.push({row:i+1,expediente:exp,extension:ext,rd,ultimo_folio:folio,numero_memorando:memo});}
    return out;
  }
  function variants(exp){const m=canonExp(exp).match(/^(\d+)-(\d{4})$/);return m?[canonExp(exp),`${parseInt(m[1],10)}-${m[2]}`]:[canonExp(exp)];}
  async function fetchRows(imported){
    const all=[...new Set(imported.flatMap(r=>variants(r.expediente)))],found=[];
    for(let i=0;i<all.length;i+=80){const {data,error}=await sb.from('expedientes').select('id,expediente,extension,rd,ultimo_folio,responsable,estado,cargo,modalidad').in('expediente',all.slice(i,i+80));if(error)throw error;found.push(...(data||[]));}
    return found;
  }
  async function activeDerivations(expedienteIds){
    const out=new Map();
    const ids=[...new Set((expedienteIds||[]).map(String).filter(Boolean))];
    if(!ids.length)return out;
    for(let i=0;i<ids.length;i+=200){
      const chunk=ids.slice(i,i+200);
      const {data,error}=await sb.rpc('v665_derivaciones_activas',{p_expediente_ids:chunk});
      if(error)throw error;
      (data||[]).forEach(x=>{
        const id=String(x?.expediente_id||'').trim();
        const dest=String(x?.destino||'').trim().toUpperCase();
        if(id&&dest&&!out.has(id))out.set(id,dest);
      });
    }
    return out;
  }
  function validateOperational(row,active){
    const myName=up(currentProfile?.nombre_personal||''),state=up(typeof operationalStatus==='function'?operationalStatus(row):row.estado),mine=!isLimitedUser()||up(row.responsable||'')===myName;
    if(!mine)return 'no se encuentra bajo su custodia';
    if(up(row.modalidad)==='COPIA DIGITAL')return 'es COPIA DIGITAL y no corresponde a una derivación física';
    if(active)return `ya se encuentra derivado a ${active==='INSTRUCCION'?'INSTRUCCIÓN':active}`;
    if(!['EN PRESTAMO','REASIGNADO','DEVUELTO AL ARCHIVO','CUSTODIA'].includes(state))return `estado actual no derivable: ${state||'SIN ESTADO'}`;
    return '';
  }
  window.v663LoadDerivationExcel=async function(dest,ev){
    const c=cfg(dest),file=ev?.target?.files?.[0];if(!file)return;
    errors[dest]=[];if(E(c.excelStatus))E(c.excelStatus).textContent='Leyendo Excel y validando el bloque...';
    try{
      const imported=await parseExcel(file);if(!imported.length)throw new Error('El archivo no contiene filas para procesar.');
      const seen=new Set(),pre=[],invalidRows=new Set();
      imported.forEach(r=>{
        const k=canonExp(r.expediente)+'|'+canonExt(r.extension);
        if(!/^\d+-\d{4}$/.test(r.expediente)){
          pre.push(`Fila ${r.row}: expediente inválido`);invalidRows.add(r.row);
        }else if(seen.has(k)){
          pre.push(`Fila ${r.row}: expediente duplicado`);invalidRows.add(r.row);
        }else{
          seen.add(k);
        }
        if(!r.ultimo_folio){pre.push(`Fila ${r.row}: falta Último folio`);invalidRows.add(r.row);}
        if(!r.numero_memorando){pre.push(`Fila ${r.row}: falta N.º Memorando`);invalidRows.add(r.row);}
      });
      const db=await fetchRows(imported),ids=db.map(x=>String(x.id)).filter(Boolean),active=await activeDerivations(ids),valid=[],validIds=new Set();
      for(const r of imported){
        if(invalidRows.has(r.row))continue;
        let matches=db.filter(x=>canonExp(x.expediente)===r.expediente);if(r.extension)matches=matches.filter(x=>canonExt(x.extension)===canonExt(r.extension));
        if(matches.length!==1){pre.push(`Fila ${r.row}: ${matches.length?'más de una coincidencia; indique Extensión':'no se encontró el expediente/extensión'}`);invalidRows.add(r.row);continue;}
        const e=matches[0],eid=String(e.id),bad=validateOperational(e,active.get(eid));
        if(bad){pre.push(`Fila ${r.row} · ${e.expediente}: ${bad}`);invalidRows.add(r.row);continue;}
        if(validIds.has(eid)){pre.push(`Fila ${r.row} · ${e.expediente}: expediente repetido en el bloque`);invalidRows.add(r.row);continue;}
        validIds.add(eid);
        valid.push({...e,rd:r.rd||e.rd||'',ultimo_folio:r.ultimo_folio,numero_memorando:r.numero_memorando});
      }
      errors[dest]=[...new Set(pre)];setRows(dest,valid.sort((a,b)=>String(a.expediente||'').localeCompare(String(b.expediente||''),'es',{numeric:true})));renderRows(dest);
      if(E(c.excelStatus))E(c.excelStatus).innerHTML=`<b>${valid.length}</b> válidos de ${imported.length} · <b>${uniqueMemos(dest).size}</b> memorandos · 1 correo${errors[dest].length?`<div class="v663-error-box"><b>${errors[dest].length} observación${errors[dest].length===1?'':'es'} excluida${errors[dest].length===1?'':'s'} del bloque:</b> ${safe(errors[dest].slice(0,12).join(' · '))}${errors[dest].length>12?' · …':''}</div>`:''}`;
      if(valid.length)syncSubject(dest,true);
    }catch(err){setRows(dest,[]);errors[dest]=[String(err?.message||err)];renderRows(dest);if(E(c.excelStatus))E(c.excelStatus).textContent=err?.message||String(err);}
    finally{if(ev?.target)ev.target.value='';}
  };
  window.v663DownloadDerivationTemplate=function(dest){
    if(!window.XLSX){showToast?.('No se pudo cargar el generador de Excel.');return;}
    const c=cfg(dest),list=rows(dest),sample=list.length?list.map(r=>[r.expediente||'',r.extension||'',r.rd||'',r.ultimo_folio||'',r.numero_memorando||'']):[['0105-2026','DSF-PA','','','00001234-2026-PRODUCE/DS-PA'],['0123-2017','DGS','','','00001235-2026-PRODUCE/DS-PA']];
    const ws=XLSX.utils.aoa_to_sheet([['Expediente','Extensión','R.D.','Último folio','N.º Memorando'],...sample]);ws['!cols']=[{wch:18},{wch:18},{wch:18},{wch:18},{wch:34}];const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,c.sheet);XLSX.writeFile(wb,`PLANTILLA_DERIVACION_${c.sheet}.xlsx`);
  };
  window.v663OpenDerivationExcel=function(dest){
    if(!allowed(dest)){showToast?.('Su perfil no está autorizado para registrar esta derivación.');return;}
    const c=cfg(dest);errors[dest]=[];setRows(dest,[]);E(c.modal)?.classList.add('show');if(E(c.memo))E(c.memo).value='';if(E(c.obs))E(c.obs).value='';if(E(c.excelStatus))E(c.excelStatus).textContent=`Cargue el Excel del bloque ${c.label}.`;renderRows(dest);window.v596PrepareDerivationMail?.(dest);setTimeout(()=>syncSubject(dest,true),0);
  };

  function selectedRecipientIds(dest){const i=mailIds(dest),enabled=E(i.enabled)?.checked!==false;if(!enabled)return [];return [...document.querySelectorAll('#'+i.recips+' input[data-v596-recipient]:checked')].map(x=>String(x.value)).filter(Boolean);}
  function mailBody(dest,items,summary,observation){
    const actor=clean(currentProfile?.nombre_personal||currentProfile?.email)||'USUARIO DEL SISTEMA',lines=[`Se comunica la derivación de un bloque de expedientes ${cfg(dest).phrase}, conforme a los movimientos registrados en el Sistema de Control y Trazabilidad de Expedientes.`,'',`Derivado por: ${actor}`,`Cantidad de expedientes: ${items.length}`,`Cantidad de memorandos: ${summary.length}`,...(observation?[`Observación: ${observation}`]:[]),'','Memorandos incluidos:'];
    summary.forEach((m,i)=>lines.push(`${i+1}. ${m.numero_memorando} · ${m.cantidad_expedientes} expediente${m.cantidad_expedientes===1?'':'s'}`));lines.push('','Expedientes:');items.forEach((r,i)=>lines.push(`${i+1}. ${r.expediente||'—'}${r.extension?` · Ext. ${r.extension}`:''}${r.rd?` · R.D. ${r.rd}`:''}${r.ultimo_folio?` · Último folio ${r.ultimo_folio}`:''} · Memorando ${r.numero_memorando}`));lines.push('','Este correo corresponde a una sola operación de derivación por bloque. Cada expediente conserva el memorando que le corresponde.');return lines.join('\n');
  }
  async function submit(dest){
    const c=cfg(dest),list=rows(dest);if(!list.length)return;syncState(dest);
    // V666: los errores del Excel corresponden a filas excluidas. No deben
    // impedir registrar las filas válidas que sí están dentro de `list`.
    if(list.some(r=>!clean(r.ultimo_folio)||!clean(r.numero_memorando)))return;
    const mi=mailIds(dest),sendMail=E(mi.enabled)?.checked!==false,recips=sendMail?selectedRecipientIds(dest):[];
    if(sendMail&&!recips.length){if(E(c.status))E(c.status).textContent='Seleccione al menos un destinatario para el correo.';return;}
    const btn=E(c.submit);if(btn)btn.disabled=true;
    const memos=uniqueMemos(dest),summary=[...memos.entries()].sort((a,b)=>a[0].localeCompare(b[0],'es',{numeric:true})).map(([numero_memorando,cantidad_expedientes])=>({numero_memorando,cantidad_expedientes}));
    if(E(c.status))E(c.status).textContent=`Registrando ${list.length} expediente(s) · ${summary.length} memorando(s) · ${sendMail?'1 correo':'sin correo'}...`;
    const observation=clean(E(c.obs)?.value),operationId=crypto?.randomUUID?.()||`${Date.now()}-${Math.random().toString(16).slice(2)}`;
    const items=list.map(x=>({expediente_id:x.id,expediente:clean(x.expediente),extension:clean(x.extension),rd:clean(x.rd)||null,ultimo_folio:clean(x.ultimo_folio),numero_memorando:clean(x.numero_memorando),observacion:observation||null}));
    const subject=clean(E(mi.subject)?.value)||defaultSubject(dest),body=sendMail?mailBody(dest,items,summary,observation):'';
    const {data,error}=await sb.rpc('v663_derivar_bloque',{p_destino:dest,p_items:items,p_operacion_id:operationId,p_asunto_correo:sendMail?subject:null,p_cuerpo:sendMail?body:null,p_destinatario_ids:sendMail?recips:[],p_metadata:{origen:'V663_HTML',destino:dest,bloque_multiple:true,derivado_por:clean(currentProfile?.nombre_personal)||null,seleccionado_por:session?.user?.id||currentProfile?.id||null,observacion:observation||null,cantidad_expedientes:items.length,cantidad_memorandos:summary.length,memorandos_resumen:summary,expedientes:items}});
    if(error){if(E(c.status))E(c.status).textContent='NO SE REGISTRÓ: '+error.message;if(btn)btn.disabled=false;return;}
    if(Number(data?.encoladas||0)>0)window.v586DrainMailInBackground?.('V663_DERIVACION_'+dest);
    selectedIds.clear();updateSelectionUI();E(c.modal)?.classList.remove('show');setRows(dest,[]);errors[dest]=[];showToast?.(`${Number(data?.total||items.length)} expediente(s) derivados ${c.phrase} · ${Number(data?.cantidad_memorandos||summary.length)} memorando(s) · ${Number(data?.encoladas||0)>0?'1 correo':'sin correo'}`);
    const jobs=[loadPanel(),loadAll(),loadStates(),loadHistory(),loadRequests(),c.folder()];await Promise.allSettled(jobs);
  }
  window.v663SubmitDerivation=submit;

  function enhanceModal(dest){
    const c=cfg(dest),modal=E(c.modal);if(!modal||modal.dataset.v663Excel==='1')return;modal.dataset.v663Excel='1';
    const memo=E(c.memo),memoField=memo?.closest('.field');if(!memoField)return;
    const label=memoField.querySelector('label');if(label)label.textContent='Memorando común (opcional)';
    const oldNote=memoField.querySelector('.note');if(oldNote)oldNote.textContent='Cada expediente puede tener un memorando distinto. Use “Aplicar a todos” solo cuando corresponda el mismo memorando para todo el bloque.';
    const wrap=document.createElement('div');wrap.className='v663-common-memo-row';memo.parentNode.insertBefore(wrap,memo);wrap.appendChild(memo);const apply=document.createElement('button');apply.type='button';apply.className='btn secondary small';apply.textContent='Aplicar a todos';apply.onclick=()=>window.v663ApplyCommonMemo(dest);wrap.appendChild(apply);
    const panel=document.createElement('div');panel.className='v663-excel-panel';panel.innerHTML=`<div class="v663-excel-tools"><button class="btn secondary" type="button" onclick="document.getElementById('${c.file}').click()">📥 Cargar Excel</button><button class="btn secondary" type="button" onclick="v663DownloadDerivationTemplate('${dest}')">⬇ Descargar plantilla</button><input class="hidden" id="${c.file}" type="file" accept=".xlsx,.xls,.csv,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel" onchange="v663LoadDerivationExcel('${dest}',event)"><span class="v663-excel-status" id="${c.excelStatus}">Puede trabajar con la selección actual o cargar un bloque completo desde Excel.</span></div><div class="note">Plantilla ${safe(c.label)}: <b>Expediente | Extensión | R.D. | Último folio | N.º Memorando</b>. Un mismo bloque puede contener varios memorandos y generará <b>un solo correo</b>.</div>`;
    memoField.parentNode.insertBefore(panel,memoField);
    const table=E(c.table),summary=document.createElement('div');summary.id=c.summary;summary.className='v663-memo-summary';table.parentNode.insertBefore(summary,table);
  }
  function addToolbarButtons(){
    // V664: se elimina el acceso separado "por Excel".
    // El Excel queda dentro del mismo centro de derivación de cada destino.
    return;
  }
  function roleUI(){[['v663ConasExcelOpenBtn','CONAS'],['v663DvcExcelOpenBtn','DVC'],['v663InstructionExcelOpenBtn','INSTRUCCION']].forEach(([id,dest])=>{const b=E(id);if(b){const ok=allowed(dest);b.classList.toggle('hidden-by-role',!ok);b.style.display=ok?'':'none';}});}

  function wrapOpen(dest,name){
    const base=window[name];if(typeof base!=='function')return;
    window[name]=async function(){errors[dest]=[];await base.apply(this,arguments);rows(dest).forEach(r=>{if(r.numero_memorando===undefined)r.numero_memorando='';});renderRows(dest);const s=E(cfg(dest).excelStatus);if(s)s.textContent='Puede completar los memorandos en pantalla o cargar un Excel para reemplazar el bloque.';setTimeout(()=>syncSubject(dest,true),0);};
    try{eval(name+'=window[name]');}catch(_){ }
  }
  function assignGlobals(){
    window.renderBulkConasRows=()=>renderRows('CONAS');window.renderBulkDvcRows=()=>renderRows('DVC');window.renderBulkInstructionRows=()=>renderRows('INSTRUCCION');
    window.syncBulkConasState=()=>syncState('CONAS');window.syncBulkDvcState=()=>syncState('DVC');window.syncBulkInstructionState=()=>syncState('INSTRUCCION');
    window.updateBulkConasField=(id,f,v)=>window.v663UpdateDerivationRow('CONAS',id,f,v);window.updateBulkDvcField=(id,f,v)=>window.v663UpdateDerivationRow('DVC',id,f,v);window.updateBulkInstructionField=(id,f,v)=>window.v663UpdateDerivationRow('INSTRUCCION',id,f,v);
    window.submitBulkConas=()=>submit('CONAS');window.submitBulkDvc=()=>submit('DVC');window.submitBulkInstruction=()=>submit('INSTRUCCION');
    try{renderBulkConasRows=window.renderBulkConasRows;renderBulkDvcRows=window.renderBulkDvcRows;renderBulkInstructionRows=window.renderBulkInstructionRows;syncBulkConasState=window.syncBulkConasState;syncBulkDvcState=window.syncBulkDvcState;syncBulkInstructionState=window.syncBulkInstructionState;updateBulkConasField=window.updateBulkConasField;updateBulkDvcField=window.updateBulkDvcField;updateBulkInstructionField=window.updateBulkInstructionField;submitBulkConas=window.submitBulkConas;submitBulkDvc=window.submitBulkDvc;submitBulkInstruction=window.submitBulkInstruction;}catch(_){ }
  }
  function boot(){
    Object.keys(C).forEach(enhanceModal);addToolbarButtons();assignGlobals();wrapOpen('CONAS','openBulkConasModal');wrapOpen('DVC','openBulkDvcModal');wrapOpen('INSTRUCCION','openBulkInstructionModal');roleUI();setTimeout(roleUI,500);setTimeout(roleUI,1800);try{console.info('V663 · Derivaciones masivas CONAS/DVC/Instrucción por Excel · varios memorandos · un correo');}catch(_){ }
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>


<script id="v663-role-ui-sync">
(function(){
  function sync(){
    const general=typeof currentProfile!=='undefined' && ['USUARIO','ARCHIVO','ADMINISTRADOR'].includes(String(currentProfile?.rol||'').trim().toUpperCase());
    ['v663ConasExcelOpenBtn','v663DvcExcelOpenBtn','v663InstructionExcelOpenBtn'].forEach(id=>{
      const b=document.getElementById(id);if(!b)return;const ok=general || (id==='v663ConasExcelOpenBtn' && window.v822MarcelaConasAllowed?.());b.classList.toggle('hidden-by-role',!ok);
    });
  }
  const base=window.applyRoleUI;
  if(typeof base==='function'){
    window.applyRoleUI=function(){const r=base.apply(this,arguments);try{sync();}catch(_){ }return r;};
    try{applyRoleUI=window.applyRoleUI;}catch(_){ }
  }
  document.addEventListener('DOMContentLoaded',sync,{once:true});
  window.addEventListener('focus',sync,{passive:true});
})();
</script>

<style id="v822-marcela-conas-style">
body.produce-coordinator-self #bulkConasBtn:not(:disabled){
  opacity:1!important;
  cursor:pointer!important;
}
</style>
<!-- V666 · EXCEL: DERIVA FILAS VÁLIDAS Y EXCLUYE OBSERVADAS -->
<!-- V665 · CONSULTA SEGURA DE DERIVACIONES ACTIVAS
     CONAS / DVC / INSTRUCCIÓN se validan mediante la RPC v665_derivaciones_activas.
     El navegador ya no consulta directamente las tablas movimientos_* protegidas por RLS/permisos. -->
<!-- V664 · CENTRO ÚNICO DE DERIVACIONES: SELECCIÓN / INGRESO DIRECTO / EXCEL -->
<style id="v664-centro-derivaciones-style">
.v664-source-panel{margin:8px 0 10px;padding:11px 12px;border:1px solid #b9cde0;border-radius:10px;background:#fbfdff}
.v664-source-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:8px}
.v664-source-head strong{color:#17365d;font-size:12px}
.v664-source-head .note{margin:2px 0 0;padding:0;border:0;background:transparent}
.v664-manual-grid{display:grid;grid-template-columns:minmax(180px,1fr) minmax(130px,.55fr) auto;gap:8px;align-items:end}
.v664-manual-grid .field{margin:0}
.v664-manual-actions{display:flex;gap:7px;align-items:center;flex-wrap:wrap}
.v664-manual-status{margin-top:7px;font-size:10.5px;color:#536d89;font-weight:700;line-height:1.4}
.v664-manual-status.bad{color:#9b1c1c}
.v664-source-badges{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.v664-source-badge{padding:4px 7px;border-radius:999px;border:1px solid #c9d8e8;background:#f6faff;color:#355a7d;font-size:9.5px;font-weight:800}
.v664-unified-note{margin:7px 0 0;padding:7px 9px;border-radius:8px;background:#eef6ff;border:1px solid #c6dcef;color:#355a7d;font-size:10px;line-height:1.45}
@media(max-width:780px){.v664-manual-grid{grid-template-columns:1fr}.v664-manual-actions{width:100%}.v664-manual-actions .btn{flex:1}}
</style>
<script id="v664-centro-derivaciones-script">
(function(){
  'use strict';
  const E=id=>document.getElementById(id);
  const clean=v=>String(v??'').trim();
  const up=v=>clean(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().replace(/\s+/g,' ').trim();
  const safe=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
  const canonExp=v=>{let s=clean(v).replace(/\s+/g,'').replace(/[–—]/g,'-');const m=s.match(/^(\d+)[\-\/](\d{4})$/);return m?`${((m[1].replace(/^0+(?=\d)/,'')||'0').length<4?(m[1].replace(/^0+(?=\d)/,'')||'0').padStart(4,'0'):(m[1].replace(/^0+(?=\d)/,'')||'0'))}-${m[2]}`:s.toUpperCase()};
  const canonExt=v=>up(v).replace(/\s+/g,'');
  const C={
    CONAS:{label:'CONAS',phrase:'al CONAS',modal:'bulkConasModal',table:'bulkConasTable',status:'bulkConasStatus',button:'bulkConasBtn',manualExp:'v664ConasManualExp',manualExt:'v664ConasManualExt',manualStatus:'v664ConasManualStatus',excelPanel:'v663ConasExcelFile',get:()=>bulkConasRows||[],set:v=>{bulkConasRows=v||[]},render:()=>window.renderBulkConasRows?.()},
    DVC:{label:'DVC',phrase:'a la DVC',modal:'bulkDvcModal',table:'bulkDvcTable',status:'bulkDvcStatus',button:'bulkDvcBtn',manualExp:'v664DvcManualExp',manualExt:'v664DvcManualExt',manualStatus:'v664DvcManualStatus',excelPanel:'v663DvcExcelFile',get:()=>bulkDvcRows||[],set:v=>{bulkDvcRows=v||[]},render:()=>window.renderBulkDvcRows?.()},
    INSTRUCCION:{label:'Instrucción',phrase:'a Instrucción',modal:'bulkInstructionModal',table:'bulkInstructionTable',status:'bulkInstructionStatus',button:'bulkInstructionBtn',manualExp:'v664InstructionManualExp',manualExt:'v664InstructionManualExt',manualStatus:'v664InstructionManualStatus',excelPanel:'v663InstructionExcelFile',get:()=>bulkInstructionRows||[],set:v=>{bulkInstructionRows=v||[]},render:()=>window.renderBulkInstructionRows?.()}
  };
  const cfg=d=>C[d];
  function allowed(dest){return typeof window.v839CanDerive==='function' && window.v839CanDerive(dest)===true;}
  function variants(exp){const m=canonExp(exp).match(/^(\d+)-(\d{4})$/);return m?[canonExp(exp),`${parseInt(m[1],10)}-${m[2]}`]:[canonExp(exp)];}
  function setManualStatus(dest,msg,bad=false){const x=E(cfg(dest).manualStatus);if(!x)return;x.textContent=msg||'';x.classList.toggle('bad',!!bad);}
  async function activeDerivations(ids){
    const out=new Map();
    const requestedIds=[...new Set((ids||[]).map(String).filter(Boolean))];
    if(!requestedIds.length)return out;
    for(let i=0;i<requestedIds.length;i+=200){
      const chunk=requestedIds.slice(i,i+200);
      const {data,error}=await sb.rpc('v665_derivaciones_activas',{p_expediente_ids:chunk});
      if(error)throw error;
      (data||[]).forEach(x=>{
        const id=String(x?.expediente_id||'').trim();
        const dest=String(x?.destino||'').trim().toUpperCase();
        if(id&&dest&&!out.has(id))out.set(id,dest);
      });
    }
    return out;
  }
  function validate(row,active){
    const myName=up(currentProfile?.nombre_personal||''),state=up(typeof operationalStatus==='function'?operationalStatus(row):row.estado),mine=!(typeof isLimitedUser==='function'&&isLimitedUser())||up(row.responsable||'')===myName;
    if(!mine)return 'no se encuentra bajo su custodia';
    if(up(row.modalidad)==='COPIA DIGITAL')return 'es COPIA DIGITAL y no corresponde a una derivación física';
    if(active)return `ya se encuentra derivado a ${active==='INSTRUCCION'?'INSTRUCCIÓN':active}`;
    if(!['EN PRESTAMO','REASIGNADO','DEVUELTO AL ARCHIVO','CUSTODIA'].includes(state))return `estado actual no derivable: ${state||'SIN ESTADO'}`;
    return '';
  }
  function normalizeRow(r){return {...r,rd:clean(r.rd),ultimo_folio:clean(r.ultimo_folio),numero_memorando:clean(r.numero_memorando)};}
  async function fetchByIds(ids){
    const all=[];
    for(let i=0;i<ids.length;i+=80){const {data,error}=await sb.from('expedientes').select('id,expediente,extension,rd,ultimo_folio,responsable,estado,cargo,modalidad').in('id',ids.slice(i,i+80));if(error)throw error;all.push(...(data||[]));}
    return all;
  }
  async function loadSelected(dest){
    const ids=[...(typeof selectedIds!=='undefined'?selectedIds:[])].map(String).filter(Boolean);
    if(!ids.length){setManualStatus(dest,'Puede ingresar un expediente por número o cargar un bloque desde Excel.');return;}
    setManualStatus(dest,`Verificando ${ids.length} expediente${ids.length===1?'':'s'} seleccionado${ids.length===1?'':'s'}...`);
    try{
      const db=await fetchByIds(ids),active=await activeDerivations(db.map(x=>String(x.id))),valid=[],invalid=[];
      db.forEach(r=>{const bad=validate(r,active.get(String(r.id)));if(bad)invalid.push(`${r.expediente||r.id}: ${bad}`);else valid.push(normalizeRow(r));});
      cfg(dest).set(valid.sort((a,b)=>String(a.expediente||'').localeCompare(String(b.expediente||''),'es',{numeric:true})));cfg(dest).render();
      if(invalid.length)setManualStatus(dest,`${valid.length} expediente(s) cargado(s). Se excluyeron ${invalid.length}: ${invalid.slice(0,4).join(' · ')}${invalid.length>4?' · …':''}`,true);
      else setManualStatus(dest,`${valid.length} expediente${valid.length===1?'':'s'} seleccionado${valid.length===1?'':'s'} cargado${valid.length===1?'':'s'}. Complete folio y memorando cuando corresponda.`);
    }catch(err){setManualStatus(dest,'No se pudo validar la selección: '+(err?.message||String(err)),true);}
  }
  async function findManual(dest){
    if(!allowed(dest))return;
    const c=cfg(dest),exp=canonExp(E(c.manualExp)?.value),ext=canonExt(E(c.manualExt)?.value);
    if(!/^\d+-\d{4}$/.test(exp)){setManualStatus(dest,'Ingrese el expediente con formato NÚMERO-AÑO. Ej.: 1234-2025 o 132456-2005.',true);return;}
    setManualStatus(dest,`Buscando ${exp}${ext?' · Ext. '+ext:''}...`);
    try{
      const {data,error}=await sb.from('expedientes').select('id,expediente,extension,rd,ultimo_folio,responsable,estado,cargo,modalidad').in('expediente',variants(exp));if(error)throw error;
      let matches=(data||[]).filter(x=>canonExp(x.expediente)===exp);if(ext)matches=matches.filter(x=>canonExt(x.extension)===ext);
      if(!matches.length){setManualStatus(dest,'No se encontró el expediente/extensión en el Registro Maestro.',true);return;}
      if(matches.length>1){setManualStatus(dest,'Existe más de una coincidencia. Ingrese la Extensión para identificar el expediente correcto.',true);return;}
      const row=matches[0],active=await activeDerivations([String(row.id)]),bad=validate(row,active.get(String(row.id)));if(bad){setManualStatus(dest,`${row.expediente}: ${bad}.`,true);return;}
      const list=[...c.get()];if(list.some(x=>String(x.id)===String(row.id))){setManualStatus(dest,'El expediente ya está incluido en este bloque.',true);return;}
      list.push(normalizeRow(row));list.sort((a,b)=>String(a.expediente||'').localeCompare(String(b.expediente||''),'es',{numeric:true}));c.set(list);c.render();
      if(E(c.manualExp))E(c.manualExp).value='';if(E(c.manualExt))E(c.manualExt).value='';setManualStatus(dest,`${row.expediente}${row.extension?' · '+row.extension:''} agregado. Puede agregar otro expediente o continuar con la derivación.`);
      E(c.manualExp)?.focus();
    }catch(err){setManualStatus(dest,'No se pudo agregar el expediente: '+(err?.message||String(err)),true);}
  }
  window.v664AddDerivationManual=findManual;
  window.v664LoadSelectedDerivation=loadSelected;

  function enhance(dest){
    const c=cfg(dest),modal=E(c.modal);if(!modal||modal.dataset.v664Unified==='1')return;modal.dataset.v664Unified='1';
    const box=modal.querySelector('.modal-box'),head=box?.querySelector('.modal-head');if(!box||!head)return;
    const h2=head.querySelector('h2');if(h2)h2.textContent=`Derivar expediente(s) ${c.phrase}`;
    const note=head.querySelector('.note');if(note)note.innerHTML=`Use una sola operación para derivar <b>un expediente o un bloque completo</b>. Puede utilizar expedientes marcados en el Registro Maestro, ingresar un expediente directamente o cargar un Excel. Cada expediente conserva su propio N.º de Memorando.`;
    const v663Panel=box.querySelector('.v663-excel-panel');
    const panel=document.createElement('div');panel.className='v664-source-panel';panel.innerHTML=`
      <div class="v664-source-head"><div><strong>Agregar expediente individual</strong><div class="note">Ingrese el número directamente. Puede repetir la operación para armar un bloque manual.</div></div><div class="v664-source-badges"><span class="v664-source-badge">1 expediente</span><span class="v664-source-badge">varios seleccionados</span><span class="v664-source-badge">Excel masivo</span></div></div>
      <div class="v664-manual-grid">
        <div class="field"><label>Expediente</label><input id="${c.manualExp}" placeholder="Ej.: 1234-2025" autocomplete="off"></div>
        <div class="field"><label>Extensión (si corresponde)</label><input id="${c.manualExt}" placeholder="Ej.: DSF-PA" autocomplete="off"></div>
        <div class="v664-manual-actions"><button class="btn" type="button" onclick="v664AddDerivationManual('${dest}')">＋ Buscar y agregar</button></div>
      </div>
      <div class="v664-manual-status" id="${c.manualStatus}">Puede ingresar un expediente o utilizar las otras opciones de carga.</div>
      <div class="v664-unified-note"><b>Flujo único:</b> no importa si deriva 1 o 100 expedientes; la validación, el último folio, el memorando por expediente, el historial y la comunicación se procesan con la misma lógica.</div>`;
    (v663Panel||head).insertAdjacentElement(v663Panel?'beforebegin':'afterend',panel);
    [c.manualExp,c.manualExt].forEach(id=>E(id)?.addEventListener('keydown',ev=>{if(ev.key==='Enter'){ev.preventDefault();findManual(dest);}}));
  }
  async function openUnified(dest){
    if(typeof window.v839CanDeriveFresh!=='function' || !(await window.v839CanDeriveFresh(dest))){showToast?.('No tiene permiso activo para derivar a este destino. Consulte al administrador.');return;}
    const c=cfg(dest);
    // V663 abre el modal vacío y, además, reinicia de forma segura los errores de una carga Excel anterior.
    if(typeof window.v663OpenDerivationExcel==='function')window.v663OpenDerivationExcel(dest);else E(c.modal)?.classList.add('show');
    if(E(c.manualExp))E(c.manualExp).value='';if(E(c.manualExt))E(c.manualExt).value='';
    const selectedCount=typeof selectedIds!=='undefined'?selectedIds.size:0;
    if(selectedCount){await loadSelected(dest);}else setManualStatus(dest,'No hay filas marcadas. Ingrese un expediente directamente o cargue un Excel masivo.');
    if(E(c.status)&&!c.get().length)E(c.status).textContent='Agregue al menos un expediente para continuar.';
    setTimeout(()=>E(c.manualExp)?.focus(),80);
  }
  window.v664OpenDerivation=openUnified;

  function removeOldExcelButtons(){['v663ConasExcelOpenBtn','v663DvcExcelOpenBtn','v663InstructionExcelOpenBtn'].forEach(id=>E(id)?.remove());}
  function syncMainButtons(){
    Object.values(C).forEach(c=>{const b=E(c.button);if(!b)return;const ok=allowed(c.label==='Instrucción'?'INSTRUCCION':c.label);b.disabled=!ok;b.classList.toggle('hidden-by-role',!ok);b.style.display=ok?'':'none';b.title=ok?`Derivar uno o varios expedientes ${c.phrase}: selección actual, ingreso directo o Excel`:'Función no disponible para este perfil';});
  }
  function assignOpeners(){
    window.openBulkConasModal=()=>openUnified('CONAS');window.openBulkDvcModal=()=>openUnified('DVC');window.openBulkInstructionModal=()=>openUnified('INSTRUCCION');
    try{openBulkConasModal=window.openBulkConasModal;openBulkDvcModal=window.openBulkDvcModal;openBulkInstructionModal=window.openBulkInstructionModal;}catch(_){ }
  }
  function wrapUiFunctions(){
    const u=window.updateSelectionUI;if(typeof u==='function'&&!u.__v664){const w=function(){const r=u.apply(this,arguments);syncMainButtons();return r};w.__v664=true;window.updateSelectionUI=w;try{updateSelectionUI=w}catch(_){ }}
    const a=window.applyRoleUI;if(typeof a==='function'&&!a.__v664){const w=function(){const r=a.apply(this,arguments);removeOldExcelButtons();syncMainButtons();return r};w.__v664=true;window.applyRoleUI=w;try{applyRoleUI=w}catch(_){ }}
  }
  function boot(){
    Object.keys(C).forEach(enhance);removeOldExcelButtons();assignOpeners();wrapUiFunctions();syncMainButtons();
    Object.values(C).forEach(c=>{const b=E(c.button);if(b)b.textContent=`↗ Derivar ${c.phrase}`;});
    setTimeout(()=>{removeOldExcelButtons();syncMainButtons();},500);setTimeout(()=>{removeOldExcelButtons();syncMainButtons();},1800);
    try{console.info('V664 · Centro único de derivaciones · individual, selección múltiple y Excel en un mismo flujo');}catch(_){ }
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>

<!-- V668 · Regla general: cuando el Administrador cierra una solicitud completa, todos sus expedientes pendientes sin entrega física quedan liberados para una nueva solicitud; se preservan ciclos posteriores activos y derivaciones vigentes. -->
<!-- V670 · Corrige integración visual: usa currentRequest/currentRequestId reales del sistema para mostrar Modalidad de atención en Gestionar solicitud. -->
<style id="v669-modality-style">
#v669ModalitySection{border:1px solid #cbdcf4;background:#f8fbff;margin-bottom:12px}
.v669-modality-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:10px 0}
.v669-modality-summary>div{border:1px solid #dbe7f6;background:#fff;border-radius:8px;padding:8px 10px;min-width:0}
.v669-modality-summary span{display:block;font-size:10px;font-weight:800;color:#64748b;text-transform:uppercase;margin-bottom:3px}
.v669-modality-summary b{display:block;font-size:12px;color:#123f78;overflow-wrap:anywhere}
.v669-modality-foot{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-top:8px}
.v669-modality-status{margin-top:7px;font-weight:700}
#v669ModalitySection.v669-readonly{background:#fafafa}
@media(max-width:900px){.v669-modality-summary{grid-template-columns:1fr}.v669-modality-grid{grid-template-columns:1fr!important}.v669-modality-grid .span2{grid-column:1!important}}
</style>
<script id="v669-modality-script">
(function(){
  'use strict';
  let v669Context=null;
  let v669LoadSeq=0;
  const $=id=>document.getElementById(id);
  const up=v=>String(v??'').trim().toUpperCase();

  function dateText(v){
    if(!v)return '';
    try{return new Date(v).toLocaleString('es-PE',{dateStyle:'short',timeStyle:'short'});}catch(_){return String(v)}
  }

  function reasonText(){
    const type=String($('v669ReasonType')?.value||'').trim();
    const detail=String($('v669ReasonDetail')?.value||'').trim();
    if(!type)return '';
    if(type==='OTRO')return detail?`OTRO: ${detail}`:'';
    return detail?`${type}: ${detail}`:type;
  }

  window.v669SyncReasonUI=function(){
    const type=String($('v669ReasonType')?.value||'').trim();
    const box=$('v669ReasonDetailBox');
    if(box)box.classList.toggle('hidden',type!=='OTRO');
    if(type!=='OTRO' && $('v669ReasonDetail'))$('v669ReasonDetail').value='';
  };

  window.v669SyncChangeButton=function(){
    const btn=$('v669ChangeModeBtn');
    if(!btn)return;
    const next=up($('v669NewMode')?.value);
    const current=up(v669Context?.modalidad_actual||currentRequest?.modalidad||'');
    const reason=reasonText();
    btn.disabled=!(v669Context?.puede_cambiar===true && next && next!==current && reason);
  };

  function resetControls(){
    if($('v669NewMode'))$('v669NewMode').value='';
    if($('v669ReasonType'))$('v669ReasonType').value='';
    if($('v669ReasonDetail'))$('v669ReasonDetail').value='';
    $('v669ReasonDetailBox')?.classList.add('hidden');
    if($('v669ModeStatus'))$('v669ModeStatus').textContent='';
    window.v669SyncChangeButton();
  }

  function render(){
    const panel=$('v669ModalitySection');
    if(!panel)return;

    const full=typeof hasFullAccess==='function' && hasFullAccess() && !(typeof isCoordinator==='function' && isCoordinator());
    if(!full || !currentRequest){
      panel.classList.add('hidden');
      return;
    }

    panel.classList.remove('hidden');
    const original=up(v669Context?.modalidad_original||currentRequest?.modalidad||'PRÉSTAMO');
    const current=up(v669Context?.modalidad_actual||currentRequest?.modalidad||'PRÉSTAMO');
    if($('v669OriginalMode'))$('v669OriginalMode').textContent=original||'—';
    if($('v669CurrentMode'))$('v669CurrentMode').textContent=current||'—';

    const last=v669Context?.ultimo_cambio;
    if($('v669LastChange')){
      $('v669LastChange').textContent=last
        ?`${up(last.modalidad_anterior)} → ${up(last.modalidad_nueva)}${last.cambiado_por?' · '+last.cambiado_por:''}${last.changed_at?' · '+dateText(last.changed_at):''}`
        :'Sin cambios';
    }

    const can=v669Context?.puede_cambiar===true;
    panel.classList.toggle('v669-readonly',!can);
    ['v669NewMode','v669ReasonType','v669ReasonDetail'].forEach(id=>{if($(id))$(id).disabled=!can;});
    if($('v669ModeRule')){
      if(can){
        $('v669ModeRule').innerHTML=current==='COPIA DIGITAL'
          ?'Puede cambiar nuevamente solo si todavía no se entregó ninguna copia. Para volver a una modalidad física, todos los expedientes deben estar disponibles en Archivo.'
          :'<b>Ejemplo:</b> si se solicitó PRÉSTAMO pero el físico no está disponible y existe copia digital, seleccione COPIA DIGITAL. Se cancelará la espera física asociada a esta solicitud, sin modificar la custodia real del expediente.';
      }else{
        $('v669ModeRule').textContent='La modalidad ya no puede cambiarse porque la solicitud inició o cerró su atención (cargo, entrega física o copia digital entregada).';
      }
    }
    window.v669SyncChangeButton();
  }

  window.v669LoadModeContext=async function(requestId){
    const seq=++v669LoadSeq;
    const panel=$('v669ModalitySection');
    const full=typeof hasFullAccess==='function' && hasFullAccess() && !(typeof isCoordinator==='function' && isCoordinator());
    if(!full || !requestId){if(panel)panel.classList.add('hidden');return null;}
    if(panel)panel.classList.remove('hidden');
    if($('v669ModeStatus'))$('v669ModeStatus').textContent='Consultando modalidad de atención…';
    try{
      const {data,error}=await sb.rpc('v669_contexto_modalidad_solicitud',{p_solicitud_id:requestId});
      if(error)throw error;
      if(seq!==v669LoadSeq || String(currentRequestId||'')!==String(requestId))return null;
      v669Context=data||null;
      if(currentRequest && data?.modalidad_actual)currentRequest.modalidad=data.modalidad_actual;
      resetControls();
      render();
      return data;
    }catch(error){
      v669Context=null;
      if($('v669ModeStatus'))$('v669ModeStatus').textContent=error?.message||String(error);
      render();
      return null;
    }
  };

  window.v669SubmitModeChange=async function(){
    if(!(typeof hasFullAccess==='function' && hasFullAccess()))return;
    const id=currentRequestId;
    const next=up($('v669NewMode')?.value);
    const reason=reasonText();
    const btn=$('v669ChangeModeBtn');
    const status=$('v669ModeStatus');
    if(!id){if(status)status.textContent='No se pudo identificar la solicitud.';return;}
    if(!next){if(status)status.textContent='Seleccione la nueva modalidad.';return;}
    if(!reason){if(status)status.textContent='Seleccione e indique el motivo del cambio.';return;}
    if(btn){btn.disabled=true;btn.textContent='Aplicando cambio…';}
    if(status)status.textContent='Actualizando modalidad y registrando trazabilidad…';
    try{
      const {data,error}=await sb.rpc('v669_cambiar_modalidad_solicitud',{
        p_solicitud_id:id,
        p_modalidad:next,
        p_motivo:reason
      });
      if(error)throw error;

      if(typeof requestDetailCacheV358!=='undefined' && requestDetailCacheV358?.delete){
        requestDetailCacheV358.delete(String(id));
      }
      try{if(typeof requestViewCache!=='undefined')requestViewCache=null;}catch(_){ }
      if(currentRequest)currentRequest.modalidad=next;

      if(typeof showToast==='function'){
        const waits=Number(data?.esperas_fisicas_canceladas||0);
        showToast(`Modalidad actualizada: ${data?.modalidad_anterior||''} → ${data?.modalidad_nueva||next}${waits?` · ${waits} espera(s) física(s) cancelada(s)`:''}`);
      }

      const jobs=[];
      if(typeof loadSummary==='function')jobs.push(loadSummary());
      if(typeof loadRequests==='function')jobs.push(loadRequests());
      if(typeof loadAll==='function')jobs.push(loadAll());
      if(typeof loadStates==='function')jobs.push(loadStates());
      await Promise.allSettled(jobs);
      await window.openRequestDetail(id);
    }catch(error){
      if(status)status.textContent=error?.message||String(error);
    }finally{
      if(btn){btn.textContent='Aplicar cambio de modalidad';}
      window.v669SyncChangeButton();
    }
  };

  const baseOpen=window.openRequestDetail;
  if(typeof baseOpen==='function'){
    window.openRequestDetail=async function(id){
      const result=await baseOpen.apply(this,arguments);
      await window.v669LoadModeContext(id);
      return result;
    };
  }

  const baseRenderActions=window.renderRequestActions;
  if(typeof baseRenderActions==='function'){
    window.renderRequestActions=function(){
      const result=baseRenderActions.apply(this,arguments);
      setTimeout(render,0);
      return result;
    };
  }

  const baseClose=window.closeRequestDetail;
  if(typeof baseClose==='function'){
    window.closeRequestDetail=function(){
      ++v669LoadSeq;
      v669Context=null;
      $('v669ModalitySection')?.classList.add('hidden');
      resetControls();
      return baseClose.apply(this,arguments);
    };
  }

  window.v669ModalityInfo=function(){return {version:'V669',rule:'Archivo/Admin puede adecuar modalidad antes de iniciar atención; cambio auditado y copia digital no altera custodia física.'};};
})();
</script>\n

<script id="v673-coordinador-pendientes-propios-sincronizados">
(function(){
  'use strict';

  // ==========================================================
  // V673 · COORDINADOR: PENDIENTES PROPIOS = MISMA FUENTE ADMIN
  //
  // Problema observado:
  // - la bandeja general reconoce expedientes ACEPTADOS pendientes;
  // - el espacio personal de un COORDINADOR podía mostrar 0 porque V414
  //   intentaba usar V310, función diseñada para consultar integrantes
  //   con perfil USUARIO, no al propio COORDINADOR.
  //
  // Regla:
  // - para el propio Coordinador, usar V409 -> listar_tarjeta_usuario_admin_v5;
  // - PENDIENTES POR ATENDER son ítems SOLICITADO/ACEPTADO sin entrega;
  // - EN PRÉSTAMO sigue siendo exclusivamente custodia física directa;
  // - REASIGNADO permanece en su tarjeta separada.
  // ==========================================================

  async function v673CoordinatorOwnPendingRows(search=''){
    if(!sb||!session)return [];
    if(typeof isCoordinatorSelfWorkspaceV206!=='function' || !isCoordinatorSelfWorkspaceV206())return [];

    const nombre=String(currentProfile?.nombre_personal||'').trim();
    if(!nombre)return [];

    const response=await coordinatorCardRpcV404({
      p_nombre:nombre,
      p_tipo:'PENDIENTES_POR_ATENDER',
      p_busqueda:cleanSearch(search||'')||null
    });

    if(response?.error)throw response.error;

    let rows=typeof v211JsonRows==='function'
      ?v211JsonRows(response?.data)
      :(Array.isArray(response?.data)?response.data:[]);

    try{
      if(typeof enrichPendingAttentionRequestTimes==='function'){
        rows=await enrichPendingAttentionRequestTimes(rows||[]);
      }
    }catch(error){
      console.warn('V673 · fecha/hora pendientes propios:',error?.message||error);
    }

    try{
      if(typeof enrichPendingAttentionMasterFieldsV148==='function'){
        rows=await enrichPendingAttentionMasterFieldsV148(rows||[]);
      }
    }catch(error){
      console.warn('V673 · datos maestros pendientes propios:',error?.message||error);
    }

    return typeof sortPendingAttentionByDateDesc==='function'
      ?sortPendingAttentionByDateDesc(rows||[])
      :(rows||[]);
  }

  const pendingBeforeV673=window.loadMyPendingAttentionRows;
  window.loadMyPendingAttentionRows=async function(search=''){
    if(
      typeof isCoordinatorSelfWorkspaceV206==='function' &&
      isCoordinatorSelfWorkspaceV206()
    ){
      try{
        return await v673CoordinatorOwnPendingRows(search);
      }catch(error){
        console.warn('V673 · pendientes propios del Coordinador:',error?.message||error);
        // Evitar volver a V310, que no admite al propio COORDINADOR como objetivo.
        return [];
      }
    }

    if(typeof pendingBeforeV673==='function'){
      return pendingBeforeV673(search);
    }
    return [];
  };

  window.coordinatorSelfSummaryV207=async function(){
    if(!sb||!session||!isCoordinatorSelfWorkspaceV206())return null;

    const name=String(currentProfile?.nombre_personal||'').trim();
    if(!name)return null;

    const [summaryResult,pendingRows]=await Promise.all([
      sb.rpc('v646_resumen_usuarios_agrupado',{p_nombres:[name]}),
      v673CoordinatorOwnPendingRows('').catch(error=>{
        console.warn('V673 · resumen pendientes propios:',error?.message||error);
        return [];
      })
    ]);

    if(summaryResult.error)throw summaryResult.error;

    await loadInternalReassignRequests(true);

    const grouped=Array.isArray(summaryResult.data)?summaryResult.data:[];
    const s=grouped.find(x=>norm(x?.nombre||'')===norm(name))||grouped[0]||{};

    return {
      todos:Number(s.total_custodia||0),
      en_prestamo:Number(s.en_prestamo||0),
      pendientes_por_atender:Array.isArray(pendingRows)?pendingRows.length:0,
      devolucion_solicitada:Number(s.devolucion_solicitada||0),
      reasignados_por_mi:Number(s.reasignados_por_mi||0),
      reasignados_a_mi:Number(s.reasignados_a_mi||0),
      devueltos:Number(s.devueltos_al_archivo||0),
      alertas_30:Number(s.alertas_30||0),
      solicitudes_reasignacion:receivedPendingReassignRowsV196().length,
      reasignaciones_solicitadas_por_mi:sentPendingReassignRowsV197().length
    };
  };

  // Eliminar el snapshot que pudo guardar el 0 anterior.
  try{
    for(let i=sessionStorage.length-1;i>=0;i--){
      const key=sessionStorage.key(i)||'';
      if(key.startsWith('v637_user_summary_')){
        sessionStorage.removeItem(key);
      }
    }
  }catch(_){ }

  // Ajustar también el rótulo si una versión previa ya dejó el DOM construido.
  function syncLabelsV673(){
    try{
      const card=document.getElementById('userKpiLoanCard');
      const label=card?.querySelector?.('.label');
      if(label)label.textContent='En préstamo';
    }catch(_){ }
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',syncLabelsV673,{once:true});
  }else{
    syncLabelsV673();
  }

  window.v673PendingCoordinatorInfo=function(){
    return {
      ownPendingSource:'v409_coordinador_tarjeta_equipo -> listar_tarjeta_usuario_admin_v5',
      loanCardMeaning:'solo expedientes físicamente EN PRÉSTAMO',
      reassignedMeaning:'custodia vigente recibida por reasignación',
      pendingMeaning:'solicitud aceptada/pendiente sin entrega física'
    };
  };
})();
</script>



<!-- V674 · MATRIZ DE PERFILES Y PROTECCIÓN DE PERFIL INCOMPLETO -->
<style id="v674-role-audit-style">
body.produce-coordinator-team #newRecordBtn,
body.produce-coordinator-team #custodyIncorporateBtn,
body.produce-coordinator-team #archiveNewRequestBtn,
body.produce-coordinator-team #cargoBtn,
body.produce-coordinator-team #importCsvBtn,
body.produce-coordinator-team #exportCsvBtn,
body.produce-coordinator-team #peopleBtn,
body.produce-coordinator-team #subjectsBtn,
body.produce-coordinator-team #usersBtn,
body.produce-coordinator-team #configBtn,
body.produce-coordinator-team [data-tab="reassignTracking"]{display:none!important;}
.v674-profile-warning{margin:8px 0;padding:9px 12px;border:1px solid #f0c36d;border-radius:8px;background:#fff8e6;color:#6b4a00;font-size:11px;font-weight:800;}
</style>
<script id="v674-role-audit-script">
(function(){
  'use strict';
  const operationalIds=['searchRequestBtn','coordinatorNewRequestBtnV396','bulkReassignBtn','bulkReturnBtn','bulkConasBtn','bulkDvcBtn','bulkInstructionBtn','requestNewRequestBtn'];
  let warned=false;

  window.v674RoleMatrix={
    ADMINISTRADOR:'Gestión total',
    ARCHIVO:'Gestión archivística total',
    COORDINADOR_SELF:'Operación sobre expedientes propios + solicitud propia',
    COORDINADOR_TEAM:'Consulta y seguimiento del equipo',
    USUARIO:'Operación sobre solicitudes y custodia propias'
  };

  function profileIncomplete(){
    try{
      if(!currentProfile||currentProfile.activo===false)return false;
      const role=norm(currentProfile.rol||'');
      return ['USUARIO','COORDINADOR'].includes(role) && !String(currentProfile.nombre_personal||'').trim();
    }catch(_){return false;}
  }

  function syncProfileCompletenessV674(){
    const incomplete=profileIncomplete();
    operationalIds.forEach(id=>{
      const n=document.getElementById(id);
      if(!n)return;
      if(incomplete){
        n.disabled=true;
        n.title='Perfil incompleto: falta asociar el nombre del personal.';
      }
    });
    let box=document.getElementById('v674ProfileWarning');
    if(incomplete){
      if(!box){
        box=document.createElement('div');
        box.id='v674ProfileWarning';
        box.className='v674-profile-warning';
        box.textContent='Perfil incompleto: falta asociar el nombre del personal. Las operaciones personales permanecerán bloqueadas hasta completar el perfil.';
        const main=document.querySelector('.main');
        if(main)main.prepend(box);
      }
      if(!warned){
        warned=true;
        try{showToast?.('Perfil incompleto: falta asociar el nombre del personal.');}catch(_){}
      }
    }else if(box){
      box.remove();
    }
  }

  const baseApply=window.applyRoleUI;
  if(typeof baseApply==='function'){
    window.applyRoleUI=function(){
      const result=baseApply.apply(this,arguments);
      syncProfileCompletenessV674();
      return result;
    };
  }

  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',syncProfileCompletenessV674,{once:true});
  else syncProfileCompletenessV674();
})();
</script>


