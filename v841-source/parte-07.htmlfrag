  const state={
    mode:'NORMAL',
    candidate:'NORMAL',
    candidateSince:0,
    changedAt:Date.now(),
    lastPassiveAt:0,
    avoided:0,
    coalesced:0,
    paused:0,
    queued:0,
    completed:0,
    failures:0,
    wrappers:{},
    queue:[],
    running:0
  };
  const rank={NORMAL:0,AHORRO_SUAVE:1,AHORRO_LOCAL:2,AHORRO_INTENSIVO:3};
  const now=()=>Date.now();
  const el=id=>document.getElementById(id);
  const setText=(id,value)=>{const n=el(id);if(n)n.textContent=String(value??'—');};
  const norm=v=>String(v??'').trim().normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase();

  function observedHealth(){
    try{return window.v605HealthInfo?.()||{};}catch(_){return {};}
  }
  function desiredMode(){
    const info=observedHealth();
    const local=norm(info.local_state||'NORMAL');
    const server=norm(info.server?.status||'NORMAL');
    const native=norm(window.v601Protection?.state?.mode||'NORMAL');
    if(native==='PROTECCION'||server==='PROTECCION')return 'AHORRO_INTENSIVO';
    if(server==='ALTA_CARGA')return 'AHORRO_INTENSIVO';
    if(local==='PROTECCION')return 'AHORRO_INTENSIVO';
    if(local==='ALTA_CARGA')return server==='NORMAL'?'AHORRO_LOCAL':'AHORRO_INTENSIVO';
    if(local==='PRECAUCION'||server==='PRECAUCION')return 'AHORRO_SUAVE';
    return 'NORMAL';
  }
  function updateMode(){
    const target=desiredMode();
    if(target===state.mode){state.candidate=target;state.candidateSince=now();renderSavings();return state.mode;}
    if((rank[target]||0)>(rank[state.mode]||0)){
      state.mode=target;state.candidate=target;state.candidateSince=now();state.changedAt=now();renderSavings();return state.mode;
    }
    if(target!==state.candidate){state.candidate=target;state.candidateSince=now();renderSavings();return state.mode;}
    // Recuperación progresiva: exigir 30 s estables antes de reducir protección.
    if(now()-state.candidateSince>=30000){state.mode=target;state.changedAt=now();renderSavings();}
    return state.mode;
  }
  function modeLabel(){return ({NORMAL:'NORMAL',AHORRO_SUAVE:'AHORRO SUAVE',AHORRO_LOCAL:'AHORRO LOCAL',AHORRO_INTENSIVO:'AHORRO INTENSIVO'})[state.mode]||state.mode;}
  function modeDescription(){
    if(state.mode==='AHORRO_SUAVE')return 'Se amplía el caché y se reducen refrescos secundarios.';
    if(state.mode==='AHORRO_LOCAL')return 'Servidor estable: se reduce trabajo de este navegador, precargas y lecturas repetidas.';
    if(state.mode==='AHORRO_INTENSIVO')return 'Se pausan lecturas secundarias y se priorizan las operaciones manuales.';
    return 'Lecturas automáticas en régimen normal.';
  }
  function modeChipState(){return state.mode==='NORMAL'?'NORMAL':state.mode==='AHORRO_SUAVE'?'PRECAUCION':state.mode==='AHORRO_LOCAL'?'ALTA_CARGA':'PROTECCION';}
  function renderSavings(){
    setText('v608SavingMode',modeLabel());
    setText('v608SavingModeText',modeDescription());
    setText('v608AvoidedCalls',state.avoided);
    setText('v608CoalescedCalls',state.coalesced);
    setText('v608PausedRefreshes',state.paused);
    const chip=el('v608SavingChip');if(chip){chip.dataset.state=modeChipState();chip.textContent=state.mode==='NORMAL'?'Monitoreando':'Protección activa';}
    document.body?.classList.toggle('v608-saving-soft',state.mode==='AHORRO_SUAVE');
    document.body?.classList.toggle('v608-saving-local',state.mode==='AHORRO_LOCAL');
    document.body?.classList.toggle('v608-saving-protection',state.mode==='AHORRO_INTENSIVO');
  }
  function modeTtl(base){
    if(state.mode==='AHORRO_INTENSIVO')return Math.max(base*4,90000);
    if(state.mode==='AHORRO_LOCAL')return Math.max(base*3,60000);
    if(state.mode==='AHORRO_SUAVE')return Math.max(base*2,30000);
    return base;
  }
  function concurrency(){
    if(state.mode==='AHORRO_INTENSIVO')return 1;
    if(state.mode==='AHORRO_LOCAL')return 2;
    return 3;
  }
  function pump(){
    const max=concurrency();
    while(state.running<max&&state.queue.length){
      const job=state.queue.shift();
      state.running+=1;
      Promise.resolve().then(job.run).then(job.resolve,job.reject).finally(()=>{state.running-=1;state.completed+=1;pump();});
    }
  }
  function enqueue(run){
    return new Promise((resolve,reject)=>{state.queue.push({run,resolve,reject});state.queued+=1;pump();});
  }

  // V608 · Los resúmenes de las tarjetas pueden disparar decenas de RPC al mismo tiempo.
  // Se coordinan solamente estas lecturas pesadas; escrituras y RPC operativas quedan intactas.
  const heavyRpcNames=new Set(['resumen_tarjetas_usuario_admin_v5','listar_solicitudes_prestamo','v170_listar_mis_tareas']);
  const heavyRpcFlights=new Map();
  function patchSupabaseRpc(){
    let client=null;
    try{client=(typeof sb!=='undefined'&&sb)?sb:window.sb;}catch(_){client=window.sb;}
    if(!client||typeof client.rpc!=='function'||client.rpc.__v608Wrapped)return false;
    const original=client.rpc.bind(client);
    const wrapped=function(fn,params,options){
      const name=String(fn||'');
      if(!heavyRpcNames.has(name))return original(fn,params,options);
      const key=name+':'+JSON.stringify(params||{});
      if(heavyRpcFlights.has(key)){state.coalesced+=1;renderSavings();return heavyRpcFlights.get(key);}
      const promise=enqueue(()=>original(fn,params,options));
      heavyRpcFlights.set(key,promise);
      promise.finally(()=>{if(heavyRpcFlights.get(key)===promise)heavyRpcFlights.delete(key);});
      return promise;
    };
    wrapped.__v608Wrapped=true;wrapped.__v608Original=original;
    try{client.rpc=wrapped;return true;}catch(_){return false;}
  }

  let ownerRenderTimer=0;
  window.v608ScheduleOwnerCardsRender=function(){
    if(ownerRenderTimer)return;
    ownerRenderTimer=setTimeout(()=>{
      ownerRenderTimer=0;
      try{if(typeof renderOwnerCards==='function')renderOwnerCards();}catch(_){ }
    },100);
  };

  function visibleAlerts(){return !!(el('alertsModal')?.classList.contains('show')||el('v549AlertDrawer')?.classList.contains('show'));}
  function visibleTab(id){const n=el(id);return !!n&&!n.classList.contains('hidden');}

  const configs={
    loadV170Tasks:{ttl:30000,secondary:true,key:args=>'v170:'+JSON.stringify(args),visible:()=>visibleAlerts(),manual:args=>args[0]===false&&args[1]===true},
    loadCrossAreaWaits:{ttl:30000,secondary:true,visible:()=>visibleAlerts()},
    loadInternalReassignRequests:{ttl:30000,secondary:true,visible:()=>visibleAlerts()||visibleTab('tab-reassignTracking')},
    loadArchiveDeliveryRequests:{ttl:30000,secondary:true,visible:()=>visibleAlerts()||visibleTab('tab-states')},
    loadOperationalAlerts:{ttl:60000,secondary:true,visible:()=>visibleAlerts()},
    loadLocationAlerts:{ttl:90000,secondary:true,visible:()=>visibleAlerts()},
    refreshLocationUnread:{ttl:115000,secondary:true,visible:()=>visibleAlerts()},
    loadV170TaskCounters:{ttl:55000,secondary:true,visible:()=>visibleAlerts()},
    loadV362RequestAlerts:{ttl:30000,secondary:true,visible:()=>visibleAlerts()},
    loadV546PersonalNotices:{ttl:45000,secondary:true,visible:()=>visibleAlerts()},
    refreshPersistentReassignmentNotificationsV483:{ttl:45000,secondary:true,visible:()=>visibleAlerts()}
  };

  function wrap(name,cfg){
    const original=window[name];
    if(typeof original!=='function'||original.__v608Wrapped)return false;
    const cache=new Map();
    const wrapper=async function(...args){
      updateMode();
      const manual=!!cfg.manual?.(args);
      const key=(cfg.key?cfg.key(args):name+':'+JSON.stringify(args))||name;
      let entry=cache.get(key);
      if(!entry){entry={lastAt:0,lastValue:undefined,inFlight:null};cache.set(key,entry);}
      if(entry.inFlight){state.coalesced+=1;renderSavings();return entry.inFlight;}
      const visible=cfg.visible?!!cfg.visible():false;
      if(!manual&&cfg.secondary&&state.mode==='AHORRO_INTENSIVO'&&!visible){state.paused+=1;renderSavings();return entry.lastValue;}
      const ttl=modeTtl(Number(cfg.ttl||15000));
      if(!manual&&entry.lastAt&&now()-entry.lastAt<ttl){state.avoided+=1;renderSavings();return entry.lastValue;}
      const run=()=>Promise.resolve(original.apply(this,args));
      const promise=(manual||visible||cfg.secondary===false)?run():enqueue(run);
      entry.inFlight=promise;
      try{
        const result=await promise;
        entry.lastAt=now();entry.lastValue=result;
        return result;
      }catch(error){state.failures+=1;throw error;}
      finally{entry.inFlight=null;renderSavings();}
    };
    wrapper.__v608Wrapped=true;wrapper.__v608Original=original;
    try{window[name]=wrapper;state.wrappers[name]=true;return true;}catch(_){return false;}
  }

  function wrapKnownLoaders(){Object.entries(configs).forEach(([name,cfg])=>wrap(name,cfg));}

  function patchSearchDebounce(){
    const original=window.debounceAll;
    if(typeof original!=='function'||original.__v608Wrapped)return;
    let timer=null;
    const wrapper=function(){
      updateMode();
      clearTimeout(timer);
      const raw=String(el('allSearch')?.value||'').trim().replace(/\s+/g,'');
      const exact=/^\d+-\d{4}$/.test(raw);
      if(exact)return original.apply(this,arguments);
      const delay=state.mode==='NORMAL'?280:state.mode==='AHORRO_SUAVE'?380:state.mode==='AHORRO_LOCAL'?500:650;
      const args=arguments,ctx=this;
      timer=setTimeout(()=>original.apply(ctx,args),delay);
    };
    wrapper.__v608Wrapped=true;wrapper.__v608Original=original;
    window.debounceAll=wrapper;
  }

  function patchPassiveRefresh(){
    const original=window.refreshPassiveSafely;
    if(typeof original!=='function'||original.__v608Wrapped)return;
    const wrapper=async function(){
      updateMode();
      const min=state.mode==='NORMAL'?55000:state.mode==='AHORRO_SUAVE'?75000:state.mode==='AHORRO_LOCAL'?120000:180000;
      if(state.lastPassiveAt&&now()-state.lastPassiveAt<min){state.avoided+=1;renderSavings();return false;}
      state.lastPassiveAt=now();
      return original.apply(this,arguments);
    };
    wrapper.__v608Wrapped=true;wrapper.__v608Original=original;
    window.refreshPassiveSafely=wrapper;
  }

  function install(){
    wrapKnownLoaders();
    patchSearchDebounce();
    patchPassiveRefresh();
    patchSupabaseRpc();
    updateMode();renderSavings();
    // Reintentar una vez por si alguna capa legacy reemplazó funciones durante el arranque.
    setTimeout(()=>{wrapKnownLoaders();patchSearchDebounce();patchPassiveRefresh();patchSupabaseRpc();updateMode();renderSavings();},2500);
    setInterval(()=>{updateMode();renderSavings();patchSupabaseRpc();pump();},5000);
    window.addEventListener('online',()=>{state.lastPassiveAt=0;updateMode();renderSavings();},{passive:true});
    document.addEventListener('visibilitychange',()=>{if(!document.hidden){updateMode();renderSavings();}}, {passive:true});
  }

  window.v608AdaptiveLoad={
    state,
    updateMode,
    invalidateAll(){Object.values(state.wrappers);state.lastPassiveAt=0;},
    info(){return {version:'V608',mode:state.mode,avoided:state.avoided,coalesced:state.coalesced,paused:state.paused,queued:state.queued,running:state.running,completed:state.completed,failures:state.failures,wrapped:Object.keys(state.wrappers)};}
  };

  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install,{once:true});else install();
  try{console.info('V608 · ahorro adaptativo anti-saturación preparado');}catch(_){ }
})();
</script>

