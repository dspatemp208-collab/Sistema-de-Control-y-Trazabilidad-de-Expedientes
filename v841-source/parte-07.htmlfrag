.v626-reit-summary{display:grid;grid-template-columns:1fr 1fr;gap:7px 12px;padding:12px;border:1px solid var(--line);border-radius:9px;background:#f8fafc;font-size:11px;line-height:1.4}
@media(max-width:650px){.v626-reit-summary{grid-template-columns:1fr}}
</style>

<div class="modal" id="v626ReiterationModal" onclick="closeModalFromBackdrop(event,this)" role="dialog" aria-modal="true" aria-labelledby="v626ReitTitle">
