#v827ReviewStatus{margin-top:6px;line-height:1.5}
@media (max-width:670px){#v827AdminReview .v827-review-header button{width:100%}}
</style>
<script id="v827-admin-check-script">
(function(){
 'use strict';
 const $=id=>document.getElementById(id);
 const roleAdmin=()=>typeof currentProfile!=='undefined'&&
   String(currentProfile?.rol||'').trim().toUpperCase()==='ADMINISTRADOR';
 const escapeHtml=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const values=()=>{
   let items=[];
   try{items=JSON.parse($('newRequestModal')?.dataset.items||'[]');}catch(_){items=[];}
   return {items,solicitante:($('rqSolicitante')?.value||'').trim(),modalidad:($('rqModalidad')?.value||'PRÉSTAMO').trim()};
 };
 let checkSeq=0,timer=null;
 async function fetchReview(items,solicitante,modalidad){
   if(!Array.isArray(items))throw Error('No se identificaron los expedientes.');
   const ids=[...new Set(items.filter(x=>x?.id).map(x=>String(x.id)))];
   if(!ids.length)return [];
   const result=[];
   for(let i=0;i<ids.length;i+=50){
     const {data,error}=await sb.rpc('v827_revisar_solicitud_admin',{
       p_expediente_ids:ids.slice(i,i+50),
       p_destinatario_nombre:solicitante,
       p_modalidad:modalidad
     });
     if(error)throw Error(error.message||'No se pudo verificar la custodia.');
     if(!data?.ok||!Array.isArray(data.casos))throw Error('No se recibió una revisión válida de Supabase.');
     result.push(...data.casos);
   }
   return result;
 }
 window.v827CheckItems=async function(items,solicitante,modalidad){
   if(!roleAdmin())return [];
   const checked=await fetchReview(items,solicitante,modalidad);
   const invalid=checked.filter(c=>!['ARCHIVO','REASIGNACION'].includes(c.ruta));
   if(invalid.length){throw Error('Revise la custodia antes de registrar: '+invalid.slice(0,5).map(x=>(x.expediente||x.expediente_id)+': '+x.motivo).join(' | ')+(invalid.length>5?' (y '+(invalid.length-5)+' más)':''));}
   const known=new Set(checked.map(x=>String(x.expediente_id)));
   if(items.some(x=>x.id&&!known.has(String(x.id))))throw Error('Faltan expedientes en la verificación: no se registró ninguna solicitud.');
   return checked;
 };
 const render=results=>{
   const box=$('v827ReviewRows');if(!box)return;
   box.innerHTML=results.length?'<table><thead><tr><th>Expediente</th><th>Estado físico</th><th>Responsable actual / área</th><th>Trámite permitido</th><th>Control</th></tr></thead><tbody>'+results.map(r=>{
     const label=r.ruta==='REASIGNACION'?'Requiere reasignación':r.ruta==='ARCHIVO'?'Solicitar al Archivo':'Requiere revisión';
     const cls=r.ruta==='REASIGNACION'?'v827-reassign':r.ruta==='ARCHIVO'?'v827-archivo':'v827-block';
     return '<tr><td><b>'+escapeHtml(r.expediente||'—')+'</b><small style="display:block">'+escapeHtml(r.extension||'—')+'</small></td>'+ 
     '<td>'+escapeHtml(r.estado_fisico||'—')+'</td><td><strong>'+escapeHtml(r.responsable_actual||'Por verificar')+'</strong><small style="display:block">Área: '+escapeHtml(r.area_trabajo||'Por verificar')+'</small></td>'+ 
     '<td><span class="v827-path '+cls+'">'+label+'</span></td><td>'+escapeHtml(r.motivo||'')+'</td></tr>';
   }).join('')+'</tbody></table>':'';
 };
 window.v827ReviewRequest=async function(explicit){
   if(!roleAdmin()||!$('newRequestModal')?.classList.contains('show'))return;
   const run=++checkSeq;
   const {items,solicitante,modalidad}=values();
   const panel=$('v827AdminReview');if(panel)panel.classList.remove('hidden');
   const output=$('v827ReviewStatus');
   if(!items.length){render([]);if(output)output.textContent='Agregue expedientes desde «Buscar en la base», «Agregar manualmente» o «Cargar Excel».';return;}
   if(!solicitante){render([]);if(output)output.textContent='Seleccione el responsable de destino para verificar si corresponde una solicitud al Archivo o una reasignación.';return;}
   if(output)output.textContent='Consultando custodia y solicitudes pendientes en Supabase...';
   try{
      const result=await fetchReview(items,solicitante,modalidad);
      if(run!==checkSeq)return;
      render(result);
      const invalid=result.filter(x=>x.ruta==='BLOQUEADO').length;
      const archive=result.filter(x=>x.ruta==='ARCHIVO').length;
      const reassign=result.filter(x=>x.ruta==='REASIGNACION').length;
      if(output)output.textContent=archive+' para solicitar al Archivo · '+reassign+' para solicitar reasignación · '+invalid+' requieren revisión. Los expedientes nuevos se validan por la ruta ordinaria. El correo no cambia la custodia.';
   }catch(err){if(run!==checkSeq)return;render([]);if(output)output.textContent='No se pudo verificar: '+(err?.message||err)+'. No envíe sin corregir esta incidencia.';}
 };
 function schedule(){clearTimeout(timer);timer=setTimeout(()=>window.v827ReviewRequest(false),180);}
 function attach(){
   const form=$('newRequestModal');if(!form)return;
   const panel=$('v827AdminReview');
   const obs=new MutationObserver(()=>{
     if(roleAdmin()&&form.classList.contains('show'))schedule();
   });
   const selected=$('rqSelectedTable');if(selected)obs.observe(selected,{childList:true,subtree:false});
   ['rqSolicitante','rqModalidad'].forEach(id=>$(id)?.addEventListener('change',schedule));
   // La visibilidad solo se activa cuando existe un perfil Administrador autenticado.
   const visibilityObs=new MutationObserver(()=>{
      if(form.classList.contains('show')&&roleAdmin()){panel?.classList.remove('hidden');schedule();}
      else{panel?.classList.add('hidden');checkSeq++;}
   });
   visibilityObs.observe(form,{attributes:true,attributeFilter:['class']});
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',attach,{once:true});else attach();
})();
</script>

<style id="v829-styles">
#locationNoticeModal .v829-email-help{background:#eff6fe;border:1px solid #cadff3;border-radius:8px;padding:10px 12px;color:#244c73;font-size:12px;line-height:1.5;margin:9px 0}
