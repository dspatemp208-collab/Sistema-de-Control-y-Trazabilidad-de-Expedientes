    profile_id:String(currentProfile?.id||''),
    profile_name:String(currentProfile?.nombre_personal||''),
    selected_count:(typeof selectedIds!=='undefined'&&selectedIds)?selectedIds.size:0,
    profile_context_user_id:String(__profileContextUserIdV687||'')
  });
})();
