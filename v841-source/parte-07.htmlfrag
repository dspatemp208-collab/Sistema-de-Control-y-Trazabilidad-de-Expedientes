  flex:1 1 auto;min-width:0;
  text-align:left;line-height:1.25;
}
#v804Overlay .v808-mail-panel #v804Recipients .v807-person-name {font-size:12px;line-height:1.3;font-weight:700;color:#173d6a}
#v804Overlay .v808-mail-panel #v804Recipients .v807-person-mail {font-size:11px;line-height:1.3;color:#4b6888;overflow-wrap:anywhere}
