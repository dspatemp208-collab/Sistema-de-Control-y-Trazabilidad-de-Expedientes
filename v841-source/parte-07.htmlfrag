</script>
<script id="v756-data-asignaciones-controller">
(function(){
 'use strict';
 const $=id=>document.getElementById(id);
 let rows=[], results=[], chosen=null, batch=[], targetOptions=[], lastUser='', loading=false, loadedDataControls=false;
 let v760Adding=false;
 const html=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const fmt=v=>{try{return new Date(v).toLocaleString('es-PE',{timeZone:'America/Lima',day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'})}catch(_){return String(v||'')}};
 const status=t=>{if($('v756DataStatus'))$('v756DataStatus').textContent=t||'';};
 function v764LocalStatus(id,msg,good=false){
  const el=$(id);if(!el)return;
  el.textContent=msg||'';el.style.color=good?'#176140':'#a12a27';
  el.style.padding=msg?'9px 11px':'';el.style.background=msg?(good?'#eef8f1':'#fff2f0'):'';
  el.style.border=msg?'1px solid '+(good?'#abdcb9':'#e6b6b0'):'';
  el.style.borderRadius='8px';
 }

 const current=()=>((typeof session!=='undefined'&&session?.user?.id)||null);
 const api=()=>typeof sb!=='undefined'?sb:null;
 const active=()=>document.querySelector('[data-tab="dataAssignments"]')?.classList.contains('active')||false;
 const err=e=>{status(e?.message||String(e));try{console.warn('V756 · asignaciones Data:',e)}catch(_){}};
 const isData=()=>{try{return (catalogo||[]).some(x=>x.activo!==false&&x.tipo==='PERSONAL'&&String(x.area_trabajo||'').trim().toUpperCase()==='DATA'&&norm(x.nombre)===norm(currentProfile?.nombre_personal||''));}catch(_){return false}};
 const badge=n=>{if($('v756Badge')){$('v756Badge').textContent=String(n);$('v756Badge').classList.toggle('zero',!n)}};
 const empty=t=>'<div class="empty" style="padding:16px">'+html(t)+'</div>';
 const lblState=s=>({'PENDIENTE':'Pendiente de solicitar','SOLICITADA':'Solicitud registrada','SOLICITUD_INTERNA':'Reasignación solicitada','REASIGNACION_ACEPTADA':'Reasignación aceptada','CANCELADA':'Cancelada','REEMPLAZADA':'Sustituida','RECHAZADA':'Solicitud interna rechazada'})[s]||s;
 async function configure(){
   const client=api();if(!client||!current())return false;
   const {data,error}=await client.rpc('v756_es_personal_data');if(error)throw error;
   const dataRole=data===true;
   if($('v756AssignForm'))$('v756AssignForm').style.display=dataRole?'block':'none';
   if(!dataRole){loadedDataControls=true;return false;}
   const [users,subjects]=await Promise.all([
     client.rpc('v756_data_destinatarios'),
     typeof loadAsuntosCatalogo==='function'?loadAsuntosCatalogo().catch(()=>null):Promise.resolve(null)
   ]);
   if(users.error)throw users.error;
   targetOptions=Array.isArray(users.data)?users.data:[];
   const target=$('v756Target');if(target){const keep=target.value;target.innerHTML='<option value="">— SELECCIONE DESTINATARIO —</option>'+targetOptions.map(x=>'<option value="'+html(x.usuario_id)+'">'+html(x.nombre)+' · '+html(x.area||'SIN ÁREA')+'</option>').join('');if(keep&&targetOptions.some(x=>x.usuario_id===keep))target.value=keep;}
   const subj=$('v756Subject');if(subj){const keep=subj.value;const catalog=typeof asuntosCatalogo!=='undefined'&&Array.isArray(asuntosCatalogo)?asuntosCatalogo:[];subj.innerHTML='<option value="">— SELECCIONE ASUNTO —</option>'+catalog.filter(x=>x&&x.activo!==false).map(x=>'<option value="'+html(x.nombre)+'">'+html(x.nombre)+'</option>').join('');if(keep&&[...subj.options].some(x=>x.value===keep))subj.value=keep;}
   loadedDataControls=true;
   return true;
 }
 async function load(){
  if(!current()||!api()){status('Debe iniciar sesión para consultar las asignaciones.');return;}
  if(loading)return;loading=true;status('Actualizando asignaciones...');
  try{
    if(lastUser!==current()){lastUser=current();chosen=null;loadedDataControls=false;}
    const client=api();
    const {data,error}=await window.v841DataList();if(error)throw error;
    rows=Array.isArray(data)?data:[];
    // V841: lecturas compartidas de forma segura por sesion para todos los paneles de Data.
    render();status('La asignación de Data no cambia la custodia ni genera un cargo.');
    if(!loadedDataControls)await configure();
  }catch(e){err(e);if($('v756MineTable'))$('v756MineTable').innerHTML=empty('No fue posible obtener las asignaciones.');}
  finally{loading=false;}
 }
 const v761Details=a=>{const parts=[];
   if(a.numero_registro)parts.push('Registro: '+a.numero_registro);
   if(a.fecha_registro)parts.push('Fecha reg.: '+v761DateLabel(a.fecha_registro));
   if(a.rd_primigenia)parts.push('RD: '+a.rd_primigenia);
   if(a.administrado)parts.push('Administrado: '+a.administrado);
   if(a.tipo_tramite)parts.push('Solicitud: '+a.tipo_tramite);
   if(a.fecha_vencimiento)parts.push('Vence: '+v761DateLabel(a.fecha_vencimiento));
   return parts.map(s=>'<div class="note" style="font-size:11px">'+html(s)+'</div>').join('');
 };
 function v761DateLabel(v){const s=String(v||'').slice(0,10);const m=s.match(/^(\d{4})-(\d\d)-(\d\d)$/);return m?m[3]+'/'+m[2]+'/'+m[1]:s;}
 function v761ExpiryLabel(v){if(!v)return '';const s=String(v).slice(0,10);const today=new Date().toLocaleDateString('en-CA',{timeZone:'America/Lima'});const d=Math.round((Date.parse(s+'T12:00:00Z')-Date.parse(today+'T12:00:00Z'))/86400000);
  const word=d<0?'VENCIDO':d===0?'VENCE HOY':d<=7?'PRÓXIMO A VENCER':'';
  return word?'<div style="font-size:11px;font-weight:700;color:'+(d<0?'#9f1a1a':'#9b5b00')+'">'+word+'</div>':'';
 }
 const v765OriginalHeaders=['ABOGADO','NRO_REG','FEC_REG','NRO_EXP','EXTENSION','RD_PRIMIGENIA','ADMINISTRADO','SOLICITUD','FECHA_VENCIMIENTO'];
 const v765Date=v=>v?html(v761DateLabel(v)):'—';
 const v765Cell=v=>{const text=String(v??'').trim();return text?html(text):'—';};
 const v765Columns=(history=false)=>v765OriginalHeaders.concat(history?['ASIGNADO POR','ASUNTO ATENCIÓN','ESTADO','SOLICITUD ARCHIVO','FECHA ASIGNACIÓN','ACCIONES']:['ASIGNADO POR','ASUNTO ATENCIÓN','CUSTODIA FÍSICA','ACCIÓN']);
 const v765Heading=history?'Seguimiento': 'Pendientes de solicitar';
 function v765Table(data,history=false){
   const headings=v765Columns(history);
   const head='<thead><tr>'+headings.map(x=>'<th scope="col">'+html(x)+'</th>').join('')+'</tr></thead>';
   const body=data.map(a=>{
     const cells=[
       v765Cell(a.destinatario),v765Cell(a.numero_registro),v765Date(a.fecha_registro),
       '<strong>'+v765Cell(a.expediente)+'</strong>'+(a.pendiente_registro?'<div class="v765-inline-info">Pendiente de registro</div>':''),
       v765Cell(a.extension),v765Cell(a.rd_primigenia),v765Cell(a.administrado),
       v765Cell(a.tipo_tramite),
       v765Date(a.fecha_vencimiento)+(a.estado==='PENDIENTE'?v761ExpiryLabel(a.fecha_vencimiento):'')
     ];
     if(history){
       cells.push(v765Cell(a.asignado_por),v765Cell(a.asunto),v765Cell(lblState(a.estado)),
         a.solicitud_id?'<div class="v765-cell-main">'+v765Cell(a.numero_solicitud||'Registrada')+'</div><div class="v765-inline-info">Solicitó: '+v765Cell(a.solicitado_por||a.destinatario)+'</div>':(a.solicitud_interna_id?'<span class="v765-inline-info">Reasignación interna por '+v765Cell(a.solicitado_por||a.destinatario)+'</span>':'—'),
         a.created_at?html(fmt(a.created_at)):'—',
         a.estado==='PENDIENTE'&&a.asignador_id===current()?'<button class="btn secondary small" type="button" onclick="v756CancelAssignment(\''+html(a.id)+'\')">Cancelar</button>':'—');
     }else{
       cells.push(v765Cell(a.asignado_por),v765Cell(a.asunto),v765Cell(a.custodio||'Pendiente de registro'),
         '<button type="button" class="btn small" onclick="'+(a.fuente==='V761_TRAMITE'?'v768OpenGroup':'v756RequestAssigned')+'(\''+html(a.id)+'\')">Solicitar al Archivo</button>');
     }
     return '<tr>'+cells.map((v,i)=>'<td data-col="'+html(headings[i])+'">'+v+'</td>').join('')+'</tr>';
   }).join('');
   return '<div class="v765-table-scroll" role="region" tabindex="0" aria-label="'+(history?'Seguimiento de asignaciones Data':'Encargos recibidos de Data')+'">'
       +'<table class="v765-data-table">'+head+'<tbody>'+body+'</tbody></table></div>';
 }
 function render(){
   const uid=current();const pending=rows.filter(x=>x.destinatario_id===uid&&x.estado==='PENDIENTE');
   if($('v756MineCount'))$('v756MineCount').textContent=String(pending.length);
   badge(pending.length);
   const mine=$('v756MineTable');if(mine)mine.innerHTML=pending.length?(window.v768BlocksSummary?window.v768BlocksSummary(pending):'')+v765Table(pending,false):empty('No tiene encargos pendientes de solicitar.');
   if($('v756HistoryCount'))$('v756HistoryCount').textContent=String(rows.length);
   const hist=$('v756HistoryTable');if(hist)hist.innerHTML=rows.length?v765Table(rows,true):empty('Todavía no existen asignaciones relacionadas con su perfil.');
 }

 async function find(){
  const q=$('v756SearchExp')?.value?.trim()||'';
  if(q.length<3){status('Escriba al menos 3 caracteres para buscar.');return;}
  chosen=null;const container=$('v756SearchResults');if(container)container.innerHTML=empty('Buscando en Registro Maestro...');
  try{
    const {data,error}=await api().rpc('v756_data_buscar',{p_busqueda:q});if(error)throw error;
    results=Array.isArray(data)?data:[];
    if(container)container.innerHTML=results.length
      ?'<table><thead><tr><th>Expediente</th><th>Extensión</th><th>Estado físico</th><th>Responsable</th><th>Elegir</th></tr></thead><tbody>'+results.map((x,i)=>'<tr><td>'+html(x.expediente)+'</td><td>'+html(x.extension||'')+'</td><td>'+html(x.estado||'')+'</td><td>'+html(x.responsable||'')+'</td><td><button type="button" class="btn secondary small" onclick="v756ChooseExp('+i+')">Seleccionar</button></td></tr>').join('')+'</tbody></table>'
      :'<div class="empty" style="padding:12px"><b>No figura en el Registro Maestro.</b><p>Puede encargar al abogado la atención sin generar solicitud, préstamo ni cargo. El abogado deberá registrar la solicitud posteriormente.</p><button class="btn secondary" type="button" onclick="v758ChooseUnregistered()">Asignar como pendiente de registro</button></div>';
    status(results.length?('Se encontraron '+results.length+' coincidencias. Seleccione la extensión correcta.'):'No registrado: utilice «Asignar como pendiente de registro».');
  }catch(e){err(e);if(container)container.innerHTML=empty('No se pudo consultar el buscador de Data.');}
}
function choose(i){chosen=results[i]||null; if($('v756SelectedLabel'))$('v756SelectedLabel').textContent=chosen?'Registrado: '+chosen.expediente+' · '+(chosen.extension||'sin extensión'):'Ningún expediente seleccionado.';}
function chooseUnregistered(){
 const numero=String($('v756SearchExp')?.value||'').trim().toUpperCase().replace(/\s+/g,'');
 if(!/^\d+-[12]\d{3}$/.test(numero)){status('El número debe tener el formato NÚMERO-AÑO.');return;}
 const extension=String($('v758PendingExtension')?.value||'').trim().toUpperCase();
 chosen={id:null,expediente:numero,extension:extension||null,pendiente_registro:true};
 if($('v756SelectedLabel'))$('v756SelectedLabel').textContent='Pendiente de registro: '+numero+(extension?' · '+extension:'')+' · No genera custodia';
 status('Encargo de atención preparado. Solo el abogado destinatario podrá registrar su solicitud.');
}
function batchKey(x){
 const normNum=v760NumberKey(x.expediente)||String(x.expediente||'').trim().toUpperCase();
 return 'NUM:'+normNum+'|'+String(x.extension||'').trim().toUpperCase()+'|'+
   (String(x.numero_registro||'').trim()?'REG:'+String(x.numero_registro).trim().toUpperCase():'TRAM:'+String(x.tipo_tramite||'').trim().toUpperCase());
}
const v761PerItemFields=['v761Reg','v761FechaReg','v761RD','v761Admin','v761Tramite','v761Vence'];
function v761ReadDetails(){return {
 numero_registro:String($('v761Reg')?.value||'').trim().toUpperCase(),
 fecha_registro:$('v761FechaReg')?.value||'',rd_primigenia:String($('v761RD')?.value||'').trim(),
 administrado:String($('v761Admin')?.value||'').trim(),tipo_tramite:String($('v761Tramite')?.value||'').trim().toUpperCase(),
 fecha_vencimiento:$('v761Vence')?.value||''
};}
function v761ClearDetails(){v761PerItemFields.forEach(id=>{if($(id))$(id).value='';});}
function renderBatch(){
 const place=$('v759BatchList'),count=$('v759BatchCount');
 if(count)count.textContent='('+batch.length+')';if(!place)return;
 place.innerHTML=batch.length?'<div style="max-height:320px;overflow:auto"><table style="width:100%"><thead><tr><th>N.º</th><th>Expediente / extensión</th><th>Registro y administrado</th><th>Trámite / vencimiento</th><th>Acciones</th></tr></thead><tbody>'+
 batch.map((x,i)=>'<tr><td>'+(i+1)+'</td><td><strong>'+html(x.expediente)+'</strong><div class="note">'+html(x.extension||'Por verificar')+' · '+html(x.pendiente_registro?'Pendiente de registro':'Registrado')+'</div></td><td>'+html(x.numero_registro||'—')+'<div class="note">'+html(x.administrado||'')+'</div><div class="note">'+html(x.rd_primigenia||'')+'</div></td><td>'+html(x.tipo_tramite||'Por definir')+'<div class="note">Vence: '+html(v761DateLabel(x.fecha_vencimiento)||'Sin fecha')+'</div>'+v761ExpiryLabel(x.fecha_vencimiento)+'</td><td><button type="button" class="btn secondary small" onclick="v761EditBatch('+i+')">Editar</button> <button type="button" class="btn secondary small" onclick="v759RemoveFromBatch('+i+')">Quitar</button></td></tr>').join('')+'</tbody></table></div>'
 :'<div class="note">Escriba el expediente, complete sus datos y pulse «+ Agregar a la lista».</div>';
}
function v761EditBatch(i){if(!Number.isInteger(i)||i<0||i>=batch.length)return;const x=batch.splice(i,1)[0];
 const mapping={v761Reg:'numero_registro',v761FechaReg:'fecha_registro',v761RD:'rd_primigenia',v761Admin:'administrado',v761Tramite:'tipo_tramite',v761Vence:'fecha_vencimiento'};
 Object.entries(mapping).forEach(([id,key])=>{if($(id))$(id).value=x[key]||'';});
 if($('v756SearchExp'))$('v756SearchExp').value=x.expediente;
 if($('v758PendingExtension'))$('v758PendingExtension').value=x.extension||'';
 chosen=x.id?{id:x.id,expediente:x.expediente,extension:x.extension,pendiente_registro:false}:null;
 renderBatch();v760Feedback('Editando '+x.expediente+'. Pulse «+ Agregar a la lista» para confirmar los cambios.',true);
}
function v760NumberKey(n){
 const m=String(n||'').trim().toUpperCase().replace(/\s+/g,'').match(/^(\d+)-(\d{4})$/);
 if(!m)return '';
 return String(parseInt(m[1],10))+'-'+m[2];
}
function v760Feedback(message,good){
 const el=$('v760BatchFeedback');
 if(el){el.textContent=message;el.style.color=good?'#14633c':'#9a3a27';}
 status(message);
}
async function addToBatch(){
 if(v760Adding)return false;
 if(batch.length>=100){v760Feedback('La lista ya tiene 100 expedientes; guárdela antes de añadir más.',false);return false;}
 const input=$('v756SearchExp');
 const typed=String(input?.value||'').trim().toUpperCase().replace(/\s+/g,'');
 const extTyped=String($('v758PendingExtension')?.value||'').trim().toUpperCase();
 // A previously chosen row is valid only for the number currently in the input.
 if(chosen&&typed&&v760NumberKey(chosen.expediente)!==v760NumberKey(typed))chosen=null;
 if(!chosen){
  if(!/^\d+-[12]\d{3}$/.test(typed)){
   v760Feedback('Ingrese un número de expediente válido, por ejemplo 895-2015, antes de pulsar «Agregar».',false);
   if(input)input.focus();return false;
  }
  v760Adding=true;
  const btn=$('v759AddToBatchBtn');if(btn)btn.disabled=true;
  v760Feedback('Verificando '+typed+' en el Registro Maestro…',true);
  try{
   const client=api();if(!client)throw new Error('No hay conexión con Supabase.');
   const {data,error}=await client.rpc('v756_data_buscar',{p_busqueda:typed});
   if(error)throw error;
   const matches=(Array.isArray(data)?data:[]).filter(x=>v760NumberKey(x.expediente)===v760NumberKey(typed));
   // Si existen varias extensiones, evitar escoger una automáticamente.
   const exactExt=extTyped?matches.filter(x=>String(x.extension||'').trim().toUpperCase()===extTyped):matches;
   if(matches.length>0&&extTyped&&exactExt.length===0){
    results=matches;
    const list=$('v756SearchResults');
    if(list)list.innerHTML='<div class="note">El expediente está registrado con otra extensión. Pulse «Buscar», verifique y seleccione el registro correcto.</div>';
    v760Feedback('El expediente '+typed+' está registrado, pero no coincide con la extensión '+extTyped+'. Corrija la extensión y vuelva a agregar.',false);
    return false;
   }
   if(exactExt.length>1){
    results=exactExt;
    const list=$('v756SearchResults');
    if(list)list.innerHTML='<div class="note">Se encontraron varias extensiones para '+html(typed)+'. Pulse «Buscar» y seleccione una de las coincidencias.</div>';
    v760Feedback('Se encontraron varias coincidencias. Seleccione la extensión correcta usando «Buscar» antes de agregar.',false);
    return false;
   }
   if(exactExt.length===1){
    chosen={...exactExt[0],pendiente_registro:false};
   }else{
    chosen={id:null,expediente:typed,extension:extTyped||null,pendiente_registro:true};
   }
  }catch(e){
   v760Feedback('No se pudo verificar el expediente: '+(e?.message||String(e))+'. Intente nuevamente; no se agregó nada.',false);
   chosen=null;return false;
  }finally{
   v760Adding=false;
   if(btn)btn.disabled=false;
  }
 }
 const obj={id:chosen.id||null,expediente:String(chosen.expediente||'').trim(),extension:chosen.id?(chosen.extension||null):(extTyped||chosen.extension||null),pendiente_registro:!chosen.id};
 Object.assign(obj,v761ReadDetails());
 // Impedir repetir el mismo número+extensión aun cuando el primero provenga de otra vía.
 const objNumber=v760NumberKey(obj.expediente);
 if(batch.some(x=>batchKey(x)===batchKey(obj))){
  v760Feedback('El expediente '+obj.expediente+' ya está en la lista. No se agregó nuevamente.',false);
  return false;
 }
 batch.push(obj);chosen=null;results=[];
 if(input)input.value='';
 const extBox=$('v758PendingExtension');if(extBox)extBox.value='';
 v761ClearDetails();
 const resultsBox=$('v756SearchResults');if(resultsBox)resultsBox.innerHTML='';
 const sel=$('v756SelectedLabel');if(sel)sel.textContent='Escriba el siguiente número o guarde la asignación.';
 renderBatch();
 v760Feedback('Agregado: '+obj.expediente+(obj.extension?' · '+obj.extension:'')+' ('+(obj.pendiente_registro?'pendiente de registro':'registrado')+'). Total en la lista: '+batch.length+'.',true);
 if(input)input.focus();
 return true;
}
function removeFromBatch(i){
 if(!Number.isInteger(i)||i<0||i>=batch.length)return;
 const x=batch.splice(i,1)[0];renderBatch();status('Se quitó '+x.expediente+' de la lista. Aún no se han registrado asignaciones.');
}
async function save(){
 const btn=$('v756SubmitBtn'),add=$('v759AddToBatchBtn');
 if(btn?.disabled)return;
 v764LocalStatus('v764SaveStatus','');
 const target=$('v756Target'),subj=$('v756Subject');
 if(!target?.value){const msg='Debe seleccionar al abogado destinatario antes de guardar.';v764LocalStatus('v764SaveStatus',msg);v760Feedback(msg,false);target?.focus();return;}
 if(!subj?.value){const msg='Debe seleccionar «Asunto de la futura atención». No se envió ningún expediente.';v764LocalStatus('v764SaveStatus',msg);v760Feedback(msg,false);subj?.focus();return;}
 // Si el número quedó en el buscador, agregarlo antes de enviar el lote.
 if((chosen||String($('v756SearchExp')?.value||'').trim())&&!(await addToBatch())){
   const msg='No se pudo agregar el expediente del buscador. Corrija el número o extensión antes de guardar.';
   v764LocalStatus('v764SaveStatus',msg);return;
 }
 if(batch.length===0){const msg='La lista está vacía. Agregue o importe expedientes antes de guardar.';v764LocalStatus('v764SaveStatus',msg);v760Feedback(msg,false);return;}
 const asunto=subj.value,observacion=$('v756Note')?.value||'';
 // V773: Toda asignación nueva necesita comunicación institucional. Validar correos ANTES de guardar.
 let v770EmailsForSave=null;
 try{v770EmailsForSave=await window.v770RecipientsForSave(target.value);}
 catch(e){const msg='Debe comprobar los destinatarios del correo antes de guardar: '+(e?.message||String(e))+'. No se registró ningún expediente.';v764LocalStatus('v764SaveStatus',msg);return;}
 if(btn)btn.disabled=true;if(add)add.disabled=true;
 v764LocalStatus('v764SaveStatus','Registrando '+batch.length+' trámite(s), espere...',true);
 const staged=batch.map(x=>({id:x.id||null,numero:x.expediente,extension:x.extension||null,numero_registro:x.numero_registro||null,fecha_registro:x.fecha_registro||null,rd_primigenia:x.rd_primigenia||null,administrado:x.administrado||null,tipo_tramite:x.tipo_tramite||null,fecha_vencimiento:x.fecha_vencimiento||null}));
 try{
  const client=api();if(!client)throw new Error('No hay conexión activa a Supabase.');
  // V773: una transacción SQL guarda el bloque y crea el aviso; si uno falla, se revierte todo.
  const {data,error}=await client.rpc('v773_data_guardar_y_notificar',{
   p_destinatario_id:target.value,p_asunto:asunto,p_observacion:observacion,
   p_items:staged,p_correos:v770EmailsForSave
  });if(error)throw error;
  if(!data?.ok)throw new Error('Supabase no confirmó el registro y comunicación. Consulte el historial antes de reintentar.');
  window.v841InvalidateDataReads?.(); // V841: una escritura confirmada invalida la lectura compartida.
  const n=Number(data?.total)||staged.length,creados=Number(data?.creados)||0,repetidos=Number(data?.ya_existian)||0;
  const mailData=data?.correo||{};
  let v769MailResult='';
  let v769MailFailed=false;
  if(creados>0){
    if(!mailData?.encolado && !mailData?.ya_existia)throw new Error('El bloque no tiene un aviso confirmado. Se canceló el guardado.');
    if(mailData?.encolado){
      // La cola no equivale a correo enviado; activar el procesador habitual.
      try{window.v558ProgramarEnvioExterno?.();}catch(e){console.warn('V773: procesador pendiente',e);}
      setTimeout(()=>{try{window.v769RefreshMailPanel?.();}catch(_){}},11000);
    }
    const direcciones=Array.isArray(mailData.destinatarios)?mailData.destinatarios:[];
    v769MailResult=mailData?.ya_existia?'El correo ya estaba registrado y no se duplicó.':
       'Comunicación registrada para '+direcciones.join(', ')+'. Estado: EN COLA. El sistema solicitará el envío automáticamente.';
  }else{
    v769MailResult='No se creó una asignación nueva porque todos los trámites ya estaban registrados; no se duplicó el correo.';
  }
  batch=[];chosen=null;results=[];renderBatch();
  if($('v756SearchExp'))$('v756SearchExp').value='';
  if($('v758PendingExtension'))$('v758PendingExtension').value='';
  v761ClearDetails();
  if($('v756SearchResults'))$('v756SearchResults').innerHTML='';
  if($('v756SelectedLabel'))$('v756SelectedLabel').textContent='Puede agregar otro expediente.';
  if($('v756Note'))$('v756Note').value='';
  const msg='Asignación registrada correctamente: '+n+' trámite(s) · '+creados+' nuevo(s) · '+repetidos+' ya existente(s). Puede iniciar otro lote.';
  v764LocalStatus('v764SaveStatus',msg,true);v760Feedback(msg,true);
  if($('v769MailSaveStatus')){const el=$('v769MailSaveStatus');el.textContent=v769MailResult;el.style.color=v769MailFailed?'#a12a27':'#176140';}
  try{await load();}catch(e){console.warn('Guardado confirmado, no se actualizó la bandeja:',e);}
  status('Asignación guardada. No se creó ninguna solicitud ni préstamo. '+v769MailResult);
  if(typeof window.v769RefreshMailPanel==='function')await window.v769RefreshMailPanel();
 }catch(e){const msg='No se guardó ningún trámite de este lote: '+(e?.message||String(e))+'. La lista se ha conservado para corregir y reintentar.';v764LocalStatus('v764SaveStatus',msg);v760Feedback(msg,false);err(e);}
 finally{if(btn)btn.disabled=false;if(add)add.disabled=false;}
}
async function request(id){
  const a=rows.find(x=>x.id===id&&x.destinatario_id===current()&&x.estado==='PENDIENTE');
  if(!a){status('La asignación ya no está pendiente. Actualice la bandeja.');return;}
  try{
    const client=api();
    if(typeof isCoordinator==='function'&&isCoordinator()&&typeof setCoordinatorWorkspaceV206==='function'&&isCoordinatorTeamWorkspaceV206())await setCoordinatorWorkspaceV206('SELF','panel');
    if(typeof openNewRequestModal!=='function')throw new Error('No está disponible el formulario de solicitud.');
    let item;
    if(a.pendiente_registro){
      const {data:ready,error:err1}=await client.rpc(a.fuente==='V761_TRAMITE'?'v761_data_preparar_solicitud':'v758_data_preparar_solicitud',{p_asignacion_id:a.id});if(err1)throw err1;
      if(ready?.existe){
        const {data:record,error:err2}=await client.from('expedientes').select('*').eq('id',ready.id).single();if(err2)throw err2;
        item={...record,_nuevo:false};
      }else{
        let ext=ready?.extension||a.extension||'';
        const allowed=typeof requestValidExtensionsForExpediente==='function'?requestValidExtensionsForExpediente(ready.expediente):null;
        if(!ext&&Array.isArray(allowed)&&allowed.length===1)ext=allowed[0];
        if(!ext&&Array.isArray(allowed)&&allowed.length>1){
          const chosenExt=window.prompt('Indique la extensión del expediente '+ready.expediente+' ('+allowed.join(' / ')+'):',allowed[0]);
          if(chosenExt===null)return;
          ext=chosenExt.trim();
        }
        if(typeof requestExtensionValidationV265==='function'){
          const chk=requestExtensionValidationV265(ready.expediente,ext);
          if(chk.required&&!chk.ok)throw new Error(requestExtensionRuleMessageV265(ready.expediente,ext));
        }
        item={id:null,expediente:ready.expediente,extension:ext||null,rd:null,ultimo_folio:null,estado:'PENDIENTE POR ATENDER',_nuevo:true};
      }
    }else{
      const {data,error}=await client.from('expedientes').select('*').eq('id',a.expediente_id).single();if(error)throw error;
      item={...data,_nuevo:false};
    }
    window.__newRequestHeaderDraft={solicitante:currentProfile?.nombre_personal||'',asunto:a.asunto,modalidad:'PRÉSTAMO',observacion:a.fuente==='V761_TRAMITE'?['Asignación de Data','Registro: '+(a.numero_registro||'Por confirmar'),'Trámite: '+(a.tipo_tramite||a.asunto),'Administrado: '+(a.administrado||'Por confirmar')].join(' · '):''};
    await openNewRequestModal([item],true);
    status('Solicitud preparada para '+a.expediente+'. Debe pulsar «Enviar solicitud» para registrarla; Data no la creó.');
  }catch(e){err(e)}
}
async function ownRequest(){
   if(typeof isCoordinator==='function'&&isCoordinator()&&typeof openCoordinatorNewRequestV396==='function'){await openCoordinatorNewRequestV396();return;}
   if(typeof openNewRequestModal==='function')await openNewRequestModal();
 }
 async function cancel(id){
  const reason=window.prompt('Motivo para cancelar esta asignación pendiente (se conserva en el historial):');if(reason===null)return;
  if(!reason.trim()){status('La cancelación requiere un motivo.');return;}
  const a=rows.find(x=>x.id===id);
  try{
    const rpc=a?.fuente==='V761_TRAMITE'?'v761_data_cancelar':a?.pendiente_registro?'v758_data_cancelar':'v756_data_cancelar';
    const {error}=await api().rpc(rpc,{p_asignacion_id:id,p_motivo:reason.trim()});if(error)throw error;
    window.v841InvalidateDataReads?.();
    await load();status('Asignación cancelada; historial conservado.');
  }catch(e){err(e)}
}
function v761HeaderKey(h){return String(h||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().replace(/[^A-Z0-9]/g,'');}
function v761DateISO(v){
 if(v==null||String(v).trim()==='')return '';
 if(v instanceof Date&&!isNaN(v))return [v.getFullYear(),String(v.getMonth()+1).padStart(2,'0'),String(v.getDate()).padStart(2,'0')].join('-');
 const s=String(v).trim();let m;
 if((m=s.match(/^(\d{4})-(\d\d?)-(\d\d?)/)))return m[1]+'-'+m[2].padStart(2,'0')+'-'+m[3].padStart(2,'0');
 if((m=s.match(/^(\d{1,2})[\/.-](\d{1,2})[\/.-](\d{2}|\d{4})$/))){const yyyy=m[3].length===2?'20'+m[3]:m[3];return yyyy+'-'+m[2].padStart(2,'0')+'-'+m[1].padStart(2,'0');}
 if(/^\d{5}$/.test(s)){const d=new Date(Date.UTC(1899,11,30)+Number(s)*86400000);return d.toISOString().slice(0,10);}
 throw new Error('Fecha no válida: '+s+'. Use dd/mm/aaaa o aaaa-mm-dd.');
}
function v761RowFromExcel(raw,n){
 const normRow={};Object.entries(raw||{}).forEach(([key,val])=>normRow[v761HeaderKey(key)]=val);
 const get=(...keys)=>{for(const k of keys){const v=normRow[k];if(v!==undefined&&String(v).trim()!=='')return String(v).trim();}return '';};
 const num=get('NROEXP','NUMEROEXPEDIENTE','EXPEDIENTE','NEXP').toUpperCase().replace(/\s+/g,'');
 if(!num)return null;
 if(!/^\d+-[12]\d{3}$/.test(num))throw new Error('Fila '+n+': número de expediente incorrecto: '+num);
 const lawyer=get('ABOGADO','RESPONSABLE');const selected=targetOptions.find(x=>x.usuario_id===$('v756Target')?.value);
 if(lawyer&&selected){const clean=v=>String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().replace(/[^A-Z ]/g,' ').split(/\s+/).filter(x=>x.length>=3);
  const a=clean(lawyer),b=clean(selected.nombre);if(b.length&&b.filter(x=>a.includes(x)).length<Math.min(2,b.length))throw new Error('Fila '+n+': el abogado '+lawyer+' no coincide con '+selected.nombre+'. Seleccione el destinatario correcto.');
 }
 return {id:null,expediente:num,extension:get('EXTENSION','SIGLA')||null,pendiente_registro:true,
  numero_registro:get('NROREG','NUMEROREGISTRO','REGISTRO').toUpperCase(),fecha_registro:v761DateISO(get('FECREG','FECHAREGISTRO')),
  rd_primigenia:get('RDPRIMIGENIA','RD','RESOLUCIONDIRECTORAL'),administrado:get('ADMINISTRADO','RAZONSOCIAL'),
  tipo_tramite:get('SOLICITUD','TIPOTRAMITE','TRAMITE','BENEFICIO').toUpperCase(),fecha_vencimiento:v761DateISO(get('FECHAVENCIMIENTO','VENCIMIENTO','FECVENC'))};
}
function v761ParseCSV(text){const out=[];let row=[],v='',quotes=false;const delimiter=(String(text).split(/\r?\n/)[0].match(/;/g)||[]).length>=(String(text).split(/\r?\n/)[0].match(/,/g)||[]).length?';':',';
 for(let i=0;i<text.length;i++){const c=text[i];if(c==='"'){if(quotes&&text[i+1]==='"'){v+='"';i++;}else quotes=!quotes;}else if(!quotes&&c===delimiter){row.push(v);v='';}else if(!quotes&&(c==='\n'||c==='\r')){if(c==='\r'&&text[i+1]==='\n')i++;row.push(v);v='';if(row.some(x=>x.trim()))out.push(row);row=[];}else v+=c;}
 row.push(v);if(row.some(x=>x.trim()))out.push(row);const headers=(out.shift()||[]).map(x=>x.replace(/^\uFEFF/,''));return out.map(r=>Object.fromEntries(headers.map((h,i)=>[h,r[i]||''])));
}
// V763: lector OOXML local sin dependencia de CDN. Conserva encabezados desplazados y cadenas compartidas.
function v763Xml(text,filename){
 const dom=new DOMParser().parseFromString(text,'application/xml');
 if(dom.getElementsByTagName('parsererror').length)throw new Error('El archivo Excel contiene XML inválido en '+filename+'.');
 return dom;
}
function v763XmlEls(parent,localName){return [...parent.getElementsByTagNameNS('*',localName)];}
function v763CellValue(cell,shared,formats){
 const type=cell.getAttribute('t')||'';
 let value='';
 if(type==='inlineStr')value=v763XmlEls(cell,'is').flatMap(el=>v763XmlEls(el,'t')).map(el=>el.textContent).join('');
 else {const node=v763XmlEls(cell,'v')[0];value=node?.textContent??'';if(type==='s')value=shared[parseInt(value,10)]??'';}
 if((type==='n'||type==='')&&/^[-+]?\d+(?:\.\d+)?$/.test(value)){
  const f=formats[parseInt(cell.getAttribute('s')||'0',10)]||'';
  // Preserve identifiers formatted with leading zeroes; do not turn them into plain integers.
  if(/^0{2,}$/.test(f)&&Number.isFinite(+value))value=String(Math.trunc(+value)).padStart(f.length,'0');
 }
 return String(value);
}
async function v763ReadXLSXOffline(file){
 if(typeof JSZip==='undefined')throw new Error('El lector XLSX integrado no está disponible.');
 const buf=await file.arrayBuffer();
 if(buf.byteLength>12*1024*1024)throw new Error('El archivo supera 12 MB. Divídalo en bloques más pequeños.');
 let zip;try{zip=await JSZip.loadAsync(buf);}catch(_){
  throw new Error('No es un XLSX válido. Si es un archivo .xls antiguo, ábralo en Excel y guárdelo como .xlsx.');
 }
 const shared=[];
 if(zip.file('xl/sharedStrings.xml')){
  const xml=v763Xml(await zip.file('xl/sharedStrings.xml').async('string'),'sharedStrings');
  v763XmlEls(xml,'si').forEach(si=>shared.push(v763XmlEls(si,'t').map(x=>x.textContent).join('')));
 }
 const formats=[];
 if(zip.file('xl/styles.xml')){
  const xml=v763Xml(await zip.file('xl/styles.xml').async('string'),'styles');
  const custom={};v763XmlEls(xml,'numFmt').forEach(x=>custom[x.getAttribute('numFmtId')]=x.getAttribute('formatCode')||'');
  const xfs=v763XmlEls(xml,'cellXfs')[0];if(xfs)v763XmlEls(xfs,'xf').forEach(x=>formats.push(custom[x.getAttribute('numFmtId')]||''));
 }
 const sheets=Object.keys(zip.files).filter(n=>/^xl\/worksheets\/sheet\d+\.xml$/.test(n)).sort((a,b)=>+(a.match(/sheet(\d+)/)[1])-(+b.match(/sheet(\d+)/)[1]));
 if(!sheets.length)throw new Error('El archivo Excel no contiene hojas de cálculo reconocibles.');
 const all=[];
 for(const fileName of sheets.slice(0,12)){
  const xml=v763Xml(await zip.file(fileName).async('string'),fileName);
  const data=v763XmlEls(xml,'sheetData')[0];if(!data)continue;
  const rows=[];
  for(const row of v763XmlEls(data,'row').slice(0,2000)){
   const arr=[];
   for(const c of v763XmlEls(row,'c')){
    const letter=(c.getAttribute('r')||'').match(/^[A-Z]+/i)?.[0]||'';
    let index=0;for(const ch of letter.toUpperCase())index=index*26+ch.charCodeAt(0)-64;
    if(index>0&&index<=80)arr[index-1]=v763CellValue(c,shared,formats);
   }
   rows.push({sourceRow:Number(row.getAttribute('r'))||rows.length+1,cells:arr});
  }
  all.push({sheet:fileName,rows});
 }
 return all;
}
// V764: detecta encabezados en tablas reales, CSV con texto previo y variantes institucionales.
function v764HeaderCanon(h){
 const k=v761HeaderKey(h);
 if(['ABOGADO','ABOGADORESOLUTOR','ABOGADORESOLUTORASIGNADO','ABOGADOASIGNADO','RESPONSABLE','PROFESIONAL'].includes(k))return 'ABOGADO';
 if(['NROREG','NREG','NROREGISTRO','NREGISTRO','NUMEROREGISTRO','NUMREGISTRO','REGISTRO','NUMERODELCARGO'].includes(k))return 'NRO_REG';
 if(['FECREG','FECHAREG','FECHAREGISTRO','FECHADE REGISTRO'.replace(/ /g,'')].includes(k))return 'FEC_REG';
 if(['NROEXP','NEXP','NUMEXP','NUMEROEXP','NEXPEDIENTE','NROEXPEDIENTE','NUMEROEXPEDIENTE','NUMERODEEXPEDIENTE','EXPEDIENTE','NOEXP'].includes(k))return 'NRO_EXP';
 if(['EXTENSION','EXT','SIGLA','SIGLAEXPEDIENTE','EXTENSIONEXPEDIENTE'].includes(k))return 'EXTENSION';
 if(['RDPRIMIGENIA','RESOLUCIONPRIMIGENIA','RD','NRORESOLUCION','RESOLUCIONDIRECTORAL','RDPRIMIG'].includes(k))return 'RD_PRIMIGENIA';
 if(['ADMINISTRADO','ADMINISTRADOS','NOMBREADMINISTRADO','RAZONSOCIAL','DENOMINACION','RAZONSOCIALADMINISTRADO'].includes(k))return 'ADMINISTRADO';
 if(['SOLICITUD','TIPOTRAMITE','TIPODESOLICITUD','SOLICITUDTIPOTRAMITE','TRAMITE','BENEFICIO','ASUNTO','MATERIA'].includes(k))return 'SOLICITUD';
 if(['FECHAVENCIMIENTO','FECHADEVENCIMIENTO','FECVENC','FECVTO','VENCIMIENTO','FECHALIMITE','FECHAVENC','PLAZO'].includes(k))return 'FECHA_VENCIMIENTO';
 return '';
}
function v764RecognizeRows(sheets){
 const all=[];const diagnostics=[];
 for(const sheet of sheets){
  const rows=sheet.rows||[];let found=-1,colMap=[];
  for(let i=0;i<Math.min(rows.length,100);i++){
   const keys=(rows[i].cells||[]).map(v764HeaderCanon);
   if(keys.includes('NRO_EXP')&&keys.filter(x=>x&&x!=='NRO_EXP').length>=1){found=i;colMap=keys;break;}
  }
  if(found<0){diagnostics.push(sheet.sheet+': sin encabezado NRO_EXP');continue;}
  let priorLawyer='';
  for(const row of rows.slice(found+1)){
   const obj={};colMap.forEach((col,j)=>{if(col)obj[col]=String(row.cells?.[j]??'').trim();});
   if(obj.ABOGADO)priorLawyer=obj.ABOGADO;
   else if(priorLawyer&&colMap.includes('ABOGADO'))obj.ABOGADO=priorLawyer;
   if(!obj.NRO_EXP)continue;
   if(v761HeaderKey(obj.NRO_EXP)==='NROEXP')continue;
   all.push({data:obj,excelRow:row.sourceRow,sheet:sheet.sheet});
  }
 }
 if(!all.length)throw new Error('No encontré expedientes en las hojas. Requiere una columna «NRO_EXP» (o «EXPEDIENTE»), más otra columna de datos. '+diagnostics.slice(0,3).join('; '));
 return all;
}
function v764ParseCsvRows(text){
 const str=String(text||'').replace(/^\uFEFF/,'');
 const sample=str.split(/\r?\n/).slice(0,12);
 const candidates=[';',',','\t'];const delimiter=candidates.sort((a,b)=>sample.reduce((n,x)=>n+(x.split(b).length-1),0)-sample.reduce((n,x)=>n+(x.split(a).length-1),0))[0];
 const result=[];let row=[],cur='',quoted=false;
 for(let i=0;i<str.length;i++){
  const c=str[i];if(c==='"'){if(quoted&&str[i+1]==='"'){cur+='"';i++;}else quoted=!quoted;}
  else if(!quoted&&c===delimiter){row.push(cur);cur='';}
  else if(!quoted&&(c==='\n'||c==='\r')){if(c==='\r'&&str[i+1]==='\n')i++;row.push(cur);cur='';if(row.some(x=>x.trim()))result.push({sourceRow:result.length+1,cells:row});row=[];}
  else cur+=c;
 }
 row.push(cur);if(row.some(x=>x.trim()))result.push({sourceRow:result.length+1,cells:row});
 return [{sheet:'CSV',rows:result}];
}
function v764LawyerTokens(v){
 return String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().replace(/[^A-Z ]/g,' ').split(/\s+/).filter(x=>x.length>=3&&!['DEL','LAS','LOS','DE','POR','SAN','DR'].includes(x));
}
function v764LawyerMatches(excelName,optionName){
 const a=v764LawyerTokens(excelName),b=v764LawyerTokens(optionName);
 const common=b.filter(t=>a.includes(t));
 return a.length>=2&&b.length>=2&&common.length>=Math.min(2,b.length);
}
function v763RecognizeRows(sheets){
 const keys=['NROEXP','NUMEROEXPEDIENTE','EXPEDIENTE','NEXP'];
 let candidates=[];
 for(const sheet of sheets){
  const rows=sheet.rows||[];let at=-1;
  for(let i=0;i<Math.min(rows.length,45);i++){
   const names=rows[i].cells.map(v761HeaderKey);
   const num=names.some(h=>keys.includes(h));
   const extra=names.some(h=>['NROREG','NUMEROREGISTRO','REGISTRO','ADMINISTRADO','SOLICITUD','TIPOTRAMITE','FECHAVENCIMIENTO','EXTENSION'].includes(h));
   if(num&&extra){at=i;break;}
  }
  if(at<0)continue;
  const names=rows[at].cells.map(x=>String(x??'').replace(/^\uFEFF/,''));
  let lastLawyer='';
  for(const row of rows.slice(at+1)){
   const values=Object.fromEntries(names.map((h,i)=>[h,row.cells[i]??'']).filter(x=>x[0]));
   const normalized=Object.fromEntries(Object.entries(values).map(([k,v])=>[v761HeaderKey(k),String(v??'').trim()]));
   if(normalized.ABOGADO||normalized.RESPONSABLE)lastLawyer=normalized.ABOGADO||normalized.RESPONSABLE;
   else if(lastLawyer&&names.some(h=>v761HeaderKey(h)==='ABOGADO'))values[names.find(h=>v761HeaderKey(h)==='ABOGADO')]=lastLawyer;
   const num=keys.map(k=>normalized[k]).find(Boolean);
   if(num)candidates.push({data:values,excelRow:row.sourceRow,sheet:sheet.sheet});
  }
 }
 if(!candidates.length)throw new Error('No se encontraron filas con expediente. Verifique que el Excel incluya NRO_EXP y EXTENSION, entre otras columnas.');
 return candidates;
}
async function v761ImportExcel(file){
 if(!file)return;
 v764LocalStatus('v764ImportStatus','');
 const tgt=$('v756Target');if(!tgt?.value){const m='Seleccione primero al abogado antes de importar el Excel.';v764LocalStatus('v764ImportStatus',m);v760Feedback(m,false);tgt?.focus();return;}
 if(batch.length>=100){v764LocalStatus('v764ImportStatus','El lote ya contiene 100 trámites. Guarde antes de importar más.');return;}
 const ctrl=$('v761ExcelInput'),button=$('v763ImportButton');if(ctrl)ctrl.disabled=true;if(button)button.disabled=true;
 v764LocalStatus('v764ImportStatus','Leyendo '+file.name+'... No cierre la ventana.',true);
 try{
  if(/\.xls$/i.test(file.name))throw new Error('El formato .xls antiguo no está admitido. Abra el archivo en Excel y guárdelo como Libro de Excel (*.xlsx).');
  if(!/\.(xlsx|xlsm|csv)$/i.test(file.name))throw new Error('Seleccione un archivo .xlsx, .xlsm o .csv.');
  if(file.size>12*1024*1024)throw new Error('El archivo supera los 12 MB; divídalo en bloques.');
  const sheets=/\.csv$/i.test(file.name)?v764ParseCsvRows(await file.text()):await v763ReadXLSXOffline(file);
  const recognized=v764RecognizeRows(sheets);
  if(recognized.length+batch.length>100)throw new Error('El archivo contiene '+recognized.length+' registros y el máximo por lote es 100. Divídalo en partes.');
  // El destinatario nunca se cambia sin que el usuario lo confirme.
  const allLawyers=[...new Set(recognized.map(r=>String(r.data.ABOGADO||'').trim()).filter(Boolean))];
  let selected=targetOptions.find(x=>x.usuario_id===tgt.value);
  const incompatible=allLawyers.filter(n=>!v764LawyerMatches(n,selected?.nombre));
  if(incompatible.length){
   // Con un solo destinatario real y una lista vacía, ofrecer selección explícita.
   if(allLawyers.length===1&&batch.length===0){
     const matches=targetOptions.filter(x=>v764LawyerMatches(allLawyers[0],x.nombre));
     if(matches.length===1){
       if(!confirm('El Excel está dirigido a «'+allLawyers[0]+'», pero seleccionaste «'+(selected?.nombre||'otro usuario')+'». ¿Quieres cambiar el destinatario a «'+matches[0].nombre+'» e importar?'))throw new Error('Importación cancelada: confirme el abogado correcto para evitar una asignación incorrecta.');
       tgt.value=matches[0].usuario_id;selected=matches[0];
     }else throw new Error('El abogado «'+allLawyers[0]+'» del Excel no coincide con el seleccionado («'+(selected?.nombre||'')+'»). Seleccione al abogado correcto.');
   }else throw new Error('El Excel contiene filas asignadas a otros abogados: '+incompatible.slice(0,3).join(', ')+'. Importe un abogado por lote.');
  }
  const prepared=recognized.map(r=>v761RowFromExcel(r.data,r.excelRow)).filter(Boolean);
  if(!prepared.length)throw new Error('No hay filas con números de expediente válidos.');
  const combined=[...batch];
  for(const row of prepared){
   if(combined.some(x=>batchKey(x)===batchKey(row)))throw new Error('Fila duplicada: '+row.expediente+' / '+(row.numero_registro||row.tipo_tramite||'sin trámite')+'. Revise el Excel o quite la repetida de la lista.');
   combined.push(row);
  }
  batch=combined;renderBatch();
  const msg='Importación completada: '+prepared.length+' trámite(s) de '+file.name+'. Total preparado: '+batch.length+'. Ahora seleccione el ASUNTO DE LA FUTURA ATENCIÓN y pulse «Guardar asignación».';
  v764LocalStatus('v764ImportStatus',msg,true);v760Feedback(msg,true);
  const subject=$('v756Subject');if(!subject?.value)subject?.focus();
 }catch(e){
  console.warn('V764 fallo de importación:',e);
  const msg='No se importó el archivo: '+(e?.message||String(e))+' La lista previa se conserva.';
  v764LocalStatus('v764ImportStatus',msg);v760Feedback(msg,false);
 }finally{if(ctrl)ctrl.disabled=false;if(button)button.disabled=false;}
}
function v761DownloadTemplate(){const cols=['ABOGADO','NRO_REG','FEC_REG','NRO_EXP','EXTENSION','RD_PRIMIGENIA','ADMINISTRADO','SOLICITUD','FECHA_VENCIMIENTO'];
 const ejemplo=[cols,Array(cols.length).fill('')];
 if(typeof XLSX!=='undefined'){const wb=XLSX.utils.book_new(),ws=XLSX.utils.aoa_to_sheet(ejemplo);ws['!cols']=[{wch:30},{wch:20},{wch:15},{wch:18},{wch:18},{wch:35},{wch:38},{wch:30},{wch:21}];XLSX.utils.book_append_sheet(wb,ws,'Asignaciones Data');XLSX.writeFile(wb,'PLANTILLA_ASIGNACIONES_DATA_V763.xlsx');return;}
 const csv=ejemplo.map(row=>row.map(x=>'"'+String(x).replace(/"/g,'""')+'"').join(';')).join('\r\n');
 const blob=new Blob(['\uFEFF'+csv],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='PLANTILLA_ASIGNACIONES_DATA_V763.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);
}
 // V765: raw Data workbook export; exact source headers and original order.
 const v765RawHeaders=['ABOGADO','NRO_REG','FEC_REG','NRO_EXP','EXTENSION','RD_PRIMIGENIA','ADMINISTRADO','SOLICITUD','FECHA_VENCIMIENTO'];
 const v765RawRow=(a)=>[
   a.destinatario||'',String(a.numero_registro||''),v762ExportDate(a.fecha_registro),
   String(a.expediente||a.numero||''),a.extension||'',a.rd_primigenia||'',
   a.administrado||'',a.tipo_tramite||'',v762ExportDate(a.fecha_vencimiento)
 ];
 function v765ExportWithHeaders(btn,prepared=false){
   const activeBtn=btn;if(activeBtn?.disabled)return;
   const before=activeBtn?.textContent;if(activeBtn){activeBtn.disabled=true;activeBtn.textContent='Preparando Excel…';}
   Promise.resolve().then(async()=>{
    let data=[];
    if(prepared){
      const dest=targetOptions.find(x=>x.usuario_id===$('v756Target')?.value)?.nombre||'';
      data=batch.map(x=>({...x,destinatario:dest}));
    }else{
      if(!current()||!api())throw new Error('Inicie sesión primero.');
      const rsp=await window.v841DataList(true);if(rsp.error)throw rsp.error;
      data=Array.isArray(rsp.data)?rsp.data:[];
    }
    const rowsOut=data.map(v765RawRow);
    const ok=v762SaveExport(prepared?'DATA_LISTA_FORMATO_ORIGINAL':'DATA_ASIGNACIONES_FORMATO_ORIGINAL',rowsOut,v765RawHeaders);
    if(ok)status('Exportación generada con los 9 encabezados originales de Data.');
   }).catch(e=>{const msg='Error al exportar formato Data: '+(e?.message||e);status(msg);v764LocalStatus('v764ImportStatus',msg);})
    .finally(()=>{if(activeBtn){activeBtn.disabled=false;activeBtn.textContent=before;}});
 }
 window.v765ExportWithHeaders=v765ExportWithHeaders;
 // V762 · Exportaciones de Data con descarga fiable y alternativa CSV.
 const v762ExportHeaders=[
   'ABOGADO','ASIGNADO_POR','NRO_REG','FEC_REG','NRO_EXP','EXTENSION',
   'RD_PRIMIGENIA','ADMINISTRADO','SOLICITUD','FECHA_VENCIMIENTO',
   'ASUNTO_ATENCION','OBSERVACION','ESTADO_ASIGNACION','FECHA_ASIGNACION',
   'NRO_SOLICITUD_ARCHIVO','SOLICITADO_POR','ESTADO_CUSTODIA','RESPONSABLE_CUSTODIA'
 ];
 function v762ExportDate(v){return v?v761DateLabel(v):'';}
 function v762ExportRow(x){return [
   x.destinatario||'',x.asignado_por||'',x.numero_registro||'',
   v762ExportDate(x.fecha_registro),x.expediente||x.numero||'',x.extension||'',
   x.rd_primigenia||'',x.administrado||'',x.tipo_tramite||'',
   v762ExportDate(x.fecha_vencimiento),x.asunto||'',x.observacion||'',
   lblState(x.estado)||'',x.created_at?fmt(x.created_at):'',
   x.numero_solicitud||'',x.solicitado_por||'',x.estado_custodia||'',x.custodio||''
 ];}
 function v762ExcelSafeText(v){
   // Evita que un valor proporcionado por otro usuario se ejecute como fórmula al abrir CSV.
   const s=String(v??'');return /^[\s]*[=+@\-\t\r]/.test(s)?"'"+s:s;
 }
 function v762CsvCell(v){return '"'+v762ExcelSafeText(v).replace(/"/g,'""')+'"';}
 function v762CsvText(headers,body){return '\uFEFF'+[headers,...body].map(r=>r.map(v762CsvCell).join(';')).join('\r\n');}
 function v762BrowserDownload(blob,name){
   const url=URL.createObjectURL(blob),link=document.createElement('a');
   link.href=url;link.download=name;link.style.display='none';document.body.appendChild(link);
   try{link.click();}finally{setTimeout(()=>{link.remove();URL.revokeObjectURL(url);},30000);}
 }
 function v762OutputDate(){const d=new Date();const parts=new Intl.DateTimeFormat('en-GB',{timeZone:'America/Lima',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(d);const val=t=>parts.find(p=>p.type===t)?.value||'';return [val('year'),val('month'),val('day')].join('-');}
 function v762SaveExport(prefix,records,headers=v762ExportHeaders){
   if(!records.length){v760Feedback('No existen filas para exportar. Agregue o cargue asignaciones y vuelva a intentar.',false);return false;}
   const basename=prefix+'_'+v762OutputDate(),data=[headers,...records];
   if(typeof XLSX!=='undefined'&&XLSX?.utils?.aoa_to_sheet&&XLSX?.writeFile){
     try{
       const wb=XLSX.utils.book_new(),ws=XLSX.utils.aoa_to_sheet(data.map(row=>row.map(v=>v762ExcelSafeText(v))));
       ws['!cols']=headers.map((h,i)=>({wch:i===7?38:i===6?34:i===10||i===11?35:i===0||i===1?30:22}));
       ws['!autofilter']={ref:'A1:'+XLSX.utils.encode_col(headers.length-1)+data.length};
       XLSX.utils.book_append_sheet(wb,ws,'Asignaciones Data');
       XLSX.writeFile(wb,basename+'.xlsx',{compression:true});
       status('Exportadas '+records.length+' fila(s) a Excel. Consulte la carpeta Descargas.');
       return true;
     }catch(ex){console.warn('V762: se usará CSV por fallo de XLSX:',ex);}
   }
   const csv=v762CsvText(headers,records);
   v762BrowserDownload(new Blob([csv],{type:'text/csv;charset=utf-8'}),basename+'.csv');
   status('Exportadas '+records.length+' fila(s) como CSV compatible con Excel. Consulte Descargas.');
   return true;
 }
 async function v762ExportAssignments(btn){
   if(!current()||!api()){status('Primero debe iniciar sesión.');return;}
   if(btn?.disabled)return;
   const before=btn?.textContent;
   if(btn){btn.disabled=true;btn.textContent='Preparando exportación…';}
   try{
     // Consultar nuevamente el servidor para evitar exportar datos de una sesión anterior.
     const {data,error}=await window.v841DataList(true);if(error)throw error;
     const available=Array.isArray(data)?data:[];
     if(!available.length){status('No existen asignaciones registradas para exportar con este perfil.');return;}
     v762SaveExport('ASIGNACIONES_DATA',available.map(v762ExportRow));
   }catch(ex){const msg=ex?.message||String(ex);status('No se pudo exportar: '+msg);console.error('V762 exportar asignaciones:',ex);}
   finally{if(btn){btn.disabled=false;btn.textContent=before;}}
 }
 function v762ExportBatch(btn){
   if(!batch.length){v760Feedback('La lista está vacía. Agregue expedientes antes de exportar.',false);return;}
   const target=targetOptions.find(x=>x.usuario_id===$('v756Target')?.value)?.nombre||'';
   const asunto=$('v756Subject')?.value||'';
   const personal=currentProfile?.nombre_personal||'';
   const day=new Date().toISOString();
   const staged=batch.map(x=>v762ExportRow({
     ...x,destinatario:target,asignado_por:personal,asunto,observacion:$('v756Note')?.value||'',
     estado:'PENDIENTE DE GUARDAR',created_at:day,estado_custodia:'SIN CAMBIO',custodio:'POR VERIFICAR'
   }));
   try{v762SaveExport('LISTA_PREPARADA_DATA',staged);}
   catch(ex){status('No se pudo exportar la lista: '+(ex?.message||String(ex)));console.error('V762 exportar lista:',ex);}
 }
 window.v762ExportDataAssignments=v762ExportAssignments;
 window.v762ExportDataBatch=v762ExportBatch;
 window.v756LoadAssignments=load;
 window.v756FindExpedientes=find;
 window.v756ChooseExp=choose;
 window.v759AddToBatch=addToBatch;
 window.v759RemoveFromBatch=removeFromBatch;
 window.v761EditBatch=v761EditBatch;
 window.v761ImportDataExcel=v761ImportExcel;
 window.v761DownloadTemplate=v761DownloadTemplate;
 window.v759ClearCandidate=function(){chosen=null;results=[];const list=$('v756SearchResults');if(list)list.innerHTML='';const label=$('v756SelectedLabel');if(label)label.textContent='Busque y seleccione el expediente antes de agregarlo.';};
 window.v758ChooseUnregistered=chooseUnregistered;
 window.v756SaveAssignment=save;
 window.v756RequestAssigned=request;
 window.v756OpenOwnRequest=ownRequest;
 window.v756CancelAssignment=cancel;
 setInterval(()=>{try{if(current()&&!loading)load();}catch(_){}},30000);
 setTimeout(()=>{try{if(current())load();}catch(_){}},3500);
})();
</script>
<div class="modal" id="v768Modal" role="dialog" aria-modal="true" aria-labelledby="v768Title">
 <div class="modal-box">
  <div class="modal-head"><h2 id="v768Title">Expedientes asignados por Data</h2><button type="button" class="btn secondary small" id="v768Close">Cerrar</button></div>
  <p class="note" id="v768Message" role="status" aria-live="polite"></p>
  <div id="v768GroupRows"></div>
  <div class="v768-actions">
   <button type="button" id="v768Prepare" class="btn">Preparar solicitud</button>
   <button type="button" id="v768Link" class="btn secondary">Vincular solicitudes existentes</button>
  </div>
  <p class="v768-small">Esta revisión no registra préstamos ni cargos. La solicitud se presenta únicamente al pulsar «Enviar solicitud» en el formulario habitual. Los encargos cancelados no se incluyen.</p>
 </div>
</div>
<script id="v768GroupLogic">
(function(){
'use strict';
const byId=id=>document.getElementById(id);
const normal=s=>String(s||'').trim().toUpperCase();
const current=()=>typeof session!=='undefined'&&session?.user?.id;
const client=()=>typeof sb!=='undefined'?sb:null;
let group=[],working=false;
function node(tag,cls,txt){const x=document.createElement(tag);if(cls)x.className=cls;if(txt!==undefined)x.textContent=String(txt);return x;}
function say(msg){const x=byId('v768Message');if(x)x.textContent=msg;}
function status(x){return x.status==='SOLICITUD_EXISTENTE'?'Ya solicitado · '+(x.data.numero_solicitud||'Solicitud existente'):
 x.status==='AMBIGUO'?'Varias extensiones; consultar Archivo':x.status==='REVISAR_ARCHIVO'?'En préstamo; requiere verificar en Archivo':'Pendiente de solicitar';}
function extOptions(exp){return typeof requestValidExtensionsForExpediente==='function'?(requestValidExtensionsForExpediente(exp)||[]):[];}
function merge(items){
 const map=new Map();
 for(const a of items){const key=a.expediente_id||[normal(a.expediente),normal(a.extension_maestro||a.extension_data)].join('|');
   if(!map.has(key))map.set(key,{data:a,records:[],status:a.clasificacion,extension:a.extension_maestro||a.extension_data||'',selected:a.clasificacion==='POR_SOLICITAR'});
   const x=map.get(key);x.records.push(a);
   if(a.clasificacion!=='POR_SOLICITAR')x.status=a.clasificacion;
 }
 for(const x of map.values()){
  const valid=extOptions(x.data.expediente);
  if(x.status==='POR_SOLICITAR'&&valid.length===1 && !valid.some(y=>normal(y)===normal(x.extension)))x.extension=valid[0];
 }
 return [...map.values()];
}
function render(){
 const host=byId('v768GroupRows');if(!host)return;host.replaceChildren();
 let canRequest=0,canLink=0;
 for(const x of group){
  const line=node('div','v768-row');const check=node('input');check.type='checkbox';check.checked=x.selected&&x.status==='POR_SOLICITAR';check.disabled=x.status!=='POR_SOLICITAR';
  check.addEventListener('change',()=>{x.selected=check.checked;render()});line.appendChild(check);
  const main=node('div');main.appendChild(node('strong','',x.data.expediente));
  main.appendChild(node('div','v768-small',x.records.length+' trámite(s) · '+x.records.map(y=>y.numero_registro||'').filter(Boolean).join(', ')));line.appendChild(main);
  const col=node('div');col.appendChild(node('div','',x.extension||'Sin extensión'));
  if(x.status==='POR_SOLICITAR'){
   const opts=extOptions(x.data.expediente);
   if(opts.length>1){const sel=node('select');sel.appendChild(new Option('Seleccionar extensión',''));
    for(const o of opts)sel.appendChild(new Option(o,o));sel.value=opts.includes(x.extension)?x.extension:'';
    sel.addEventListener('change',()=>{x.extension=sel.value;render()});col.replaceChildren(sel);
   }else if(opts.length===1){col.replaceChildren(node('div','',opts[0]));x.extension=opts[0];}
  }
  if(normal(x.extension)!==normal(x.data.extension_data||''))col.appendChild(node('div','v768-small','Data registró: '+(x.data.extension_data||'sin sigla')));
  line.appendChild(col);
  const situation=node('div');situation.appendChild(node('strong','',status(x)));
  situation.appendChild(node('div','v768-small',(x.data.administrado||'')+' '+(x.data.tipo_tramite||'')));line.appendChild(situation);
  host.appendChild(line);
  if(check.checked)canRequest++;
  if(x.status==='SOLICITUD_EXISTENTE')canLink++;
 }
 const prepare=byId('v768Prepare');prepare.disabled=working||canRequest===0;prepare.textContent='Preparar una solicitud ('+canRequest+' expediente(s))';
 const link=byId('v768Link');link.hidden=!canLink;link.disabled=working;
 link.textContent='Reconocer '+canLink+' expediente(s) ya solicitados';
}
async function open(id){
 if(working)return;working=true;group=[];byId('v768Modal').classList.add('show');say('Consultando todos los expedientes del bloque...');render();
 try{
  if(!current()||!client())throw Error('Inicie sesión como el destinatario de Data.');
  const reply=await client().rpc('v766_data_revisar_grupo',{p_asignacion_id:id});
  if(reply.error)throw Error(reply.error.message||'No se pudo consultar el bloque.');
  if(!Array.isArray(reply.data?.items)||!reply.data.items.length)throw Error('No hay expedientes pendientes en este bloque.');
  group=merge(reply.data.items);say('Revise el bloque. Los expedientes con préstamo existente no se solicitarán otra vez.');
 }catch(e){say('No se pudo abrir el bloque: '+e.message);}finally{working=false;render();}
}
async function prepare(){
 if(working)return;
 const chosen=group.filter(x=>x.status==='POR_SOLICITAR'&&x.selected);
 if(!chosen.length){say('Seleccione al menos un expediente por solicitar.');return;}
 for(const x of chosen){const opts=extOptions(x.data.expediente);
  if(opts.length&&!opts.some(o=>normal(o)===normal(x.extension))){say('Debe elegir una extensión válida para '+x.data.expediente);return;}
 }
 working=true;render();say('Preparando el formulario con el bloque seleccionado...');
 try{
  if(!client()||!current())throw Error('Su sesión ya no está activa.');
  // Se comprueba otra vez el estado del bloque antes de preparar la solicitud.
  const check=await client().rpc('v766_data_revisar_grupo',{p_asignacion_id:chosen[0].records[0].id});
  if(check.error)throw Error(check.error.message);
  const valid=merge(check.data.items||[]);
  for(const item of chosen){const now=valid.find(x=>x.data.expediente===item.data.expediente);
   if(!now||now.status!=='POR_SOLICITAR')throw Error('Cambió el estado del expediente '+item.data.expediente+'. Actualice el bloque.');
  }
  if(typeof isCoordinator==='function'&&isCoordinator()&&typeof isCoordinatorTeamWorkspaceV206==='function'&&isCoordinatorTeamWorkspaceV206()&&typeof setCoordinatorWorkspaceV206==='function')await setCoordinatorWorkspaceV206('SELF','panel');
  window.__editingRequestId=null;window.__editingRequestNumero=null;window.__editingRequestState=null;
  const draft=[];
  for(const x of chosen){const a=x.data;
   if(a.expediente_id){const resp=await client().from('expedientes').select('*').eq('id',a.expediente_id).single();
    if(resp.error||!resp.data)throw Error('No se pudo consultar el expediente '+a.expediente+'.');
    draft.push({...resp.data,_nuevo:false});
   }else draft.push({id:null,expediente:a.expediente,extension:x.extension||null,rd:null,ultimo_folio:null,estado:'PENDIENTE DE VERIFICACIÓN',_nuevo:true});
  }
  const asunto=chosen[0].data.asunto||'';
  const obs='Encargo Data por bloque: '+chosen.map(x=>x.data.expediente).join(', ');
  window.__newRequestHeaderDraft={solicitante:currentProfile?.nombre_personal||'',asunto,modalidad:'PRÉSTAMO',observacion:obs};
  if(typeof openNewRequestModal!=='function')throw Error('Formulario de solicitudes no disponible.');
  await openNewRequestModal(draft,true);
  if(!byId('newRequestModal')?.classList.contains('show'))throw Error('No se pudo abrir el formulario de solicitud.');
  byId('v768Modal').classList.remove('show');
 }catch(e){say(e.message||'No se pudo preparar la solicitud.');}
 finally{working=false;render();}
}
async function link(){
 if(working)return;const selected=group.filter(x=>x.status==='SOLICITUD_EXISTENTE');
 if(!selected.length)return;
 if(!confirm('Se vincularán los encargos a solicitudes existentes, sin generar otros préstamos. ¿Continuar?'))return;
 working=true;render();
 try{
  const ids=[...new Set(selected.flatMap(x=>x.records.map(a=>a.id)))];
  const resp=await client().rpc('v766_data_vincular_existentes',{p_asignacion_ids:ids});
  if(resp.error)throw Error(resp.error.message);
  window.v841InvalidateDataReads?.();
  say('Se vincularon '+(resp.data?.vinculadas||0)+' encargo(s). No se generó un préstamo nuevo.');
  byId('v768Modal').classList.remove('show');
  if(typeof v756LoadAssignments==='function')await v756LoadAssignments();
 }catch(e){say(e.message||'No se pudieron vincular los encargos.');}finally{working=false;render();}
}
window.v768BlocksSummary=function(pending){
 const source=pending.filter(a=>a.fuente==='V761_TRAMITE'&&a.lote_id);
 const byLot=new Map();for(const a of source){if(!byLot.has(a.lote_id))byLot.set(a.lote_id,[]);byLot.get(a.lote_id).push(a);}
 if(!byLot.size)return '';
 const esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 return '<section class="v768-blocks"><strong>Bloques de Data pendientes de solicitar</strong>'+
 [...byLot.values()].map(list=>{
  const n=[...new Set(list.map(a=>a.expediente))];
  return '<div class="v768-block"><div><strong>'+list.length+' trámite(s) · '+n.length+' expediente(s)</strong><p>'+esc(n.join(' · '))+'</p></div>'+ 
  '<button type="button" class="btn small" onclick="v768OpenGroup(\''+esc(list[0].id)+'\')">Revisar y solicitar bloque</button></div>';}).join('')+'</section>';
};
window.v768OpenGroup=open;
byId('v768Close')?.addEventListener('click',()=>{if(!working)byId('v768Modal').classList.remove('show')});
byId('v768Prepare')?.addEventListener('click',prepare);
byId('v768Link')?.addEventListener('click',link);
})();
</script>
<script id="v769-data-email-ui">
(function(){
  'use strict';
  const byId=id=>document.getElementById(id);
  const esc=value=>String(value??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  const client=()=>typeof sb!=='undefined'?sb:null;
  const uid=()=>typeof session!=='undefined'?session?.user?.id||null:null;
  const shortDate=s=>{try{return new Date(s).toLocaleString('es-PE',{timeZone:'America/Lima',day:'2-digit',month:'2-digit',year:'numeric'})}catch(_){return String(s||'')}};
  function showMessage(id,text,good){const el=byId('v769mail-'+id);if(el){el.textContent=text||'';el.style.color=good?'#19613e':'#a12a27';}}
  function stateText(x){
    const v=String(x?.estado||'SIN_CORREO').toUpperCase();
    if(v==='SIN_CORREO')return 'Aún no se ha solicitado un correo para este bloque.';
    const name={PENDIENTE:'En cola, pendiente de procesamiento',ENVIANDO:'Procesando',EN_PROCESO:'Procesando',ENVIADO:'Enviado según la cola',ERROR:'Error de envío',FALLIDO:'Error de envío',CANCELADO:'Cancelado'}[v]||v;
    return name+(x?.enviado_at?' · '+shortDate(x.enviado_at):'')+(x?.ultimo_error?' · '+x.ultimo_error:'');
  }
  let busy=false;
  async function refresh(){
    const p=byId('v769MailPanel'),out=byId('v769MailRows');
    if(!p||!out||busy)return;
    const active=uid(),c=client();if(!active||!c){p.style.display='none';return;}
    busy=true;
    try{
      const {data:isData,error:roleError}=await window.v841RoleData();if(roleError)throw roleError;
      if(!isData){p.style.display='none';return;}
      p.style.display='block';
      const response=await window.v841DataList();if(response.error)throw response.error;
      const data=Array.isArray(response.data)?response.data:[];
      const map=new Map();
      (Array.isArray(data)?data:[]).forEach(row=>{
        if(row.fuente!=='V761_TRAMITE'||!row.lote_id||row.asignador_id!==active)return;
        if(!map.has(row.lote_id))map.set(row.lote_id,{lot:row.lote_id,target:row.destinatario,items:[],date:row.created_at});
        map.get(row.lote_id).items.push(row);
      });
      const groups=[...map.values()].sort((a,b)=>String(b.date).localeCompare(String(a.date))).slice(0,30);
      out.innerHTML=groups.length?groups.map(g=>{
        const ids=new Set(g.items.map(r=>r.expediente));
        const nActive=g.items.filter(x=>!['REEMPLAZADA','CANCELADA','RECHAZADA'].includes(x.estado)).length;
        const lot=esc(g.lot);
        return '<div class="v769-mail-lot" style="border:1px solid #dce5ef;border-radius:8px;padding:10px;margin:9px 0;background:var(--surface,#fff)">'+
          '<div><b>'+esc(g.target||'Sin destinatario')+'</b> · '+nActive+' trámite(s) · '+ids.size+' expediente(s)'+
          ' <span class="note">· '+esc(shortDate(g.date))+'</span></div>'+
          '<div class="note" style="margin:3px 0 7px">'+esc([...ids].join(' · '))+'</div>'+
          '<div style="display:flex;gap:6px;flex-wrap:wrap">'+
          '<button type="button" class="btn secondary small" onclick="v769SendMail(\''+lot+'\',false)">Enviar / consultar correo</button>'+
          '<button type="button" class="btn secondary small" onclick="v769CheckMail(\''+lot+'\')">Ver estado</button>'+
          '<button type="button" class="btn secondary small" onclick="v769SendMail(\''+lot+'\',true)">Reenviar con motivo</button></div>'+
          '<div class="note" id="v769mail-'+lot+'" role="status" style="margin-top:6px">Consulte el estado o solicite el envío.</div></div>';
      }).join(''):'<div class="note">Todavía no registra bloques propios de Data con este perfil.</div>';
    }catch(e){p.style.display='block';out.textContent='No se pudo consultar los bloques: '+(e?.message||String(e));}
    finally{busy=false;}
  }
  async function check(lot){
    try{
      const c=client();if(!c)throw Error('No hay conexión a Supabase.');
      const {data,error}=await c.rpc('v769_data_estado_correo_lote',{p_lote_id:lot});if(error)throw error;
      showMessage(lot,stateText(data),!['ERROR','FALLIDO'].includes(String(data?.estado||'').toUpperCase()));
      return data;
    }catch(e){showMessage(lot,e?.message||String(e),false);return null;}
  }
  async function send(lot,reenvio){
    let reason=null;
    if(reenvio){
      reason=window.prompt('Indique el motivo del reenvío del correo de Data:');
      if(reason===null)return;
      reason=reason.trim();if(!reason){showMessage(lot,'Debe indicar el motivo del reenvío.',false);return;}
      if(!window.confirm('¿Confirmar un nuevo correo a este mismo destinatario? La asignación no se modificará.'))return;
    }
    showMessage(lot,reenvio?'Solicitando reenvío...':'Consultando o poniendo el correo en cola...',true);
    try{
      const c=client();if(!c)throw Error('No hay conexión a Supabase.');
      const {data,error}=await c.rpc('v769_data_encolar_correo_lote',{
        p_lote_id:lot,p_reenviar:!!reenvio,p_motivo:reason
      });if(error)throw error;
      const action=data?.ya_existia?'El correo ya estaba registrado; no se duplicó.':
        (data?.encolado?'Correo puesto en cola.':'No se encoló un correo nuevo.');
      showMessage(lot,action+' Estado: '+(data?.estado||'PENDIENTE')+'. Destinatario: '+(data?.destinatario||'cuenta institucional')+'.',true);
    }catch(e){showMessage(lot,'No se pudo encolar el correo: '+(e?.message||String(e)),false);}
  }
  async function showRecipient(){
    const el=byId('v769RecipientPreview'),select=byId('v756Target'),opt=byId('v769NotifyOnSave');
    if(!el)return;
    if(opt)opt.checked=false;
    if(!select?.value){el.textContent='Seleccione un destinatario para comprobar su correo autorizado.';return;}
    el.textContent='Consultando el correo autorizado...';
    try{
      const c=client();if(!c)throw Error('No hay conexión a Supabase.');
      const {data,error}=await c.rpc('v769_data_destinatario_correo',{p_destinatario_id:select.value});
      if(error)throw error;
      if(select.value!==data?.usuario_id)return;
      el.textContent=data?.autorizado?
        ('Correo autorizado de notificación: '+data.email+(data.difiere_login?' · Atención: es distinto del correo de inicio de sesión. Revise el vínculo antes de enviar.':'')):
        'No hay una dirección autorizada para este usuario. Puede guardar la asignación sin enviar correo.';
    }catch(e){el.textContent='No se pudo verificar el correo: '+(e?.message||String(e));}
  }
  byId('v756Target')?.addEventListener('change',showRecipient);
  window.v769ReviewRecipient=showRecipient;
  window.v769SendMail=send;window.v769CheckMail=check;window.v769RefreshMailPanel=refresh;
  const original=window.v756LoadAssignments;
  if(typeof original==='function')window.v756LoadAssignments=async function(...args){const result=await original.apply(this,args);await refresh();return result;};
})();
</script>
<style id="v771-data-recipient-columns">
#v770RecipientBox{max-width:1100px!important}
.v771-recipient-columns{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);gap:12px;align-items:stretch;margin:10px 0 7px}
.v771-recipient-available,.v771-recipient-selected{min-width:0;border:1px solid #d5e0ec;border-radius:9px;background:#fff;overflow:hidden}
.v771-recipient-selected{background:#f6faff}
.v771-pane-header{min-height:39px;padding:9px 10px;display:flex;justify-content:space-between;gap:7px;align-items:center;background:#edf4fb;border-bottom:1px solid #dce5ef;color:#20466e}
.v771-pane-header strong{font-size:12px}
.v771-pane-hint{font-size:10px;color:#62778d;text-align:right}
.v771-selected-total{font-size:11px;font-weight:800;border:1px solid #c4d6e8;border-radius:999px;background:#fff;padding:2px 7px;white-space:nowrap}
.v771-recipient-search{display:block;box-sizing:border-box;width:calc(100% - 16px);margin:8px;height:36px;border:1px solid #cbd5e1;border-radius:7px;padding:0 10px;font-size:12px}
.v771-recipient-options{min-height:96px;max-height:260px;overflow-y:auto;padding:2px 8px 8px}
.v771-recipient-options .v770-choice{display:flex;min-height:34px;padding:7px 5px!important;overflow-wrap:anywhere}
.v771-selected-list{max-height:318px;min-height:150px;overflow:auto;padding:8px;display:flex;flex-direction:column;gap:6px}
.v771-selected-item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:7px;align-items:center;padding:8px;border:1px solid #d4e0ec;border-radius:8px;background:#fff}
.v771-selected-person{min-width:0}
.v771-selected-name{display:block;font-weight:750;color:#173d62;font-size:11px;line-height:1.3;overflow-wrap:anywhere}
.v771-selected-email{display:block;font-size:10px;color:#64748b;margin-top:3px;overflow-wrap:anywhere}
.v771-selected-role{display:inline-block;font-size:10px;font-weight:850;color:#235279;background:#e5f1fc;padding:3px 6px;border-radius:5px;margin-bottom:3px}
.v771-selected-role[data-main="true"]{color:#20573c;background:#e5f6ec}
.v771-selected-remove{width:27px;height:27px;border:1px solid #d3dfeb;border-radius:6px;background:#fff;color:#9a2d2d;cursor:pointer;font-weight:bold}
.v771-selected-remove:hover{background:#fff1f1}
.v771-selected-locked{font-size:10px;color:#52745f;font-weight:750;padding:4px}
.v771-empty{color:#637b91;font-size:12px;padding:12px 8px;line-height:1.5}
@media(max-width:730px){.v771-recipient-columns{grid-template-columns:minmax(0,1fr)}.v771-selected-list{max-height:190px;min-height:90px}.v771-recipient-options{max-height:190px}}
</style>
<script id="v770-data-mail-selection">
(function(){
 'use strict';
 const by=id=>document.getElementById(id);
 const safe=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const api=()=>typeof sb!=='undefined'?sb:null;
 const who=()=>typeof session!=='undefined'?session?.user?.id:null;
 let saveState=null,modalState=null,wait=0,submitting=false;
 function status(id,msg,ok){let el=by(id);if(el){el.textContent=msg;el.style.color=ok===false?'#ad2626':'#315676';}}
 function markup(data){
  const main=data?.destinatario_email||null;
  return (data?.correos||[]).map(c=>{
   const primary=c.email===main;
   const checked=!!(c.predeterminado||primary);
   const role=primary?'PARA · Obligatorio':c.archivo?'ARCHIVO · Copia':c.asignador?'DATA · Copia':(c.categoria||'OTRO');
   return '<label class="v770-choice" data-search="'+safe((c.nombre||'')+' '+c.email)+'" style="display:flex;gap:8px;align-items:center;padding:6px 5px;border-bottom:1px solid #eff2f6;font-size:12px;cursor:pointer">'+
   '<input type="checkbox" class="v770-checkbox" value="'+safe(c.email)+'" data-default="'+(checked?'1':'0')+'" '+(checked?'checked ':'')+(primary?'disabled ':'')+'style="flex-shrink:0">'+
   '<span><b>'+safe(c.nombre||c.email)+'</b> · <span style="word-break:break-all">'+safe(c.email)+'</span> <small style="color:#51647b">('+safe(role)+')</small></span></label>';
  }).join('');
 }
 function collect(container,data){
   if(!data?.destinatario_autorizado)throw Error('El abogado asignado no tiene un correo autorizado y único. Solicite actualizar el catálogo de correos.');
   const all=[...by(container).querySelectorAll('input.v770-checkbox:checked')].map(x=>x.value);
   if(!all.includes(data.destinatario_email))all.unshift(data.destinatario_email);
   if(all.length>20)throw Error('Puede seleccionar un máximo de 20 destinatarios.');
   return [...new Set(all)];
 }
 function renderSelected(sourceId,outputId,countId,data){
  const host=by(outputId), count=by(countId), source=by(sourceId);
  if(!host||!source)return;
  const all=[...source.querySelectorAll('input.v770-checkbox:checked')];
  const main=data?.destinatario_email||'';
  const chosen=[];
  for(const control of all){
   const email=control.value;
   const entry=(data?.correos||[]).find(c=>c.email===email);
   if(!entry || chosen.some(c=>c.email===email))continue;
   chosen.push(entry);
  }
  chosen.sort((a,b)=>Number(b.email===main)-Number(a.email===main));
  if(count)count.textContent=String(chosen.length);
  host.replaceChildren();
  if(!chosen.length){
   const empty=document.createElement('div');empty.className='v771-empty';
   empty.textContent=data?'No hay destinatarios seleccionados.':'Seleccione al abogado para cargar la lista.';
   host.appendChild(empty);return;
  }
  chosen.forEach(c=>{
    const isMain=c.email===main;
    const row=document.createElement('div');row.className='v771-selected-item';
    const person=document.createElement('div');person.className='v771-selected-person';
    const badge=document.createElement('span');badge.className='v771-selected-role';
    if(isMain)badge.dataset.main='true';
    badge.textContent=isMain?'PARA · Abogado':'CC · '+(c.archivo?'Archivo':c.asignador?'Data':(c.categoria||'Otro'));
    const name=document.createElement('strong');name.className='v771-selected-name';name.textContent=c.nombre||c.email;
    const address=document.createElement('small');address.className='v771-selected-email';address.textContent=c.email;
    person.append(badge,name,address);row.appendChild(person);
    if(isMain){
      const fixed=document.createElement('span');fixed.className='v771-selected-locked';fixed.textContent='Fijo';fixed.title='El abogado destinatario es obligatorio';row.appendChild(fixed);
    }else{
      const remove=document.createElement('button');remove.type='button';remove.className='v771-selected-remove';remove.textContent='×';
      remove.title='Quitar '+(c.nombre||c.email)+' de los correos seleccionados';
      remove.setAttribute('aria-label',remove.title);remove.dataset.v771RemoveEmail=c.email;row.appendChild(remove);
    }
    host.appendChild(row);
  });
 }
 function renderSave(){renderSelected('v770RecipientChoices','v771SelectedSave','v771CountSave',saveState);}
 function renderModal(){renderSelected('v770ModalChoices','v771SelectedModal','v771CountModal',modalState);}
 function removeOnRight(event,side){
  const button=event.target.closest('button[data-v771-remove-email]');
  if(!button)return;
  const listId=side==='save'?'v770RecipientChoices':'v770ModalChoices';
  const list=by(listId);
  const input=[...(list?.querySelectorAll('input.v770-checkbox')||[])].find(c=>c.value===button.dataset.v771RemoveEmail);
  if(!input || input.disabled)return;
  input.checked=false;
  input.dispatchEvent(new Event('change',{bubbles:true}));
 }
 function updateSummary(){
  renderSave();
  const msg=by('v770RecipientSummary');if(!msg||!saveState)return;
  try{const list=collect('v770RecipientChoices',saveState);
    msg.textContent='PARA: '+saveState.destinatario_email+' · CC: '+Math.max(0,list.length-1)+' correo(s).';
  }catch(e){msg.textContent=e.message;}
 }
 async function loadForSave(force){
   const select=by('v756Target'),target=select?.value||'';
   const stamp=++wait;
   if(!target){saveState=null;status('v770RecipientStatus','Seleccione al abogado para consultar los correos.',false);by('v770RecipientChoices').textContent='Sin abogado seleccionado.';updateSummary();return;}
   if(!force&&saveState?.destinatario_id===target)return saveState;
   saveState=null;renderSave();status('v770RecipientStatus','Consultando correos habilitados...',true);
   const client=api();if(!client)throw Error('No existe una conexión activa a Supabase.');
   const {data,error}=await client.rpc('v770_data_destinatarios_disponibles',{p_destinatario_id:target});
   if(error)throw error;
   if(stamp!==wait||select.value!==target)return null;
   saveState=data;
   const box=by('v770RecipientChoices');box.innerHTML=markup(data);
   renderSave();
   const isSender=data.correos.some(c=>c.asignador);
   const msg=(data.destinatario_autorizado?'Abogado principal: '+data.destinatario_email+'.':'El abogado no tiene correo de notificación autorizado.')+
    ' Se seleccionaron por defecto los correos activos de Archivo.'+(isSender?' También el trabajador de Data que asigna.':' El asignador no tiene correo autorizado; pida al administrador actualizar su vínculo.');
   status('v770RecipientStatus',msg,data.destinatario_autorizado);
   updateSummary();return data;
 }
 async function refreshForSave(){try{await loadForSave(true)}catch(e){saveState=null;status('v770RecipientStatus','No se pudieron cargar los destinatarios: '+(e?.message||e),false);by('v770RecipientChoices').textContent='No disponible';renderSave();}}
 window.v770FilterRecipients=function(id,value){const s=String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
   (by(id)?.querySelectorAll('.v770-choice')||[]).forEach(el=>{const x=(el.getAttribute('data-search')||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();el.style.display=x.includes(s)?'flex':'none';});};
 window.v770RestoreDefaults=function(){if(!saveState)return;by('v770RecipientChoices').querySelectorAll('input.v770-checkbox').forEach(el=>{el.checked=el.dataset.default==='1'});updateSummary();};
 window.v770RecipientsForSave=async function(target){
   if(!saveState||saveState.destinatario_id!==target)await loadForSave(true);
   if(!saveState||saveState.destinatario_id!==target)throw Error('No fue posible verificar los destinatarios seleccionados.');
   return collect('v770RecipientChoices',saveState);
 };
 let currentLot=null;
 window.v770CloseMailPicker=function(){if(submitting)return;by('v770MailModal').style.display='none';modalState=null;currentLot=null;};
 window.v770RestoreModalDefaults=function(){if(!modalState)return;by('v770ModalChoices').querySelectorAll('input.v770-checkbox').forEach(el=>el.checked=el.dataset.default==='1');renderModal();};
 window.v770OpenMailPicker=async function(lot,reenviar){
   currentLot={lot,re:!!reenviar};modalState=null;
   by('v770MailModal').style.display='flex';by('v770ModalChoices').textContent='Consultando correos autorizados...';renderModal();
   status('v770ModalSummary','Cargando datos del bloque...',true);status('v770ModalMessage','',true);
   by('v770ResendNote').style.display=reenviar?'block':'none';by('v770ResendReason').value='';
   try{
    const c=api();if(!c)throw Error('No hay conexión a Supabase.');
    const {data:items,error:listError}=await window.v841DataList(true);if(listError)throw listError;
    const group=(Array.isArray(items)?items:[]).filter(x=>x.lote_id===lot&&x.fuente==='V761_TRAMITE'&&x.asignador_id===who());
    if(!group.length)throw Error('No se encontró un bloque de Data registrado por su cuenta.');
    const target=group[0].destinatario_id;
    if(group.some(x=>x.destinatario_id!==target))throw Error('El bloque tiene diferentes responsables; no puede enviarse como un único correo.');
    const {data,error}=await c.rpc('v770_data_destinatarios_disponibles',{p_destinatario_id:target});if(error)throw error;
    if(currentLot?.lot!==lot)return;
    modalState=data;
    by('v770ModalChoices').innerHTML=markup(data);renderModal();
    const n=group.filter(x=>!['CANCELADA','REEMPLAZADA','RECHAZADA'].includes(x.estado)).length;
    status('v770ModalSummary','Bloque: '+n+' trámite(s) · Abogado: '+data.destinatario_nombre+' · PARA: '+(data.destinatario_email||'SIN CORREO')+'. Compruebe las copias antes de confirmar.',data.destinatario_autorizado);
    if(!data.destinatario_autorizado)status('v770ModalMessage','No se podrá enviar mientras el abogado no tenga correo autorizado.',false);
   }catch(e){modalState=null;status('v770ModalMessage','Error al consultar destinatarios: '+(e?.message||e),false);by('v770ModalChoices').textContent='Sin datos';renderModal();}
 };
 window.v770ConfirmMailPicker=async function(){
   if(!currentLot||!modalState||submitting)return;
   let emails;try{emails=collect('v770ModalChoices',modalState);}catch(e){status('v770ModalMessage',e.message,false);return;}
   let reason=null;if(currentLot.re){reason=by('v770ResendReason').value.trim();if(!reason){status('v770ModalMessage','Debe indicar por qué está reenviando este correo.',false);return;}}
   if(!window.confirm('¿Poner en cola un correo para '+modalState.destinatario_nombre+' y '+(emails.length-1)+' copia(s)? Verifique las direcciones antes de confirmar.'))return;
   const lot=currentLot.lot,re=currentLot.re;
   submitting=true;by('v770ModalConfirm').disabled=true;status('v770ModalMessage','Registrando aviso, espere...',true);
   try{
     const c=api();const {data,error}=await c.rpc('v770_data_encolar_lote',{p_lote_id:lot,p_correos:emails,p_reenviar:re,p_motivo:reason});if(error)throw error;
     // V772: solicitar despacho solo cuando se acaba de registrar un aviso nuevo.
     if(data?.encolado){
       try{window.v558ProgramarEnvioExterno?.();}catch(e){console.warn('V772: despacho pendiente',e);}
       setTimeout(()=>{try{window.v770CheckMail?.(lot);}catch(_){ }},11000);
     }
     const msg=data?.ya_existia?'Ya existía un correo para este bloque; no se duplicó. Consulte sus destinatarios registrados.':
      ('Correo en cola para '+(data?.destinatarios||[]).join(', ')+'. Estado: '+(data?.estado||'PENDIENTE'));
     const box=by('v769mail-'+lot);if(box){box.textContent=msg;box.style.color='#216843';}
     status('v770ModalMessage',msg,true);
     by('v770MailModal').style.display='none';currentLot=null;modalState=null;
   }catch(e){status('v770ModalMessage','No se pudo encolar el correo: '+(e?.message||e),false)}
   finally{submitting=false;by('v770ModalConfirm').disabled=false;}
 };
 window.v770CheckMail=async function(lot){
  const el=by('v769mail-'+lot);if(el)el.textContent='Consultando estado y destinatarios...';
  try{const c=api();const {data,error}=await c.rpc('v770_data_estado_lote',{p_lote_id:lot});if(error)throw error;
   const rows=(data?.destinatarios||[]).map(x=>x.email+' ('+x.estado+')');
   if(el){el.textContent='Estado del correo: '+(data?.estado||'SIN_CORREO')+'. Destinatarios: '+(rows.length?rows.join(' · '):'No hay correo registrado.');el.style.color=data?.estado==='ERROR'?'#a12a27':'#19613e';}
  }catch(e){if(el){el.textContent='No se pudo consultar el estado: '+(e?.message||e);el.style.color='#a12a27';}}
 };
 // Mantener la pantalla V769, pero interponer revisión manual antes de cualquier envío.
 window.v769SendMail=(lot,re)=>window.v770OpenMailPicker(lot,re);
 window.v769CheckMail=lot=>window.v770CheckMail(lot);
 by('v770RecipientChoices')?.addEventListener('change',updateSummary);
 by('v770ModalChoices')?.addEventListener('change',renderModal);
 by('v771SelectedSave')?.addEventListener('click',e=>removeOnRight(e,'save'));
 by('v771SelectedModal')?.addEventListener('click',e=>removeOnRight(e,'modal'));
 by('v756Target')?.addEventListener('change',refreshForSave);
 // V773: notificación obligatoria. No se ofrece desmarcar el aviso institucional.
 setTimeout(()=>{if(by('v756Target')?.value)refreshForSave();},700);
})();
</script>
<script id="v772-data-mail-queue-dispatch">
(function(){
  'use strict';
  let running=false;
  function by(id){return document.getElementById(id);}
  function info(message,good){
    const el=by('v772MailProcessStatus');if(!el)return;
    el.textContent=String(message||'');el.style.color=good?'#19613e':'#a12a27';
  }
  window.v772ProcesarCorreosData=async function(button){
    if(running)return;
    if(typeof window.v558ProcesarNotificacionesExternas!=='function'){
      info('El servicio de procesamiento de correos no está disponible. No se ha enviado ningún aviso.',false);return;
    }
    running=true;
    if(button)button.disabled=true;
    info('Solicitando al servicio el procesamiento de los correos pendientes...',true);
    try{
      const response=await window.v558ProcesarNotificacionesExternas(true);
      if(!response||response.ok===false){
        throw new Error(response?.error||'El servicio no confirmó el procesamiento. Los correos permanecen en la cola.');
      }
      info('Procesamiento solicitado. Compruebe el resultado mediante «Actualizar estado»; la cola no equivale a entrega.',true);
      try{await window.v769RefreshMailPanel?.();}catch(_){ }
      setTimeout(()=>{try{window.v769RefreshMailPanel?.();}catch(_){ }},5500);
    }catch(e){
      info('No se pudo confirmar el procesamiento: '+String(e?.message||e),false);
    }finally{
      running=false;if(button)button.disabled=false;
    }
  };
})();
</script><script id="v774-recepciones-logica">
// V774: Confirmaciones independientes de custodia, cargos y movimientos.
(function(){
  let rows=[];
  let selected=new Set();
  let busy=false;
  const E=id=>document.getElementById(id);
  const safe=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  const normalized=v=>String(v??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().trim();
  const dateFmt=v=>{
    if(!v)return '—';
    const dt=new Date(v);
    return isNaN(+dt)?'—':new Intl.DateTimeFormat('es-PE',{
      timeZone:'America/Lima',day:'2-digit',month:'2-digit',year:'numeric',
      hour:'2-digit',minute:'2-digit',hour12:true
    }).format(dt);
  };
  function me(){return String(session?.user?.id||'');}
  const canConfirm=r=>r.estado_recepcion==='PENDIENTE'&&!!me()&&r.destinatario_id===me();
  function filtered(){
    const q=normalized(E('v774Search')?.value||'');
    const t=E('v774Type')?.value||'';
    return rows.filter(r=>(!t||r.tipo===t)&&(!q||
      [r.expediente,r.extension,r.remitente_nombre,r.destinatario_nombre,r.cargo_numero,
       r.custodio_actual,r.tipo,r.estado_recepcion,r.observacion].some(k=>normalized(k).includes(q))));
  }
  function syncSelection(){
    const visible=filtered().filter(canConfirm);
    const all=visible.length>0&&visible.every(x=>selected.has(x.id));
    const toggle=E('v774SelectAll');
    if(toggle){toggle.checked=all;toggle.indeterminate=!all&&visible.some(x=>selected.has(x.id));toggle.disabled=busy||!visible.length;}
    if(E('v774SelectionCount'))E('v774SelectionCount').textContent=selected.size+' seleccionados';
    if(E('v774ConfirmSelected'))E('v774ConfirmSelected').disabled=busy||!selected.size;
  }
  function message(t,bad=false){const x=E('v774ReceiptsMessage');if(x){x.textContent=t;x.style.color=bad?'#b42318':'#1b5f47';}}
  window.v774RenderReceipts=function(){
    const target=E('v774ReceiptsList');if(!target)return;
    const visible=filtered();
    selected=new Set([...selected].filter(id=>rows.some(r=>r.id===id&&canConfirm(r))));
    if(!visible.length){
      target.innerHTML='<div class="empty" style="padding:25px">No se encontraron recepciones con estos filtros.</div>';
      syncSelection();return;
    }
    const body=visible.map(r=>{
      const ok=canConfirm(r);const confirmed=r.estado_recepcion==='CONFIRMADA';
      const chk=ok?`<input type="checkbox" aria-label="Seleccionar expediente ${safe(r.expediente)}" ${selected.has(r.id)?'checked':''} onchange="v774ToggleReceipt('${r.id}',this.checked)">`:'';
      const action=ok?`<button class="btn small" type="button" onclick="v774ConfirmOne('${r.id}')">Confirmar</button>`:'—';
      const history=r.expediente_id?`<button class="btn secondary small" type="button" onclick="showExpHistory('${r.expediente_id}','')">Historial</button>`:'';
      return `<tr><td>${chk}</td><td><strong>${safe(r.expediente)}</strong><div>${safe(r.extension||'—')}</div></td>
        <td>${safe(r.tipo==='ENTREGA_ARCHIVO'?'Entrega de Archivo':'Reasignación')}</td>
        <td>${safe(r.remitente_nombre||'—')}</td><td>${safe(r.destinatario_nombre||'—')}</td>
        <td>${safe(r.cargo_numero||'—')}</td><td>${safe(dateFmt(r.movimiento_at))}</td>
        <td><span class="v774-state">${safe(r.estado_recepcion)}</span>${confirmed?`<div>${safe(dateFmt(r.confirmado_at))}</div><div>${safe(r.confirmado_por_nombre||'')}</div><div>${safe(r.observacion||'')}</div>`:''}</td>
        <td style="white-space:nowrap">${action} ${history}</td></tr>`;
    }).join('');
    target.innerHTML=`<table><thead><tr><th></th><th>Expediente</th><th>Operación</th><th>Entregado por</th><th>Destinatario</th><th>Cargo</th><th>Movimiento</th><th>Recepción</th><th>Acciones</th></tr></thead><tbody>${body}</tbody></table>`;
    syncSelection();
  };
  window.v774ToggleReceipt=function(id,value){if(busy)return;if(value)selected.add(id);else selected.delete(id);syncSelection();};
  window.v774SelectVisible=function(all){if(busy)return;filtered().filter(canConfirm).forEach(r=>all?selected.add(r.id):selected.delete(r.id));v774RenderReceipts();};
  window.v774LoadReceipts=async function(){
    if(!sb||!session){message('Inicie sesión para consultar sus recepciones.',true);return;}
    if(busy)return;
    const mode=E('v774Status')?.value||'PENDIENTES';
    message('Consultando recepciones...');
    try{
      const {data,error}=await sb.rpc('v774_listar_recepciones',{p_filtro:mode});
      if(error)throw error;
      rows=Array.isArray(data)?data:[];
      selected.clear();
      const nPending=rows.filter(x=>x.estado_recepcion==='PENDIENTE').length;
      const nDone=rows.filter(x=>x.estado_recepcion==='CONFIRMADA').length;
      if(E('v774PendingCount'))E('v774PendingCount').textContent=mode==='CONFIRMADAS'?'—':String(nPending);
      if(E('v774ConfirmedCount'))E('v774ConfirmedCount').textContent=mode==='PENDIENTES'?'—':String(nDone);
      if(E('v774CounterTab')){
        E('v774CounterTab').textContent=mode==='PENDIENTES'?String(nPending):'•';
        E('v774CounterTab').classList.toggle('zero',mode==='PENDIENTES'&&!nPending);
      }
      v774RenderReceipts();
      message(rows.length+' registro(s) consultados. Solo el destinatario puede confirmar su propia recepción.');
    }catch(err){rows=[];selected.clear();v774RenderReceipts();message('No se pudo consultar recepciones: '+(err?.message||err),true);}
  };
  // V819 · Recepciones en lotes acotados; un único consentimiento para
  // todos los expedientes, pero la transacción y auditoría se hacen por bloque.
  // Ante un error individual de custodia se divide el bloque (sin confirmar
  // expedientes incorrectos). Ante fallos indeterminados no se reenvía:
  // se consulta la base antes de permitir un nuevo intento manual.
  async function confirm(ids){
    if(busy||!ids.length)return;
    if(!sb||!session){message('Inicie sesión para confirmar recepciones.',true);return;}
    const unique=[...new Set(ids)];
    const incoming=unique.filter(id=>rows.some(r=>r.id===id&&canConfirm(r)));
    if(incoming.length!==ids.length){
      message('Parte de la selección ya no está disponible. Actualice los resultados y vuelva a seleccionar.',true);
      return;
    }
    const total=incoming.length;
    if(!window.confirm(`¿Confirma que ha recibido físicamente ${total} expediente${total===1?'':'s'}?\n\nSe registrarán por bloques seguros, conservando usuario, fecha y hora. Esta confirmación no modificará los préstamos ni la custodia.`))return;
    const observation=E('v774Observation')?.value?.trim()||null;
    const BATCH_SIZE=75;
    const completed=new Set();
    const failed=[];
    let queued=0,groups=0,warnings=0,processedBlocks=0,activeChunk=0,abortReason='';
    const receiptById=new Map(rows.map(r=>[r.id,r]));
    const busyButton=E('v774ConfirmSelected');
    const originalLabel=busyButton?.textContent||'✓ Confirmar recepción seleccionados';
    const progress=E('v819ReceiptsProgress');
    function report(text){
      message(text);
      if(progress){progress.hidden=false;progress.max=total;progress.value=completed.size;}
      if(busyButton)busyButton.textContent=`Confirmando ${completed.size}/${total}…`;
    }
    const isIndividualError=err=>/custodia o el movimiento han cambiado|recepci[oó]n ya fue confirmada|recepci[oó]n seleccionada no existe|solo el destinatario puede confirmar|no existe|ya fue confirmada/i.test(String(err?.message||err));
    async function processBlock(batch){
      if(!batch.length||abortReason)return;
      processedBlocks++;
      report(`Confirmando ${completed.size} de ${total} recepción(es) · bloque ${activeChunk}/${Math.ceil(total/BATCH_SIZE)} (${batch.length} expediente(s))…`);
      try{
        const {data,error}=await sb.rpc('v775_confirmar_recepciones',{p_ids:batch,p_observacion:observation});
        if(error)throw error;
        if(!data?.ok||Number(data.confirmadas)!==batch.length)throw new Error('El servidor no confirmó la cantidad del bloque. Es necesario conciliar la bandeja antes de reintentar.');
        batch.forEach(id=>{
          completed.add(id);selected.delete(id);
          const item=receiptById.get(id);
          if(item){item.estado_recepcion='CONFIRMADA';item.confirmado_at=data.fecha_confirmacion||new Date().toISOString();}
        });
        queued+=Number(data.avisos_en_cola||0);
        groups+=Number(data.grupos||0);
        warnings+=Number(data.avisos_con_problemas||0);
        if(progress)progress.value=completed.size;
      }catch(err){
        if(batch.length>1&&isIndividualError(err)&&failed.length<20){
          // Falló un dato concreto: localizarlo, manteniendo transaccionales
          // las confirmaciones de todos los subbloques válidos.
          const half=Math.floor(batch.length/2);
          await processBlock(batch.slice(0,half));
          await processBlock(batch.slice(half));
          return;
        }
        if(batch.length===1&&isIndividualError(err)){
          const r=receiptById.get(batch[0]);
          failed.push({id:batch[0],expediente:r?.expediente||batch[0],causa:String(err?.message||err)});
          return;
        }
        abortReason=String(err?.message||err);
      }
    }
    busy=true;
    if(progress){progress.hidden=false;progress.max=total;progress.value=0;}
    syncSelection();
    try{
      for(let i=0;i<incoming.length&&!abortReason;i+=BATCH_SIZE){
        activeChunk=Math.floor(i/BATCH_SIZE)+1;
        await processBlock(incoming.slice(i,i+BATCH_SIZE));
        report(`Registradas ${completed.size} de ${total} recepción(es); ${failed.length} caso(s) requieren revisión.`);
      }
    }finally{
      busy=false;
      if(busyButton)busyButton.textContent=originalLabel;
      try{
        // Reconciliación con Supabase: no se vuelve a confirmar automáticamente
        // ningún expediente cuando una petición pudo haber terminado sin respuesta.
        const {data,error}=await sb.rpc('v774_listar_recepciones',{p_filtro:E('v774Status')?.value||'PENDIENTES'});
        if(error)throw error;
        rows=Array.isArray(data)?data:[];
        selected=new Set([...selected].filter(id=>rows.some(r=>r.id===id&&canConfirm(r))));
        const nPending=rows.filter(r=>r.estado_recepcion==='PENDIENTE').length;
        const nConfirmed=rows.filter(r=>r.estado_recepcion==='CONFIRMADA').length;
        if(E('v774PendingCount'))E('v774PendingCount').textContent=E('v774Status')?.value==='CONFIRMADAS'?'—':String(nPending);
        if(E('v774ConfirmedCount'))E('v774ConfirmedCount').textContent=E('v774Status')?.value==='PENDIENTES'?'—':String(nConfirmed);
        if(E('v774CounterTab'))E('v774CounterTab').textContent=String(nPending);
      }catch(e){abortReason+=(abortReason?' · ':'')+'No se pudo actualizar la bandeja: '+String(e?.message||e);}
      v774RenderReceipts();
      if(completed.size&&E('v774Observation')&&!selected.size)E('v774Observation').value='';
      const failMsg=failed.length?` Pendientes de revisión: ${failed.slice(0,5).map(f=>f.expediente).join(', ')}${failed.length>5?' y '+(failed.length-5)+' más':''}.`:'';
      message(`${completed.size} de ${total} recepción(es) confirmada(s). ${total-completed.size} sin confirmar.${failMsg}${abortReason?' Proceso detenido: '+abortReason:''} ${queued} grupo(s) de avisos en cola; ${warnings} aviso(s) con incidencia. Revise el historial antes de reintentar.`,Boolean(abortReason||failed.length||warnings));
      if(progress){progress.value=completed.size;progress.hidden=false;}
      try{window.v775RefreshReceiptsEmail?.();}catch(_){ }
      // Un solo procesamiento de la cola, tras confirmar todos los bloques.
      if(queued>0){Promise.resolve().then(async()=>{
        if(typeof window.v558ProcesarNotificacionesExternas==='function')await window.v558ProcesarNotificacionesExternas(true);
        await window.v775RefreshReceiptsEmail?.();
      }).catch(e=>console.warn('V819: los avisos continúan en cola',e?.message||e));}
    }
  }
  window.v774ConfirmOne=function(id){return confirm([id]);};
  window.v774ConfirmSelected=function(){return confirm([...selected]);};
  window.v774OpenReceipts=async function(btn){
    if(typeof switchTab==='function')switchTab('receipts',btn||document.querySelector('[data-tab="receipts"]'));
    await v774LoadReceipts();
  };
  // La consulta general de Historial integra las recepciones confirmadas sin
  // insertar movimientos adicionales ni alterar el control de préstamos.
  const v774OriginalLoadHistory=window.loadHistory;
  if(typeof v774OriginalLoadHistory==='function'){
    window.loadHistory=async function(...args){
      const result=await v774OriginalLoadHistory.apply(this,args);
      if(!sb||!session||typeof historyRows==='undefined')return result;
      try{
        const response=await sb.rpc('v774_listar_recepciones',{p_filtro:'CONFIRMADAS'});
        if(response.error||!Array.isArray(response.data))return result;
        const q=normalized(document.getElementById('historySearch')?.value||'');
        const extras=response.data.filter(r=>!q||
          [r.expediente,r.extension,r.remitente_nombre,r.destinatario_nombre,
           r.cargo_numero,r.observacion,'RECEPCIÓN CONFIRMADA'].some(x=>normalized(x).includes(q)))
         .map(r=>({
          created_at:r.confirmado_at,expediente:r.expediente,extension:r.extension,
          accion:'RECEPCIÓN CONFIRMADA POR DESTINATARIO',
          desde:r.remitente_nombre||'—',hacia:r.destinatario_nombre||'—',
          cargo:r.cargo_numero||'—',
          detalle:'Recibido y confirmado por '+(r.confirmado_por_nombre||r.destinatario_nombre||'—')+
            (r.observacion?' · '+r.observacion:'')
        }));
        if(extras.length){
          historyRows=[...historyRows,...extras].sort((a,b)=>
            String(b.created_at||'').localeCompare(String(a.created_at||''))).slice(0,500);
          if(document.getElementById('historyCount'))document.getElementById('historyCount').textContent=historyRows.length;
          renderHistory();
        }
      }catch(err){console.warn('V774: historial de recepciones no disponible',err?.message||err);}
      return result;
    };
  }
  // No se importan recepciones históricas de forma retroactiva: las nuevas
  // entregas y reasignaciones generan constancias desde la activación V774.
})();
</script>


<style id="v775-receipts-mail-styles">
#v775ReceiptMailSummary .v775-mail-row{border-bottom:1px solid #dce4ed;padding:10px 2px;display:flex;flex-wrap:wrap;gap:4px 12px;justify-content:space-between;align-items:center}
#v775ReceiptMailSummary .v775-mail-meta{font-size:11px;color:#55697e;margin-top:4px;overflow-wrap:anywhere}
#v775ReceiptMailSummary .v775-mail-state{font-size:11px;font-weight:700;padding:3px 8px;border-radius:12px;background:#eef3f8;color:#324e68;white-space:nowrap}
</style>
<script id="v775-receipts-mail-status">
(function(){
  'use strict';
  let ongoing=false;
  const esc=v=>String(v??'').replace(/[&<>"']/g,x=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[x]));
  const ts=v=>{try{return new Intl.DateTimeFormat('es-PE',{timeZone:'America/Lima',day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit',hour12:true}).format(new Date(v));}catch(_){return String(v||'');}};
  window.v775RefreshReceiptsEmail=async function(){
    const container=document.getElementById('v775ReceiptMailSummary');
    const details=document.getElementById('v775ReceiptMailFollowup');
    if(!container||!details||ongoing||!details.open)return;
    if(!sb||!session?.user?.id){container.textContent='Inicie sesión para ver el seguimiento.';return;}
    ongoing=true;container.textContent='Consultando el estado de los avisos...';
    try{
      const {data,error}=await sb.rpc('v775_listar_avisos_recepcion',{p_limite:35});
      if(error)throw error;
      const list=Array.isArray(data)?data:[];
      if(!list.length){container.textContent='Todavía no existen correos de recepción confirmada en este perfil.';return;}
      container.innerHTML=list.map(row=>{
        const sent=Number(row.destinatarios_enviados||0),total=Number(row.destinatarios_totales||0);
        const t=row.tipo==='ENTREGA_ARCHIVO'?'Entrega de Archivo':'Reasignación';
        const status=String(row.estado_correo||'PENDIENTE');
        return '<div class="v775-mail-row"><div style="min-width:220px;flex:1">'+
         '<strong>'+esc(t)+' · '+esc(row.expedientes)+' expediente(s)</strong>'+
         '<div class="v775-mail-meta">Confirmó: '+esc(row.confirmador_nombre)+' · Entregó: '+esc(row.remitente_nombre||'Archivo')+'</div>'+
         '<div class="v775-mail-meta">'+esc(ts(row.creado_at))+' · '+sent+' de '+total+' destinatarios aceptados por Gmail</div>'+
         (row.detalle_error?'<div class="v775-mail-meta">Observación: '+esc(row.detalle_error)+'</div>':'')+
         '</div><span class="v775-mail-state">'+esc(status)+'</span></div>';
      }).join('');
    }catch(err){container.textContent='No se pudo consultar el correo: '+(err?.message||err);}
    finally{ongoing=false;}
  };
  const details=document.getElementById('v775ReceiptMailFollowup');
  if(details)details.addEventListener('toggle',()=>{if(details.open)window.v775RefreshReceiptsEmail();});
})();
</script>
<!-- V776 · Navegación exclusiva: Expedientes por área / por usuario (base V775). -->
<style id="v776-unica-seleccion-areas-usuarios">
/* Conserva la apariencia institucional de las opciones sin agregados decorativos. */
.produce-nav #produceAreasWorkBtnV280:not(.active),
.produce-nav button[data-destination="panel"][data-nav-index]:not([data-nav-index="0"]):not(.active){
  background:transparent!important;
  box-shadow:none!important;
  color:#cfdae5!important;
}
.produce-nav #produceAreasWorkBtnV280:not(.active):hover,
.produce-nav button[data-destination="panel"][data-nav-index]:not([data-nav-index="0"]):not(.active):hover{
  background:#213e5d!important;
  color:#fff!important;
}
</style>
<script id="v776-menu-areas-usuarios-exclusivo">
(function(){
  'use strict';
  const AREA='produceAreasWorkBtnV280';
  const USER='button[data-destination="panel"][data-nav-index]:not([data-nav-index="0"])';
  let preference='';
  let timer=0;
  let busy=false;
  let lastActive='';
  const nav=()=>document.querySelector('.produce-nav');
  const areaBtn=()=>document.getElementById(AREA);
  const userBtn=()=>nav()?.querySelector(USER)||null;
  function areaFilter(){
    try{return typeof selectedAreaFilter!=='undefined'?String(selectedAreaFilter||'').trim():'';}
    catch(_){return '';}
  }
  function currentTab(){
    try{if(typeof currentVisibleTabName==='function')return String(currentVisibleTabName());}
    catch(_){ }
    const btn=document.querySelector('.main-sticky-header .tab.active[data-tab]');
    return btn?.dataset.tab||'';
  }
  function inDirectOwnerMode(){
    return document.body.classList.contains('v631-direct-owner')||
      !!document.querySelector('.app.v631-direct-owner');
  }
  function areaModalOpen(){
    return !!document.getElementById('workAreasModalV280')?.classList.contains('show');
  }
  function activeMode(){
    if(currentTab()!=='panel')return '';
    // V779 · Personal de mi área es una vista exclusiva del coordinador.
    // No marcar además Expedientes por área ni Expedientes por usuario.
    try{
      if(typeof isCoordinatorTeamWorkspaceV206==='function' &&
         isCoordinatorTeamWorkspaceV206())return '';
    }catch(_){ }
    if(areaModalOpen())return 'area';
    if(inDirectOwnerMode())return 'user';
    if(preference==='user')return 'user';
    if(preference==='area'&&areaFilter())return 'area';
    if(areaFilter())return 'area';
    return 'user';
  }
  function toggle(btn,on){
    if(!btn)return;
    if(btn.classList.contains('active')!==on)btn.classList.toggle('active',on);
    if(on){if(btn.getAttribute('aria-current')!=='page')btn.setAttribute('aria-current','page');}
    else if(btn.hasAttribute('aria-current'))btn.removeAttribute('aria-current');
  }
  function synchronize(){
    if(busy)return;
    const a=areaBtn(),u=userBtn();
    if(!a||!u)return;
    busy=true;
    try{
      const mode=activeMode();
      toggle(a,mode==='area');
      toggle(u,mode==='user');
      lastActive=mode;
    }finally{busy=false;}
  }
  function schedule(){
    if(timer)return;
    timer=setTimeout(()=>{timer=0;synchronize();},0);
  }
  function userFromAreaClear(){
    // Al entrar al explorador general por usuario se retira el filtro de área previo.
    // No se cambia el custodio, historial, registros ni ninguna consulta en Supabase.
    try{
      if(typeof selectedAreaFilter!=='undefined')selectedAreaFilter='';
    }catch(_){ }
  }
  document.addEventListener('click',e=>{
    const n=nav();if(!n)return;
    const b=e.target?.closest?.('button');
    if(b&&n.contains(b)){
      if(b.id===AREA){
        preference='area';
      }else if(b.matches(USER)){
        preference='user';
        userFromAreaClear();
      }else{
        // Las demás opciones no deben quedar visualmente activas por un filtro residual.
        if(b.dataset?.destination && b.dataset.destination!=='panel')preference='';
      }
      schedule();
      setTimeout(synchronize,120);
      return;
    }
    const card=e.target?.closest?.('[data-area-v280]');
    if(card){
      preference='area';
      schedule();
      setTimeout(synchronize,120);
    }else if(e.target?.closest?.('#workAreasModalV280')){
      schedule();
      setTimeout(synchronize,120);
    }
  },true);
  // Las vistas originales actualizan clases desde varios módulos: reconciliar
  // solo estas dos opciones, sin alterar los event handlers existentes.
  function install(){
    const n=nav();if(!n)return;
    const observer=new MutationObserver(schedule);
    observer.observe(n,{subtree:true,attributes:true,attributeFilter:['class'],childList:true});
    const section=document.getElementById('workAreasModalV280');
    if(section)new MutationObserver(schedule).observe(section,{attributes:true,attributeFilter:['class']});
    synchronize();
    window.addEventListener('pageshow',schedule);
    document.addEventListener('visibilitychange',()=>{if(!document.hidden)schedule();});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install,{once:true});
  else install();
  window.v776SyncActiveAreasUsers=synchronize;
  window.v776MenuVersion='V776';
})();
</script>
<!-- V777: El filtro de usuario y el detalle nunca muestran personas contradictorias. -->
<script id="v777-sincronizacion-usuario-filtrado">
(function(){
  'use strict';
  let seq=0;
  function normOwner(value){
    return String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toUpperCase();
  }
  function getOwner(){
    try{return typeof selectedOwner!=='undefined'?String(selectedOwner||'').trim():'';}
    catch(_){return '';}
  }
  function selectExists(name){
    try{
      if(typeof ownerCardsRows!=='undefined'&&Array.isArray(ownerCardsRows)){
        return ownerCardsRows.some(row=>normOwner(row?.nombre)===normOwner(name));
      }
    }catch(_){}
    return false;
  }
  function clearFormerDetail(){
    // No se altera la custodia ni se ejecutan operaciones en la base de datos.
    // Cuando se combinan filtros, la tarjeta es un resultado de búsqueda,
    // no debe mezclarse con el detalle de un usuario de una consulta previa.
    try{
      if(typeof isLimitedUser==='function'&&isLimitedUser())return;
      if(typeof selectedOwner!=='undefined')selectedOwner='';
      if(typeof panelQuickFilter!=='undefined')panelQuickFilter='';
      if(typeof page!=='undefined')page=0;
      const owner=document.getElementById('ownerSelect');if(owner)owner.value='';
      const name=document.getElementById('selectedOwnerDisplay');if(name)name.value='';
      if(typeof updateOwnerPanelVisibility==='function')updateOwnerPanelVisibility();
      if(typeof renderOwnerCards==='function')renderOwnerCards();
    }catch(error){console.warn('V777 · limpiar vista anterior:',error?.message||error);}
  }
  window.v777OnOwnerFilterChange=async function(select){
    const ticket=++seq;
    const name=String(select?.value||'').trim();
    const exp=String(document.getElementById('ownerCardsExpSearchV538')?.value||'').trim();
    const status=String(document.getElementById('ownerCardsStateSearchV538')?.value||'').trim();

    // Conserva el filtrado combinado original (expediente + estado + usuario).
    try{
      if(typeof applyOwnerTeamFilterV538==='function'){
        const result=applyOwnerTeamFilterV538(true);
        if(result?.catch)result.catch(err=>console.warn('V777 · filtro de tarjetas:',err?.message||err));
      }
    }catch(err){console.warn('V777 · filtro de tarjetas:',err?.message||err);}

    if(ticket!==seq)return;
    if(!name || exp || status){
      if(getOwner() && (!name || normOwner(getOwner())!==normOwner(name))){
        clearFormerDetail();
      }
      return;
    }
    if(!selectExists(name)){
      // Evitar búsquedas fuera del personal visible/autorizado.
      clearFormerDetail();
      return;
    }
    if(normOwner(getOwner())===normOwner(name)){
      const display=document.getElementById('selectedOwnerDisplay');
      if(display && display.value!==name)display.value=name;
      return;
    }

    // Seleccionar un nombre específico sin otros filtros equivale a abrir
    // su tarjeta de "Ver expedientes". Deja de mostrar el último usuario consultado.
    const display=document.getElementById('selectedOwnerDisplay');
    if(display)display.value=name;
    try{
      if(typeof openOwnerCustodyV215==='function'){
        await openOwnerCustodyV215(name);
      }else if(typeof openOwnerExpedientes==='function'){
        await openOwnerExpedientes(name,'custody');
      }
      if(ticket!==seq)return;
      if(display && normOwner(getOwner())===normOwner(name))display.value=name;
    }catch(error){
      console.warn('V777 · selección de usuario:',error?.message||error);
      if(ticket===seq){
        clearFormerDetail();
        if(typeof toast==='function')toast('No se pudo abrir el usuario seleccionado. Vuelva a intentarlo.');
      }
    }
  };
  window.v777Version='V777';
})();
</script>
<!-- V795: en las tarjetas de expedientes, Asunto muestra solo el asunto;
     se omiten resumen/motivo y boton de situación. La consulta sigue disponible
     en módulos especializados y la trazabilidad permanece intacta. -->
<!-- V784 · Consulta consolidada de situación del trámite; solo lectura, no modifica custodia. -->
<style id="v785-owner-area-style">
