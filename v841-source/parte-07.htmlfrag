 #v804Overlay .v808-mail-panel #v804Recipients.v807-recipient-list,
 #v804Overlay .v808-mail-panel #v808SelectedRecipients {height:205px;max-height:205px}
 #v804Overlay .v808-mail-panel {height:auto}
}
