<script id="v627-custody-rule-marker">
/* V627 · Regla única de custodia:
   - préstamo/entrega efectiva: reinicia;
   - reasignación efectiva: reinicia;
   - derivación a CONAS/DVC/Instrucción: reinicia;
   - retorno a Archivo u otra instancia: reinicia;
   - traslado físico a San Luis: reinicia;
   - solicitudes, ediciones y avisos: NO reinician.
   El conteo se expresa en días hábiles. */
</script>


