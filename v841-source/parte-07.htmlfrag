<style id="v634-hide-instructional-statuses">
/* V634 · Oculta microinstrucciones que comparten contenedores de estado.
   Los errores, resultados y bloqueos operativos permanecen visibles. */
.v634-helper-hidden{display:none!important;}
.modal-head p,
.modal-head > div > p,
.section-head p,
.section-subtitle,
.form-subtitle,
.panel-subtitle,
.micro-help,
.micro-instruction,
.inline-help,
.inline-hint{
  display:none!important;
}
</style>
<script id="v634-microtext-filter">
(()=>{
  const STATUS_IDS=[
    'requestLookupStatus','locationUnreadBanner','returnBulkStatus','rqSaveStatus','rqActionStatus',
    'accumStatus','adminCloseStatus','adminDeleteStatusV235','usersStatus','coordinatorTeamStatusV211',
    'archiveListBulkStatus','archiveListStatus','panelBulkReturnStatus','masterBulkReturnStatus',
    'v595ConasMailStatus','bulkConasStatus','conasReturnStatus','bulkDvcStatus','dvcReturnStatus',
    'bulkInstructionStatus','instructionReturnStatus','instructionRequestReturnStatus','v560MailAdminStatus',
    'v566ConfirmStatus','v572AttentionMailStatus','v626ReitStatus'
  ];

  const helperPatterns=[
    /^escriba\b/i,
    /^seleccione\b/i,
    /^busque\b/i,
    /^pulsa(?:r)?\b/i,
    /^pulse\b/i,
    /^haga clic\b/i,
    /^puede (?:buscar|seleccionar|combinar|agregar|usar|filtrar|continuar)\b/i,
    /^utilice\b/i,
    /^use el formato\b/i,
    /^cada nuevo pedido\b/i,
    /^opcional\b/i,
    /^predeterminados del sistema\b/i,
    /^importante\b/i,
    /^aún no ha agregado\b/i,
    /^todavía no ha agregado\b/i,
    /^la extensión es obligatoria\b/i,
    /^reasignación directa\s*[·:-]/i,
    /^el expediente está actualmente con\b/i,
    /^el expediente está derivado a instrucción\b/i,
    /^el ciclo anterior ya está cerrado\b/i,
    /haga clic en cualquier parte de la fila/i,
    /puede seleccionar el expediente/i,
    /para continuar con la solicitud/i,
    /antes de continuar/i,
    /esta vista permite/i,
    /se enviará un solo correo/i,
    /el correo del usuario actual/i
  ];

  // Frases que deben conservarse aunque contengan verbos de acción.
  const operationalPatterns=[
    /no se (?:pudo|puede|encontraron|detectaron)/i,
    /error/i,
    /fall[oó]/i,
    /ya est[aá] agregado/i,
    /no est[aá] disponible/i,
    /requiere/i,
    /bloquead/i,
    /procesando/i,
    /guardando/i,
    /enviando/i,
    /leyendo excel/i,
    /revalidado correctamente/i,
    /registrad[oa]/i,
    /confirmad[oa]/i,
    /completad[oa]/i,
    /atendid[oa]/i
  ];

  function classify(el){
    if(!el) return;
    const t=(el.textContent||'').replace(/\s+/g,' ').trim();
    if(!t){ el.classList.add('v634-helper-hidden'); return; }
    const operational=operationalPatterns.some(rx=>rx.test(t));
    const helper=helperPatterns.some(rx=>rx.test(t));
    el.classList.toggle('v634-helper-hidden', helper && !operational);
  }

  function bind(el){
    if(!el || el.dataset.v634Bound==='1') return;
    el.dataset.v634Bound='1';
    classify(el);
    new MutationObserver(()=>classify(el)).observe(el,{childList:true,subtree:true,characterData:true});
  }

  function boot(){
    STATUS_IDS.forEach(id=>bind(document.getElementById(id)));
    document.querySelectorAll('.v588-digital-mail-status,.v595-conas-mail-status,[role="status"]')
      .forEach(bind);
  }

  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot,{once:true});
  else boot();
})();
</script>


