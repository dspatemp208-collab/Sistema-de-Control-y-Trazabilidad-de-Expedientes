<style id="v688-pending-location-style">
#stateDetailTable th.v688-location-col,
#stateDetailTable td.v688-location-col{min-width:178px;max-width:215px;vertical-align:middle}
.v688-location-cell{display:flex;flex-direction:column;gap:3px;line-height:1.18}
.v688-location-cell .pill{align-self:flex-start;white-space:normal;text-align:left}
.v688-location-cell .v688-location-status{font-weight:700;color:#175c35}
.v688-location-cell small{color:#5f6f82}
.v688-location-empty{color:#6b7280;font-size:12px}
.v688-location-btn{white-space:nowrap}
@media(max-width:1100px){#stateDetailTable th.v688-location-col,#stateDetailTable td.v688-location-col{min-width:160px}}
</style>
<script id="v688-pending-location-script">
/* V688 · Ubicación/comunicación visible en PENDIENTE POR ATENDER */
let v688PendingLocationMap=new Map();
let v688PendingLocationSeq=0;
let v688PendingLocationCacheKey='';
let v688PendingLocationInFlightKey='';
let v688PendingLocationErrorKey='';
let v688PendingLocationLoadedAt=0;

function v688PendingLocationHtml(notice){
  if(!notice)return '<span class="v688-location-empty">Sin comunicación</span>';
  const read=notice.leida_at?'Leído por solicitante':'Pendiente de lectura';
  return `<div class="v688-location-cell" title="${esc(notice.observacion||'')}">
    <span class="pill returned">📍 ${esc(notice.sede||'UBICACIÓN VERIFICADA')}</span>
    <div class="v688-location-status">✓ Comunicado · ${fmtDate(notice.created_at)} ${fmtTime(notice.created_at)}</div>
    <small>${esc(notice.verificado_nombre||'—')} · ${esc(read)}</small>
  </div>`;
}

function v688PaintPendingLocationCells(){
  document.querySelectorAll('#stateDetailTable [data-v688-pending-location]').forEach(cell=>{
    const exp=String(cell.dataset.v688PendingLocation||'');
    const req=String(cell.dataset.v688Request||'');
    cell.innerHTML=v688PendingLocationHtml(v688PendingLocationMap.get(exp+'|'+req));
    cell.removeAttribute('aria-busy');
  });
}

async function loadPendingLocationNoticesV688(force=false){
  // V740: cargar la información de TODA la bandeja, no solo de las filas visibles;
  // de otro modo el filtro SAN LUIS no podría encontrar filas ocultas por el propio filtro.
  if(!sb||!session)return;
  const uid=session.user.id;
  const allRows=pendingAttentionRows||[];
  const pairs=new Set(allRows.map(row=>v740PendingNoticePair(row)).filter(k=>k!=='|'));
  const expIds=[...new Set(allRows.map(row=>String(row?.expediente_id||'')).filter(Boolean))].sort();
  const cacheKey=v740PendingNoticeCacheKey();
  if(!force && v688PendingLocationCacheKey===cacheKey && (Date.now()-v688PendingLocationLoadedAt)<90000){v688PaintPendingLocationCells();return;}
  if(!force && v688PendingLocationInFlightKey===cacheKey)return;
  const seq=++v688PendingLocationSeq;
  v688PendingLocationInFlightKey=cacheKey;
  v688PendingLocationErrorKey='';
  const latest=new Map();
  try{
    for(let i=0;i<expIds.length;i+=100){
      for(let offset=0;;offset+=500){
        const {data,error}=await sb.from('avisos_ubicacion_verificada')
          .select('id,expediente_id,solicitud_id,sede,created_at,verificado_nombre,observacion,leida_at')
          .in('expediente_id',expIds.slice(i,i+100))
          .order('created_at',{ascending:false}).order('id').range(offset,offset+499);
        if(seq!==v688PendingLocationSeq||session?.user?.id!==uid)return;
        if(error)throw error;
        for(const notice of data||[]){
          const key=String(notice.expediente_id||'')+'|'+String(notice.solicitud_id||'');
          if(pairs.has(key)&&!latest.has(key))latest.set(key,notice);
        }
        if(!data||data.length<500)break;
      }
    }
    if(seq!==v688PendingLocationSeq||session?.user?.id!==uid)return;
    v688PendingLocationMap=latest;
    v688PendingLocationCacheKey=cacheKey;
    v688PendingLocationLoadedAt=Date.now();
    v688PendingLocationErrorKey='';
    v740RefreshLocationChoices();
    if(selectedState==='PENDIENTE POR ATENDER' && el('v740PendingCommunicationFilter')?.value){
      renderPendingAttentionRows();
    }else{
      v688PaintPendingLocationCells();
    }
  }catch(error){
    if(seq!==v688PendingLocationSeq||session?.user?.id!==uid)return;
    v688PendingLocationErrorKey=cacheKey;
    document.querySelectorAll('#stateDetailTable [data-v688-pending-location]').forEach(cell=>{
      cell.innerHTML='<span class="v688-location-empty">No disponible</span>';
      cell.title=locationNoticeError(error);
      cell.removeAttribute('aria-busy');
    });
    if(selectedState==='PENDIENTE POR ATENDER' && el('v740PendingCommunicationFilter')?.value){
      renderPendingAttentionRows();
    }
    console.warn('V740 · comunicaciones en pendientes:',error);
  }finally{
    if(seq===v688PendingLocationSeq)v688PendingLocationInFlightKey='';
  }
}
window.loadPendingLocationNoticesV688=loadPendingLocationNoticesV688;

function openPendingLocationV688(index){
  if(!hasFullAccess()||isCoordinator())return;
  const row=(pendingAttentionVisibleRows||[])[Number(index)]||(pendingAttentionRows||[])[Number(index)];
  if(!row){showToast('No se pudo identificar el expediente pendiente.');return;}
  const requestId=String(row.solicitud_id||'').trim();
  if(!requestId){showToast('No se pudo identificar la solicitud del expediente.');return;}
  const itemState=norm(row.estado_item||'ACEPTADO');
  if(!['SOLICITADO','ACEPTADO','PENDIENTE POR ATENDER'].includes(itemState)){
    showToast(`El expediente ya no está pendiente de atención. Estado actual: ${row.estado_item||'—'}.`);
    return;
  }
  const ctxRow={...row,estado_item:itemState==='PENDIENTE POR ATENDER'?'ACEPTADO':(row.estado_item||'ACEPTADO')};
  openLocationNotice({
    id:requestId,
    header:{numero:row.solicitud_numero||'',solicitante:row.solicitante||''},
    rows:[ctxRow],
    __v688PendingDirect:true
  });
}
window.openPendingLocationV688=openPendingLocationV688;

// Tras comunicar una ubicación, refrescar inmediatamente la columna de la bandeja.
if(typeof window.sendLocationNotice==='function'){
  const v688OriginalSendLocationNotice=window.sendLocationNotice;
  window.sendLocationNotice=async function(...args){
    const result=await v688OriginalSendLocationNotice.apply(this,args);
    v688PendingLocationCacheKey='';
    try{await loadPendingLocationNoticesV688(true);}catch(_){ }
    return result;
  };
}

// Al reconstruir la bandeja, invalidar solo la vista si cambió de perfil/solicitud.
window.addEventListener('focus',()=>{
  if(selectedState==='PENDIENTE POR ATENDER'&&document.querySelector('#stateDetailTable [data-v688-pending-location]')){
    loadPendingLocationNoticesV688(false);
  }
},{passive:true});
</script>

