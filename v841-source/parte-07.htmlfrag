#requestExcelResults .request-owner-current .v785-owner-area{
  display:block;margin-top:4px;font-size:10px;font-weight:600;
  color:#506b83;line-height:1.35;white-space:normal;
}
#requestLookupResults .pill.returned{display:inline-block;max-width:150px;white-space:normal;text-align:center;}
</style>
<style id="v784-style">
.v784-search-cell{min-width:170px;max-width:250px;vertical-align:middle}
.v784-inline-area{margin-top:4px;line-height:1.35}
.v784-summary{display:block;font-size:10px;color:#536b83;line-height:1.45;max-width:250px;white-space:normal}
.v784-tag{display:inline-block;border-radius:7px;background:#edf3fa;padding:3px 6px;border:1px solid #d6e4f1;color:#163c64;font-size:10px;font-weight:800;line-height:1.35;white-space:normal}
.v784-tag.v784-wait{background:#fff2db;border-color:#f2dba8;color:#79500c}
.v784-tag.v784-done{background:#e8f7ee;border-color:#b5decb;color:#146343}
.v784-light{color:#5c6c7f;font-size:10px}
.v784-summary button{display:inline-block;margin-top:4px;padding:3px 7px;border:1px solid #a7c5e4;border-radius:6px;background:#fff;color:#15528a;font-size:10px;font-weight:700;cursor:pointer}
#v784Overlay{display:none;position:fixed;inset:0;z-index:2147483590;background:rgba(5,20,42,.63);justify-content:center;align-items:center;padding:14px;box-sizing:border-box}
#v784Overlay.v784-open{display:flex}
#v784Overlay .v784-modal-box{width:min(850px,100%);max-height:min(90vh,930px);overflow:auto;background:#fff;color:#1a314d;border-radius:13px;border:1px solid #d1e1f0;box-shadow:0 18px 50px #091e3740;padding:18px}
#v784Overlay .v784-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;border-bottom:1px solid #d6e4f1;padding-bottom:10px;margin-bottom:10px}
#v784Overlay h2{font:800 17px Arial,sans-serif;margin:0;color:#173f6b}
#v784Overlay .v784-close,#v784Overlay .v784-refresh{border:1px solid #b6d0e7;border-radius:7px;background:white;padding:7px 10px;color:#11436f;font-weight:700;cursor:pointer}
#v784Overlay .v784-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:11px 0}
#v784Overlay .v784-meta>div{background:#f1f6fc;border:1px solid #d4e1ef;border-radius:8px;padding:10px;min-width:0;overflow-wrap:anywhere}
#v784Overlay .v784-meta small{color:#52657a;display:block;margin-bottom:4px}
#v784Overlay .v784-doc{border:1px solid #d4e2ef;border-left:4px solid #2772ac;padding:10px 12px;border-radius:7px;margin:9px 0}
#v784Overlay .v784-doc .v784-doc-title{font-weight:800;color:#1d446e;margin-bottom:6px}
#v784Overlay .v784-doc p{font-size:12px;color:#486078;margin:6px 0}
#v784Overlay .v784-note{font-size:11px;color:#596b81;margin:8px 0}
@media(max-width:650px){#v784Overlay .v784-meta{grid-template-columns:1fr}#v784Overlay .v784-modal-box{padding:12px}}
</style>
<div id="v784Overlay" role="dialog" aria-modal="true" aria-label="Situación del trámite" aria-hidden="true">
  <div class="v784-modal-box">
    <div class="v784-head"><div><h2 id="v784Title">Situación actual del trámite</h2><div class="v784-note">Consulta informativa de solo lectura. No modifica la custodia.</div></div><div style="display:flex;gap:5px"><button class="v784-refresh" type="button" id="v784Refresh">Actualizar</button><button class="v784-close" type="button" id="v784Close">Cerrar</button></div></div>
    <div id="v784Content">Consultando información vigente...</div>
  </div>
</div>
<script id="v784-script">
(()=>{
 'use strict';
 const root=document.getElementById('v784Overlay');
 const $=id=>document.getElementById(id);
 const safe=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const labels={EN_REVISION:'En revisión',PENDIENTE_NOTIFICACION:'Pendiente de notificación',EN_PROCESO_NOTIFICACION:'En proceso de notificación',EN_ESPERA_CARGO_ORIGINAL:'En espera del cargo original',CARGO_ORIGINAL_RECIBIDO:'Cargo original recibido',ACTIVIDAD_FINALIZADA:'Actividad finalizada'};
 const makeDate=value=>{if(!value)return '—';const str=String(value);if(/^\d{4}-\d{2}-\d{2}$/.test(str)){const p=str.split('-');return p[2]+'/'+p[1]+'/'+p[0]};const d=new Date(str);return Number.isNaN(d.getTime())?'—':d.toLocaleString('es-PE',{timeZone:'America/Lima',dateStyle:'short',timeStyle:'short'});};
 const validUUID=id=>/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(String(id||''));
 const statusTag=s=>'<span class="v784-tag '+(s==='EN_ESPERA_CARGO_ORIGINAL'?'v784-wait':s==='ACTIVIDAD_FINALIZADA'||s==='CARGO_ORIGINAL_RECIBIDO'?'v784-done':'')+'">'+safe(labels[s]||s||'Situación no informada')+'</span>';
 const cache=new Map(),pending=new Map();let authKey='',openId='',listTimer=null,openSequence=0;
 function ensureSession(){const user=String(typeof session!=='undefined'?session?.user?.id||'':'');if(user!==authKey){cache.clear();pending.clear();authKey=user;}return !!user;}
 function rowsById(ids,force=false){
   if(!ensureSession()||typeof sb==='undefined'||!sb)return Promise.resolve([]);
   const missing=ids.filter(id=>validUUID(id)&&(force||!cache.has(id)||Date.now()-cache.get(id).time>25000));
   if(!missing.length)return Promise.resolve(ids.map(id=>cache.get(id)?.value).filter(Boolean));
   const unique=[...new Set(missing)];
   const groups=[];for(let i=0;i<unique.length;i+=80)groups.push(unique.slice(i,i+80));
   return Promise.all(groups.map(async group=>{
     const key=group.slice().sort().join(',');if(pending.has(key))return pending.get(key);
     const run=(async()=>{
       const {data,error}=await sb.rpc('v784_consultar_situaciones',{p_expediente_ids:group});
       if(error)throw error;
       const arr=Array.isArray(data)?data:[];
       for(const x of arr){if(validUUID(x?.expediente_id))cache.set(x.expediente_id,{time:Date.now(),value:x});}
       for(const id of group){if(!cache.has(id))cache.set(id,{time:Date.now(),value:null});}
       return arr;
     })();pending.set(key,run);
     try{return await run}finally{pending.delete(key)}
   })).then(()=>ids.map(id=>cache.get(id)?.value).filter(Boolean));
 }
 function summaryHtml(info,id){
   if(!info)return '<span class="v784-light">Sin información disponible.</span>';
   const acts=Array.isArray(info.actividades)?info.actividades:[];
   const motivo='<span class="v784-light">Motivo: '+safe(info.motivo_atencion?String(info.motivo_atencion).slice(0,78):'No registrado')+'</span>';
   if(!acts.length)return '<span class="v784-light">Situación del trámite no informada.</span><br>'+motivo+
      '<br><button type="button" data-v784-show="'+safe(id)+'">Ver situación</button>';
   const priority=acts.find(a=>['EN_ESPERA_CARGO_ORIGINAL','EN_REVISION','PENDIENTE_NOTIFICACION','EN_PROCESO_NOTIFICACION'].includes(a.situacion))||acts[0];
   const intro=acts.length>1?'<span class="v784-light">'+acts.length+' actividades documentales</span><br>':'';
   return intro+statusTag(priority.situacion)+'<br>'+motivo+'<br><button type="button" data-v784-show="'+safe(id)+'">Ver situación</button>';
 }
 async function hydrate(){
   if(!ensureSession())return;
   // V795: no insertar resúmenes documentales dentro de las tarjetas de expedientes.
   // La consulta de situación continúa disponible en sus módulos especializados.
   const els=[...document.querySelectorAll('#requestLookupResults [data-v784-id]')];
   // V785: reutilizar el mismo lote de consulta, sin una segunda petición de área.
   const areaEls=[...document.querySelectorAll('#requestLookupResults [data-v785-owner-id],#requestExcelResults [data-v785-owner-id]')];
   const ids=[...new Set([...els.map(e=>e.dataset.v784Id),...areaEls.map(e=>e.dataset.v785OwnerId)].filter(validUUID))];
   if(!ids.length)return;
   try{const info=await rowsById(ids);const byId=new Map(info.map(x=>[x.expediente_id,x]));
     for(const node of els){if(!node.isConnected)continue;const id=node.dataset.v784Id;node.innerHTML=summaryHtml(byId.get(id),id);}
     for(const node of areaEls){
       if(!node.isConnected)continue;
       const area=String(byId.get(node.dataset.v785OwnerId)?.area_trabajo||'').trim();
       if(area)node.textContent='Área: '+area;
     }
   }catch(e){for(const node of els){if(node.isConnected)node.innerHTML='<span class="v784-light">Situación temporalmente no disponible.</span><br><button type="button" data-v784-show="'+safe(node.dataset.v784Id)+'">Reintentar</button>';}}
 }
 function schedule(){clearTimeout(listTimer);listTimer=setTimeout(hydrate,90)}
 function renderDetail(info){
   if(!info){$('v784Content').textContent='No se encontró información de este expediente.';return;}
   $('v784Title').textContent='Expediente '+(info.expediente||'')+(info.extension?' · '+info.extension:'');
   const meta=[['Responsable actual',info.responsable_actual||'No informado'],['Área de trabajo',info.area_trabajo||'No informada'],['Estado vigente de custodia',info.estado_visible||info.estado_custodia||'No informado'],['Motivo de atención',info.motivo_atencion||'Motivo no registrado']];
   const blocks=meta.map(([label,value])=>'<div><small>'+safe(label)+'</small><strong>'+safe(value)+'</strong></div>').join('');
   const acts=Array.isArray(info.actividades)?info.actividades:[];
   const actHtml=acts.length?acts.map(a=>'<div class="v784-doc"><div class="v784-doc-title">'+safe(a.tipo_documento||'Documento')+(a.referencia_documento?' · '+safe(a.referencia_documento):'')+'</div>'+statusTag(a.situacion)+
      '<p>Notificado: '+safe(makeDate(a.fecha_notificacion))+' · Cargo original recibido: '+safe(makeDate(a.fecha_cargo_original))+'</p><p>Última actualización: '+safe(makeDate(a.updated_at))+' · Registrado por: '+safe(a.responsable_ultima_actualizacion||'No identificado')+'</p></div>').join(''):'<p class="v784-note">No se ha registrado una actividad de Notificaciones para este expediente. No se asigna un estado supuesto.</p>';
   $('v784Content').innerHTML='<div class="v784-meta">'+blocks+'</div><h3 style="margin:13px 0 7px;font-size:14px;color:#183e68">Situación documental actual</h3>'+actHtml+'<p class="v784-note">La actividad documentada se presenta por IFI, RD u otro documento; el historial anterior se conserva en su módulo de origen. El estado de préstamo no cambia por consultar esta información.</p>';
 }
 async function open(id,force=true){
   if(!validUUID(id))return;
   openId=id;const seq=++openSequence;root.classList.add('v784-open');root.setAttribute('aria-hidden','false');
   $('v784Title').textContent='Situación actual del trámite';$('v784Content').textContent='Consultando información vigente...';
   try{const data=await rowsById([id],force);if(seq!==openSequence)return;renderDetail(data.find(x=>x.expediente_id===id));}
   catch(e){if(seq===openSequence)$('v784Content').textContent='No fue posible consultar la situación: '+String(e?.message||e);}
 }
 function close(){++openSequence;openId='';root.classList.remove('v784-open');root.setAttribute('aria-hidden','true');}
 window.v784OpenDetalle=open;window.v784RefrescarResumen=hydrate;
 $('v784Close').addEventListener('click',close);
 $('v784Refresh').addEventListener('click',()=>{if(openId)open(openId,true)});
 root.addEventListener('click',e=>{if(e.target===root)close();});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&root.classList.contains('v784-open')){e.stopPropagation();close();}},true);
 document.addEventListener('click',e=>{const btn=e.target.closest?.('[data-v784-show]');if(btn){e.stopPropagation();e.preventDefault();open(btn.dataset.v784Show,true);}},true);
 function start(){for(const id of ['requestLookupResults','requestExcelResults']){
    const target=$(id);if(target){const obs=new MutationObserver(schedule);obs.observe(target,{childList:true});}}
   schedule();
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();
})();
</script>
<style id="v788-access-regularization-style">
/* V788: una solicitud abierta queda bajo la ventana de acumulados. */
html body #acumuladosModal.modal {z-index:550!important;}
html body #acumuladosModal.modal.show {z-index:550!important;}
#v788Entry.v788-regularize-entry{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;background:#f0f6ff;border:1px solid #b7d3f6;border-radius:9px;padding:11px 13px;margin:11px 0 14px;box-sizing:border-box}
#v788Entry[hidden]{display:none!important}
#v788Entry .v788-regularize-copy{flex:1;min-width:220px;color:#183b62}
#v788Entry .v788-regularize-copy strong{display:block;font-size:13px;margin-bottom:4px}
#v788Entry .v788-regularize-copy .note{font-size:11px;line-height:1.45}
#v788Entry button{white-space:normal;text-align:center}
#v788PrincipalPicker{position:fixed;inset:0;z-index:490;background:rgba(11,29,49,.67);display:flex;align-items:center;justify-content:center;padding:18px;box-sizing:border-box}
#v788PrincipalPicker[hidden]{display:none!important}
#v788PrincipalPicker .v788-picker-content{width:min(620px,100%);max-height:90vh;overflow:auto;background:white;border-radius:12px;border:1px solid #bbd3ea;box-shadow:0 22px 70px rgba(0,0,0,.28);padding:20px;color:#233b57}
#v788PrincipalPicker .v788-picker-head{display:flex;gap:8px;align-items:center;justify-content:space-between}
#v788PrincipalPicker h2{font-size:18px;color:#173d67;margin:0}
#v788PrincipalPicker p{font-size:13px;line-height:1.5;margin:12px 0}
#v788PrincipalPicker select{display:block;width:100%;min-height:43px;margin:8px 0;border:1px solid #a9c6e2;border-radius:8px;background:white;color:#233b57;padding:9px;font-size:13px}
#v788PrincipalPicker .note{margin-top:8px;font-size:11px}
#v788PrincipalPicker .v788-picker-actions{display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap;margin-top:18px}
@media(max-width:720px){#v788Entry button{width:100%}#v788PrincipalPicker .v788-picker-actions button{flex:1}}
</style>
<script id="v788-direct-entry-script">
(function(){
 'use strict';
 const get=id=>document.getElementById(id);
 const safe=s=>typeof esc==='function'?esc(String(s??'')):String(s??'').replace(/[&<>"']/g,x=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[x]));
 function admin(){return typeof isAdmin==='function'&&isAdmin();}
 function entries(){
  const values=typeof requestDetailRows!=='undefined'&&Array.isArray(requestDetailRows)?requestDetailRows:[];
  const seen=new Set();
  return values.filter(row=>{
    const id=String(row?.expediente_id||'');
    if(!/^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$/i.test(id)||seen.has(id))return false;
    seen.add(id);return true;
  });
 }
 function open(){
  if(!admin())return;
  if(!get('requestDetailModal')?.classList.contains('show'))return;
  const rows=entries();
  const picker=get('v788PrincipalPicker'), select=get('v788PrincipalSelect');
  if(!picker||!select||!rows.length)return;
  select.innerHTML='<option value="">— SELECCIONE EL EXPEDIENTE PRINCIPAL —</option>'+rows.map(r=>
    '<option value="'+safe(r.expediente_id)+'">'+safe(r.expediente||'—')+' · '+safe(r.extension||'SIN EXTENSIÓN')+' · '+safe(r.estado_item||r.estado||'')+'</option>'
  ).join('');
  const selected=rows.filter(r=>typeof requestSelectedIds!=='undefined'&&requestSelectedIds.has(r.expediente_id));
  if(selected.length===1)select.value=selected[0].expediente_id;
  else if(rows.length===1)select.value=rows[0].expediente_id;
  get('v788PickerNote').textContent=selected.length>1
   ?'Hay '+selected.length+' expedientes marcados. Elija cuál es el principal; no necesita desmarcar los demás.'
   :'Seleccione el expediente principal y continúe. La selección original se conservará.';
  picker.hidden=false;
  select.focus();
 }
 function close(){const picker=get('v788PrincipalPicker');if(picker)picker.hidden=true;}
 async function next(){
  if(!admin())return;
  const id=get('v788PrincipalSelect')?.value||'';
  const row=entries().find(x=>x.expediente_id===id);
  const note=get('v788PickerNote');
  if(!row){if(note)note.textContent='Seleccione primero el expediente principal.';return;}
  if(!currentRequestId){if(note)note.textContent='No se identificó la solicitud abierta.';return;}
  const requestId=currentRequestId;
  close();
  try{
    await openAccumulatedModal(row.expediente_id,requestId,row.expediente||'',row.extension||'');
    const section=get('v787Section');
    if(!section||section.hidden){throw new Error('No se habilitó el panel de regularización. Compruebe el perfil Administrador.');}
    section.scrollIntoView({block:'center',behavior:'instant'});
    get('v787Find')?.focus({preventScroll:true});
  }catch(e){
    if(typeof showToast==='function')showToast('No se pudo abrir la regularización: '+String(e?.message||e));
    else alert('No se pudo abrir la regularización: '+String(e?.message||e));
  }
 }
 window.v788OpenRegularizationPicker=open;
 window.v788CloseRegularizationPicker=close;
 window.v788ContinueRegularization=next;
 get('v788PrincipalPicker')?.addEventListener('click',e=>{if(e.target?.id==='v788PrincipalPicker')close();});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!get('v788PrincipalPicker')?.hidden)close();});
})();
</script>

<!-- V789: completar extensión del mismo registro físico, sin alterar préstamos ni movimientos -->
<style>
#v789Modal{z-index:20030}
#v789Modal .modal-box{max-width:690px;width:min(96vw,690px)}
#v789Modal .v789-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:12px 0}
#v789Modal .v789-meta>div{border:1px solid #cddcf0;background:#f4f8fd;border-radius:8px;padding:9px;min-width:0}
#v789Modal .v789-meta small{display:block;color:#506980;margin-bottom:3px}
#v789Modal .v789-meta strong{overflow-wrap:anywhere}
#v789Modal .v789-note{padding:10px;border:1px solid #bfd8ef;background:#eff6fc;border-radius:8px;font-size:13px;line-height:1.5}
#v789Modal textarea{width:100%;min-height:80px}
#v789Modal .v789-actions{display:flex;gap:9px;justify-content:flex-end;flex-wrap:wrap;margin-top:13px}
.v789-offer{border:1px solid #b8d3ed;border-radius:8px;padding:11px;margin-top:9px;background:#f1f7ff}
.v789-offer .btn{margin-top:8px}
@media(max-width:640px){#v789Modal .v789-meta{grid-template-columns:1fr}}
</style>
<div class="modal" id="v789Modal" onclick="if(event.target===this)window.v789Close()">
<div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="v789Title">
<div class="modal-head"><div><h2 id="v789Title">Completar extensión del expediente existente</h2>
<div class="note">Solo Administrador · Se conserva el identificador y todo el historial</div></div>
<button type="button" class="btn secondary small" onclick="window.v789Close()">Cerrar</button></div>
<div class="v789-note">Esta acción <b>no crea otra variante</b>, no genera una nueva solicitud y no modifica la custodia del expediente. Si el registro ya tiene préstamos, estos permanecerán vinculados al mismo expediente.</div>
<div id="v789Meta" class="v789-meta"><div>Consultando expediente...</div></div>
<div class="field"><label for="v789Motive">Motivo de la corrección *</label>
<textarea id="v789Motive" placeholder="Ej.: Se verificó que el expediente físico existente corresponde a DSF-PA y se completa la extensión omitida al registrarlo."></textarea></div>
<label style="display:flex;align-items:flex-start;gap:8px;margin:10px 0;font-size:13px"><input type="checkbox" id="v789Agree" style="margin-top:3px;width:auto"/> Confirmo que verifiqué la extensión del expediente original y que no corresponde crear otra variante física.</label>
<div id="v789Status" class="note" role="status">Cargando información...</div>
<div class="v789-actions"><button type="button" class="btn secondary" onclick="window.v789Close()">Cancelar</button><button type="button" class="btn" disabled id="v789Save" onclick="window.v789Save()">Completar extensión del registro existente</button></div>
</div></div>
<script id="v789-extension-existente">
(function(){
 'use strict';
 const E=id=>document.getElementById(id);
 const safe=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 let candidate=null, preview=null, busy=false;
 function admin(){return typeof isAdmin==='function'&&isAdmin();}
 function normalizeNum(v){return String(v||'').trim().replace(/^0+(?=\d)/,'');}
 window.v789ExtensionOffer=function(rows,number,newExtension){
   candidate=null;preview=null;
   if(!admin()||!newExtension||!Array.isArray(rows))return '';
   const clean=rows.filter(r=>r?.id && String(r?.expediente||'').trim()===String(number||'').trim());
   const without=clean.filter(r=>!String(r?.extension||'').trim());
   if(without.length!==1)return '';
   if(clean.some(r=>String(r?.extension||'').trim() && String(r?.extension||'').trim().toUpperCase()===String(newExtension).trim().toUpperCase()))return '';
   candidate={id:without[0].id,expediente:number,extension:newExtension};
   return '<div class="v789-offer"><b>Opción para el Administrador:</b> el expediente físico '+safe(number)+
     ' ya existe, pero sin extensión registrada. Si su extensión correcta es <b>'+safe(newExtension)+
     '</b>, puede completarla en el <b>mismo registro</b>, conservando su responsable y movimientos.<div>'+ 
     '<button type="button" class="btn small" onclick="window.v789Open()">✎ Completar extensión del expediente existente</button></div></div>';
 };
 function showStatus(s,bad){const e=E('v789Status');if(e){e.textContent=s||'';e.style.color=bad?'#a52c2c':'#425a75';}}
 function enabled(){const b=E('v789Save');if(b)b.disabled=busy||!preview?.puede_corregir||!E('v789Agree')?.checked||String(E('v789Motive')?.value||'').trim().length<12;}
 window.v789Close=function(){if(busy)return;E('v789Modal')?.classList.remove('show');preview=null;};
 window.v789Open=async function(){
  if(!admin()||!candidate?.id)return;
  const modal=E('v789Modal');if(!modal)return;
  modal.classList.add('show');
  E('v789Motive').value='';E('v789Agree').checked=false;
  preview=null;enabled();showStatus('Comprobando el registro en Supabase...');
  E('v789Meta').innerHTML='<div>Consultando el expediente...</div>';
  try{
   const {data,error}=await sb.rpc('v789_previsualizar_extension',{p_expediente_id:candidate.id,p_extension:candidate.extension});
   if(error)throw error;
   if(!modal.classList.contains('show'))return;
   preview=data;
   const entries=[['Expediente',data.expediente],['Extensión actual',data.extension_actual||'SIN EXTENSIÓN'],
     ['Extensión que se registrará',data.nueva_extension],['Estado de custodia',data.estado],
     ['Responsable actual',data.responsable],['Solicitudes conservadas',data.solicitudes],['Movimientos conservados',data.movimientos]];
   E('v789Meta').innerHTML=entries.map(([k,v])=>'<div><small>'+safe(k)+'</small><strong>'+safe(v??'—')+'</strong></div>').join('');
   showStatus(data.puede_corregir?'Expediente apto para completar la extensión. Confirme la verificación física y registre el motivo.':
      'No es posible realizar la corrección: '+(data.motivos_bloqueo||[]).join(' · '),!data.puede_corregir);
   enabled();
  }catch(err){showStatus('No se pudo evaluar el expediente: '+String(err?.message||err),true);}
 };
 window.v789Save=async function(){
   if(!admin()||busy||!preview?.puede_corregir)return;
   const motivo=String(E('v789Motive')?.value||'').trim();
   if(motivo.length<12||!E('v789Agree')?.checked){showStatus('Debe verificar la extensión, confirmar y registrar el motivo.',true);return;}
   if(!confirm('¿Confirmas que '+preview.expediente+' corresponde a la extensión '+preview.nueva_extension+'? Se completará el registro existente, sin cambiar su custodia ni crear otra variante.'))return;
   busy=true;enabled();showStatus('Guardando la corrección en Supabase...');
   try{
    const {data,error}=await sb.rpc('v789_completar_extension',{p_expediente_id:preview.expediente_id,p_extension:preview.nueva_extension,p_motivo:motivo});
    if(error)throw error;
    if(!data?.ok)throw Error('Supabase no confirmó la operación.');
    showStatus('Extensión registrada. El mismo expediente conserva '+data.solicitudes_conservadas+' solicitudes y '+data.movimientos_conservados+' movimientos.');
    if(typeof v187RequestLookupCache!=='undefined' && typeof v187RequestLookupCache.clear==='function')v187RequestLookupCache.clear();
    if(E('requestLookupInput'))E('requestLookupInput').value=data.numero;
    if(E('requestLookupExtension'))E('requestLookupExtension').value=data.extension;
    candidate=null;
    E('v789Modal')?.classList.remove('show');
    if(typeof showToast==='function')showToast('Extensión '+data.extension+' agregada al expediente existente '+data.numero+'.');
    if(typeof searchRequestCandidates==='function')await searchRequestCandidates();
   }catch(err){showStatus('No se guardó la corrección: '+String(err?.message||err),true);}
   finally{busy=false;enabled();}
 };
 function bind(){E('v789Agree')?.addEventListener('change',enabled);E('v789Motive')?.addEventListener('input',enabled);}
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind,{once:true});else bind();
})();
</script>

<!-- V790 · CAMPANA EN CABECERA, CONTADOR DE ACCIONES Y REFRESCO DIRIGIDO -->
<style id="v790-campana-superior-estilo">
#v790BellSlot{display:inline-flex;align-items:center;justify-content:center;flex:0 0 58px;width:58px;height:48px;min-width:58px;pointer-events:none}
#v549BellPill{
  top:12px!important;bottom:auto!important;left:auto!important;
  width:auto!important;min-width:47px!important;height:46px!important;
  padding:0 10px!important;box-shadow:0 3px 12px rgba(10,42,76,.20)!important;
  border:1px solid #d3e0ec!important;border-radius:13px!important;
}
#v549BellPill .v549-pill-icon{font-size:19px!important;line-height:1}
#v549BellPill .v549-pill-count{font-size:11px!important}
#v549BellPill.zero .v549-pill-count{display:none!important}
/* El espacio existe en la barra PRODUCE. No tapar los botones de sesión. */
body.v549-drawer-open #v549BellPill{bottom:auto!important;left:auto!important}
#v549AlertDrawer .v549-head-copy p{font-size:11px}
#v549AlertDrawer .v549-foot-note{font-size:10px}
#v549AlertDrawer .v549-item{overflow-wrap:anywhere}
/* No situar la campana por delante de modales de confirmación o acceso. */
body:has(.modal.show) #v549BellPill{transform:scale(0)!important;pointer-events:none!important}
@media(max-width:700px){
  #v790BellSlot{flex-basis:43px;width:43px;min-width:43px;height:42px}
  #v549BellPill{min-width:39px!important;height:40px!important;padding:0 7px!important;border-radius:11px!important}
  #v549BellPill .v549-pill-icon{font-size:17px!important}
  #v549BellPill .v549-pill-count{font-size:10px!important;min-width:16px!important;height:16px!important}
}
@media print{#v549BellPill,#v790BellSlot{display:none!important}}
</style>
<script id="v790-campana-superior-script">
(function(){
  'use strict';
  const P='V790';
  let slot=null;
  let scheduled=false;
  let lastRoleKey='';
  let lastRequestCheck=0;
  let requestBusy=false;
  const CHECK_INTERVAL_MS=120000; // Una sola consulta ligera por perfil cada 2 min, no 8 fuentes.
  const RETRY_INTERVAL_MS=40000;
  const up=v=>String(v??'').trim().toUpperCase();
  function currentRole(){try{return up(currentProfile?.rol||'')}catch(_){return ''}}
  function operational(){return ['ADMINISTRADOR','ARCHIVO'].includes(currentRole())}
  function currentIdentity(){
    try{return String(session?.user?.id||'')+'|'+currentRole()}catch(_){return currentRole()}
  }
  function hasSession(){
    try{return !!(session?.user?.id && typeof sb!=='undefined' && sb)}catch(_){return false}
  }
  function isDrawerOpen(){return document.body.classList.contains('v549-drawer-open')}
  function ensureSlot(){
    const account=document.querySelector('.produce-top .produce-account');
    const logout=account?.querySelector('.produce-logout');
    if(!account||!logout)return null;
    let node=document.getElementById('v790BellSlot');
    if(!node){
      node=document.createElement('span');node.id='v790BellSlot';
      node.setAttribute('aria-hidden','true');node.title='';
    }
    if(node.parentElement!==account || node.nextElementSibling!==logout){
      account.insertBefore(node,logout);
    }
    if(slot!==node){
      slot=node;
      if(typeof ResizeObserver==='function'){
        const ro=new ResizeObserver(schedulePlacement);ro.observe(account);ro.observe(node);
      }
    }
    return node;
  }
  function placeBell(){
    scheduled=false;
    const bell=document.getElementById('v549BellPill');
    if(!bell)return;
    const placeholder=ensureSlot();
    const area=placeholder?.getBoundingClientRect();
    let right=14,top=10;
    const mobile=window.matchMedia('(max-width:700px)').matches;
    const targetHeight=mobile?40:46;
    if(area && area.width>0 && area.height>0 && area.left>=0 && area.right<=innerWidth+1){
      right=Math.max(4,Math.round(innerWidth-area.right+(area.width-(mobile?41:48))/2));
      top=Math.max(2,Math.round(area.top+(area.height-targetHeight)/2));
    }else{
      const header=document.querySelector('.produce-top');
      const rect=header?.getBoundingClientRect();
      top=Math.max(8,Math.round(((rect?.height||72)-targetHeight)/2));
    }
    if(isDrawerOpen()){
      // El panel derecho debe quedar libre y seguir accesible por su botón de cierre.
      const drawer=document.getElementById('v549AlertDrawer');
      const width=drawer?.getBoundingClientRect()?.width||430;
      right=Math.min(innerWidth-targetHeight-8,Math.round(width+10));
      right=Math.max(8,right);
    }
    bell.style.setProperty('right',right+'px','important');
    bell.style.setProperty('left','auto','important');
    bell.style.setProperty('top',top+'px','important');
    bell.style.setProperty('bottom','auto','important');
    bell.setAttribute('aria-label',isDrawerOpen()?'Cerrar avisos pendientes':'Abrir avisos pendientes');
    bell.setAttribute('title',isDrawerOpen()?'Cerrar avisos':'Ver acciones pendientes');
    bell.dataset.version=P;
  }
  function schedulePlacement(){
    if(scheduled)return;
    scheduled=true;
    window.requestAnimationFrame(placeBell);
  }
  function safeRows(fn){try{return typeof fn==='function'?(fn()||[]):[]}catch(_){return []}}
  function applyCount(){
    // Los avisos informativos se muestran en la pestaña Novedades, sin aumentar la campana.
    const requests=operational()?safeRows(typeof v364BuildNewRequests==='function'?v364BuildNewRequests:null):[];
    const tasks=safeRows(typeof v364TaskRows==='function'?v364TaskRows:null);
    const notices=safeRows(typeof v364NoticeRows==='function'?v364NoticeRows:null).filter(x=>x?.unread);
    const pending=requests.length+tasks.length;
    const countIds=['v549PillCount','v549DrawerCount','produceAlerts','alertsUnreadText','alertsBadge','userOnlyAlertsBadge'];
    countIds.forEach(id=>{const n=document.getElementById(id);if(n){n.textContent=(id==='alertsBadge'||id==='userOnlyAlertsBadge')&&pending>99?'99+':String(pending);if(id==='alertsBadge'||id==='userOnlyAlertsBadge')n.classList.toggle('zero',pending===0)}});
    const bell=document.getElementById('v549BellPill');
    bell?.classList.toggle('zero',pending===0);
    if(bell)bell.setAttribute('aria-label',pending?`${pending} acciones pendientes. Abrir notificaciones`:'Sin acciones pendientes. Abrir notificaciones');
    const all=document.getElementById('v549AllCount');if(all)all.textContent=String(pending+notices.length);
    const notice=document.getElementById('v549NoticeCount');if(notice)notice.textContent=String(notices.length);
    const request=document.getElementById('v550RequestCount');if(request)request.textContent=String(requests.length);
    const task=document.getElementById('v549TaskCount');if(task)task.textContent=String(tasks.length);
    return pending;
  }
  async function refreshRequests(force=false){
    const profile=currentIdentity();
    if(profile!==lastRoleKey){lastRoleKey=profile;lastRequestCheck=0;}
    if(!hasSession()||!operational()||requestBusy)return false;
    if(!force && Date.now()-lastRequestCheck<CHECK_INTERVAL_MS)return false;
    if(navigator.onLine===false)return false;
    if(window.v601Protection?.state?.mode==='BLOQUEADO')return false;
    requestBusy=true;
    try{
      if(typeof window.loadV362RequestAlerts==='function'){
        await window.loadV362RequestAlerts({silent:true});
      }
      // No consultar todas las tablas en segundo plano; aprovechar la caché de tareas V170.
      try{if(typeof renderV364Alerts==='function')renderV364Alerts(true)}catch(_){ }
      applyCount();
      if(isDrawerOpen() && typeof window.v549RefreshAlerts==='function'){
        await window.v549RefreshAlerts(false);
      }
      lastRequestCheck=Date.now();
      return true;
    }catch(e){
      try{console.warn('V790 · actualización de solicitudes:',e?.message||e)}catch(_){ }
      lastRequestCheck=Date.now()-(CHECK_INTERVAL_MS-RETRY_INTERVAL_MS);
      return false;
    }finally{requestBusy=false;}
  }
  const baseRefresh=window.v549RefreshAlerts;
  if(typeof baseRefresh==='function'){
    window.v549RefreshAlerts=async function(force=false){
      const result=await baseRefresh.apply(this,arguments);
      applyCount();schedulePlacement();
      return result;
    };
  }
  window.v790ActualizarNotificaciones=async function(){
    lastRequestCheck=0;
    if(typeof window.v549RefreshAlerts==='function')await window.v549RefreshAlerts(true);
    return refreshRequests(true);
  };
  window.v790EstadoNotificaciones=function(){
    return {version:P,rol:currentRole(),acciones:applyCount(),
      solicitudes:operational()?safeRows(typeof v364BuildNewRequests==='function'?v364BuildNewRequests:null).length:0,
      sincronizacion:CHECK_INTERVAL_MS,solo_consulta:true};
  };
  function init(){
    ensureSlot();schedulePlacement();applyCount();
    window.addEventListener('resize',schedulePlacement,{passive:true});
    window.addEventListener('scroll',schedulePlacement,{passive:true});
    window.visualViewport?.addEventListener('resize',schedulePlacement,{passive:true});
    document.addEventListener('click',ev=>{
      if(ev.target?.closest?.('#v549BellPill,#v549AlertDrawer'))setTimeout(schedulePlacement,0);
      else if(ev.target?.closest?.('button'))setTimeout(applyCount,600);
    },true);
    document.addEventListener('visibilitychange',()=>{
      if(!document.hidden){schedulePlacement();refreshRequests(false).catch(()=>{});}
    });
    window.addEventListener('focus',()=>{schedulePlacement();refreshRequests(false).catch(()=>{})},{passive:true});
    const backdrop=document.getElementById('v549AlertDrawer');
    if(backdrop) new MutationObserver(schedulePlacement).observe(backdrop,{attributes:true,attributeFilter:['class']});
    // Reutilizar el mecanismo V602, con un pulso ligero V362 cada dos minutos.
    setInterval(()=>{
      if(document.hidden||!hasSession())return;
      if(currentIdentity()!==lastRoleKey)lastRequestCheck=0;
      refreshRequests(false).catch(()=>{});
      schedulePlacement();
    },CHECK_INTERVAL_MS);
    setTimeout(()=>refreshRequests(true).catch(()=>{}),1800);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});
  else init();
})();
</script>


<!-- V791 · Etiquetas de disponibilidad según custodio y trámite autorizado -->
<style id="v791-disponibilidad-clara">
#requestLookupResults .v791-availability,#requestExcelResults .v791-availability{display:flex;flex-direction:column;align-items:flex-start;gap:4px;max-width:245px;line-height:1.36;white-space:normal;overflow-wrap:anywhere}
#requestLookupResults .v791-tag,#requestExcelResults .v791-tag{display:inline-block;border-radius:7px;padding:4px 7px;max-width:100%;box-sizing:border-box;font-size:10px;font-weight:800;background:#e9eff8;color:#214b73;border:1px solid #b6cfe5;white-space:normal;overflow-wrap:anywhere}
#requestLookupResults .v791-tag.reassignment,#requestExcelResults .v791-tag.reassignment{background:#e7f3ec;color:#18603e;border-color:#abddc1}
#requestLookupResults .v791-tag.unavailable,#requestExcelResults .v791-tag.unavailable{background:#fff1e9;color:#894b2c;border-color:#edccaf}
#requestLookupResults .v791-action,#requestExcelResults .v791-action{display:block;color:#155d90;font-size:11px;font-weight:800;line-height:1.3}
#requestLookupResults .v791-detail,#requestExcelResults .v791-detail{display:block;color:#516779;font-size:10px;line-height:1.42;max-width:235px}
@media(max-width:780px){#requestLookupResults .v791-availability,#requestExcelResults .v791-availability{min-width:142px;max-width:185px}#requestLookupResults .v791-detail,#requestExcelResults .v791-detail{font-size:10px}}
</style>

<!-- V792 · Disponibilidad compacta y diferenciada del préstamo del Archivo -->
<style id="v792-disponibilidad">
#requestLookupResults .v792-requiere-reasignacion,#requestExcelResults .v792-requiere-reasignacion{
  display:inline-block;padding:5px 7px;border:1px solid #bad7e7;
  border-radius:7px;background:#eaf5fc;color:#13577e;
  font-size:10px;font-weight:800;line-height:1.36;text-align:center;
  white-space:normal;overflow-wrap:anywhere;max-width:150px;
}
#requestLookupResults td:nth-child(8),#requestExcelResults td:nth-child(8){vertical-align:middle}
</style>

<!-- V798 · Corrección de grupos personales: origen único por grupo y creación vacía. -->
<!-- V797 · Grupos personales: seleccionar un grupo reemplaza exactamente sus destinatarios,
     sincroniza la columna derecha, sin cruces ni nuevos correos. -->
<style id="v796-grupos-correo-estilo">
.v796-grupos{grid-column:1 / -1;border:1px solid #c4d8ea;background:#f2f7fd;border-radius:10px;padding:11px 12px;min-width:0}
.v796-grupos-header{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:7px}
.v796-grupos-header strong{font-size:13px;color:#173e68}
.v796-grupos-info{font-size:11px;color:#526e88;line-height:1.4}
.v796-grupos-grid{display:grid;grid-template-columns:minmax(210px,1fr) minmax(210px,1fr);gap:8px}
.v796-grupos-field{min-width:0}.v796-grupos-field>label{display:block;margin-bottom:4px;font-size:10px;color:#466582;font-weight:850}
.v796-grupos-field input,.v796-grupos-field select{width:100%;height:35px;border:1px solid #bdcfe1;border-radius:7px;background:#fff;color:#153e68;padding:5px 9px;font-size:12px;min-width:0}
.v796-grupos-actions{display:flex;gap:7px;flex-wrap:wrap;align-items:center;margin-top:8px}
.v796-grupos-actions button{font-size:11px;line-height:1.2;border-radius:7px;padding:7px 9px;white-space:normal}
.v796-grupos-default{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:750;color:#365977;margin-left:auto}
.v796-grupos-default input{height:15px;width:15px;accent-color:#245b90}
.v796-grupos-status{font-size:11px;line-height:1.4;color:#436681;margin-top:7px;min-height:14px;overflow-wrap:anywhere}
.v796-grupos-status[data-error="1"]{color:#a33b32}
.v796-grupos-actions button:disabled{opacity:.55;cursor:not-allowed}
@media(max-width:670px){.v796-grupos-grid{grid-template-columns:1fr}.v796-grupos-default{margin-left:0}}
</style>

<!-- V798: nombre + correo visible para cada destinatario seleccionado -->
<style id="v798-destinatarios-visible-estilo">
#v560RequestMailPanel .v571-selected-person,
#v560ReassignMailPanel .v571-selected-person{min-width:0!important;flex:1 1 auto!important;display:block!important}
#v560RequestMailPanel .v571-selected-person small,
#v560ReassignMailPanel .v571-selected-person small{
 display:block!important;visibility:visible!important;opacity:1!important;
 white-space:normal!important;overflow-wrap:anywhere!important;text-overflow:clip!important;
 line-height:1.35!important;margin-top:4px!important;font-size:10px!important;color:#45637f!important;
}
#v560RequestMailPanel .v571-selected-item,
#v560ReassignMailPanel .v571-selected-item{align-items:center!important;min-height:52px!important}
</style>
<script id="v798-grupos-correo-script">
(function(){
 'use strict';
 const CONFIG={
   SOLICITUD:{box:'v560RequestMailRecipients',host:'v560RequestMailContent',titulo:'Préstamos y solicitudes'},
   REASIGNACION:{box:'v560ReassignMailRecipients',host:'v560ReassignMailContent',titulo:'Reasignaciones'}
 };
 const state={SOLICITUD:{groups:[],lastUid:'',busy:false,initialIds:[],observer:null,observerBox:null},REASIGNACION:{groups:[],lastUid:'',busy:false,initialIds:[],observer:null,observerBox:null}};
 const $=id=>document.getElementById(id);
 const safe=x=>String(x??'').trim();
 const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
 const db=()=>{try{return typeof sb!=='undefined' ? sb : window.sb}catch(_){return window.sb}};
 const uid=()=>{try{return String(session?.user?.id||'')}catch(_){return ''}};
 const prefix=op=>'v796'+op;
 const NUEVO='__v798_nuevo__';
 const nameId=op=>prefix(op)+'Nombre';
 const selId=op=>prefix(op)+'Elegir';
 const defId=op=>prefix(op)+'Default';
 const statusId=op=>prefix(op)+'Estado';
 const checks=op=>[...($(CONFIG[op].box)?.querySelectorAll('input[data-v560-recipient]')||[])];
 const selected=op=>[...new Set(checks(op).filter(c=>c.checked).map(c=>safe(c.value)).filter(Boolean))];
 const activeSelected=op=>new Map(checks(op).map(c=>[safe(c.value),c]));
 const isDbReady=()=>!!(uid()&&db()?.from);
 function say(op,message,error=false){const el=$(statusId(op));if(el){el.textContent=message;el.dataset.error=error?'1':'0'}}
 function controls(op,busy){state[op].busy=!!busy;const h=$(prefix(op)+'Bar');if(h){h.querySelectorAll('button,select,input').forEach(el=>el.disabled=!!busy)}}
 function panel(op){
   const cfg=CONFIG[op],host=$(cfg.host);
   if(!host)return null;
   let bar=$(prefix(op)+'Bar');if(bar)return bar;
   bar=document.createElement('section');
   bar.id=prefix(op)+'Bar';bar.className='v796-grupos';
   bar.innerHTML=`
    <div class="v796-grupos-header"><strong>✉ Mis grupos de correos</strong><span class="v796-grupos-info">Configuración personal · ${esc(cfg.titulo)}</span></div>
    <div class="v796-grupos-grid">
      <div class="v796-grupos-field"><label for="${selId(op)}">Grupo guardado</label><select id="${selId(op)}"><option value="">Selección habitual del sistema</option></select></div>
      <div class="v796-grupos-field"><label for="${nameId(op)}">Nombre del grupo</label><input type="text" id="${nameId(op)}" maxlength="80" placeholder="Ej.: Solicitudes de mi área" autocomplete="off"></div>
    </div>
    <div class="v796-grupos-actions">
      <button type="button" class="btn small" data-v796-action="create">+ Guardar nuevo grupo</button>
      <button type="button" class="btn secondary small" data-v796-action="update">Actualizar seleccionado</button>
      <button type="button" class="btn secondary small" data-v796-action="delete">Eliminar grupo</button>
      <label class="v796-grupos-default"><input type="checkbox" id="${defId(op)}"> Usar por defecto</label>
    </div>
    <div class="v796-grupos-status" id="${statusId(op)}" role="status">Selecciona destinatarios o utiliza un grupo guardado.</div>`;
   host.insertBefore(bar,host.firstChild);
   bar.querySelector('select').addEventListener('change',()=>choose(op));
   $(CONFIG[op].box)?.addEventListener('change',ev=>{
     if(!ev.isTrusted||!ev.target?.matches?.('input[data-v560-recipient]'))return;
     const current=state[op].groups.find(g=>String(g.id)===$(selId(op))?.value);
     if(current)say(op,'Selección modificada. Pulsa «Actualizar seleccionado» para guardar estos cambios solamente en el grupo «'+current.nombre+'».');
   });
   bar.addEventListener('click',e=>{
     const action=e.target?.closest?.('[data-v796-action]')?.dataset.v796Action;
     if(action==='create')save(op,false);
     if(action==='update')save(op,true);
     if(action==='delete')remove(op);
   });
   return bar;
 }
 function refreshOptions(op,selectedId=''){
   const selector=$(selId(op));if(!selector)return;
   const entries=state[op].groups;
   selector.innerHTML='<option value="">Selección habitual del sistema</option>'+entries.map(g=>
      `<option value="${esc(g.id)}">${esc(g.nombre)}${g.predeterminado?' · predeterminado':''}</option>`).join('')+
      `<option value="${NUEVO}">＋ Crear grupo nuevo (selección vacía)</option>`;
   selector.value=selectedId||'';
   if(!selector.value){$(nameId(op)).value='';$(defId(op)).checked=false}
 }
 // Una plantilla contiene EXCLUSIVAMENTE los destinatarios guardados en ese grupo.
 // No copiar ni reinsertar automáticamente destinatarios del grupo anterior.
 function redraw(op){
   const box=$(CONFIG[op].box);
   // Las listas existentes se repintan a partir de los checkbox actuales.
   window.v797ActualizarSeleccionCorreo?.(op);
   const first=checks(op)[0];
   if(first)first.dispatchEvent(new Event('change',{bubbles:true}));
   else box?.dispatchEvent(new Event('change',{bubbles:true}));
 }
 function setExact(op,ids){
   const available=activeSelected(op);
   const wanted=new Set((Array.isArray(ids)?ids:[]).map(String));
   let missing=0;
   for(const id of wanted){if(!available.has(id))missing++;}
   // Cada cambio sustituye el conjunto completo, también los predeterminados
   // marcados por versiones anteriores. Mantener esta selección frente a rutinas
   // diferidas V580/V585 y reconstrucciones de la lista.
   window.v798FijarSeleccionGrupoCorreo?.(CONFIG[op].box,[...wanted]);
   for(const [id,cb] of available){
     cb.checked=wanted.has(id);
     if(op==='REASIGNACION'&&cb.dataset.v585TargetAuto==='1')delete cb.dataset.v585TargetAuto;
   }
   redraw(op);
   return {missing,count:checks(op).filter(c=>c.checked).length};
 }
 function signatures(ids){return [...new Set((ids||[]).map(String))].sort().join('|')}
 function namesWithSameSelection(op,g){
   const sig=signatures(g?.destinatario_ids);
   return state[op].groups.filter(x=>x.id!==g.id && signatures(x.destinatario_ids)===sig).map(x=>x.nombre);
 }
 function apply(op,group){
   const result=setExact(op,group?.destinatario_ids||[]);
   const nombre=safe(group?.nombre)||'Seleccionado';
   const duplicates=namesWithSameSelection(op,group);
   const notice=duplicates.length?` Aviso: este grupo tiene los mismos destinatarios guardados que «${duplicates.join('», «')}». Si necesitas listas diferentes, modifica uno y pulsa «Actualizar seleccionado».`:'';
   say(op,`Grupo «${nombre}»: ${result.count} destinatario(s) mostrado(s) en el panel derecho.${result.missing?' '+result.missing+' correo(s) inactivo(s) o no disponible(s) se omitieron.':''}${notice}`,result.missing>0);
 }
 function choose(op){
   const val=$(selId(op))?.value||'';
   const g=state[op].groups.find(g=>String(g.id)===val);
   if(val===NUEVO){
     $(nameId(op)).value='';$(defId(op)).checked=false;
     setExact(op,[]);
     say(op,'Nuevo grupo: selección vacía. Marca los destinatarios que correspondan, escribe el nombre y pulsa «Guardar nuevo grupo».');
     $(nameId(op))?.focus();
     return;
   }
   if(!g){
     $(nameId(op)).value='';$(defId(op)).checked=false;
     const result=setExact(op,state[op].initialIds);
     say(op,`Selección habitual del sistema restaurada (${result.count} destinatarios).`);
     return;
   }
   $(nameId(op)).value=g.nombre;
   $(defId(op)).checked=!!g.predeterminado;
   apply(op,g);
 }
 function attachRefresh(op){
   const box=$(CONFIG[op].box),st=state[op];
   if(!box||st.observerBox===box)return;
   st.observer?.disconnect();
   st.observerBox=box;
   st.observer=new MutationObserver(changes=>{
     if(!changes.some(m=>m.type==='childList'))return;
     const val=$(selId(op))?.value;
     const g=st.groups.find(x=>x.id===val);
     if(g)setExact(op,g.destinatario_ids);
     else if(val===NUEVO)setExact(op,[]);
   });
   st.observer.observe(box,{childList:true,subtree:false});
 }
 async function load(op,applyDefault=true){
   panel(op);
   if(!isDbReady()){say(op,'Inicia sesión para utilizar tus grupos personales.',true);return}
   const currentUid=uid();const st=state[op];
   if(applyDefault)st.initialIds=selected(op);
   attachRefresh(op);
   const choiceBefore=$(selId(op))?.value||'';
   // La información se carga siempre desde Supabase para respetar cambios hechos en otros equipos.
   try{
     const {data,error}=await db().from('v796_grupos_correo_usuario')
       .select('id,usuario_id,operacion,nombre,destinatario_ids,predeterminado,updated_at')
       .eq('usuario_id',currentUid).eq('operacion',op).order('nombre',{ascending:true});
     if(error)throw error;
     if(uid()!==currentUid)return;
     st.groups=Array.isArray(data)?data:[];
     st.lastUid=currentUid;
     const automatic=st.groups.find(g=>g.predeterminado);
     refreshOptions(op,applyDefault?(automatic?.id||''):choiceBefore);
     if(automatic && applyDefault){choose(op)}
     else say(op,st.groups.length?`${st.groups.length} grupo(s) personales disponibles. Elige un grupo o «Crear grupo nuevo (selección vacía)».`:'Aún no tienes grupos. Selecciona correos y pulsa «Guardar nuevo grupo».');
   }catch(e){st.groups=[];refreshOptions(op);say(op,'No se pudieron cargar los grupos. Continúa con los correos actuales. '+safe(e.message),true)}
 }
 function normEmailSelections(op){
   const all=checks(op).filter(c=>c.checked);
   const seen=new Set(),ids=[];
   for(const cb of all){
     const email=safe(cb.dataset.email).toLowerCase();
     if(!email || seen.has(email))continue;
     seen.add(email);ids.push(safe(cb.value));
   }
   return ids.filter(Boolean);
 }
 async function save(op,updating){
   if(state[op].busy)return;
   if(!isDbReady()){say(op,'Tu sesión no está activa.',true);return}
   const nombre=safe($(nameId(op))?.value);
   const ids=normEmailSelections(op);
   const id=$(selId(op))?.value||'';
   const makeDefault=!!$(defId(op))?.checked;
   if(!updating && id && id!==NUEVO){
     $(selId(op)).value=NUEVO;
     choose(op);
     say(op,'Primero configura un grupo nuevo. Se vació la selección para evitar copiar los destinatarios del grupo anterior.');
     return;
   }
   if(nombre.length<2||nombre.length>80){say(op,'Escribe un nombre de grupo de 2 a 80 caracteres.',true);return}
   if(ids.length<1){say(op,'Selecciona al menos un destinatario antes de guardar.',true);return}
   if(ids.length>40){say(op,'Puedes guardar hasta 40 destinatarios por grupo.',true);return}
   if(updating&&(!id||id===NUEVO)){say(op,'Selecciona el grupo guardado que deseas actualizar.',true);return}
   if(updating&&!state[op].groups.some(g=>g.id===id)){say(op,'No se encontró el grupo seleccionado.',true);return}
   if(!updating){
     const repeated=state[op].groups.filter(g=>signatures(g.destinatario_ids)===signatures(ids));
     if(repeated.length&&!window.confirm(`La selección coincide con «${repeated.map(g=>g.nombre).join('», «')}». ¿Quieres guardar otro grupo con los mismos correos?`)){
       say(op,'No se guardó el nuevo grupo. Modifica los destinatarios si deseas un grupo diferente.');
       return;
     }
   }
   controls(op,true);
   try{
     // Operación atómica: si falla el guardado, el grupo predeterminado anterior no cambia.
     const {data:savedId,error:saveError}=await db().rpc('v796_guardar_grupo_correo',{
       p_id:updating?id:null,
       p_operacion:op,
       p_nombre:nombre,
       p_destinatario_ids:ids,
       p_predeterminado:makeDefault
     });
     if(saveError)throw saveError;

     await load(op,false);
     refreshOptions(op,savedId);
     const saved=state[op].groups.find(g=>g.id===savedId);
     if(saved){$(nameId(op)).value=saved.nombre;$(defId(op)).checked=!!saved.predeterminado;apply(op,saved)}
     say(op,updating?'Grupo actualizado. Los integrantes guardados se muestran a la derecha.':'Grupo guardado. Los destinatarios guardados se muestran a la derecha.');
   }catch(e){
     say(op,'No se pudo guardar el grupo: '+safe(e.message),true);
     // Refrescar por si hubo cambios simultáneos desde otro equipo.
     await load(op,false);
   }finally{controls(op,false)}
 }
 async function remove(op){
   if(state[op].busy)return;
   const id=$(selId(op))?.value;
   const g=state[op].groups.find(g=>g.id===id);
   if(!g){say(op,'Selecciona un grupo para eliminar.',true);return}
   if(!window.confirm(`¿Eliminar el grupo «${g.nombre}»? Esto no elimina correos ni movimientos.`))return;
   controls(op,true);
   try{
     const {error}=await db().from('v796_grupos_correo_usuario').delete()
       .eq('id',id).eq('usuario_id',uid()).eq('operacion',op);
     if(error)throw error;
     await load(op,false);
     setExact(op,state[op].initialIds);
     say(op,'Grupo eliminado. Se restableció la selección habitual del sistema.');
   }catch(e){say(op,'No se pudo eliminar el grupo: '+safe(e.message),true)}
   finally{controls(op,false)}
 }
 window.v797GrupoCorreoActivo=op=>!!(state[op]?.groups.find(g=>String(g.id)===$(selId(op))?.value));
 window.v798GrupoCorreoActivo=op=>window.v797GrupoCorreoActivo(op)||$(selId(op))?.value===NUEVO;
 window.v796PrepararGrupoCorreo=load;
 window.v796GruposCorreoPrueba={
   configuraciones:Object.keys(CONFIG),
   normalizar:ids=>[...new Set(ids.map(String))]
 };
 function boot(){Object.keys(CONFIG).forEach(panel)}
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>

<!-- V799 · Visibilidad de las opciones de expedientes por área y por usuario.
     Cambio exclusivamente visual: no modifica permisos, navegación ni consultas. -->
<style id="v799-menu-expedientes-area-usuario-legible">
/* V776 atenuaba el texto de ambas opciones inactivas, haciéndolas parecer
   deshabilitadas sobre el fondo claro. Darles contraste sin marcar las dos
   como activas ni eludir el control de permisos vigente. */
.produce-nav > #produceAreasWorkBtnV280:not(.active):not(:disabled),
.produce-nav > button[data-destination="panel"][data-nav-index]:not([data-nav-index="0"]):not(.active):not(:disabled){
  color:#153d6e!important;
  background:#eaf2fc!important;
  border:1px solid #cbdff3!important;
  box-shadow:none!important;
  opacity:1!important;
  cursor:pointer!important;
}
.produce-nav > #produceAreasWorkBtnV280:not(.active):not(:disabled) .p-icon,
.produce-nav > button[data-destination="panel"][data-nav-index]:not([data-nav-index="0"]):not(.active):not(:disabled) .p-icon{
  color:inherit!important;
  opacity:1!important;
  stroke:currentColor!important;
}
.produce-nav > #produceAreasWorkBtnV280:not(.active):not(:disabled):hover,
.produce-nav > button[data-destination="panel"][data-nav-index]:not([data-nav-index="0"]):not(.active):not(:disabled):hover{
  color:#fff!important;
  background:#214e80!important;
  border-color:#214e80!important;
}
.produce-nav > #produceAreasWorkBtnV280:not(:disabled):focus-visible,
.produce-nav > button[data-destination="panel"][data-nav-index]:not([data-nav-index="0"]):not(:disabled):focus-visible{
  outline:3px solid #77b5ff!important;
  outline-offset:2px!important;
}
/* Si un rol no tiene permiso, se conserva el aspecto y la deshabilitación
   originales; no se fuerzan display, hidden ni disabled desde esta versión. */
</style>

<!-- V800: Modificar solo identificación del expediente físico existente, con auditoría obligatoria -->
<style id="v800-numero-estilo">
#v800NumeroModal{z-index:20210}
#v800NumeroModal .modal-box{width:min(96vw,720px);max-width:720px}
#v800NumeroModal .v800-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:12px 0}
#v800NumeroModal .v800-grid>div{border:1px solid #d3dfeb;background:#f6f9fd;padding:9px;border-radius:8px;min-width:0}
#v800NumeroModal .v800-grid small{display:block;font-size:11px;color:#58708c;margin-bottom:2px}
#v800NumeroModal .v800-grid strong{display:block;overflow-wrap:anywhere}
#v800NumeroModal .v800-help{padding:11px;border:1px solid #caddec;border-radius:9px;background:#f4f8fd;font-size:13px;line-height:1.5}
#v800NumeroModal textarea{width:100%;min-height:82px}
#v800NumeroModal .v800-action-row{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;margin-top:12px}
#v800NumeroModal .v800-check{display:flex;align-items:flex-start;gap:8px;margin:10px 0;line-height:1.5;font-size:13px}
#v800NumeroModal .v800-check input{width:auto;flex:none;margin-top:3px}
#v800NumeroModal #v800Feedback{overflow-wrap:anywhere;min-height:22px;font-size:13px;white-space:pre-wrap}
@media(max-width:620px){#v800NumeroModal .v800-grid{grid-template-columns:1fr}#v800NumeroModal .v800-action-row .btn{flex:1}}
</style>
<div class="modal" id="v800NumeroModal" onclick="if(event.target===this)window.v800CloseCorrection()">
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="v800NumeroTitulo">
    <div class="modal-head"><div>
      <h2 id="v800NumeroTitulo">Corregir número de expediente existente</h2>
      <div class="note">Solo Administrador · No crea otra solicitud ni modifica la custodia</div>
    </div><button class="btn secondary small" type="button" onclick="window.v800CloseCorrection()">Cerrar</button></div>
    <div class="v800-help">Utilice esta opción solo para corregir la <b>identificación del expediente físico que ya fue entregado</b>. El número de la solicitud, el cargo emitido y los movimientos históricos no se reescriben. El cargo firmado deberá conservarse junto con la constancia de corrección.</div>
    <div class="v800-grid" id="v800NumeroMeta"><div>Consultando expediente...</div></div>
    <div class="field"><label for="v800NumeroNuevo">Número correcto del expediente *</label>
      <input id="v800NumeroNuevo" placeholder="Ej.: 0916-2023" autocomplete="off" spellcheck="false" maxlength="22"/>
      <small>Correlativo-año. En casos históricos se admite subnúmero: 10813-52-2004. La extensión se conserva.</small>
    </div>
    <div class="field"><label for="v800Motivo">Motivo de la corrección *</label>
      <textarea id="v800Motivo" maxlength="1000" placeholder="Ej.: Se verificó el expediente físico entregado y se detectó un error de digitación del correlativo."></textarea>
    </div>
    <label class="v800-check"><input type="checkbox" id="v800Confirmacion"/> <span>Confirmo que revisé la documentación original, que el expediente entregado corresponde al número correcto y que no estoy sustituyendo un expediente físico por otro.</span></label>
    <div class="note" id="v800Feedback" role="status">Escriba el número correcto para comprobarlo antes de guardar.</div>
    <div class="v800-action-row">
      <button class="btn secondary" type="button" onclick="window.v800CloseCorrection()">Cancelar</button>
      <button class="btn secondary" type="button" id="v800Previsualizar" onclick="window.v800PreviewCorrection()">Verificar numeración</button>
      <button class="btn" type="button" id="v800Guardar" disabled onclick="window.v800SaveCorrection()">Guardar corrección</button>
    </div>
  </div>
</div>
<script id="v800-correccion-numeracion-script">
(function(){
 'use strict';
 const E=id=>document.getElementById(id);
 const safe=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 let original=null,preview=null,busy=false,sequence=0,debounce=0;
 const isAuthorized=()=>typeof isAdmin==='function'&&isAdmin();
 const enteredNumber=()=>String(E('v800NumeroNuevo')?.value||'').trim().toUpperCase().replace(/\s+/g,'');
 function status(message,error=false){const n=E('v800Feedback');if(n){n.textContent=message||'';n.style.color=error?'#ac2525':'#405974';}}
 function allowed(){const save=E('v800Guardar');const check=E('v800Confirmacion')?.checked;const reason=String(E('v800Motivo')?.value||'').trim();if(save)save.disabled=busy||!preview?.puede_corregir||!check||reason.length<12||reason.length>1000||preview.numero_nuevo!==enteredNumber();const test=E('v800Previsualizar');if(test)test.disabled=busy||!original?.id;}
 function clearPreview(){preview=null;allowed();}
 function meta(data){
   const items=[['Número actual',data.numero_anterior],['Extensión (no se modifica)',data.extension||'—'],['Número propuesto',data.numero_nuevo||'—'],['Estado de custodia',data.estado||'—'],['Responsable actual',data.responsable||'—'],['Cargo original',data.cargo||'—'],['Solicitudes vinculadas',data.solicitudes??'—'],['Movimientos conservados',data.movimientos??'—'],['Eventos de historial',data.historial??'—']];
   if(E('v800NumeroMeta'))E('v800NumeroMeta').innerHTML=items.map(([name,val])=>'<div><small>'+safe(name)+'</small><strong>'+safe(val)+'</strong></div>').join('');
 }
 window.v800CloseCorrection=function(){if(busy)return;sequence++;clearTimeout(debounce);E('v800NumeroModal')?.classList.remove('show');original=null;clearPreview();};
 window.v800OpenCorrection=async function(id){
   if(!isAuthorized()){if(typeof showToast==='function')showToast('Solo el Administrador puede corregir la numeración.');return;}
   if(!id||!E('v800NumeroModal')||typeof sb==='undefined'||!sb)return;
   sequence++;const seq=sequence;busy=false;preview=null;original=null;
   E('v800NumeroModal').classList.add('show');E('v800NumeroNuevo').value='';E('v800Motivo').value='';E('v800Confirmacion').checked=false;
   E('v800NumeroMeta').innerHTML='<div>Consultando información del expediente...</div>';
   status('Consultando el registro actual en Supabase...');allowed();
   try{
     const {data,error}=await sb.from('expedientes').select('id,expediente,extension,estado,responsable,cargo').eq('id',id).single();
     if(error)throw error;if(seq!==sequence)return;
     original=data;
     meta({numero_anterior:data.expediente,extension:data.extension,estado:data.estado,responsable:data.responsable,cargo:data.cargo});
     status('Ingrese el número correcto y seleccione «Verificar numeración».');
     E('v800NumeroNuevo').focus();allowed();
   }catch(err){status('No fue posible consultar el expediente: '+String(err?.message||err),true);}
 };
 window.v800PreviewCorrection=async function(){
   if(!isAuthorized()||busy||!original?.id)return;
   const n=enteredNumber();clearPreview();
   if(!/^\d{1,6}(?:-\d{1,3})?-[12]\d{3}$/.test(n)){status('Escriba número-año (por ejemplo, 0916-2023).',true);return;}
   const seq=++sequence;busy=true;allowed();status('Validando numeración, extensión, duplicados y acumulados...');
   try{
     const {data,error}=await sb.rpc('v800_previsualizar_correccion_numero',{p_expediente_id:original.id,p_numero_nuevo:n});
     if(error)throw error;if(seq!==sequence)return;
     preview=data;meta(data);
     const reasons=Array.isArray(data.motivos_bloqueo)?data.motivos_bloqueo:[];
     if(data.puede_corregir){status('Numeración apta para corregirse. '+(data.advertencia_cargo||'')+' Revise y confirme.');}
     else status('No es posible corregir el expediente: '+reasons.join(' · '),true);
   }catch(err){if(seq===sequence)status('No se pudo verificar: '+String(err?.message||err),true);}
   finally{busy=false;allowed();}
 };
 window.v800SaveCorrection=async function(){
   if(!isAuthorized()||busy||!preview?.puede_corregir||!original?.id)return;
   const motivo=String(E('v800Motivo')?.value||'').trim();
   if(!E('v800Confirmacion')?.checked||motivo.length<12||motivo.length>1000||preview.numero_nuevo!==enteredNumber()){allowed();return;}
   if(!confirm('¿Confirmas la corrección de '+preview.numero_anterior+' a '+preview.numero_nuevo+'? Se conservarán la solicitud, el préstamo y el cargo original. El cambio quedará auditado.'))return;
   busy=true;allowed();status('Aplicando corrección auditada en Supabase...');
   try{
     const {data,error}=await sb.rpc('v800_corregir_numero_expediente',{
       p_expediente_id:original.id,p_numero_anterior:preview.numero_anterior,
       p_numero_nuevo:preview.numero_nuevo,p_motivo:motivo
     });
     if(error)throw error;if(!data?.ok)throw Error('Supabase no confirmó la corrección.');
     E('v800NumeroModal')?.classList.remove('show');
     if(typeof v187RequestLookupCache!=='undefined'&&typeof v187RequestLookupCache.clear==='function')v187RequestLookupCache.clear();
     if(typeof accumulatedCache!=='undefined'&&typeof accumulatedCache.clear==='function')accumulatedCache.clear();
     if(typeof showToast==='function')showToast('Número corregido: '+data.numero_anterior+' → '+data.numero_nuevo+'. Préstamos e historial conservados.');
     else alert('Número corregido: '+data.numero_anterior+' → '+data.numero_nuevo);
     // V801: actualizar de inmediato el expediente en la solicitud abierta y descartar el detalle anterior de caché.
     const reqId=(typeof currentRequestId!=='undefined')?String(currentRequestId||''):'';
     if(reqId && typeof requestDetailRows!=='undefined' && Array.isArray(requestDetailRows)){
       const corrected=requestDetailRows.find(x=>String(x.expediente_id)===String(data.expediente_id));
       if(corrected){
         corrected.expediente=data.numero_nuevo;
         if(typeof renderRequestDetailItems==='function')renderRequestDetailItems();
         if(typeof requestDetailCacheV358!=='undefined'&&requestDetailCacheV358?.delete)requestDetailCacheV358.delete(reqId);
       }
     }
     // Recargar vistas sin borrar los registros ni reiniciar solicitudes.
     const refresh=[typeof loadAll==='function'?loadAll:null,typeof loadPanel==='function'?loadPanel:null,typeof loadStates==='function'?loadStates:null].filter(Boolean);
     for(const action of refresh){try{await action();}catch(ex){console.warn('V800 refresco:',ex);}}
   }catch(err){status('No se guardó ninguna corrección: '+String(err?.message||err),true);}
   finally{busy=false;allowed();}
 };
 function bind(){
   E('v800NumeroNuevo')?.addEventListener('input',()=>{clearPreview();clearTimeout(debounce);status('Número modificado. Vuelva a verificar antes de guardar.');});
   E('v800Confirmacion')?.addEventListener('change',allowed);
   E('v800Motivo')?.addEventListener('input',allowed);
   document.addEventListener('keydown',e=>{if(e.key==='Escape'&&E('v800NumeroModal')?.classList.contains('show'))window.v800CloseCorrection();});
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind,{once:true});else bind();
})();
</script>
\n<!-- V801: acción visible directamente desde Expedientes solicitados (Administrador) -->
<style id="v801-solicitud-correccion-style">
#requestDetailModal .v801-correction-head-actions{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:8px}
#requestDetailModal #v801CorrectionSelectedBtn{white-space:nowrap;font-weight:700}
#requestDetailModal .v801-correction-head-actions #rqDSelectedCount{white-space:nowrap}
@media(max-width:680px){#requestDetailModal .v801-correction-head-actions{justify-content:flex-start;width:100%}}
</style>
<script id="v801-solicitud-correccion-script">
(function(){
  'use strict';
  const byId=id=>document.getElementById(id);
  function selected(){
    if(typeof requestDetailRows==='undefined'||typeof requestSelectedIds==='undefined')return [];
    const ids=new Set([...requestSelectedIds].map(String));
    return (requestDetailRows||[]).filter(row=>row?.expediente_id && ids.has(String(row.expediente_id)));
  }
  window.v801SyncNumberButton=function(){
    const b=byId('v801CorrectionSelectedBtn');if(!b)return;
    const admin=typeof isAdmin==='function'&&isAdmin();
    const inRequest=!!byId('requestDetailModal')?.classList.contains('show');
    const items=selected();
    b.style.display=admin&&inRequest&&Array.isArray(requestDetailRows)&&requestDetailRows.length?'':'none';
    b.disabled=items.length!==1;
    b.title=items.length>1?'Seleccione únicamente un expediente para corregir su número.':
      items.length===0?'Seleccione un expediente en la tabla.':
      'Corregir '+String(items[0].expediente||'')+' sin crear otra solicitud y conservando el cargo.';
  };
  window.v801OpenSelectedNumberCorrection=function(){
    if(typeof isAdmin!=='function'||!isAdmin())return;
    const items=selected();
    if(items.length!==1){
      const msg='Seleccione solo un expediente de la tabla «Expedientes solicitados» para corregir su número.';
      const label=byId('rqActionStatus');if(label)label.textContent=msg;
      if(typeof showToast==='function')showToast(msg);
      return;
    }
    const expedienteId=String(items[0].expediente_id||'');
    if(!expedienteId||typeof window.v800OpenCorrection!=='function'){
      const label=byId('rqActionStatus');if(label)label.textContent='No se pudo abrir el corrector. Actualice el HTML V801.';
      return;
    }
    window.v800OpenCorrection(expedienteId);
  };
})();
</script>

<!-- V823: Selector de Estado en la misma sección de filtros y navegación segura entre tarjetas -->
<style id="v823-filtro-estado-style">
#statePendingFilters > .filters.v813-pending-grid{
 display:grid!important;grid-template-columns:minmax(150px,1.65fr) minmax(150px,1.25fr) minmax(155px,1.15fr) minmax(120px,.87fr) minmax(170px,1.25fr) max-content!important;
 gap:10px!important;align-items:end!important;max-width:100%!important;
}
#statePendingFilters .v823-state-field{min-width:0}
#statePendingFilters .v823-state-field label{font-weight:700}
#stateDetailBox .v823-state-nav{
 display:flex;align-items:end;gap:14px;flex-wrap:wrap;padding:11px 14px 9px;
 background:#f2f7fd;border-top:1px solid #dce9f6;border-bottom:1px solid #dce9f6;
}
#stateDetailBox .v823-state-nav.hidden{display:none!important}
#stateDetailBox .v823-state-nav-field{display:flex;flex-direction:column;gap:5px;min-width:235px;max-width:340px;flex:0 1 320px}
#stateDetailBox .v823-state-nav label{font-size:11px;font-weight:700;color:#40617e}
#stateDetailBox .v823-state-nav select{height:42px;width:100%;min-width:0;font-size:13px}
#stateDetailBox .v823-state-nav .v823-state-hint{margin:0;align-self:center;min-width:140px;flex:1;font-size:11px;color:#526980}
#stateDetailBox #v823ResetOther{height:42px;align-self:end;white-space:nowrap}
#statePendingFilters select:disabled,#stateDetailBox .v823-state-nav select:disabled{opacity:.6}
@container (max-width:1250px){#statePendingFilters > .filters.v813-pending-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important}}
@container (max-width:770px){#statePendingFilters > .filters.v813-pending-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
@container (max-width:480px){#statePendingFilters > .filters.v813-pending-grid{grid-template-columns:minmax(0,1fr)!important}}
@media(max-width:700px){#stateDetailBox .v823-state-nav-field{max-width:none;flex:1 1 100%}#stateDetailBox .v823-state-nav{gap:9px}#stateDetailBox #v823ResetOther{width:100%}}
</style>
<script id="v823-filtro-estado-js">
(function(){'use strict';
 const STATES=['PENDIENTE POR ATENDER','EN PRÉSTAMO','SOLICITUDES DE DEVOLUCIÓN','DEVUELTOS AL ARCHIVO'];
 const $=id=>document.getElementById(id);
 let changing=false;
 const access=()=>typeof tabAvailableForCurrentRole==='function'
   && tabAvailableForCurrentRole('states') && typeof currentProfile!=='undefined'
   && !!currentProfile && currentProfile.activo!==false;
 const privileged=()=> (typeof isAdmin==='function'&&isAdmin()) || (typeof isArchive==='function'&&isArchive());
 function isAllowed(state){
   if(!access()||!STATES.includes(state))return false;
   if(['PENDIENTE POR ATENDER','SOLICITUDES DE DEVOLUCIÓN'].includes(state) && !privileged())return false;
   // La preparación de listados de devueltos es exclusiva de Archivo/Administración.
   if(state==='DEVUELTOS AL ARCHIVO'&&!privileged())return false;
   return true;
 }
 function sync(state){
   const active=STATES.includes(state)?state:'';
   const privilegedNow=privileged();
   for(const select of [$('v823PendingEstado'),$('v823OtherEstado')]){
     if(!select)continue;
     for(const option of select.options){
       option.disabled=!isAllowed(option.value);
       option.hidden=!isAllowed(option.value);
     }
     if(active)select.value=active;
   }
   const nav=$('v823StateSwitcher');
   if(nav){nav.classList.toggle('hidden',!active||active==='PENDIENTE POR ATENDER'||!access());}
   const clear=$('v823ResetOther');if(clear)clear.disabled=!privilegedNow;
   const p=$('v823StateHint');
   if(p){
     p.textContent=active==='EN PRÉSTAMO'
       ?'Custodia activa. Combine con expediente, responsable, área y fechas.'
       :active==='SOLICITUDES DE DEVOLUCIÓN'
       ?'Devoluciones pendientes. Combine con búsqueda, responsable y ubicación de recepción.'
       :active==='DEVUELTOS AL ARCHIVO'
       ?'Expedientes devueltos. Combine con búsqueda, sede y situación del listado.'
       :'Cada estado utiliza sus filtros correspondientes.';
   }
 }
 async function change(next){
   if(changing)return;
   const current=typeof selectedState==='string'?selectedState:'';
   if(!isAllowed(next)){
     sync(current);
     if(typeof showToast==='function')showToast('No tiene permiso para consultar este estado.');
     return;
   }
   if(next===current){sync(current);return;}
   changing=true;
   for(const x of [$('v823PendingEstado'),$('v823OtherEstado')])if(x)x.disabled=true;
   try{
     if(typeof loadStateDetail!=='function')throw Error('No está disponible la tarjeta seleccionada');
     await loadStateDetail(next);
     $('stateDetailBox')?.scrollIntoView({behavior:'auto',block:'start'});
   }catch(e){
     console.warn('V823 cambio de estado:',e);
     if(typeof showToast==='function')showToast('No se pudo abrir el estado seleccionado.');
     sync(current);
   }finally{
     changing=false;
     for(const x of [$('v823PendingEstado'),$('v823OtherEstado')])if(x)x.disabled=false;
     sync(typeof selectedState==='string'?selectedState:current);
   }
 }
 async function clearAll(){
   if(changing || !access())return;
   // Limpiar criterios comunes y específicos; nunca confirma ni modifica expedientes.
   for(const id of ['pendingStateSearch','pendingStateModality','v813PendingSolicitante',
     'v740PendingCommunicationFilter','loanGlobalSearch','loanGlobalOwner',
     'loanGlobalArea','loanGlobalSituation','loanGlobalDateFrom','loanGlobalDateTo',
     'v504ReturnSearch','v504ReturnResponsible']){
       const x=$(id);if(x)x.value='';
   }
   window.v824ClearOwnerFilter?.(false);
   try{
     if(typeof returnedArchiveFilterStateV247!=='undefined'){
       returnedArchiveFilterStateV247={search:'',destino:'',status:''};
       if(typeof saveReturnedArchiveFilterStateV247==='function')saveReturnedArchiveFilterStateV247();
     }
     for(const id of ['returnedArchiveSearch','returnedArchiveDestination','returnedArchiveListStatus']){
       const x=$(id);if(x)x.value='';
     }
   }catch(e){console.warn('V823 limpieza de filtros de listados',e);}
   for(const x of [$('v823PendingEstado'),$('v823OtherEstado')])if(x)x.value='PENDIENTE POR ATENDER';
   if(isAllowed('PENDIENTE POR ATENDER')){
     if(typeof selectedState==='string'&&selectedState==='PENDIENTE POR ATENDER'){
       if(typeof renderPendingAttentionRows==='function')renderPendingAttentionRows();
       sync('PENDIENTE POR ATENDER');
     }else await change('PENDIENTE POR ATENDER');
   }else if(typeof loadStateDetail==='function'){
     if(typeof selectedState==='string'&&selectedState==='EN PRÉSTAMO'){
       if(typeof renderGlobalLoanRows==='function')renderGlobalLoanRows();
     }else await change('EN PRÉSTAMO');
   }
 }
 window.v823ChangeState=change;
 window.v823SyncStateFilters=sync;
 window.v823ClearAllStateFilters=clearAll;
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>sync(typeof selectedState==='string'?selectedState:''),{once:true});
 else sync(typeof selectedState==='string'?selectedState:'');
})();
</script>


<style id="v828-personal-requests-style">
#v828PersonalHelp{margin-top:9px;padding:9px 12px;border:1px solid #c9deef;border-left:3px solid #2d6090;border-radius:7px;background:#f4f9fe;font-size:11px;line-height:1.6;color:#254865}
#v828PersonalHelp.hidden{display:none!important}
</style>
<style id="v827-admin-request-style">
#v827AdminReview{margin:12px 0 4px;padding:12px;border:1px solid #c6d9eb;background:#f7fbff;border-radius:9px;color:#183c60}
#v827AdminReview.hidden{display:none!important}
#v827AdminReview .v827-review-header{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
