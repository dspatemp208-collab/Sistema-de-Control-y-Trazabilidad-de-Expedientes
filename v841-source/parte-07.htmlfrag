<style id="v723-cargo-materia-style">
  /* Una sola columna compacta; cargo y asunto del mismo ciclo. */
  .v723-cargo-materia{display:flex;flex-direction:column;gap:2px;max-width:325px;line-height:1.25;text-align:left;}
  .v723-cargo-label{font-size:10px;font-weight:900;color:#125187;white-space:nowrap;}
  .v723-asunto-label{font-size:10px;font-weight:700;color:#263d56;white-space:normal;overflow-wrap:anywhere;}
  td.v723-cargo-materia-cell{min-width:155px;max-width:345px;white-space:normal!important;}
  .v723-cargo-materia-empty{color:#8494a6;}
</style>
<style id="v724-single-value-style">
  /* V724: exactamente un dato por fila, compactado en un máximo de dos líneas. */
  td.v723-cargo-materia-cell{min-width:150px;max-width:310px;vertical-align:middle;}
  .v724-celda-dato{max-width:300px;overflow:hidden;display:-webkit-box;
    -webkit-box-orient:vertical;-webkit-line-clamp:2;line-clamp:2;
    font-size:10px;line-height:1.3;text-align:left;overflow-wrap:anywhere;}
  .v724-asunto{color:#253b54;font-weight:700;}
  .v724-cargo{color:#125187;font-weight:800;white-space:normal;}
</style>
<script id="v723-cargo-materia-cycle-sync">
/* V723: fuente única para cargo y materia: solicitud_id realmente ACTIVA.
   El cargo y el asunto se corresponden con el UUID del expediente;
   no se emparejan por número/año sin extensión. Solo lectura. */
const v723CargoMateriaCache=new Map();
function v723Clean(value){
  const t=String(value??'').trim();
  return t && t!=='—' && t!=='-' && t.toUpperCase()!=='NULL' && t.toUpperCase()!=='VARIOS'?t:'';
}
function v723FirstValid(...values){
  for(const value of values){const valid=v723Clean(value);if(valid)return valid;}
  return '';
}
/* V732 · Valor único para la columna Asunto en todas las tarjetas.
   Respeta el ciclo vigente confirmado; nunca recurre a cargo_materia,
   materia, cargo o cargo_numero para llenar un asunto ausente. */
function v732AsuntoValor(row){
  const r=row||{};
  if(r._v724_ciclo_comprobado) return v723Clean(r._v723_asunto);
  return v723FirstValid(
    r._v723_asunto,r.asunto,r.master_asunto,
    r.asunto_requerimiento,r.solicitud_asunto
  );
}
function v723CargoMateriaHtml(row){
  // V731: esta columna muestra exclusivamente el ASUNTO de la solicitud.
  // El cargo permanece en su propia columna; jamás usarlo como reemplazo.
  const asunto=v732AsuntoValor(row);
  if(asunto){
    return '<div class="v724-celda-dato v724-asunto" title="'+esc(asunto)+'">'+esc(asunto)+'</div>';
  }
  return '<span class="v723-cargo-materia-empty" title="Asunto no registrado">—</span>';
}
function v723IsHistorical(row){
  const r=row||{};
  const type=String(r._v184_activity||r._v530_relation||'').toUpperCase();
  if(['DEVUELTOS','CIERRE_ADMIN_ARCHIVO','COPIAS_DIGITALES'].includes(type))return true;
  const state=String(r.estado_item||r.estado_operativo||r.estado_actual||r.estado||'')
    .normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase();
  return state==='DEVUELTO'||state.includes('CERRADO POR ADMINISTRADOR')||state.includes('CERRADA POR ADMINISTRADOR');
}
async function v723EnrichCargoMateria(rows){
  const list=Array.isArray(rows)?rows:[];
  if(!list.length || !sb || !session)return list;
  const target=list.filter(r=>!v723IsHistorical(r));
  const getId=r=>String(r?.expediente_id||r?.id||'').trim();
  const ids=[...new Set(target.map(getId).filter(id=>/^[0-9a-f-]{36}$/i.test(id)))];
  if(!ids.length)return list;
  const fresh=new Map();
  const toQuery=[];
  const now=Date.now();
  for(const id of ids){
    const cached=v723CargoMateriaCache.get(id);
    if(cached && now-cached.at<12000){fresh.set(id,cached.value);}
    else toQuery.push(id);
  }
  if(toQuery.length){
    try{
      // Batch: no inventar datos si falla la consulta ni usar cargo de otro ciclo.
      const batches=[];
      for(let i=0;i<toQuery.length;i+=200)batches.push(toQuery.slice(i,i+200));
      const result=await Promise.all(batches.map(x=>sb.rpc('v723_cargo_materia_ciclo_vigente',{p_expediente_ids:x})));
      for(let i=0;i<result.length;i++){
        const {data,error}=result[i]||{};
        if(error)throw error;
        const byId=new Map((Array.isArray(data)?data:[]).map(x=>[String(x.expediente_id),x]));
        for(const id of batches[i]){
          const detail=byId.get(id)||null;
          v723CargoMateriaCache.set(id,{value:detail,at:Date.now()});
          if(detail)fresh.set(id,detail);
        }
      }
    }catch(error){
      console.warn('V723 · cargo y materia del ciclo vigente:',error?.message||error);
      // Error de acceso NO debe borrar lo que la fila ya contiene.
    }
  }
  return list.map(r=>{
    if(v723IsHistorical(r))return r;
    const detail=fresh.get(getId(r));
    if(!detail || !detail.solicitud_id)return r;
    // Si una tarjeta muestra expresamente un ciclo histórico distinto,
    // NO sustituir su cargo ni asunto por los de la solicitud activa.
    const requested=String(r.solicitud_id||r.solicitud_activa_id||'').trim();
    const current=String(detail.solicitud_id);
    if(requested && requested!==current)return r;
    const cargo=v723Clean(detail.cargo_numero);
    const asunto=v723Clean(detail.asunto);
    return {
      ...r,
      _v723_cargo:cargo,_v723_asunto:asunto,
      _v724_ciclo_comprobado:true,
      ...(cargo?{cargo, cargo_numero:cargo, cargo_actual:cargo}:{}),
      ...(asunto?{asunto,master_asunto:asunto}:{}),
      solicitud_id:requested||current,
      solicitud_numero:r.solicitud_numero||detail.solicitud_numero||''
    };
  });
}
async function v723EnrichSearchResults(rows){
  const list=Array.isArray(rows)?rows:[];
  const all=[];
  for(const item of list){
    all.push(item);
    for(const e of item?._v530_candidates||[])if(e?.row)all.push(e.row);
  }
  const enriched=await v723EnrichCargoMateria(all);
  let cursor=0;
  return list.map(item=>{
    const main=enriched[cursor++]||item;
    const candidates=(item?._v530_candidates||[]).map(e=>({
      ...e,row:e?.row?(enriched[cursor++]||e.row):e?.row
    }));
    return {...main,_v530_candidates:candidates};
  });
}
(function(){
  // No mantener HTML anterior con columnas incompletas luego del despliegue V723.
  try{
    const once='v723_cache_invalidation_once';
    if(sessionStorage.getItem(once)!=='1'){
      for(let i=sessionStorage.length-1;i>=0;i--){
        const k=sessionStorage.key(i)||'';
        if(k.startsWith('v353_panel_snapshot_'))sessionStorage.removeItem(k);
      }
      if(typeof invalidatePanelViewCacheV179==='function')invalidatePanelViewCacheV179();
      if(typeof v184UserGlobalSearchCache!=='undefined')v184UserGlobalSearchCache.clear();
      sessionStorage.setItem(once,'1');
    }
  }catch(_){ }
  // Coordinador: V716 devuelve filas completas pero omite el cargo/materia.
  const oldSelf=window.coordinatorSelfCardRowsV207;
  if(typeof oldSelf==='function'){
    window.coordinatorSelfCardRowsV207=async function(){
      const rows=await oldSelf.apply(this,arguments);
      return v723EnrichCargoMateria(rows);
    };
  }
  const oldTeam=window.coordinatorTeamRowsV218;
  if(typeof oldTeam==='function'){
    window.coordinatorTeamRowsV218=async function(){
      const rows=await oldTeam.apply(this,arguments);
      return v723EnrichCargoMateria(rows);
    };
  }
  window.v723CargoMateriaInfo=()=>({
    version:'V723',fuente:'v723_cargo_materia_ciclo_vigente',
    cache:v723CargoMateriaCache.size,
    criterio:'expediente UUID + solicitud vigente; histórico excluido'
  });
})();
</script>


<style id="v725-health-style-effective">
/* V725 · Recupera los estilos que V605/V607 dejó accidentalmente dentro
   de la plantilla JavaScript de impresión de listados (no estaban en el DOM).
   No modifica CSS ni flujo de los módulos operativos. */
.v605-health-pill{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border:1px solid #d9e4f0;border-radius:999px;background:#fff;color:#173f6b;font-weight:800;font-size:12px;box-shadow:0 1px 2px rgba(15,23,42,.04)}
.v605-health-pill .v605-dot{width:10px;height:10px;border-radius:999px;background:#94a3b8;display:inline-block}
.v605-health-pill[data-state="NORMAL"] .v605-dot,.v605-health-status[data-state="NORMAL"] .v605-dot,.v607-chip[data-state="NORMAL"]::before{background:#16a34a}
.v605-health-pill[data-state="PRECAUCION"] .v605-dot,.v605-health-status[data-state="PRECAUCION"] .v605-dot,.v607-chip[data-state="PRECAUCION"]::before{background:#f59e0b}
.v605-health-pill[data-state="ALTA_CARGA"] .v605-dot,.v605-health-status[data-state="ALTA_CARGA"] .v605-dot,.v607-chip[data-state="ALTA_CARGA"]::before{background:#ea580c}
.v605-health-pill[data-state="PROTECCION"] .v605-dot,.v605-health-status[data-state="PROTECCION"] .v605-dot,.v607-chip[data-state="PROTECCION"]::before{background:#dc2626}
.v605-health-pill[data-state="SIN_DATOS"] .v605-dot,.v607-chip[data-state="SIN_DATOS"]::before{background:#94a3b8}
.v607-health-modal-box{max-width:980px}
.v607-health-hero{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin:8px 0 12px;padding:14px;border:1px solid #dbe4ee;border-radius:14px;background:linear-gradient(180deg,#f8fbff 0%,#f2f7fc 100%)}
.v607-health-overview{flex:1;min-width:0}
.v607-chip{display:inline-flex;align-items:center;gap:8px;padding:7px 12px;border-radius:999px;border:1px solid #dbe4ee;background:#fff;color:#173f6b;font-weight:900;font-size:12px}
.v607-chip::before{content:"";display:inline-block;width:10px;height:10px;border-radius:999px;background:#94a3b8}
.v607-health-overview h3{margin:10px 0 6px;color:#173f6b;font-size:22px;line-height:1.15}
.v607-health-overview p{margin:0;color:#52677d;font-size:13px;line-height:1.45}
.v607-minirow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:14px}
.v607-mini{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:10px 12px}
.v607-mini span{display:block;font-size:11px;font-weight:800;color:#64748b;text-transform:uppercase;letter-spacing:.04em}
.v607-mini b{display:block;margin-top:4px;color:#173f6b;font-size:14px}
.v607-actions-panel{display:flex;flex-direction:column;gap:8px;min-width:210px}
.v607-actions-panel .btn{width:100%;justify-content:center}
.v607-health-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:12px 0}
.v607-health-card{border:1px solid #dbe4ee;border-radius:14px;background:#fff;padding:13px;box-shadow:0 1px 2px rgba(15,23,42,.04)}
.v607-health-card .eyebrow{font-size:11px;font-weight:900;color:#64748b;text-transform:uppercase;letter-spacing:.05em}
.v607-health-card .big{font-size:26px;line-height:1.1;font-weight:900;color:#173f6b;margin:6px 0 4px}
.v607-health-card .sub{font-size:12px;line-height:1.45;color:#52677d}
.v607-health-card .state-chip{display:inline-flex;align-items:center;gap:6px;margin-top:8px;padding:4px 9px;border-radius:999px;font-size:11px;font-weight:900;border:1px solid #e2e8f0;background:#f8fafc;color:#173f6b}
.v607-health-card .state-chip::before{content:"";display:inline-block;width:8px;height:8px;border-radius:999px;background:#94a3b8}
.v607-health-card .state-chip[data-state="NORMAL"]::before{background:#16a34a}
.v607-health-card .state-chip[data-state="PRECAUCION"]::before{background:#f59e0b}
.v607-health-card .state-chip[data-state="ALTA_CARGA"]::before{background:#ea580c}
.v607-health-card .state-chip[data-state="PROTECCION"]::before{background:#dc2626}
.v607-health-tips{margin:12px 0;border:1px solid #dbe4ee;border-radius:14px;background:#fff;padding:14px}
.v607-health-tips strong{display:block;font-size:13px;color:#173f6b;margin-bottom:8px}
.v607-health-tips ul{margin:0;padding-left:18px;color:#52677d;font-size:13px;line-height:1.5}
.v607-health-tips li+li{margin-top:4px}
.v607-health-details{margin-top:12px;border:1px solid #dbe4ee;border-radius:14px;background:#fff;overflow:hidden}
.v607-health-details>summary{list-style:none;cursor:pointer;padding:12px 14px;font-weight:900;color:#173f6b;background:#eef4fa;display:flex;align-items:center;justify-content:space-between}
.v607-health-details>summary::-webkit-details-marker{display:none}
.v607-health-details>summary::after{content:"Mostrar detalle técnico";font-size:12px;color:#64748b;font-weight:700}
.v607-health-details[open]>summary::after{content:"Ocultar detalle técnico"}
.v607-health-detail-body{padding:12px}
.v605-health-section{margin-top:12px;border:1px solid #dbe4ee;border-radius:12px;overflow:hidden}
.v605-health-section-head{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 11px;background:#eef4fa;border-bottom:1px solid #dbe4ee}
.v605-health-section-head strong{font-size:12px;color:#173f6b}
.v605-health-table{width:100%;border-collapse:collapse}
.v605-health-table th,.v605-health-table td{padding:8px 10px;border-bottom:1px solid #edf1f5;font-size:12px;text-align:left}
.v605-health-table th{background:#f8fafc;color:#53687d;width:26%}
.v605-health-table tr:last-child td,.v605-health-table tr:last-child th{border-bottom:0}
.v605-health-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:14px;align-items:center;flex-wrap:wrap}.v605-health-stamp{margin-right:auto;font-size:11px;color:#64748b}
.v605-health-banner{padding:9px 11px;border-radius:10px;font-size:12px;margin-top:10px;background:#f8fafc;border:1px solid #dbe4ee;color:#334155;line-height:1.45}.v605-health-banner.warn{background:#fff7ed;border-color:#fed7aa;color:#9a3412}.v605-health-banner.bad{background:#fef2f2;border-color:#fecaca;color:#991b1b}
@media(max-width:900px){.v607-health-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.v607-health-hero{flex-direction:column}.v607-actions-panel{width:100%}.v607-minirow{grid-template-columns:1fr}}
@media(max-width:600px){.v607-health-grid{grid-template-columns:1fr}.v605-health-table th,.v605-health-table td{font-size:11px;padding:7px 8px}.v605-health-actions{flex-direction:column;align-items:stretch}.v605-health-stamp{margin-right:0}}
/* Ajustes de ancho: paneles y tarjetas legibles en ventana reducida. */
#v605HealthModal .v607-health-modal-box{width:min(980px,calc(100vw - 28px));max-width:980px;max-height:calc(100vh - 30px);overflow-y:auto;box-sizing:border-box;}
#v605HealthModal .v607-health-card{min-width:0;overflow-wrap:anywhere;}
#v605HealthModal .v607-health-card .big{font-variant-numeric:tabular-nums;overflow-wrap:anywhere;}
#v605HealthModal .v607-health-hero{min-width:0;}
#v605HealthModal .v607-health-overview{min-width:0;}
#v605HealthModal .v607-health-minirow{min-width:0;}
#v605HealthModal .v607-actions-panel{min-width:175px;}
#v605HealthModal .modal-head .note{font-size:12px;color:#64748b;}
@media(max-width:900px){#v605HealthModal .v607-health-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){#v605HealthModal .v607-health-grid{grid-template-columns:1fr}#v605HealthModal .v607-health-hero{flex-direction:column}#v605HealthModal .v607-actions-panel{min-width:0;width:100%}#v605HealthModal .v607-minirow{grid-template-columns:1fr}}
</style>


<style id="v726-mail-status-style">
#v726MailBar{display:none;align-items:center;gap:10px;flex-wrap:wrap;background:#f4f7fd;border:1px solid #cbd8ec;border-radius:10px;padding:9px 11px;margin:7px 0 11px;font-size:12px;color:#16365e}
#v726MailBar.v726-blocked{background:#fff3e4;border-color:#f2c58c;color:#79450e}
#v726MailBar.v726-error{background:#fff0f0;border-color:#e9b2b2;color:#812020}
#v726MailBar .v726-icon{font-size:16px;line-height:1}
#v726MailBar .v726-copy{flex:1;min-width:210px}
#v726MailBar strong{display:block;font-size:12px}
#v726MailBar small{display:block;font-size:11px;margin-top:2px}
#v726MailBar button,.v726-button{font:inherit;padding:6px 11px;border-radius:7px;background:#fff;color:#174675;border:1px solid #b4c7e4;cursor:pointer;font-weight:650}
#v726MailBar button:hover,.v726-button:hover{background:#ecf3fe}
#v726MailModal{position:fixed;inset:0;background:rgba(20,35,58,.53);z-index:200090;display:none;align-items:center;justify-content:center;padding:20px}
#v726MailModal.v726-open{display:flex}
#v726MailModal .v726-shell{background:#fff;border:1px solid #cbd7e7;border-radius:13px;box-shadow:0 12px 40px #13233d39;max-width:950px;width:100%;max-height:86vh;overflow:hidden;display:flex;flex-direction:column}
#v726MailModal .v726-head{display:flex;gap:10px;align-items:center;justify-content:space-between;padding:14px 17px;border-bottom:1px solid #d7e2ef}
#v726MailModal h3{font-size:18px;margin:0;color:#123964}
#v726MailModal .v726-body{padding:14px 17px;overflow:auto}
#v726MailModal .v726-hint{font-size:12px;color:#53677d;line-height:1.5}
#v726MailModal .v726-actions{display:flex;gap:7px;flex-wrap:wrap;padding:9px 17px;border-top:1px solid #e3e9f4}
#v726MailTable{width:100%;border-collapse:collapse;font-size:12px;table-layout:auto}
#v726MailTable th{background:#1b416d;color:#fff;font-weight:650;text-align:left}
#v726MailTable th,#v726MailTable td{padding:8px;border:1px solid #d8e3f0;vertical-align:top}
#v726MailTable tbody tr:nth-child(even){background:#f5f8fd}
#v726MailTable .v726-pill{display:inline-block;border-radius:10px;padding:3px 7px;font-weight:650;background:#eef4fc;color:#163e67;line-height:1.3}
#v726MailTable .v726-pill.v726-warning{color:#875111;background:#fff0d6}
#v726MailTable .v726-pill.v726-failed{color:#922b27;background:#fdeaea}
#v726MailTable .v726-pill.v726-sent{color:#176b4c;background:#e5f5eb}
#v726MailTable .v726-muted{font-size:11px;color:#506278;margin-top:3px}
@media(max-width:650px){#v726MailModal{padding:8px}#v726MailModal .v726-head,#v726MailModal .v726-body,#v726MailModal .v726-actions{padding:10px}#v726MailTable{font-size:11px}#v726MailTable th,#v726MailTable td{padding:5px}}
</style>
<script id="v726-mail-status-script">
(function(){
 'use strict';
 const H='<div id="v726MailBar" role="status" aria-live="polite"><span class="v726-icon">✉</span><div class="v726-copy"><strong id="v726MailTitle">Consultando estado de correo...</strong><small id="v726MailSubtitle">La operación y su notificación son procesos distintos.</small></div><button id="v726MailOpen" type="button">Ver estado de correos</button></div>';
 const M='<div id="v726MailModal" role="dialog" aria-modal="true" aria-labelledby="v726MailModalTitle"><div class="v726-shell"><div class="v726-head"><h3 id="v726MailModalTitle">Estado de mis correos</h3><button type="button" class="v726-button" id="v726MailClose">Cerrar</button></div><div class="v726-body"><div id="v726MailSummary" class="v726-hint"></div><div style="overflow-x:auto;margin-top:11px"><table id="v726MailTable"><thead><tr><th>Operación</th><th>Fecha</th><th>Estado real del correo</th><th>Destinatarios</th><th>Control</th></tr></thead><tbody id="v726MailRows"><tr><td colspan="5">Consultando notificaciones...</td></tr></tbody></table></div><p class="v726-hint">«Aceptado por Gmail» significa que Gmail recibió el mensaje para procesamiento. No garantiza que llegue al buzón. La entrega solo se mostrará como confirmada cuando exista evidencia verificable del proveedor.</p></div><div class="v726-actions"><button type="button" class="v726-button" id="v726MailRefresh">Actualizar estado</button><button type="button" class="v726-button" id="v726MailTest" style="display:none">Enviar prueba controlada</button><span id="v726MailTestResult" class="v726-hint" style="align-self:center"></span></div></div></div>';
 let lastService='DESCONOCIDO',lastBlockedAt=0,cache=null,busy=false,timer=null,sessionOwner='';
 const $=id=>document.getElementById(id);
 const norm=v=>String(v??'').trim();
 const esc=v=>norm(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const shortTime=v=>{try{return v?new Date(v).toLocaleString('es-PE',{dateStyle:'short',timeStyle:'short'}):'—'}catch(_){return '—'}};
 const own=()=>{try{return session?.user?.id||''}catch(_){return ''}};
 const logged=()=>{try{return !!(sb&&session?.user?.id&&currentProfile)}catch(_){return false}};
 function isBlock(){return lastService==='BLOQUEADO_OAUTH'&&Date.now()-lastBlockedAt<60000}
 window.v726MailPaused=isBlock;
 function decorate(){
   if(!$('v726MailBar')){
     const anchor=$('desktopNotifyBtnV467')||$('v558ExternalNotifyTestBtn');
     const container=anchor?.closest?.('.actions')||anchor?.parentElement||document.querySelector('main')||document.body;
     if(container===document.body)document.body.insertAdjacentHTML('afterbegin',H);
     else container.insertAdjacentHTML('afterend',H);
   }
   if(!$('v726MailModal'))document.body.insertAdjacentHTML('beforeend',M);
   $('v726MailOpen')?.addEventListener('click',()=>{render();$('v726MailModal')?.classList.add('v726-open');refresh(true)});
   $('v726MailClose')?.addEventListener('click',()=>{$('v726MailModal')?.classList.remove('v726-open')});
   $('v726MailModal')?.addEventListener('click',e=>{if(e.target===$('v726MailModal'))$('v726MailModal').classList.remove('v726-open')});
   $('v726MailRefresh')?.addEventListener('click',()=>refresh(true));
   $('v726MailRows')?.addEventListener('click',e=>{const b=e.target?.closest?.('[data-v726-retry]');if(b)retryOne(b.getAttribute('data-v726-retry'))});
   $('v726MailTest')?.addEventListener('click',test);
   document.addEventListener('keydown',e=>{if(e.key==='Escape')$('v726MailModal')?.classList.remove('v726-open')});
 }
 function classification(r){
   if(r.entregado_confirmado_at)return ['Entrega confirmada','v726-sent','Confirmada con evidencia registrada'];
   if(r.estados?.includes('REVISAR_ENTREGA'))return ['Verificar antes de reintentar','v726-failed','Gmail pudo haber aceptado el mensaje; no repetir automáticamente'];
   if(r.estados?.includes('ERROR'))return ['Error de envío','v726-failed',r.ultimo_error||'Consulte al administrador'];
   if(r.estados?.includes('ENVIANDO'))return ['En procesamiento','v726-warning','Esperando respuesta del proveedor'];
   if(r.estados?.includes('PENDIENTE'))return ['Pendiente de envío','v726-warning',lastService==='BLOQUEADO_OAUTH'?'Gmail sin autorización; mensaje no enviado':'Registrado en la cola; aún no aceptado por Gmail'];
   if(r.estados?.includes('ENVIADO'))return r.aceptado_at||r.id_proveedor
      ? ['Aceptado por Gmail','v726-sent','Entrega al destinatario no confirmada']
      : ['Registrado como enviado','v726-warning','No existe acuse del proveedor guardado para este mensaje histórico'];
   return [norm(r.estado)||'Sin confirmar','v726-warning',''];
 }
 function render(){
   if(!$('v726MailBar'))return;
   const bar=$('v726MailBar');bar.style.display=logged()?'flex':'none';
   // V729: el alcance lo define Supabase mediante la sesión validada, no el navegador.
   const allMail=cache?.alcance==='TODOS' && norm(currentProfile?.rol).toUpperCase()==='ADMINISTRADOR';
   const title=$('v726MailModalTitle');
   if(title)title.textContent=allMail?'Estado de todos los correos del sistema':'Estado de mis correos';
   const rows=Array.isArray(cache?.notificaciones)?cache.notificaciones:[];
   const summary=cache?.resumen||{};
   const blocked=lastService==='BLOQUEADO_OAUTH';
   bar.classList.toggle('v726-blocked',blocked);
   bar.classList.toggle('v726-error',lastService==='ERROR_PROVEEDOR');
   $('v726MailTitle').textContent=blocked?'⚠ Correo detenido: renovar autorización de Gmail':lastService==='ERROR_PROVEEDOR'?'⚠ El servicio de correo presenta un error':lastService==='OPERATIVO'?'Correo habilitado · consulte cada envío':'Estado de correo pendiente de comprobar';
   $('v726MailSubtitle').textContent=blocked?'Sus solicitudes se registran, pero los correos quedan pendientes. No se ha confirmado ningún envío nuevo.':lastService==='OPERATIVO'?'La aceptación de Gmail se comprueba por cada operación. La entrega final no está confirmada automáticamente.':'Las operaciones pueden guardarse aunque la notificación no llegue a enviarse.';
   $('v726MailSummary').textContent=(blocked?'Gmail tiene la autorización OAuth vencida o revocada. No se están enviando mensajes. ':'')+
     `${allMail?'Notificaciones recientes del sistema':'Notificaciones recientes de sus operaciones'}: ${summary.pendientes??0} pendientes, ${summary.aceptados??0} registradas como enviadas, ${summary.errores??0} con error. `+
     'La lista es una consulta reciente, no el total histórico.';
   const tbody=$('v726MailRows');
   if(tbody){tbody.innerHTML=rows.length?rows.map(r=>{
     const [name,cls,info]=classification(r);
     return `<tr><td><strong>${esc(String(r.tipo||'').replaceAll('_',' '))}</strong>${r.referencia?`<div class="v726-muted">${esc(r.referencia)}</div>`:''}</td>`+
       `<td>${esc(shortTime(r.creado_at))}</td>`+
       `<td><span class="v726-pill ${cls}">${esc(name)}</span><div class="v726-muted">${esc(info)}</div></td>`+
       `<td>${Number(r.destinatarios)||1}</td>`+
       `<td>${['ADMINISTRADOR','ARCHIVO'].includes(norm(currentProfile?.rol).toUpperCase())&&r.estados?.length===1&&r.estados[0]==='ERROR' ? `<button type="button" class="v726-button" data-v726-retry="${esc(r.key)}">Reintentar</button>` : '—'}</td></tr>`;
   }).join(''):'<tr><td colspan="5">No se encontraron notificaciones recientes generadas por sus operaciones.</td></tr>'}
   const role=norm(currentProfile?.rol).toUpperCase();
   if($('v726MailTest'))$('v726MailTest').style.display=['ADMINISTRADOR','ARCHIVO'].includes(role)?'':'none';
 }
 async function refresh(force=false){
   if(busy||!logged())return null;
   if(typeof window.v562InvokeExternalFunction!=='function')return null;
   busy=true;
   try{
     const {data,error}=await window.v562InvokeExternalFunction({mode:'status'});
     if(error)throw error;
     if(!data?.ok)throw new Error(data?.error||'Sin respuesta válida');
     cache=data;lastService=norm(data.servicio?.estado).toUpperCase()||'DESCONOCIDO';
     lastBlockedAt=lastService==='BLOQUEADO_OAUTH'?(Date.parse(data.servicio?.revisado_at)||Date.now()):0;
     $('v726MailTestResult').textContent='Actualizado: '+shortTime(new Date().toISOString());
     render();return data;
   }catch(err){
     if($('v726MailTestResult'))$('v726MailTestResult').textContent='Error al consultar el estado: '+norm(err?.message||err);
     render();return null;
   }finally{busy=false}
 }
 window.v726ConsultarEstadoCorreo=refresh;
 async function retryOne(key){
   if(!key||!logged()||!['ADMINISTRADOR','ARCHIVO'].includes(norm(currentProfile?.rol).toUpperCase()))return;
   if(!confirm('¿Reintentar únicamente los destinatarios de esta operación que figuran en ERROR? No se reenvían correos aceptados por Gmail.'))return;
   const target=$('v726MailTestResult');if(target)target.textContent='Verificando la operación antes del reintento...';
   try{
     const {data,error}=await window.v562InvokeExternalFunction({mode:'retry_error',event_key:key});
     if(error||!data?.ok)throw new Error(error?.message||data?.error||'El proveedor no confirmó el reintento');
     const confirmados=(data?.resultados||[]).filter(x=>x.estado==='ENVIADO'&&x.gmail_id).length;
     if(target)target.textContent=confirmados?'Reintento aceptado por Gmail. Entrega al buzón sin confirmar.':'No se obtuvo aceptación de Gmail; revise la cola.';
   }catch(err){if(target)target.textContent='No se realizó el reintento: '+norm(err?.message||err)}
   await refresh(true);
 }
 async function test(){
   if(!logged()||!['ARCHIVO','ADMINISTRADOR'].includes(norm(currentProfile?.rol).toUpperCase()))return;
   if(!confirm('¿Enviar un único correo de prueba a su cuenta institucional? No se reenviarán correos de la cola.'))return;
   const btn=$('v726MailTest');if(btn)btn.disabled=true;
   try{
     const {data,error}=await window.v562InvokeExternalFunction({mode:'test'});
     if(error||!data?.ok)throw new Error(error?.message||data?.error||'Gmail no aceptó el envío');
     if(!data?.gmail_id)throw new Error('El proveedor no devolvió identificador de aceptación');
     $('v726MailTestResult').textContent='Prueba aceptada por Gmail (ID disponible). Entrega al buzón no confirmada.';
     await refresh(true);
   }catch(err){
     $('v726MailTestResult').textContent='Prueba fallida: '+norm(err?.message||err);
     await refresh(true);
   }finally{if(btn)btn.disabled=false}
 }
 function operationsClicked(event){
   const btn=event.target?.closest?.('button');if(!btn||!logged())return;
   const sig=(norm(btn.textContent)+' '+norm(btn.id)+' '+norm(btn.getAttribute('onclick'))).toUpperCase();
   if(!/(ENVIAR SOLICITUD|REASIGN|DEVOLV|ATENDER SOLICITUD|ENTREGAR|CONFIRMAR RECEPCI|COPIA DIGITAL|DERIVAR A)/.test(sig))return;
   setTimeout(()=>refresh(true),2200);
   setTimeout(()=>refresh(true),8500);
 }
 function guardToast(){
   const f=window.showToast;
   if(typeof f!=='function'||f.__v726Checked)return;
   function guarded(message,time){
     let value=norm(message);
     if(/correo\s+(?:de\s+reasignaci[oó]n\s+)?enviado\b|correo\s+procesado\s+en\s+segundo\s+plano/i.test(value)){
       value='✉ Aviso registrado. Compruebe en «Ver estado de correos» si Gmail aceptó el mensaje.';
     }
     return f.call(this,value,time);
   }
   guarded.__v726Checked=true;
   window.showToast=guarded;
 }
 function boot(){
   decorate();guardToast();render();
   document.addEventListener('click',operationsClicked,true);
   timer=setInterval(()=>{
     guardToast();
     const who=own();
     if(who!==sessionOwner){sessionOwner=who;cache=null;lastService='DESCONOCIDO';lastBlockedAt=0;render();}
     if(logged())refresh(false);else render();
   },60000);
   setTimeout(()=>refresh(true),2200);
   setTimeout(()=>refresh(true),6500);
   window.addEventListener('focus',()=>setTimeout(()=>refresh(true),700),{passive:true});
   window.addEventListener('online',()=>setTimeout(()=>refresh(true),900),{passive:true});
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>


<!-- V734: gestion de correos de notificacion desde Usuarios y permisos / Correos de notificacion.
     Los permisos se validan en RPC SECURITY DEFINER de Supabase, no en el cliente. -->
<style id="v734-admin-mail-style">
#v734MailLinks{border:1px solid #cbd5e1;border-radius:12px;padding:14px;margin:12px 0;background:#f8fafc}
#v734MailLinks .v734-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:10px}
#v734MailLinks .v734-grid{display:grid;grid-template-columns:minmax(210px,1.25fr) minmax(225px,1.2fr);gap:10px}
#v734MailLinks .v734-grid label{display:block;font-size:11px;font-weight:700;color:#334155;margin-bottom:4px}
#v734MailLinks .v734-grid select,#v734MailLinks .v734-grid input{width:100%;min-height:36px;border-radius:8px;border:1px solid #cbd5e1;padding:8px;background:white;color:#0f172a}
#v734MailLinks .v734-meta{display:flex;gap:12px;flex-wrap:wrap;background:#fff;padding:9px;border:1px solid #e2e8f0;border-radius:8px;font-size:11px;margin:10px 0}
#v734MailLinks .v734-meta b{color:#0f3767}
#v734MailLinks .v734-actions{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}
#v734MailLinks .v734-actions button{padding:7px 10px;min-height:33px;font-size:11px}
#v734MailLinks .v734-table-wrap{overflow:auto;max-height:260px;background:white;border:1px solid #dae2ee;border-radius:8px}
#v734MailLinks table{border-collapse:collapse;min-width:660px;width:100%;font-size:11px}
#v734MailLinks th,#v734MailLinks td{padding:7px 9px;text-align:left;border-bottom:1px solid #e2e8f0;vertical-align:top}
#v734MailLinks th{position:sticky;top:0;background:#eaf2fc;color:#173b61}
#v734MailLinks .v734-muted{color:#64748b;font-size:10px}
#v734MailLinks #v734MailInfo{font-size:11px;white-space:normal;min-height:18px}
#v734MailLinks .v734-row{cursor:pointer}
#v734MailLinks .v734-row:hover{background:#edf5ff}
#v734MailLinks .v734-row[aria-selected="true"]{background:#d9ecff}
@media(max-width:700px){#v734MailLinks .v734-grid{grid-template-columns:1fr}}
</style>
<script id="v734-admin-mail-script">
(function(){
  'use strict';
  const $ = id => document.getElementById(id);
  const clean = x => String(x??'').trim();
  const esc = x => clean(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  let rows=[],log=[],loading=false,working=false;
  function isAdmin(){return String(window.currentProfile?.rol||(typeof currentProfile!=='undefined'?currentProfile?.rol:'')||'').trim().toUpperCase()==='ADMINISTRADOR'}
  function boxHtml(){return `<section id="v734MailLinks" aria-label="Administrar vinculos de correo">
    <div class="v734-head"><div><b>🔗 Vinculación de correos por usuario</b><div class="v734-muted">Solo el Administrador puede asociar, cambiar o desactivar correos. <b>No modifica la cuenta de inicio de sesión.</b></div></div>
    <button class="btn secondary small" type="button" onclick="v734LoadMailLinks()">↻ Actualizar</button></div>
    <div class="v734-grid">
      <div><label for="v734UserSelect">Usuario del sistema</label><select id="v734UserSelect" onchange="v734PickUser()"><option value="">Seleccione usuario...</option></select></div>
      <div><label for="v734MailNew">Correo de notificación</label><input id="v734MailNew" type="email" maxlength="254" autocomplete="off" placeholder="correo@produce.gob.pe"/></div>
    </div>
    <div class="v734-meta" id="v734MailMeta">Seleccione un usuario para consultar su vinculación.</div>
    <div class="v734-actions">
      <button type="button" class="btn" onclick="v734Act('VINCULAR')" id="v734LinkBtn">Vincular</button>
      <button type="button" class="btn secondary" onclick="v734Act('CAMBIAR')" id="v734ChangeBtn">Cambiar correo</button>
      <button type="button" class="btn secondary" onclick="v734Act('DESVINCULAR')" id="v734UnlinkBtn">Desvincular</button>
      <button type="button" class="btn secondary" onclick="v734Act('ACTIVAR')" id="v734EnableBtn">Habilitar notificaciones</button>
      <button type="button" class="btn secondary" onclick="v734Act('DESACTIVAR')" id="v734DisableBtn">Deshabilitar notificaciones</button>
    </div>
    <div id="v734MailInfo" class="note" role="status" aria-live="polite"></div>
    <div class="v734-grid" style="margin:10px 0">
      <div><label for="v734Search">Buscar usuario o correo</label><input id="v734Search" placeholder="Filtrar usuarios..." oninput="v734RenderRows()" /></div>
      <div style="align-self:end"><span class="v734-muted">Usuarios vinculados, sin vincular e inactivos. Seleccione una fila para gestionarla.</span></div>
    </div>
    <div class="v734-table-wrap"><table><thead><tr><th>Usuario</th><th>Correo de acceso</th><th>Correo de notificación</th><th>Estado</th></tr></thead><tbody id="v734UsersTable"><tr><td colspan="4">Cargando...</td></tr></tbody></table></div>
    <details style="margin-top:10px" id="v734AuditDetails"><summary style="cursor:pointer;font-size:11px;font-weight:bold">Historial de modificaciones de correos</summary>
      <div class="v734-table-wrap" style="max-height:200px;margin-top:8px"><table><thead><tr><th>Fecha</th><th>Acción</th><th>Administrador</th><th>Antes</th><th>Después</th></tr></thead><tbody id="v734AuditTable"></tbody></table></div>
    </details>
    <div class="v734-muted" style="margin-top:9px">Los cambios quedan auditados en Supabase. Desvincular un correo no elimina el usuario, su perfil ni su historial. Cambiar el correo de autenticación requiere un procedimiento independiente.</div>
  </section>`}
  function mount(){
    const modal=$('v560MailAdminModal');if(!modal||!isAdmin())return false;
    if(!$('v734MailLinks')){
      const target=$('v560MailAdminTable');
      if(!target)return false;
      target.insertAdjacentHTML('beforebegin',boxHtml());
    }
    return true;
  }
  function info(message,error=false){const el=$('v734MailInfo');if(el){el.textContent=message;el.style.color=error?'#b91c1c':'#1e4977'}}
  function activeRow(){return rows.find(r=>String(r.usuario_id)===String($('v734UserSelect')?.value||''))}
  function updateButtons(){
    const r=activeRow(), has=!!r?.destinatario_id, enabled=!!r?.notificaciones_habilitadas;
    const allowed=!!r?.usuario_activo;
    for(const [id,yes] of [['v734LinkBtn',!!r&&allowed&&!has],['v734ChangeBtn',!!r&&allowed&&has],['v734UnlinkBtn',!!r&&has],['v734EnableBtn',!!r&&has&&!enabled&&allowed],['v734DisableBtn',!!r&&has&&enabled]]){
      const btn=$(id);if(btn)btn.disabled=working||!yes;
    }
  }
  function pickUser(){
    const r=activeRow();if(!r){$('v734MailMeta').textContent='Seleccione un usuario.';updateButtons();return}
    if($('v734MailNew'))$('v734MailNew').value=r.correo_notificacion||'';
    const st=r.destinatario_id?(r.notificaciones_habilitadas?'HABILITADO':'DESHABILITADO'):'SIN VINCULAR';
    $('v734MailMeta').innerHTML=`<span><b>Inicio de sesión:</b> ${esc(r.correo_acceso)}</span><span><b>Notificaciones:</b> ${esc(r.correo_notificacion||'Sin correo vinculado')}</span><span><b>Estado:</b> ${st}${r.usuario_activo?'':' · USUARIO INACTIVO'}</span>`;
    updateButtons();
  }
  function renderRows(){
    const query=clean($('v734Search')?.value).toLowerCase(),tbl=$('v734UsersTable');if(!tbl)return;
    const selected=$('v734UserSelect')?.value;
    let vis=rows.filter(r=>!query||[r.nombre,r.correo_acceso,r.correo_notificacion,r.rol].some(x=>String(x||'').toLowerCase().includes(query)));
    tbl.innerHTML=vis.map(r=>{
      const st=!r.destinatario_id?'Sin vincular':r.notificaciones_habilitadas?'Habilitado':'Deshabilitado';
      return `<tr class="v734-row" tabindex="0" aria-selected="${r.usuario_id===selected}" data-id="${esc(r.usuario_id)}">
        <td><b>${esc(r.nombre)}</b><div class="v734-muted">${esc(r.rol)}${r.usuario_activo?'':' · INACTIVO'}</div></td>
        <td>${esc(r.correo_acceso)}</td><td>${esc(r.correo_notificacion||'—')}</td><td>${esc(st)}</td></tr>`
    }).join('')||'<tr><td colspan="4">Sin resultados</td></tr>';
    tbl.querySelectorAll('tr[data-id]').forEach(tr=>{
      const choose=()=>{if($('v734UserSelect'))$('v734UserSelect').value=tr.dataset.id;pickUser();renderRows()};
      tr.addEventListener('click',choose);
      tr.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();choose()}});
    });
  }
  function renderAudit(){
    const target=$('v734AuditTable');if(!target)return;
    target.innerHTML=log.map(x=>`<tr><td>${esc(x.fecha?new Date(x.fecha).toLocaleString('es-PE'):'—')}</td><td>${esc(x.operacion)}</td><td>${esc(x.administrador)}</td><td>${esc(x.correo_anterior||'—')}</td><td>${esc(x.correo_nuevo||'—')}</td></tr>`).join('')||'<tr><td colspan="5">Sin cambios registrados</td></tr>';
  }
  async function load(){
    if(!isAdmin()||!mount()||loading)return;
    const select=$('v734UserSelect');const old=select?.value||'';
    loading=true;info('Cargando vínculos de usuarios...');
    try{
      const [links,history]=await Promise.all([
        sb.rpc('v734_admin_listar_vinculos'),
        sb.rpc('v734_admin_historial_vinculos',{p_limite:60})]);
      if(links.error)throw links.error;if(history.error)throw history.error;
      rows=Array.isArray(links.data)?links.data:[];
      log=Array.isArray(history.data)?history.data:[];
      select.innerHTML='<option value="">Seleccione usuario...</option>'+rows.map(r=>`<option value="${esc(r.usuario_id)}">${esc(r.nombre)} · ${esc(r.correo_acceso)}</option>`).join('');
      if(rows.some(x=>x.usuario_id===old))select.value=old;
      pickUser();renderRows();renderAudit();info(`Cargados ${rows.length} perfiles. Los cambios se guardan de forma segura en Supabase.`);
    }catch(e){info('No se pudo consultar la administración de correos: '+(e?.message||String(e)),true)}
    finally{loading=false}
  }
  async function act(action){
    if(!isAdmin()){info('Solo el Administrador puede modificar vínculos.',true);return}
    const r=activeRow();if(!r)return info('Seleccione un usuario.',true);
    const email=clean($('v734MailNew')?.value).toLowerCase();
    if(['VINCULAR','CAMBIAR'].includes(action) && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))return info('Ingrese un correo válido.',true);
    if(action==='CAMBIAR' && email===String(r.correo_notificacion||'').toLowerCase())return info('Ingrese una dirección distinta para cambiar el correo.',true);
    const desc={VINCULAR:`Vincular ${email} a ${r.nombre}`,CAMBIAR:`Cambiar el correo de ${r.nombre} a ${email}. El anterior se desactivará`,DESVINCULAR:`Desvincular y desactivar el correo de ${r.nombre}`,ACTIVAR:`Habilitar las notificaciones de ${r.nombre}`,DESACTIVAR:`Deshabilitar las notificaciones de ${r.nombre}`} [action];
    if(!window.confirm(`${desc}?\n\nNo modifica el inicio de sesión ni el historial.`))return;
    working=true;updateButtons();info('Guardando operación...');
    try{
      const {data,error}=await sb.rpc('v734_admin_configurar_correo',{p_usuario_id:r.usuario_id,p_accion:action,p_email:['VINCULAR','CAMBIAR'].includes(action)?email:null});
      if(error)throw error;
      if(!data?.ok)throw new Error('Supabase no confirmó el cambio.');
      // Mantener sincronizadas la tabla original de destinatarios y la tabla de vinculos.
      if(typeof window.v560OpenMailAdmin==='function')await window.v560OpenMailAdmin();
      else await load();
      info('Cambio guardado, auditado y actualizado en Supabase.');
      try{window.showToast?.('Vinculación de correo actualizada.')}catch(_){}
    }catch(e){info('No se pudo completar: '+(e?.message||String(e)),true)}
    finally{working=false;updateButtons()}
  }
  window.v734PickUser=pickUser;
  window.v734RenderRows=renderRows;
  window.v734LoadMailLinks=load;
  window.v734Act=act;
  window.v734OpenLinkManager=async function(){
    if(!isAdmin())return window.alert('Solo el Administrador puede administrar vínculos de correos.');
    try{window.closeUsersModal?.()}catch(_){$('usersModal')?.classList.remove('show')}
    if(typeof window.v560OpenMailAdmin==='function')await window.v560OpenMailAdmin();
    if(mount()){$('v734MailLinks')?.scrollIntoView({behavior:'smooth',block:'nearest'});await load()}
  };
  function boot(){
    if(typeof window.v560OpenMailAdmin==='function' && !window.v560OpenMailAdmin.__v734){
      const previous=window.v560OpenMailAdmin;
      window.v560OpenMailAdmin=async function(){const result=await previous.apply(this,arguments);if(mount())await load();return result};
      window.v560OpenMailAdmin.__v734=true;
    }
    for (const name of ['v560SaveMailRecipient','v560ToggleMailRecipient']) {
      const original=window[name];
      if(typeof original==='function' && !original.__v734) {
        const wrapped=async function(){const result=await original.apply(this,arguments);if($('v734MailLinks'))await load();return result};
        wrapped.__v734=true;
        window[name]=wrapped;
      }
    }
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>

<!-- V735 · Acciones se reemplaza por Observaciones en tarjetas de expedientes.
     Se conservan operaciones previas en un menú secundario dentro de la misma celda. -->
<style id="v735-observaciones-estilo">
.v735-observaciones-cell{min-width:178px;max-width:265px;vertical-align:middle!important;white-space:normal!important}
.v735-cell-inner{display:flex;flex-direction:column;gap:5px;align-items:flex-start;max-width:265px}
.v735-open{font-size:10px!important;padding:4px 9px!important;white-space:normal!important;background:#eef5ff!important;color:#17427b!important;border:1px solid #b9d4f5!important}
.v735-preview{font-size:10px;line-height:1.3;color:#3d5271;white-space:normal;max-width:230px;overflow-wrap:anywhere}
.v735-preview b{font-weight:850;color:#16406e}
.v735-preview .v735-snippet{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.v735-actions-legacy{width:100%;font-size:10px;white-space:normal}
.v735-actions-legacy summary{cursor:pointer;color:#40597c;font-weight:700;font-size:9.5px}
.v735-actions-legacy>div{display:flex;flex-wrap:wrap;gap:4px;align-items:center;margin-top:5px}
.v735-actions-legacy .btn{font-size:9px!important;padding:4px 6px!important}
#v735ObservacionesModal{position:fixed;inset:0;z-index:2147482000;background:rgba(8,23,42,.65);display:none;align-items:center;justify-content:center;padding:16px}
#v735ObservacionesModal.show{display:flex}
.v735-dialog{width:min(690px,100%);max-height:min(88vh,820px);overflow:auto;background:#fff;border-radius:12px;box-shadow:0 16px 55px rgba(0,0,0,.28);padding:19px;color:#172f52}
.v735-dialog-head{display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid #dce6f3;padding-bottom:9px;margin-bottom:10px}
.v735-dialog h2{font-size:17px;margin:0}
.v735-dialog .v735-subhead{font-size:11px;color:#526782;margin-bottom:10px}
.v735-dialog label{font-size:11px;font-weight:750;display:block;margin-bottom:5px}
#v735NoteInput{width:100%;min-height:76px;padding:10px;box-sizing:border-box;border:1px solid #aabdd7;border-radius:7px;resize:vertical;font:12px/1.45 inherit}
.v735-dialog-actions{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin:9px 0 12px}
#v735NoteStatus{font-size:11px;color:#385979}
.v735-history{border-top:1px solid #e1e8f2;padding-top:10px;margin-top:12px;display:grid;gap:8px}
.v735-entry{border:1px solid #dce6f2;border-left:3px solid #8cb0e4;border-radius:7px;padding:10px;background:#f9fbfe}
.v735-entry-title{font-size:10.5px;font-weight:750;color:#245082}
.v735-entry-meta{font-size:9.5px;color:#61748c;margin:2px 0 5px}
.v735-entry-text{font-size:11.5px;white-space:pre-wrap;overflow-wrap:anywhere;color:#283e5d}
#expTimeline .v735-history-linked{padding:8px 0;border-top:1px solid #dae4ee;margin-top:14px}
@media(max-width:640px){.v735-dialog{padding:12px}.v735-observaciones-cell{min-width:155px}.v735-cell-inner{max-width:185px}}
</style>
<div id="v735ObservacionesModal" role="dialog" aria-modal="true" aria-label="Observaciones del expediente" onclick="if(event.target===this)window.v735CerrarObservaciones()">
  <div class="v735-dialog">
    <div class="v735-dialog-head"><h2 id="v735ObsTitle">Observaciones del expediente</h2><button type="button" class="btn secondary small" onclick="window.v735CerrarObservaciones()">Cerrar</button></div>
    <div class="v735-subhead">Comentarios registrados en las operaciones anteriores; se conservan cuando cambia la custodia.</div>
    <label for="v735NoteInput">Agregar observación complementaria (opcional)</label>
    <textarea id="v735NoteInput" maxlength="1500" placeholder="Ej.: Documentación pendiente, expediente incompleto, acumulados, observaciones de revisión…"></textarea>
    <div class="v735-dialog-actions"><button type="button" class="btn" id="v735NoteSave" onclick="window.v735GuardarObservacion()">Guardar observación</button><span id="v735NoteStatus" role="status"></span></div>
    <strong style="font-size:12px">Historial de observaciones</strong>
    <div id="v735NoteHistory" class="v735-history"><div class="empty">Consultando historial…</div></div>
    <details id="v736GestionDesdeObs" class="v736-gestion-modal" hidden><summary>Opciones de gestión del expediente</summary><div id="v736GestionContenido" class="v736-gestion-acciones"></div></details>
  </div>
</div>
<script id="v735-observaciones-script">
(function(){
  'use strict';
  const ID_RE=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  const cache=new Map();
  const actionMarkupByExpediente=new Map(); // V736: conserva gestionar/historial fuera de la columna.
  let currentId='',currentNumber='',loading=false;
  const $=id=>document.getElementById(id);
  const safe=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  const norm=v=>String(v??'').trim();
  const date=v=>{if(!v)return '—';try{return new Intl.DateTimeFormat('es-PE',{timeZone:'America/Lima',dateStyle:'short',timeStyle:'short'}).format(new Date(v));}catch(_){return String(v)}};
  const validId=id=>ID_RE.test(norm(id));
  function content(data){return (Array.isArray(data)?data:[]).map(x=>`<div class="v735-entry"><div class="v735-entry-title">${safe(x.operacion||'OBSERVACIÓN')}</div><div class="v735-entry-meta">${safe(x.autor||'Usuario no identificado')} · ${safe(date(x.fecha))}</div><div class="v735-entry-text">${safe(x.observacion||'')}</div></div>`).join('')||'<div class="empty">Este expediente todavía no tiene observaciones registradas.</div>'}
  function rowId(row){return norm(row?.expediente_id||row?.id||row?.expediente_uuid||'')}
  function rowNumber(row){return norm(row?.expediente||row?.numero_expediente||'')}
  // V736 · Una sola opción en la columna. El historial y la gestión se abren desde el modal.
  function cellMarkup(id,num,original){
    if(original)actionMarkupByExpediente.set(id,original);
    return `<div class="v735-cell-inner" onclick="event.stopPropagation()"><button type="button" class="btn secondary small v735-open" data-v735-view="${safe(id)}" data-v735-num="${safe(num)}" onclick="window.v735AbrirObservaciones(this.dataset.v735View,this.dataset.v735Num);return false">Ver observaciones</button></div>`;
  }
  function changeTable(html,rows){
    if(typeof html!=='string'||!Array.isArray(rows)||!rows.length||!html.includes('Acciones'))return html;
    try{
      const t=document.createElement('template');t.innerHTML=html;
      for(const table of t.content.querySelectorAll('table')){
        const head=table.tHead?.rows?.[0];const body=table.tBodies?.[0];if(!head||!body)continue;
        const i=[...head.cells].findIndex(th=>norm(th.textContent).toUpperCase()==='ACCIONES');
        if(i<0)continue;
        head.cells[i].textContent='Observaciones';head.cells[i].title='Comentarios y antecedentes documentales vinculados al expediente';
        [...body.rows].forEach((tr,k)=>{
          const cell=tr.cells[i],r=rows[k];if(!cell||!r)return;
          const id=rowId(r);if(!validId(id))return;
          cell.classList.add('v735-observaciones-cell');
          cell.innerHTML=cellMarkup(id,rowNumber(r),cell.innerHTML);
        });
      }
      return t.innerHTML;
    }catch(e){console.warn('V735 visualización:',e);return html;}
  }
  function wrap(fnName){
    const prev=window[fnName];
    if(typeof prev!=='function'||prev.__v735)return;
    const wrapped=function(rows,...rest){
      const html=prev.apply(this,arguments);
      const output=changeTable(html,rows);
      if(typeof output==='string'&&output.includes('data-v735-resume'))requestAnimationFrame(refreshVisible);
      return output;
    };
    wrapped.__v735=true;window[fnName]=wrapped;
  }
  let refreshing=false;
  async function refreshVisible(force=false){
    if(refreshing||!window.sb&&!('sb' in window)){
      // La conexión supabase puede estar declarada mediante let global.
      if(refreshing)return;
    }
    const all=[...document.querySelectorAll('#panelTable [data-v735-resume]')];
    if(!all.length)return;
    const ids=[...new Set(all.map(x=>x.dataset.v735Resume).filter(validId))];
    const stale=ids.filter(id=>force||!cache.has(id)||Date.now()-cache.get(id).time>30000);
    const paint=()=>all.forEach(node=>{
      const r=cache.get(node.dataset.v735Resume);if(!r)return;
      const info=r.data;
      node.innerHTML=info?.cantidad?`<span class="v735-snippet" title="${safe(info?.observacion||'')}">${safe(info?.observacion||'—')}</span><small>${info.cantidad} registro${info.cantidad===1?'':'s'}</small>`:'Sin observaciones';
    });
    if(!stale.length){paint();return;}
    refreshing=true;
    try{
      for(let n=0;n<stale.length;n+=100){
        const batch=stale.slice(n,n+100);
        const {data,error}=await sb.rpc('v735_resumen_observaciones',{p_ids:batch});
        if(error)throw error;
        const found=new Map((data||[]).map(x=>[x.expediente_id,x]));
        batch.forEach(id=>cache.set(id,{data:found.get(id)||null,time:Date.now()}));
      }
      paint();
    }catch(e){
      all.forEach(n=>{if(!cache.has(n.dataset.v735Resume))n.textContent='Consultar historial'});
      console.warn('V735 resumen (SQL requerido):',e?.message||e);
    }finally{refreshing=false;}
  }
  window.v735CerrarObservaciones=function(){$('v735ObservacionesModal')?.classList.remove('show');currentId='';};
  async function load(id){
    const box=$('v735NoteHistory');if(!box)return;
    box.innerHTML='<div class="empty">Consultando observaciones…</div>';
    try{const {data,error}=await sb.rpc('v735_historial_observaciones',{p_expediente_id:id,p_limite:100});if(error)throw error;if(currentId===id)box.innerHTML=content(data)}
    catch(e){if(currentId===id)box.innerHTML=`<div class="empty">No se pudo consultar el historial: ${safe(e?.message||String(e))}</div>`;}
  }
  window.v735AbrirObservaciones=async function(id,num=''){
    if(!validId(id))return;
    currentId=id;currentNumber=num;
    $('v735ObsTitle').textContent=`Observaciones · ${num||'Expediente'}`;
    $('v735NoteInput').value='';$('v735NoteStatus').textContent='';
    const gestionar=$('v736GestionContenido');
    const acciones=actionMarkupByExpediente.get(id)||'';
    if(gestionar){gestionar.innerHTML=acciones;const caja=$('v736GestionDesdeObs');if(caja){caja.hidden=!acciones;caja.open=false;}}
    $('v735ObservacionesModal')?.classList.add('show');
    await load(id);
  };
  window.v735GuardarObservacion=async function(){
    if(loading||!validId(currentId))return;
    const text=norm($('v735NoteInput')?.value);
    if(!text){$('v735NoteStatus').textContent='Escriba una observación o cierre sin registrar comentarios.';return;}
    if(text.length>1500){$('v735NoteStatus').textContent='Máximo 1500 caracteres.';return;}
    const btn=$('v735NoteSave');loading=true;if(btn)btn.disabled=true;
    try{
      const {error}=await sb.rpc('v735_guardar_nota',{p_expediente_id:currentId,p_observacion:text,p_solicitud_id:null});
      if(error)throw error;
      const saved=currentId;
      $('v735NoteInput').value='';$('v735NoteStatus').textContent='Observación registrada con autor y fecha.';
      cache.delete(saved);await Promise.all([load(saved),refreshVisible(true)]);
      try{showToast?.('Observación registrada en el historial del expediente.')}catch(_){}
    }catch(e){$('v735NoteStatus').textContent='No se pudo guardar: '+(e?.message||String(e));}
    finally{loading=false;if(btn)btn.disabled=false;}
  };
  function init(){
    // Tarjetas de expedientes: no añadir columnas adicionales.
    wrap('recordTable');
    wrap('renderCoordinatorCompleteTableV225');
    wrap('renderUserSearchGenericTableV185');
    // La vista principal de historial también ofrece el acceso al historial de observaciones.
    const hist=window.showExpHistory;
    if(typeof hist==='function'&&!hist.__v735){
      const wrapped=async function(id,...rest){
        const result=await hist.apply(this,arguments);
        if(validId(id)&&$('expTimeline')&&!$('expTimeline').querySelector('[data-v735-history-link]')
           // V751: el historial es estrictamente de lectura para USUARIO / COORDINADOR.
           && !['USUARIO','COORDINADOR'].includes(String(currentProfile?.rol||'').toUpperCase())){
          const div=document.createElement('div');div.className='v735-history-linked';div.dataset.v735HistoryLink='1';
          div.innerHTML=`<button class="btn secondary small" type="button">Ver observaciones del expediente</button>`;
          div.querySelector('button')?.addEventListener('click',()=>window.v735AbrirObservaciones(id));
          $('expTimeline').appendChild(div);
        }
        return result;
      };
      wrapped.__v735=true;window.showExpHistory=wrapped;
    }
    const gestion=$('v736GestionContenido');
    if(gestion)gestion.addEventListener('click',e=>{
      if(e.target.closest('button,[role="button"],a'))window.v735CerrarObservaciones();
    },true);
    const root=$('panelTable');
    if(root){
      const observer=new MutationObserver(()=>{if(root.querySelector('[data-v735-resume]'))requestAnimationFrame(refreshVisible)});
      observer.observe(root,{childList:true,subtree:false});
      requestAnimationFrame(refreshVisible);
    }
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
})();
</script>


<style id="v736-compact-column">
/* V736: una sola acción visual, sin datos secundarios ni botones de gestión en la celda. */
#panelTable td.v735-observaciones-cell{min-width:124px!important;max-width:170px!important;width:148px!important;padding:5px 7px!important;text-align:center!important}
#panelTable td.v735-observaciones-cell .v735-cell-inner{max-width:none!important;display:flex;justify-content:center;align-items:center}
#panelTable td.v735-observaciones-cell .v735-open{font-size:11px!important;padding:5px 8px!important;white-space:nowrap!important}
.v736-gestion-modal{margin-top:17px;padding:10px;border:1px solid #dce6f2;background:#f8fbff;border-radius:8px}
.v736-gestion-modal summary{cursor:pointer;color:#245082;font-size:11px;font-weight:750}
.v736-gestion-acciones{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.v736-gestion-acciones button,.v736-gestion-acciones a{margin:2px}
</style>
<script id="v736-corregir-tarjeta-devoluciones-vigentes">
(function(){
  'use strict';
  // Los detalles se consultan frescos en V512; una tarjeta cacheada puede
  // conservar un contador anterior aunque la custodia haya cambiado.
  try{
    const flag='v736_snapshots_limpiados';
    if(sessionStorage.getItem(flag)!=='1'){
      for(let i=sessionStorage.length-1;i>=0;i--){
        const key=sessionStorage.key(i)||'';
        if(key.startsWith('v353_panel_snapshot_') ||
           key.startsWith('v637_user_summary_') ||
           key.startsWith('v207_user_summary_'))sessionStorage.removeItem(key);
      }
      if(typeof invalidatePanelViewCacheV179==='function')invalidatePanelViewCacheV179();
      sessionStorage.setItem(flag,'1');
    }
  }catch(error){console.warn('V736 limpieza temporal:',error);}
  const previous=window.showUserCard;
  if(typeof previous!=='function')return;
  const wrapped=async function(tipo){
    const isReturn=String(tipo||'').toUpperCase()==='DEVOLUCION_SOLICITADA';
    const result=await previous.apply(this,arguments);
    if(!isReturn || String(userPanelMode||'').toUpperCase()!=='DEVOLUCION_SOLICITADA')return result;
    try{
      const detail=document.getElementById('panelTable');
      const pageInfo=String(document.getElementById('pageInfo')?.textContent||'');
      const errorDetected=/error de consulta|no se pudo cargar|error de servicio/i.test(pageInfo+' '+(detail?.textContent||''));
      if(!errorDetected && Number.isInteger(panelCount) && panelCount>=0){
        const previousCount=Number(userPanelSummary?.devolucion_solicitada||0);
        const updated={...(userPanelSummary||{}),devolucion_solicitada:panelCount};
        // Se conserva la comparación con la fuente vigente, sin modificar datos en Supabase.
        if(typeof applyUserSummaryV184==='function')applyUserSummaryV184(updated);
        if(typeof saveUserSummaryV184==='function')saveUserSummaryV184(updated);
        if(previousCount!==panelCount){
          const node=document.getElementById('uKReturnRequested');
          if(node)node.title='Conteo actualizado desde los expedientes vigentes. Antes: '+previousCount;
        }
      }
    }catch(error){console.warn('V736 sincronización de devoluciones:',error);}
    return result;
  };
  window.showUserCard=wrapped;
  try{showUserCard=wrapped;}catch(_){}
})();
</script>

<style id="v740-pending-communications-style">
#statePendingFilters .v740-pending-grid .field{min-width:0}
#statePendingFilters #v740PendingCommunicationFilter{width:100%;max-width:100%;min-height:35px}
#v740PendingNoticeHint{font-size:11px;color:#526681}
#stateDetailTable .v740-header-filter{margin-left:3px;padding:1px 5px;border:1px solid #b9cde5;border-radius:5px;background:#fff;color:#17436d;cursor:pointer;font-size:11px;vertical-align:middle}
@media(max-width:1050px){#statePendingFilters .v740-pending-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
@media(max-width:610px){#statePendingFilters .v740-pending-grid{grid-template-columns:minmax(0,1fr)!important}}
</style>
<script id="v740-pending-communication-filter-script">
/* V740 — Filtro por comunicacion registrada para toda la bandeja PENDIENTE POR ATENDER.
   Las comunicaciones pertenecen al par expediente + solicitud, no a otros ciclos. */
function v740PendingNoticePair(row){
  return String(row?.expediente_id||'')+'|'+String(row?.solicitud_id||'');
}
function v740PendingNoticeCacheKey(){
  const pairs=[...new Set((pendingAttentionRows||[]).map(v740PendingNoticePair).filter(x=>x!=='|'))].sort();
  return String(session?.user?.id||'')+'|'+pairs.join(',');
}
function v740CommunicationPlace(value){
  let text=String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    .trim().replace(/\s+/g,' ').toUpperCase();
  if(text==='EN SAN LUIS'||text==='SEDE SAN LUIS')text='SAN LUIS';
  return text;
}
function v740FilterPendingCommunications(rows,choice){
  if(!choice)return rows;
  if(v688PendingLocationCacheKey!==v740PendingNoticeCacheKey())return null;
  return rows.filter(row=>{
    const notice=v688PendingLocationMap.get(v740PendingNoticePair(row));
    if(choice==='s:SIN')return !notice;
    if(choice==='s:COMUNICADO')return !!notice;
    if(choice==='s:LEIDO')return !!notice?.leida_at;
    if(choice==='s:NO_LEIDO')return !!notice&&!notice.leida_at;
    if(choice.startsWith('l:'))return !!notice&&v740CommunicationPlace(notice.sede)===choice.slice(2);
    return true;
  });
}
function v740RefreshLocationChoices(){
  const group=document.getElementById('v740PendingLocations');
  const select=document.getElementById('v740PendingCommunicationFilter');
  if(!group||!select)return;
  const selected=String(select.value||'');
  const places=new Map([['SAN LUIS','SAN LUIS']]);
  for(const row of pendingAttentionRows||[]){
    const notice=v688PendingLocationMap.get(v740PendingNoticePair(row));
    if(!notice)continue;
    const name=v740CommunicationPlace(notice.sede);
    if(name&&!places.has(name))places.set(name,String(notice.sede||name).trim().toUpperCase());
  }
  if(selected.startsWith('l:')&&!places.has(selected.slice(2)))places.set(selected.slice(2),selected.slice(2));
  const sorted=[...places.entries()].sort((a,b)=>a[0]==='SAN LUIS'?-1:b[0]==='SAN LUIS'?1:a[0].localeCompare(b[0],'es'));
  group.replaceChildren();
  for(const [key,label] of sorted){
    const option=document.createElement('option');
    option.value='l:'+key;
    option.textContent=label;
    group.appendChild(option);
  }
  select.value=selected;
}
function v740UpdatePendingHint(visible,total,complete){
  const hint=document.getElementById('v740PendingNoticeHint');
  if(!hint)return;
  const selection=document.getElementById('v740PendingCommunicationFilter');
  const filter=selection?.value||'';
  if(!filter){hint.textContent='Filtre toda la bandeja por la última comunicación asociada a cada expediente y solicitud.';return;}
  const description=selection?.selectedOptions?.[0]?.textContent?.trim()||'comunicación';
  if(!complete){hint.textContent='Consultando las comunicaciones de todos los expedientes pendientes…';return;}
  hint.textContent=`${visible} de ${total} expedientes · Filtro: ${description} · Se utiliza la última comunicación de cada solicitud.`;
}
function v740FocusPendingCommunicationFilter(){
  const select=document.getElementById('v740PendingCommunicationFilter');
  if(!select)return;
  select.scrollIntoView?.({block:'nearest'});
  select.focus();
  if(typeof select.showPicker==='function'){try{select.showPicker();}catch(_){}}
}
window.v740FocusPendingCommunicationFilter=v740FocusPendingCommunicationFilter;
function v740RetryPendingCommunications(){
  v688PendingLocationErrorKey='';
  renderPendingAttentionRows();
  window.loadPendingLocationNoticesV688?.(true);
}
window.v740RetryPendingCommunications=v740RetryPendingCommunications;
</script>

<style id="v741-pending-accumulated-style">
#stateDetailTable .v741-pending-accumulated{margin-top:4px;max-width:170px;font-size:10px;color:#355377;line-height:1.25}
#stateDetailTable .v741-pending-accumulated details{display:block}
#stateDetailTable .v741-pending-accumulated summary{display:inline-block;cursor:pointer;border:1px solid #aac8ed;background:#edf6ff;color:#124b8a;border-radius:7px;padding:2px 6px;white-space:nowrap;font-weight:800}
#stateDetailTable .v741-pending-accumulated summary:hover{background:#dcecff}
#stateDetailTable .v741-pending-accumulated-list{display:flex;flex-direction:column;gap:2px;margin:3px 0 0 4px;padding-left:6px;border-left:2px solid #f3c96c;min-width:120px}
#stateDetailTable .v741-pending-accumulated-item{white-space:normal;overflow-wrap:anywhere;font-size:10px;line-height:1.23}
#stateDetailTable .v741-pending-accumulated-item small{font-size:9px;color:#5f7086}
#stateDetailTable .v741-pending-accumulated-loading{font-size:9px;color:#758397}
</style>
<script id="v741-pending-accumulated-script">
/* V741: listar acumulados ligados al principal, sin añadir filas seleccionables,
   sin recalcular comunicaciones y sin convertirlos en expedientes independientes. */
const v741PendingAccumulatedFailures=new Set();
let v741PendingAccumulatedPromise=null;
function v741PendingAccumulatedForRow(row){
  const id=String(row?.expediente_id||'');
  const req=String(row?.solicitud_id||'');
  const all=(typeof accumulatedCache!=='undefined'&&accumulatedCache.has(id))
    ?(accumulatedCache.get(id)||[]):[];
  // Sólo los acumulados de esta solicitud o los vínculos generales sin ciclo.
  return all.filter(a=>!a?.solicitud_id||String(a.solicitud_id)===req);
}
function v741PendingAccumulatedMarkup(row){
  const id=String(row?.expediente_id||'');
  const ready=(typeof accumulatedCache!=='undefined'&&accumulatedCache.has(id));
  if(!ready){
    if(v741PendingAccumulatedFailures.has(id))return '<small class="v741-pending-accumulated-loading">Acumulados no disponibles</small>';
    return '<small class="v741-pending-accumulated-loading">Consultando acumulados…</small>';
  }
  const arr=v741PendingAccumulatedForRow(row);
  if(!arr.length)return '';
  return `<details onclick="event.stopPropagation()">
    <summary>${arr.length} acumulado${arr.length===1?'':'s'} ▾</summary>
    <div class="v741-pending-accumulated-list">${arr.map(a=>
      `<div class="v741-pending-accumulated-item">↳ <b>${esc(a.numero_acumulado||'—')}</b>${a.extension?` <small>· ${esc(a.extension)}</small>`:''}</div>`
    ).join('')}</div>
  </details>`;
}
function v741PendingAccumulatedCell(row){
  const id=String(row?.expediente_id||'');
  if(!id)return '';
  return `<div class="v741-pending-accumulated" data-v741-principal="${esc(id)}" data-v741-solicitud="${esc(row?.solicitud_id||'')}">${v741PendingAccumulatedMarkup(row)}</div>`;
}
function v741PaintPendingAccumulatedCells(){
  const available=new Map((pendingAttentionRows||[]).map(x=>[
    String(x?.expediente_id||'')+'|'+String(x?.solicitud_id||''),x
  ]));
  document.querySelectorAll('#stateDetailTable [data-v741-principal]').forEach(node=>{
    const key=String(node.dataset.v741Principal||'')+'|'+String(node.dataset.v741Solicitud||'');
    const row=available.get(key);
    if(!row)return;
    const old=node.querySelector('details');
    const opened=!!old?.open;
    node.innerHTML=v741PendingAccumulatedMarkup(row);
    if(opened&&node.querySelector('details'))node.querySelector('details').open=true;
  });
}
async function v741LoadPendingAccumulated(){
  if(!sb||!session || selectedState!=='PENDIENTE POR ATENDER')return;
  if(v741PendingAccumulatedPromise)return v741PendingAccumulatedPromise;
  const uid=String(session.user.id||'');
  const pending=[...new Set((pendingAttentionRows||[]).map(r=>String(r?.expediente_id||'')).filter(Boolean))];
  const missing=pending.filter(id=>!accumulatedCache.has(id)&&!v741PendingAccumulatedFailures.has(id));
  if(!missing.length){v741PaintPendingAccumulatedCells();return;}
  v741PendingAccumulatedPromise=(async()=>{
    for(let i=0;i<missing.length;i+=65){
      if(String(session?.user?.id||'')!==uid)return;
      const ids=missing.slice(i,i+65);
      const {data,error}=await sb.rpc('listar_acumulados_por_principales',{p_principal_ids:ids});
      if(String(session?.user?.id||'')!==uid)return;
      if(error){
        ids.forEach(id=>v741PendingAccumulatedFailures.add(id));
        console.warn('V741 acumulados:',error.message||error);
      }else{
        const grouped=new Map(ids.map(id=>[id,[]]));
        (data||[]).forEach(a=>{
          const id=String(a.expediente_principal_id||'');
          if(grouped.has(id))grouped.get(id).push(a);
        });
        grouped.forEach((items,id)=>accumulatedCache.set(id,items));
      }
      if(selectedState==='PENDIENTE POR ATENDER')v741PaintPendingAccumulatedCells();
    }
    // Cuando la búsqueda corresponde a un número acumulado, incluir su principal.
    if(selectedState==='PENDIENTE POR ATENDER' && String(document.getElementById('pendingStateSearch')?.value||'').trim()){
      renderPendingAttentionRows();
    }
  })().finally(()=>{v741PendingAccumulatedPromise=null;});
  return v741PendingAccumulatedPromise;
}
window.v741LoadPendingAccumulated=v741LoadPendingAccumulated;
</script>

<style id="v742-audit-css">
#v742AuditPanel {margin-top:20px;padding:16px 14px;border:1px solid #cbd5e1;border-radius:12px;background:#f8fafc;color:#13314f}
#v742AuditPanel h3{font-size:16px;margin:0 0 8px;font-weight:800}
#v742AuditPanel h4{font-size:13px;margin:14px 0 8px}
.v742-audit-info{font-size:12px;color:#526781;margin:5px 0 12px;line-height:1.4}
.v742-audit-bar{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:10px 0}
.v742-audit-stamp{color:#60758b;font-size:12px}
.v742-audit-overview{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:12px 0;font-size:12px}
.v742-audit-pill{padding:5px 9px;border-radius:999px;font-size:11px;font-weight:800;background:#e7f4ec;color:#137a45}
.v742-audit-pill.warn{background:#fff0cb;color:#7c520a}
.v742-audit-pill.review{background:#ffe0df;color:#a72130}
.v742-audit-grid{display:grid;grid-template-columns:repeat(4,minmax(130px,1fr));gap:8px;margin:12px 0}
.v742-audit-stat{padding:9px 10px;background:white;border:1px solid #d6e2ee;border-radius:9px;display:flex;flex-direction:column;gap:3px;min-width:0}
.v742-audit-stat strong{font-size:18px;color:#0d396b;font-variant-numeric:tabular-nums}
.v742-audit-stat span{font-size:11px;color:#516479}
.v742-audit-table-scroll{overflow-x:auto;max-height:260px;overflow-y:auto;border:1px solid #d5e0ed;border-radius:8px;background:white}
.v742-audit-table{border-collapse:collapse;width:100%;min-width:730px;font-size:11px}
.v742-audit-table th,.v742-audit-table td{padding:8px;border-bottom:1px solid #dce7f1;text-align:left;vertical-align:top;line-height:1.4}
.v742-audit-table th{position:sticky;top:0;background:#eaf2fc;color:#0d396b;z-index:1}
.v742-audit-error{background:#fff2ef;color:#9b2424;padding:10px;border-radius:8px}
@media(max-width:680px){.v742-audit-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
<script id="v742-audit-script">
/* V742 — Auditoría estructural de solo lectura (no modifica préstamos ni estados).
   Disponible desde el panel de salud V605/V607; RPC con validación de roles en Supabase. */
(function(){
  'use strict';
  let busy=false;
  const $=id=>document.getElementById(id);
  function make(tag,cls,txt){
    const el=document.createElement(tag);
    if(cls)el.className=cls;
    if(txt!==undefined&&txt!==null)el.textContent=String(txt);
    return el;
  }
  function cell(row,text){const td=make('td','',text===null||text===undefined||text===''?'—':text);row.appendChild(td);return td;}
  function boot(){
    const box=document.querySelector('#v605HealthModal .v607-health-modal-box');
    if(!box||$('v742AuditPanel'))return;
    const panel=make('section','v742-audit-panel');
    panel.id='v742AuditPanel';
    const h=make('h3','','V742 · Integridad y trazabilidad de expedientes');
    panel.appendChild(h);
    panel.appendChild(make('p','v742-audit-info','Consulta de solo lectura. Compara el estado maestro con la custodia vigente y señala excepciones para revisión archivística. No cambia ningún expediente.'));
    const bar=make('div','v742-audit-bar');
    const btn=make('button','btn secondary','Verificar trazabilidad');
    btn.type='button';btn.id='v742AuditRun';btn.addEventListener('click',run);
    bar.appendChild(btn);
    const stamp=make('span','v742-audit-stamp','Aún no consultado');stamp.id='v742AuditStamp';
    bar.appendChild(stamp);panel.appendChild(bar);
    const result=make('div','v742-audit-result','');result.id='v742AuditResult';
    result.setAttribute('aria-live','polite');
    panel.appendChild(result);
    box.appendChild(panel);
  }
  function statusBlock(root,r){
    const top=make('div','v742-audit-overview');
    const pill=make('span','v742-audit-pill '+(r.estado==='NORMAL'?'ok':r.estado==='ADVERTENCIA'?'warn':'review'),
      r.estado==='NORMAL'?'Sin incidencias detectadas':r.estado==='ADVERTENCIA'?'Requiere seguimiento':'Requiere revisión documental');
    top.appendChild(pill);
    top.appendChild(make('span','',`Lectura: ${new Date(r.muestra_tomada||Date.now()).toLocaleString('es-PE')}`));
    root.appendChild(top);
    const d=r.resumen||{};
    const stats=[
      ['Expedientes',d.expedientes],['Responsables coincidentes',Number(d.expedientes||0)-Number(d.responsable_no_coincide||0)],
      ['Fases distintas válidas',d.fase_operativa_distinta],['Divergencias por revisar',d.divergencias_no_esperadas],
      ['Préstamos sin ciclo',d.prestamo_sin_ciclo],['Sin historial',d.sin_movimientos],
      ['Movimientos sin autor',d.movimientos_sin_autor],['Acumulados activos',d.acumulados_activos]
    ];
    const grid=make('div','v742-audit-grid');
    for(const [name,count] of stats){const card=make('div','v742-audit-stat');card.appendChild(make('strong','',count??'—'));card.appendChild(make('span','',name));grid.appendChild(card);}
    root.appendChild(grid);
    root.appendChild(make('p','v742-audit-info','«Fases distintas válidas» incluye reasignaciones y devoluciones solicitadas que conservan «En préstamo» como estado base. No son errores automáticos. Los eventos SIN_ID de edición de solicitudes no se consideran expedientes huérfanos.'));
  }
  function render(data){
    const root=$('v742AuditResult');if(!root)return;
    root.replaceChildren();
    if(!data||data.ok!==true){root.appendChild(make('p','v742-audit-error','No se pudo interpretar el resultado de la auditoría.'));return;}
    statusBlock(root,data);
    const entries=Array.isArray(data.incidencias)?data.incidencias:[];
    root.appendChild(make('h4','','Casos para revisión ('+entries.length+' mostrados)'));
    if(!entries.length){root.appendChild(make('p','','No se identificaron excepciones en esta comprobación.'));return;}
    const wrap=make('div','v742-audit-table-scroll');
    const table=make('table','v742-audit-table');
    const thead=make('thead');const tr=make('tr');
    for(const label of ['Expediente','Tipo de incidencia','Estado vigente','Responsable','Recomendación'])cell(tr,label);
    thead.appendChild(tr);table.appendChild(thead);
    const tbody=make('tbody');
    const labels={PRESTAMO_SIN_CICLO:'Préstamo sin solicitud',SIN_HISTORIAL:'Sin historial',DIVERGENCIA_ESTADO:'Divergencia de estado',RESPONSABLE_SIN_CUENTA_ACTIVA:'Responsable sin cuenta activa'};
    for(const item of entries){const t=make('tr');
      cell(t,(item.expediente||'—')+(item.extension?' · '+item.extension:''));
      cell(t,labels[item.tipo]||item.tipo);cell(t,item.estado_operativo);cell(t,item.responsable);cell(t,item.detalle);
      tbody.appendChild(t);
    }
    table.appendChild(tbody);wrap.appendChild(table);root.appendChild(wrap);
    root.appendChild(make('p','v742-audit-info','La misma incidencia puede aparecer en más de una categoría. Verifique físicamente y documentalmente antes de cualquier regularización.'));
  }
  async function run(){
    if(busy)return;
    boot();busy=true;
    const btn=$('v742AuditRun'),stamp=$('v742AuditStamp'),output=$('v742AuditResult');
    if(btn)btn.disabled=true;
    if(stamp)stamp.textContent='Consultando Supabase…';
    if(output)output.replaceChildren(make('p','','Validando los expedientes y sus ciclos…'));
    try{
      const client=(typeof sb!=='undefined'&&sb)?sb:window.sb;
      if(!client||typeof client.rpc!=='function')throw Error('No hay conexión activa con Supabase.');
      const {data,error}=await client.rpc('v742_auditoria_trazabilidad',{p_limite:70});
      if(error)throw error;
      const result=Array.isArray(data)?data[0]:data;
      if(!result||result.ok!==true)throw Error('Respuesta de auditoría no válida.');
      render(result);
      if(stamp)stamp.textContent='Última revisión: '+new Date(result.muestra_tomada||Date.now()).toLocaleString('es-PE');
    }catch(err){
      if(stamp)stamp.textContent='No fue posible completar la consulta';
      if(output)output.replaceChildren(make('p','v742-audit-error',err&&err.message?err.message:'Error consultando auditoría.'));
    }finally{busy=false;if(btn)btn.disabled=false;}
  }
  window.v742AuditRun=run;
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();

</script>

<!-- V745: búsquedas por tarjeta; no se combina la trazabilidad de tarjetas distintas. -->
<style id="v745-card-search-style">
#v745CardSearchBar{display:none;padding:11px 14px;background:#f5f9ff;border-top:1px solid #d6e3f2;border-bottom:1px solid #d6e3f2;gap:8px;align-items:flex-end;flex-wrap:wrap}
#v745CardSearchBar.v745-visible{display:flex}
#v745CardSearchBar .v745-field{flex:1 1 290px;min-width:170px;display:flex;flex-direction:column;gap:5px}
#v745CardSearchBar label{font-size:11px;font-weight:800;color:#17436d;letter-spacing:.01em}
#v745CardSearchBar input{width:100%;box-sizing:border-box;height:36px;padding:7px 11px;border:1px solid #bacfe6;border-radius:7px;background:#fff;color:#163351;font-size:13px}
#v745CardSearchBar input:focus{outline:2px solid rgba(32,108,209,.22);border-color:#2779d5}
#v745CardSearchBar .v745-actions{display:flex;gap:6px;align-items:center}
#v745CardSearchBar .v745-actions button{height:36px;white-space:nowrap}
#v745CardSearchMessage{flex-basis:100%;font-size:11px;color:#52708e;min-height:14px}
#v745CardSearchMessage[data-kind="error"]{color:#a12d2d}
#v745CardSearchMessage[data-kind="ok"]{color:#155e3b}
/* V530 buscaba simultáneamente en tarjetas distintas. Lo sustituye V745. */
body.produce-user #v530UserTraceSearch,
body.produce-coordinator-self #v530UserTraceSearch,
body.produce-staff #v530UserTraceSearch,
#tab-panel #v530UserTraceSearch{display:none!important}
/* Retirar solo el buscador global anterior en la pestaña de expedientes. */
#tab-panel #ownerDetailFilters .field:has(#searchInput),
#tab-panel .v349-toolbar-search:has(#searchInput),
.v349-toolbar-search:has(#searchInput){display:none!important}
@media(max-width:640px){#v745CardSearchBar{padding:9px;gap:7px}#v745CardSearchBar .v745-field{flex-basis:100%}#v745CardSearchBar .v745-actions{width:100%}#v745CardSearchBar .v745-actions button{flex:1}}
</style>
<script id="v745-card-search-script">
(function(){
  'use strict';
  window.V745_CARD_SEARCH_ONLY=true;
  let term='',timer=null,seq=0;
  const E=id=>document.getElementById(id);
  const normalized=s=>String(s||'').trim().replace(/[–—]/g,'-');
  const fullKey=value=>{
    const m=normalized(value).match(/^0*(\d{1,7})\s*[-/]\s*(\d{4})$/);
    return m?String(Number(m[1]))+'-'+m[2]:'';
  };
  const rowKey=value=>{
    const text=normalized(value);
    const m=text.match(/(?:^|\b)0*(\d{1,7})\s*[-/]\s*(\d{4})(?=$|\b|\s)/);
    return m?String(Number(m[1]))+'-'+m[2]:'';
  };
  window.v745FilterCardRows=function(rows,search){
    const values=Array.isArray(rows)?rows:[];
    const key=fullKey(search);
    if(!key)return values;
    return values.filter(row=>{
      // Se compara el N.º/Año de expediente, nunca el N.º de solicitud o cargo.
      const names=[row?.expediente,row?.numero_expediente,row?.nro_expediente,
        row?.expediente_numero,row?.numero_expediente_principal,row?.codigo_expediente];
      return names.some(value=>rowKey(value)===key);
    });
  };
  window.v745GetScopedTerm=()=>term;

  function cardLabel(){
    try{
      const restricted=typeof isLimitedUser==='function'&&isLimitedUser();
      if(restricted){
        if(typeof userPanelLabel==='function')return String(userPanelLabel()||'Tarjeta seleccionada');
        return String(userPanelMode||'Tarjeta seleccionada').replaceAll('_',' ');
      }
      if(typeof panelQuickLabel==='function')return String(panelQuickLabel()||'Tarjeta seleccionada');
    }catch(_){ }
    return 'Tarjeta seleccionada';
  }
  function allowed(){
    const panel=E('panelDetailWrap');
    if(!panel || panel.closest('.hidden'))return false;
    try{
      if(typeof isLimitedUser==='function'&&isLimitedUser())return true;
      if(typeof selectedOwnerIsUser==='function'&&selectedOwnerIsUser())return true;
      if(typeof v629IsOtherUser==='function'&&v629IsOtherUser())return true;
    }catch(_){ }
    return false;
  }
  function notice(message,kind=''){
    const n=E('v745CardSearchMessage');
    if(n){n.textContent=message;n.dataset.kind=kind;}
  }
  function renderToolbar(){
    const bar=E('v745CardSearchBar');
    if(!bar)return;
    const show=allowed();
    bar.classList.toggle('v745-visible',show);
    bar.hidden=!show;
    if(!show)return;
    const label=E('v745CardSearchLabel');
    if(label)label.textContent='Buscar expediente solo en: '+cardLabel();
    const input=E('v745CardSearchInput');
    if(input && document.activeElement!==input && input.value!==term)input.value=term;
  }
  function clean(){
    clearTimeout(timer);
    seq++;
    term='';
    const old=E('searchInput');if(old)old.value='';
    const input=E('v745CardSearchInput');if(input)input.value='';
    notice('Busque por número y año. Solo se consultará la tarjeta seleccionada.');
    renderToolbar();
  }
  function inputClean(){
    clearTimeout(timer);
    seq++;
    term='';
    const old=E('searchInput');if(old)old.value='';
  }
  async function refreshRows(force){
    if(!allowed())return;
    const input=E('v745CardSearchInput');
    const typed=normalized(input?.value||'');
    if(typed && !fullKey(typed)){
      notice('Ingrese el número y año completo. Ejemplo: 844-2025 o 0844-2025.','error');
      return;
    }
    const current=++seq;
    term=typed;
    const old=E('searchInput');if(old)old.value=typed;
    try{
      if(typeof page!=='undefined')page=0;
      notice(typed?'Consultando '+typed+' solo en '+cardLabel()+'…':'Restableciendo esta tarjeta…');
      const btn=E('v745CardSearchBtn');if(btn)btn.disabled=true;
      if(typeof loadPanel!=='function')throw Error('El panel de expedientes no está disponible.');
      await loadPanel({forceFresh:true,refreshCards:false});
      if(current!==seq)return;
      const count=typeof panelCount==='number'?panelCount:0;
      notice(typed
        ?(count?count+' coincidencia(s) dentro de «'+cardLabel()+'».':'No hay expedientes con ese número y año en esta tarjeta.')
        :'Mostrando nuevamente el contenido de «'+cardLabel()+'».','ok');
    }catch(error){
      if(current===seq)notice('No se pudo consultar esta tarjeta: '+String(error?.message||error),'error');
    }finally{
      if(current===seq){const btn=E('v745CardSearchBtn');if(btn)btn.disabled=false;}
    }
  }
  window.v745SearchCard=refreshRows;
  window.v745ClearCardSearch=async function(){clean();await refreshRows(true);};
  function beforeCardSwitch(){
    inputClean();
    const visible=E('v745CardSearchInput');if(visible)visible.value='';
    notice('Busque por número y año. Solo se consultará la tarjeta seleccionada.');
  }
  function wrap(name){
    const previous=window[name];
    if(typeof previous!=='function' || previous.__v745)return;
    const next=async function(...args){
      beforeCardSwitch();
      const result=await previous.apply(this,args);
      renderToolbar();
      return result;
    };
    next.__v745=true;
    window[name]=next;
    // Los manejadores onclick en línea pueden referirse al binding de función global.
    try{
      if(name==='showUserCard')showUserCard=next;
      if(name==='showKpiExpedientes')showKpiExpedientes=next;
      if(name==='changeOwnerStateFilter')changeOwnerStateFilter=next;
      if(name==='setOwner')setOwner=next;
    }catch(_){ }
  }
  function init(){
    const panel=E('panelDetailWrap');
    if(!panel || E('v745CardSearchBar'))return;
    const bar=document.createElement('div');
    bar.id='v745CardSearchBar';
    bar.hidden=true;
    bar.setAttribute('role','search');
    bar.innerHTML=`<div class="v745-field">
      <label id="v745CardSearchLabel" for="v745CardSearchInput">Buscar en la tarjeta seleccionada</label>
      <input id="v745CardSearchInput" type="search" autocomplete="off" spellcheck="false"
        placeholder="Ej.: 844-2025 (sin ceros iniciales)" aria-describedby="v745CardSearchMessage">
      </div><div class="v745-actions">
        <button id="v745CardSearchBtn" class="btn" type="button">🔎 Buscar</button>
        <button id="v745CardSearchClear" class="btn secondary" type="button">Limpiar</button>
      </div><small id="v745CardSearchMessage">Busque por número y año. Solo se consultará la tarjeta seleccionada.</small>`;
    const tableHead=panel.querySelector('.table-head');
    if(tableHead)tableHead.insertAdjacentElement('afterend',bar);
    else panel.prepend(bar);
    E('v745CardSearchBtn').addEventListener('click',()=>refreshRows(true));
    E('v745CardSearchClear').addEventListener('click',()=>window.v745ClearCardSearch());
    const input=E('v745CardSearchInput');
    input.addEventListener('keydown',event=>{
      if(event.key==='Enter'){event.preventDefault();clearTimeout(timer);refreshRows(true);}
      if(event.key==='Escape'){event.preventDefault();window.v745ClearCardSearch();}
    });
    input.addEventListener('input',()=>{
      clearTimeout(timer);
      if(!input.value.trim()){
        timer=setTimeout(()=>refreshRows(false),280);
      }else if(fullKey(input.value)){
        timer=setTimeout(()=>refreshRows(false),330);
      }else{
        notice('Complete número y año para buscar únicamente en esta tarjeta.');
      }
    });
    ['showUserCard','showKpiExpedientes','changeOwnerStateFilter','setOwner'].forEach(wrap);
    const title=E('panelTitle');
    if(title){
      const observer=new MutationObserver(()=>renderToolbar());
      observer.observe(title,{childList:true,characterData:true,subtree:true});
    }
    renderToolbar();
    window.addEventListener('focus',renderToolbar);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});
  else init();
})();
</script>

<style id="v750-admin-personal-css">
#peopleModal .modal-box{max-width:1080px}
#peopleModal .v750-area-cell{display:flex;align-items:center;gap:6px;justify-content:center;min-width:245px}
#peopleModal .v750-area-select{min-width:132px;max-width:260px;flex:1 1 150px}
#peopleModal .v750-save-area{white-space:nowrap;font-size:10px;padding:7px 9px;flex:0 0 auto}
#peopleModal .v750-area-cell.v750-pending .v750-area-select{border:2px solid #c58b19;background:#fffaf0}
#peopleModal .v750-area-cell.v750-pending .v750-save-area:not(:disabled){background:#1f4e78}
#peopleModal #peopleStatus{min-height:20px;line-height:1.45}
#peopleModal .people-table{max-height:min(57vh,510px)}
@media(max-width:850px){#peopleModal .v750-area-cell{flex-wrap:wrap;min-width:185px}#peopleModal .v750-save-area{width:100%}}
</style>
<script id="v750-admin-personal-guardado-area">
/* El cambio de área usa la identidad UUID del catálogo. No actualiza custodias ni movimientos. */
(function(){
  const $=id=>document.getElementById(id);
  const clean=v=>String(v??'').trim();
  const normArea=v=>clean(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().replace(/\s+/g,' ');
  const busyPeople=new Set();
  window.v750AreaChanged=function(select){
    if(!select)return;
    const cell=select.closest('.v750-area-cell');
    if(!cell)return;
    const changed=normArea(select.value)!==normArea(select.dataset.oldArea||'');
    cell.classList.toggle('v750-pending',changed);
    const btn=cell.querySelector('.v750-save-area');
    if(btn)btn.disabled=!changed||select.disabled;
    const st=$('peopleStatus');
    if(st&&changed){st.style.color='#8a5b00';st.textContent='Cambio pendiente: pulse «Guardar área» en la fila seleccionada. No utilice «Agregar personal».';}
  };
  window.v750SavePersonArea=async function(id,button){
    const status=$('peopleStatus');
    if(typeof isAdmin!=='function'||!isAdmin()){
      if(status)status.textContent='Solo el administrador puede modificar áreas.';
      return;
    }
    const person=(typeof catalogo!=='undefined'&&Array.isArray(catalogo))
      ?catalogo.find(x=>String(x?.id||'')===String(id)):null;
    const cell=button?.closest('.v750-area-cell');
    const select=cell?.querySelector('.v750-area-select');
    if(!person||!select||busyPeople.has(String(id)))return;
    const area=clean(select.value);
    if(normArea(person.area_trabajo)===normArea(area)){v750AreaChanged(select);return;}
    busyPeople.add(String(id));
    select.disabled=true;
    if(button)button.disabled=true;
    if(status){status.style.color='#516b84';status.textContent=`Guardando el área de ${person.nombre}…`;}
    try{
      if(typeof sb==='undefined'||!sb)throw Error('No hay conexión con Supabase.');
      const result=await sb.rpc('v750_admin_guardar_area_personal',{
        p_personal_id:String(person.id),p_area:area||null
      });
      if(result.error)throw result.error;
      const resultRow=Array.isArray(result.data)?result.data[0]:result.data;
      const storedArea=clean(resultRow?.area_nueva??area);
      // La identidad, los expedientes, cargos y el historial NO se modifican.
      person.area_trabajo=storedArea||null;
      let warnings=[];
      if(typeof v298SyncPersonTeamAfterAreaChange==='function'){
        try{
          const synced=await v298SyncPersonTeamAfterAreaChange(person.nombre,storedArea);
          warnings=Array.isArray(synced?.warnings)?synced.warnings:[];
        }catch(err){warnings=[String(err?.message||err)];}
      }
      // Primero actualizar catálogo / cuadro actual, para que el usuario vea el resultado.
      if(typeof loadCatalogo==='function')await loadCatalogo();
      if(typeof renderPeople==='function')renderPeople();
      if(typeof renderPeopleAreaSelect==='function')renderPeopleAreaSelect($('pArea')?.value||'');
      if(typeof fillSelects==='function')fillSelects();
      if(typeof renderSidebar==='function')renderSidebar();
      if(typeof renderSummary==='function')renderSummary();
      if(typeof renderOwnerCards==='function')renderOwnerCards();
      const message=`${person.nombre}: área guardada en ${storedArea||'SIN ASIGNAR'}. Los expedientes y el historial se conservan.`;
      if(status){status.style.color=warnings.length?'#9a6700':'#166534';status.textContent=message+(warnings.length?' Atención: revisar configuración de equipos: '+warnings.join(' · '):'');}
      if(typeof showToast==='function')showToast('Área del personal actualizada');
      // Los contadores se recalculan sin impedir al administrador seguir trabajando.
      try{
        if(typeof loadOwnerCards==='function')await loadOwnerCards();
        if(typeof renderOwnerCards==='function')renderOwnerCards();
        if(typeof renderSidebar==='function')renderSidebar();
      }catch(err){
        console.warn('V750 actualización secundaria de contadores:',err);
        if(status)status.textContent+=' No se actualizaron todos los contadores; vuelva a abrir «Expedientes por área».';
      }
    }catch(err){
      console.error('V750 guardado de área:',err);
      if(status){status.style.color='#a61b1b';status.textContent='No se pudo guardar el cambio de área: '+String(err?.message||err);}
      try{if(typeof loadCatalogo==='function')await loadCatalogo();if(typeof renderPeople==='function')renderPeople();}catch(_){
        select.disabled=false;
        v750AreaChanged(select);
      }
    }finally{
      busyPeople.delete(String(id));
      if(select.isConnected){select.disabled=false;v750AreaChanged(select);}
    }
  };
})();
</script>


<style id="v752-asunto-por-reasignacion-css">
.v752-subject-col{min-width:210px;max-width:300px}
.v752-subject-select{min-width:190px;width:100%;font:inherit;font-size:11px;padding:7px;border-radius:7px;border:1px solid #c9d6e6;background:#fff;color:#203044}
.v752-previous-subject{font-size:10px;color:#566b83;margin-bottom:5px;line-height:1.3;overflow-wrap:anywhere}
.v752-detail-subject-area{grid-column:1/-1}
#v752DetailSubjectRows{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px;margin-top:5px}
.v752-detail-subject-row{padding:8px 10px;background:#f6f9fd;border:1px solid #d8e2ec;border-radius:8px;min-width:0}
.v752-detail-subject-row strong{font-size:11px;display:block;color:#174268;margin-bottom:5px}
.v752-current-subject{margin-top:5px;padding:5px 8px;border-radius:7px;background:#ecf4ff;color:#1d446e;font-size:11px}
</style>
<script id="v752-asunto-por-reasignacion-script">
/* V752: asunto opcional por UUID y ciclo confirmado; sin cambiar solicitud/cargo. */
const v752DetailSubjects=new Map();
const v752DetailSubjectCurrent=new Map();
function v752AsuntoOptions(selected=''){
  const list=(typeof asuntosCatalogo!=='undefined'&&Array.isArray(asuntosCatalogo)?asuntosCatalogo:[])
    .filter(x=>x&&x.activo!==false&&String(x.nombre||'').trim())
    .map(x=>String(x.nombre).trim()).sort((a,b)=>a.localeCompare(b,'es'));
  const unique=[...new Set(list)];
  return '<option value="">— Mantener asunto vigente —</option>'+unique.map(x=>
    `<option value="${esc(x)}" ${selected===x?'selected':''}>${esc(x)}</option>`).join('');
}
function v752ChangeBulkAsunto(id,value){
  const row=(bulkReassignRows||[]).find(r=>String(r.id)===String(id));
  if(row)row._v752_nuevo=String(value||'').trim();
  if(typeof window.v753RefreshReassignSubject==='function')window.v753RefreshReassignSubject();
}
function v752AsuntosBulk(rows){
  const result={};
  for(const r of rows||[]){if(String(r._v752_nuevo||'').trim())result[String(r.id)]=String(r._v752_nuevo).trim();}
  return result;
}
async function v752FetchBulkSubjects(rows){
  const ids=(rows||[]).map(x=>String(x.id)).filter(Boolean);
  if(!ids.length||!sb)return;
  const authId=String(session?.user?.id||'');
  const {data,error}=await sb.rpc('v723_cargo_materia_ciclo_vigente',{p_expediente_ids:ids});
  if(error){console.warn('V752 consulta de asuntos vigentes:',error.message);return;}
  if(authId!==String(session?.user?.id||'')||!el('bulkReassignModal')?.classList.contains('show'))return;
  const m=new Map((data||[]).map(r=>[String(r.expediente_id),String(r.asunto||'').trim()]));
  for(const row of rows){
    if((bulkReassignRows||[]).includes(row))row._v752_asunto=m.get(String(row.id))||'';
  }
  renderBulkReassignRows();
}
function v752AsuntosSelected(ids){
  const map={};
  for(const id of ids||[]){
    const value=String(v752DetailSubjects.get(String(id))||'').trim();
    if(value)map[String(id)]=value;
  }
  return map;
}
function v752RenderDetailSubjectRows(){
  const holder=el('v752DetailSubjectRows');
  if(!holder)return;
  if(typeof isCoordinatorTeamWorkspaceV206==='function'&&isCoordinatorTeamWorkspaceV206()){
    holder.innerHTML='<span class="note">Seguimiento del equipo: solo lectura.</span>';return;
  }
  const rows=(requestDetailRows||[]).filter(r=>requestSelectedIds.has(r.expediente_id)&&requestItemCanReassign(r));
  if(!rows.length){holder.innerHTML='<span class="note">Seleccione uno o más expedientes EN PRÉSTAMO para indicar un asunto diferente.</span>';return;}
  holder.innerHTML=rows.map(r=>{
    const id=String(r.expediente_id),value=v752DetailSubjects.get(id)||'';
    const vigente=v752DetailSubjectCurrent.get(id)||String(currentRequest?.asunto||'');
    return `<div class="v752-detail-subject-row"><strong>${esc(r.expediente||id)}${r.extension?' · '+esc(r.extension):''}</strong>
      <div class="v752-previous-subject">Vigente: ${esc(vigente||'Sin asunto indicado')}</div>
      <select class="v752-subject-select" onchange="v752DetailSubjects.set('${id}',this.value)">${v752AsuntoOptions(value)}</select></div>`;
  }).join('');
  v752FetchDetailSubjects(rows.map(r=>String(r.expediente_id)));
}
let v752DetailsFetching=false;
async function v752FetchDetailSubjects(ids){
  if(v752DetailsFetching||!ids.some(id=>!v752DetailSubjectCurrent.has(id))||!currentRequestId)return;
  v752DetailsFetching=true;
  const currentId=String(currentRequestId), profile=String(session?.user?.id||'');
  try{
    const {data,error}=await sb.rpc('v723_cargo_materia_ciclo_vigente',{p_expediente_ids:ids});
    if(error)throw error;
    if(currentId!==String(currentRequestId)||profile!==String(session?.user?.id||''))return;
    for(const row of data||[]){
      if(String(row.solicitud_id)!==currentId)continue;
      v752DetailSubjectCurrent.set(String(row.expediente_id),String(row.asunto||'').trim());
    }
    const holder=el('v752DetailSubjectRows');
    if(holder){
      // Reactualizar el asunto vigente sin volver a consultar inmediatamente.
      const eligible=(requestDetailRows||[]).filter(r=>requestSelectedIds.has(r.expediente_id)&&requestItemCanReassign(r));
      holder.innerHTML=eligible.map(r=>{
        const id=String(r.expediente_id),value=v752DetailSubjects.get(id)||'';
        const asunto=v752DetailSubjectCurrent.get(id)||String(currentRequest?.asunto||'');
        return `<div class="v752-detail-subject-row"><strong>${esc(r.expediente||id)}</strong><div class="v752-previous-subject">Vigente: ${esc(asunto||'Sin asunto indicado')}</div><select class="v752-subject-select" onchange="v752DetailSubjects.set('${id}',this.value)">${v752AsuntoOptions(value)}</select></div>`;
      }).join('');
    }
  }catch(error){console.warn('V752 detalle de asuntos:',error?.message||error);}
  finally{v752DetailsFetching=false;}
}
</script>

<!-- V754 · REASIGNADOS POR MÍ: solo consulta de observaciones e historial. -->
<style id="v754-reasignados-lectura-style">
body.v754-reasignados-consulta #panelTable tbody tr{cursor:default!important}
body.v754-reasignados-consulta #panelTable tbody tr:hover{cursor:default!important}
body.v754-reasignados-consulta #panelTable input[type="checkbox"]{display:none!important;pointer-events:none!important}
body.v754-reasignados-consulta #panelTable tr.record-selected-row,
body.v754-reasignados-consulta #panelTable tr.selected-row{background:inherit!important;box-shadow:none!important}
body.v754-reasignados-consulta #v735ObservacionesModal label[for="v735NoteInput"],
body.v754-reasignados-consulta #v735NoteInput,
body.v754-reasignados-consulta #v735NoteSave,
body.v754-reasignados-consulta #v735NoteStatus,
body.v754-reasignados-consulta #v736GestionDesdeObs{display:none!important}
body.v754-reasignados-consulta #v735ObservacionesModal .v735-dialog-actions{display:none!important}
#v754IrHistorial{display:none;margin:7px 0 10px 0}
body.v754-reasignados-consulta #v735ObservacionesModal.show #v754IrHistorial{display:inline-flex}
</style>
<script id="v754-reasignados-lectura-script">
(function(){
  'use strict';
  const $=id=>document.getElementById(id);
  let activeHistoryId='';
  let scheduled=false;
  function normalized(value){return String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toUpperCase();}
  function onlyConsult(){
    // El modo real se almacena en un binding global `let`, que no siempre
    // coincide con window.userPanelMode (origen del defecto V316).
    let mode='';
    try{mode=typeof userPanelMode!=='undefined'?userPanelMode:window.userPanelMode;}catch(_){mode=window.userPanelMode||'';}
    return normalized(mode)==='REASIGNADOS_POR_MI';
  }
  function clearSelection(){
    if(!onlyConsult())return;
    try{if(typeof selectedIds!=='undefined'&&selectedIds?.size)selectedIds.clear();}catch(_){ }
    try{if(window.selectedIds?.size)window.selectedIds.clear();}catch(_){ }
    // No llamar aquí a renderizadores que refresquen la tabla recursivamente.
  }
  function lockRows(){
    const active=onlyConsult();
    document.body.classList.toggle('v754-reasignados-consulta',active);
    if(!active)return;
    clearSelection();
    const container=$('panelTable');if(!container)return;
    for(const table of container.querySelectorAll('table')){
      const header=table.tHead?.rows?.[0];
      const firstTh=header?.cells?.[0];
      if(firstTh && (firstTh.querySelector('input[type="checkbox"]')||normalized(firstTh.textContent)==='SELECCIONAR')){
        firstTh.textContent='N.°';
      }
      const rows=[...(table.tBodies?.[0]?.rows||[])];
      rows.forEach((row,i)=>{
        // Suprimir la selección (también la aplicada mediante clic en toda la fila).
        if(row.hasAttribute('onclick'))row.removeAttribute('onclick');
        row.removeAttribute('aria-selected');
        row.classList.remove('record-selectable-row','record-selected-row','v291-own-selectable','v291-own-selected','row-click-select','selected-row','is-selected');
        const first=row.cells?.[0];
        if(first && first.querySelector('input[type="checkbox"]'))first.textContent=String(i+1);
        row.querySelectorAll('input[type="checkbox"]').forEach(box=>{
          box.checked=false;box.disabled=true;
        });
      });
    }
  }
  function schedule(){
    if(scheduled)return;
    scheduled=true;
    requestAnimationFrame(()=>{scheduled=false;lockRows();});
  }
  // Defensa ante los handlers de versiones antiguas: solo se permite abrir
  // observaciones, historial y demás enlaces de consulta.
  document.addEventListener('click',function(event){
    if(!onlyConsult() || !event.target.closest('#panelTable'))return;
    const node=event.target;
    if(node.closest('button,a,[role="button"],summary,details'))return;
    event.preventDefault();event.stopImmediatePropagation();
    clearSelection();
  },true);
  document.addEventListener('change',function(event){
    if(!onlyConsult() || !event.target.closest('#panelTable'))return;
    if(event.target.matches('input[type="checkbox"]')){
      event.target.checked=false;
      event.preventDefault();event.stopImmediatePropagation();
      clearSelection();
    }
  },true);
  function ensureHistoryButton(){
    const dialog=$('v735ObservacionesModal');
    if(!dialog || $('v754IrHistorial'))return;
    const btn=document.createElement('button');
    btn.type='button';btn.id='v754IrHistorial';
    btn.className='btn secondary small';
    btn.textContent='Ver historial del expediente';
    btn.addEventListener('click',()=>{
      if(!activeHistoryId)return;
      const id=activeHistoryId;
      if(typeof window.v735CerrarObservaciones==='function')window.v735CerrarObservaciones();
      if(typeof window.showExpHistory==='function')window.showExpHistory(id);
      else if(typeof showExpHistory==='function')showExpHistory(id);
    });
    const label=[...dialog.querySelectorAll('strong')].find(n=>normalized(n.textContent)==='HISTORIAL DE OBSERVACIONES');
    if(label)label.insertAdjacentElement('afterend',btn);
    else dialog.querySelector('.v735-dialog')?.appendChild(btn);
  }
  function wrapObservations(){
    ensureHistoryButton();
    const prev=window.v735AbrirObservaciones;
    if(typeof prev!=='function'||prev.__v754)return;
    const next=async function(id,num){
      activeHistoryId=String(id||'');
      ensureHistoryButton();
      document.body.classList.toggle('v754-reasignados-consulta',onlyConsult());
      return await prev.apply(this,arguments);
    };
    next.__v754=true;
    window.v735AbrirObservaciones=next;
  }
  function init(){
    wrapObservations();schedule();
    const panel=$('panelTable');
    if(panel)new MutationObserver(schedule).observe(panel,{childList:true,subtree:true});
    const header=$('panelTitle');
    if(header)new MutationObserver(schedule).observe(header,{childList:true,subtree:true,characterData:true});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});
  else init();
  window.v754ReadonlyReassignedByMe=onlyConsult;
  window.v754RecheckReadonly=schedule;
})();
</script>
