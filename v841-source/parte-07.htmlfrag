#locationNoticeModal .v829-mail-status.warn{background:#fff2dc;color:#87530c}
#locationNoticeModal .v829-mail-status.err{background:#fff0ec;color:#9a3324}
</style>
<script id="v829-mail-followup">
(()=>{
'use strict';
const $=id=>document.getElementById(id);
const enc=t=>String(t??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]||c));
let seq=0;
const states={
 'PENDIENTE':['En cola, pendiente de Gmail','warn'],
 'PROCESANDO':['Gmail procesando envío','warn'],
 'ENVIADO':['Aceptado por Gmail (entrega final no confirmada)','ok'],
 'ERROR':['Error de envío · reintento controlado','err'],
 'ERROR_COLA':['Error al registrar el correo','err'],
 'SIN_DESTINATARIO':['Sin correo institucional autorizado','err'],
 'CANCELADO':['Correo cancelado','err'],
 'AVISO_ANTERIOR_SIN_CORREO':['Aviso histórico · sin correo automático','warn'],
 'NO_SOLICITADO':['No se solicitó correo','warn']
};
async function refresh(requestId){
 const id=String(requestId||$('locationNoticeModal')?.dataset?.requestId||'');
 const box=$('v829MailRows');if(!box||!id)return;
 const token=++seq;
 box.textContent='Consultando comunicaciones...';
 try{
  if(typeof sb==='undefined'||!sb)throw Error('Sin conexión con Supabase.');
  const {data,error}=await sb.rpc('v829_estados_correo_ubicacion',{p_solicitud_id:id});
  if(error)throw error;
  if(token!==seq||$('locationNoticeModal')?.dataset?.requestId!==id)return;
  if(!Array.isArray(data)||!data.length){box.textContent='Esta solicitud todavía no tiene avisos de ubicación.';return;}
  const isArchive=typeof hasFullAccess==='function'&&hasFullAccess();
  box.innerHTML='<div class="v829-mail-grid">'+data.map(r=>{
   const [label,kind]=states[r.estado]||[r.estado||'No determinado','warn'];
   const when=r.enviado_at||r.proveedor_aceptado_at;
   const approved=when?'<small>Registro del procesador: '+enc(new Date(when).toLocaleString('es-PE',{timeZone:'America/Lima'}))+'</small>':'';
   const email=r.destinatario_email?'<small>Para: '+enc(r.destinatario_email)+'</small>':'';
   const retry=isArchive&&r.puede_reintentar?'<button class="btn secondary small" type="button" data-v829-retry="'+enc(r.aviso_id)+'">Reintentar</button>':'';
   return '<div class="v829-mail-item"><div><strong>'+enc(r.expediente)+' / '+enc(r.extension||'SIN EXTENSIÓN')+'</strong><small>Ubicación: '+enc(r.sede||'POR VERIFICAR')+'</small>'+email+approved+'</div><div><span class="v829-mail-status '+kind+'">'+enc(label)+'</span> '+retry+'</div></div>';
  }).join('')+'</div>';
 }catch(e){if(token!==seq)return;box.textContent='No fue posible consultar el estado de correos: '+(e?.message||e);}
}
window.v829RefreshUbicacionCorreo=refresh;
document.addEventListener('click',async event=>{
 const btn=event.target.closest?.('[data-v829-retry]');if(!btn)return;
 const id=btn.dataset.v829Retry;
 if(!id||btn.disabled)return;
 btn.disabled=true;const text=btn.textContent;btn.textContent='Registrando...';
 try{
  const {data,error}=await sb.rpc('v829_reintentar_correo_ubicacion',{p_aviso_id:id});
  if(error)throw error;
  // V835: el reintento recupera los destinatarios Para/CC guardados en Supabase.
  // Nunca crear otra comunicacion de ubicacion ni reasignar la custodia.
  const msg=data?.mensaje||({
   'EN_COLA':'Correo registrado en cola con los destinatarios autorizados. Consulte los estados.',
   'PENDIENTE':'Correo devuelto a cola; consulte los estados.',
   'SIN_DESTINATARIO':'No se encontraron destinatarios activos para este aviso. Revise el catalogo institucional.',
   'ERROR_COLA':'El correo no pudo incorporarse a la cola. Revise el estado del aviso.'
  }[data?.estado])||'Estado del correo actualizado. Consulte los estados.';
  if(typeof showToast==='function')showToast(msg);
  // V836: reintentar no solo encola; activa el mismo procesador inmediato.
  if(data?.ok && ['EN_COLA','PENDIENTE'].includes(String(data.estado||''))){
   const requestId=document.getElementById('locationNoticeModal')?.dataset?.requestId;
   window.v836ProcesarCorreoUbicacion?.(requestId,[id]);
  }
 }catch(e){if(typeof showToast==='function')showToast(e?.message||'No se pudo reintentar.');}
 finally{btn.disabled=false;btn.textContent=text;await refresh();}
});
})();
</script>
