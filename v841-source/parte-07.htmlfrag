.v626-reit-ready{display:inline-flex;margin-top:4px;padding:3px 7px;border-radius:999px;background:#fff7ed;border:1px solid #fdba74;color:#9a3412;font-size:9px;font-weight:850}
.v626-reit-wait{display:block;margin-top:4px;color:#64748b;font-size:9px;font-weight:750}
.v626-reiterate-btn{background:#9a5b00!important;border-color:#9a5b00!important;color:#fff!important}
.v626-action-stack{display:flex;gap:5px;justify-content:center;align-items:center;flex-wrap:wrap}
.v626-reit-history{margin-top:14px;border:1px solid var(--line);border-radius:10px;background:#fff;overflow:hidden}
.v626-reit-history-head{padding:10px 12px;background:#fff8e7;border-bottom:1px solid #f2ddb0}
#v626ReiterationHistory{padding:10px 12px}
.v626-reit-event{padding:9px 10px;border:1px solid #e6edf5;border-radius:8px;background:#fbfdff;font-size:11px;line-height:1.45}
.v626-reit-event+.v626-reit-event{margin-top:7px}
