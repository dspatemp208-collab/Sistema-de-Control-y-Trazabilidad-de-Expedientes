#locationNoticeModal .v831-group-grid input,#locationNoticeModal .v831-group-grid select,#locationNoticeModal .v831-search input,#locationNoticeModal #v831Subject{height:38px;width:100%;box-sizing:border-box;background:#fff;border:1px solid #b9cee2;border-radius:7px;padding:8px 10px;font-size:12px;color:#163960}
#locationNoticeModal .v831-buttons{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin:8px 0}
#locationNoticeModal .v831-buttons label{margin-left:auto;font-size:11px;white-space:nowrap}
#locationNoticeModal .v831-buttons input{vertical-align:middle}
#locationNoticeModal .v831-recipient-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;margin:10px 0}
#locationNoticeModal .v831-recipient-grid>div{min-width:0;border:1px solid #cadff0;background:#fff;border-radius:8px;overflow:hidden}
#locationNoticeModal .v831-caption{display:flex;justify-content:space-between;gap:6px;align-items:center;background:#e9f2fb;padding:10px;font-size:11px;font-weight:800}
#locationNoticeModal .v831-caption small{font-size:10px;font-weight:600;color:#47739c}
#locationNoticeModal .v831-search{display:flex;gap:7px;padding:8px}
#locationNoticeModal .v831-search input{flex:1;min-width:0}
#locationNoticeModal .v831-search button{white-space:nowrap}
#locationNoticeModal .v831-list{max-height:260px;overflow-y:auto;min-height:70px}
#locationNoticeModal .v831-contact{display:flex;align-items:center;gap:9px;padding:8px 10px;border-bottom:1px solid #e4edf5;font-size:11px;min-height:44px;cursor:pointer;box-sizing:border-box}
#locationNoticeModal .v831-contact:hover{background:#f5f9fd}
#locationNoticeModal .v831-contact input{width:16px;height:16px;flex:none;accent-color:#1670c8}
#locationNoticeModal .v831-contact-info{display:block;min-width:0;flex:1;overflow-wrap:anywhere}
#locationNoticeModal .v831-contact-info b{font-size:11px;color:#183f68;display:block}
#locationNoticeModal .v831-contact-info small{font-size:10px;color:#58738e;display:block;margin-top:3px}
#locationNoticeModal .v831-role{font-size:9px;line-height:1;padding:3px 6px;border:1px solid #c5d9ed;border-radius:15px;background:#f1f6fb;color:#35628a;font-weight:800}
#locationNoticeModal .v831-remove{border:1px solid #c8d8e9;border-radius:7px;background:#fff;cursor:pointer;color:#1f557e;padding:5px 9px}
#locationNoticeModal .v831-message{margin:6px 0 0}
#locationNoticeModal #v831Content[hidden]{display:none!important}
@media(max-width:690px){#locationNoticeModal .v831-recipient-grid,#locationNoticeModal .v831-group-grid{grid-template-columns:1fr}#locationNoticeModal .v831-buttons label{margin-left:0}}
</style>
<!-- V835: recuperación de destinatarios institucionales guardados para reintentos controlados -->
<script id="v831-mail-ui">
(()=>{
 'use strict';
 const $=id=>document.getElementById(id);
 const escape=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const normal=s=>String(s??'').toLowerCase().trim();
 const state={request:'',uid:'',contacts:[],groups:[],suggested:null,roles:new Map(),loaded:false,seq:0,busy:false};
 const client=()=>typeof sb==='undefined'?null:sb;
 const items=()=>state.contacts.filter(c=>c&&c.id&&c.email);
 const byRole=role=>items().filter(c=>state.roles.get(c.id)===role);
 const list=()=>items().filter(c=>state.roles.has(c.id));
 function inform(msg,problem=false){const x=$('v831Status');if(x){x.textContent=msg;x.style.color=problem?'#a23828':'#486e8d';}}
 function note(s){if($('v831GroupStatus'))$('v831GroupStatus').textContent=s;}
 function active(){const yes=!!$('v831Enabled')?.checked;$('v831Content').hidden=!yes;return yes;}
 window.v831ToggleLocationMail=active;
 // V834: selección institucional, usando SOLO correos activos del catálogo cargado.
 // Mantener los grupos personales como alternativa; nunca sobrescribir sus destinatarios.
 const DEFAULT_ARCHIVO=[
  {email:'ds_pa_temp208@produce.gob.pe',rol:'PARA',nombre:'Coordinador de Archivo'},
  {email:'agarciag@produce.gob.pe',rol:'CC',nombre:'Armando García'},
  {email:'jgradosp@produce.gob.pe',rol:'CC',nombre:'Jaime Grados'}
 ];
 function defaults(){
  state.roles.clear();
  const contacts=items();
  for(const expected of DEFAULT_ARCHIVO){
   const found=contacts.find(c=>normal(c.email)===expected.email);
   if(found)state.roles.set(found.id,expected.rol);
  }
  // La comunicación también debe llegar al solicitante cuando tenga correo
  // autorizado. Se incorpora en CC sin desplazar al Coordinador de Archivo.
  if(state.suggested&&!state.roles.has(state.suggested.id)){
   state.roles.set(state.suggested.id,
    Array.from(state.roles.values()).includes('PARA')?'CC':'PARA');
  }
  // Si el Coordinador no está disponible, no impedir la operación:
  // el usuario puede modificar los destinatarios autorizados.
  if(!Array.from(state.roles.values()).includes('PARA')){
   const first=contacts.find(c=>state.roles.has(c.id));
   if(first)state.roles.set(first.id,'PARA');
  }
 }
 function defaultNote(){
  const selected=items();
  const absent=DEFAULT_ARCHIVO.filter(d=>!selected.some(c=>normal(c.email)===d.email));
  const main=byRole('PARA'),copy=byRole('CC');
  if(!absent.length)note('Selección institucional: Coordinador de Archivo (Para), Armando García y Jaime Grados (CC). Puedes cambiar los destinatarios.');
  else note('Destinatarios de Archivo cargados: '+(3-absent.length)+' de 3. No disponibles: '+absent.map(x=>x.nombre).join(', ')+'. Revisa el catálogo.');
  return {main,copy,absent};
 }
 function loadOptions(value=''){
  const s=$('v831Group');if(!s)return;
  s.replaceChildren(new Option('Selección habitual del sistema',''),new Option('Crear nuevo grupo','__new'));
  state.groups.forEach(g=>s.add(new Option(g.nombre,g.id)));
  s.value=state.groups.some(g=>g.id===value)?value:'';
 }
 function render(){
  const q=normal($('v831Search')?.value);
  const filtered=items().filter(c=>normal(c.nombre+' '+c.email).includes(q));
  $('v831AvailableCount').textContent=filtered.length+' de '+items().length;
  $('v831Available').innerHTML=filtered.map(c=>'<label class="v831-contact"><input type="checkbox" data-v831-id="'+escape(c.id)+'" '+(state.roles.has(c.id)?'checked ':'')+'><span class="v831-contact-info"><b>'+escape(c.nombre)+'</b><small>'+escape(c.email)+' · '+escape(c.categoria||'USUARIO')+'</small></span></label>').join('')||'<div class="note" style="padding:12px">No hay coincidencias.</div>';
  const selected=list();
  $('v831SelectedCount').textContent=selected.length+' seleccionado(s) · '+byRole('PARA').length+' Para · '+byRole('CC').length+' CC';
  $('v831Selected').innerHTML=selected.map(c=>{
   const role=state.roles.get(c.id);
   return '<div class="v831-contact"><span class="v831-contact-info"><b>'+escape(c.nombre)+'</b><small>'+escape(c.email)+'</small></span><select aria-label="Tipo de destinatario para '+escape(c.nombre)+'" class="v833-role" data-v833-role="'+escape(c.id)+'"><option value="PARA" '+(role==='PARA'?'selected':'')+'>Para</option><option value="CC" '+(role==='CC'?'selected':'')+'>CC</option></select><button type="button" class="v831-remove" data-v831-remove="'+escape(c.id)+'" title="Quitar destinatario">×</button></div>';
  }).join('')||'<div class="note" style="padding:12px">Seleccione personal autorizado a la izquierda.</div>';
 }
 window.v831RenderRecipients=render;
 window.v831ClearCc=()=>{state.roles.clear();render();note('Selección vacía. Agrega destinatarios y define Para o CC.');};
 window.v831ChooseGroup=()=>{
  const id=$('v831Group').value;
  if(id==='__new'){state.roles.clear();$('v831GroupName').value='';$('v831DefaultGroup').checked=false;render();note('Nuevo grupo: selecciona Para y CC y guarda.');return;}
  const group=state.groups.find(g=>g.id===id);
  if(!group){defaults();$('v831GroupName').value='';$('v831DefaultGroup').checked=false;render();defaultNote();return;}
  state.roles.clear();
  const current=new Set(items().map(c=>c.id));
  if(Array.isArray(group.para_ids)&&group.para_ids.length){
    (group.para_ids||[]).filter(x=>current.has(x)).forEach(x=>state.roles.set(x,'PARA'));
    (group.cc_ids||[]).filter(x=>current.has(x)&&!state.roles.has(x)).forEach(x=>state.roles.set(x,'CC'));
  }else{
    // Grupos anteriores a V833: conservar sus destinatarios como CC.
    // El solicitante se propone en Para cuando está autorizado.
    (group.destinatario_ids||[]).filter(x=>current.has(x)).forEach(x=>state.roles.set(x,'CC'));
    if(state.suggested)state.roles.set(state.suggested.id,'PARA');
  }
  $('v831GroupName').value=group.nombre;$('v831DefaultGroup').checked=!!group.predeterminado;
  render();note('Grupo aplicado: '+byRole('PARA').length+' Para y '+byRole('CC').length+' CC.');
 };
 async function loadGroups(chooseDefault=false){
  if(!state.uid||!client())return;
  const {data,error}=await client().rpc('v833_listar_grupos_ubicacion');
  if(error)throw error;
  state.groups=Array.isArray(data)?data:[];
  const id=chooseDefault?state.groups.find(g=>g.predeterminado)?.id:'';
  loadOptions(id);
  if(id)window.v831ChooseGroup();
 }
 window.v831OpenLocationMail=async(request,header)=>{
  const seq=++state.seq;
  state.request=String(request||'');state.uid=String(session?.user?.id||'');
  state.contacts=[];state.suggested=null;state.groups=[];state.roles.clear();state.loaded=false;
  $('v831Enabled').checked=true;$('v831Search').value='';$('v831GroupName').value='';$('v831Subject').value='';
  $('v831DefaultGroup').checked=false;loadOptions();active();render();
  if($('v832RetryRecipients'))$('v832RetryRecipients').hidden=true;
  inform('Cargando destinatarios autorizados...');
  try{
   const {data,error}=await client().rpc('v831_opciones_correo_ubicacion',{p_solicitud_id:request});
   if(error)throw error;
   if(seq!==state.seq||state.request!==String(request))return;
   state.contacts=Array.isArray(data?.contactos)?data.contactos:[];
   state.suggested=items().find(c=>c.id===data?.solicitante_contact_id)||null;
   defaults();state.loaded=true;
   $('v831Subject').value='Comunicación de ubicación verificada - '+(data?.solicitud_numero||header?.numero||'Solicitud');
   render();
   try{await loadGroups(true);}catch(e){note('Contactos cargados; no se pudieron consultar los grupos: '+(e?.message||e));}
   const isCustom=!!state.groups.find(g=>g.id===$('v831Group').value);
   if(!isCustom)defaultNote();
   if(!byRole('PARA').length){
    inform('No hay destinatarios principales autorizados seleccionados. Selecciona un trabajador y asígnale Para.',true);
   }else if(!state.suggested){
    inform('Archivo está seleccionado por defecto. El solicitante no tiene un contacto autorizado vinculado; el correo se enviará únicamente a los destinatarios que aparecen en la derecha.');
   }else{
    inform('Destinatarios listos: '+byRole('PARA').length+' Para y '+byRole('CC').length+' CC. Puedes modificar la selección antes de comunicar.');
   }
  }catch(e){if(seq!==state.seq)return;inform('No se pudo cargar el catálogo: '+(e?.message||e),true);if($('v832RetryRecipients'))$('v832RetryRecipients').hidden=false;render();}
 };
 window.v832RetryLocationRecipients=()=>{if(state.request)window.v831OpenLocationMail(state.request);};
 window.v831GetLocationDraft=()=>{
  if(!active())return{ok:true,enabled:false,paraIds:[],ccIds:[],subject:''};
  if(!state.loaded)return{ok:false,error:'La lista de destinatarios no está cargada. Actualice el catálogo.'};
  const para=byRole('PARA'),cc=byRole('CC');
  if(!para.length)return{ok:false,error:'Seleccione al menos un destinatario con la opción Para.'};
  if(para.length+cc.length>40)return{ok:false,error:'Puede seleccionar hasta 40 destinatarios en total.'};
  const emails=[...para,...cc].map(c=>normal(c.email));
  if(new Set(emails).size!==emails.length)return{ok:false,error:'La misma dirección no puede figurar más de una vez entre Para y CC.'};
  const subject=$('v831Subject').value.trim();
  if(subject.length<6||subject.length>180||/[\r\n]/.test(subject))return{ok:false,error:'Ingrese un asunto válido de 6 a 180 caracteres.'};
  return{ok:true,enabled:true,paraIds:para.map(c=>c.id),ccIds:cc.map(c=>c.id),subject};
 };
 window.v831SaveGroup=async(updating)=>{
  if(state.busy||!state.uid||!state.loaded)return;
  const id=$('v831Group').value,name=$('v831GroupName').value.trim();
  if(updating&&!state.groups.some(g=>g.id===id))return note('Seleccione un grupo guardado.');
  if(!updating&&id&&id!=='__new')return note('Seleccione «Crear nuevo grupo» para guardar uno diferente.');
  if(name.length<2||name.length>80)return note('El nombre debe contener entre 2 y 80 caracteres.');
  const para=byRole('PARA').map(c=>c.id),cc=byRole('CC').map(c=>c.id);
  if(!para.length)return note('Seleccione al menos un destinatario Para.');
  state.busy=true;
  try{
   const {data,error}=await client().rpc('v833_guardar_grupo_ubicacion',{
    p_id:updating?id:null,p_nombre:name,p_para_ids:para,p_cc_ids:cc,
    p_predeterminado:!!$('v831DefaultGroup').checked
   });
   if(error)throw error;
   await loadGroups(false);loadOptions(data);window.v831ChooseGroup();
   note('Grupo guardado con '+para.length+' destinatario(s) Para y '+cc.length+' CC.');
  }catch(e){note('No se pudo guardar: '+(e?.message||e));}
  finally{state.busy=false;}
 };
 window.v831RemoveGroup=async()=>{
  const id=$('v831Group').value;
  if(!state.groups.some(g=>g.id===id))return note('Seleccione un grupo guardado.');
  if(!confirm('¿Eliminar este grupo personal de correos?'))return;
  const {error}=await client().from('v796_grupos_correo_usuario').delete().eq('id',id)
   .eq('usuario_id',state.uid).eq('operacion','UBICACION');
  if(error)return note('No se pudo eliminar: '+error.message);
  await loadGroups(false);defaults();render();defaultNote();
 };
 document.addEventListener('change',e=>{
  const cb=e.target.closest?.('[data-v831-id]');
  if(cb){const id=cb.dataset.v831Id;
   if(cb.checked)state.roles.set(id,byRole('PARA').length?'CC':'PARA');else state.roles.delete(id);
   render();return;
  }
  const role=e.target.closest?.('[data-v833-role]');
  if(role){state.roles.set(role.dataset.v833Role,role.value==='PARA'?'PARA':'CC');render();}
 });
 document.addEventListener('click',e=>{
  const b=e.target.closest?.('[data-v831-remove]');if(!b)return;
  state.roles.delete(b.dataset.v831Remove);render();
 });
})();
</script>
<style id="v833-role-styles">
#locationNoticeModal .v833-role{font-size:11px;min-width:72px;width:72px;height:30px;padding:3px 5px;border:1px solid #a7c8e5;border-radius:6px;background:#eef6ff;color:#183f69;cursor:pointer;flex:none}
#locationNoticeModal .v831-contact .v833-role{margin-left:auto}
#locationNoticeModal .v831-contact-info{flex:1;min-width:0}
#locationNoticeModal .v831-caption small{white-space:nowrap}
@media(max-width:450px){#locationNoticeModal .v833-role{width:66px;min-width:66px}}
</style>

<!-- V836: activar el procesador de ubicacion al confirmar o reintentar, sin duplicados. -->
<style id="v836-location-mail-style">
#locationNoticeModal #v836LocationMailProgress:not([hidden]){
  display:block;padding:9px 12px;margin:8px 0 0;border:1px solid #c9deee;
  border-radius:8px;background:#f1f7fd;color:#235078;font-size:12px;line-height:1.5;
}
#locationNoticeModal #v836LocationMailProgress[data-v836-kind="ok"]{
  border-color:#bcdcc9;background:#eef8f2;color:#165a35;
}
#locationNoticeModal #v836LocationMailProgress[data-v836-kind="warn"]{
  border-color:#edd7a8;background:#fff8e9;color:#77540e;
}
</style>
<script id="v836-location-mail-immediate">
(()=>{
 'use strict';
 let generation=0;
 const timers=new Set();
 const $=id=>document.getElementById(id);
 const uid=()=>{try{return String(session?.user?.id||'');}catch(_){return '';}};
 const valid=(solicitud,usuario,token)=>token===generation && !!usuario && uid()===usuario &&
    $('locationNoticeModal')?.dataset?.requestId===solicitud &&
    $('locationNoticeModal')?.classList.contains('show');
 const inform=(solicitud,usuario,token,message,kind='')=>{
  if(!valid(solicitud,usuario,token))return;
  const node=$('v836LocationMailProgress');if(!node)return;
  node.hidden=false;node.dataset.v836Kind=kind;node.textContent=message;
 };
 function later(fn,ms){const timer=setTimeout(()=>{timers.delete(timer);fn();},ms);timers.add(timer);}
 function clearTimers(){for(const t of timers)clearTimeout(t);timers.clear();}
 async function status(solicitud,avisos,usuario,token){
  if(!valid(solicitud,usuario,token))return true;
  try{
   const {data,error}=await sb.rpc('v829_estados_correo_ubicacion',{p_solicitud_id:solicitud});
   if(error)throw error;
   if(!valid(solicitud,usuario,token))return true;
   const wanted=new Set(avisos);
   const rows=(Array.isArray(data)?data:[]).filter(x=>wanted.has(String(x.aviso_id||'')));
   if(rows.length===wanted.size && rows.length){
    const allAccepted=rows.every(x=>x.estado==='ENVIADO');
    if(allAccepted){
     inform(solicitud,usuario,token,
      'El correo principal de cada aviso fue aceptado por Gmail. Consulta «Estado de todos los correos» para confirmar el estado individual de cada destinatario. La recepción final no está confirmada.','ok');
     window.v829RefreshUbicacionCorreo?.(solicitud);
     return true;
    }
    const failed=rows.filter(x=>['SIN_DESTINATARIO','ERROR_COLA','ERROR','CANCELADO'].includes(String(x.estado||'')));
    if(failed.length){
     inform(solicitud,usuario,token,
      'Se detectó una incidencia en el procesamiento. Consulta los estados y el detalle del error; el aviso registrado no se modificó.','warn');
     window.v829RefreshUbicacionCorreo?.(solicitud);
     return true;
    }
   }
   inform(solicitud,usuario,token,
    'Correo registrado y solicitado al procesador. La aceptación por Gmail sigue pendiente; se actualizan los estados automáticamente.');
   window.v829RefreshUbicacionCorreo?.(solicitud);
   return false;
  }catch(e){
   inform(solicitud,usuario,token,
    'No fue posible verificar el estado en este momento. El correo permanece registrado; consulta «Actualizar estados».','warn');
   return false;
  }
 }
 function start(solicitud,avisos){
  solicitud=String(solicitud||'');
  avisos=[...new Set((Array.isArray(avisos)?avisos:[]).map(String).filter(Boolean))];
  const usuario=uid();
  if(!solicitud||!avisos.length||!usuario)return;
  clearTimers();const token=++generation;
  inform(solicitud,usuario,token,'Ubicación registrada. Solicitando el procesamiento inmediato del correo…');
  const trigger=async()=>{
   if(token!==generation||!usuario||uid()!==usuario)return;
   const drain=window.v558ProcesarNotificacionesExternas;
   if(typeof drain!=='function'){
    inform(solicitud,usuario,token,
     'Procesador inmediato no disponible. El correo permanece en cola y puede ser enviado por el siguiente proceso automático.','warn');
    return;
   }
   // La funcion V558 usa sesion autenticada y bloquea envios concurrentes por pestaña.
   // Supabase mantiene el mismo event_key para impedir duplicados.
   try{
    const result=await drain(true);
    if(token!==generation)return;
    if(result?.estado==='BLOQUEADO_OAUTH'){
     inform(solicitud,usuario,token,'Gmail requiere autorización. El correo permanece en cola, sin marcarse como enviado.','warn');
    }else if(result?.error){
     inform(solicitud,usuario,token,
      'El procesador no confirmó el envío. Se conserva la cola y el historial; revisa el estado antes de reintentar.','warn');
    }
   }catch(e){
    inform(solicitud,usuario,token,
     'No se pudo completar el envío inmediato. El correo queda en cola y no se genera uno nuevo.','warn');
   }
  };
  // Ejecutar una vez en cuanto la transaccion de comunicacion ha terminado.
  // Una segunda llamada temprana cubre si otro envío tenía ocupado el procesador.
  void trigger();
  later(()=>{if(valid(solicitud,usuario,token))void trigger();},4000);
  // Consultas breves y acotadas: no consulta cada segundo ni continúa al cerrar el modal.
  for(const delay of [1800,7000,15000,30000]){
   later(async()=>{
    if(!valid(solicitud,usuario,token))return;
    const finished=await status(solicitud,avisos,usuario,token);
    if(finished)clearTimers();
   },delay);
  }
 }
 window.v836ProcesarCorreoUbicacion=start;
})();
</script>


<style id="v839-permissions-styles">
  .v839-admin{margin:16px 0 0;padding:14px;border:1px solid #cbd9e9;border-radius:12px;background:#f8fbff}
  .v839-admin h3{margin:0 0 7px;color:#19416b;font-size:16px}
  .v839-admin h4{margin:16px 0 9px;color:#19416b}
  .v839-admin .note{margin:0 0 11px}
  .v839-filters{display:flex;align-items:end;gap:8px;flex-wrap:wrap;margin:12px 0}
  .v839-filters label{font-size:12px;font-weight:650;flex:1;min-width:200px}
  .v839-filters input{display:block;width:100%;margin-top:5px;padding:8px;border:1px solid #b5c8df;border-radius:7px}
  .v839-table-scroll{max-width:100%;overflow:auto;border:1px solid #dbe4f0;border-radius:8px;background:#fff}
  .v839-table{border-collapse:collapse;min-width:910px;width:100%;font-size:12px}
  .v839-table th{position:sticky;top:0;background:#19436e;color:#fff;padding:9px;text-align:left;white-space:nowrap}
  .v839-table td{padding:8px;border-bottom:1px solid #e0e7f0;vertical-align:middle}
  .v839-table tr:nth-child(even){background:#f5f9fe}
  .v839-table .v839-who{font-weight:650;color:#183e63}
  .v839-table .v839-email{display:block;color:#63768b;font-weight:400;font-size:11px}
  .v839-table input[type=checkbox]{width:17px;height:17px}
  .v839-table input[type=text]{width:175px;max-width:100%;padding:6px;border:1px solid #bccbdc;border-radius:6px}
  .v839-table button{white-space:nowrap}
  .v839-table .v839-inactive{color:#bd3a3a;font-weight:700;font-size:11px}
  body #bulkConasBtn.v839-denied, body #bulkDvcBtn.v839-denied, body #bulkInstructionBtn.v839-denied{display:none!important}
  body.produce-coordinator-self #bulkConasBtn.v839-allowed,
  body.produce-coordinator-self #bulkDvcBtn.v839-allowed,
  body.produce-coordinator-self #bulkInstructionBtn.v839-allowed{display:flex!important}
  body.produce-coordinator-team #bulkConasBtn,body.produce-coordinator-team #bulkDvcBtn,
  body.produce-coordinator-team #bulkInstructionBtn{display:none!important}
</style>
<script id="v839-derivation-permissions">
(function(){
'use strict';
const $=id=>document.getElementById(id);
const up=s=>String(s??'').trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const DEST=['CONAS','DVC','INSTRUCCION'];
const key=d=>up(d).replace(/\s+/g,'')==='INSTRUCCION'?'instruccion':up(d).toLowerCase();
const known=()=>typeof currentProfile!=='undefined'&&currentProfile?.activo!==false&&!!currentProfile?.id;
const uid=()=>known()?String(currentProfile.id):'';
const client=()=>typeof sb!=='undefined'?sb:null;
const admin=()=>known()&&up(currentProfile.rol)==='ADMINISTRADOR';
const ownWorkspace=()=>up(currentProfile?.rol)!=='COORDINADOR' || (typeof isCoordinatorSelfWorkspaceV206==='function'&&isCoordinatorSelfWorkspaceV206());
let self={uid:'',conas:false,dvc:false,instruccion:false,updated:0};
let inflight=null,lastFetch=0,blockedUntil=0;
let list=[],busy=false,historyLoaded=false;
function clearSelf(user=''){
  self={uid:user,conas:false,dvc:false,instruccion:false,updated:0};lastFetch=0;
}
function can(d){const user=uid();if(!user||self.uid!==user||!ownWorkspace())return false;
  return DEST.includes(up(d)) && self[key(d)]===true;
}
window.v839CanDerive=can;
function syncButtons(){
 const user=uid();if(self.uid!==user)clearSelf(user);
 [['CONAS','bulkConasBtn'],['DVC','bulkDvcBtn'],['INSTRUCCION','bulkInstructionBtn']].forEach(([dest,id])=>{
   const btn=$(id);if(!btn)return;
   const ok=can(dest);
   btn.classList.toggle('v839-denied',!ok);
   btn.classList.toggle('v839-allowed',ok);
   if(!ok){btn.disabled=true;return;}
   // The coordinator's personal workspace must honor any selected destination;
   // the team workspace remains read-only.
   if(up(currentProfile?.rol)==='COORDINADOR'&&ownWorkspace()){
     btn.hidden=false;btn.classList.remove('hidden','hidden-by-role');
     btn.disabled=false;
   }
 });
}
window.v839SyncDerivationButtons=syncButtons;
async function refresh(force=false){
 const user=uid();if(!user||!client()){clearSelf(user);syncButtons();return false;}
 if(self.uid!==user)clearSelf(user);
 if(inflight)return inflight;
 if(Date.now()<blockedUntil)return false;
 if(!force && Date.now()-lastFetch<12000)return true;
 lastFetch=Date.now();
 inflight=(async()=>{
   try{
     const {data,error}=await client().rpc('v839_mis_permisos_derivacion');
     if(error)throw error;
     if(uid()!==user)return false;
     if(String(data?.usuario_id||'')!==user)throw new Error('El permiso no corresponde a la sesión actual.');
     self={uid:user,conas:data.conas===true,dvc:data.dvc===true,instruccion:data.instruccion===true,updated:Date.now()};
     // Re-run the existing V664 permission-to-buttons synchronizer after a grant change.
     try{if(typeof window.updateSelectionUI==='function')window.updateSelectionUI();}catch(_){}
     syncButtons();return true;
   }catch(e){
     if(uid()===user){clearSelf(user);syncButtons();}
     const detail=String(e?.message||e||'');
     blockedUntil=Date.now()+(/exceed_egress_quota|\b402\b|service for this project is restricted/i.test(detail)?900000:120000);
     console.warn('V839: no se pudieron confirmar permisos de derivación',e);
     return false;
   }finally{inflight=null;}
 })();return inflight;
}
window.v839CanDeriveFresh=async d=>{await refresh(true);return can(d);};
window.v839ReloadOwnPermissions=()=>refresh(true);
const status=message=>{if($('v839AdminStatus'))$('v839AdminStatus').textContent=message;};
function adminRow(x){
 const fixed=up(x.rol)==='ADMINISTRADOR',disabled=fixed||busy;
 const check=(field,label)=>`<label title="Permitir derivación a ${label}"><input type="checkbox" data-v839-dest="${field}" data-v839-uid="${esc(x.id)}" ${x[field]?'checked':''} ${disabled?'disabled':''} aria-label="${label}: ${esc(x.nombre||x.email)}"></label>`;
 return `<tr data-v839-row="${esc(x.id)}" data-v839-search="${esc(up([x.nombre,x.email,x.rol].join(' ')))}">
 <td><span class="v839-who">${esc(x.nombre||'Sin nombre')}</span><span class="v839-email">${esc(x.email)}</span>${!x.activo?'<span class="v839-inactive">INACTIVO · permisos sin efecto</span>':''}</td>
 <td>${esc(x.rol)}${fixed?'<span class="v839-email">Acceso institucional</span>':''}</td>
 <td>${check('conas','CONAS')}</td><td>${check('dvc','DVC')}</td><td>${check('instruccion','Instrucción')}</td>
 <td><input type="text" id="v839Motivo-${esc(x.id)}" placeholder="Observación" maxlength="500" ${disabled?'disabled':''}></td>
 <td>${fixed?'—':`<button type="button" class="btn secondary small" ${busy?'disabled':''} onclick="v839AdminSave('${esc(x.id)}')">Guardar</button>`}</td></tr>`;
}
function filter(){
 const term=up($('v839AdminSearch')?.value||'');
 document.querySelectorAll('[data-v839-row]').forEach(row=>{row.hidden=!!term && !String(row.dataset.v839Search||'').includes(term);});
}
window.v839AdminFilter=filter;
function render(){if($('v839AdminBody'))$('v839AdminBody').innerHTML=list.map(adminRow).join('')||'<tr><td colspan="7">Sin usuarios registrados.</td></tr>';filter();}
async function loadAdmin(){
 const section=$('v839AdminSection');if(!section)return;
 section.hidden=!admin();if(!admin()||!client())return;
 if(busy)return;
 status('Cargando matriz de permisos...');
 const {data,error}=await client().rpc('v839_admin_matriz_derivaciones');
 if(error){status('No fue posible cargar permisos: '+error.message);return;}
 if(!admin())return;
 list=Array.isArray(data)?data:[];
 render();status(list.length+' cuentas · modificaciones guardadas en Supabase con auditoría individual.');
}
window.v839AdminReload=loadAdmin;
window.v839AdminSave=async id=>{
 if(!admin()||busy)return;
 const original=list.find(x=>x.id===id),tr=document.querySelector(`[data-v839-row="${id}"]`);
 if(!original||!tr||up(original.rol)==='ADMINISTRADOR')return;
 const value=field=>!!tr.querySelector(`[data-v839-dest="${field}"]`)?.checked;
 const payload={p_usuario_id:id,p_conas:value('conas'),p_dvc:value('dvc'),p_instruccion:value('instruccion'),p_motivo:($('v839Motivo-'+id)?.value||'').trim()||null};
 const changed=['conas','dvc','instruccion'].filter(k=>original[k]!==payload['p_'+k]);
 if(!changed.length){status('No se detectaron cambios para este usuario.');return;}
 const name=original.nombre||original.email;
 if(!confirm(`¿Guardar ${changed.length} cambio(s) de permiso para ${name}? Se registrará el historial.`))return;
 busy=true;status('Guardando permisos de '+name+'...');render();
 try{
   const {data,error}=await client().rpc('v839_admin_guardar_derivaciones',payload);
   if(error)throw error;
   if(!data?.ok)throw new Error('Supabase no confirmó la operación.');
   historyLoaded=false;
   busy=false;
   await loadAdmin();
   status('Permisos de '+name+' actualizados: '+data.modificados+' cambio(s) auditado(s).');
 }catch(e){status('No se guardaron los permisos: '+(e.message||e));}
 finally{busy=false;render();}
};
window.v839ToggleHistory=async()=>{
 if(!admin())return;
 const section=$('v839History');if(!section)return;
 section.hidden=!section.hidden;
 if(section.hidden)return;
 if(historyLoaded)return;
 const {data,error}=await client().rpc('v839_admin_historial_derivaciones',{p_limit:100});
 if(error){status('No se pudo consultar el historial: '+error.message);return;}
 const rows=Array.isArray(data)?data:[];
 $('v839HistoryBody').innerHTML=rows.map(r=>`<tr>
 <td>${esc(new Date(r.changed_at).toLocaleString('es-PE',{timeZone:'America/Lima'}))}</td>
 <td>${esc(r.usuario)}</td><td>${esc(r.destino)}</td><td>${r.anterior?'Permitido':'Restringido'}</td><td>${r.nuevo?'Permitido':'Restringido'}</td><td>${esc(r.actor)}</td><td>${esc(r.motivo||'—')}</td></tr>`).join('')||'<tr><td colspan="7">Sin cambios registrados aún.</td></tr>';
 historyLoaded=true;
};
function boot(){
 const users=$('usersModal');
 if(users){new MutationObserver(()=>{
    if(users.classList.contains('show')&&admin())loadAdmin();
 }).observe(users,{attributes:true,attributeFilter:['class']});}
 setTimeout(()=>{refresh(true);syncButtons();},800);
 // Reloads once per active user change, otherwise at a low fixed cadence.
 setInterval(()=>{
   const user=uid();if(user!==self.uid){clearSelf(user);refresh(true);syncButtons();}
   else if(user && !document.hidden && Date.now()-self.updated>60000)refresh(true);
   syncButtons();
 },5000);
 window.addEventListener('focus',()=>{if(Date.now()-self.updated>30000)refresh(true);});
 document.addEventListener('visibilitychange',()=>{if(!document.hidden&&Date.now()-self.updated>30000)refresh(true);});
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>

<script id="v841-egress-read-cache">
// V841: cache corta solo de consultas de lectura. No almacena datos entre sesiones.
// Cada operación de escritura se sigue confirmando directamente en Supabase.
(function(){
 'use strict';
 const TTL=12000, ROLE_TTL=60000, QUOTA_COOLDOWN=15*60*1000;
 const quotaError=err=>/exceed_egress_quota|\b402\b|service for this project is restricted/i.test(String(err?.message||err||''));
 const user=()=>{try{return String(session?.user?.id||'')}catch(_){return ''}};
 const client=()=>{try{return sb}catch(_){return null}};
 const empty=()=>({uid:'',data:null,at:0,promise:null});
 let list=empty(),role=empty(),blockedUntil=0;
 const stats={listRequests:0,listCacheHits:0,listCoalesced:0,roleRequests:0,roleCacheHits:0};
 function sync(){const u=user();if(list.uid!==u){list=empty();list.uid=u;}if(role.uid!==u){role=empty();role.uid=u;}return u;}
 function invalid(){list=empty();list.uid=user();}
 window.v841InvalidateDataReads=invalid;
 function rejected(message){return {data:null,error:{message}};}
 async function shared(kind, rpc, ttl, force){
  const u=sync(),c=client();
  if(!u||!c)return rejected('No existe una sesión activa de Supabase.');
  if(Date.now()<blockedUntil)return rejected('Supabase mantiene temporalmente restringidas las consultas por límite de transferencia.');
  const ref=kind==='list'?list:role;
  if(!force && ref.at && Date.now()-ref.at<ttl){stats[kind==='list'?'listCacheHits':'roleCacheHits']++;return {data:ref.data,error:null};}
  if(ref.promise){if(kind==='list')stats.listCoalesced++;return ref.promise;}
  stats[kind==='list'?'listRequests':'roleRequests']++;
  const pending=(async()=>{
   try{
    const result=await c.rpc(rpc);
    if(result?.error){if(quotaError(result.error))blockedUntil=Date.now()+QUOTA_COOLDOWN;return result;}
    // Never mix data if the user logged out or changed accounts mid-request.
    if(sync()!==u)return rejected('Cambió la sesión. Actualice la consulta.');
    const target=kind==='list'?list:role;
    target.data=result.data;target.at=Date.now();
    return result;
   }catch(e){if(quotaError(e))blockedUntil=Date.now()+QUOTA_COOLDOWN;return rejected(String(e?.message||e));}
   finally{const target=kind==='list'?list:role;if(target.uid===u)target.promise=null;}
  })();
  ref.promise=pending;
  return pending;
 }
 window.v841DataList=async(force=false)=>shared('list','v761_data_listar',TTL,!!force);
 window.v841RoleData=async(force=false)=>shared('role','v756_es_personal_data',ROLE_TTL,!!force);
 window.v841TrafficStats=()=>({...stats,quotaCooldownSeconds:Math.ceil(Math.max(0,blockedUntil-Date.now())/1000)});
})();
</script>
</body>
</html>

<script>try{console.info('V651 · edición de cargo + cargo oficial/prueba controlada');}catch(_){}</script>

<!-- V654 · Plantilla masiva oficial validada: Expediente | Extensión | R.D. | Último folio -->

<!-- V783 | Seguimiento de actividades de Notificaciones: sin tocar custodia ni estados operativos -->
<style id="v783-style">
#v783NavBtn{font-weight:700}
#v783Overlay{display:none;position:fixed;inset:0;z-index:2147482300;background:rgba(6,22,50,.62);align-items:center;justify-content:center;padding:18px;box-sizing:border-box}
#v783Overlay.v783-show{display:flex}
#v783Overlay .v783-dialog{width:min(1290px,100%);max-height:94vh;overflow:auto;background:#fff;border-radius:13px;border:1px solid #a5c3e1;box-shadow:0 18px 55px #07172d50;padding:20px 22px;box-sizing:border-box;font-family:Arial,sans-serif;color:#18345c}
#v783Overlay .v783-head{display:flex;justify-content:space-between;align-items:center;gap:12px;border-bottom:1px solid #d9e4f1;padding-bottom:12px}
#v783Overlay h2{font-size:20px;margin:0;color:#0a3566}
#v783Overlay h3{font-size:15px;margin:12px 0}
#v783Overlay .v783-text{font-size:12px;line-height:1.5;color:#52657a}
#v783Overlay .v783-tabs{display:flex;gap:7px;flex-wrap:wrap;margin:12px 0}
#v783Overlay button{border:1px solid #bdd3e8;background:#f4f9ff;border-radius:6px;padding:8px 12px;font-size:12px;cursor:pointer;color:#104576;font-weight:700}
#v783Overlay button.v783-primary,#v783Overlay .v783-tabs button.v783-on{background:#14588f;color:white;border-color:#14588f}
#v783Overlay button:disabled{opacity:.45;cursor:default}
#v783Overlay button:hover:not(:disabled){filter:brightness(.96)}
#v783Overlay .v783-kpis{display:grid;grid-template-columns:repeat(3,minmax(90px,1fr));gap:9px;margin:10px 0 14px}
#v783Overlay .v783-kpi{border:1px solid #d2e3f3;border-radius:8px;padding:9px 12px;background:#f4faff}
#v783Overlay .v783-kpi strong{display:block;font-size:23px;color:#0a416f}
#v783Overlay .v783-kpi span{font-size:11px;color:#536b88}
#v783Overlay .v783-form{border:1px solid #bdd8f2;background:#f8fbff;border-radius:10px;padding:14px;margin:10px 0 16px}
#v783Overlay .v783-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(195px,1fr));gap:10px;align-items:end}
#v783Overlay label{font-weight:700;font-size:11px;display:block;margin:4px 0;color:#284c79}
#v783Overlay input,#v783Overlay select,#v783Overlay textarea{box-sizing:border-box;width:100%;padding:9px 10px;border:1px solid #b8cfe6;border-radius:7px;font-size:13px;color:#16365f;background:#fff;min-width:0}
#v783Overlay textarea{min-height:54px;resize:vertical}
#v783Overlay .v783-filters{display:grid;grid-template-columns:minmax(170px,2fr) minmax(160px,1fr);gap:10px;margin:9px 0}
#v783Overlay .v783-scroll{max-height:330px;overflow:auto;border:1px solid #dae4ed;border-radius:8px}
#v783Overlay table{width:100%;border-collapse:collapse;font-size:12px}
#v783Overlay th{background:#e8f2fc;font-size:11px;color:#264d77;position:sticky;top:0;text-align:left}
#v783Overlay td,#v783Overlay th{padding:10px 8px;border-bottom:1px solid #e3edf6;vertical-align:top}
#v783Overlay .v783-tag{display:inline-block;padding:3px 7px;border-radius:50px;font-size:10px;background:#e1ecfa;color:#1b568a;white-space:normal}
#v783Overlay .v783-wait{background:#fff0cf;color:#855000}
#v783Overlay .v783-ok{background:#e0f5e9;color:#146444}
#v783Overlay .v783-msg{font-size:12px;margin:9px 0;min-height:18px;color:#214f7e}
#v783Overlay .v783-error{color:#ad1f20;font-weight:700}
#v783Overlay .v783-success{color:#08704c;font-weight:700}
#v783Overlay .v783-history{display:none;margin-top:10px;border-top:2px solid #dae4ef;padding-top:10px}
#v783Overlay .v783-history.v783-visible{display:block}
#v783Overlay .v783-event{border-left:3px solid #478bc5;padding:8px 11px;margin:7px 0;background:#f7faff;font-size:12px}
#v783Overlay .v783-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;align-items:center}
@media(max-width:650px){#v783Overlay{padding:4px}#v783Overlay .v783-dialog{max-height:99vh;padding:12px;border-radius:6px}#v783Overlay .v783-kpis{gap:4px}#v783Overlay .v783-scroll{max-height:260px}#v783Overlay .v783-filters{grid-template-columns:1fr}#v783Overlay table{min-width:740px}}
</style>
<div id="v783Overlay" role="dialog" aria-modal="true" aria-labelledby="v783Title" aria-hidden="true">
 <div class="v783-dialog">
  <div class="v783-head"><div><h2 id="v783Title">Registros históricos de Notificaciones</h2><div class="v783-text">IFI, Resoluciones Directorales y recepción de cargos originales · Registro independiente de la custodia</div></div><button id="v783Close" type="button">✕ Cerrar</button></div>
  <div class="v783-tabs"><button id="v783Mine" class="v783-on" type="button">Mis actividades</button><button id="v783Team" type="button" hidden>Seguimiento del equipo</button><button id="v783Reload" type="button">↻ Actualizar</button></div>
  <div class="v783-kpis"><div class="v783-kpi"><strong id="v783Total">0</strong><span>Actividades registradas</span></div><div class="v783-kpi"><strong id="v783Waiting">0</strong><span>En espera del cargo original</span></div><div class="v783-kpi"><strong id="v783Received">0</strong><span>Cargos originales recibidos</span></div></div>
  <div id="v783Form" class="v783-form">
    <h3 id="v783FormTitle">Registrar actividad del expediente</h3>
    <div class="v783-text">Solo puede registrar o actualizar actividades de expedientes físicos que se encuentren actualmente bajo su responsabilidad. Al registrar un cambio, se conserva la situación anterior en el historial.</div>
    <div class="v783-grid">
      <div><label for="v783ExpSearch">Buscar expediente propio</label><input id="v783ExpSearch" autocomplete="off" placeholder="Ej.: 0492-2026"/></div>
      <div><label for="v783Exp">Expediente bajo mi custodia</label><select id="v783Exp"><option value="">Seleccione un expediente</option></select></div>
      <div><label for="v783Doc">Documento</label><select id="v783Doc"><option value="IFI">Informe Final de Instrucción (IFI)</option><option value="RD">Resolución Directoral (RD)</option><option value="OTRO">Otro documento</option></select></div>
      <div><label for="v783Ref">Número / referencia del documento</label><input id="v783Ref" maxlength="140" placeholder="Ej.: RD 00123-2026"/></div>
      <div><label for="v783State">Situación de Notificaciones</label><select id="v783State"><option value="EN_REVISION">En revisión</option><option value="PENDIENTE_NOTIFICACION">Pendiente de notificación</option><option value="EN_PROCESO_NOTIFICACION">En proceso de notificación</option><option value="EN_ESPERA_CARGO_ORIGINAL">En espera del cargo original</option><option value="CARGO_ORIGINAL_RECIBIDO">Cargo original recibido</option><option value="ACTIVIDAD_FINALIZADA">Actividad finalizada</option></select></div>
      <div><label for="v783NotifDate">Fecha de notificación</label><input id="v783NotifDate" type="date"/></div>
      <div><label for="v783CargoDate">Fecha de recepción del cargo original</label><input id="v783CargoDate" type="date"/></div>
    </div>
    <div style="margin-top:9px"><label for="v783Obs">Observación (opcional)</label><textarea id="v783Obs" maxlength="1000" placeholder="Detalle de la notificación, revisión o del cargo original..."></textarea></div>
    <div class="v783-actions"><button id="v783Save" class="v783-primary" type="button">Guardar actividad</button><button id="v783CancelEdit" type="button">Nueva actividad / Limpiar</button><span class="v783-text" id="v783FormInfo"></span></div>
  </div>
  <h3 id="v783ListTitle">Situación vigente de los documentos</h3>
  <div class="v783-filters"><div><label for="v783Filter">Filtrar por expediente, responsable o referencia</label><input id="v783Filter" placeholder="Buscar dentro de los seguimientos..." autocomplete="off"/></div><div><label for="v783FilterStatus">Situación</label><select id="v783FilterStatus"><option value="">Todas</option><option value="EN_REVISION">En revisión</option><option value="PENDIENTE_NOTIFICACION">Pendiente de notificación</option><option value="EN_PROCESO_NOTIFICACION">En proceso de notificación</option><option value="EN_ESPERA_CARGO_ORIGINAL">En espera del cargo original</option><option value="CARGO_ORIGINAL_RECIBIDO">Cargo original recibido</option><option value="ACTIVIDAD_FINALIZADA">Actividad finalizada</option></select></div></div>
  <div class="v783-scroll"><table><thead><tr><th>Expediente</th><th>Responsable actual</th><th>Documento</th><th>Situación vigente</th><th>Última actualización</th><th>Acciones</th></tr></thead><tbody id="v783Rows"><tr><td colspan="6">Cargando información...</td></tr></tbody></table></div>
  <div class="v783-msg" id="v783Message" role="status"></div>
  <div id="v783History" class="v783-history"><h3>Historial de actividad: <span id="v783HistoryTitle"></span></h3><div id="v783HistoryRows"></div><button id="v783HistoryClose" type="button">Cerrar historial</button></div>
 </div>
</div>
<script id="v783-script">
(function(){
 'use strict';
 const $=id=>document.getElementById(id);
 const escText=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const statusLabels={EN_REVISION:'En revisión',PENDIENTE_NOTIFICACION:'Pendiente de notificación',EN_PROCESO_NOTIFICACION:'En proceso de notificación',EN_ESPERA_CARGO_ORIGINAL:'En espera del cargo original',CARGO_ORIGINAL_RECIBIDO:'Cargo original recibido',ACTIVIDAD_FINALIZADA:'Actividad finalizada'};
 const state={allowed:false,uid:'',teamAllowed:false,open:false,scope:'MIO',items:[],mine:[],activities:[],editing:null,loading:false,searchTimer:null,filterTimer:null,accessLoading:false,lastAccess:0,listSeq:0,searchSeq:0};
 const uid=()=>{try{return String(session?.user?.id||'')}catch(_){return ''}};
 const supa=()=>{try{return sb}catch(_){return null}};
 const profile=()=>{try{return currentProfile||{}}catch(_){return {}}};
 const msg=(str,error=false)=>{if($('v783Message')){$('v783Message').textContent=str||'';$('v783Message').className='v783-msg '+(error?'v783-error':str?'v783-success':'')}};
 const rpc=async(name,args={})=>{const client=supa();if(!client)throw Error('No se encuentra disponible la conexión con Supabase.');const {data,error}=await client.rpc(name,args);if(error)throw Error(error.message||'No se pudo consultar Supabase.');return data};
 const dateLocal=v=>{if(!v)return '—';const a=String(v).slice(0,19);if(/^\d{4}-\d{2}-\d{2}$/.test(a))return a.split('-').reverse().join('/');const d=new Date(v);return isNaN(d)?a:d.toLocaleString('es-PE',{timeZone:'America/Lima',day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit',hour12:false})};
 const statusBadge=s=>'<span class="v783-tag '+(s==='EN_ESPERA_CARGO_ORIGINAL'?'v783-wait':s==='CARGO_ORIGINAL_RECIBIDO'||s==='ACTIVIDAD_FINALIZADA'?'v783-ok':'')+'">'+escText(statusLabels[s]||s)+'</span>';
 function identityArea(){try{const c=profile();return String(c?.nombre_personal||'').trim()}catch(_){return ''}}
 async function checkAccess(force=false){
   if(state.accessLoading)return;
   const me=uid();if(!me){state.uid='';state.allowed=false;state.teamAllowed=false;syncAccess();return;}
   if(!force&&state.uid===me)return;
   state.uid=me;state.allowed=false;state.teamAllowed=false;state.accessLoading=true;state.lastAccess=Date.now();
   try{
     state.allowed=!!(await rpc('v783_es_personal_notificaciones',{p_user_id:me}));
     const p=profile();
     state.teamAllowed=state.allowed&&String(p?.rol||'').toUpperCase()==='COORDINADOR';
   }catch(error){console.warn('V783 permisos:',error?.message||error);}finally{state.accessLoading=false;}
   syncAccess();
 }
 function syncAccess(){
   const nav=document.querySelector('.produce-nav');
   if(nav){let btn=$('v783NavBtn');if(!btn){btn=document.createElement('button');btn.type='button';btn.id='v783NavBtn';btn.innerHTML='<span aria-hidden="true">↪</span><span>Reasignación a Data</span>';btn.onclick=()=>window.v810OpenNotiData();const anchor=nav.querySelector('button[data-destination="panel"],#staffMyExpedientesV319');if(anchor)anchor.after(btn);else nav.appendChild(btn);}
     btn.hidden=!state.allowed;btn.style.display=state.allowed?'':'none';}
   const main=$('tab-panel');if(main){let action=$('v783PanelAction');if(!action){action=document.createElement('button');action.id='v783PanelAction';action.type='button';action.className='btn secondary small';action.textContent='↪ Reasignación a Data';action.onclick=()=>window.v810OpenNotiData();main.insertBefore(action,main.firstChild);action.style.margin='7px 0 12px';}
    action.hidden=!state.allowed;action.style.display=state.allowed?'':'none';}
   if($('v783Team'))$('v783Team').hidden=!state.teamAllowed;
   if(!state.allowed&&state.open)close();
 }
 function checkSync(){
   if(document.hidden)return; // V840: no consumir egress en pestañas inactivas
   const id=uid();
   if(id!==state.uid)checkAccess(true);
   else if(id&&!state.allowed&&Date.now()-state.lastAccess>300000)checkAccess(true);
   else if(id&&state.allowed){state.teamAllowed=String(profile()?.rol||'').toUpperCase()==='COORDINADOR';syncAccess();}
 }
 function close(){state.open=false;$('v783Overlay')?.classList.remove('v783-show');$('v783Overlay')?.setAttribute('aria-hidden','true');}
 async function open(){await checkAccess(true);if(!state.allowed){alert('Este seguimiento es exclusivo del área de Notificaciones.');return;}
   state.open=true;state.scope='MIO';$('v783Overlay').classList.add('v783-show');$('v783Overlay').setAttribute('aria-hidden','false');
   $('v783Filter').value='';$('v783FilterStatus').value='';$('v783ExpSearch').value='';
   $('v783Mine').classList.add('v783-on');$('v783Team').classList.remove('v783-on');
   $('v783Form').style.display='';clearEdit();await Promise.all([loadMine(),loadActivities()]);
 }
 function formatExp(e){return String(e.expediente||'')+(e.extension?' · '+e.extension:'')+(e.rd?' · RD: '+e.rd:'')}
 async function loadMine(){
   if(!state.open)return;
   const ticket=++state.searchSeq;
   const q=$('v783ExpSearch').value.trim();const selected=$('v783Exp').value;
   try{
    const data=await rpc('v783_buscar_mis_expedientes',{p_busqueda:q,p_limite:150});
    if(!state.open||ticket!==state.searchSeq)return;
    state.mine=Array.isArray(data)?data:[];
    $('v783Exp').innerHTML='<option value="">Seleccione un expediente</option>'+state.mine.map(e=>'<option value="'+escText(e.id)+'">'+escText(formatExp(e))+'</option>').join('');
    if(state.mine.some(e=>String(e.id)===selected))$('v783Exp').value=selected;
    if(state.editing && state.mine.some(e=>e.id===state.editing.expediente_id))$('v783Exp').value=state.editing.expediente_id;
   }catch(error){msg('No se pudieron buscar los expedientes propios: '+error.message,true)}
 }
 async function loadActivities(){if(!state.open)return;
   const ticket=++state.listSeq;
   const scope=state.scope;const text=$('v783Filter').value.trim(),situacion=$('v783FilterStatus').value;
   $('v783Rows').innerHTML='<tr><td colspan="6">Consultando situaciones vigentes...</td></tr>';
   try{
     const data=await rpc('v783_listar_actividades',{p_alcance:scope,p_busqueda:text,p_estado:situacion});
     if(!state.open||state.scope!==scope||ticket!==state.listSeq)return;
     state.activities=Array.isArray(data)?data:[]; // V810: mostrar actividades históricas aunque ya no tenga su custodia; la edición conserva el control puede_editar.
     $('v783ListTitle').textContent=scope==='EQUIPO'?'Actividades registradas del equipo (histórico)':'Actividades registradas por mí (incluye historial)';
     drawActivities();msg('');
   }catch(error){$('v783Rows').innerHTML='<tr><td colspan="6" class="v783-error">'+escText(error.message)+'</td></tr>';msg(error.message,true)}
 }
 function drawActivities(){
  const rows=state.activities||[];
  $('v783Total').textContent=String(rows.length);
  $('v783Waiting').textContent=String(rows.filter(x=>x.estado_actividad==='EN_ESPERA_CARGO_ORIGINAL').length);
  $('v783Received').textContent=String(rows.filter(x=>x.estado_actividad==='CARGO_ORIGINAL_RECIBIDO').length);
  $('v783Rows').innerHTML=rows.length?rows.map((r,i)=>'<tr><td><b>'+escText(r.expediente)+'</b><div class="v783-text">'+escText(r.extension||'')+'</div></td><td>'+escText(r.responsable_actual)+'</td><td>'+escText(r.tipo_documento)+'<div class="v783-text">'+escText(r.referencia_documento||'Sin número')+'</div></td><td>'+statusBadge(r.estado_actividad)+'</td><td>'+escText(dateLocal(r.updated_at))+'</td><td>'+(r.puede_editar&&r.estado_actividad!=='ACTIVIDAD_FINALIZADA'?'<button type="button" data-v783-edit="'+i+'">Actualizar</button>':'')+'<button type="button" data-v783-history="'+i+'">Historial</button></td></tr>').join(''):'<tr><td colspan="6">No existen actividades registradas con estos filtros.</td></tr>';
 }
 function clearEdit(){
   state.editing=null;
   $('v783FormTitle').textContent='Registrar actividad del expediente';
   for(const id of ['v783Exp','v783Doc']){$(id).disabled=false;}
   $('v783Ref').readOnly=false;
   $('v783Exp').value='';$('v783Doc').value='IFI';$('v783State').value='EN_REVISION';
   for(const id of ['v783Ref','v783NotifDate','v783CargoDate','v783Obs'])$(id).value='';
   $('v783Save').disabled=false;
   $('v783Save').textContent='Guardar actividad';
   $('v783FormInfo').textContent='';
 }
 function edit(index){const rec=state.activities[index];if(!rec||!rec.puede_editar)return;
   state.editing=rec;
   $('v783Form').style.display='';
   $('v783FormTitle').textContent='Actualizar actividad del expediente '+rec.expediente;
   $('v783Exp').innerHTML='<option value="'+escText(rec.expediente_id)+'">'+escText(rec.expediente+' '+(rec.extension||''))+'</option>';
   $('v783Exp').value=rec.expediente_id;$('v783Exp').disabled=true;
   $('v783Doc').value=rec.tipo_documento;$('v783Doc').disabled=true;
   $('v783Ref').value=rec.referencia_documento||'';$('v783Ref').readOnly=true;
   $('v783State').value=rec.estado_actividad;$('v783NotifDate').value=rec.fecha_notificacion||'';
   $('v783CargoDate').value=rec.fecha_cargo_original||'';$('v783Obs').value=rec.ultima_observacion||'';
   $('v783FormInfo').textContent='La actividad anterior se conservará en el historial.';
   $('v783Form').scrollIntoView({behavior:'smooth',block:'start'});
 }
 async function save(){
  if(state.loading)return;
  const editing=state.editing;
  const id=editing?.expediente_id||$('v783Exp').value;
  const tipo=$('v783Doc').value,ref=$('v783Ref').value.trim(),situacion=$('v783State').value;
  const notif=$('v783NotifDate').value||null,cargo=$('v783CargoDate').value||null;
  if(!id){msg('Seleccione primero el expediente bajo su custodia.',true);return;}
  if(tipo==='RD'&&!ref){msg('Ingrese el número de la Resolución Directoral.',true);return;}
  if(['EN_ESPERA_CARGO_ORIGINAL','CARGO_ORIGINAL_RECIBIDO','ACTIVIDAD_FINALIZADA'].includes(situacion)&&!notif){msg('Ingrese la fecha en que se efectuó la notificación.',true);return;}
  if(['CARGO_ORIGINAL_RECIBIDO','ACTIVIDAD_FINALIZADA'].includes(situacion)&&!cargo){msg('Ingrese la fecha en que se recibió el cargo original.',true);return;}
  state.loading=true;$('v783Save').disabled=true;msg('Guardando situación e historial...');
  try{
   await rpc('v783_guardar_actividad',{
     p_expediente_id:id,p_tipo:tipo,p_referencia:ref,p_estado:situacion,
     p_fecha_notificacion:notif,p_fecha_cargo_original:cargo,
     p_observacion:$('v783Obs').value.trim()||null,
     p_actividad_id:editing?.id||null,p_updated_at_esperado:editing?.updated_at||null
   });
   clearEdit();await Promise.all([loadMine(),loadActivities()]);
   msg('Actividad registrada correctamente. La custodia y las reasignaciones no se han modificado.');
  }catch(error){msg('No se pudo guardar: '+error.message,true)}finally{state.loading=false;$('v783Save').disabled=false;}
 }
 async function history(index){const rec=state.activities[index];if(!rec)return;
   $('v783History').classList.add('v783-visible');$('v783HistoryTitle').textContent=rec.expediente+' · '+rec.tipo_documento+' '+(rec.referencia_documento||'');
   $('v783HistoryRows').textContent='Consultando historial...';
   try{const data=await rpc('v783_historial_actividad',{p_actividad_id:rec.id});
     $('v783HistoryRows').innerHTML=Array.isArray(data)&&data.length?data.map(x=>'<div class="v783-event"><strong>'+escText(dateLocal(x.registrado_at))+' · '+escText(x.realizado_por)+'</strong><div>'+statusBadge(x.estado_nuevo)+(x.estado_anterior?' <span class="v783-text">Anterior: '+escText(statusLabels[x.estado_anterior]||x.estado_anterior)+'</span>':'')+'</div><div class="v783-text">Responsable al registrar: '+escText(x.responsable_al_registrar)+' · Notificación: '+escText(dateLocal(x.fecha_notificacion))+' · Cargo original: '+escText(dateLocal(x.fecha_cargo_original))+'</div>'+(x.observacion?'<p>'+escText(x.observacion)+'</p>':'')+'</div>').join(''):'<div class="v783-text">Todavía no hay eventos.</div>';
   }catch(error){$('v783HistoryRows').textContent='No se pudo recuperar el historial: '+error.message;}
   $('v783History').scrollIntoView({behavior:'smooth',block:'start'});
 }
 function switchScope(scope){if(scope==='EQUIPO'&&!state.teamAllowed)return;
  state.scope=scope;
  $('v783Mine').classList.toggle('v783-on',scope==='MIO');$('v783Team').classList.toggle('v783-on',scope==='EQUIPO');
  $('v783Form').style.display=scope==='EQUIPO'?'none':'';
  loadActivities();
 }
 function bind(){
  $('v783Close').onclick=close;$('v783HistoryClose').onclick=()=>{$('v783History').classList.remove('v783-visible')};
  $('v783Overlay').addEventListener('click',e=>{if(e.target===$('v783Overlay'))close()});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&state.open)close()});
  $('v783Mine').onclick=()=>switchScope('MIO');$('v783Team').onclick=()=>switchScope('EQUIPO');
  $('v783Reload').onclick=()=>{loadMine();loadActivities()};
  $('v783Save').onclick=save;$('v783CancelEdit').onclick=()=>{clearEdit();loadMine()};
  $('v783Filter').oninput=()=>{clearTimeout(state.filterTimer);state.filterTimer=setTimeout(loadActivities,350)};
  $('v783FilterStatus').onchange=loadActivities;
  $('v783ExpSearch').oninput=()=>{clearTimeout(state.searchTimer);state.searchTimer=setTimeout(loadMine,350)};
  $('v783Exp').onchange=()=>{const e=state.mine.find(x=>x.id===$('v783Exp').value);if(e&&$('v783Doc').value==='RD'&&!$('v783Ref').value.trim())$('v783Ref').value=e.rd||''};
  $('v783Doc').onchange=()=>{const e=state.mine.find(x=>x.id===$('v783Exp').value);$('v783Ref').placeholder=$('v783Doc').value==='RD'?'Número de RD (obligatorio)':'Identificador del documento (si existe)';if(e&&$('v783Doc').value==='RD'&&!$('v783Ref').value.trim())$('v783Ref').value=e.rd||''};
  $('v783Rows').addEventListener('click',e=>{const b=e.target?.closest?.('button');if(!b)return;
   if(b.dataset.v783Edit!==undefined)edit(Number(b.dataset.v783Edit));
   if(b.dataset.v783History!==undefined)history(Number(b.dataset.v783History))});
  setInterval(checkSync,15000);checkSync(); // V841: comprobación pasiva local menos frecuente
 }
 window.v783Open=open;
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind,{once:true});else bind();
})();
</script>


<!-- V787: Regularización no destructiva de expedientes físicamente acumulados -->
<style id="v787-regularizacion-style">
#acumuladosModal .modal-box{max-width:1040px;max-height:93vh;overflow-y:auto}
#v787Section{border:1px solid #bbd5f1;background:#f5f9fe;border-radius:12px;padding:14px;margin:18px 0 0;font-size:12px;color:#193c65}
#v787Section[hidden]{display:none!important}
.v787-master-tag{display:block;margin-top:4px;border-radius:5px;background:#f0eafc;border:1px solid #d5c4f4;color:#683c93;font-size:10px;font-weight:750;padding:3px 6px;max-width:245px;line-height:1.3}
#v787Section .v787-heading{font-size:15px;font-weight:850;color:#073c79}
#v787Section p{line-height:1.5}
#v787Section .v787-row{display:flex;align-items:flex-end;gap:10px;margin:11px 0}
#v787Section .v787-row label{flex:1;min-width:0;font-weight:750}
#v787Section .v787-row input,#v787Section .v787-row select{display:block;width:100%;margin-top:5px;min-height:38px;box-sizing:border-box;border:1px solid #b8cfe9;border-radius:7px;padding:8px;background:#fff;color:#173d65}
#v787Preview{padding:10px;background:#fff;border:1px solid #d0e0ef;border-radius:8px;margin:12px 0;font-size:12px}
#v787Preview p{margin:8px 0}
#v787Preview details{margin:10px 0}
#v787Preview summary{cursor:pointer;font-weight:800}
#v787Preview .v787-scroll{overflow-x:auto;max-height:250px;overflow-y:auto}
#v787Preview table{width:100%;border-collapse:collapse;min-width:640px}
#v787Preview td,#v787Preview th{border:1px solid #d7e4f3;padding:6px;text-align:left;font-size:11px}
#v787Preview th{background:#e3effb}
.v787-tag{display:inline-block;border-radius:30px;padding:3px 7px;font-size:10px;font-weight:900;margin-left:10px}
.v787-tag.ok{background:#d8f4e3;color:#196337}.v787-tag.bad{background:#ffe6e6;color:#9b2b2b}
#v787Preview .v787-issues{color:#9c2c24;background:#fff0ee;border-radius:6px;padding:9px}
#v787Preview .v787-ok{color:#176339}
#v787Section .v787-check{display:flex;gap:8px;align-items:flex-start;font-weight:750;line-height:1.5;margin:9px 0}
#v787Section .v787-check input{width:17px;height:17px;flex-shrink:0;margin:0}
#v787Section .v787-actions{display:flex;gap:8px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-top:10px}
#v787Status[data-kind="error"]{color:#a02f28}
#v787Status[data-kind="ok"]{color:#196640}
#v787Section .v787-warning{font-size:11px;color:#765625;margin:10px 0 0}
@media(max-width:650px){#v787Section .v787-row{display:block}#v787Section .v787-row button{margin-top:8px}#v787Section .v787-actions{align-items:stretch}}
</style>
<script id="v787-regularizacion">
/* V787 · Regularización administrativa no destructiva de expedientes físicos acumulados.
   La custodia y las solicitudes previas no se modifican. */
(()=>{
 'use strict';
 const $=id=>document.getElementById(id);
 const h=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 let candidates=[],candidate=null,preview=null,seq=0,busy=false;
 function admin(){return typeof isAdmin==='function' && isAdmin();}
 function principal(){return (typeof accumulatedContext!=='undefined'&&accumulatedContext)?accumulatedContext:null;}
 function setStatus(v,kind=''){const e=$('v787Status');if(e){e.textContent=v||'';e.dataset.kind=kind;}}
 function enabled(v){const b=$('v787Do');if(b)b.disabled=!v||busy;}
 function resetCandidate(){candidate=null;preview=null;enabled(false);$('v787Confirm').checked=false;const box=$('v787Preview');if(box)box.innerHTML='Seleccione un expediente físico y pulse <b>Evaluar regularización</b>.';}
 function visible(){const section=$('v787Section');if(!section)return;section.hidden=!admin(); if(!admin())return;resetCandidate();$('v787Find').value='';$('v787Select').innerHTML='<option value="">— BUSQUE UN EXPEDIENTE —</option>';setStatus('');}
 async function search(){if(!admin()||!principal()||busy)return;let raw=$('v787Find').value.trim();resetCandidate();if(raw.length<3){setStatus('Ingrese al menos tres caracteres del número de expediente.','error');return;}
  const order=++seq;setStatus('Buscando registros independientes...');try{
   const {data,error}=await sb.rpc('v787_buscar_fisicos',{p_numero:raw,p_limite:40});if(error)throw error;if(order!==seq)return;
   candidates=Array.isArray(data)?data:[];
   const select=$('v787Select');select.innerHTML='<option value="">— SELECCIONE EXPEDIENTE Y EXTENSIÓN —</option>'+
     candidates.map(x=>`<option value="${h(x.id)}">${h(x.expediente)} · ${h(x.extension||'SIN EXTENSIÓN')} · ${h(x.estado)} · ${h(x.responsable)}${x.vinculado_a?' · YA VINCULADO':''}</option>`).join('');
   setStatus(candidates.length?`${candidates.length} registro(s) encontrado(s). Verifique número y extensión.`:'No se encontraron registros independientes. Puede usar el registro normal de acumulados.');
  }catch(e){setStatus('No se pudo buscar: '+String(e?.message||e),'error');}
 }
 async function evaluate(){if(!admin()||!principal()||busy)return;resetCandidate();const id=$('v787Select').value;
  candidate=candidates.find(x=>x.id===id);if(!candidate){setStatus('Seleccione primero un expediente de la lista.','error');return;}
  if(candidate.id===principal().principalId){setStatus('El principal no puede acumularse a sí mismo.','error');return;}
  const version=++seq;setStatus('Verificando préstamos, devoluciones, derivaciones e historial...');
  try{
   const [ev,hist]=await Promise.all([
    sb.rpc('v787_evaluar_regularizacion',{p_principal_id:principal().principalId,p_acumulado_fisico_id:candidate.id}),
    sb.rpc('v787_solicitudes_del_acumulado',{p_expediente_fisico_id:candidate.id})
   ]);
   if(ev.error)throw ev.error;if(hist.error)throw hist.error;if(version!==seq)return;
   preview=ev.data;
   const issues=Array.isArray(preview?.motivos_bloqueo)?preview.motivos_bloqueo:[];
   const rows=Array.isArray(hist.data)?hist.data:[];
   const names={true:'Sí',false:'No'};
   $('v787Preview').innerHTML=`<div class="v787-result-head"><b>${h(preview.acumulado)} · ${h(preview.acumulado_extension||'SIN EXTENSIÓN')}</b> <span class="v787-tag ${preview.apto?'ok':'bad'}">${preview.apto?'APTO PARA REGULARIZAR':'REGULARIZACIÓN BLOQUEADA'}</span></div>
    <p>Principal: <b>${h(preview.principal)} · ${h(preview.principal_extension||'SIN EXTENSIÓN')}</b><br>Custodia del acumulado: ${h(preview.responsable)} · ${h(preview.estado)}</p>
    <p>Solicitudes históricas: <b>${Number(preview.solicitudes_historicas||0)}</b> · Cierres administrativos: <b>${Number(preview.solicitudes_cerradas_admin||0)}</b> · Movimientos históricos: <b>${Number(preview.movimientos_historicos||0)}</b></p>
    ${issues.length?'<div class="v787-issues">'+issues.map(x=>'<div>• '+h(x)+'</div>').join('')+'</div>':'<p class="v787-ok">Sin operaciones activas incompatibles detectadas. Revise los antecedentes antes de confirmar.</p>'}
    <details><summary>Consultar ${rows.length} solicitud(es) histórica(s) del acumulado</summary>
      <div class="v787-scroll"><table><thead><tr><th>Solicitud</th><th>Solicitante</th><th>Estado</th><th>Cierre administrativo</th><th>Movimientos</th><th>Cargo</th></tr></thead><tbody>
      ${rows.map(r=>`<tr><td>${h(r.numero)}</td><td>${h(r.solicitante)}</td><td>${h(r.estado)}</td><td>${r.cerrado_admin?'Sí':'No'}</td><td>${Number(r.movimientos||0)}</td><td>${h(r.cargo_numero||'—')}</td></tr>`).join('')}
      </tbody></table></div></details>
    <p class="v787-fine">Esta operación no elimina expedientes, solicitudes, cargos ni movimientos. Únicamente crea un vínculo documentado.</p>`;
   setStatus(preview.apto?'Evaluación favorable. Para continuar, registre el motivo y confirme la revisión.':'La regularización no está permitida. Resuelva antes los motivos indicados.',preview.apto?'ok':'error');
   allow();
  }catch(e){preview=null;enabled(false);setStatus('Error al evaluar: '+String(e?.message||e),'error');}
 }
 function allow(){const motive=$('v787Reason')?.value.trim()||'';enabled(!!(admin()&&preview?.apto&&candidate?.id===preview.acumulado_fisico_id&&motive.length>=15&&$('v787Confirm')?.checked));}
 async function confirm(){if(!admin()||busy||!preview?.apto||!principal()||!candidate)return;
  const motivo=$('v787Reason').value.trim();if(motivo.length<15||!$('v787Confirm').checked){setStatus('Registre un motivo de al menos 15 caracteres y confirme la revisión.','error');return;}
  const name=`${candidate.expediente} · ${candidate.extension||'SIN EXTENSIÓN'}`;
  const parent=`${principal().principalLabel||preview.principal}`;
  if(!window.confirm(`¿Confirmar que ${name} está físicamente acumulado a ${parent}?\nSe conservarán todas las solicitudes y movimientos anteriores.\nNo será posible solicitarlo nuevamente por separado mientras dure el vínculo.`))return;
  busy=true;enabled(false);setStatus('Registrando vínculo y constancia de auditoría...');
  try{
    const {data,error}=await sb.rpc('v787_regularizar_acumulado',{p_principal_id:principal().principalId,p_acumulado_fisico_id:candidate.id,p_solicitud_id:principal().solicitudId||null,p_motivo:motivo});
    if(error)throw error;if(!data?.ok)throw Error('No se confirmó el registro del vínculo.');
    const parentId=principal().principalId;
    if(typeof accumulatedCache!=='undefined')accumulatedCache.delete(parentId);
    if(typeof refreshAccumulatedModal==='function')await refreshAccumulatedModal(true);
    if(typeof requestDetailRows!=='undefined' && typeof enrichAccumulatedRowsInPlace==='function' && typeof currentRequestId!=='undefined' && currentRequestId===principal().solicitudId){
      try{await enrichAccumulatedRowsInPlace(requestDetailRows,true);renderRequestDetailItems();}catch(e){console.warn('V787 refresco del detalle:',e);}
    }
    setStatus('Regularización registrada. El acumulado aparece junto al principal; sus movimientos anteriores permanecen en el historial.','ok');
    $('v787Reason').value='';$('v787Confirm').checked=false;resetCandidate();
    $('v787Select').value='';
    if(typeof showToast==='function')showToast('Expediente físico regularizado como acumulado');
    if(typeof loadAll==='function')loadAll().catch(()=>{});
  }catch(e){setStatus('No se realizó la regularización: '+String(e?.message||e),'error');}
  finally{busy=false;allow();}
 }
 // Bloqueo preventivo en la interfaz de nuevas solicitudes. La validación
 // definitiva y transaccional reside en el trigger de Supabase.
 async function checkDraft(ids){
   const unique=[...new Set(ids.filter(id=>/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(id||''))))];
   for(let i=0;i<unique.length;i+=100){
    const {data,error}=await sb.rpc('v787_relaciones_fisicas',{p_ids:unique.slice(i,i+100)});
    if(error)throw error;
    if(Array.isArray(data)&&data.length)return data;
   }
   return [];
 }
 window.v787CheckDraft=checkDraft;
 window.v787ShowRegularization=visible;
 let masterDelay=0,masterActive=false;
 async function hydrateMasterLinks(){
   if(masterActive)return;
   const nodes=[...document.querySelectorAll('[data-v787-master]')].filter(x=>!x.dataset.v787Checked);
   if(!nodes.length||!window.sb?.rpc)return;
   const ids=[...new Set(nodes.map(x=>x.dataset.v787Master).filter(x=>/^[0-9a-f]{8}-[0-9a-f-]{27,}$/i.test(x)))];
   if(!ids.length)return;
   masterActive=true;
   try{
     const links=[];
     for(let i=0;i<ids.length;i+=100){
       const {data,error}=await window.sb.rpc('v787_relaciones_fisicas',{p_ids:ids.slice(i,i+100)});
       if(error)throw error;
       if(Array.isArray(data))links.push(...data);
     }
     const byId=new Map(links.map(x=>[x.expediente_id,x]));
     for(const node of nodes){
       if(!node.isConnected)continue;
       const match=byId.get(node.dataset.v787Master);
       if(match){
         node.textContent='Acumulado al principal '+match.principal_numero+(match.principal_extension?' · '+match.principal_extension:'')+' · No solicitar por separado';
         node.classList.add('v787-master-tag');
       }
       node.dataset.v787Checked='1';
     }
   }catch(e){console.warn('V787 indicador de acumulados:',e?.message||e);}
   finally{masterActive=false;}
 }
 function scheduleMaster(){clearTimeout(masterDelay);masterDelay=setTimeout(hydrateMasterLinks,230);}
 function bind(){
  const section=$('v787Section');if(!section)return;
  $('v787SearchBtn').addEventListener('click',search);
  $('v787Find').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();search();}});
  $('v787Select').addEventListener('change',resetCandidate);
  $('v787EvalBtn').addEventListener('click',evaluate);
  $('v787Reason').addEventListener('input',allow);
  $('v787Confirm').addEventListener('change',allow);
  $('v787Do').addEventListener('click',confirm);
  const all=document.getElementById('allTable');
  if(all){new MutationObserver(scheduleMaster).observe(all,{childList:true,subtree:true});scheduleMaster();}
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind,{once:true});else bind();
})();

</script>


<style id="v803-auditoria-optimizacion-css">
#v803AuditActions[hidden],#v803AuditPanel[hidden]{display:none!important}
#v803AuditActions{margin:9px 0;padding:9px 12px;background:#f7fafc;border:1px solid #c7d8e8;border-radius:9px;display:flex;align-items:center;flex-wrap:wrap;gap:10px}
#v803AuditPanel{margin:10px 0 14px;padding:12px;border:1px solid #adc8e3;background:#f9fbff;border-radius:10px;color:#1a3659;font-size:12px}
.v803-audit-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap}
.v803-audit-controls{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin:12px 0}
.v803-audit-controls select{height:34px;min-width:240px;max-width:100%;font-size:11px}
.v803-audit-summary{padding:8px 10px;background:#edf5fb;border-radius:6px;line-height:1.65;white-space:normal;margin:8px 0}
.v803-audit-table-wrap{max-height:450px;overflow:auto;border:1px solid #dae3ed;border-radius:7px}
.v803-audit-table-wrap table{width:100%;border-collapse:collapse;min-width:1090px;font-size:10px}
.v803-audit-table-wrap th{position:sticky;top:0;background:#244d77;color:#fff;z-index:1;padding:8px;text-align:left;white-space:nowrap}
.v803-audit-table-wrap td{padding:8px;border-bottom:1px solid #dce5ee;vertical-align:top;line-height:1.5}
.v803-audit-table-wrap tr:nth-child(even){background:#f0f6fb}
.v803-audit-table-wrap .v803-audit-prio{font-weight:bold;color:#9d4b18}
#v803AuditPerformance{margin-top:10px}
@media(max-width:700px){.v803-audit-controls{align-items:stretch;flex-direction:column}.v803-audit-controls select{width:100%}}
</style>

<script id="v803-auditoria-optimizacion-script">
/* V803 · Corrección preventiva: observar estados, no sobreescribir custodia.
   Optimización de navegación: single-flight de recargas idénticas de tarjetas.
   Nunca se utiliza una respuesta en caché para reemplazar una actualización real. */
(function(){
'use strict';
const Q=id=>document.getElementById(id);
const metrics=window.v803Metrics={iniciadas:0,coalescidas:0,por_tarjeta:Object.create(null)};
const safe=x=>String(x??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
let open=false,loading=false,seq=0,again=false;
function isAdministrator(){try{return typeof isAdmin==='function'&&!!isAdmin()}catch(_){return false}}
function sync(){
 const eligible=isAdministrator(); const bar=Q('v803AuditActions'),panel=Q('v803AuditPanel');
 if(bar)bar.hidden=!eligible;
 if(panel && !eligible){panel.hidden=true;open=false}
}
function summaryMetrics(){
 const list=Object.keys(metrics.por_tarjeta).map(k=>{
   const x=metrics.por_tarjeta[k];
   return k+': '+x.ultima_ms+' ms (última carga; '+x.completadas+' mediciones)';
 });
 const el=Q('v803AuditPerformance');if(el)el.textContent='Mediciones de este navegador: '+(list.join(' · ')||'sin cargas medidas')+'. Consultas repetidas simultáneas evitadas: '+metrics.coalescidas+'.';
}
function wrapSingleFlight(name){
 const old=window[name];if(typeof old!=='function'||old.__v803Flight)return;
 const inFlight=new Map();
 const wrapped=function(...args){
   const k=JSON.stringify(args);
   if(inFlight.has(k)){
     metrics.coalescidas++;
     summaryMetrics();
     return inFlight.get(k);
   }
   const t=(typeof performance!=='undefined'&&performance.now)?performance.now():Date.now();
   metrics.iniciadas++;
   const m=metrics.por_tarjeta[name]||(metrics.por_tarjeta[name]={completadas:0,ultima_ms:0});
   let result;
   try{result=old.apply(this,args)}catch(error){throw error}
   if(!result||typeof result.then!=='function'){
     m.completadas++;m.ultima_ms=Math.round(((performance?.now?.()||Date.now())-t));
     summaryMetrics();return result;
   }
   const tracked=Promise.resolve(result).finally(()=>{
     inFlight.delete(k);
     m.completadas++;m.ultima_ms=Math.round((performance?.now?.()||Date.now())-t);
     summaryMetrics();
   });
   inFlight.set(k,tracked);
   return tracked;
 };
 wrapped.__v803Flight=true;window[name]=wrapped;
}
function render(data){
 const area=Q('v803AuditTable');const summary=Q('v803AuditSummary');if(!area||!summary)return;
 const rs=Array.isArray(data?.resumen)?data.resumen:[];
 const chips=rs.map(r=>'<span style="margin-right:13px"><b>'+safe(r.etiqueta)+':</b> '+safe(r.cantidad)+'</span>').join('');
 summary.innerHTML='<b>Consulta de solo lectura · '+safe(data?.fecha_corte||'')+'</b> · '+safe(data?.total_expedientes||0)+' expedientes físicos · '+safe(data?.total_incidencias||0)+' coincidencias de revisión en el filtro.<div style="margin-top:6px">'+chips+'</div>';
 const records=Array.isArray(data?.casos)?data.casos:[];
 area.innerHTML=!records.length?'<div class="empty">Sin casos para el filtro elegido.</div>':
  '<table><thead><tr><th>Expediente</th><th>Extensión</th><th>Hallazgo</th><th>Estado maestro</th><th>Estado operativo</th><th>Custodia</th><th>Responsable actual</th><th>Corrección propuesta</th></tr></thead><tbody>'+records.map(r=>
   '<tr><td><b>'+safe(r.expediente)+'</b></td><td>'+safe(r.extension)+'</td><td class="v803-audit-prio">'+safe(r.etiqueta)+'</td><td>'+safe(r.estado_maestro)+'</td><td>'+safe(r.estado_operativo)+'</td><td>'+safe(r.estado_custodia)+'</td><td>'+safe(r.responsable_actual)+'</td><td>'+safe(r.propuesta)+'</td></tr>'
  ).join('')+'</tbody></table>';
 if(Number(data?.total_incidencias||0)>records.length){area.insertAdjacentHTML('beforeend','<p class="note" style="padding:8px">Se muestran los primeros '+records.length+' casos. Seleccione una categoría para ver su relación específica; informe integral disponible por separado.</p>')}
 summaryMetrics();
}
async function refresh(){
 if(!open||!isAdministrator())return;
 if(loading){again=true;return}
 const out=Q('v803AuditSummary'),b=Q('v803AuditRefreshBtn');
 const client=(typeof sb!=='undefined')?sb:null;
 if(!client){if(out)out.textContent='Inicie sesión para consultar la auditoría.';return}
 const current=++seq;loading=true;if(b)b.disabled=true;if(out)out.textContent='Consultando estados actuales sin modificar datos...';
 try{
  const {data,error}=await client.rpc('v803_diagnostico_estados',{
   p_categoria:Q('v803AuditCategory')?.value||'TODOS',p_limite:250
  });
  if(error)throw error;
  if(current!==seq||!open)return;
  if(!data?.ok)throw new Error('El diagnóstico no pudo completarse.');
  render(data);
 }catch(error){if(out)out.textContent='No se pudo consultar la auditoría: '+(error?.message||String(error));}
 finally{loading=false;if(b)b.disabled=false;if(again&&open){again=false;setTimeout(refresh,0)}}
}
function setOpen(value){
 if(!isAdministrator())return;
 open=!!value;const panel=Q('v803AuditPanel');if(panel)panel.hidden=!open;
 if(open)refresh();
}
function bind(){
 const toggle=Q('v803AuditToggleBtn');if(!toggle||toggle.dataset.v803Bound==='1')return;
 toggle.dataset.v803Bound='1';
 toggle.addEventListener('click',()=>setOpen(!open));
 Q('v803AuditCloseBtn')?.addEventListener('click',()=>setOpen(false));
 Q('v803AuditRefreshBtn')?.addEventListener('click',refresh);
 Q('v803AuditCategory')?.addEventListener('change',()=>{if(open)refresh()});
 ['loadPanel','loadStates','loadRequests'].forEach(wrapSingleFlight);
 sync();summaryMetrics();
 // Actualizar visibilidad cuando cambia el perfil activo, sin sondeos permanentes.
 document.addEventListener('click',()=>{if(!isAdministrator()&&open)setOpen(false);sync()},true);
 window.addEventListener('focus',sync);
 for(const ms of [500,1700,4000,8000,16000])setTimeout(sync,ms);
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind,{once:true});else bind();
})();
</script>


<!-- V805 — Vista previa vinculada de cédulas adicionales al expediente y a su asignación. Conserva el envío original V804. -->
