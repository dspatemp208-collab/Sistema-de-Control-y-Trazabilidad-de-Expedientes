  body.produce-staff .app .main,
  .app.role-admin .main,
  .app.role-archive .main,
  .app.role-user .main,
  .app.limited-user .main{
    background:var(--v514-main)!important;
  }
}
</style>


<script id="v517-digital-nonblocking-script">
(function(){
  'use strict';
  function v517Norm(v){
    try{return typeof norm==='function'?norm(v||''):String(v||'').trim().toUpperCase();}
    catch(_){return String(v||'').trim().toUpperCase();}
  }
  function v517RequestedMode(){
    const direct=document.getElementById('rqModalidad')?.value;
    const draft=window.__newRequestHeaderDraft?.modalidad;
    return v517Norm(direct||draft||'PRÉSTAMO');
  }
  function v517ActiveMode(req,row){
    const value=req?.modalidad ?? req?.modalidad_solicitud ?? req?.tipo_modalidad ?? req?.tipo_atencion ?? req?.modalidad_atencion ?? '';
    const direct=v517Norm(value);
    if(direct)return direct;
    const t=v517Norm(req?.detalle ?? req?.descripcion ?? req?.motivo ?? row?.motivo ?? '');
    if(t.includes('COPIA DIGITAL'))return 'COPIA DIGITAL';
    if(t.includes('LECTURA EN SALA'))return 'LECTURA EN SALA';
    if(t.includes('PRÉSTAMO')||t.includes('PRESTAMO'))return 'PRÉSTAMO';
    return '';
  }
  function v517OutsideArchive(row){
    const state=v517Norm(row?.estado_operativo || row?.ultimo_estado || row?.estado || (typeof operationalStatus==='function'?operationalStatus(row):'') || '');
    return ['EN PRÉSTAMO','EN PRESTAMO','REASIGNADO','REASIGNADOS','DEVOLUCIÓN SOLICITADA','DEVOLUCION SOLICITADA','DERIVADO AL CONAS','DERIVADO A CONAS','DERIVADO A LA DVC','DERIVADO A DVC','DERIVADO A INSTRUCCIÓN','DERIVADO A INSTRUCCION'].includes(state);
  }
  function v517ApplyDigitalCoexistenceSync(rows){
    const requested=v517RequestedMode();
    return (Array.isArray(rows)?rows:[]).map(raw=>{
      const row={...raw};
      const active=Array.isArray(row._activeRequests)?row._activeRequests:[];
      const digital=[],physical=[];
      active.forEach(req=>{(v517ActiveMode(req,row)==='COPIA DIGITAL'?digital:physical).push(req);});
      const reason=v517Norm(row.motivo||'');
      if(!digital.length && active.length && reason.includes('COPIA DIGITAL')){
        digital.push(...active); physical.length=0;
      }
      row._v517_nonblockingDigitalRequests=digital;
      row._v517_nonblockingDigitalCount=digital.length;

      if(requested==='COPIA DIGITAL'){
        row._activeRequests=[];
        row.disponible=true;
        row.solicitud_interna=false;
        row.solicitud_otra_area=false;
        row.usar_reasignacion_interna=false;
        row._existingPendingReassignV481=null;
        row._referralDestination=null;
        row._instruction_active=false;
        row._v517_digitalAvailable=true;
        row.motivo=digital.length
          ?'DISPONIBLE · Ya existe otra copia digital solicitada, pero las copias digitales no modifican ni bloquean la custodia física.'
          :'DISPONIBLE · La copia digital es una atención documental y no modifica la custodia física del expediente.';
        return row;
      }

      if(digital.length){
        row._activeRequests=physical;
        if(!physical.length){
          const hardExternal=!!row._referralDestination || !!row._instruction_active;
          if(!v517OutsideArchive(row) && !hardExternal){
            row.disponible=true;
            row.solicitud_interna=false;
            row.solicitud_otra_area=false;
            row.usar_reasignacion_interna=false;
            row._v517_physicalAvailableDespiteDigital=true;
            row.motivo='DISPONIBLE · Existe una copia digital en atención, pero no bloquea el préstamo ni una nueva solicitud física.';
          }else{
            const upperReason=v517Norm(row.motivo||'');
            if(upperReason.includes('SOLICITUD ACTIVA') && upperReason.includes('COPIA DIGITAL')){
              row.motivo='La copia digital activa no bloquea. Se mantiene la condición física actual del expediente.';
            }
          }
        }
      }
      return row;
    });
  }
  async function v517ApplyDigitalCoexistence(rows,ensureActive){
    let source=Array.isArray(rows)?rows:[];
    if(ensureActive && source.length && typeof annotateActiveRequestsV119==='function'){
      try{source=await annotateActiveRequestsV119(source);}
      catch(error){console.warn('V517 · validación de solicitudes activas:',error?.message||error);}
    }
    return v517ApplyDigitalCoexistenceSync(source);
  }
  window.v517ApplyDigitalCoexistence=v517ApplyDigitalCoexistence;
  window.v517ApplyDigitalCoexistenceSync=v517ApplyDigitalCoexistenceSync;

  if(typeof validateRequestRowsFastV188==='function'){
    const baseValidateV517=validateRequestRowsFastV188;
    validateRequestRowsFastV188=async function(){
      const rows=await baseValidateV517.apply(this,arguments);
      return v517ApplyDigitalCoexistenceSync(rows);
    };
    window.validateRequestRowsFastV188=validateRequestRowsFastV188;
  }
  if(typeof requestLookupCacheKeyV187==='function'){
    requestLookupCacheKeyV187=function(expediente,extension=''){
      return `${v517Norm(expediente||'')}::${v517Norm(extension||'')}::${v517RequestedMode()}`;
    };
    window.requestLookupCacheKeyV187=requestLookupCacheKeyV187;
  }
  function refresh(){
    try{
      if(typeof invalidateRequestLookupCacheV187==='function')invalidateRequestLookupCacheV187();
      const input=document.getElementById('requestLookupInput');
      if(input?.value?.trim() && typeof searchRequestCandidates==='function')searchRequestCandidates();
    }catch(error){console.warn('V517 · cambio de modalidad:',error?.message||error);}
  }
  const mode=document.getElementById('rqModalidad');
  if(mode && !mode.dataset.v517Bound){mode.dataset.v517Bound='1';mode.addEventListener('change',refresh);}
})();
</script>
<style id="v517-digital-nonblocking-style">
.v517-digital-nonblocking-note{display:block;margin-top:4px;color:#17603a;font-size:10px;line-height:1.3;font-weight:700}
</style>

<script id="v518-digital-mode-from-sql-script">
(function(){
  'use strict';

  async function attachModesV518(rows){
    const source=Array.isArray(rows)?rows:[];
    const ids=[...new Set(source.map(r=>String(r?.id||r?.expediente_id||'').trim()).filter(Boolean))];
    if(!ids.length || !window.sb)return source;

    try{
      const {data,error}=await sb.rpc('v518_modalidades_solicitudes_expediente',{
        p_expediente_ids:ids
      });
      if(error)throw error;

      const byReqId=new Map();
      const byReqNumber=new Map();
      const byExp=new Map();

      (Array.isArray(data)?data:[]).forEach(x=>{
        const exp=String(x?.expediente_id||'').trim();
        const req=String(x?.solicitud_id||'').trim();
        const num=String(x?.numero||'').trim();
        if(exp && req)byReqId.set(`${exp}::${req}`,x);
        if(exp && num)byReqNumber.set(`${exp}::${num}`,x);
        if(exp){
          if(!byExp.has(exp))byExp.set(exp,[]);
          byExp.get(exp).push(x);
        }
      });

      return source.map(raw=>{
        const row={...raw};
        const exp=String(row?.id||row?.expediente_id||'').trim();
        const active=Array.isArray(row._activeRequests)?row._activeRequests:[];
        const allForExp=byExp.get(exp)||[];

        row._activeRequests=active.map(req=>{
          const rid=String(req?.solicitud_id||req?.id||'').trim();
          const num=String(req?.numero||req?.solicitud_numero||'').trim();
          let hit=(rid?byReqId.get(`${exp}::${rid}`):null) ||
                  (num?byReqNumber.get(`${exp}::${num}`):null) || null;

          if(!hit && active.length===1 && allForExp.length===1)hit=allForExp[0];

          return hit
            ?{
                ...req,
                modalidad:hit.modalidad||req?.modalidad||null,
                modalidad_solicitud:hit.modalidad||req?.modalidad_solicitud||null,
                estado:hit.estado_solicitud||req?.estado||null,
                estado_item:hit.estado_item||req?.estado_item||null
              }
            :req;
        });
        return row;
      });
    }catch(error){
      console.warn('V518 · No se pudo consultar modalidad desde Supabase:',error?.message||error);
      return source;
    }
  }

  window.v518AttachRequestModes=attachModesV518;

  if(typeof annotateActiveRequestsV119==='function'){
    const baseAnnotateV518=annotateActiveRequestsV119;
    annotateActiveRequestsV119=async function(){
      const rows=await baseAnnotateV518.apply(this,arguments);
      return attachModesV518(rows);
    };
    window.annotateActiveRequestsV119=annotateActiveRequestsV119;
  }

  if(typeof window.v517ApplyDigitalCoexistence==='function'){
    const baseCoexistV518=window.v517ApplyDigitalCoexistence;
    window.v517ApplyDigitalCoexistence=async function(rows,ensureActive){
      let result=await baseCoexistV518(rows,ensureActive);
      result=await attachModesV518(result);
      return typeof window.v517ApplyDigitalCoexistenceSync==='function'
        ?window.v517ApplyDigitalCoexistenceSync(result)
        :result;
    };
  }
})();
</script>

<style id="v523-master-search-hint-style">
#tab-all #allSearch{transition:border-color .12s ease,box-shadow .12s ease}
#tab-all #allSearch:focus{border-color:#2d6fb7;box-shadow:0 0 0 2px rgba(45,111,183,.08)}
</style>

<script id="v525-master-instant-filter">
(function(){
  'use strict';

  function canonicalExpV525(value){
    const raw=String(value||'').trim().toUpperCase().replace(/\s+/g,'');
    const m=raw.match(/^0*(\d+)-(\d{4})$/);
    if(!m)return raw;
    return String(Number(m[1]||0))+'-'+m[2];
  }

  function rowExpValuesV525(row){
    const cell=row?.querySelector?.('.v19-exp');
    const text=String(cell?.textContent||'').toUpperCase();
    const found=text.match(/0*\d+-\d{4}/g)||[];
    return found.map(canonicalExpV525);
  }

  function applyInstantMasterFilterV525(){
    const input=document.getElementById('allSearch');
    const root=document.getElementById('allTable');
    if(!input||!root)return;

    const raw=String(input.value||'').trim();
    const compact=raw.replace(/\s+/g,'');
    const exact=/^0*\d+-\d{4}$/.test(compact);
    const canonical=exact?canonicalExpV525(compact):'';
    const general=raw.toUpperCase();
    const rows=[...root.querySelectorAll('table tbody tr')];
    if(!rows.length)return;

    let visible=0;
    rows.forEach(row=>{
      let show=true;
      if(raw){
        if(exact){
          const values=rowExpValuesV525(row);
          show=values.includes(canonical);
        }else{
          const cell=row.querySelector('.v19-exp');
          show=String(cell?.textContent||'').toUpperCase().includes(general);
        }
      }
      row.style.display=show?'':'none';
      if(show)visible++;
    });

    root.dataset.v525InstantFilter=raw?'1':'0';
    root.dataset.v525InstantVisible=String(visible);
  }

  function bindV525(){
    const input=document.getElementById('allSearch');
    const root=document.getElementById('allTable');
    if(!input||!root)return;

    if(!input.dataset.v525InstantBound){
      input.dataset.v525InstantBound='1';
      input.addEventListener('input',applyInstantMasterFilterV525,{passive:true});
      input.addEventListener('keydown',ev=>{
        if(ev.key==='Enter')applyInstantMasterFilterV525();
      });
    }

    if(!root.dataset.v525Observed){
      root.dataset.v525Observed='1';
      const observer=new MutationObserver(()=>{
        if(String(input.value||'').trim())queueMicrotask(applyInstantMasterFilterV525);
      });
      observer.observe(root,{childList:true,subtree:true});
      window.__v525MasterObserver=observer;
    }

    applyInstantMasterFilterV525();
  }

  window.applyInstantMasterFilterV525=applyInstantMasterFilterV525;

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',bindV525,{once:true});
  }else{
    bindV525();
  }
  window.addEventListener('load',bindV525,{once:true});
})();
</script>

<style id="v527-human-state-cards">
