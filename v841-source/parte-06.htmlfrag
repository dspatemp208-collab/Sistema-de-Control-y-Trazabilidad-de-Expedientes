<!-- V460 · depuración estructural: cero sticky en área operativa, una sola pestaña pintable, catálogo de asuntos desmontado cuando está cerrado. -->

<script id="v461-subject-orphan-sanitizer">
(function(){
  'use strict';
  let scheduled=false;

  function normV461(value){
    return String(value||'')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .trim()
      .replace(/\s+/g,' ')
      .toUpperCase();
  }

  function catalogV461(){
    const base=(typeof ASUNTOS_PREDETERMINADOS!=='undefined' && Array.isArray(ASUNTOS_PREDETERMINADOS))
      ? ASUNTOS_PREDETERMINADOS : [];
    const loaded=(typeof asuntosCatalogo!=='undefined' && Array.isArray(asuntosCatalogo))
      ? asuntosCatalogo.map(x=>x && x.nombre) : [];
    return new Set([...base,...loaded].map(normV461).filter(Boolean));
  }

  function legitimateV461(textNode){
    const p=textNode && textNode.parentElement;
    if(!p) return false;
    return !!p.closest([
      'td','th','select','option',
      '#newRequestModal','#subjectsModal','#requestModal','#historyModal','#cargoModal',
      '.modal','[role="dialog"]',
      '.notification-item','.alert-item','.cross-area-wait-alert','.timeline-item',
      '.toast','.pill','.badge'
    ].join(','));
  }

  function sanitizeTextNodeV461(node,set){
    if(!node || node.nodeType!==Node.TEXT_NODE) return 0;
    const value=normV461(node.nodeValue);
    if(!value || !set.has(value) || legitimateV461(node)) return 0;
    try{ node.remove(); }catch(_){ node.nodeValue=''; }
    return 1;
  }

  function sanitizeRootV461(root,set){
    if(!root) return 0;
    let removed=0;
    if(root.nodeType===Node.TEXT_NODE) return sanitizeTextNodeV461(root,set);
    if(root.nodeType!==Node.ELEMENT_NODE && root!==document.body) return 0;

    if(root.querySelectorAll){
      root.querySelectorAll('option').forEach(opt=>{
        const value=normV461(opt.value||opt.textContent);
        if(set.has(value) && !opt.closest('select')){ opt.remove(); removed++; }
      });
    }

    const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
    const doomed=[];
    let node;
    while((node=walker.nextNode())){
      const value=normV461(node.nodeValue);
      if(value && set.has(value) && !legitimateV461(node)) doomed.push(node);
    }
    doomed.forEach(n=>{ try{n.remove();}catch(_){n.nodeValue='';} });
    return removed+doomed.length;
  }

  function fullGuardV461(){
    scheduled=false;
    const set=catalogV461();
    if(!set.size || !document.body) return 0;
    return sanitizeRootV461(document.body,set);
  }

  function scheduleFullV461(){
    if(scheduled) return;
    scheduled=true;
    requestAnimationFrame(fullGuardV461);
  }

  function startV461(){
    fullGuardV461();
    requestAnimationFrame(()=>{
      fullGuardV461();
      document.documentElement.classList.remove('v461-subject-boot');
    });

    if('MutationObserver' in window){
      const observer=new MutationObserver(records=>{
        const set=catalogV461();
        if(!set.size) return;
        let needsFull=false;
        for(const rec of records){
          if(rec.type==='characterData'){
            sanitizeTextNodeV461(rec.target,set);
            continue;
          }
          for(const n of rec.addedNodes){ sanitizeRootV461(n,set); }
          if(rec.type==='attributes') needsFull=true;
        }
        if(needsFull) scheduleFullV461();
      });
      observer.observe(document.body,{
        childList:true,
        subtree:true,
        characterData:true,
        attributes:true,
        attributeFilter:['class','style','hidden']
      });
      window.__v461SubjectOrphanObserver=observer;
    }

    [80,250,700,1500,3000].forEach(ms=>setTimeout(fullGuardV461,ms));

    document.addEventListener('click',event=>{
      if(event.target.closest('.nav-item,.nav-btn,.btn,[data-tab],#stateGrid')){
        setTimeout(fullGuardV461,0);
        setTimeout(fullGuardV461,80);
      }
    },true);

    window.sanitizeSubjectArtifactsV461=fullGuardV461;
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',startV461,{once:true});
  }else{
    startV461();
  }
})();
</script>

<script id="v467-desktop-notification-script">
(function(){
  'use strict';

  const V467_ENABLED_KEY='v467_desktop_notifications_enabled';
  const V467_SEEN_PREFIX='v467_reassign_desktop_seen_';
  const V467_POLL_MS=12000;

  let v467DesktopTimer=null;
  let v467DesktopBusy=false;
  let v467LastProfileKey='';

  function v467Session(){
    try{return session||null;}catch(_){return null;}
  }

  function v467Profile(){
    try{return currentProfile||null;}catch(_){return null;}
  }

  function v467UserKey(){
    const s=v467Session();
    const p=v467Profile();
    return String(
      s?.user?.id ||
      p?.id ||
      p?.email ||
      'anon'
    );
  }

  function v467SeenKey(){
    return V467_SEEN_PREFIX+v467UserKey();
  }

  function v467ReadSeen(){
    try{
      const raw=localStorage.getItem(v467SeenKey())||'[]';
      const arr=JSON.parse(raw);
      return new Set(Array.isArray(arr)?arr.map(String):[]);
    }catch(_){
      return new Set();
    }
  }

  function v467SaveSeen(set){
    try{
      localStorage.setItem(
        v467SeenKey(),
        JSON.stringify([...set].slice(-400))
      );
    }catch(_){}
  }

  function v467RowKey(row){
    return String(
      row?.id ||
      row?.solicitud_reasignacion_id ||
      row?.solicitud_id ||
      [
        row?.expediente_id||row?.expediente||'',
        row?.solicitante_nombre||'',
        row?.created_at||''
      ].join('|')
    );
  }

  function v467IsEnabled(){
    try{
      return localStorage.getItem(V467_ENABLED_KEY)==='1';
    }catch(_){
      return false;
    }
  }

  function v467SetEnabled(value){
    try{
      localStorage.setItem(V467_ENABLED_KEY,value?'1':'0');
    }catch(_){}
  }

  function v467Supported(){
    return 'Notification' in window;
  }

  function v467Button(){
    return document.getElementById('desktopNotifyBtnV467');
  }

  function v467RefreshButton(){
    const btn=v467Button();
    if(!btn)return;

    btn.classList.remove('v467-active','v467-blocked','v467-waiting');

    if(!v467Supported()){
      btn.textContent='🔕 Avisos PC no disponibles';
      btn.classList.add('v467-blocked');
      btn.disabled=true;
      btn.title='Este navegador no admite notificaciones de escritorio.';
      return;
    }

    if(Notification.permission==='denied'){
      btn.textContent='🔕 Avisos PC bloqueados';
      btn.classList.add('v467-blocked');
      btn.disabled=false;
      btn.title='El navegador tiene bloqueadas las notificaciones para este sitio.';
      return;
    }

    if(Notification.permission==='granted' && v467IsEnabled()){
      btn.textContent='🔔 Avisos PC activos';
      btn.classList.add('v467-active');
      btn.title='Las solicitudes de reasignación recibidas generan un aviso de escritorio.';
      return;
    }

    btn.textContent='🔔 Activar avisos PC';
    btn.classList.add('v467-waiting');
    btn.title='Activar avisos de Windows/Chrome por solicitudes de reasignación.';
  }

  function v467OpenReassignments(){
    try{ window.focus(); }catch(_){}

    setTimeout(async()=>{
      try{
        if(typeof window.showUserCard==='function' &&
           typeof window.isLimitedUser==='function' &&
           window.isLimitedUser()){
          await window.showUserCard('SOLICITUDES_REASIGNACION');
          return;
        }
      }catch(_){}

      try{
        if(typeof window.openAlertsModal==='function'){
          await window.openAlertsModal();
        }
      }catch(_){}
    },120);
  }

  function v467DesktopNotification(row){
    if(!v467Supported() ||
       Notification.permission!=='granted' ||
       !v467IsEnabled()) return false;

    const expediente=String(row?.expediente||'—').trim()||'—';
    const solicitante=String(row?.solicitante_nombre||'Otro usuario').trim()||'Otro usuario';
    const extension=String(row?.extension||'').trim();
    const asunto=String(row?.asunto||'').trim();

    const lines=[
      `Expediente: ${expediente}${extension?' · '+extension:''}`,
      `Solicitado por: ${solicitante}`,
      'El expediente se encuentra bajo su custodia.'
    ];
    if(asunto)lines.push(`Asunto: ${asunto}`);

    try{
      const n=new Notification('🔄 Nueva solicitud de reasignación',{
        body:lines.join('\n'),
        tag:'reasignacion-'+v467RowKey(row),
        renotify:false,
        requireInteraction:true,
        silent:false
      });

      n.onclick=()=>{
        try{n.close();}catch(_){}
        v467OpenReassignments();
      };

      return true;
    }catch(error){
      console.warn('V467 · notificación de escritorio:',error?.message||error);
      return false;
    }
  }

  function v467PendingReceived(){
    try{
      if(typeof window.receivedPendingReassignRowsV196==='function'){
        return window.receivedPendingReassignRowsV196()||[];
      }
    }catch(_){}

    let rows=[];
    try{
      rows=Array.isArray(internalReassignRows)
        ?internalReassignRows
        :[];
    }catch(_){
      rows=[];
    }

    return rows.filter(r=>
      String(r?.direccion||'').trim().toUpperCase()==='RECIBIDA' &&
      String(r?.estado||'').trim().toUpperCase()==='PENDIENTE' &&
      r?.puede_responder!==false &&
      !r?._derived_custodian_alert
    );
  }

  function v467NotifyPending(){
    if(!v467Supported() ||
       Notification.permission!=='granted' ||
       !v467IsEnabled()) return;

    const rows=v467PendingReceived()
      .slice()
      .sort((a,b)=>String(a?.created_at||'').localeCompare(String(b?.created_at||'')));

    if(!rows.length)return;

    const seen=v467ReadSeen();
    const pending=rows.filter(r=>{
      const key=v467RowKey(r);
      return key && !seen.has(key);
    });

    if(!pending.length)return;

    let shown=0;
    pending.slice(0,5).forEach(row=>{
      const key=v467RowKey(row);
      if(v467DesktopNotification(row)){
        seen.add(key);
        shown++;
      }
    });

    v467SaveSeen(seen);

    if(shown){
      try{
        if(typeof window.v362PlayRequestSound==='function'){
          window.v362PlayRequestSound();
        }
      }catch(_){}

      try{
        if(typeof window.showToast==='function'){
          window.showToast(
            shown===1
              ?'🔔 Nueva solicitud de reasignación recibida'
              :`🔔 ${shown} solicitudes de reasignación recibidas`,
            9000
          );
        }
      }catch(_){}
    }
  }

  async function v467Poll(){
    if(v467DesktopBusy)return;
    if(!v467Session() || !v467Profile())return;
    if(navigator.onLine===false)return;

    const profileKey=v467UserKey();
    if(profileKey!==v467LastProfileKey){
      v467LastProfileKey=profileKey;
      v467RefreshButton();
    }

    v467DesktopBusy=true;
    try{
      if(typeof window.loadInternalReassignRequests==='function'){
        await window.loadInternalReassignRequests(true);
      }

      // V476 · Mantener sincronizadas también las tarjetas personales.
      try{
        if(typeof isStaffPersonalWorkspaceV319==='function' &&
           isStaffPersonalWorkspaceV319() &&
           typeof loadUserPersonalSummary==='function'){
          await loadUserPersonalSummary();
        }
      }catch(error){
        console.warn('V476 · actualización de tarjetas:',error?.message||error);
      }

      v467NotifyPending();
    }catch(error){
      console.warn('V467 · revisión de reasignaciones:',error?.message||error);
    }finally{
      v467DesktopBusy=false;
    }
  }

  async function toggleDesktopNotificationsV467(){
    if(!v467Supported()){
      try{
        window.showToast?.('Este navegador no admite avisos de escritorio.',7000);
      }catch(_){}
      v467RefreshButton();
      return;
    }

    if(Notification.permission==='denied'){
      try{
        window.showToast?.(
          'Las notificaciones están bloqueadas en el navegador. Habilítelas para este sitio y vuelva a intentarlo.',
          9000
        );
      }catch(_){}
      v467RefreshButton();
      return;
    }

    if(Notification.permission==='granted' && v467IsEnabled()){
      v467SetEnabled(false);
      v467RefreshButton();
      try{window.showToast?.('Avisos de escritorio desactivados.',6000);}catch(_){}
      return;
    }

    let permission=Notification.permission;
    if(permission!=='granted'){
      try{
        permission=await Notification.requestPermission();
      }catch(error){
        console.warn('V467 · permiso de notificaciones:',error?.message||error);
      }
    }

    if(permission==='granted'){
      v467SetEnabled(true);
      v467RefreshButton();

      try{
        const test=new Notification('✅ Avisos de expedientes activados',{
          body:'Recibirá un aviso cuando otro usuario le solicite la reasignación de un expediente.',
          tag:'v467-notifications-enabled',
          requireInteraction:false
        });
        test.onclick=()=>{try{window.focus();test.close();}catch(_){}};
      }catch(_){}

      // Si ya existe una solicitud pendiente, avisarla ahora.
      await v467Poll();
    }else{
      v467SetEnabled(false);
      v467RefreshButton();
    }
  }

  function v467Start(){
    v467RefreshButton();

    clearInterval(v467DesktopTimer);
    v467DesktopTimer=null;

    // V601: V467 queda solo como compatibilidad visual/nativa. La fuente activa
    // de reasignaciones se actualiza desde V483/V549 para evitar consultas duplicadas.
    setTimeout(()=>{ if(!document.hidden) v467Poll(); },4000);

    if(!window.__v467DesktopHooks){
      window.addEventListener('focus',v467RefreshButton,{passive:true});
      window.addEventListener('online',v467RefreshButton,{passive:true});
      document.addEventListener('visibilitychange',()=>{
        if(!document.hidden)v467RefreshButton();
      });
      window.__v467DesktopHooks=true;
    }
  }

  window.toggleDesktopNotificationsV467=toggleDesktopNotificationsV467;
  window.refreshDesktopNotificationButtonV467=v467RefreshButton;
  window.checkDesktopReassignmentNotificationsV467=v467Poll;

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',v467Start,{once:true});
  }else{
    v467Start();
  }
})();
</script>


<script id="v476-reassign-diagnostic">
(function(){
  'use strict';

  function logV476(){
    try{
      if(!currentProfile)return;
      const role=norm(currentProfile.rol||'');
      if(role!=='ARCHIVO' && role!=='ADMINISTRADOR')return;

      const received=typeof receivedPendingReassignRowsV196==='function'
        ?receivedPendingReassignRowsV196().length
        :0;
      const sent=typeof sentPendingReassignRowsV197==='function'
        ?sentPendingReassignRowsV197().length
        :0;

      console.info(
        'V476 · Reasignaciones personales',
        {
          usuario:currentProfile.nombre_personal||'',
          rol:currentProfile.rol||'',
          recibidas_pendientes:received,
          enviadas_pendientes:sent,
          filas_cargadas:Array.isArray(internalReassignRows)?internalReassignRows.length:0
        }
      );
    }catch(_){}
  }

  window.v476LogReassignments=logV476;
  // V602: diagnóstico manual disponible en window.v476LogReassignments(),
  // pero sin escribir en consola cada 30 segundos en producción.
})();
</script>


<div id="v482ReassignCornerStack"
     class="v482-hidden"
     aria-live="assertive"
     aria-label="Avisos de reasignación">
</div>

<script id="v482-reassignment-corner-alert-script">
(function(){
  'use strict';

  const V482_POLL_MS=8000;
  const V482_ACK_PREFIX='v482_reassign_ack_';
  const V482_NATIVE_PREFIX='v482_reassign_native_seen_';

  let v482Timer=null;
  let v482Busy=false;
  let v482KnownKeys=new Set();
  let v482FirstRun=true;

  function v482Profile(){
    try{return currentProfile||null;}catch(_){return null;}
  }

  function v482Session(){
    try{return session||null;}catch(_){return null;}
  }

  function v482UserKey(){
    const s=v482Session();
    const p=v482Profile();
    return String(s?.user?.id||p?.id||p?.email||'anon');
  }

  function v482ReadSet(prefix){
    try{
      const raw=sessionStorage.getItem(prefix+v482UserKey())||'[]';
      const arr=JSON.parse(raw);
      return new Set(Array.isArray(arr)?arr.map(String):[]);
    }catch(_){
      return new Set();
    }
  }

  function v482SaveSet(prefix,set){
    try{
      sessionStorage.setItem(
        prefix+v482UserKey(),
        JSON.stringify([...set].slice(-500))
      );
    }catch(_){}
  }

  function v482AckSet(){
    return v482ReadSet(V482_ACK_PREFIX);
  }

  function v482Ack(key){
    const set=v482AckSet();
    set.add(String(key));
    v482SaveSet(V482_ACK_PREFIX,set);
    v482Render();
  }

  function v482NativeSeen(){
    try{
      const raw=localStorage.getItem(V482_NATIVE_PREFIX+v482UserKey())||'[]';
      const arr=JSON.parse(raw);
      return new Set(Array.isArray(arr)?arr.map(String):[]);
    }catch(_){
      return new Set();
    }
  }

  function v482SaveNativeSeen(set){
    try{
      localStorage.setItem(
        V482_NATIVE_PREFIX+v482UserKey(),
        JSON.stringify([...set].slice(-500))
      );
    }catch(_){}
  }

  function v482DateText(value){
    if(!value)return '';
    try{
      const d=typeof fmtDate==='function'?fmtDate(value):'';
      const hasTime=typeof masterValueHasExplicitTime==='function'
        ?masterValueHasExplicitTime(value)
        :true;
      const t=hasTime && typeof fmtTime==='function'?fmtTime(value):'';
      return [d,t].filter(Boolean).join(' · ');
    }catch(_){
      return String(value||'');
    }
  }

  function v482ReceivedRows(){
    try{
      if(typeof receivedPendingReassignRowsV196==='function'){
        return (receivedPendingReassignRowsV196()||[]).filter(Boolean);
      }
    }catch(_){}

    let rows=[];
    try{
      rows=Array.isArray(internalReassignRows)?internalReassignRows:[];
    }catch(_){}

    return rows.filter(r=>
      String(r?.estado||'').trim().toUpperCase()==='PENDIENTE' &&
      String(r?.direccion||'').trim().toUpperCase()==='RECIBIDA' &&
      r?.puede_responder!==false &&
      !r?._derived_custodian_alert
    );
  }

  function v482CompletedRows(){
    let rows=[];
    try{
      rows=Array.isArray(notificationRows)?notificationRows:[];
    }catch(_){}

    return rows.filter(n=>n && !n.leida);
  }

  function v482Events(){
    const requests=v482ReceivedRows().map(r=>({
      key:'request:'+String(r.id||[
        r.expediente_id||r.expediente||'',
        r.solicitante_nombre||'',
        r.created_at||''
      ].join('|')),
      kind:'request',
      id:String(r.id||''),
      expedienteId:String(r.expediente_id||''),
      expediente:String(r.expediente||'—'),
      extension:String(r.extension||''),
      person:String(r.solicitante_nombre||'Otro usuario'),
      asunto:String(r.asunto||''),
      date:r.created_at||null,
      raw:r
    }));

    const completed=v482CompletedRows().map(n=>({
      key:'completed:'+String(n.id||[
        n.expediente_id||n.expediente||'',
        n.created_at||'',
        n.titulo||''
      ].join('|')),
      kind:'completed',
      id:String(n.id||''),
      expedienteId:String(n.expediente_id||''),
      expediente:String(n.expediente||'—'),
      title:String(n.titulo||'Expediente reasignado'),
      message:String(n.mensaje||'El expediente fue reasignado.'),
      date:n.created_at||null,
      raw:n
    }));

    return [...requests,...completed]
      .filter(x=>x.key && !x.key.endsWith(':'))
      .sort((a,b)=>String(b.date||'').localeCompare(String(a.date||'')));
  }

  function v482Esc(value){
    try{
      return typeof esc==='function'
        ?esc(value)
        :String(value??'')
          .replace(/&/g,'&amp;')
          .replace(/</g,'&lt;')
          .replace(/>/g,'&gt;')
          .replace(/"/g,'&quot;');
    }catch(_){
      return String(value??'');
    }
  }

  function v482EscJs(value){
    return String(value??'')
      .replace(/\\/g,'\\\\')
      .replace(/'/g,"\\'");
  }

  function v482RequestHtml(e){
    const date=v482DateText(e.date);
    return `<article class="v482-corner-alert is-request" data-v482-key="${v482Esc(e.key)}">
      <div class="v482-corner-head">
        <div class="v482-corner-title">
          <span>🔄 Nueva solicitud de reasignación</span>
          <span class="v482-corner-badge">NUEVA</span>
        </div>
        <button class="v482-corner-close" type="button"
                title="Cerrar este aviso"
                onclick="v482Dismiss('${v482EscJs(e.key)}')">×</button>
      </div>
      <div class="v482-corner-body">
        <div class="v482-corner-exp">Expediente ${v482Esc(e.expediente)}${e.extension?' · '+v482Esc(e.extension):''}</div>
        <div class="v482-corner-message">
          <b>${v482Esc(e.person)}</b> solicita que el expediente que está bajo su custodia sea reasignado.
          ${e.asunto?`<br>Asunto: <b>${v482Esc(e.asunto)}</b>`:''}
          ${date?`<br>Solicitud: <b>${v482Esc(date)}</b>`:''}
        </div>
      </div>
      <div class="v482-corner-actions">
        <button class="btn small" type="button"
                onclick="v482OpenRequest('${v482EscJs(e.key)}')">
          Ver solicitud
        </button>
      </div>
    </article>`;
  }

  function v482CompletedHtml(e){
    const date=v482DateText(e.date);
    return `<article class="v482-corner-alert is-completed" data-v482-key="${v482Esc(e.key)}">
      <div class="v482-corner-head">
        <div class="v482-corner-title">
          <span>✅ ${v482Esc(e.title||'Expediente reasignado')}</span>
          <span class="v482-corner-badge">REASIGNADO</span>
        </div>
        <button class="v482-corner-close" type="button"
                title="Cerrar este aviso"
                onclick="v482Dismiss('${v482EscJs(e.key)}')">×</button>
      </div>
      <div class="v482-corner-body">
        <div class="v482-corner-exp">Expediente ${v482Esc(e.expediente)}</div>
        <div class="v482-corner-message">
          ${v482Esc(e.message||'El expediente fue reasignado.')}
          ${date?`<br>Fecha: <b>${v482Esc(date)}</b>`:''}
        </div>
      </div>
      <div class="v482-corner-actions">
        <button class="btn small" type="button"
                onclick="v482OpenCompleted('${v482EscJs(e.key)}')">
          Ver expediente
        </button>
      </div>
    </article>`;
  }

  function v482AdjustPosition(){
    const host=document.getElementById('v482ReassignCornerStack');
    if(!host)return;

    const existing=document.getElementById('v362RequestAlertStack');
    const visible=existing &&
      !existing.classList.contains('hidden') &&
      existing.offsetParent!==null &&
      existing.getBoundingClientRect().height>0;

    host.style.right='';
    host.style.bottom='';

    if(!visible)return;

    const rect=existing.getBoundingClientRect();

    if(window.innerWidth>940){
      host.style.right=`${Math.ceil(18+rect.width+12)}px`;
      host.style.bottom='18px';
    }else{
      const offset=Math.min(
        Math.ceil(rect.height+18),
        Math.max(120,Math.floor(window.innerHeight*.47))
      );
      host.style.bottom=`${offset}px`;
      host.style.right='8px';
    }
  }

  function v482VisibleEvents(){
    const ack=v482AckSet();
    return v482Events().filter(e=>!ack.has(e.key));
  }

  function v482Render(){
    const host=document.getElementById('v482ReassignCornerStack');
    if(!host)return;

    // V484 · Si Windows/Chrome ya está mostrando avisos nativos,
    // no duplicarlos como tarjetas dentro del sistema.
    if(typeof window.nativeOnlyActiveV484==='function' &&
       window.nativeOnlyActiveV484()){
      host.innerHTML='';
      host.classList.add('v482-hidden');
      return;
    }

    const events=v482VisibleEvents();
    if(!events.length){
      host.innerHTML='';
      host.classList.add('v482-hidden');
      return;
    }

    const visible=events.slice(0,4);
    const remaining=Math.max(0,events.length-visible.length);

    host.innerHTML=visible.map(e=>
      e.kind==='request'
        ?v482RequestHtml(e)
        :v482CompletedHtml(e)
    ).join('')+
    (remaining
      ?`<div class="v482-corner-summary">
          + ${remaining} aviso(s) adicional(es) de reasignación.
        </div>`
      :'');

    host.classList.remove('v482-hidden');
    v482AdjustPosition();
  }

  function v482PlaySound(){
    try{
      if(typeof v362PlayRequestSound==='function'){
        v362PlayRequestSound();
      }
    }catch(_){}
  }

  function v482NativeEnabled(){
    try{
      return 'Notification' in window &&
        Notification.permission==='granted' &&
        localStorage.getItem('v467_desktop_notifications_enabled')==='1';
    }catch(_){
      return false;
    }
  }

  function v482NativeCompleted(event){
    if(!v482NativeEnabled() || event.kind!=='completed')return false;

    const seen=v482NativeSeen();
    if(seen.has(event.key))return false;

    try{
      const n=new Notification('✅ Expediente reasignado',{
        body:
          `Expediente: ${event.expediente}\n`+
          `${event.message||'El expediente fue reasignado.'}`,
        tag:'v482-'+event.key,
        renotify:false,
        requireInteraction:true,
        silent:false
      });

      n.onclick=()=>{
        try{n.close();window.focus();}catch(_){}
        v482OpenCompleted(event.key);
      };

      seen.add(event.key);
      v482SaveNativeSeen(seen);
      return true;
    }catch(error){
      console.warn('V482 · aviso nativo:',error?.message||error);
      return false;
    }
  }

  function v482DetectNew(){
    const events=v482Events();
    const keys=new Set(events.map(e=>e.key));

    const fresh=events.filter(e=>!v482KnownKeys.has(e.key));

    if(fresh.length){
      v482PlaySound();
      fresh.forEach(v482NativeCompleted);

      try{
        if(typeof showToast==='function'){
          const requests=fresh.filter(x=>x.kind==='request').length;
          const completed=fresh.filter(x=>x.kind==='completed').length;

          let message='🔔 Nueva alerta de reasignación';
          if(requests && completed){
            message=`🔔 ${requests} solicitud(es) y ${completed} reasignación(es) nueva(s)`;
          }else if(requests){
            message=requests===1
              ?'🔔 Nueva solicitud de reasignación'
              :`🔔 ${requests} solicitudes de reasignación`;
          }else if(completed){
            message=completed===1
              ?'✅ Tiene un expediente reasignado'
              :`✅ Tiene ${completed} expedientes reasignados`;
          }

          showToast(message,12000);
        }
      }catch(_){}
    }

    v482KnownKeys=keys;
    v482FirstRun=false;
    v482Render();
  }

  async function v482Refresh(){
    if(v482Busy)return;
    if(!v482Session() || !v482Profile())return;
    if(navigator.onLine===false)return;

    v482Busy=true;
    try{
      const jobs=[];

      if(typeof loadInternalReassignRequests==='function'){
        jobs.push(loadInternalReassignRequests(true));
      }

      if(typeof loadNotifications==='function'){
        jobs.push(loadNotifications(true));
      }

      await Promise.allSettled(jobs);

      // Mantener los contadores del espacio personal actualizados.
      try{
        if(typeof isStaffPersonalWorkspaceV319==='function' &&
           isStaffPersonalWorkspaceV319() &&
           typeof loadUserPersonalSummary==='function'){
          await loadUserPersonalSummary();
        }
      }catch(error){
        console.warn('V482 · tarjetas personales:',error?.message||error);
      }

      v482DetectNew();
    }catch(error){
      console.warn('V482 · actualización:',error?.message||error);
    }finally{
      v482Busy=false;
    }
  }

  async function v482OpenRequest(key){
    v482Ack(key);

    try{
      if(
        typeof isStaffPersonalWorkspaceV319==='function' &&
        isStaffPersonalWorkspaceV319()
      ){
        userPanelMode='SOLICITUDES_REASIGNACION';
        page=0;
        if(typeof updateUserPersonalKpiUI==='function'){
          updateUserPersonalKpiUI();
        }
        if(typeof loadPanel==='function'){
          await loadPanel({refreshCards:false});
        }
        document.getElementById('panelTable')
          ?.scrollIntoView({behavior:'smooth',block:'start'});
        return;
      }
    }catch(error){
      console.warn('V482 · abrir tarjeta ARCHIVO:',error?.message||error);
    }

    try{
      if(typeof showUserCard==='function'){
        await showUserCard('SOLICITUDES_REASIGNACION');
        return;
      }
    }catch(_){}

    try{
      if(typeof openAlertsModal==='function'){
        await openAlertsModal();
      }
    }catch(_){}
  }

  async function v482OpenCompleted(key){
    const event=v482Events().find(e=>e.key===key);
    v482Ack(key);
    if(!event)return;

    try{
      if(
        event.id &&
        event.expedienteId &&
        typeof openNotificationExpediente==='function'
      ){
        await openNotificationExpediente(event.id,event.expedienteId);
        return;
      }
    }catch(error){
      console.warn('V482 · abrir expediente reasignado:',error?.message||error);
    }

    try{
      if(event.expedienteId && typeof manageExpedienteFromPanel==='function'){
        await manageExpedienteFromPanel(event.expedienteId);
      }
    }catch(_){}
  }

  function v482Dismiss(key){
    v482Ack(key);
  }

  function v482Test(){
    const host=document.getElementById('v482ReassignCornerStack');
    if(!host)return;

    host.innerHTML=`<article class="v482-corner-alert v482-corner-test">
      <div class="v482-corner-head">
        <div class="v482-corner-title">
          <span>🔔 Avisos de reasignación activos</span>
          <span class="v482-corner-badge">PRUEBA</span>
        </div>
        <button class="v482-corner-close" type="button"
                onclick="v482Render()">×</button>
      </div>
      <div class="v482-corner-body">
        <div class="v482-corner-exp">Aviso de prueba</div>
        <div class="v482-corner-message">
          Los avisos internos aparecerán aquí cuando reciba una solicitud
          de reasignación o cuando un expediente sea reasignado.
        </div>
      </div>
    </article>`;

    host.classList.remove('v482-hidden');
    v482AdjustPosition();
    v482PlaySound();

    setTimeout(()=>v482Render(),7000);
  }

  function v482Start(){
    clearInterval(v482Timer);

    // V601: V482 conserva render/compatibilidad, pero no mantiene su propio polling.
    // V483 actualiza las fuentes y vuelve a dibujar V482.
    setTimeout(()=>{ if(!document.hidden) v482Refresh(); },2500);
    v482Timer=null;

    if(!window.__v482Hooks){
      window.addEventListener('focus',v482AdjustPosition,{passive:true});
      window.addEventListener('online',v482AdjustPosition,{passive:true});
      window.addEventListener('resize',v482AdjustPosition,{passive:true});
      document.addEventListener('visibilitychange',()=>{
        if(!document.hidden)v482AdjustPosition();
      });
      window.__v482Hooks=true;
    }

    // El botón de Avisos PC conserva su función nativa y además permite
    // verificar visualmente la esquina inferior.
    setTimeout(()=>{
      try{
        if(
          typeof window.toggleDesktopNotificationsV467==='function' &&
          !window.__v482WrappedDesktopToggle
        ){
          const original=window.toggleDesktopNotificationsV467;
          window.toggleDesktopNotificationsV467=async function(){
            const result=await original.apply(this,arguments);

            // V484 · La prueba visual interna solo se utiliza como
            // respaldo cuando no quedó habilitada la notificación nativa.
            if(!(typeof window.nativeOnlyActiveV484==='function' &&
                 window.nativeOnlyActiveV484())){
              v482Test();
            }
            return result;
          };
          window.__v482WrappedDesktopToggle=true;
        }
      }catch(_){}
    },500);
  }

  window.v482RefreshReassignmentAlerts=v482Refresh;
  window.v482Render=v482Render;
  window.v482Dismiss=v482Dismiss;
  window.v482OpenRequest=v482OpenRequest;
  window.v482OpenCompleted=v482OpenCompleted;
  window.v482Test=v482Test;

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',v482Start,{once:true});
  }else{
    v482Start();
  }
})();
</script>


<script id="v483-native-persistent-reassignment-notifications">
(function(){
  'use strict';

  /* ============================================================
     V483 · NOTIFICACIONES NATIVAS WINDOWS / CHROME / EDGE
     ============================================================

     OBJETIVO
     - Mostrar avisos como los de Gmail/Windows.
     - Solicitud recibida: permanece/reaparece mientras siga PENDIENTE.
     - Reasignación confirmada: permanece/reaparece mientras siga SIN LEER.
     - Cerrar el aviso NO equivale a atenderlo.
     - Al desaparecer la condición en Supabase, el aviso se cierra.
     - El aspecto exacto lo dibuja Windows/Chrome/Edge.
     ============================================================ */

  const V483_ENABLED_KEY='v467_desktop_notifications_enabled';
  const V483_POLL_MS=60000;
  const V483_RESHOW_MS=45000;

  const requestNotifications=new Map();
  const completedNotifications=new Map();
  const requestRetryAt=new Map();
  const completedRetryAt=new Map();

  let v483Timer=null;
  let v483Busy=false;

  function profileV483(){
    try{return currentProfile||null;}catch(_){return null;}
  }

  function sessionV483(){
    try{return session||null;}catch(_){return null;}
  }

  function enabledV483(){
    try{
      return localStorage.getItem(V483_ENABLED_KEY)==='1';
    }catch(_){
      return false;
    }
  }

  function setEnabledV483(value){
    try{
      localStorage.setItem(V483_ENABLED_KEY,value?'1':'0');
    }catch(_){}
  }

  function supportedV483(){
    return 'Notification' in window;
  }

  function notificationIconV483(){
    try{
      const favicon=document.querySelector(
        'link[rel="icon"],link[rel="shortcut icon"],link[rel*="icon"]'
      );
      return favicon?.href||undefined;
    }catch(_){
      return undefined;
    }
  }

  function rowKeyV483(row){
    return String(
      row?.id ||
      row?.solicitud_reasignacion_id ||
      row?.solicitud_id ||
      [
        row?.expediente_id||row?.expediente||'',
        row?.solicitante_nombre||'',
        row?.created_at||''
      ].join('|')
    );
  }

  function pendingReceivedV483(){
    try{
      if(typeof receivedPendingReassignRowsV196==='function'){
        return (receivedPendingReassignRowsV196()||[])
          .filter(r=>
            String(r?.estado||'').trim().toUpperCase()==='PENDIENTE'
          );
      }
    }catch(_){}

    let rows=[];
    try{
      rows=Array.isArray(internalReassignRows)?internalReassignRows:[];
    }catch(_){}

    return rows.filter(r=>
      String(r?.direccion||'').trim().toUpperCase()==='RECIBIDA' &&
      String(r?.estado||'').trim().toUpperCase()==='PENDIENTE' &&
      r?.puede_responder!==false &&
      !r?._derived_custodian_alert
    );
  }

  function unreadCompletedV483(){
    let rows=[];
    try{
      rows=Array.isArray(notificationRows)?notificationRows:[];
    }catch(_){}

    return rows.filter(n=>n && !n.leida);
  }

  function closeNotificationV483(map,key){
    const n=map.get(key);
    if(n){
      try{
        // Evitar programar reaparición cuando lo cerramos porque ya fue atendido.
        n.__v483Resolved=true;
        n.close();
      }catch(_){}
    }
    map.delete(key);
  }

  function openReceivedRequestsV483(){
    try{window.focus();}catch(_){}

    setTimeout(async()=>{
      try{
        if(
          typeof isStaffPersonalWorkspaceV319==='function' &&
          isStaffPersonalWorkspaceV319()
        ){
          userPanelMode='SOLICITUDES_REASIGNACION';
          page=0;
          if(typeof updateUserPersonalKpiUI==='function'){
            updateUserPersonalKpiUI();
          }
          if(typeof loadPanel==='function'){
            await loadPanel({forceFresh:true});
          }
          document.getElementById('panelTable')
            ?.scrollIntoView({behavior:'smooth',block:'start'});
          return;
        }
      }catch(error){
        console.warn('V483 · abrir reasignaciones ARCHIVO:',error?.message||error);
      }

      try{
        if(typeof showUserCard==='function'){
          await showUserCard('SOLICITUDES_REASIGNACION');
          return;
        }
      }catch(_){}

      try{
        if(typeof openAlertsModal==='function'){
          await openAlertsModal();
        }
      }catch(_){}
    },120);
  }

  async function openCompletedV483(row){
    try{window.focus();}catch(_){}

    try{
      if(
        row?.id &&
        row?.expediente_id &&
        typeof openNotificationExpediente==='function'
      ){
        await openNotificationExpediente(row.id,row.expediente_id);
        return;
      }
    }catch(error){
      console.warn('V483 · abrir reasignación confirmada:',error?.message||error);
    }

    try{
      if(row?.expediente_id && typeof manageExpedienteFromPanel==='function'){
        await manageExpedienteFromPanel(row.expediente_id);
      }
    }catch(_){}
  }

  function showRequestNativeV483(row){
    if(
      !supportedV483() ||
      Notification.permission!=='granted' ||
      !enabledV483()
    ) return false;

    const key=rowKeyV483(row);
    if(!key)return false;

    const expediente=String(row?.expediente||'—').trim()||'—';
    const extension=String(row?.extension||'').trim();
    const solicitante=String(row?.solicitante_nombre||'Otro usuario').trim()||'Otro usuario';
    const asunto=String(row?.asunto||'').trim();

    const body=[
      `SOLICITUD DE REASIGNACIÓN · ${expediente}${extension?' · '+extension:''}`,
      `${solicitante} solicita el expediente que está bajo su custodia.`,
      asunto?`Asunto: ${asunto}`:'',
      'El aviso permanecerá hasta que la solicitud sea atendida.'
    ].filter(Boolean).join('\n');

    try{
      const options={
        body,
        tag:'reasignacion-'+key,
        renotify:true,
        requireInteraction:true,
        silent:false
      };

      const icon=notificationIconV483();
      if(icon)options.icon=icon;

      const n=new Notification(
        'Sistema de Control y Trazabilidad de Expedientes',
        options
      );

      n.__v483Resolved=false;

      n.onclick=()=>{
        // Abrir la solicitud NO la marca como atendida.
        try{window.focus();}catch(_){}
        openReceivedRequestsV483();
        try{n.close();}catch(_){}
      };

      n.onclose=()=>{
        requestNotifications.delete(key);

        // Si el usuario la cerró pero la solicitud sigue pendiente,
        // volver a mostrarla más adelante.
        if(!n.__v483Resolved){
          requestRetryAt.set(key,Date.now()+V483_RESHOW_MS);
        }
      };

      requestNotifications.set(key,n);
      requestRetryAt.delete(key);
      return true;
    }catch(error){
      console.warn('V483 · notificación solicitud:',error?.message||error);
      return false;
    }
  }

  function completedKeyV483(row){
    return String(
      row?.id ||
      [
        row?.expediente_id||row?.expediente||'',
        row?.created_at||'',
        row?.titulo||''
      ].join('|')
    );
  }

  function showCompletedNativeV483(row){
    if(
      !supportedV483() ||
      Notification.permission!=='granted' ||
      !enabledV483()
    ) return false;

    const key=completedKeyV483(row);
    if(!key)return false;

    const expediente=String(row?.expediente||'—').trim()||'—';
    const titulo=String(row?.titulo||'Expediente reasignado').trim();
    const mensaje=String(
      row?.mensaje||
      'La reasignación fue confirmada. Revise el expediente en el sistema.'
    ).trim();

    const body=[
      `EXPEDIENTE REASIGNADO · ${expediente}`,
      mensaje,
      'El aviso permanecerá hasta que sea revisado.'
    ].join('\n');

    try{
      const options={
        body,
        tag:'v482-completed:'+key,
        renotify:true,
        requireInteraction:true,
        silent:false
      };

      const icon=notificationIconV483();
      if(icon)options.icon=icon;

      const n=new Notification(
        'Sistema de Control y Trazabilidad de Expedientes',
        options
      );

      n.__v483Resolved=false;

      n.onclick=async()=>{
        try{window.focus();}catch(_){}
        await openCompletedV483(row);
        try{n.close();}catch(_){}
      };

      n.onclose=()=>{
        completedNotifications.delete(key);

        if(!n.__v483Resolved){
          completedRetryAt.set(key,Date.now()+V483_RESHOW_MS);
        }
      };

      completedNotifications.set(key,n);
      completedRetryAt.delete(key);
      return true;
    }catch(error){
      console.warn('V483 · notificación reasignado:',error?.message||error);
      return false;
    }
  }

  function syncRequestsV483(){
    const rows=pendingReceivedV483();
    const current=new Map(
      rows.map(r=>[rowKeyV483(r),r]).filter(([key])=>!!key)
    );

    // Si ya fue atendida/rechazada, cerrar automáticamente el aviso.
    [...requestNotifications.keys()].forEach(key=>{
      if(!current.has(key)){
        closeNotificationV483(requestNotifications,key);
        requestRetryAt.delete(key);
      }
    });

    [...requestRetryAt.keys()].forEach(key=>{
      if(!current.has(key)){
        requestRetryAt.delete(key);
      }
    });

    let shown=0;
    current.forEach((row,key)=>{
      if(requestNotifications.has(key))return;

      const retry=requestRetryAt.get(key)||0;
      if(retry>Date.now())return;

      if(showRequestNativeV483(row))shown++;
    });

    return shown;
  }

  function syncCompletedV483(){
    const rows=unreadCompletedV483();
    const current=new Map(
      rows.map(r=>[completedKeyV483(r),r]).filter(([key])=>!!key)
    );

    // Cuando el aviso ya fue leído/atendido, cerrarlo.
    [...completedNotifications.keys()].forEach(key=>{
      if(!current.has(key)){
        closeNotificationV483(completedNotifications,key);
        completedRetryAt.delete(key);
      }
    });

    [...completedRetryAt.keys()].forEach(key=>{
      if(!current.has(key)){
        completedRetryAt.delete(key);
      }
    });

    let shown=0;
    current.forEach((row,key)=>{
      if(completedNotifications.has(key))return;

      const retry=completedRetryAt.get(key)||0;
      if(retry>Date.now())return;

      if(showCompletedNativeV483(row))shown++;
    });

    return shown;
  }

  function playSoundV483(){
    try{
      if(typeof v362PlayRequestSound==='function'){
        v362PlayRequestSound();
      }
    }catch(_){}
  }

  function refreshButtonV483(){
    const btn=document.getElementById('desktopNotifyBtnV467');
    if(!btn)return;

    btn.classList.remove('v483-native-ok','v483-native-warn');

    if(!supportedV483()){
      btn.textContent='🔕 Avisos PC no disponibles';
      btn.classList.add('v483-native-warn');
      return;
    }

    if(Notification.permission==='denied'){
      btn.textContent='🔕 Avisos PC bloqueados';
      btn.classList.add('v483-native-warn');
      btn.title='Habilite las notificaciones del sitio en Chrome/Edge.';
      return;
    }

    if(Notification.permission==='granted' && enabledV483()){
      btn.textContent='🔔 Avisos PC activos';
      btn.classList.add('v483-native-ok');
      btn.title='Los avisos permanecen mientras la reasignación siga pendiente.';
      return;
    }

    btn.textContent='🔔 Activar avisos PC';
    btn.classList.add('v483-native-warn');
  }

  async function enableV483(){
    if(!supportedV483()){
      try{
        showToast?.('Este navegador no admite notificaciones de escritorio.',8000);
      }catch(_){}
      return;
    }

    if(Notification.permission==='denied'){
      try{
        showToast?.(
          'Las notificaciones están bloqueadas. Habilítelas para este sitio en Chrome/Edge.',
          10000
        );
      }catch(_){}
      refreshButtonV483();
      return;
    }

    let permission=Notification.permission;

    if(permission!=='granted'){
      try{
        permission=await Notification.requestPermission();
      }catch(error){
        console.warn('V483 · permiso:',error?.message||error);
      }
    }

    if(permission!=='granted'){
      setEnabledV483(false);
      refreshButtonV483();
      return;
    }

    setEnabledV483(true);
    refreshButtonV483();

    // Prueba NATIVA, con el mismo estilo de los avisos de Gmail/Windows.
    try{
      const test=new Notification(
        'Sistema de Control y Trazabilidad de Expedientes',
        {
          body:
            '✅ Avisos de escritorio activados.\n'+
            'Las solicitudes de reasignación permanecerán notificadas hasta ser atendidas.',
          tag:'v483-test',
          requireInteraction:true,
          renotify:true,
          silent:false
        }
      );

      test.onclick=()=>{
        try{window.focus();test.close();}catch(_){}
      };
    }catch(error){
      console.warn('V483 · prueba nativa:',error?.message||error);
    }

    await refreshV483();
  }

  async function refreshV483(){
    if(v483Busy)return;
    if(!profileV483() || !sessionV483())return;
    if(navigator.onLine===false || document.hidden)return;
    if(window.v601Protection && !window.v601Protection.canPoll('v483'))return;

    v483Busy=true;

    try{
      const jobs=[];

      if(typeof loadInternalReassignRequests==='function'){
        jobs.push(loadInternalReassignRequests(true));
      }

      if(typeof loadNotifications==='function'){
        jobs.push(loadNotifications(true));
      }

      await Promise.allSettled(jobs);

      const newRequests=syncRequestsV483();
      const newCompleted=syncCompletedV483();

      if(newRequests || newCompleted){
        playSoundV483();
      }

      // Mantener también los avisos internos V482.
      try{
        if(typeof v482Render==='function'){
          v482Render();
        }
      }catch(_){}

      refreshButtonV483();
    }catch(error){
      console.warn('V483 · actualización:',error?.message||error);
    }finally{
      v483Busy=false;
    }
  }

  function startV483(){
    refreshButtonV483();

    clearInterval(v483Timer);
    v483Timer=null;

    // V602: una carga inicial. Después, V170/cambios de operación disparan la
    // actualización dirigida; foco/visibilidad ya no consultan Supabase.
    setTimeout(()=>{if(!document.hidden)refreshV483();},2500);

    if(!window.__v483Hooks){
      window.addEventListener('focus',refreshButtonV483,{passive:true});
      window.addEventListener('online',refreshButtonV483,{passive:true});
      document.addEventListener('visibilitychange',()=>{
        if(!document.hidden)refreshButtonV483();
      });
      window.__v483Hooks=true;
    }

    // V483 toma el control del botón de activación.
    window.toggleDesktopNotificationsV467=enableV483;
  }

  window.enablePersistentReassignmentNotificationsV483=enableV483;
  window.refreshPersistentReassignmentNotificationsV483=refreshV483;

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',startV483,{once:true});
  }else{
    startV483();
  }
})();
</script>


<script id="v484-native-only-helper">
(function(){
  'use strict';

  function nativeOnlyActiveV484(){
    try{
      return (
        'Notification' in window &&
        Notification.permission==='granted' &&
        localStorage.getItem('v467_desktop_notifications_enabled')==='1'
      );
    }catch(_){
      return false;
    }
  }

  window.nativeOnlyActiveV484=nativeOnlyActiveV484;
})();
</script>


<script id="v484-native-status">
(function(){
  'use strict';

  function refreshNativeStatusV484(){
    const btn=document.getElementById('desktopNotifyBtnV467');
    if(!btn)return;

    try{
      if(!('Notification' in window)){
        btn.title='Notificaciones nativas no disponibles en este navegador.';
        return;
      }

      if(Notification.permission==='denied'){
        btn.title='Notificaciones bloqueadas por Chrome/Edge. Debe habilitarlas para este sitio.';
        return;
      }

      if(Notification.permission==='granted' &&
         localStorage.getItem('v467_desktop_notifications_enabled')==='1'){
        btn.title='Avisos nativos de Windows activos. Las solicitudes pendientes se vuelven a avisar mientras continúen sin atender.';
        return;
      }

      btn.title='Pulse para habilitar notificaciones nativas de Windows/Chrome/Edge.';
    }catch(_){}
  }

  setInterval(refreshNativeStatusV484,2500);
  setTimeout(refreshNativeStatusV484,800);
})();
</script>


<script id="v485-suppress-blue-reassignment-toast">
(function(){
  'use strict';

  /* ============================================================
     V485 · SUPRIMIR DEFINITIVAMENTE EL TOAST AZUL HISTÓRICO
     ============================================================
     Varias capas antiguas (V362/V467/V482) pueden llamar showToast().
     Esta capa final intercepta únicamente los avisos informativos de:
       - nueva solicitud recibida;
       - nueva solicitud de reasignación;
       - nuevas reasignaciones;
       - expediente reasignado recibido.
     Los mensajes de error, confirmaciones manuales y demás toast del
     sistema continúan funcionando normalmente.
     ============================================================ */

  function normV485(value){
    return String(value??'')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .trim()
      .toUpperCase();
  }

  function isReassignmentNotificationToastV485(message){
    const s=normV485(message)
      .replace(/^🔔\s*/,'')
      .replace(/^✅\s*/,'')
      .trim();

    if(!s)return false;

    return (
      s==='NUEVA SOLICITUD RECIBIDA' ||
      s==='NUEVAS SOLICITUDES RECIBIDAS' ||
      s.startsWith('NUEVA SOLICITUD DE REASIGNACION') ||
      s.includes('SOLICITUDES DE REASIGNACION RECIBIDAS') ||
      s.startsWith('TIENE UNA NUEVA REASIGNACION') ||
      /^TIENE \d+ NUEVAS REASIGNACIONES/.test(s) ||
      /^NUEVA ALERTA DE REASIGNACION/.test(s) ||
      /^\d+ SOLICITUD\(ES\) Y \d+ REASIGNACION\(ES\) NUEVA\(S\)/.test(s) ||
      /^TIENE UN EXPEDIENTE REASIGNADO/.test(s) ||
      /^TIENE \d+ EXPEDIENTES REASIGNADOS/.test(s)
    );
  }

  function hideLegacyToastV485(){
    const toast=document.getElementById('toast');
    if(!toast)return;

    if(isReassignmentNotificationToastV485(toast.textContent||'')){
      toast.classList.remove('show');
      toast.style.display='none';

      // Restaurar display después para que otros toast del sistema
      // (errores, confirmaciones, etc.) sigan funcionando.
      setTimeout(()=>{
        if(toast && !toast.classList.contains('show')){
          toast.style.display='';
          toast.textContent='';
        }
      },80);
    }
  }

  function installShowToastGuardV485(){
    if(typeof window.showToast!=='function')return false;
    if(window.showToast.__v485Guarded)return true;

    const original=window.showToast;

    function guardedToastV485(message,duration){
      if(isReassignmentNotificationToastV485(message)){
        const toast=document.getElementById('toast');
        if(toast){
          toast.classList.remove('show');
          toast.style.display='none';
          toast.textContent='';
          setTimeout(()=>{ if(toast)toast.style.display=''; },80);
        }
        return;
      }

      return original.apply(this,arguments);
    }

    guardedToastV485.__v485Guarded=true;
    guardedToastV485.__v485Original=original;
    window.showToast=guardedToastV485;

    // "showToast" fue declarada globalmente como función; reasignar también
    // la referencia léxica cuando el navegador la expone por window.
    try{ showToast=guardedToastV485; }catch(_){}

    return true;
  }

  function installToastObserverV485(){
    const toast=document.getElementById('toast');
    if(!toast || toast.__v485Observed)return;

    const observer=new MutationObserver(()=>{
      hideLegacyToastV485();
    });

    observer.observe(toast,{
      subtree:true,
      childList:true,
      characterData:true,
      attributes:true,
      attributeFilter:['class','style']
    });

    toast.__v485Observed=true;
  }

  function hideLegacyRequestCardsV485(){
    try{
      if(
        typeof window.nativeOnlyActiveV484==='function' &&
        window.nativeOnlyActiveV484()
      ){
        const legacy=document.getElementById('v362RequestAlertStack');
        if(legacy){
          legacy.innerHTML='';
          legacy.classList.add('hidden');
        }

        const v482=document.getElementById('v482ReassignCornerStack');
        if(v482){
          v482.innerHTML='';
          v482.classList.add('v482-hidden');
        }
      }
    }catch(_){}
  }

  function installV485(){
    installShowToastGuardV485();
    installToastObserverV485();
    hideLegacyToastV485();
    hideLegacyRequestCardsV485();

    // Algunas capas antiguas terminan de instalarse después del DOMContentLoaded.
    // Reintentar para que la última definición activa de showToast quede protegida.
    [250,700,1500,3000].forEach(ms=>{
      setTimeout(()=>{
        installShowToastGuardV485();
        installToastObserverV485();
        hideLegacyToastV485();
        hideLegacyRequestCardsV485();
      },ms);
    });

    setInterval(()=>{
      hideLegacyToastV485();
      hideLegacyRequestCardsV485();
    },1000);
  }

  window.isReassignmentNotificationToastV485=isReassignmentNotificationToastV485;

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',installV485,{once:true});
  }else{
    installV485();
  }
})();
</script>


<script id="v486-request-responsive-subject-script">
(function(){
  'use strict';

  let subjectObserverV486=null;
  let modalObserverV486=null;

  function qV486(id){
    return document.getElementById(id);
  }

  function normalizeV486(value){
    return String(value??'')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .toUpperCase()
      .trim();
  }

  function nativeSubjectV486(){
    return qV486('rqAsunto');
  }

  function pickerV486(){
    return qV486('rqAsuntoPickerV486');
  }

  function dropdownV486(){
    return qV486('rqAsuntoDropdownV486');
  }

  function subjectItemsV486(){
    const field=nativeSubjectV486();
    if(!field)return [];

    return [...field.options]
      .filter(o=>String(o.value||'').trim())
      .map(o=>({
        value:String(o.value||'').trim(),
        label:String(o.textContent||o.value||'').trim()
      }));
  }

  function syncSubjectTriggerV486(){
    const field=nativeSubjectV486();
    const trigger=qV486('rqAsuntoTriggerV486');
    const label=qV486('rqAsuntoTriggerTextV486');

    if(!field||!trigger||!label)return;

    const current=String(field.value||'').trim();
    const selected=[...field.options].find(o=>o.value===current);

    label.textContent=current
      ?String(selected?.textContent||current)
      :'— SELECCIONE ASUNTO —';

    trigger.disabled=!!field.disabled;
    trigger.setAttribute('aria-disabled',field.disabled?'true':'false');

    if(field.disabled){
      closeSubjectPickerV486();
    }

    renderSubjectOptionsV486(
      qV486('rqAsuntoSearchV486')?.value||''
    );
  }

  function renderSubjectOptionsV486(search=''){
    const list=qV486('rqAsuntoListV486');
    const count=qV486('rqAsuntoCountV486');
    const field=nativeSubjectV486();
    if(!list||!field)return;

    const query=normalizeV486(search);
    const current=String(field.value||'').trim();

    const items=subjectItemsV486().filter(item=>
      !query || normalizeV486(item.label).includes(query)
    );

    if(count){
      count.textContent=query
        ?`${items.length} coincidencia${items.length===1?'':'s'}`
        :`${items.length} asunto${items.length===1?'':'s'}`;
    }

    if(!items.length){
      list.innerHTML=
        '<div class="v486-subject-empty">No se encontraron asuntos con ese texto.</div>';
      return;
    }

    list.innerHTML=items.map(item=>{
      const selected=item.value===current;
      const safe=String(item.value)
        .replace(/&/g,'&amp;')
        .replace(/</g,'&lt;')
        .replace(/>/g,'&gt;')
        .replace(/"/g,'&quot;');

      const safeLabel=String(item.label)
        .replace(/&/g,'&amp;')
        .replace(/</g,'&lt;')
        .replace(/>/g,'&gt;')
        .replace(/"/g,'&quot;');

      return `<button
        type="button"
        class="v486-subject-option${selected?' is-selected':''}"
        data-value="${safe}"
        title="${safeLabel}"
      >${safeLabel}</button>`;
    }).join('');

    list.querySelectorAll('.v486-subject-option').forEach(btn=>{
      btn.addEventListener('click',()=>{
        chooseSubjectV486(btn.dataset.value||'');
      });
    });
  }

  function openSubjectPickerV486(){
    const field=nativeSubjectV486();
    const drop=dropdownV486();
    const trigger=qV486('rqAsuntoTriggerV486');
    const search=qV486('rqAsuntoSearchV486');

    if(!field||!drop||!trigger||field.disabled)return;

    // Si el catálogo fue vaciado al cerrar el modal, reconstruirlo.
    if(field.options.length<=1 && typeof window.renderRequestAsuntoSelect==='function'){
      try{window.renderRequestAsuntoSelect(field.value||'');}catch(_){}
    }

    drop.hidden=false;
    trigger.setAttribute('aria-expanded','true');

    if(search){
      search.value='';
      renderSubjectOptionsV486('');
      requestAnimationFrame(()=>{
        search.focus();
        search.select();
      });
    }
  }

  function closeSubjectPickerV486(){
    const drop=dropdownV486();
    const trigger=qV486('rqAsuntoTriggerV486');

    if(drop)drop.hidden=true;
    if(trigger)trigger.setAttribute('aria-expanded','false');
  }

  function toggleSubjectPickerV486(){
    const drop=dropdownV486();
    if(!drop)return;
    if(drop.hidden)openSubjectPickerV486();
    else closeSubjectPickerV486();
  }

  function chooseSubjectV486(value){
    const field=nativeSubjectV486();
    if(!field||field.disabled)return;

    const exists=[...field.options].some(o=>o.value===value);
    if(!exists)return;

    field.value=value;
    field.dispatchEvent(new Event('input',{bubbles:true}));
    field.dispatchEvent(new Event('change',{bubbles:true}));

    syncSubjectTriggerV486();
    closeSubjectPickerV486();
    qV486('rqAsuntoTriggerV486')?.focus();
  }

  function buildSubjectPickerV486(){
    const field=nativeSubjectV486();
    if(!field || pickerV486())return;

    field.classList.add('v486-native-subject-select');

    const wrap=document.createElement('div');
    wrap.id='rqAsuntoPickerV486';
    wrap.innerHTML=`
      <button
        type="button"
        id="rqAsuntoTriggerV486"
        aria-haspopup="listbox"
        aria-expanded="false"
      >
        <span id="rqAsuntoTriggerTextV486">— SELECCIONE ASUNTO —</span>
        <span id="rqAsuntoTriggerArrowV486" aria-hidden="true">▼</span>
      </button>

      <div id="rqAsuntoDropdownV486" hidden>
        <div class="v486-subject-search-bar">
          <input
            id="rqAsuntoSearchV486"
            type="search"
            autocomplete="off"
            placeholder="Buscar asunto..."
            aria-label="Buscar asunto"
          >
          <div class="v486-subject-meta">
            <span>Escriba una palabra para filtrar</span>
            <span id="rqAsuntoCountV486"></span>
          </div>
        </div>
        <div id="rqAsuntoListV486" role="listbox"></div>
      </div>
    `;

    field.insertAdjacentElement('afterend',wrap);

    qV486('rqAsuntoTriggerV486')?.addEventListener('click',toggleSubjectPickerV486);

    qV486('rqAsuntoSearchV486')?.addEventListener('input',event=>{
      renderSubjectOptionsV486(event.target.value||'');
    });

    qV486('rqAsuntoSearchV486')?.addEventListener('keydown',event=>{
      if(event.key==='Escape'){
        event.preventDefault();
        closeSubjectPickerV486();
        qV486('rqAsuntoTriggerV486')?.focus();
      }else if(event.key==='Enter'){
        const first=qV486('rqAsuntoListV486')
          ?.querySelector('.v486-subject-option');
        if(first){
          event.preventDefault();
          first.click();
        }
      }
    });

    document.addEventListener('pointerdown',event=>{
      const picker=pickerV486();
      if(picker && !picker.contains(event.target)){
        closeSubjectPickerV486();
      }
    },true);

    subjectObserverV486=new MutationObserver(()=>{
      syncSubjectTriggerV486();
    });

    subjectObserverV486.observe(field,{
      childList:true,
      subtree:true,
      attributes:true,
      attributeFilter:['disabled']
    });

    field.addEventListener('change',syncSubjectTriggerV486);

    syncSubjectTriggerV486();
  }

  function syncModalStateV486(){
    const modal=qV486('newRequestModal');
    if(!modal)return;

    const open=modal.classList.contains('show');
    document.body.classList.toggle('v486-request-open',open);

    if(open){
      buildSubjectPickerV486();

      // Cada apertura inicia desde arriba y recalcula el selector.
      const box=modal.querySelector('.modal-box');
      if(box && box.scrollTop<4)box.scrollTop=0;

      setTimeout(syncSubjectTriggerV486,0);
    }else{
      closeSubjectPickerV486();
    }
  }

  function installModalObserverV486(){
    const modal=qV486('newRequestModal');
    if(!modal)return;

    modalObserverV486=new MutationObserver(syncModalStateV486);
    modalObserverV486.observe(modal,{
      attributes:true,
      attributeFilter:['class']
    });

    syncModalStateV486();
  }

  function installCompatibilityV486(){
    /* Las funciones históricas continúan existiendo, pero ahora dirigen
       el foco al selector propio en vez de abrir el SELECT nativo. */
    const focusFn=()=>{
      if(!nativeSubjectV486()?.disabled){
        qV486('rqAsuntoTriggerV486')?.focus();
      }
    };

    const openFn=()=>{
      openSubjectPickerV486();
    };

    try{window.focusRequestAsuntoPicker=focusFn;}catch(_){}
    try{focusRequestAsuntoPicker=focusFn;}catch(_){}

    try{window.openRequestAsuntoPicker=openFn;}catch(_){}
    try{openRequestAsuntoPicker=openFn;}catch(_){}

    try{window.toggleRequestAsuntoPicker=toggleSubjectPickerV486;}catch(_){}
    try{toggleRequestAsuntoPicker=toggleSubjectPickerV486;}catch(_){}
  }

  function initV486(){
    buildSubjectPickerV486();
    installModalObserverV486();
    installCompatibilityV486();

    window.addEventListener('resize',()=>{
      // En cambios de media pantalla, cerrar el desplegable para que
      // vuelva a calcular su posición al abrirse.
      closeSubjectPickerV486();
    },{passive:true});
  }

  window.openSubjectPickerV486=openSubjectPickerV486;
  window.closeSubjectPickerV486=closeSubjectPickerV486;
  window.syncSubjectTriggerV486=syncSubjectTriggerV486;

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',initV486,{once:true});
  }else{
    initV486();
  }
})();
</script>


<style id="v487-subject-compact-final">
/* ============================================================
   V487 · ASUNTOS COMPACTOS
   - Se elimina visualmente el SELECT nativo duplicado.
   - El selector visible mantiene el ancho exacto del campo.
   - Máximo 6-7 asuntos visibles; luego scroll.
   - Cada asunto ocupa una sola línea con puntos suspensivos.
   ============================================================ */

#newRequestModal #rqAsunto{
  display:none!important;
  visibility:hidden!important;
  position:absolute!important;
  left:-99999px!important;
  width:1px!important;
  height:1px!important;
  min-width:1px!important;
  min-height:1px!important;
  max-width:1px!important;
  max-height:1px!important;
  margin:0!important;
  padding:0!important;
  border:0!important;
  opacity:0!important;
  pointer-events:none!important;
}

/* El contenedor del selector propio no puede crecer fuera de su campo. */
#newRequestModal #rqAsuntoPickerV486{
  position:relative!important;
  display:block!important;
  width:100%!important;
  max-width:100%!important;
  min-width:0!important;
  box-sizing:border-box!important;
}

/* Selector cerrado */
#newRequestModal #rqAsuntoTriggerV486{
  width:100%!important;
  max-width:100%!important;
  min-width:0!important;
  height:38px!important;
  min-height:38px!important;
  padding:6px 10px!important;
  margin:0!important;
  box-sizing:border-box!important;
  border:1px solid #b9ccdf!important;
  border-radius:7px!important;
  background:#fff!important;
  color:#16395f!important;
  font:inherit!important;
  font-size:13px!important;
  font-weight:500!important;
  line-height:1.1!important;
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
  gap:8px!important;
  text-align:left!important;
  box-shadow:none!important;
}

#newRequestModal #rqAsuntoTriggerTextV486{
  display:block!important;
  flex:1 1 auto!important;
  min-width:0!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
  white-space:nowrap!important;
}

#newRequestModal #rqAsuntoTriggerArrowV486{
  flex:0 0 auto!important;
  font-size:10px!important;
  color:#57718a!important;
}

/* Caja desplegable */
#newRequestModal #rqAsuntoDropdownV486{
  position:absolute!important;
  top:calc(100% + 4px)!important;
  left:0!important;
  right:0!important;
  width:100%!important;
  min-width:0!important;
  max-width:100%!important;
  margin:0!important;
  padding:0!important;
  box-sizing:border-box!important;
  z-index:2147483200!important;
  overflow:hidden!important;
  border:1px solid #9fb8d1!important;
  border-radius:9px!important;
  background:#fff!important;
  box-shadow:0 12px 28px rgba(13,45,77,.22)!important;
}

/* Buscador compacto */
#newRequestModal #rqAsuntoDropdownV486 .v486-subject-search-bar{
  padding:6px!important;
  margin:0!important;
  background:#f5f8fb!important;
  border-bottom:1px solid #dbe5ef!important;
}

#newRequestModal #rqAsuntoSearchV486{
  width:100%!important;
  height:34px!important;
  min-height:34px!important;
  padding:5px 9px!important;
  margin:0!important;
  box-sizing:border-box!important;
  border:1px solid #b8ccdf!important;
  border-radius:6px!important;
  background:#fff!important;
  font-size:12px!important;
}

#newRequestModal #rqAsuntoDropdownV486 .v486-subject-meta{
  display:flex!important;
  justify-content:space-between!important;
  gap:8px!important;
  padding:4px 2px 0!important;
  margin:0!important;
  color:#6d8298!important;
  font-size:9px!important;
  line-height:1.15!important;
}

/* 6-7 filas visibles */
#newRequestModal #rqAsuntoListV486{
  display:block!important;
  width:100%!important;
  max-width:100%!important;
  max-height:220px!important;
  overflow-y:auto!important;
  overflow-x:hidden!important;
  padding:3px!important;
  margin:0!important;
  box-sizing:border-box!important;
  overscroll-behavior:contain!important;
}

/* Una sola línea por asunto */
#newRequestModal #rqAsuntoListV486 .v486-subject-option{
  appearance:none!important;
  -webkit-appearance:none!important;
  display:block!important;
  width:100%!important;
  max-width:100%!important;
  min-width:0!important;
  height:30px!important;
  min-height:30px!important;
  margin:0 0 2px!important;
  padding:5px 8px!important;
  box-sizing:border-box!important;
  border:1px solid transparent!important;
  border-radius:5px!important;
  background:#fff!important;
  color:#17395e!important;
  font-family:inherit!important;
  font-size:11px!important;
  font-weight:500!important;
  line-height:18px!important;
  text-align:left!important;
  text-transform:none!important;
  white-space:nowrap!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
  box-shadow:none!important;
  cursor:pointer!important;
}

#newRequestModal #rqAsuntoListV486 .v486-subject-option:hover,
#newRequestModal #rqAsuntoListV486 .v486-subject-option:focus-visible{
  background:#edf5fd!important;
  border-color:#bdd4e9!important;
