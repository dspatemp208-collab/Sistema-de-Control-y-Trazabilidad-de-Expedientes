<style id="v510-hide-legacy-floating-notifications">
/* ============================================================
   V510 · ELIMINACIÓN DEFINITIVA DE AVISOS INTERNOS FANTASMA
   V362/V482 son capas heredadas. Desde V485 la interfaz utiliza
   Centro de alertas + notificación nativa de Windows.
   ============================================================ */
#v362RequestAlertStack,
#v482ReassignCornerStack{
  display:none!important;
  visibility:hidden!important;
  opacity:0!important;
  pointer-events:none!important;
  width:0!important;
  height:0!important;
  max-width:0!important;
  max-height:0!important;
  min-width:0!important;
  min-height:0!important;
  overflow:hidden!important;
  padding:0!important;
  margin:0!important;
  border:0!important;
}
#v362RequestAlertStack *,
#v482ReassignCornerStack *{
  display:none!important;
  visibility:hidden!important;
}
</style>
<script id="v510-purge-legacy-floating-notifications">
(function(){
  'use strict';

  function purgeLegacyFloatingV510(){
    ['v362RequestAlertStack','v482ReassignCornerStack'].forEach(id=>{
      const node=document.getElementById(id);
      if(!node)return;
      if(node.childNodes.length) node.replaceChildren();
      node.setAttribute('hidden','');
      node.setAttribute('aria-hidden','true');
      node.style.setProperty('display','none','important');
      node.style.setProperty('visibility','hidden','important');
    });
  }

  function installLegacyGuardV510(){
    purgeLegacyFloatingV510();
    ['v362RequestAlertStack','v482ReassignCornerStack'].forEach(id=>{
      const node=document.getElementById(id);
      if(!node || node.__v510GhostGuard)return;
      const observer=new MutationObserver(()=>{
        if(node.childNodes.length) node.replaceChildren();
        if(!node.hasAttribute('hidden')) node.setAttribute('hidden','');
        node.style.setProperty('display','none','important');
      });
      observer.observe(node,{childList:true,subtree:true,attributes:true,attributeFilter:['class','style','hidden']});
      node.__v510GhostGuard=true;
    });
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',installLegacyGuardV510,{once:true});
  }else{
    installLegacyGuardV510();
  }

  // Las capas antiguas pueden intentar repintarse después de consultas asíncronas.
  [250,700,1500,3000].forEach(ms=>setTimeout(installLegacyGuardV510,ms));
  setInterval(purgeLegacyFloatingV510,5000);
})();
</script>


