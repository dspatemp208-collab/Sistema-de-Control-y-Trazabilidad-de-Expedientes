<script id="v604-request-mail-recovery">
(function(){
  'use strict';

  let done=false;
  let tries=0;
  let timer=null;

  async function recoverPendingMail(source){
    if(done)return false;
    tries+=1;

    try{
      const hasSession=!!(window.session?.user?.id);
      const drain=window.v558ProcesarNotificacionesExternas;

      if(hasSession && typeof drain==='function'){
        const result=await drain(true);
        done=true;
        if(timer){clearInterval(timer);timer=null;}
        try{
          console.info('V604 · recuperación de cola de correo ejecutada',source||'inicio',result||{});
        }catch(_){ }
        return true;
      }
    }catch(error){
      try{console.warn('V604 · recuperación de correo pendiente:',error?.message||error);}catch(_){ }
    }

    if(tries>=15 && timer){
      clearInterval(timer);
      timer=null;
    }
    return false;
  }

  function boot(){
    setTimeout(()=>recoverPendingMail('inicio-1'),1200);
    setTimeout(()=>recoverPendingMail('inicio-2'),4500);
    timer=setInterval(()=>recoverPendingMail('espera-sesion'),3000);

    window.addEventListener('online',()=>setTimeout(()=>recoverPendingMail('online'),500),{passive:true});
    window.addEventListener('focus',()=>setTimeout(()=>recoverPendingMail('focus'),350),{passive:true});
  }

  window.v604RecoverPendingMail=recoverPendingMail;

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',boot,{once:true});
  }else{
    boot();
  }

  try{
    console.info('V604 · correo de solicitudes: Supabase + autovínculo de usuario + recuperación de cola');
  }catch(_){ }
})();
</script>


