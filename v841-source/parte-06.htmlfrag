}

#newRequestModal #rqAsuntoListV486 .v486-subject-empty{
  padding:14px 8px!important;
  font-size:11px!important;
  color:#6f8396!important;
  text-align:center!important;
}

/* Media pantalla: todavía más contenido visible sin agrandar el modal. */
@media(max-width:1100px){
  #newRequestModal #rqAsuntoListV486{
    max-height:185px!important;
  }

  #newRequestModal #rqAsuntoTriggerV486{
    height:35px!important;
    min-height:35px!important;
    font-size:12px!important;
  }

  #newRequestModal #rqAsuntoListV486 .v486-subject-option{
    height:28px!important;
    min-height:28px!important;
    padding:4px 7px!important;
    font-size:10.5px!important;
    line-height:18px!important;
  }
}
</style>


<script id="v487-subject-compact-final-script">
(function(){
  'use strict';

  function applySubjectCompactV487(){
    const native=document.getElementById('rqAsunto');

    if(native){
      /* Forzar ocultamiento incluso si un estilo anterior intenta
         volver a mostrar el SELECT nativo. */
      native.style.setProperty('display','none','important');
      native.style.setProperty('visibility','hidden','important');
      native.style.setProperty('position','absolute','important');
      native.style.setProperty('left','-99999px','important');
      native.style.setProperty('width','1px','important');
      native.style.setProperty('height','1px','important');
      native.setAttribute('aria-hidden','true');
      native.tabIndex=-1;
    }

    const trigger=document.getElementById('rqAsuntoTriggerV486');
    const triggerText=document.getElementById('rqAsuntoTriggerTextV486');

    if(trigger && triggerText){
      const text=(triggerText.textContent||'').trim();
      trigger.title=text;
    }

    document
      .querySelectorAll('#rqAsuntoListV486 .v486-subject-option')
      .forEach(btn=>{
        const text=(btn.textContent||'').replace(/\s+/g,' ').trim();
        if(text){
          btn.title=text;
          /* El texto visible permanece en una sola línea; el nombre
             completo puede leerse al pasar el mouse. */
        }
      });
  }

  function initSubjectCompactV487(){
    applySubjectCompactV487();

    const modal=document.getElementById('newRequestModal');
    if(!modal)return;

    const observer=new MutationObserver(()=>{
      applySubjectCompactV487();
    });

    observer.observe(modal,{
      childList:true,
      subtree:true,
      attributes:true,
      attributeFilter:['class','style','disabled']
    });

    document.addEventListener('click',event=>{
      if(
        event.target.closest('#rqAsuntoTriggerV486') ||
        event.target.closest('#rqAsuntoDropdownV486')
      ){
        requestAnimationFrame(applySubjectCompactV487);
      }
    },true);
  }

  window.applySubjectCompactV487=applySubjectCompactV487;

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',initSubjectCompactV487,{once:true});
  }else{
    initSubjectCompactV487();
  }
})();
</script>

<style id="v488-digital-copies-style">
/* =========================================================
   V488 · COPIAS DIGITALES PENDIENTES
   ========================================================= */
#tab-requests .request-workflow-kpis{grid-template-columns:repeat(5,minmax(145px,1fr))}
#v488DigitalCard{position:relative;overflow:hidden}
#v488DigitalCard::before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:#0f766e}
#v488DigitalCard.selected{box-shadow:0 0 0 2px #0f766e inset}
#v488DigitalCard .value{color:#0f5f59}
.v488-digital-workspace{margin-bottom:14px;overflow:hidden}
.v488-digital-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:13px 14px;border-bottom:1px solid var(--line);background:#f8fbfb}
.v488-digital-head strong{color:var(--navy);font-size:14px}
.v488-digital-head>span{font-size:12px;color:var(--muted);white-space:nowrap}
.v488-digital-filters{display:grid;grid-template-columns:minmax(240px,1.4fr) minmax(180px,.85fr) minmax(145px,.65fr) minmax(135px,.65fr) minmax(135px,.65fr) auto;gap:9px;align-items:end;padding:12px 14px;border-bottom:1px solid var(--line);background:#fbfdfe}
.v488-digital-filter-actions{display:flex;align-items:flex-end}
.v488-digital-table{overflow:auto;max-height:56vh}
.v488-digital-table table{min-width:1120px}
.v488-digital-status{display:inline-flex;align-items:center;padding:4px 8px;border-radius:999px;font-size:10px;font-weight:850;white-space:nowrap}
.v488-digital-status.pending{background:#fff4cc;color:#6d5100}
.v488-digital-status.delivered{background:#e6f5ea;color:#21613a}
.v488-digital-status.closed{background:#eef2f7;color:#475569}
.v488-digital-link{max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.v488-digital-modal-box{max-width:760px}
.v488-digital-modal-summary{display:grid;grid-template-columns:repeat(4,minmax(130px,1fr));gap:8px}
.v488-digital-modal-summary>div{border:1px solid var(--line);border-radius:9px;padding:9px 10px;background:#f8fafc}
.v488-digital-modal-summary span{display:block;font-size:9px;font-weight:800;text-transform:uppercase;color:var(--muted);margin-bottom:3px}
.v488-digital-modal-summary b{display:block;color:var(--navy);font-size:12px;overflow-wrap:anywhere}
.v488-digital-modal-actions{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;margin-top:14px;padding-top:12px;border-top:1px solid var(--line)}
.v488-request-digital-list{display:grid;gap:8px;margin-top:8px}
.v488-request-digital-row{display:grid;grid-template-columns:minmax(160px,.8fr) minmax(120px,.55fr) minmax(130px,.6fr) minmax(170px,1fr) auto;gap:8px;align-items:center;padding:9px 10px;border:1px solid var(--line);border-radius:9px;background:#fff}
.v488-request-digital-row .v488-small{font-size:10px;color:var(--muted)}
#requestDetailModal.v488-digital-request .request-location-section{display:none!important}
#requestDetailModal.v488-digital-request .request-quick-intro{display:none!important}
#requestDetailModal.v488-digital-request #rqAttentionSection,
#requestDetailModal.v488-digital-request #rqMovementSection,
#requestDetailModal.v488-digital-request #rqObservationSection{display:none!important}
@media(max-width:1250px){#tab-requests .request-workflow-kpis{grid-template-columns:repeat(3,1fr)}.v488-digital-filters{grid-template-columns:repeat(3,1fr)}}
@media(max-width:800px){#tab-requests .request-workflow-kpis{grid-template-columns:repeat(2,1fr)}.v488-digital-filters{grid-template-columns:1fr 1fr}.v488-digital-modal-summary{grid-template-columns:1fr 1fr}.v488-request-digital-row{grid-template-columns:1fr 1fr}}
@media(max-width:520px){#tab-requests .request-workflow-kpis,.v488-digital-filters,.v488-digital-modal-summary,.v488-request-digital-row{grid-template-columns:1fr}}
</style>
<script id="v488-digital-copies-script">
(function(){
  'use strict';

  let digitalModeV488=false;
  let digitalRowsV488=[];
  let digitalLoadedAtV488=0;
  let digitalEditingV488=null;
  let digitalDetailRowsV488=[];

  const $=id=>document.getElementById(id);
  const upper=v=>String(v??'').trim().toUpperCase();
  const clean=v=>String(v??'').trim();
  const jsEsc=v=>String(v??'').split('\\').join('\\\\').split("'").join("\\'");
  const htmlEsc=v=>typeof esc==='function'?esc(v):String(v??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

  function isFullV488(){
    try{return typeof hasFullAccess==='function' && hasFullAccess() && !(typeof isCoordinator==='function'&&isCoordinator());}
    catch(_){return false;}
  }

  function isDigitalRequestV488(request=currentRequest){
    const rows=Array.isArray(requestDetailRows)?requestDetailRows:[];
    if(rows.length){
      const modes=rows.map(r=>upper(
        r?.modalidad_atencion||
        r?.modalidad_actual||
        request?.modalidad||
        'PRÉSTAMO'
      ));
      if(modes.every(m=>m==='COPIA DIGITAL'))return true;
      if(modes.some(m=>m && m!=='COPIA DIGITAL'))return false;
    }
    return upper(request?.modalidad)==='COPIA DIGITAL';
  }

  function requestDateV488(row){
    const raw=row?.fecha_solicitud||row?.created_at||'';
    if(!raw)return '—';
    try{
      if(typeof masterDateTimeHtml==='function')return masterDateTimeHtml(raw);
      if(typeof fmtDate==='function')return fmtDate(raw);
    }catch(_){ }
    return htmlEsc(raw);
  }

  function localDateKeyV488(value){
    if(!value)return '';
    const d=new Date(value);
    if(Number.isNaN(d.getTime()))return String(value).slice(0,10);
    const y=d.getFullYear();
    const m=String(d.getMonth()+1).padStart(2,'0');
    const day=String(d.getDate()).padStart(2,'0');
    return `${y}-${m}-${day}`;
  }

  function safeUrlV488(value){
    const raw=clean(value);
    if(!/^https?:\/\//i.test(raw))return '';
    try{
      const u=new URL(raw);
      return ['http:','https:'].includes(u.protocol)?u.href:'';
    }catch(_){return '';}
  }

  function statusV488(row){
    const state=upper(row?.estado_copia);
    if(state==='ENTREGADA')return '<span class="v488-digital-status delivered">ENTREGADA</span>';
    if(state==='CERRADA')return '<span class="v488-digital-status closed">CERRADA</span>';
    return '<span class="v488-digital-status pending">PENDIENTE</span>';
  }

  function annotateRequestRowsV488(){
    const groups=new Map();
    digitalRowsV488.forEach(row=>{
      const key=String(row.solicitud_id||'');
      if(!key)return;
      const g=groups.get(key)||{total:0,delivered:0,pending:0};
      g.total++;
      if(upper(row.estado_copia)==='ENTREGADA')g.delivered++;
      if(upper(row.estado_copia)==='PENDIENTE')g.pending++;
      groups.set(key,g);
    });

    const apply=list=>{
      if(!Array.isArray(list))return;
      list.forEach(r=>{
        if(upper(r?.modalidad)!=='COPIA DIGITAL')return;
        const g=groups.get(String(r.id||r.solicitud_id||''));
        if(!g)return;
        r.total_expedientes=g.total;
        r.atendidos=g.delivered;
        r._v488_copias_pendientes=g.pending;
      });
    };
    try{apply(typeof requestRows!=='undefined'?requestRows:[]);}catch(_){ }
    try{apply(typeof requestViewCache!=='undefined'?requestViewCache?.rows:[]);}catch(_){ }
  }

  function updateDigitalCardV488(){
    if(!isFullV488())return;
    const pending=digitalRowsV488.filter(r=>upper(r.estado_copia)==='PENDIENTE');
    const requests=new Set(pending.map(r=>String(r.solicitud_id||'')).filter(Boolean));
    if($('v488DigitalPendingCount'))$('v488DigitalPendingCount').textContent=String(pending.length);
    if($('v488DigitalRequestCount'))$('v488DigitalRequestCount').textContent=`${requests.size} solicitud${requests.size===1?'':'es'}`;
    if($('v488DigitalItemCount'))$('v488DigitalItemCount').textContent=`${pending.length} copia${pending.length===1?'':'s'}`;
  }

  function populateDigitalRequestersV488(){
    const select=$('v488DigitalRequester');
    if(!select)return;
    const previous=select.value;
    const values=[...new Set(digitalRowsV488.map(r=>clean(r.solicitante)).filter(Boolean))]
      .sort((a,b)=>a.localeCompare(b,'es',{sensitivity:'base'}));
    select.innerHTML='<option value="">TODOS</option>'+values.map(v=>`<option value="${htmlEsc(v)}">${htmlEsc(v)}</option>`).join('');
    if(values.some(v=>v===previous))select.value=previous;
  }

  async function loadDigitalCopiesV488(force=false){
    if(!isFullV488() || typeof sb==='undefined' || !sb || typeof session==='undefined' || !session)return [];
    if(!force && digitalRowsV488.length && Date.now()-digitalLoadedAtV488<12000)return digitalRowsV488;
    const {data,error}=await sb.rpc('v488_listar_copias_digitales');
    if(error){
      const box=$('v488DigitalTable');
      if(box)box.innerHTML=`<div class="empty"><b>No se pudo cargar Copias digitales.</b><br>${htmlEsc(error.message)}<br><small>Ejecute primero el SQL V488 en Supabase.</small></div>`;
      console.warn('V488 · copias digitales:',error.message);
      return [];
    }
    digitalRowsV488=Array.isArray(data)?data:[];
    digitalLoadedAtV488=Date.now();
    annotateRequestRowsV488();
    updateDigitalCardV488();
    populateDigitalRequestersV488();
    return digitalRowsV488;
  }

  function filteredDigitalRowsV488(){
    const q=upper($('v488DigitalSearch')?.value||'');
    const requester=clean($('v488DigitalRequester')?.value||'');
    const state=upper($('v488DigitalState')?.value||'');
    const from=$('v488DigitalFrom')?.value||'';
    const to=$('v488DigitalTo')?.value||'';

    return digitalRowsV488.filter(row=>{
      if(requester && clean(row.solicitante)!==requester)return false;
      if(state && upper(row.estado_copia)!==state)return false;
      const dk=localDateKeyV488(row.fecha_solicitud);
      if(from && dk && dk<from)return false;
      if(to && dk && dk>to)return false;
      if(q){
        const hay=[row.expediente,row.extension,row.solicitud_numero,row.solicitante,row.asunto,row.atendido_por]
          .map(upper).join(' | ');
        if(!hay.includes(q))return false;
      }
      return true;
    }).sort((a,b)=>{
      const pa=upper(a.estado_copia)==='PENDIENTE'?0:1;
      const pb=upper(b.estado_copia)==='PENDIENTE'?0:1;
      if(pa!==pb)return pa-pb;
      return new Date(b.fecha_solicitud||0)-new Date(a.fecha_solicitud||0);
    });
  }

  window.renderDigitalCopiesV488=function(){
    const box=$('v488DigitalTable');
    if(!box)return;
    const rows=filteredDigitalRowsV488();
    if($('v488DigitalVisibleCount'))$('v488DigitalVisibleCount').textContent=`${rows.length} registro${rows.length===1?'':'s'}`;
    if(!rows.length){
      box.innerHTML='<div class="empty">No hay copias digitales para los filtros seleccionados.</div>';
      return;
    }
    box.innerHTML=`<table>
      <thead><tr>
        <th>Expediente</th><th>Extensión</th><th>Solicitud</th><th>Solicitante</th><th class="subject-cell-v639">Asunto</th>
        <th>Fecha / hora solicitud</th><th>Estado</th><th>Enlace</th><th>Atendido por</th><th></th>
      </tr></thead>
      <tbody>${rows.map(r=>{
        const delivered=upper(r.estado_copia)==='ENTREGADA';
        const pending=upper(r.estado_copia)==='PENDIENTE';
        const url=safeUrlV488(r.enlace);
        return `<tr>
          <td><b>${htmlEsc(r.expediente||'—')}</b></td>
          <td>${htmlEsc(r.extension||'—')}</td>
          <td><b>${htmlEsc(r.solicitud_numero||'—')}</b></td>
          <td>${htmlEsc(r.solicitante||'—')}</td>
          <td class="subject-cell-v639" title="${htmlEsc(r.asunto||'')}"><div class="subject-text-v639">${htmlEsc(r.asunto||'—')}</div></td>
          <td>${requestDateV488(r)}</td>
          <td>${statusV488(r)}</td>
          <td class="v488-digital-link">${url?`<button class="btn secondary small" onclick="openDigitalCopyLinkV488('${jsEsc(r.solicitud_id)}','${jsEsc(r.expediente_id)}')">Abrir copia</button>`:'—'}</td>
          <td>${delivered?`${htmlEsc(r.atendido_por||'—')}<div class="v488-small">${requestDateV488({fecha_solicitud:r.entregado_at})}</div>`:'—'}</td>
          <td><div style="display:flex;gap:6px;flex-wrap:wrap;white-space:nowrap">
            ${pending?`<button class="btn small" onclick="openDigitalCopyAttentionV488('${jsEsc(r.solicitud_id)}','${jsEsc(r.expediente_id)}')">Atender</button>`:''}
            <button class="btn secondary small" onclick="openRequestDetail('${jsEsc(r.solicitud_id)}')">Ver solicitud</button>
          </div></td>
        </tr>`;
      }).join('')}</tbody>
    </table>`;
  };

  window.clearDigitalCopyFiltersV488=function(){
    ['v488DigitalSearch','v488DigitalRequester','v488DigitalFrom','v488DigitalTo'].forEach(id=>{if($(id))$(id).value='';});
    if($('v488DigitalState'))$('v488DigitalState').value='PENDIENTE';
    renderDigitalCopiesV488();
  };

  function setDigitalModeV488(active){
    digitalModeV488=!!active;
    $('v488DigitalWorkspace')?.classList.toggle('hidden',!digitalModeV488);
    $('requestStandardFilters')?.classList.toggle('hidden',digitalModeV488);
    $('requestStandardTableCard')?.classList.toggle('hidden',digitalModeV488);
    $('v488DigitalCard')?.classList.toggle('selected',digitalModeV488);
    if(digitalModeV488){
      document.querySelectorAll('#fullRequestKpis [data-rq-state]').forEach(c=>c.classList.remove('selected'));
    }
  }

  window.openDigitalCopiesV488=async function(){
    if(!isFullV488())return;
    setDigitalModeV488(true);
    if($('v488DigitalState') && !$('v488DigitalState').value)$('v488DigitalState').value='PENDIENTE';
    if($('v488DigitalTable'))$('v488DigitalTable').innerHTML='<div class="empty">Cargando copias digitales...</div>';
    await loadDigitalCopiesV488(true);
    renderDigitalCopiesV488();
    $('v488DigitalWorkspace')?.scrollIntoView({behavior:'auto',block:'start'});
  };

  window.exitDigitalModeV488=function(){setDigitalModeV488(false);};

  window.openDigitalCopyLinkV488=function(solicitudId,expedienteId){
    const row=digitalRowsV488.find(r=>String(r.solicitud_id)===String(solicitudId)&&String(r.expediente_id)===String(expedienteId)) ||
      digitalDetailRowsV488.find(r=>String(r.solicitud_id)===String(solicitudId)&&String(r.expediente_id)===String(expedienteId));
    const url=safeUrlV488(row?.enlace);
    if(!url){alert('No se encontró un enlace válido para esta copia digital.');return;}
    window.open(url,'_blank','noopener,noreferrer');
  };

  window.openDigitalCopyAttentionV488=function(solicitudId,expedienteId){
    if(!isFullV488())return;
    const row=digitalRowsV488.find(r=>String(r.solicitud_id)===String(solicitudId)&&String(r.expediente_id)===String(expedienteId)) ||
      digitalDetailRowsV488.find(r=>String(r.solicitud_id)===String(solicitudId)&&String(r.expediente_id)===String(expedienteId));
    if(!row){alert('No se pudo identificar la copia digital seleccionada.');return;}
    digitalEditingV488={...row};
    $('v488DigitalModalExp').textContent=row.expediente||'—';
    $('v488DigitalModalReq').textContent=row.solicitud_numero||'—';
    $('v488DigitalModalRequester').textContent=row.solicitante||'—';
    $('v488DigitalModalDate').textContent=clean(row.fecha_solicitud)?new Date(row.fecha_solicitud).toLocaleString('es-PE'):'—';
    $('v488DigitalModalMeta').textContent=`${row.asunto||'Sin asunto'} · COPIA DIGITAL`;
    $('v488DigitalLink').value=row.enlace||'';
    $('v488DigitalObservation').value=row.observacion_entrega||'';
    $('v488DigitalModalStatus').textContent='';
    $('v488DigitalModal').classList.add('show');
    validateDigitalCopyLinkV488();
    setTimeout(()=>$('v488DigitalLink')?.focus(),0);
  };

  window.closeDigitalCopyModalV488=function(){
    $('v488DigitalModal')?.classList.remove('show');
    digitalEditingV488=null;
  };

  window.validateDigitalCopyLinkV488=function(){
    const url=safeUrlV488($('v488DigitalLink')?.value||'');
    if($('v488DeliverBtn'))$('v488DeliverBtn').disabled=!url;
    if($('v488OpenLinkBtn'))$('v488OpenLinkBtn').disabled=!url;
    return !!url;
  };

  window.openDigitalCopyDraftLinkV488=function(){
    const url=safeUrlV488($('v488DigitalLink')?.value||'');
    if(!url){$('v488DigitalModalStatus').textContent='Ingrese un enlace http:// o https:// válido.';return;}
    window.open(url,'_blank','noopener,noreferrer');
  };

  window.deliverDigitalCopyV488=async function(){
    if(!isFullV488() || !digitalEditingV488)return;
    const url=safeUrlV488($('v488DigitalLink')?.value||'');
    if(!url){$('v488DigitalModalStatus').textContent='Ingrese un enlace válido antes de entregar la copia.';return;}
    const who=clean(currentProfile?.nombre_personal||currentProfile?.email||session?.user?.email||'ARCHIVO');
    const obs=clean($('v488DigitalObservation')?.value||'');
    const btn=$('v488DeliverBtn');
    if(btn){btn.disabled=true;btn.textContent='Entregando...';}
    $('v488DigitalModalStatus').textContent='Registrando entrega y cerrando la copia digital...';
    try{
      const {data,error}=await sb.rpc('v488_entregar_copia_digital',{
        p_solicitud_id:digitalEditingV488.solicitud_id,
        p_expediente_id:digitalEditingV488.expediente_id,
        p_enlace:url,
        p_atendido_por:who,
        p_observacion:obs||null
      });
      if(error)throw error;
      closeDigitalCopyModalV488();
      digitalLoadedAtV488=0;
      if(typeof showToast==='function')showToast(`Copia digital de ${digitalEditingV488?.expediente||'expediente'} entregada y cerrada.`);
      if(typeof requestViewCache!=='undefined')requestViewCache=null;
      await loadDigitalCopiesV488(true);
      renderDigitalCopiesV488();
      try{if(typeof v488BaseLoadRequests==='function')await v488BaseLoadRequests();else if(typeof loadRequests==='function')await loadRequests();}catch(_){ }
      if(currentRequestId && String(currentRequestId)===String(data?.solicitud_id||digitalEditingV488?.solicitud_id||'')){
        await renderDigitalRequestDetailV488(currentRequestId,true);
      }
    }catch(error){
      $('v488DigitalModalStatus').textContent=error?.message||String(error);
    }finally{
      if(btn){btn.disabled=!safeUrlV488($('v488DigitalLink')?.value||'');btn.textContent='Entregar y cerrar';}
    }
  };

  window.renderDigitalRequestDetailV488=async function(requestId,force=false){
    const panel=$('v488DigitalRequestPanel');
    const box=$('v488DigitalRequestDetail');
    const modal=$('requestDetailModal');
    if(!panel||!box||!modal)return;
    if(!isDigitalRequestV488()){
      panel.classList.add('hidden');
      modal.classList.remove('v488-digital-request');
      digitalDetailRowsV488=[];
      return;
    }
    panel.classList.remove('hidden');
    modal.classList.add('v488-digital-request');
    box.innerHTML='<div class="empty">Cargando atención digital...</div>';
    const {data,error}=await sb.rpc('v488_detalle_copias_digitales',{p_solicitud_id:requestId});
    if(error){
      box.innerHTML=`<div class="empty">${htmlEsc(error.message)}<br><small>Si es la primera vez, ejecute el SQL V488 en Supabase.</small></div>`;
      return;
    }
    digitalDetailRowsV488=Array.isArray(data)?data:[];
    if(!digitalDetailRowsV488.length){
      box.innerHTML='<div class="empty">No se encontraron expedientes de copia digital en esta solicitud.</div>';
      return;
    }
    box.innerHTML=`<div class="v488-request-digital-list">${digitalDetailRowsV488.map(r=>{
      const pending=upper(r.estado_copia)==='PENDIENTE';
      const url=safeUrlV488(r.enlace);
      return `<div class="v488-request-digital-row">
        <div><b>${htmlEsc(r.expediente||'—')}</b><div class="v488-small">Extensión: ${htmlEsc(r.extension||'—')}</div></div>
        <div>${statusV488(r)}</div>
        <div><div class="v488-small">Atendido por</div><b>${htmlEsc(r.atendido_por||'—')}</b></div>
        <div>${url?`<button class="btn secondary small" onclick="openDigitalCopyLinkV488('${jsEsc(r.solicitud_id)}','${jsEsc(r.expediente_id)}')">Abrir copia digital</button>`:'<span class="v488-small">Enlace aún no entregado</span>'}</div>
        <div>${isFullV488()&&pending?`<button class="btn small" onclick="openDigitalCopyAttentionV488('${jsEsc(r.solicitud_id)}','${jsEsc(r.expediente_id)}')">Atender</button>`:''}</div>
      </div>`;
    }).join('')}</div>`;
  };

  // Copia digital nunca pertenece a la tarjeta física PENDIENTES POR ATENDER.
  const basePendingUnitsV488=window.requestPendingUnitsV163;
  if(typeof basePendingUnitsV488==='function'){
    window.requestPendingUnitsV163=function(row){
      if(upper(row?.modalidad)==='COPIA DIGITAL')return 0;
      return basePendingUnitsV488(row);
    };
  }

  // Al seleccionar cualquier tarjeta estándar, salir de la bandeja digital.
  const baseSelectAdminV488=window.selectAdminRequestCard;
  if(typeof baseSelectAdminV488==='function'){
    window.selectAdminRequestCard=async function(state){
      setDigitalModeV488(false);
      return await baseSelectAdminV488(state);
    };
  }
  const baseClearRequestV488=window.clearRequestWorkflowFilter;
  if(typeof baseClearRequestV488==='function'){
    window.clearRequestWorkflowFilter=async function(){
      setDigitalModeV488(false);
      return await baseClearRequestV488();
    };
  }

  // Actualizar contador digital cada vez que se refresca Solicitudes.
  const baseLoadRequestsLocalV488=window.loadRequests;
  window.v488BaseLoadRequests=baseLoadRequestsLocalV488;
  if(typeof baseLoadRequestsLocalV488==='function'){
    window.loadRequests=async function(){
      const result=await baseLoadRequestsLocalV488.apply(this,arguments);
      $('v488DigitalCard')?.classList.toggle('hidden',!isFullV488());
      if(isFullV488()){
        await loadDigitalCopiesV488(true);
        annotateRequestRowsV488();
        if(!digitalModeV488 && typeof window.renderRequests==='function')window.renderRequests();
        if(digitalModeV488)renderDigitalCopiesV488();
      }
      return result;
    };
  }

  // En detalle, sustituir controles físicos por el flujo digital.
  const baseItemSelectableV488=window.requestItemSelectable;
  if(typeof baseItemSelectableV488==='function'){
    window.requestItemSelectable=function(row){
      if(isDigitalRequestV488()){
        return isFullV488()
          ?baseItemSelectableV488(row)
          :false;
      }
      return baseItemSelectableV488(row);
    };
  }

  const baseRenderItemsV488=window.renderRequestDetailItems;
  if(typeof baseRenderItemsV488==='function'){
    window.renderRequestDetailItems=function(){
      if(!isDigitalRequestV488())return baseRenderItemsV488.apply(this,arguments);
      const data=Array.isArray(requestDetailRows)?requestDetailRows:[];
      const selectableRows=data.filter(x=>requestItemSelectable(x));
      const allChecked=selectableRows.length>0 &&
        selectableRows.every(x=>requestSelectedIds.has(x.expediente_id));

      if($('rqDSelectedCount')){
        $('rqDSelectedCount').textContent=requestSelectedIds.size+
          ' seleccionado'+(requestSelectedIds.size===1?'':'s');
      }
      if(typeof window.v801SyncNumberButton==='function')window.v801SyncNumberButton();

      if(!data.length){
        $('rqDetailItems').innerHTML='<div class="empty">No hay expedientes.</div>';
        return;
      }

      $('rqDetailItems').innerHTML=`<table>
        <thead><tr>
          <th><input type="checkbox" ${selectableRows.length?'':'disabled'} ${allChecked?'checked':''}
                     onchange="toggleAllRequestItems(this.checked)"></th>
          <th>Expediente</th><th>Extensión</th><th>R.D.</th>
          <th>Estado de la solicitud</th><th>Modalidad actual</th>
          <th>Estado físico actual</th><th>Responsable físico actual</th>
        </tr></thead>
        <tbody>${data.map(x=>{
          const selectable=requestItemSelectable(x);
          return `<tr class="${selectable?'row-click-select ':''}${requestSelectedIds.has(x.expediente_id)?'record-selected-row':''}"
                      ${selectable?`onclick="toggleRequestItemFromRow(event,'${x.expediente_id}',true)"`:''}>
            <td><input type="checkbox" ${selectable?'':'disabled'}
              ${requestSelectedIds.has(x.expediente_id)?'checked':''}
              onchange="toggleRequestItem('${x.expediente_id}',this.checked)"></td>
            <td><b>${htmlEsc(x.expediente||'—')}</b></td>
            <td>${htmlEsc(x.extension||'—')}</td>
            <td>${htmlEsc(x.rd||'—')}</td>
            <td><span class="v488-digital-status pending">${htmlEsc(x.estado_item||'COPIA DIGITAL')}</span></td>
            <td>${typeof v710ModalityBadge==='function'
              ?v710ModalityBadge(x.modalidad_atencion||x.modalidad_actual||'COPIA DIGITAL')
              :'<span class="v488-digital-status pending">COPIA DIGITAL</span>'}</td>
            <td>${htmlEsc(x.estado_fisico||'—')}</td>
            <td>${htmlEsc(typeof requestEffectiveCurrentResponsible==='function'
              ?requestEffectiveCurrentResponsible(x)
              :(x.responsable_actual||'—'))}</td>
          </tr>`;
        }).join('')}</tbody>
      </table>`;
    };
  }

  const baseRenderActionsV488=window.renderRequestActions;
  if(typeof baseRenderActionsV488==='function'){
    window.renderRequestActions=function(){
      if(!isDigitalRequestV488())return baseRenderActionsV488.apply(this,arguments);

      $('requestDetailModal')?.classList.add('v488-digital-request');
      ['rqAttentionSection','rqMovementSection','rqObservationSection'].forEach(id=>$(id)?.classList.add('hidden'));

      const state=upper(currentRequest?.estado_atencion||currentRequest?.estado);
      const rows=Array.isArray(requestDetailRows)?requestDetailRows:[];

      const cancelled=[
        'CERRADA POR ADMINISTRADOR',
        'CERRADO POR ADMINISTRADOR',
        'CANCELADA',
        'CANCELADO',
        'ANULADA',
        'ANULADO'
      ].includes(state);

      const delivered=[
        'COPIA DIGITAL ENTREGADA',
        'ENTREGA TOTAL',
        'CERRADA POR ARCHIVO',
        'CERRADO POR ARCHIVO'
      ].includes(state);

      const deliveredItems=rows.filter(
        x=>upper(x?.estado_item)==='COPIA DIGITAL ENTREGADA'
      ).length;

      const canCancelDigital=
        typeof isAdmin==='function' &&
        isAdmin() &&
        rows.length>0 &&
        typeof requestItemCanAdminClose==='function' &&
        rows.every(x=>requestItemCanAdminClose(x));

      if($('rqWorkflowActions')){
        if(cancelled){
          $('rqWorkflowActions').innerHTML=`
            <span class="note">
              <b>CERRADA POR ADMINISTRADOR.</b>
              La solicitud de COPIA DIGITAL fue cancelada y se conserva únicamente para consulta e historial.
              La cancelación no modifica el estado, ubicación ni responsable físico del expediente.
            </span>`;
          return;
        }

        if(delivered){
          $('rqWorkflowActions').innerHTML=`
            <span class="note">
              <b>COPIA DIGITAL ENTREGADA.</b>
              La atención digital se encuentra cerrada.
              El expediente físico conserva su estado, ubicación y responsable.
            </span>`;
          return;
        }

        let html=`
          <span class="note">
            <b>COPIA DIGITAL.</b>
            Esta solicitud no genera cargo, préstamo, reasignación ni devolución.
            Archivo debe entregar el enlace de cada copia pendiente; al entregar la última,
            la solicitud se cierra automáticamente.
          </span>`;

        if(canCancelDigital){
          html+=`
            <button class="btn secondary request-cancel-btn"
                    type="button"
                    onclick="openAdminCancelRequestModalV289()">
              Cancelar solicitud
            </button>
            <span class="note">
              <b>Cancelar solicitud:</b>
              disponible mientras ninguna copia haya sido entregada.
              Se conserva toda la trazabilidad y no se modifica la custodia física.
            </span>`;
        }else if(
          typeof isAdmin==='function' &&
          isAdmin() &&
          deliveredItems>0
        ){
          html+=`
            <span class="note">
              <b>Cancelación no disponible.</b>
              Esta solicitud ya tiene ${deliveredItems} copia${deliveredItems===1?'':'s'} digital${deliveredItems===1?'':'es'} entregada${deliveredItems===1?'':'s'}.
              No corresponde cancelar la solicitud completa como no atendida.
            </span>`;
        }

        $('rqWorkflowActions').innerHTML=html;
      }
    };
  }

  const baseOpenDetailV488=window.openRequestDetail;
  if(typeof baseOpenDetailV488==='function'){
    window.openRequestDetail=async function(id){
      await baseOpenDetailV488(id);
      await renderDigitalRequestDetailV488(id,true);
    };
  }

  const baseCloseDetailV488=window.closeRequestDetail;
  if(typeof baseCloseDetailV488==='function'){
    window.closeRequestDetail=function(){
      $('requestDetailModal')?.classList.remove('v488-digital-request');
      $('v488DigitalRequestPanel')?.classList.add('hidden');
      digitalDetailRowsV488=[];
      return baseCloseDetailV488.apply(this,arguments);
    };
  }

  function initV488(){
    if(!isFullV488()){
      $('v488DigitalCard')?.classList.add('hidden');
      return;
    }
    $('v488DigitalCard')?.classList.remove('hidden');
    loadDigitalCopiesV488(true).then(()=>{
      if(digitalModeV488)renderDigitalCopiesV488();
    }).catch(()=>{});
  }

  window.v488DigitalInfo=function(){
    return {
      version:'V488',
      rule:'COPIA DIGITAL = atención documental; no cambia custodia física',
      card:'COPIAS DIGITALES PENDIENTES',
      sql_required:'V488_COPIAS_DIGITALES_SUPABASE.sql'
    };
  };

  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initV488,{once:true});
  else initV488();
})();
</script>


<style id="v489-digital-attention-layer-fix">
/* =========================================================
   V489 · COPIA DIGITAL · CORRECCIÓN DE ATENCIÓN
   El modal V488 se encontraba detrás del detalle de solicitud
   porque ambos usaban el mismo z-index.
   ========================================================= */
#v488DigitalModal{
  z-index:220!important;
}
#v488DigitalModal .v488-digital-modal-box{
  position:relative;
  z-index:221;
}
/* En copia digital no corresponde mostrar el mensaje heredado
   que indica generar/imprimir cargo físico. */
#requestDetailModal.v488-digital-request #rqActionStatus{
  display:none!important;
}
</style>
<script id="v489-digital-attention-layer-script">
(function(){
  'use strict';

  const baseOpenDigitalCopyAttentionV489=window.openDigitalCopyAttentionV488;
  if(typeof baseOpenDigitalCopyAttentionV489==='function'){
    window.openDigitalCopyAttentionV488=function(solicitudId,expedienteId){
      // Asegura que el modal de atención digital quede por encima del detalle.
      const digitalModal=document.getElementById('v488DigitalModal');
      if(digitalModal) digitalModal.style.zIndex='220';

      const result=baseOpenDigitalCopyAttentionV489.apply(this,arguments);

      // Limpia mensajes heredados del flujo físico.
      const status=document.getElementById('rqActionStatus');
      if(status) status.textContent='';

      // Reafirma el foco una vez que el modal ya está visible.
      setTimeout(()=>{
        const link=document.getElementById('v488DigitalLink');
        if(digitalModal?.classList.contains('show')) link?.focus();
      },30);

      return result;
    };
  }

  const baseRenderActionsV489=window.renderRequestActions;
  if(typeof baseRenderActionsV489==='function'){
    window.renderRequestActions=function(){
      const result=baseRenderActionsV489.apply(this,arguments);
      const modal=document.getElementById('requestDetailModal');
      if(modal?.classList.contains('v488-digital-request')){
        const status=document.getElementById('rqActionStatus');
        if(status) status.textContent='';
      }
      return result;
    };
  }

  window.v489DigitalAttentionInfo=function(){
    return {
      version:'V489',
      fix:'Atender copia digital abre el formulario sobre el detalle de solicitud',
      sql:'No requiere SQL nuevo; conserva SQL V488 corregido'
    };
  };
})();
</script>


<style id="v490-digital-logical-close-style">
/* =========================================================
   V490 · COPIA DIGITAL · CIERRE LÓGICO INDEPENDIENTE
   ========================================================= */
.status-attn.v490-digital-closed,
.v490-digital-closed-pill{
  display:inline-flex;
  align-items:center;
  padding:4px 8px;
  border-radius:999px;
  background:#e6f5ea;
  color:#21613a;
  font-size:10px;
  font-weight:850;
  white-space:nowrap;
}
</style>
<script id="v490-digital-logical-close-script">
(function(){
  'use strict';

  const upperV490=v=>String(v??'').trim().toUpperCase();
  const isDigitalV490=r=>upperV490(r?.modalidad)==='COPIA DIGITAL';

  function digitalCompletedRowV490(r){
    if(!isDigitalV490(r))return false;
    const total=Number(r?.total_expedientes||0);
    const pending=Number(r?._v488_copias_pendientes);
    return total>0 && Number.isFinite(pending) && pending===0;
  }

  function markDigitalRowsClosedV490(){
    try{
      if(Array.isArray(window.requestRows)){
        window.requestRows.forEach(r=>{
          if(!digitalCompletedRowV490(r))return;
          if(!r._v490_estado_original){
            r._v490_estado_original=r.estado_atencion||r.estado||'';
          }
          r._v490_copia_cerrada=true;
          r.estado_atencion='COPIA DIGITAL ENTREGADA';
        });
      }
    }catch(_){ }
  }

  const baseAttentionStateClassV490=window.attentionStateClass;
  if(typeof baseAttentionStateClassV490==='function'){
    window.attentionStateClass=function(value){
      if(upperV490(value)==='COPIA DIGITAL ENTREGADA')return 'total';
      return baseAttentionStateClassV490(value);
    };
  }

  const baseLoadRequestsV490=window.loadRequests;
  if(typeof baseLoadRequestsV490==='function'){
    window.loadRequests=async function(){
      const result=await baseLoadRequestsV490.apply(this,arguments);
      markDigitalRowsClosedV490();
      try{
        if(typeof window.renderRequests==='function')window.renderRequests();
      }catch(_){ }
      return result;
    };
  }

  const baseRenderDigitalDetailV490=window.renderDigitalRequestDetailV488;
  if(typeof baseRenderDigitalDetailV490==='function'){
    window.renderDigitalRequestDetailV488=async function(){
      const result=await baseRenderDigitalDetailV490.apply(this,arguments);

      const panel=document.getElementById('v488DigitalRequestDetail');
      if(!panel)return result;

      const delivered=panel.querySelectorAll('.v488-digital-status.delivered').length;
      const pending=panel.querySelectorAll('.v488-digital-status.pending').length;
      const completed=delivered>0 && pending===0;

      if(completed){
        try{
          if(window.currentRequest){
            if(!window.currentRequest._v490_estado_original){
              window.currentRequest._v490_estado_original=
                window.currentRequest.estado_atencion||window.currentRequest.estado||'';
            }
            window.currentRequest._v490_copia_cerrada=true;
            window.currentRequest.estado_atencion='COPIA DIGITAL ENTREGADA';
          }
        }catch(_){ }

        const state=document.getElementById('rqDState');
        if(state){
          state.innerHTML='<span class="status-attn total">COPIA DIGITAL ENTREGADA</span>';
        }

        const actions=document.getElementById('rqWorkflowActions');
        if(actions){
          actions.innerHTML='<span class="note"><b>COPIA DIGITAL ENTREGADA.</b> La atención digital se encuentra cerrada. El expediente físico conserva su estado, ubicación y responsable.</span>';
        }
      }

      return result;
    };
  }

  const baseRenderActionsV490=window.renderRequestActions;
  if(typeof baseRenderActionsV490==='function'){
    window.renderRequestActions=function(){
      const digital=isDigitalV490(window.currentRequest);
      const closed=digital && (
        window.currentRequest?._v490_copia_cerrada===true ||
        upperV490(window.currentRequest?.estado_atencion)==='COPIA DIGITAL ENTREGADA'
      );

      if(!closed)return baseRenderActionsV490.apply(this,arguments);

      document.getElementById('requestDetailModal')?.classList.add('v488-digital-request');
      ['rqAttentionSection','rqMovementSection','rqObservationSection'].forEach(id=>
        document.getElementById(id)?.classList.add('hidden')
      );

      const actions=document.getElementById('rqWorkflowActions');
      if(actions){
        actions.innerHTML='<span class="note"><b>COPIA DIGITAL ENTREGADA.</b> La atención digital se encuentra cerrada. El expediente físico conserva su estado, ubicación y responsable.</span>';
      }
    };
  }

  window.v490DigitalCloseInfo=function(){
    return {
      version:'V490',
      rule:'El cierre de COPIA DIGITAL se deriva de la entrega de todas las copias; no modifica solicitudes_prestamo.estado ni la custodia física.',
      sql_required:'V490_COPIAS_DIGITALES_CIERRE_LOGICO.sql'
    };
  };
})();
</script>



<style id="v491-digital-persisted-close-style">
/* =========================================================
   V491 · COPIA DIGITAL · ESTADO PERSISTENTE PROPIO
   ========================================================= */
.status-attn.v491-digital-delivered,
.v491-digital-delivered{
  background:#e6f5ea!important;
  color:#21613a!important;
  border-color:#b9dfc5!important;
  font-weight:850!important;
}
</style>
<script id="v491-digital-persisted-close-script">
(function(){
  'use strict';

  const upperV491=v=>String(v??'').trim().toUpperCase();
  const DIGITAL_DONE_V491='COPIA DIGITAL ENTREGADA';

  // Presentación uniforme del nuevo estado persistente.
  const baseRequestStateDisplayNameV491=window.requestStateDisplayName;
  if(typeof baseRequestStateDisplayNameV491==='function'){
    window.requestStateDisplayName=function(value){
      if(upperV491(value)===DIGITAL_DONE_V491)return DIGITAL_DONE_V491;
      return baseRequestStateDisplayNameV491.apply(this,arguments);
    };
  }

  const baseAttentionStateClassV491=window.attentionStateClass;
  if(typeof baseAttentionStateClassV491==='function'){
    window.attentionStateClass=function(value){
      if(upperV491(value)===DIGITAL_DONE_V491)return 'total v491-digital-delivered';
      return baseAttentionStateClassV491.apply(this,arguments);
    };
  }

  // Una solicitud digital ya entregada nunca vuelve al editor/cargo físico.
  const baseCanEditRequestBeforeCargoV491=window.canEditRequestBeforeCargo;
  if(typeof baseCanEditRequestBeforeCargoV491==='function'){
    window.canEditRequestBeforeCargo=function(r){
      if(
        upperV491(r?.modalidad)==='COPIA DIGITAL' &&
        upperV491(r?.estado_atencion||r?.estado)===DIGITAL_DONE_V491
      ) return false;
      return baseCanEditRequestBeforeCargoV491.apply(this,arguments);
    };
  }

  // Refuerza el estado visible en la cabecera del detalle.
  const baseRenderDigitalDetailV491=window.renderDigitalRequestDetailV488;
  if(typeof baseRenderDigitalDetailV491==='function'){
    window.renderDigitalRequestDetailV488=async function(){
      const result=await baseRenderDigitalDetailV491.apply(this,arguments);
      const req=window.currentRequest;
      const persisted=upperV491(req?.estado_atencion||req?.estado)===DIGITAL_DONE_V491;
      if(persisted){
        req._v490_copia_cerrada=true;
        req.estado_atencion=DIGITAL_DONE_V491;
        const state=document.getElementById('rqDState');
        if(state) state.innerHTML='<span class="status-attn total v491-digital-delivered">COPIA DIGITAL ENTREGADA</span>';
        const actions=document.getElementById('rqWorkflowActions');
        if(actions){
          actions.innerHTML='<span class="note"><b>COPIA DIGITAL ENTREGADA.</b> El servicio digital está cerrado. El expediente físico conserva su estado, ubicación y responsable.</span>';
        }
      }
      return result;
    };
  }

  // Después de entregar, fuerza recarga de la solicitud para leer el estado
  // persistido por SQL V491 y no depender solo del cierre visual V490.
  const baseDeliverDigitalCopyV491=window.deliverDigitalCopyV488;
  if(typeof baseDeliverDigitalCopyV491==='function'){
    window.deliverDigitalCopyV488=async function(){
      const requestId=(typeof digitalEditingV488!=='undefined' && digitalEditingV488)
        ?digitalEditingV488.solicitud_id
        :null;
      const result=await baseDeliverDigitalCopyV491.apply(this,arguments);
      try{
        if(requestId && typeof window.loadRequests==='function')await window.loadRequests();
        if(requestId && String(window.currentRequestId||'')===String(requestId) && typeof window.renderDigitalRequestDetailV488==='function'){
          await window.renderDigitalRequestDetailV488(requestId,true);
        }
      }catch(_){ }
      return result;
    };
  }

  window.v491DigitalStateInfo=function(){
    return {
      version:'V491',
      persisted_state:DIGITAL_DONE_V491,
      rule:'La copia digital se cierra con estado propio de solicitud; no crea préstamo ni modifica custodia física.',
      sql_required:'V491_COPIAS_DIGITALES_ESTADO_PROPIO.sql'
    };
  };
})();
</script>


<style id="v492-personal-digital-copies-style">
/* =========================================================
   V492 · TARJETA PERSONAL DE COPIAS DIGITALES
   ========================================================= */
body.produce-user .app.role-user #userPersonalKpis #userKpiDigitalCopiesCard,
body.produce-staff .app.role-user #userPersonalKpis #userKpiDigitalCopiesCard{
  background:#e7f8f6!important;
  border-color:#b9e6df!important;
}
#userKpiDigitalCopiesCard .produce-kpi-icon{
  background:#0f766e!important;
  color:#fff!important;
}
body.produce-coordinator-self #userPersonalKpis #userKpiDigitalCopiesCard{
  background:#e7f8f6!important;
  border-color:#b9e6df!important;
}
.v492-digital-card-caption{
  margin-top:2px;
  font-size:10px;
  line-height:1.2;
  color:#52706d;
  font-weight:700;
}
body.produce-user #userKpiDigitalCopiesCard .kpi-view,
body.produce-staff #userKpiDigitalCopiesCard .kpi-view,
body.produce-coordinator-self #userKpiDigitalCopiesCard .kpi-view{
  margin-top:2px!important;
}
.v492-my-digital-status{display:inline-flex;align-items:center;padding:4px 8px;border-radius:999px;font-size:10px;font-weight:850;white-space:nowrap}
.v492-my-digital-status.pending{background:#fff4cc;color:#6d5100}
.v492-my-digital-status.delivered{background:#e6f5ea;color:#21613a}
.v492-my-digital-status.closed{background:#eef2f7;color:#475569}
.v492-digital-attention-meta{font-size:10px;color:var(--muted);margin-top:3px;line-height:1.35}
</style>
<script id="v492-personal-digital-copies-script">
(function(){
  'use strict';

  const DIGITAL_MODE_V492='COPIAS_DIGITALES';
  let myDigitalRowsV492=[];
  let myDigitalLoadedAtV492=0;
  let myDigitalFlightV492=null;

  const $=id=>document.getElementById(id);
  const upper=v=>String(v??'').trim().toUpperCase();
  const clean=v=>String(v??'').trim();
  const escV492=v=>typeof esc==='function'?esc(v):String(v??'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));
  const jsV492=v=>String(v??'').split('\\').join('\\\\').split("'").join("\\'");

  function isPersonalScopeV492(){
    try{return typeof isLimitedUser==='function' && isLimitedUser();}
    catch(_){return false;}
  }

  function safeUrlV492(value){
    const raw=clean(value);
    if(!/^https?:\/\//i.test(raw))return '';
    try{
      const u=new URL(raw);
      return ['http:','https:'].includes(u.protocol)?u.href:'';
    }catch(_){return '';}
  }

  function dateV492(value){
    if(!value)return '—';
    try{
      const d=new Date(value);
      if(Number.isNaN(d.getTime()))return escV492(value);
      return d.toLocaleString('es-PE',{dateStyle:'short',timeStyle:'short'});
    }catch(_){return escV492(value);}
  }

  function statusHtmlV492(row){
    const state=upper(row?.estado_copia);
    if(state==='ENTREGADA')return '<span class="v492-my-digital-status delivered">ENTREGADA</span>';
    if(state==='CERRADA')return '<span class="v492-my-digital-status closed">CERRADA</span>';
    return '<span class="v492-my-digital-status pending">PENDIENTE</span>';
  }

  function digitalSummaryV492(){
    const pending=myDigitalRowsV492.filter(r=>upper(r.estado_copia)==='PENDIENTE').length;
    const delivered=myDigitalRowsV492.filter(r=>upper(r.estado_copia)==='ENTREGADA').length;
    const closed=myDigitalRowsV492.filter(r=>upper(r.estado_copia)==='CERRADA').length;
    return {pending,delivered,closed,total:myDigitalRowsV492.length};
  }

  function paintDigitalCardV492(){
    const card=$('userKpiDigitalCopiesCard');
    if(!card)return;
    const summary=digitalSummaryV492();
    if($('uKDigitalCopies'))$('uKDigitalCopies').textContent=String(summary.pending);
    if($('uKDigitalCopiesBreakdown'))$('uKDigitalCopiesBreakdown').textContent=`${summary.pending} pendiente${summary.pending===1?'':'s'} · ${summary.delivered} entregada${summary.delivered===1?'':'s'}`;
    card.classList.toggle('quick-active',typeof userPanelMode!=='undefined'&&userPanelMode===DIGITAL_MODE_V492);
  }

  async function loadMyDigitalCopiesV492(force=false){
    if(!isPersonalScopeV492() || typeof sb==='undefined' || !sb || typeof session==='undefined' || !session)return [];
    if(!force && myDigitalRowsV492.length && Date.now()-myDigitalLoadedAtV492<12000){paintDigitalCardV492();return myDigitalRowsV492;}
    if(myDigitalFlightV492 && !force)return myDigitalFlightV492;

    myDigitalFlightV492=(async()=>{
      const {data,error}=await sb.rpc('v492_listar_mis_copias_digitales');
      if(error){
        console.warn('V492 · mis copias digitales:',error.message);
        if($('uKDigitalCopies'))$('uKDigitalCopies').textContent='—';
        if($('uKDigitalCopiesBreakdown'))$('uKDigitalCopiesBreakdown').textContent='Ejecute SQL V492';
        return [];
      }
      myDigitalRowsV492=Array.isArray(data)?data:[];
      myDigitalLoadedAtV492=Date.now();
      paintDigitalCardV492();
      return myDigitalRowsV492;
    })();

    try{return await myDigitalFlightV492;}
    finally{myDigitalFlightV492=null;}
  }

  function filteredMyDigitalCopiesV492(search=''){
    const q=upper(search);
    return myDigitalRowsV492.filter(r=>{
      if(!q)return true;
      return [r.expediente,r.extension,r.solicitud_numero,r.asunto,r.estado_copia,r.atendido_por].map(upper).join(' | ').includes(q);
    }).sort((a,b)=>{
      const pa=upper(a.estado_copia)==='PENDIENTE'?0:1;
      const pb=upper(b.estado_copia)==='PENDIENTE'?0:1;
      if(pa!==pb)return pa-pb;
      return new Date(b.fecha_solicitud||0)-new Date(a.fecha_solicitud||0);
    });
  }

  function renderMyDigitalCopiesTableV492(rows){
    if(!rows.length)return '<div class="empty">No tiene solicitudes de copia digital.</div>';
    return `<table>
      <thead><tr><th>Expediente</th><th>Extensión</th><th>Solicitud</th><th class="subject-cell-v639">Asunto</th><th>Fecha / hora solicitud</th><th>Estado</th><th>Copia digital</th><th>Atención</th><th></th></tr></thead>
      <tbody>${rows.map(r=>{
        const url=safeUrlV492(r.enlace);
        const delivered=upper(r.estado_copia)==='ENTREGADA';
        return `<tr>
          <td><b>${escV492(r.expediente||'—')}</b></td>
          <td>${escV492(r.extension||'—')}</td>
          <td><b>${escV492(r.solicitud_numero||'—')}</b></td>
          <td class="subject-cell-v639" title="${escV492(r.asunto||'')}"><div class="subject-text-v639">${escV492(r.asunto||'—')}</div></td>
          <td>${dateV492(r.fecha_solicitud)}</td>
          <td>${statusHtmlV492(r)}</td>
          <td>${url?`<button class="btn secondary small" onclick="window.open('${jsV492(url)}','_blank','noopener,noreferrer')">Abrir copia</button>`:'<span class="v492-digital-attention-meta">Aún no entregada</span>'}</td>
          <td>${delivered?`${escV492(r.atendido_por||'—')}<div class="v492-digital-attention-meta">${dateV492(r.entregado_at)}</div>`:'—'}</td>
          <td><button class="btn secondary small" onclick="openRequestDetail('${jsV492(r.solicitud_id)}')">Ver solicitud</button></td>
        </tr>`;
      }).join('')}</tbody>
    </table>`;
  }

  async function renderMyDigitalPanelV492(options={}){
    const search=$('searchInput')?.value?.trim()||'';
    await loadMyDigitalCopiesV492(!!options?.forceFresh);
    const all=filteredMyDigitalCopiesV492(search);
    const size=typeof PAGE_SIZE!=='undefined'?PAGE_SIZE:50;
    const currentPage=typeof page!=='undefined'?page:0;
    const from=currentPage*size;
    const to=from+size-1;
    const rows=all.slice(from,to+1);
    const summary=digitalSummaryV492();

    if(typeof panelCount!=='undefined')panelCount=all.length;
    if(typeof panelRows!=='undefined')panelRows=rows;
    if($('panelTitle'))$('panelTitle').textContent=`Mis copias digitales · ${summary.pending} pendientes · ${summary.delivered} entregadas`;
    const first=all.length?from+1:0;
    const last=Math.min(to+1,all.length);
    if($('pageInfo'))$('pageInfo').textContent=`${first} - ${last} de ${all.length} registros`;
    if($('panelTable'))$('panelTable').innerHTML=renderMyDigitalCopiesTableV492(rows);
    paintDigitalCardV492();
  }

  const baseUpdateKpiV492=window.updateUserPersonalKpiUI;
  if(typeof baseUpdateKpiV492==='function'){
    window.updateUserPersonalKpiUI=function(){const result=baseUpdateKpiV492.apply(this,arguments);paintDigitalCardV492();return result;};
  }

  const baseLoadPanelV492=window.loadPanel;
  if(typeof baseLoadPanelV492==='function'){
    window.loadPanel=async function(){
      if(isPersonalScopeV492() && typeof userPanelMode!=='undefined' && userPanelMode===DIGITAL_MODE_V492){return await renderMyDigitalPanelV492(arguments[0]||{});}
      return await baseLoadPanelV492.apply(this,arguments);
    };
  }

  const baseLoadUserSummaryV492=window.loadUserPersonalSummary;
  if(typeof baseLoadUserSummaryV492==='function'){
    window.loadUserPersonalSummary=async function(){const result=await baseLoadUserSummaryV492.apply(this,arguments);loadMyDigitalCopiesV492(true).catch(()=>{});return result;};
  }

  const baseDeliverV492=window.deliverDigitalCopyV488;
  if(typeof baseDeliverV492==='function'){
    window.deliverDigitalCopyV488=async function(){const result=await baseDeliverV492.apply(this,arguments);myDigitalLoadedAtV492=0;if(isPersonalScopeV492())await loadMyDigitalCopiesV492(true);return result;};
  }

  let tries=0;
  const boot=setInterval(()=>{
    tries++;
    if(isPersonalScopeV492() && typeof sb!=='undefined' && sb && typeof session!=='undefined' && session){clearInterval(boot);loadMyDigitalCopiesV492(true).catch(()=>{});}
    else if(tries>=20)clearInterval(boot);
  },400);

  window.v492DigitalPersonalInfo=function(){return {version:'V492',card:'COPIAS DIGITALES',counter:'copias propias pendientes',detail:'pendientes y entregadas con enlace',physical_custody:'sin cambios',sql_required:'V492_COPIAS_DIGITALES_TODOS_PERFILES.sql'};};
})();
</script>

<script>
(function(){
  function syncResponsiveModalState(){
    try{
      const hasOpenModal=!!document.querySelector('.modal.show');
      const compact=window.innerWidth<=1200;
      document.body.classList.toggle('modal-responsive-active', hasOpenModal && compact);
    }catch(_err){}
  }
  function observeModals(){
    document.querySelectorAll('.modal').forEach(modal=>{
      if(modal.__responsiveObserved)return;
      modal.__responsiveObserved=true;
      new MutationObserver(syncResponsiveModalState).observe(modal,{attributes:true,attributeFilter:['class']});
    });
    syncResponsiveModalState();
  }
  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded', observeModals);
  }else{
    observeModals();
  }
  window.addEventListener('resize', syncResponsiveModalState, {passive:true});
  window.addEventListener('load', syncResponsiveModalState);
})();
</script>

<style id="v496-digital-closed-color-style">
/* =========================================================
   V496 · COPIA DIGITAL CERRADA · CAMBIO VISUAL DE COLOR
   ========================================================= */
.v496-digital-closed-row td,
.v496-digital-closed-row th,
.v496-digital-closed-row > div{
  background:#eef8f0!important;
}
.v496-digital-closed-row td,
.v496-digital-closed-row th{
  color:#1f5131!important;
}
.v496-digital-closed-row:hover td{
  background:#e4f3e8!important;
}
.v496-digital-closed-row .pill,
.v496-digital-closed-row .status-attn,
.v496-digital-closed-row .tag,
.v496-digital-closed-row .badge{
  border-color:#b9dfc5!important;
}
.v496-digital-closed-mark{
  background:#e6f5ea!important;
  color:#21613a!important;
  border:1px solid #b9dfc5!important;
  font-weight:850!important;
}
</style>
<script id="v496-digital-closed-color-script">
(function(){
  'use strict';
  function upper(v){return String(v??'').trim().toUpperCase();}
  function collapse(v){return upper(String(v??'').replace(/\s+/g,' '));}
  function isDigitalClosedText(v){
    const t=collapse(v);
    return t.includes('COPIA DIGITAL ENTREGADA');
  }
  function paintDigitalClosedRows(root){
    const scope=root&&root.querySelectorAll?root:document;
    scope.querySelectorAll('tr, .v488-request-digital-row').forEach(row=>{
      const text=collapse(row.textContent||'');
      const closedByText=isDigitalClosedText(text);
      const closedByBadge=!!row.querySelector('.v491-digital-delivered, .v496-digital-closed-mark');
      row.classList.toggle('v496-digital-closed-row', closedByText || closedByBadge);
    });

    scope.querySelectorAll('.pill, .status-attn, .tag, .badge, .v488-digital-status, td, th, div').forEach(node=>{
      if(isDigitalClosedText(node.textContent||'')){
        node.classList.add('v496-digital-closed-mark');
      }
    });
  }

  const baseDeliver=window.deliverDigitalCopyV488;
  if(typeof baseDeliver==='function'){
    window.deliverDigitalCopyV488=async function(){
      const result=await baseDeliver.apply(this,arguments);
      requestAnimationFrame(()=>paintDigitalClosedRows(document));
      setTimeout(()=>paintDigitalClosedRows(document),180);
      return result;
    };
  }

  const baseLoadRequests=window.loadRequests;
  if(typeof baseLoadRequests==='function'){
    window.loadRequests=async function(){
      const result=await baseLoadRequests.apply(this,arguments);
      requestAnimationFrame(()=>paintDigitalClosedRows(document));
      return result;
    };
  }

  const baseRenderReqDetail=window.renderRequestDetail;
  if(typeof baseRenderReqDetail==='function'){
    window.renderRequestDetail=async function(){
      const result=await baseRenderReqDetail.apply(this,arguments);
      requestAnimationFrame(()=>paintDigitalClosedRows(document));
      return result;
    };
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',()=>paintDigitalClosedRows(document));
  }else{
    paintDigitalClosedRows(document);
  }

  // V511: no observar todo el DOM continuamente. La pintura se aplica
  // únicamente al cargar/renderizar las vistas correspondientes para evitar
  // cambios repetidos de clases y parpadeos de color.
  window.addEventListener('load',()=>{
    paintDigitalClosedRows(document);
  },{once:true});
})();
</script>


<style id="v497-modality-style">
/* =========================================================
   V497 · Modalidad visible en vistas operativas
   ========================================================= */
.v497-modality{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:24px;
  padding:4px 8px;
  border-radius:999px;
  font-size:9px;
  font-weight:850;
  line-height:1.15;
  white-space:nowrap;
  border:1px solid transparent;
}
.v497-modality.loan{background:#fff4cc;color:#6d5100;border-color:#ead996}
.v497-modality.digital{background:#e8f4ff;color:#0f5f93;border-color:#b9d9ee}
.v497-modality.reading{background:#f2eaff;color:#663399;border-color:#d7c2ed}
#statePendingFilters .filters{max-width:900px}
@media(max-width:850px){
  #statePendingFilters .filters{grid-template-columns:1fr!important}
  .v497-modality{white-space:normal;text-align:center}
}
</style>


<style id="v499-safe-modal-stack-style">
/* =========================================================
   V499 · PILA SEGURA DE MODALES
   - Evita ventanas auxiliares detrás de Nueva solicitud.
   - No observa sus propias clases de presentación en bucle.
   ========================================================= */
.modal.v499-stack-top > .modal-box{
  box-shadow:0 28px 90px rgba(3,20,42,.34)!important;
}
</style>
<script id="v499-safe-modal-stack-script">
(function(){
  'use strict';

  const BASE_Z=300000;
  const openStack=[];
  const shownState=new WeakMap();
  let currentTop=null;

  function modalList(){
    return Array.from(document.querySelectorAll('.modal'));
  }

  function isShown(modal){
    return !!modal?.classList?.contains('show');
  }

  function removeModal(modal){
    const i=openStack.indexOf(modal);
    if(i>=0) openStack.splice(i,1);
  }

  function applyStack(){
    for(let i=openStack.length-1;i>=0;i--){
      const m=openStack[i];
      if(!m?.isConnected || !isShown(m)) openStack.splice(i,1);
    }

    openStack.forEach((m,index)=>{
      m.style.setProperty('z-index', String(BASE_Z + index*20), 'important');
      m.dataset.v499Stacked='1';
    });

    modalList().forEach(m=>{
      if(!isShown(m) && m.dataset.v499Stacked==='1'){
        m.style.removeProperty('z-index');
        delete m.dataset.v499Stacked;
      }
    });

    const nextTop=openStack[openStack.length-1]||null;
    if(currentTop!==nextTop){
      if(currentTop?.isConnected) currentTop.classList.remove('v499-stack-top');
      currentTop=nextTop;
      if(currentTop) currentTop.classList.add('v499-stack-top');
    }

    const compact=window.innerWidth<=1200;
    document.body.classList.toggle('modal-responsive-active', !!currentTop && compact);
  }

  function bringToFront(modal){
    if(!isShown(modal)) return;
    removeModal(modal);
    openStack.push(modal);
    applyStack();
  }

  function onVisibilityChange(modal){
    const now=isShown(modal);
    const before=shownState.get(modal);
    shownState.set(modal,now);

    // Ignorar cambios de clase que no alteran show/no-show.
    if(before===now) return;

    if(now) bringToFront(modal);
    else{
      removeModal(modal);
      applyStack();
    }
  }

  function observe(modal){
    if(!modal || modal.dataset.v499Observed==='1') return;
    modal.dataset.v499Observed='1';
    shownState.set(modal,isShown(modal));
    new MutationObserver(()=>onVisibilityChange(modal))
      .observe(modal,{attributes:true,attributeFilter:['class']});
  }

  function scan(){
    modalList().forEach(observe);
    modalList().filter(isShown).forEach(m=>{
      if(!openStack.includes(m)) openStack.push(m);
    });
    applyStack();
  }

  function install(){
    scan();

    new MutationObserver(records=>{
      let found=false;
      for(const rec of records){
        for(const node of rec.addedNodes||[]){
          if(node?.nodeType!==1) continue;
          if(node.matches?.('.modal')){ observe(node); found=true; }
          node.querySelectorAll?.('.modal').forEach(m=>{ observe(m); found=true; });
        }
      }
      if(found) scan();
    }).observe(document.documentElement,{childList:true,subtree:true});

    document.addEventListener('pointerdown',event=>{
      const modal=event.target?.closest?.('.modal.show');
      if(modal && modal!==currentTop) bringToFront(modal);
    },true);

    window.addEventListener('resize',applyStack,{passive:true});
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',install,{once:true});
  }else{
    install();
  }

  window.bringModalToFrontV499=function(idOrElement){
    const modal=typeof idOrElement==='string'
      ?document.getElementById(idOrElement)
      :idOrElement;
    if(modal) bringToFront(modal);
  };

  // Refuerzo para las ventanas auxiliares de Nueva solicitud.
  function liftRequestSearch(){
    requestAnimationFrame(()=>{
      const modal=document.getElementById('requestSearchModal');
      if(isShown(modal)) bringToFront(modal);
    });
  }

  const originalOpenSource=window.openRequestSourceFromNew;
  if(typeof originalOpenSource==='function'){
    window.openRequestSourceFromNew=function(){
      const result=originalOpenSource.apply(this,arguments);
      liftRequestSearch();
      return result;
    };
  }

  const originalSearchModal=window.openRequestSearchModal;
  if(typeof originalSearchModal==='function'){
    window.openRequestSearchModal=function(){
      const result=originalSearchModal.apply(this,arguments);
      liftRequestSearch();
      return result;
    };
  }
})();
</script>


<style id="v500-digital-total-and-request-child-style">
/* =========================================================
   V500 · COPIA DIGITAL ATENDIDA = ENTREGA TOTAL
   + ventana auxiliar de ingreso sin superposición
   ========================================================= */
#requestsTable tr.v500-digital-total-row td{
  background:#eef8f0!important;
  color:#1f5131!important;
}
#requestsTable tr.v500-digital-total-row:hover td{
  background:#e4f3e8!important;
}
#requestsTable tr.v500-digital-total-row td:first-child{
  box-shadow:inset 4px 0 0 #4f8a62;
}

/* Cuando se abre Agregar manualmente / Buscar / Excel, la ventana padre
   se conserva en memoria pero deja de mostrarse para evitar cualquier
   superposición visual. */
#newRequestModal.v500-suspended-by-child{
  display:none!important;
}
#requestSearchModal.show{
  position:fixed!important;
  inset:0!important;
  width:100vw!important;
  height:100vh!important;
  margin:0!important;
  padding:10px!important;
  display:flex!important;
  align-items:flex-start!important;
  justify-content:center!important;
  overflow:auto!important;
  background:rgba(9,30,53,.72)!important;
  z-index:2147483500!important;
  box-sizing:border-box!important;
}
#requestSearchModal.show > .modal-box{
  width:min(980px,calc(100vw - 20px))!important;
  max-width:980px!important;
  min-width:0!important;
  max-height:calc(100vh - 20px)!important;
  margin:0 auto!important;
  padding:15px!important;
  overflow:auto!important;
  box-sizing:border-box!important;
  border-radius:14px!important;
}
#requestSearchModal .modal-head{
  position:sticky!important;
  top:-1px!important;
  z-index:10!important;
  background:#fff!important;
  padding-bottom:10px!important;
