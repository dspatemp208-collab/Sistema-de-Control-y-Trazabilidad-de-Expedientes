}
#v572AttentionMailPanel .v572-selected-head{
  display:flex;align-items:center;justify-content:space-between;gap:8px;
  padding:8px 10px;border-bottom:1px solid #dbe5ef;background:#eef5fb
}
#v572AttentionMailPanel .v572-selected-head b{
  font-size:10px;text-transform:uppercase;color:#315b82;letter-spacing:.03em
}
#v572AttentionMailPanel .v572-selected-body{
  display:flex;flex-direction:column;gap:6px;padding:7px;max-height:150px;overflow:auto
}
#v572AttentionMailPanel .v572-selected-item{
  display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:8px;
  padding:7px 8px;border:1px solid #d7e2ed;border-radius:8px;background:#fff
}
#v572AttentionMailPanel .v572-selected-item b{
  display:block;font-size:10px;color:#173b61;white-space:nowrap;overflow:hidden;text-overflow:ellipsis
}
#v572AttentionMailPanel .v572-selected-item small{
  display:block;margin-top:2px;font-size:9px;color:#64748b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis
}
#v572AttentionMailPanel .v572-remove{
  border:1px solid #d7e2ed;background:#fff;color:#64748b;width:28px;height:28px;
  border-radius:7px;font-size:16px;line-height:1;cursor:pointer
}
