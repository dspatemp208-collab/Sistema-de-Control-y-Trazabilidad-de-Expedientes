            <tr><th>Llamadas &gt; 1 s</th><td id="v605Slow1Local">0</td><th>Llamadas &gt; 2 s</th><td id="v605Slow2Local">0</td></tr>
            <tr><th>RPC</th><td id="v605RpcCalls">0</td><th>REST / Functions / Auth</th><td id="v605OtherCalls">0</td></tr>
            <tr><th>Pulsos en reposo</th><td id="v605IdlePulses">0</td><th>Ráfagas por cambios</th><td id="v605ChangeBursts">0</td></tr>
            <tr><th>Control V170</th><td id="v605V170Rule">55 s mín.</td><th>Control ubicación</th><td id="v605LocationRule">115 s mín.</td></tr>
          </tbody></table>
