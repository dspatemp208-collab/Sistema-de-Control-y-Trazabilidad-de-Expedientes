}
@media(max-width:760px){
  #requestSearchModal.show{padding:5px!important}
  #requestSearchModal.show > .modal-box{
    width:calc(100vw - 10px)!important;
    max-width:none!important;
    max-height:calc(100vh - 10px)!important;
    padding:10px!important;
    border-radius:10px!important;
  }
  #requestSearchModal .form-grid{grid-template-columns:1fr!important}
  #requestSearchModal .span2,
  #requestSearchModal .span4{grid-column:span 1!important}
}
</style>
<script id="v500-digital-total-and-request-child-script">
(function(){
  'use strict';

  const up=v=>String(v??'').trim().toUpperCase();

  function isDigitalV500(r){
    return up(r?.modalidad)==='COPIA DIGITAL';
  }

  function digitalCompletedV500(r){
    if(!isDigitalV500(r))return false;
    const raw=up(r?.estado_atencion||r?.estado||'');
    if(raw==='COPIA DIGITAL ENTREGADA' || raw==='ENTREGA TOTAL')return true;
    const total=Math.max(0,Number(r?.total_expedientes||0));
    const attended=Math.max(0,Number(r?.atendidos||0));
    const receive=Math.max(0,Number(r?.devoluciones_pendientes||0));
    return total>0 && attended>=total && receive===0;
  }

  window.requestEffectiveStateV500=function(r){
    return digitalCompletedV500(r)
      ?'ENTREGA TOTAL'
      :(r?.estado_atencion||r?.estado||'');
  };

  // El estado técnico persistente se presenta al usuario con la misma
  // nomenclatura del resto de solicitudes completamente atendidas.
  const stateNameBase=window.requestStateDisplayName;
  if(typeof stateNameBase==='function'){
    window.requestStateDisplayName=function(value){
      if(up(value)==='COPIA DIGITAL ENTREGADA')return 'ENTREGA TOTAL';
      return stateNameBase.apply(this,arguments);
    };
  }

  const attentionCellBase=window.requestAttentionCellHtml;
  if(typeof attentionCellBase==='function'){
    window.requestAttentionCellHtml=function(r){
      if(digitalCompletedV500(r)){
        return '<span class="status-attn total">ENTREGA TOTAL</span>';
      }
      return attentionCellBase.apply(this,arguments);
    };
  }

  const workflowBase=window.requestWorkflowAction;
  if(typeof workflowBase==='function'){
    window.requestWorkflowAction=function(r){
      if(digitalCompletedV500(r)){
        const id=String(r?.id||'');
        return `<button class="btn secondary small" onclick="openRequestDetail('${id}')">Ver copia</button>`;
      }
      return workflowBase.apply(this,arguments);
    };
  }

  function paintDigitalTotalsV500(){
    const table=document.querySelector('#requestsTable table');
    if(!table)return;
    const heads=Array.from(table.querySelectorAll('thead th')).map(th=>up(th.textContent));
    const modalIdx=heads.findIndex(x=>x==='MODALIDAD');
    const stateIdx=heads.findIndex(x=>x==='ESTADO');
    if(modalIdx<0||stateIdx<0)return;
    table.querySelectorAll('tbody tr').forEach(tr=>{
      const cells=tr.children;
      const modal=up(cells[modalIdx]?.textContent||'');
      const state=up(cells[stateIdx]?.textContent||'');
      tr.classList.toggle(
        'v500-digital-total-row',
        modal.includes('COPIA DIGITAL') && state.includes('ENTREGA TOTAL')
      );
    });
  }

  const renderRequestsBase=window.renderRequests;
  if(typeof renderRequestsBase==='function'){
    window.renderRequests=function(){
      const result=renderRequestsBase.apply(this,arguments);
      requestAnimationFrame(paintDigitalTotalsV500);
      return result;
    };
  }

  // ===== Ventana auxiliar de Nueva solicitud =====
  function suspendParentV500(){
    const parent=document.getElementById('newRequestModal');
    const child=document.getElementById('requestSearchModal');
    if(parent?.classList.contains('show') && child?.classList.contains('show')){
      parent.classList.add('v500-suspended-by-child');
      child.style.setProperty('z-index','2147483500','important');
      child.scrollTop=0;
      const box=child.querySelector('.modal-box');
      if(box)box.scrollTop=0;
      setTimeout(()=>document.getElementById('requestLookupInput')?.focus(),60);
    }
  }

  function restoreParentV500(){
    const parent=document.getElementById('newRequestModal');
    parent?.classList.remove('v500-suspended-by-child');
    if(parent?.classList.contains('show')){
      requestAnimationFrame(()=>{
        const box=parent.querySelector('.modal-box');
        if(box)box.scrollTop=0;
      });
    }
  }

  const openSourceBase=window.openRequestSourceFromNew;
  if(typeof openSourceBase==='function'){
    window.openRequestSourceFromNew=function(){
      const result=openSourceBase.apply(this,arguments);
      requestAnimationFrame(suspendParentV500);
      setTimeout(suspendParentV500,40);
      return result;
    };
  }

  const openSearchBase=window.openRequestSearchModal;
  if(typeof openSearchBase==='function'){
    window.openRequestSearchModal=function(){
      const result=openSearchBase.apply(this,arguments);
      requestAnimationFrame(suspendParentV500);
      return result;
    };
  }

  const closeSearchBase=window.closeRequestSearchModal;
  if(typeof closeSearchBase==='function'){
    window.closeRequestSearchModal=function(){
      const result=closeSearchBase.apply(this,arguments);
      restoreParentV500();
      return result;
    };
  }

  // Si por cualquier ruta se cierra el hijo, restaurar el padre.
  const child=document.getElementById('requestSearchModal');
  if(child){
    let previous=child.classList.contains('show');
    new MutationObserver(()=>{
      const shown=child.classList.contains('show');
      if(previous && !shown)restoreParentV500();
      if(!previous && shown)requestAnimationFrame(suspendParentV500);
      previous=shown;
    }).observe(child,{attributes:true,attributeFilter:['class']});
  }

  // Refuerzo visual del detalle: el estado general debe decir ENTREGA TOTAL.
  function normalizeDigitalDetailV500(){
    const req=window.currentRequest;
    if(!digitalCompletedV500(req))return;
    const state=document.getElementById('rqDState');
    if(state)state.innerHTML='<span class="status-attn total">ENTREGA TOTAL</span>';
  }
  document.addEventListener('click',()=>setTimeout(normalizeDigitalDetailV500,80),true);
  window.addEventListener('load',()=>{
    paintDigitalTotalsV500();
    normalizeDigitalDetailV500();
  });
})();
</script>


<style id="v501-multi-request-entry-style">
/* V501 · ingreso consecutivo de varios expedientes */
#requestLookupNextBtnV501{white-space:nowrap}
#requestSearchModal.v501-ready-next #requestLookupInput{
  border-color:#7ca5cc!important;
  box-shadow:0 0 0 3px rgba(31,78,120,.08)!important;
}
#requestSearchModal .v501-next-note{
  display:inline-flex;align-items:center;gap:5px;
  font-size:10px;color:#49657e;font-weight:700;
}
@media(max-width:700px){
  #requestSearchModal .modal-foot>div{width:100%;display:grid!important;grid-template-columns:1fr 1fr}
  #requestSearchModal .modal-foot .btn{width:100%;white-space:normal}
  #requestLookupContinueBtn{grid-column:1/-1}
}
</style>
<script id="v501-multi-request-entry-script">
(function(){
  'use strict';

  function byId(id){return document.getElementById(id);}

  window.prepareNextRequestLookupV501=function(message){
    try{
      if(typeof requestLookupSequence!=='undefined')requestLookupSequence++;
      if(typeof requestSearchRows!=='undefined')requestSearchRows=[];
      if(typeof requestSearchSelectedIds!=='undefined')requestSearchSelectedIds.clear();

      const input=byId('requestLookupInput');
      if(input)input.value='';

      const ext=byId('requestLookupExtension');
      if(ext){
        try{
          if(typeof setRequestExtensionDropdownV330==='function')setRequestExtensionDropdownV330([],false);
          else ext.value='';
        }catch(_){ ext.value=''; }
      }

      try{if(typeof updateRequestExtensionRequirementV265==='function')updateRequestExtensionRequirementV265();}catch(_){ }
      try{if(typeof showNewExpRequestOption==='function')showNewExpRequestOption(false);}catch(_){ }

      const results=byId('requestLookupResults');
      if(results)results.innerHTML='<div class="empty">Ingrese el siguiente expediente.</div>';

      const status=byId('requestLookupStatus');
      if(status)status.textContent=message||'Listo para ingresar otro expediente. Escriba el número y pulse Buscar o Enter.';

      const modal=byId('requestSearchModal');
      modal?.classList.add('v501-ready-next');

      try{if(typeof updateRequestLookupSelection==='function')updateRequestLookupSelection();}catch(_){ }

      requestAnimationFrame(()=>{
        input?.focus();
        input?.select?.();
      });
    }catch(error){
      console.warn('V501 · preparar siguiente expediente:',error);
    }
  };

  function syncNextButtonV501(){
    const btn=byId('requestLookupNextBtnV501');
    if(!btn)return;
    const count=(typeof requestDraftItems!=='undefined' && Array.isArray(requestDraftItems))
      ?requestDraftItems.length
      :0;
    btn.disabled=count===0;
    btn.textContent=count
      ?'+ Agregar otro expediente'
      :'+ Agregar otro expediente';
  }

  const renderDraftBase=window.renderRequestDraft;
  if(typeof renderDraftBase==='function'){
    window.renderRequestDraft=function(){
      const result=renderDraftBase.apply(this,arguments);
      syncNextButtonV501();
      return result;
    };
  }

  // Al agregar un expediente existente, limpiar automáticamente la búsqueda
  // para que el siguiente número pueda escribirse de inmediato.
  const addSelectedBase=window.addSelectedSearchResultsToDraft;
  if(typeof addSelectedBase==='function'){
    window.addSelectedSearchResultsToDraft=function(){
      const before=(typeof requestDraftItems!=='undefined' && Array.isArray(requestDraftItems))
        ?requestDraftItems.length
        :0;
      const result=addSelectedBase.apply(this,arguments);
      const after=(typeof requestDraftItems!=='undefined' && Array.isArray(requestDraftItems))
        ?requestDraftItems.length
        :0;
      syncNextButtonV501();
      if(after>before){
        setTimeout(()=>window.prepareNextRequestLookupV501(
          `${after} expediente${after===1?'':'s'} agregado${after===1?'':'s'} a la solicitud. Ingrese el siguiente.`
        ),60);
      }
      return result;
    };
  }

  // El alta de un expediente nuevo ya limpia los campos en la base; reforzar
  // foco, botón y mensaje para continuar ingresando sin cerrar.
  const addNewBase=window.openNewFirstTimeRequest;
  if(typeof addNewBase==='function'){
    window.openNewFirstTimeRequest=async function(){
      const before=(typeof requestDraftItems!=='undefined' && Array.isArray(requestDraftItems))
        ?requestDraftItems.length
        :0;
      const result=await addNewBase.apply(this,arguments);
      const after=(typeof requestDraftItems!=='undefined' && Array.isArray(requestDraftItems))
        ?requestDraftItems.length
        :0;
      syncNextButtonV501();
      if(after>before){
        setTimeout(()=>byId('requestLookupInput')?.focus(),50);
      }
      return result;
    };
  }

  // Mientras escribe un nuevo número, retirar el resalte del ciclo anterior.
  document.addEventListener('input',event=>{
    if(event.target?.id==='requestLookupInput'){
      byId('requestSearchModal')?.classList.remove('v501-ready-next');
    }
  },true);

  // Enter = búsqueda. Tras una coincidencia exacta única, V501 la deja
  // seleccionada automáticamente y habilita '+ Agregar seleccionados'.
  document.addEventListener('keydown',event=>{
    if(event.target?.id!=='requestLookupInput' || event.key!=='Enter')return;
    event.preventDefault();
    if(typeof window.searchRequestCandidates==='function')window.searchRequestCandidates();
  },true);

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',syncNextButtonV501,{once:true});
  }else{
    syncNextButtonV501();
  }
})();
</script>


<script id="v506-clear-request-lookup-cache">
(function(){
  try{ if(typeof invalidateRequestLookupCacheV187==='function')invalidateRequestLookupCacheV187(); }catch(_){}
})();
</script>

\n<script id="v507-performance-script">
(function(){
  'use strict';

  const STATE_TAB_FRESH_MS=12000;
  let statesOpenedAt=0;
  let statesOpenRefresh=null;

  function hasStateCache(){
    return !!(
      (Array.isArray(window.stateRows)&&window.stateRows.length) ||
      (Array.isArray(window.stateWorkRows)&&window.stateWorkRows.length) ||
      (Array.isArray(window.pendingAttentionRows)&&window.pendingAttentionRows.length) ||
      (Array.isArray(window.stateLoanAllRows)&&window.stateLoanAllRows.length) ||
      (Array.isArray(window.returnRequestRows)&&window.returnRequestRows.length)
    );
  }

  function markFastSwitch(id,on){
    const node=document.getElementById(id);
    if(node)node.classList.toggle('v507-fast-switch',!!on);
  }

  // Estados: al volver a la pestaña, primero pinta lo que ya está en memoria.
  // La actualización de red se hace después, sin bloquear el clic.
  window.v507OpenStates=async function(btn){
    if(typeof window.switchTab==='function')window.switchTab('states',btn);

    const cached=hasStateCache();
    if(cached){
      try{ window.renderStates?.(); }catch(_e){}
      try{
        if(window.selectedState) await window.loadStateDetail?.(window.selectedState);
      }catch(_e){}
    }

    const age=Date.now()-statesOpenedAt;
    if(cached && age<STATE_TAB_FRESH_MS)return;
    if(statesOpenRefresh)return statesOpenRefresh;

    markFastSwitch('stateDetailBox',cached);
    statesOpenRefresh=(async()=>{
      try{
        await window.loadStates?.();
        if((window.isAdmin?.()||window.isArchive?.()) && typeof window.loadReturnRequests==='function'){
          // loadStates ya carga devoluciones; esta llamada solo completa compatibilidad
          // de módulos antiguos y no bloquea la primera pintura.
          Promise.resolve(window.loadReturnRequests()).catch(()=>{});
        }
        statesOpenedAt=Date.now();
      }finally{
        markFastSwitch('stateDetailBox',false);
        statesOpenRefresh=null;
      }
    })();
    return statesOpenRefresh;
  };

  // Perfil USUARIO: la versión previa forzaba una consulta nueva en cada clic.
  // Ahora usa el cache V179/V353 existente y revalida silenciosamente.
  window.showUserCard=async function(tipo){
    if(!window.isLimitedUser?.())return;

    const search=document.getElementById('searchInput');
    if(search)search.value='';
    window.userPanelMode=tipo||'PRESTAMO';
    window.page=0;
    window.updateUserPersonalKpiUI?.();
    window.setFastPanelTransitionV244?.(window.userPanelLabel?.()||'');

    markFastSwitch('panelDetailWrap',true);
    try{
      // SIN forceFresh: loadPanel ya sabe restaurar cache y actualizar en segundo plano.
      await window.loadPanel?.({refreshCards:false});
    }finally{
      window.clearFastPanelTransitionV244?.();
      markFastSwitch('panelDetailWrap',false);
    }
    document.getElementById('panelTable')?.scrollIntoView({behavior:'auto',block:'start'});
  };

  // No repetir una misma apertura de tarjeta mientras la anterior todavía procesa.
  const baseShowKpi=window.showKpiExpedientes;
  let kpiSwitchPromise=null;
  let kpiSwitchKey='';
  if(typeof baseShowKpi==='function'){
    window.showKpiExpedientes=function(tipo){
      const key=String(tipo||'');
      if(kpiSwitchPromise && kpiSwitchKey===key)return kpiSwitchPromise;
      kpiSwitchKey=key;
      markFastSwitch('panelDetailWrap',true);
      kpiSwitchPromise=Promise.resolve(baseShowKpi.apply(this,arguments))
        .finally(()=>{
          markFastSwitch('panelDetailWrap',false);
          kpiSwitchPromise=null;
          kpiSwitchKey='';
        });
      return kpiSwitchPromise;
    };
  }

  // Clic repetido sobre la misma tarjeta de Estados: ignorar duplicados muy rápidos.
  const baseLoadStateDetail=window.loadStateDetail;
  let lastStateKey='';
  let lastStateClickAt=0;
  let stateDetailPromise=null;
  if(typeof baseLoadStateDetail==='function'){
    window.loadStateDetail=function(estado){
      const key=String(estado||'');
      const now=Date.now();
      if(stateDetailPromise && key===lastStateKey && (now-lastStateClickAt)<600){
        return stateDetailPromise;
      }
      lastStateKey=key;
      lastStateClickAt=now;
      stateDetailPromise=Promise.resolve(baseLoadStateDetail.apply(this,arguments))
        .finally(()=>{stateDetailPromise=null;});
      return stateDetailPromise;
    };
  }

  window.v507PerformanceInfo=function(){
    return {
      version:'V507',
      states_cache_first:true,
      user_cards_use_existing_cache:true,
      request_search_debounce_ms:180,
      panel_search_debounce_ms:'100-260 según perfil'
    };
  };
})();
</script>\n


<style id="v508-states-no-empty-space-style">
/* =========================================================
   V508 · ESTADOS SIN ESPACIOS VACÍOS INFERIORES
   El módulo termina visualmente al finalizar su contenido.
   ========================================================= */
body.produce-staff #tab-states,
body.produce-user #tab-states,
body.produce-coordinator #tab-states{
  height:auto!important;
  min-height:0!important;
  max-height:none!important;
  padding-bottom:0!important;
  margin-bottom:0!important;
  background:transparent!important;
}
body.produce-staff #tab-states #stateDetailBox,
body.produce-user #tab-states #stateDetailBox,
body.produce-coordinator #tab-states #stateDetailBox{
  height:auto!important;
  min-height:0!important;
  max-height:none!important;
  margin-bottom:0!important;
  padding-bottom:0!important;
  overflow:visible!important;
}
body.produce-staff #tab-states #stateDetailTable,
