<script id="v527-human-state-cards-script">
(function(){
  'use strict';

  function humanStateNameV527(state){
    const s=String(state||'').toUpperCase().trim();
    if(s==='PENDIENTE POR ATENDER')return 'Por atender';
    if(s==='EN PRÉSTAMO' || s==='PRÉSTAMOS')return 'En préstamo';
    if(s==='REASIGNADOS' || s==='REASIGNADO')return 'Reasignados';
    if(s==='SOLICITUDES DE DEVOLUCIÓN')return 'Por recibir';
    if(s==='DEVUELTOS AL ARCHIVO')return 'De vuelta en Archivo';
    return typeof stateDisplayName==='function'?stateDisplayName(state):state;
  }

  function humanStateMetaV527(state){
    const s=String(state||'').toUpperCase().trim();
    if(s==='PENDIENTE POR ATENDER')return 'Solicitudes que Archivo aún debe preparar.';
    if(s==='EN PRÉSTAMO' || s==='PRÉSTAMOS')return 'Expedientes actualmente en manos de un usuario.';
    if(s==='REASIGNADOS' || s==='REASIGNADO')return 'Expedientes que cambiaron de responsable.';
    if(s==='SOLICITUDES DE DEVOLUCIÓN')return 'Devoluciones que Archivo aún debe recibir.';
    if(s==='DEVUELTOS AL ARCHIVO')return 'Expedientes que ya regresaron a custodia de Archivo.';
    return '';
  }

  if(typeof renderStates==='function'){
    renderStates=function(){
      if(!el('stateGrid'))return;
      const q='';

      const card=(x)=>{
        const stateArg=x.estado.replace(/\\/g,'\\\\').replace(/'/g,"\\'");
        return `<div class="card state-card ${selectedState===x.estado?'selected':''}" onclick="loadStateDetail('${stateArg}')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();loadStateDetail('${stateArg}')}" role="button" tabindex="0" title="Ver ${esc(humanStateNameV527(x.estado))}">
          <div class="state-name">${esc(humanStateNameV527(x.estado))}</div>
          <div class="state-count">${Number(x.total||0)}</div>
          <div class="state-meta">${esc(humanStateMetaV527(x.estado))}</div>
          <div class="state-progress"><span></span></div>
          <div class="state-card-actions"></div>
        </div>`;
      };

      const physicalByState=new Map((stateRows||[]).map(x=>[x.estado,x]));
      const workByState=new Map((stateWorkRows||[]).map(x=>[x.estado,x]));
      const returnName='SOLICITUDES DE DEVOLUCIÓN';
      const showReturn=(isAdmin()||isArchive())&&(!q||norm(returnName).includes(q));
      const orderedCards=[];

      const pendingCard=workByState.get('PENDIENTE POR ATENDER');
      if(pendingCard&&(!q||norm(pendingCard.estado).includes(q)))orderedCards.push(card(pendingCard));

      const loanCard=physicalByState.get('EN PRÉSTAMO');
      if(loanCard&&(!q||norm(loanCard.estado).includes(q)))orderedCards.push(card(loanCard));

      const reassignedCard=physicalByState.get('REASIGNADOS');
      if(reassignedCard&&(!q||norm(reassignedCard.estado).includes(q)))orderedCards.push(card(reassignedCard));

      if(showReturn){
        orderedCards.push(`<div class="card state-card ${selectedState===returnName?'selected':''}" onclick="loadStateDetail('SOLICITUDES DE DEVOLUCIÓN')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();loadStateDetail('SOLICITUDES DE DEVOLUCIÓN')}" role="button" tabindex="0" title="Ver devoluciones pendientes de recepción">
          <div class="state-name">Por recibir</div>
          <div class="state-count">${returnRequestRows.length||0}</div>
          <div class="state-meta">Devoluciones que Archivo aún debe recibir.</div>
          <div class="state-progress"><span></span></div>
          <div class="state-card-actions"></div>
        </div>`);
      }

      const returnedCard=physicalByState.get('DEVUELTOS AL ARCHIVO');
      if(returnedCard&&(!q||norm(returnedCard.estado).includes(q)))orderedCards.push(card(returnedCard));

      el('stateGrid').innerHTML=orderedCards.join('')||'<div class="empty">No hay estados para mostrar en este momento.</div>';
    };
    window.renderStates=renderStates;

    try{
      if(document.getElementById('stateGrid'))renderStates();
    }catch(e){
      console.warn('V527 · No se pudo refrescar tarjetas al cargar:',e);
    }
  }
})();
</script>



<!-- =========================================================
     V529 · PERFIL USUARIO · COPIAS DIGITALES CON ESTADO REAL
     Corrige Mis solicitudes para leer el detalle digital entregado.
     ========================================================= -->
<script id="v529-user-digital-real-state-script">
(function(){
  'use strict';

  const up=v=>String(v??'').trim().toUpperCase();
  const digitalCache=new Map();
  const CACHE_MS=30000;

  function isUserProfile(){
    try{return typeof isLimitedUser==='function' && isLimitedUser();}
    catch(_){return false;}
  }

  function requestIdOf(r){
    return String(r?.id||r?.solicitud_id||'').trim();
  }

  async function fetchDigitalDetail(id,force=false){
    const now=Date.now();
    const cached=digitalCache.get(id);
    if(!force && cached && now-cached.at<CACHE_MS)return cached.rows;

    const {data,error}=await sb.rpc('v488_detalle_copias_digitales',{
      p_solicitud_id:id
    });
    if(error)throw error;

    const rows=Array.isArray(data)?data:[];
    digitalCache.set(id,{at:now,rows});
    return rows;
  }

  function isDeliveredItem(r){
    return up(r?.estado_copia)==='ENTREGADA' ||
      up(r?.estado_item)==='COPIA DIGITAL ENTREGADA' ||
      !!String(r?.enlace||'').trim();
  }

  function summarizeDigital(rows){
    const total=rows.length;
    const delivered=rows.filter(isDeliveredItem).length;
    const pending=Math.max(total-delivered,0);
    const attendants=[...new Set(rows
      .map(r=>String(r?.atendido_por||'').trim())
      .filter(Boolean))];

    return {
      total,
      delivered,
      pending,
      state: total>0 && delivered>=total
        ?'ENTREGA TOTAL'
        :(delivered>0?'ENTREGA PARCIAL':'PENDIENTE POR ATENDER'),
      attendant:attendants.length===1?attendants[0]:(attendants.length>1?'VARIOS':'')
    };
  }

  function applySummaryToHeader(header,summary){
    if(!header||up(header.modalidad)!=='COPIA DIGITAL'||!summary)return;

    header.total_expedientes=summary.total||Number(header.total_expedientes||0);
    header.atendidos=summary.delivered;
    header.devoluciones_pendientes=0;
    header._v488_copias_pendientes=summary.pending;
    header._v529_digital_state_real=true;

    if(summary.total>0){
      header.estado_atencion=summary.state;
    }

    if(summary.attendant){
      header.atiende_requerimiento=summary.attendant;
      header.atiende=summary.attendant;
    }

    // Una copia digital nunca genera préstamo físico ni cargo.
    header.cargo_numero=null;
    header.fechas_entrega_prestamo=[];
  }

  function allKnownRequestLists(){
    const lists=[];
    try{if(Array.isArray(requestRows))lists.push(requestRows);}catch(_){ }
    try{
      if(typeof requestViewCache!=='undefined' && Array.isArray(requestViewCache?.rows)){
        lists.push(requestViewCache.rows);
      }
    }catch(_){ }
    return lists;
  }

  async function hydrateUserDigitalRequestsV529(force=false){
    if(!isUserProfile() || !sb)return false;

    const lists=allKnownRequestLists();
    const byId=new Map();

    lists.forEach(list=>list.forEach(r=>{
      if(up(r?.modalidad)!=='COPIA DIGITAL')return;
      const id=requestIdOf(r);
      if(!id)return;
      const arr=byId.get(id)||[];
      arr.push(r);
      byId.set(id,arr);
    }));

    if(!byId.size)return false;

    const ids=[...byId.keys()];
    let changed=false;

    // Lotes pequeños para no saturar Supabase si el usuario tiene muchas solicitudes.
    for(let i=0;i<ids.length;i+=4){
      const batch=ids.slice(i,i+4);
      const results=await Promise.all(batch.map(async id=>{
        try{
          return {id,rows:await fetchDigitalDetail(id,force)};
        }catch(error){
          console.warn('V529 · detalle digital',id,error?.message||error);
          return {id,rows:null};
        }
      }));

      results.forEach(({id,rows})=>{
        if(!Array.isArray(rows)||!rows.length)return;
        const summary=summarizeDigital(rows);
        (byId.get(id)||[]).forEach(header=>applySummaryToHeader(header,summary));
        changed=true;
      });
    }

    return changed;
  }

  window.hydrateUserDigitalRequestsV529=hydrateUserDigitalRequestsV529;

  // Envolver la carga FINAL de solicitudes para que el usuario vea el estado
  // digital real antes del último renderizado.
  const previousLoadRequests=window.loadRequests;
  if(typeof previousLoadRequests==='function'){
    window.loadRequests=async function(){
      const result=await previousLoadRequests.apply(this,arguments);

      if(isUserProfile()){
        const changed=await hydrateUserDigitalRequestsV529(false);
        if(changed && typeof window.renderRequests==='function'){
          window.renderRequests();
        }
      }
      return result;
    };
  }

  // Si la pestaña ya estaba cargada al iniciar esta versión, sincronizarla una vez.
  setTimeout(async()=>{
    try{
      if(!isUserProfile())return;
      const changed=await hydrateUserDigitalRequestsV529(false);
      if(changed && typeof window.renderRequests==='function')window.renderRequests();
    }catch(error){
      console.warn('V529 · sincronización inicial:',error?.message||error);
    }
  },350);
})();
</script>



<style id="v530-user-trace-search-style">
/* =========================================================
   V530 · BUSCADOR PERSONAL DE TRAZABILIDAD TOTAL
   Visible en MIS EXPEDIENTES para perfil USUARIO.
   ========================================================= */
#v530UserTraceSearch{
  display:none;
