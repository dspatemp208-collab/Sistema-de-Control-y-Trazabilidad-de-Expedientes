<script id="v431-safe-lawyer-redirect">
(function(){
  function v431RedirectIfNeeded(){
    try{
      var app=document.querySelector('.app.role-admin');
      if(!app)return;
      var law=document.getElementById('tab-requestsByLawyer');
      if(law && !law.classList.contains('hidden')){
        var panel=document.querySelector('.tabs .tab[data-tab="panel"]');
        if(panel) panel.click();
      }
    }catch(e){ console.warn('V431:', e && e.message ? e.message : e); }
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',v431RedirectIfNeeded,{once:true});
  else v431RedirectIfNeeded();
  window.addEventListener('load',v431RedirectIfNeeded,{once:true});
})();
</script>
