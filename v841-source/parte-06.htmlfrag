.v571-selected-person b > .v593-requester-badge{
  margin-left:0!important;
  flex:0 0 auto!important;
}
</style>


<script id="v593-requester-badge-script">
(function(){
  'use strict';

  function updateRequesterBadge(){
    const box=document.getElementById('v560RequestMailRecipients');
    if(!box)return;

    box.querySelectorAll('.v580-self-badge').forEach(badge=>{
      badge.textContent='QUIEN SOLICITA';
      badge.classList.add('v593-requester-badge');
    });
  }

  function boot(){
    updateRequesterBadge();

    const box=document.getElementById('v560RequestMailRecipients');
    if(box){
      new MutationObserver(()=>setTimeout(updateRequesterBadge,0))
        .observe(box,{childList:true,subtree:true});
    }

    let tries=0;
    const timer=setInterval(()=>{
      updateRequesterBadge();
      tries++;
      if(tries>=30)clearInterval(timer);
    },300);
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',boot,{once:true});
  }else{
    boot();
  }

  try{
    console.info('V593 · Nueva solicitud identifica al usuario como QUIEN SOLICITA');
  }catch(_){}
})();
</script>




