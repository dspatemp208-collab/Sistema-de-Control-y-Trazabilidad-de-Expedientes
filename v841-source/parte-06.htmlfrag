<script id="v512-user-cards-content-fix">
(function(){
  'use strict';

  let cardOpenPromiseV512=null;
  let cardOpenKeyV512='';

  async function showUserCardV512(tipo){
    if(typeof isLimitedUser==='function' && !isLimitedUser())return;

    const key=String(tipo||'PRESTAMO');
    if(cardOpenPromiseV512 && cardOpenKeyV512===key)return cardOpenPromiseV512;

    cardOpenKeyV512=key;
    cardOpenPromiseV512=(async()=>{
      const search=document.getElementById('searchInput');
      if(search)search.value='';

      /* CRÍTICO: userPanelMode es un binding global léxico (let), no una
         propiedad de window. V507 escribía window.userPanelMode y por eso
         el detalle podía permanecer en la tarjeta anterior. */
      userPanelMode=key;
      try{ window.userPanelMode=userPanelMode; }catch(_e){}
      page=0;

      if(typeof updateUserPersonalKpiUI==='function')updateUserPersonalKpiUI();
      if(typeof setFastPanelTransitionV244==='function'){
        let label='';
        try{ label=typeof userPanelLabel==='function'?userPanelLabel():''; }catch(_e){}
        setFastPanelTransitionV244(label);
      }

      const wrap=document.getElementById('panelDetailWrap');
      wrap?.classList.add('v507-fast-switching');

      try{
        if(typeof loadPanel==='function')await loadPanel({refreshCards:false,forceFresh:true});
      }finally{
        if(typeof clearFastPanelTransitionV244==='function')clearFastPanelTransitionV244();
        wrap?.classList.remove('v507-fast-switching');
      }

      /* Mover la vista al encabezado del detalle, no al interior de la tabla. */
      (document.getElementById('panelDetailWrap')||document.getElementById('panelTable'))
        ?.scrollIntoView({behavior:'auto',block:'start'});
    })();

    try{return await cardOpenPromiseV512;}
    finally{
      cardOpenPromiseV512=null;
      cardOpenKeyV512='';
    }
  }

  /* Sobrescribir la versión V507 defectuosa y el handler global usado por onclick. */
  showUserCard=showUserCardV512;
  window.showUserCard=showUserCardV512;

  function normalizeUserCardsV512(){
    const grid=document.getElementById('userPersonalKpis');
    if(!grid)return;
    grid.querySelectorAll('.kpi').forEach(card=>{
      card.setAttribute('role','button');
      if(!card.hasAttribute('tabindex'))card.setAttribute('tabindex','0');
    });
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',normalizeUserCardsV512,{once:true});
  }else normalizeUserCardsV512();
})();
</script>



<style id="v513-global-wheel-style">
/* V513 · La rueda del mouse funciona desde cualquier zona de la interfaz. */
html,body{overscroll-behavior-y:none}
.modal.show{overscroll-behavior:contain}
</style>
<script id="v513-global-wheel-script">
(function(){
  'use strict';

  function isVisible(elm){
    if(!elm || !(elm instanceof Element)) return false;
    const st=getComputedStyle(elm);
    return st.display!=='none' && st.visibility!=='hidden';
  }

  function canScrollVertically(elm,delta){
    if(!elm || elm===document.body || elm===document.documentElement) return false;
    const st=getComputedStyle(elm);
    const oy=st.overflowY;
    if(!['auto','scroll','overlay'].includes(oy)) return false;
    if(elm.scrollHeight<=elm.clientHeight+1) return false;
    if(delta<0) return elm.scrollTop>0;
    if(delta>0) return elm.scrollTop+elm.clientHeight<elm.scrollHeight-1;
    return false;
  }

  function nearestVerticalScroller(start,delta,limit){
    let node=start instanceof Element ? start : start?.parentElement;
    while(node && node!==limit && node!==document.body && node!==document.documentElement){
      /* Las tablas usan scroll horizontal; solo toman la rueda si además
         tienen desplazamiento vertical real. */
      if(canScrollVertically(node,delta)) return node;
      node=node.parentElement;
    }
    if(limit && canScrollVertically(limit,delta)) return limit;
    return null;
  }

  function topOpenModal(){
    const open=[...document.querySelectorAll('.modal.show')].filter(isVisible);
    if(!open.length) return null;
    return open.sort((a,b)=>{
      const za=parseInt(getComputedStyle(a).zIndex,10)||0;
      const zb=parseInt(getComputedStyle(b).zIndex,10)||0;
      return zb-za;
    })[0];
  }

  document.addEventListener('wheel',function(ev){
    if(ev.defaultPrevented || ev.ctrlKey || ev.metaKey || ev.shiftKey) return;
    if(!Number.isFinite(ev.deltaY) || Math.abs(ev.deltaY)<0.01) return;

    const modal=topOpenModal();
    if(modal){
      const box=modal.querySelector('.modal-box') || modal;
      const internal=nearestVerticalScroller(ev.target,ev.deltaY,box);
      const target=internal || (canScrollVertically(box,ev.deltaY)?box:null);
      if(target){
        target.scrollTop += ev.deltaY;
        ev.preventDefault();
      }
      return;
    }

    /* Si el cursor está sobre un bloque interno con scroll vertical real,
       se desplaza ese bloque. De lo contrario, se desplaza toda la página. */
    const internal=nearestVerticalScroller(ev.target,ev.deltaY,null);
    if(internal && !internal.classList.contains('sidebar')){
      internal.scrollTop += ev.deltaY;
      ev.preventDefault();
      return;
    }

    const page=document.scrollingElement || document.documentElement;
    if(page){
      const before=page.scrollTop;
      page.scrollTop += ev.deltaY;
      if(page.scrollTop!==before) ev.preventDefault();
    }
  },{passive:false,capture:true});
})();
</script>


<style id="v514-neutral-background-style">
/* =========================================================
   V514 · PALETA NEUTRA INSTITUCIONAL
   Fondo claro; el color queda reservado a estados y alertas.
   ========================================================= */
:root{
  --v514-page:#eef3f7;
  --v514-main:#f5f7fa;
  --v514-surface:#ffffff;
  --v514-soft:#f8fafc;
  --v514-line:#d8e2ec;
}

html,body{
  background:var(--v514-page)!important;
}
