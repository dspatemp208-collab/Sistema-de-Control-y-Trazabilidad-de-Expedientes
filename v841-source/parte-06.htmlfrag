        </div>
      </div>
    </details>
  </div>
</div>
<script id="v605-health-monitor">
(function(){
  'use strict';

  const monitor={samples:[],longTasks:[],server:null,serverAt:0,serverBusy:false,opened:false};
  const allowedRoles=new Set(['ADMINISTRADOR','ARCHIVO','COORDINADOR']);
  const $=id=>document.getElementById(id);
  const now=()=>Date.now();
  const clean=v=>String(v??'').trim();
  const upper=v=>clean(v).normalize('NFD').replace(/[̀-ͯ]/g,'').toUpperCase();
  const setText=(id,v)=>{const n=$(id);if(n)n.textContent=String(v??'—');};
  const setStateChip=(id,state,label)=>{const n=$(id);if(!n)return;n.dataset.state=state||'SIN_DATOS';n.textContent=label||prettyState(state||'SIN_DATOS');};

  function roleAllowed(){
    let role=upper($('currentRole')?.textContent||'');
    if(allowedRoles.has(role))return true;
    try{if(typeof currentProfile!=='undefined'&&currentProfile){role=upper(currentProfile.rol||currentProfile.role||'');if(allowedRoles.has(role))return true;}}catch(_){ }
    try{if(window.currentProfile){role=upper(window.currentProfile.rol||window.currentProfile.role||'');if(allowedRoles.has(role))return true;}}catch(_){ }
    try{if(typeof isAdmin==='function'&&isAdmin())return true;}catch(_){ }
    try{if(typeof isArchive==='function'&&isArchive())return true;}catch(_){ }
    try{const metaRole=upper(session?.user?.user_metadata?.rol||session?.user?.user_metadata?.role||'');if(allowedRoles.has(metaRole))return true;}catch(_){ }
    return false;
  }
  function syncVisibility(){const pill=$('v605HealthPill');if(pill)pill.style.display=roleAllowed()?'inline-flex':'none';}

  function isSupabaseResource(name){const u=clean(name).toLowerCase();return u.includes('.supabase.co/')||u.includes('/rest/v1/')||u.includes('/functions/v1/');}
  function kindOf(name){const u=clean(name).toLowerCase();if(u.includes('/rest/v1/rpc/'))return 'RPC';if(u.includes('/functions/v1/'))return 'FUNCTION';if(u.includes('/auth/v1/'))return 'AUTH';if(u.includes('/rest/v1/'))return 'REST';if(u.includes('/realtime/'))return 'REALTIME';return 'OTHER';}
  function addResource(e){if(!e||!isSupabaseResource(e.name))return;monitor.samples.push({at:performance.timeOrigin+Number(e.startTime||0),duration:Number(e.duration||0),kind:kindOf(e.name)});prune();}
  function prune(){const cut=now()-10*60*1000;monitor.samples=monitor.samples.filter(x=>x.at>=cut).slice(-600);monitor.longTasks=monitor.longTasks.filter(x=>x.at>=cut).slice(-300);}
  function initPassiveObservers(){
    try{performance.getEntriesByType('resource').forEach(addResource);}catch(_){ }
    try{const po=new PerformanceObserver(list=>list.getEntries().forEach(addResource));po.observe({entryTypes:['resource']});}catch(_){ }
    try{if(PerformanceObserver.supportedEntryTypes?.includes('longtask')){const lo=new PerformanceObserver(list=>{list.getEntries().forEach(e=>monitor.longTasks.push({at:performance.timeOrigin+Number(e.startTime||0),duration:Number(e.duration||0)}));prune();});lo.observe({entryTypes:['longtask']});}}catch(_){ }
  }

  function localSummary(){
    prune();
    const cut=now()-5*60*1000;
    const rows=monitor.samples.filter(x=>x.at>=cut);
    const durations=rows.map(x=>x.duration).filter(Number.isFinite).sort((a,b)=>a-b);
    const avg=durations.length?durations.reduce((a,b)=>a+b,0)/durations.length:0;
    const p95=durations.length?durations[Math.min(durations.length-1,Math.floor(durations.length*.95))]:0;
    const counts=rows.reduce((a,x)=>(a[x.kind]=(a[x.kind]||0)+1,a),{});
    const protection=window.v601Protection?.state||{};
    const perf=window.v602PerformanceInfo?.()||{};
    const burst=window.v603BurstControlInfo?.()||{};
    const long5=monitor.longTasks.filter(x=>x.at>=cut).length;
    return {calls:rows.length,avg,p95,slow1:durations.filter(x=>x>1000).length,slow2:durations.filter(x=>x>2000).length,counts,long5,protectionMode:clean(protection.mode||perf.proteccion||'NORMAL'),failures:Number(protection.consecutiveFailures||0),idlePulses:Number(perf.pulsos_reposo||0),changeBursts:Number(perf.rafagas_por_cambio||0),v170:Number(burst.v170_min_interval_seconds||55),location:Number(burst.location_min_interval_seconds||115)};
  }
  function localState(l){
    const mode=upper(l.protectionMode);
    if(mode==='PROTECCION'||l.failures>=5)return 'PROTECCION';
    if(l.failures>=3||l.p95>=2500||l.slow2>=3)return 'ALTA_CARGA';
    if(l.p95>=1200||l.avg>=800||l.slow1>=3)return 'PRECAUCION';
    return 'NORMAL';
  }
  function serverState(data){return upper(data?.status||'SIN_DATOS');}
  // V725 · Evaluar la carga de PostgreSQL separadamente de la cola de correos.
  // El RPC V605 suma ambos conceptos en un indicador; esta distinción evita
  // presentar los correos pendientes como saturación confirmada de la base.
  function databaseLoadState(data){
    if(!data)return 'SIN_DATOS';
    const db=data.database||{};
    const locks=Number(db.locks_waiting||0);
    const slow2=Number(db.slow_over_2s||0);
    const slow5=Number(db.slow_over_5s||0);
    const total=Number(db.total_connections||0);
    const max=Number(db.max_connections||0);
    const hit=Number(db.cache_hit_pct??100);
    let score=0;
    if(locks>0)score+=4;
    if(slow5>=3)score+=4;else if(slow5>=1)score+=2;else if(slow2>=2)score+=1;
    if(max>0&&total/max>=.85)score+=3;else if(max>0&&total/max>=.70)score+=1;
    if(hit<95)score+=2;else if(hit<99)score+=1;
    return score>=7?'PROTECCION':score>=4?'ALTA_CARGA':score>=2?'PRECAUCION':'NORMAL';
  }
  function mailBacklog(data){
    const mail=data?.mail||{};
    return Number(mail.pending||0)>=20||Number(mail.error||0)>0||Number(mail.oldest_pending_minutes||0)>=15;
  }
  const rank={NORMAL:0,PRECAUCION:1,ALTA_CARGA:2,PROTECCION:3,SIN_DATOS:-1};
  function worst(a,b){return (rank[b]??-1)>(rank[a]??-1)?b:a;}
  function prettyState(s){return ({NORMAL:'NORMAL',PRECAUCION:'PRECAUCIÓN',ALTA_CARGA:'ALTA CARGA',PROTECCION:'PROTECCIÓN',SIN_DATOS:'SIN DATOS'})[s]||s;}
  function friendlyCombined(local,server){
    if(!monitor.server)return local;
    if(server==='PROTECCION')return 'PROTECCION';
    if(server==='ALTA_CARGA')return local==='PROTECCION'?'PROTECCION':'ALTA_CARGA';
    if(server==='PRECAUCION')return (local==='PROTECCION'||local==='ALTA_CARGA')?'ALTA_CARGA':'PRECAUCION';
    if(local==='PROTECCION')return 'ALTA_CARGA';
    if(local==='ALTA_CARGA')return 'PRECAUCION';
    return local;
  }
  function setPill(state){
    const pill=$('v605HealthPill');if(pill)pill.dataset.state=state;
    setText('v605HealthPillText',prettyState(state));
    const chip=$('v607OverallChip');if(chip){chip.dataset.state=state;chip.textContent=prettyState(state);}    
    setText('v607OverallMini',prettyState(state));
  }
  function stateShortText(state,source){
    if(source==='server'){
      if(state==='NORMAL')return 'Servidor estable';
      if(state==='PRECAUCION')return 'Señales moderadas';
      if(state==='ALTA_CARGA')return 'Carga elevada';
      if(state==='PROTECCION')return 'Modo crítico';
      return 'Sin lectura';
    }
    if(state==='NORMAL')return 'Fluido';
    if(state==='PRECAUCION')return 'Leve demora';
    if(state==='ALTA_CARGA')return 'Demora alta';
    if(state==='PROTECCION')return 'Muy exigido';
    return 'Sin lectura';
  }
  function renderLocal(){
    const l=localSummary();
    const ls=localState(l);
    setText('v605LocalCalls',l.calls);
    setText('v605LocalCallsSub',`Últimos 5 min · tareas largas UI: ${l.long5}`);
    setText('v605AvgLatency',`${Math.round(l.avg)} ms`);
    setText('v605P95Latency',`P95: ${Math.round(l.p95)} ms`);
    setText('v605ProtectionMode',l.protectionMode||'NORMAL');
    setText('v605Failures',l.failures);
    setText('v605Slow1Local',l.slow1);
    setText('v605Slow2Local',l.slow2);
    setText('v605RpcCalls',Number(l.counts.RPC||0));
    setText('v605OtherCalls',Number(l.counts.REST||0)+Number(l.counts.FUNCTION||0)+Number(l.counts.AUTH||0));
    setText('v605IdlePulses',l.idlePulses);
    setText('v605ChangeBursts',l.changeBursts);
    setText('v605V170Rule',`${l.v170} s mín.`);
    setText('v605LocationRule',`${l.location} s mín.`);
    setText('v607LocalState',prettyState(ls));
    setText('v607LocalHeadline',stateShortText(ls,'local'));
    setText('v607LocalText',`Latencia promedio ${Math.round(l.avg)} ms · P95 ${Math.round(l.p95)} ms · llamadas > 2 s: ${l.slow2}.`);
    setStateChip('v607LocalChip',ls,prettyState(ls));
    const callState=l.calls>=120||l.slow2>=5?'ALTA_CARGA':l.calls>=60||l.slow1>=3?'PRECAUCION':'NORMAL';
    setStateChip('v607CallsChip',callState,l.calls>=1?`${prettyState(callState)} · ${l.calls} llamadas`:'Actividad baja');
    renderCombined();
    return l;
  }
  function renderServer(data){
    const db=data?.database||{};
    const mail=data?.mail||{};
    const ss=databaseLoadState(data);
    setText('v605ActiveQueries',db.active_client_queries??'—');
    setText('v605SlowQueries',`>2 s: ${db.slow_over_2s??'—'} · >5 s: ${db.slow_over_5s??'—'}`);
    setText('v605Connections',`${db.total_connections??'—'} / ${db.max_connections??'—'}`);
    setText('v605ConnectionsSub',`Cliente: ${db.client_connections??'—'} · activas: ${db.active_client_queries??'—'}`);
    setText('v605Locks',db.locks_waiting??'—');
    setText('v605CacheHit',`Cache hit: ${db.cache_hit_pct??'—'}%`);
    setText('v605MailPending',mail.pending??'—');
    setText('v605MailSub',`Pendientes: ${mail.pending??'—'} · errores: ${mail.error??'—'} · enviando: ${mail.sending??'—'}`);
    setText('v605ClientConnections',db.client_connections??'—');
    setText('v605TotalConnections',db.total_connections??'—');
    setText('v605ServerSlow1',db.slow_over_1s??'—');
    setText('v605ServerSlow5',db.slow_over_5s??'—');
    setText('v605MailSending',mail.sending??'—');
    setText('v605OldestMail',mail.oldest_pending_minutes!=null?`${mail.oldest_pending_minutes} min`:'—');
    const stamp=data?.sampled_at?new Date(data.sampled_at):new Date();
    setText('v605HealthStamp',`Servidor actualizado: ${stamp.toLocaleString()}`);
    setText('v607LastRead',stamp.toLocaleString());
    setText('v607ServerState',prettyState(ss));
    setText('v607ServerHeadline',stateShortText(ss,'server'));
    setText('v607ServerText',`Conexiones ${db.total_connections??'—'}/${db.max_connections??'—'} · activas ${db.active_client_queries??'—'} · bloqueos ${db.locks_waiting??'—'}.`);
    setStateChip('v607ServerChip',ss,prettyState(ss));
    const mailState=(Number(mail.error||0)>0||Number(mail.pending||0)>=20)?'PRECAUCION':'NORMAL';
    setStateChip('v607MailChip',mailState,(mail.pending||mail.error||mail.sending)?`${mailState==='PRECAUCION'?'COLA PENDIENTE':'NORMAL'} · ${mail.pending||0} correos`:'Sin cola relevante');
    renderCombined();
  }
  function renderTips(combined,local,server){
    const tips=[];
    if(!monitor.server)tips.push('Pulse “Actualizar servidor” para incorporar la lectura de Supabase y PostgreSQL.');
    if(server==='NORMAL'&&(local==='PRECAUCION'||local==='ALTA_CARGA'||local==='PROTECCION')){
      tips.push('El servidor se ve estable; la demora parece venir principalmente de este navegador o de la carga local del equipo.');
      tips.push('Evite abrir muchas pestañas del sistema a la vez y cierre otras aplicaciones pesadas si nota lentitud.');
    }
    if((server==='PRECAUCION'||server==='ALTA_CARGA'||server==='PROTECCION')&&databaseLoadState(monitor.server)!=='NORMAL'){
      tips.push('Hay señales del lado del servidor. Evite refrescar repetidamente y priorice operaciones necesarias.');
      tips.push('Si la carga persiste, revise solicitudes masivas, búsquedas amplias y cola de correos antes de continuar.');
    }
    const mail=monitor.server?.mail||{};
    if(Number(mail.pending||0)>0||Number(mail.error||0)>0)tips.push(`La cola de correos merece revisión: pendientes ${mail.pending||0}, errores ${mail.error||0}, enviando ${mail.sending||0}.`);
    const db=monitor.server?.database||{};
    if(Number(db.locks_waiting||0)>0)tips.push('Se detectaron bloqueos en base de datos; conviene detener operaciones repetitivas hasta que se normalicen.');
    const l=localSummary();
    if(l.calls>=80)tips.push(`En este equipo hubo ${l.calls} llamadas a Supabase en 5 minutos. Conviene reducir refrescos manuales innecesarios.`);
    if(combined==='NORMAL'&&tips.length===0)tips.push('La lectura actual no muestra señales importantes de saturación. Puede seguir operando normalmente.');
    const ul=$('v607HealthTips');
    if(ul)ul.innerHTML=tips.map(t=>`<li>${t}</li>`).join('');
  }
  function renderCombined(errorText=''){
    const l=localSummary();
    const ls=localState(l);
    const ss=serverState(monitor.server);
    const combined=friendlyCombined(ls,ss);
    setPill(combined);
    setText('v607LocalState',prettyState(ls));
    setText('v607ServerState',prettyState(monitor.server?databaseLoadState(monitor.server):'SIN DATOS'));
    const banner=$('v605HealthAdvice');
    const title=$('v607OverallTitle');
    const text=$('v607OverallText');
    if(banner){banner.className='v605-health-banner';}
    if(errorText){
      if(banner){banner.classList.add('warn');banner.textContent=errorText;}
      setText('v607OverallTitle','No se pudo completar una lectura del servidor');
      setText('v607OverallText','Puede seguir viendo el comportamiento local de este equipo, pero la comparación con el servidor quedó pendiente.');
      renderTips(combined,ls,ss);
      return;
    }
    if(combined==='NORMAL'){
      setText('v607OverallTitle','Estado general estable');
      setText('v607OverallText','No se observan señales relevantes de saturación. El sistema puede seguir utilizándose con normalidad.');
      if(banner)banner.textContent='Lectura actual sin alertas importantes.';
    }else if(combined==='PRECAUCION'){
      if(monitor.server&&databaseLoadState(monitor.server)==='NORMAL'&&mailBacklog(monitor.server)){
        setText('v607OverallTitle','Revisar cola de correos pendientes');
        setText('v607OverallText','PostgreSQL no presenta señales relevantes de saturación en esta lectura. La precaución corresponde principalmente a notificaciones pendientes de procesamiento o envío.');
        if(banner){banner.classList.add('warn');banner.textContent='Revise el servicio de notificaciones y los intentos de envío. No vuelva a enviar en masa: podría generar mensajes duplicados.';}
        renderTips(combined,ls,ss);
        return;
      }
      setText('v607OverallTitle',serverState(monitor.server)==='NORMAL'?'Atención ligera en este equipo':'Atención moderada en el sistema');
      setText('v607OverallText',serverState(monitor.server)==='NORMAL'?'El servidor luce estable, pero este equipo muestra algunas demoras o actividad elevada.':'Se detectaron señales moderadas de carga. Conviene operar sin refrescos innecesarios.');
      if(banner){banner.classList.add('warn');banner.textContent=serverState(monitor.server)==='NORMAL'?'La principal señal de carga parece estar en este navegador o equipo.':'Hay señales moderadas de carga; evite repetir acciones hasta que termine la lectura o el proceso en curso.';}
    }else if(combined==='ALTA_CARGA'){
      setText('v607OverallTitle',serverState(monitor.server)==='NORMAL'?'Este equipo muestra carga alta':'Carga elevada detectada');
      setText('v607OverallText',serverState(monitor.server)==='NORMAL'?'El servidor sigue estable, pero la experiencia en este equipo es pesada. Conviene reducir pestañas, filtros y acciones repetidas.':'La lectura muestra carga alta. Priorice operaciones manuales importantes y evite refrescos o consultas repetitivas.');
      if(banner){banner.classList.add('warn');banner.textContent=serverState(monitor.server)==='NORMAL'?'El problema parece concentrarse en este equipo, no en el servidor.':'Carga elevada detectada. Evite refrescos repetidos y espere a que terminen las operaciones en curso.';}
    }else{
      setText('v607OverallTitle','Protección o señal crítica detectada');
      setText('v607OverallText','Se detectó una condición crítica en el navegador o el servidor. Mantenga al mínimo las operaciones secundarias hasta normalizar el estado.');
      if(banner){banner.classList.add('bad');banner.textContent='Modo de protección o señal crítica detectada. Las consultas automáticas secundarias deberían mantenerse limitadas.';}
    }
    renderTips(combined,ls,ss);
  }

  async function refreshServer(force=false){
    if(monitor.serverBusy)return false;
    if(!window.sb&&typeof sb==='undefined')return false;
    if(!session?.user?.id){renderCombined('No hay una sesión activa para consultar el servidor.');return false;}
    if(!roleAllowed()){renderCombined('Este perfil no tiene acceso al diagnóstico del servidor.');return false;}
    if(!force&&monitor.serverAt&&now()-monitor.serverAt<15000){renderServer(monitor.server);return true;}
    monitor.serverBusy=true;
    setText('v605HealthStamp','Consultando servidor…');
    setText('v607LastRead','Consultando…');
    try{
      const client=(typeof sb!=='undefined'?sb:window.sb);
      const {data,error}=await client.rpc('v605_salud_sistema');
      if(error)throw error;
      monitor.server=Array.isArray(data)?(data[0]||{}):(data||{});
      monitor.serverAt=now();
      renderServer(monitor.server);
      return true;
    }catch(error){
      console.warn('V607 · salud servidor:',error?.message||error);
      setText('v605HealthStamp','No se pudo consultar el servidor.');
      setText('v607LastRead','No disponible');
      renderCombined('No se pudo obtener la lectura del servidor: '+(error?.message||error));
      return false;
    }finally{monitor.serverBusy=false;}
  }

  function openModal(){if(!roleAllowed())return;monitor.opened=true;$('v605HealthModal')?.classList.add('show');renderLocal();refreshServer(false);}
  function closeModal(){monitor.opened=false;$('v605HealthModal')?.classList.remove('show');}
  function diagnostic(){return {version:'V607',generated_at:new Date().toISOString(),local:localSummary(),local_state:localState(localSummary()),server:monitor.server,existing_protection:window.v601PerformanceInfo?.()||null,burst_control:window.v603BurstControlInfo?.()||null};}
  async function copyDiagnostic(){const txt=JSON.stringify(diagnostic(),null,2);try{await navigator.clipboard.writeText(txt);window.showToast?.('Diagnóstico V607 copiado.',4000);}catch(_){try{prompt('Copie el diagnóstico:',txt);}catch(__){}}}

  window.openV605HealthModal=openModal;
  window.closeV605HealthModal=closeModal;
  window.refreshV605HealthServer=refreshServer;
  window.copyV605HealthDiagnostic=copyDiagnostic;
  window.v605HealthInfo=diagnostic;

  function boot(){
    initPassiveObservers();
    syncVisibility();
    renderLocal();
    const roleNode=$('currentRole');
    if(roleNode)new MutationObserver(()=>{syncVisibility();renderLocal();}).observe(roleNode,{childList:true,subtree:true,characterData:true});
    setInterval(()=>{if(monitor.opened)renderLocal();else syncVisibility();},2500);
    window.addEventListener('online',()=>{renderLocal();if(monitor.opened)refreshServer(false);},{passive:true});
    try{console.info('V607 · monitor de salud amigable activo',diagnostic());}catch(_){ }
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>

<script id="v608-adaptive-saturation-control">
(function(){
  'use strict';
  if(window.__v608AdaptiveLoadInstalled)return;
  window.__v608AdaptiveLoadInstalled=true;

