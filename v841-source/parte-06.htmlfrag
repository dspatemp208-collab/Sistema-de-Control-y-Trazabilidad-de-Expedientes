<script id="v571-selected-recipients-script">
(function(){
  'use strict';

  const CONFIGS=[
    {id:'v560RequestMailRecipients', selector:'input[data-v560-recipient]', subject:'v560RequestMailSubject'},
    {id:'v560ReassignMailRecipients', selector:'input[data-v560-recipient]', subject:'v560ReassignMailSubject'},
    {id:'v565ReturnMailRecipients', selector:'input[data-v565-recipient]', subject:'v565ReturnMailSubject'},
    {id:'v566ConfirmRecipients', selector:'input.v566-recipient-check', subject:'v566ConfirmSubject'}
  ];

  function configByBox(box){
    return CONFIGS.find(c=>c.id===box?.id)||null;
  }

  function rowFor(check){
    return check.closest('label.v560-recipient-item, label.v566-recipient');
  }

  function detailsFor(check){
    const row=rowFor(check);
    const b=row?.querySelector('b');
    let name=String(check?.dataset?.name||'').trim();

    // Si no existe data-name, tomar solo el texto del nombre sin copiar badges.
    if(!name && b){
      const clone=b.cloneNode(true);
      clone.querySelectorAll(
        '.v580-self-badge,.v581-mail-role,.v584-mail-role,.v588-mail-role'
      ).forEach(x=>x.remove());
      name=(clone.textContent||'Destinatario').trim();
    }

    const small=(row?.querySelector('small')?.textContent||'').trim();
    const email=String(
      check?.dataset?.email ||
      (small.split('·')[0]||'')
    ).trim();

    return {
      value:String(check.value||''),
      name:name||'Destinatario',
      email:email || 'Correo autorizado',
      isSelf:!!row?.querySelector('.v580-self-badge'),
      isTarget:check?.dataset?.v585TargetAuto==='1',
      explicitRole:String(check?.dataset?.v592Role||'').toUpperCase()
    };
  }

  function panelId(cfg){
    return 'v571Selected_'+cfg.id;
  }

  function subjectHost(cfg){
    const subject=document.getElementById(cfg.subject);
    if(!subject)return null;

    if(cfg.id==='v566ConfirmRecipients'){
      return subject.closest('.v566-mail-box') || subject.parentElement;
    }

    return subject.closest('.field') || subject.parentElement;
  }

  function ensurePanel(cfg){
    const host=subjectHost(cfg);
    if(!host)return null;

    let panel=document.getElementById(panelId(cfg));
    if(panel && panel.isConnected)return panel;

    panel=document.createElement('div');
    panel.id=panelId(cfg);
    panel.className='v571-selected-panel';
    panel.innerHTML=
      '<div class="v571-selected-head">'+
        '<span class="v571-selected-title">Destinatarios seleccionados</span>'+
        '<span class="v571-selected-total">0 seleccionados</span>'+
      '</div>'+
      '<div class="v571-selected-list">'+
        '<div class="v571-selected-empty">Aún no ha seleccionado destinatarios.</div>'+
      '</div>';

    host.appendChild(panel);

    panel.addEventListener('click',function(ev){
      const btn=ev.target.closest('[data-v571-remove]');
      if(!btn)return;

      const box=document.getElementById(cfg.id);
      if(!box)return;

      const value=btn.getAttribute('data-v571-remove')||'';
      const check=[...box.querySelectorAll(cfg.selector)]
        .find(x=>String(x.value||'')===value);

      if(check){
        check.checked=false;
        check.dispatchEvent(new Event('change',{bubbles:true}));
      }
    });

    return panel;
  }

  function roleFor(cfg,d){
    const email=String(d?.email||'').trim().toLowerCase();

    // Nueva solicitud: Coordinador principal; todos los demás son CC.
    if(cfg.id==='v560RequestMailRecipients'){
      return email==='ds_pa_temp208@produce.gob.pe' ? 'TO' : 'CC';
    }

    // Reasignación: el nuevo responsable es PARA; el resto queda en CC.
    if(cfg.id==='v560ReassignMailRecipients'){
      return d?.isTarget ? 'TO' : 'CC';
    }

    // Solicitud de devolución: Coordinador principal; usuario y adicionales en CC.
    if(cfg.id==='v565ReturnMailRecipients'){
      return email==='ds_pa_temp208@produce.gob.pe' ? 'TO' : 'CC';
    }

    // Confirmación de devolución: se usa el rol marcado por la lógica del flujo.
    if(cfg.id==='v566ConfirmRecipients'){
      return d?.explicitRole==='TO' ? 'TO' : 'CC';
    }

    return 'CC';
  }

  function roleBadge(role){
    if(role==='TO'){
      const span=document.createElement('span');
      span.className='v581-mail-role v581-mail-role-to';
      span.textContent='PARA';
      return span;
    }

    const span=document.createElement('span');
    span.className='v581-mail-role v581-mail-role-cc';
    span.textContent='CC';
    return span;
  }

  function selfBadge(){
    const span=document.createElement('span');
    span.className='v580-self-badge';
    span.textContent='MI CORREO';
    return span;
  }

  function requesterBadge(){
    const span=document.createElement('span');
    span.className='v593-requester-badge';
    span.textContent='QUIEN SOLICITA';
    return span;
  }

  function render(cfg){
    const box=document.getElementById(cfg.id);
    if(!box)return;

    const panel=ensurePanel(cfg);
    if(!panel)return;

    const selected=[...box.querySelectorAll(cfg.selector)]
      .filter(x=>x.checked)
      .map(detailsFor);

    const total=panel.querySelector('.v571-selected-total');
    const list=panel.querySelector('.v571-selected-list');

    if(total){
      total.textContent=selected.length+' seleccionado'+(selected.length===1?'':'s');
    }

    if(!list)return;
    list.replaceChildren();

    if(!selected.length){
      const empty=document.createElement('div');
      empty.className='v571-selected-empty';
      empty.textContent='Aún no ha seleccionado destinatarios. Use el buscador de la izquierda para agregarlos.';
      list.appendChild(empty);
      return;
    }

    // Mostrar primero al destinatario principal y luego los CC.
    selected.sort((a,b)=>{
      const ar=roleFor(cfg,a)==='TO' ? 0 : 1;
      const br=roleFor(cfg,b)==='TO' ? 0 : 1;
      return ar-br;
    });

    selected.forEach(d=>{
      const item=document.createElement('div');
      item.className='v571-selected-item';

      const person=document.createElement('div');
      person.className='v571-selected-person';

      const name=document.createElement('b');

      const label=document.createElement('span');
      label.textContent=d.name;
      name.appendChild(label);

      // V592: cada seleccionado siempre muestra su función real.
      name.appendChild(roleBadge(roleFor(cfg,d)));

      if(d.isSelf){
        if(cfg.id==='v560RequestMailRecipients'){
          name.appendChild(requesterBadge());
        }else{
          name.appendChild(selfBadge());
        }
      }

      const email=document.createElement('small');
      email.textContent=d.email;

      person.append(name,email);

      const remove=document.createElement('button');
      remove.type='button';
      remove.className='v571-selected-remove';
      remove.title='Quitar destinatario';
      remove.setAttribute('aria-label','Quitar '+d.name);
      remove.setAttribute('data-v571-remove',d.value);
      remove.textContent='×';

      item.append(person,remove);
      list.appendChild(item);
    });
  }

  window.v797ActualizarSeleccionCorreo=function(op){
    const id=op==='REASIGNACION'?'v560ReassignMailRecipients':'v560RequestMailRecipients';
    const cfg=CONFIGS.find(c=>c.id===id);
    if(cfg)render(cfg);
  };

  const observed=new WeakSet();

  function enhance(cfg){
    const box=document.getElementById(cfg.id);
    if(!box)return;

    ensurePanel(cfg);

    if(!observed.has(box)){
      box.addEventListener('change',function(ev){
        if(ev.target?.matches?.(cfg.selector)){
          render(cfg);
        }
      });

      const obs=new MutationObserver(function(mutations){
        if(mutations.some(m=>m.type==='childList')){
          requestAnimationFrame(()=>render(cfg));
        }
      });
      obs.observe(box,{childList:true,subtree:false});
      observed.add(box);
    }

    render(cfg);
  }

  function enhanceAll(){
    CONFIGS.forEach(enhance);
  }

  document.addEventListener('click',function(ev){
    if(ev.target.closest('.v568-recipient-clear')){
      setTimeout(enhanceAll,0);
    }
  },true);

  document.addEventListener('change',function(ev){
    for(const cfg of CONFIGS){
      if(ev.target?.matches?.('#'+cfg.id+' '+cfg.selector)){
        setTimeout(()=>render(cfg),0);
        break;
      }
    }
  },true);

  function boot(){
    enhanceAll();

    // Refuerzo liviano: recrea el panel si un modal dinámico vuelve a dibujarse.
    setInterval(enhanceAll,700);
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',boot,{once:true});
  }else{
    boot();
  }
})();
</script>


<!-- =========================================================
     V572 · CORREO AL ATENDER SOLICITUDES
     - Selección manual de destinatarios autorizados.
     - Un solo correo consolidado por operación de atención.
     - Compatible con cargo nuevo y cargo existente.
     - El correo nunca revierte ni bloquea la atención.
     ========================================================= -->
<style id="v572-attention-mail-style">
