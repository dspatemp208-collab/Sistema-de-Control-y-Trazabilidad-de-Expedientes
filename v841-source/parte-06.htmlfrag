}
@media(max-width:800px){
  #v572AttentionMailPanel .v572-grid{grid-template-columns:1fr}
}
</style>

<script id="v572-attention-mail-script">
(function(){
  'use strict';

  const $=id=>document.getElementById(id);
  const txt=v=>String(v??'').trim();
  const upper=v=>txt(v).toUpperCase();
  const escLocal=v=>String(v??'').replace(/[&<>"']/g,m=>({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  }[m]));

  let recipients=[];
  let loadedRequestKey='';
  let loading=false;

  function profileName(){
    return txt(currentProfile?.nombre_personal||
               currentProfile?.email||
               session?.user?.email)||'Personal de Archivo';
  }

  function requestNumber(){
    return txt(currentRequest?.numero||
               currentRequest?.solicitud_numero||
               currentRequest?.numero_solicitud) || '';
  }

  function requestSubject(){
    return txt(currentRequest?.asunto||
               currentRequest?.asunto_solicitud) || '';
  }

  function requestRequester(){
    return txt(currentRequest?.solicitante||
               currentRequest?.nombre_solicitante||
               currentRequest?.solicitante_nombre) || '—';
  }

  function requestModality(){
    return txt(currentRequest?.modalidad)||'—';
  }


  const V584_COORD_EMAIL='ds_pa_temp208@produce.gob.pe';
  const V584_ARCHIVO_EMAILS=['agarciag@produce.gob.pe','jgradosp@produce.gob.pe'];

  function v584NormName(value){
    return txt(value)
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .replace(/[^A-Za-z0-9 ]+/g,' ')
      .replace(/\s+/g,' ')
      .trim()
      .toUpperCase();
  }

  function v584NameTokens(value){
    return v584NormName(value).split(' ').filter(x=>x.length>=2);
  }

  function v584FindByEmail(email){
    const wanted=txt(email).toLowerCase();
    return recipients.find(r=>txt(r?.email).toLowerCase()===wanted)||null;
  }

  function v584FindByName(name){
    const wanted=v584NameTokens(name);
    if(!wanted.length)return null;

    let exact=null;
    let best=null;
    let bestScore=0;

    for(const r of recipients){
      const rn=v584NormName(r?.nombre);
      if(!rn)continue;
      if(rn===v584NormName(name)){
        exact=r;
        break;
      }
      const rt=new Set(v584NameTokens(r?.nombre));
      const matches=wanted.filter(t=>rt.has(t)).length;
      const score=matches/Math.max(wanted.length,1);
      if(matches>=2 && score>bestScore){
        best=r;
        bestScore=score;
      }
    }
    return exact||best;
  }

  function v584AttendantName(){
    return txt(
      $('rqDAtiende')?.value ||
      $('rqPrepareAtiende')?.value ||
      currentRequest?.atiende ||
      currentRequest?.atiende_requerimiento ||
      profileName()
    );
  }

  function v584RequesterRecipient(){
    return v584FindByName(requestRequester());
  }

  function v584AttendantRecipient(){
    return v584FindByName(v584AttendantName());
  }

  function v584ApplyAttentionDefaults(){
    const box=$('v572AttentionRecipients');
    if(!box||!recipients.length)return;

    const requester=v584RequesterRecipient();
    const coordinator=v584FindByEmail(V584_COORD_EMAIL);
    const armando=v584FindByEmail(V584_ARCHIVO_EMAILS[0]);
    const jaime=v584FindByEmail(V584_ARCHIVO_EMAILS[1]);
    const attendant=v584AttendantRecipient();

    const wanted=new Set(
      [requester,coordinator,armando,jaime,attendant]
        .filter(Boolean)
        .map(r=>String(r.id))
    );

    const checks=[...box.querySelectorAll('input[data-v572-recipient]')];

    // Quitar solamente selecciones automáticas anteriores que ya no correspondan
    // (por ejemplo, si cambia "Atiende el requerimiento").
    checks.forEach(cb=>{
      if(cb.dataset.v584Auto==='1' && !wanted.has(String(cb.value))){
        cb.checked=false;
        delete cb.dataset.v584Auto;
      }
    });

    // Aplicar solicitante + Coordinador + Armando + Jaime + quien atiende, sin tocar adicionales manuales.
    checks.forEach(cb=>{
      if(wanted.has(String(cb.value))){
        cb.checked=true;
        cb.dataset.v584Auto='1';
      }
    });

    renderSelection();
  }

  function v584BindAttendant(){
    const el=$('rqDAtiende')||$('rqPrepareAtiende');
    if(!el||el.dataset.v584MailBound==='1')return;
    el.dataset.v584MailBound='1';
    el.addEventListener('change',()=>{
      setTimeout(v584ApplyAttentionDefaults,0);
    });
  }

  function expLabel(x){
    const e=txt(x?.expediente)||'—';
    const ext=txt(x?.extension||x?.ext);
    return ext?`${e} · Ext. ${ext}`:e;
  }

  function ensurePanel(){
    const section=$('rqAttentionSection');
    if(!section)return null;

    let panel=$('v572AttentionMailPanel');
    if(panel)return panel;

    const grid=section.querySelector('.request-unified-grid');
    if(!grid)return null;

    panel=document.createElement('div');
    panel.id='v572AttentionMailPanel';
    panel.className='v560-mail-panel';
    panel.innerHTML=`
      <div class="v560-mail-head">
        <div>
          <strong>✉ Notificación por correo de la atención</strong>
          <div class="note" style="margin-top:3px">
            Opcional. Después de registrar la atención se enviará <b>un solo correo</b>
            con todos los expedientes atendidos en esta operación.
          </div>
        </div>
        <label class="v560-mail-switch">
          <input id="v572AttentionMailEnabled" type="checkbox" checked>
          Enviar correo
        </label>
      </div>

      <div id="v572AttentionMailContent" class="v572-grid">
        <div>
          <label style="display:block;font-size:10px;font-weight:800;color:#315b82;margin-bottom:5px">
            DESTINATARIOS AUTORIZADOS
          </label>
          <div class="v572-recipient-tools">
            <input id="v572AttentionSearch" class="v572-search" type="search"
                   autocomplete="off" placeholder="Buscar por nombre, apellido o correo...">
            <span id="v572AttentionCount" class="v572-count">0 seleccionados</span>
            <button id="v572AttentionClear" class="v572-clear" type="button">Quitar selección</button>
          </div>
          <div id="v572AttentionRecipients" class="v572-list">
            <div class="v572-empty">Cargando destinatarios...</div>
          </div>
        </div>

        <div>
          <div class="field">
            <label>Asunto del correo *</label>
            <input id="v572AttentionSubject" maxlength="180"
                   placeholder="Solicitud atendida de SOLICITANTE - Asunto: ...">
          </div>

          <div class="v572-selected">
            <div class="v572-selected-head">
              <b>Destinatarios seleccionados</b>
              <span id="v572SelectedCount" class="v572-count">0 seleccionados</span>
            </div>
            <div id="v572SelectedBody" class="v572-selected-body">
              <div class="v572-empty">Aún no ha seleccionado destinatarios.</div>
            </div>
          </div>

          <div class="v584-routing-note">
            <b>PARA:</b> solicitante original ·
            <b>CC:</b> Coordinador de Archivo + quien atiende + destinatarios adicionales.
            El solicitante no se repite en CC.
          </div>
          <div id="v572AttentionMailStatus" class="note" style="margin-top:8px">
            El correo es complementario. Si el envío falla, la atención del expediente no se revierte.
          </div>
        </div>
      </div>`;

    grid.insertAdjacentElement('afterend',panel);

    $('v572AttentionMailEnabled')?.addEventListener('change',syncEnabled);
    $('v572AttentionSearch')?.addEventListener('input',applySearch);
    $('v572AttentionClear')?.addEventListener('click',()=>{
      document.querySelectorAll('#v572AttentionRecipients input[data-v572-recipient]')
        .forEach(x=>x.checked=false);
      renderSelection();
    });
    $('v572AttentionRecipients')?.addEventListener('change',ev=>{
      if(ev.target?.matches?.('input[data-v572-recipient]'))renderSelection();
    });
    $('v572SelectedBody')?.addEventListener('click',ev=>{
      const btn=ev.target.closest('[data-v572-remove]');
      if(!btn)return;
      const id=btn.getAttribute('data-v572-remove')||'';
      const cb=[...document.querySelectorAll('#v572AttentionRecipients input[data-v572-recipient]')]
        .find(x=>String(x.value)===id);
      if(cb){
        cb.checked=false;
        renderSelection();
      }
    });

    return panel;
  }

  function defaultSubject(){
    const solicitante=txt(requestRequester())||'SOLICITANTE';
    const asunto=txt(requestSubject());
    const base=`Solicitud atendida de ${solicitante}`;
    return asunto?`${base} - Asunto: ${asunto}`:base;
  }

  function syncEnabled(){
    const enabled=!!$('v572AttentionMailEnabled')?.checked;
    const content=$('v572AttentionMailContent');
    if(content){
      content.style.opacity=enabled?'1':'.55';
      content.style.pointerEvents=enabled?'auto':'none';
    }
  }

  function selectedDetails(){
    const ids=new Set(
      [...document.querySelectorAll('#v572AttentionRecipients input[data-v572-recipient]:checked')]
        .map(x=>String(x.value))
    );
    return recipients.filter(r=>ids.has(String(r.id)));
  }

  function renderSelection(){
    const selected=selectedDetails();
    const countText=`${selected.length} seleccionado${selected.length===1?'':'s'}`;
    if($('v572AttentionCount'))$('v572AttentionCount').textContent=countText;
    if($('v572SelectedCount'))$('v572SelectedCount').textContent=countText;

    const body=$('v572SelectedBody');
    if(!body)return;

    if(!selected.length){
      body.innerHTML='<div class="v572-empty">Aún no ha seleccionado destinatarios. Use el buscador para agregarlos.</div>';
      return;
    }

    const requester=v584RequesterRecipient();
    const requesterId=String(requester?.id||'');

    body.innerHTML=selected.map(r=>{
      const isTo=requesterId && String(r.id)===requesterId;
      const badge=isTo
        ? '<span class="v584-mail-role v584-mail-role-to">PARA</span>'
        : '<span class="v584-mail-role v584-mail-role-cc">CC</span>';
      return `
      <div class="v572-selected-item">
        <div>
          <b>${escLocal(r.nombre||r.email)} ${badge}</b>
          <small>${escLocal(r.email||'')}</small>
        </div>
        <button class="v572-remove" type="button" data-v572-remove="${escLocal(r.id)}"
                title="Quitar destinatario" aria-label="Quitar ${escLocal(r.nombre||r.email)}">×</button>
      </div>`;
    }).join('');
  }

  function applySearch(){
    const raw=String($('v572AttentionSearch')?.value||'')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .toUpperCase()
      .trim();

    const queryTokens=raw.split(/\s+/).filter(Boolean);

    document.querySelectorAll('#v572AttentionRecipients .v572-recipient').forEach(row=>{
      const name=String(row.querySelector('b')?.textContent||'')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g,'')
        .toUpperCase()
        .trim();

      const email=String((row.querySelector('small')?.textContent||'').split('·')[0]||'')
        .toUpperCase()
        .trim();

      const nameTokens=name.split(/\s+/).filter(Boolean);

      const byName=queryTokens.length>0 &&
        queryTokens.every(q=>nameTokens.some(token=>token.startsWith(q)));

      const byEmail=email.includes(raw);
      const visible=!raw || byName || byEmail;

      row.style.setProperty('display',visible?'grid':'none','important');
    });
  }

  function renderRecipients(){
    const box=$('v572AttentionRecipients');
    if(!box)return;

    if(!recipients.length){
      box.innerHTML='<div class="v572-empty">No hay correos activos configurados por el Administrador.</div>';
      renderSelection();
      return;
    }

    box.innerHTML=recipients.map(r=>`
      <label class="v572-recipient">
        <input type="checkbox" data-v572-recipient value="${escLocal(r.id)}">
        <span>
          <b>${escLocal(r.nombre||r.email)}</b>
          <small>${escLocal(r.email)}${r.categoria?' · '+escLocal(r.categoria):''}</small>
        </span>
      </label>`).join('');

    v584BindAttendant();
    v584ApplyAttentionDefaults();
    applySearch();
  }

  async function loadRecipients(){
    if(loading)return;
    loading=true;
    try{
      const {data,error}=await sb.rpc('v560_listar_destinatarios_correo',{p_evento:'ATENCION'});
      if(error)throw error;
      recipients=(Array.isArray(data)?data:[]).filter(x=>x?.id&&x?.email);
      renderRecipients();
    }catch(error){
      console.warn('V572 destinatarios atención:',error);
      const box=$('v572AttentionRecipients');
      if(box)box.innerHTML=`<div class="v572-empty">No se pudo cargar el catálogo: ${escLocal(error?.message||error)}</div>`;
    }finally{
      loading=false;
    }
  }

  function resetForRequest(){
    ensurePanel();
    const subject=$('v572AttentionSubject');
    if(subject)subject.value=defaultSubject();
    const enabled=$('v572AttentionMailEnabled');
    if(enabled)enabled.checked=true;
    const search=$('v572AttentionSearch');
    if(search)search.value='';
    const status=$('v572AttentionMailStatus');
    if(status){
      status.className='note';
      status.textContent='El correo es complementario. Si el envío falla, la atención del expediente no se revierte.';
    }
    syncEnabled();
    loadRecipients();
  }

  function syncPanel(){
    const panel=ensurePanel();
    const section=$('rqAttentionSection');
    if(!panel||!section)return;

    const visible=!section.classList.contains('hidden');
    if(!visible)return;

    const key=txt(currentRequestId)||requestNumber()||'SIN_ID';
    if(key!==loadedRequestKey){
      loadedRequestKey=key;
      resetForRequest();
    }else{
      syncEnabled();
      v584BindAttendant();
    }
  }

  function captureAttention(name,args){
    if(!['generar_cargo_pendiente_entrega','vincular_cargo_pendiente_entrega','v676_generar_cargo_atencion','v676_vincular_cargo_atencion'].includes(name))return null;
    if(!$('v572AttentionMailEnabled')?.checked)return null;

    const selected=selectedDetails();
    if(!selected.length){
      const status=$('v572AttentionMailStatus');
      if(status){
        status.className='note v572-error';
        status.textContent='La atención se registrará sin correo porque no seleccionó destinatarios.';
      }
      return null;
    }

    const ids=(Array.isArray(args?.p_expediente_ids)?args.p_expediente_ids:[]).map(String);
    const obsArgs=Array.isArray(args?.p_observaciones_items)?args.p_observaciones_items:[];
    const obsMap=new Map(obsArgs.map(x=>[String(x?.expediente_id||''),txt(x?.observacion)]));
    let sourceRows=(requestDetailRows||[]).filter(x=>ids.includes(String(x.expediente_id)));
    if(!sourceRows.length){
      try{
        const modalItems=JSON.parse(document.getElementById('newRequestModal')?.dataset.items||'[]');
        sourceRows=(modalItems||[]).filter(x=>ids.includes(String(x.id||x.expediente_id)));
      }catch(_){sourceRows=[]}
    }
    const rows=sourceRows.map(x=>({
        id:String(x.expediente_id||x.id||''),
        expediente:txt(x.expediente),
        extension:txt(x.extension||x.ext),
        rd:txt(x.rd),
        ultimo_folio:txt(x.ultimo_folio),
        cargo:txt(x.cargo_numero||x.cargo),
        observacion_individual:obsMap.get(String(x.expediente_id||x.id||''))||txt(x._cargo_observacion)
      }));

    return {
      operationId:(crypto?.randomUUID?.()||`${Date.now()}-${Math.random().toString(16).slice(2)}`),
      rpc:name,
      solicitudId:txt(args?.p_solicitud_id||currentRequestId),
      solicitudNumero:requestNumber(),
      solicitante:requestRequester(),
      modalidad:requestModality(),
      asuntoSolicitud:requestSubject(),
      atiende:txt(args?.p_atiende||$('rqDAtiende')?.value||currentRequest?.atiende),
      observacion:txt(args?.p_observacion||$('rqDObservacion')?.value),
      cargoExistente:txt(args?.p_cargo_numero||$('rqDCargoExistente')?.value),
      subject:txt($('v572AttentionSubject')?.value)||defaultSubject(),
      recipients:selected.map(x=>({
        id:x.id,nombre:x.nombre,email:x.email,categoria:x.categoria
      })),
      items:rows
    };
  }

  function buildBody(draft,data){
    const cargo=txt(data?.cargo_numero||data?.cargo||draft.cargoExistente);
    const lines=[
      'Se ha registrado la atención de una solicitud en el Sistema de Control y Trazabilidad de Expedientes.',
      '',
      `Solicitud: ${draft.solicitudNumero||'—'}`,
      `Solicitante: ${draft.solicitante||'—'}`,
      `Modalidad: ${draft.modalidad||'—'}`,
      `Asunto de la solicitud: ${draft.asuntoSolicitud||'—'}`,
      `Atendido por: ${draft.atiende||profileName()}`,
      ...(cargo?[`Cargo: ${cargo}`]:[]),
      `Expedientes atendidos en esta operación: ${draft.items.length}`,
      '',
      'Destinatarios notificados:',
      ...draft.recipients.map((r,i)=>`${i+1}. ${r.nombre||r.email} <${r.email}>`),
      '',
      'Expedientes atendidos:',
      ...draft.items.map((x,i)=>{
        let row=`${i+1}. ${x.expediente||x.id||'Expediente'}`;
        if(x.extension)row+=` · Ext. ${x.extension}`;
        if(x.rd)row+=` · R.D. ${x.rd}`;
        if(x.ultimo_folio)row+=` · Último folio ${x.ultimo_folio}`;
        if(x.observacion_individual)row+=`\n   Observación del expediente: ${x.observacion_individual}`;
        return row;
      }),
      ...(draft.observacion?['',`Observación general de la atención: ${draft.observacion}`]:[]),
      '',
      'La atención quedó registrada en el sistema. Revise la solicitud para consultar su estado y trazabilidad.'
    ];
    return lines.join('\n');
  }

  async function sendAttentionMail(draft,data){
    if(!draft||!draft.recipients?.length)return;

    const status=$('v572AttentionMailStatus');
    if(status){
      status.className='note';
      status.textContent='Atención registrada. Preparando correo...';
    }

    try{
      const cargo=txt(data?.cargo_numero||data?.cargo||draft.cargoExistente);
      if(cargo){
        try{
          const {data:obsCtx,error:obsCtxError}=await sb.rpc('v676_contexto_observaciones_cargo',{p_numero:cargo});
          if(!obsCtxError && obsCtx && typeof obsCtx==='object'){
            draft.observacion=txt(obsCtx.observacion_general)||draft.observacion;
            const ctxMap=new Map((Array.isArray(obsCtx.items)?obsCtx.items:[]).map(x=>[String(x?.expediente_id||''),txt(x?.observacion)]));
            draft.items=(draft.items||[]).map(x=>({
              ...x,
              observacion_individual:ctxMap.get(String(x.id||''))||x.observacion_individual||''
            }));
          }
        }catch(obsError){
          console.warn('V676 contexto de observaciones para correo:',obsError);
        }
      }
      const body=buildBody(draft,data);

      const {data:queued,error}=await sb.rpc('v572_encolar_correo_atencion',{
        p_operacion_id:draft.operationId,
        p_solicitud_id:draft.solicitudId,
        p_solicitud_numero:draft.solicitudNumero,
        p_asunto_correo:draft.subject,
        p_cuerpo:body,
        p_destinatario_ids:draft.recipients.map(x=>x.id),
        p_metadata:{
          origen:'V574_HTML',
          rpc_atencion:draft.rpc,
          solicitud_id:draft.solicitudId,
          solicitud_numero:draft.solicitudNumero,
          solicitante:draft.solicitante,
          modalidad:draft.modalidad,
          asunto_solicitud:draft.asuntoSolicitud,
          atendido_por:draft.atiende||profileName(),
          seleccionado_por:session?.user?.id||currentProfile?.id||null,
          cargo:cargo||null,
          observacion_general:draft.observacion||null,
          cantidad_expedientes:draft.items.length,
          expedientes:draft.items,
          destinatarios_detalle:draft.recipients
        }
      });
      if(error)throw error;

      const queuedCount=Number(queued?.encoladas||0);

      // V586: la atención ya está registrada. El envío de Gmail no bloquea la interfaz.
      window.v586DrainMailInBackground?.('V586_V574_HTML');

      if(status){
        status.className='note v572-ok';
        status.textContent=queuedCount>0
          ? 'Atención registrada. El correo se está enviando en segundo plano.'
          : 'Atención registrada.';
      }
      window.showToast?.(
        queuedCount>0
          ? 'Atención registrada · correo en proceso de envío.'
          : 'Atención registrada.',
        5500
      );

      // Selección manual: limpiar después de la operación para evitar envíos accidentales posteriores.
      document.querySelectorAll('#v572AttentionRecipients input[data-v572-recipient]')
        .forEach(x=>x.checked=false);
      renderSelection();

      return queued;
    }catch(error){
      console.warn('V572 envío atención:',error);
      if(status){
        status.className='note v572-error';
        status.textContent='La atención ya quedó registrada, pero no se pudo enviar el correo: '+(error?.message||error);
      }
      window.showToast?.('Atención registrada. No se pudo enviar el correo.',7500);
    }
  }

  function hookRpc(){
    if(!sb||sb.__v572AttentionHooked||typeof sb.rpc!=='function')return false;

    const old=sb.rpc.bind(sb);
    sb.rpc=async function(name,args,options){
      const draft=captureAttention(name,args||{});
      const res=await old(name,args,options);

      if(draft && !res?.error){
        // No bloquear la actualización normal de la atención.
        setTimeout(()=>sendAttentionMail(draft,res?.data||{}),0);
      }

      return res;
    };

    sb.__v572AttentionHooked=true;
    try{console.info('V574 · captura de atención por correo ACTIVADA');}catch(_){ }
    return true;
  }

  function hookRender(){
    if(typeof window.renderRequestActions!=='function'||window.renderRequestActions.__v572Wrapped)return;
    const old=window.renderRequestActions;
    const wrapped=function(){
      const result=old.apply(this,arguments);
      setTimeout(syncPanel,0);
      return result;
    };
    wrapped.__v572Wrapped=true;
    window.renderRequestActions=wrapped;
  }

  function boot(){
    ensurePanel();
    hookRender();
    hookRpc();
    syncPanel();

    const timer=setInterval(()=>{
      hookRender();
      hookRpc();
      syncPanel();
    },800);

    setTimeout(()=>clearInterval(timer),30000);
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',boot,{once:true});
  }else{
    boot();
  }
})();
</script>





<!-- =========================================================
     V575 · COPIA AL USUARIO QUE REALIZA LA OPERACIÓN
     Solicitud / reasignación / devolución:
     si el Administrador registró un correo autorizado cuyo nombre
     coincide con el usuario de la sesión, ese destinatario queda
     seleccionado por defecto. El usuario puede quitarlo manualmente.
     ========================================================= -->
<style id="v580-self-recipient-style">
.v580-self-badge{
  display:inline-flex;
  align-items:center;
  margin-left:6px;
  padding:1px 6px;
  border-radius:999px;
  background:#e8f2fb;
  color:#245d8d;
  font-size:8px;
  font-weight:900;
  vertical-align:middle;
}
</style>

<script id="v580-self-recipient-script">
(function(){
  'use strict';

  const CONFIGS=[
    {id:'v560RequestMailRecipients', selector:'input[data-v560-recipient]', autoSelect:true, label:'QUIEN SOLICITA'},
    {id:'v560ReassignMailRecipients', selector:'input[data-v560-recipient]', autoSelect:true, label:'QUIEN REASIGNA'},
    {id:'v565ReturnMailRecipients', selector:'input[data-v565-recipient]', autoSelect:true, label:'QUIEN DEVUELVE'}
  ];

  let resolvedOwnRecipientId = null;
  let resolving = false;
  const observed = new WeakSet();
  // V733: conservar la elección del usuario, sin almacenar correos ni datos sensibles.
  // Los estados se separan por sesión, panel e ID de destinatario.
  const manualStates = new Map();

  function norm(v){
    return String(v??'')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .replace(/[^\p{L}\p{N}@._-]+/gu,' ')
      .trim()
      .toUpperCase()
      .replace(/\s+/g,' ');
  }

  function profileData(){
    let p=null, s=null;
    try{ p=currentProfile||null; }catch(_){}
    try{ s=session||null; }catch(_){}

    const userId =
      p?.id || p?.user_id || p?.auth_user_id ||
      s?.user?.id || null;

    return {
      userId: userId ? String(userId) : '',
      name: norm(
        p?.nombre_personal ||
        p?.nombre ||
        p?.display_name ||
        p?.nombre_completo ||
        ''
      ),
      email: norm(
        p?.email ||
        p?.correo ||
        s?.user?.email ||
        ''
      )
    };
  }

  async function resolveOwnRecipient(){
    if(resolvedOwnRecipientId || resolving) return resolvedOwnRecipientId;
    resolving=true;

    try{
      const me=profileData();
      if(!me.userId) return null;

      // V580: vínculo explícito en Supabase. No depende del texto visible.
      const {data,error}=await sb.rpc('v580_mi_destinatario_correo');
      if(error){
        console.warn('V580 · no se pudo resolver correo propio por RPC:',error);
        return null;
      }

      const row=Array.isArray(data) ? data[0] : data;
      const id=row?.destinatario_id || row?.id || null;
      if(id){
        resolvedOwnRecipientId=String(id);
        return resolvedOwnRecipientId;
      }
      return null;
    }catch(err){
      console.warn('V580 · error resolviendo correo propio:',err);
      return null;
    }finally{
      resolving=false;
    }
  }

  function recipientId(check){
    return String(
      check?.dataset?.recipientId ||
      check?.dataset?.id ||
      check?.value ||
      ''
    ).trim();
  }

  function rowFor(check){
    return check?.closest('label.v560-recipient-item') ||
           check?.closest('label') ||
           check?.parentElement ||
           null;
  }

  // V733: una selección manual siempre prevalece sobre los automatismos de V560/V580.
  function selectionKey(cfg, id){
    return `${profileData().userId}|${cfg.id}|${String(id||'').trim()}`;
  }
  function cfgForCheck(check){
    return CONFIGS.find(cfg=>check?.closest?.('#'+cfg.id) && check.matches(cfg.selector));
  }
  function rememberSelection(check, checked){
    const cfg=cfgForCheck(check);
    if(!cfg || !recipientId(check))return;
    manualStates.set(selectionKey(cfg,recipientId(check)),!!checked);
  }
  // V798: un grupo guardado prevalece sobre las selecciones automáticas
  // y las preferencias manuales de una vista anterior. Sin alterar Supabase.
  window.v798FijarSeleccionGrupoCorreo=function(containerId, ids){
    const cfg=CONFIGS.find(x=>x.id===containerId);
    const box=cfg?document.getElementById(cfg.id):null;
    if(!box)return;
    const wanted=new Set((Array.isArray(ids)?ids:[]).map(String));
    box.querySelectorAll(cfg.selector).forEach(check=>{
      const id=recipientId(check);
      if(!id)return;
      manualStates.set(selectionKey(cfg,id),wanted.has(id));
      check.dataset.v580AutoApplied='1';
    });
  };
  function restoreSelections(box,cfg){
    [...box.querySelectorAll(cfg.selector)].forEach(check=>{
      const key=selectionKey(cfg,recipientId(check));
      if(!manualStates.has(key))return;
      const desired=manualStates.get(key);
      if(check.checked!==desired){
        check.checked=desired;
        check.dispatchEvent(new Event('change',{bubbles:true}));
      }
    });
  }
  document.addEventListener('change',event=>{
    // Solo acciones humanas. No guardar como manual las marcas de otras rutinas.
    if(!event.isTrusted)return;
    rememberSelection(event.target,event.target?.checked);
  },true);
  document.addEventListener('click',event=>{
    if(!event.isTrusted)return;
    const remove=event.target?.closest?.('[data-v571-remove]');
    if(remove){
      const panel=remove.closest?.('[id^="v571Selected_"]');
      const cfg=CONFIGS.find(x=>'v571Selected_'+x.id===panel?.id);
      const box=cfg?document.getElementById(cfg.id):null;
      const id=remove.getAttribute('data-v571-remove')||'';
      const check=[...(box?.querySelectorAll(cfg?.selector||'input')||[])].find(x=>recipientId(x)===id);
      if(check)rememberSelection(check,false);
    }
    // "Quitar selección" desmarca todos, incluso el correo autovinculado.
    const clear=event.target?.closest?.('.v568-recipient-clear');
    const box=clear?.parentElement?.nextElementSibling;
    const cfg=CONFIGS.find(x=>x.id===box?.id);
    if(cfg){
      box.querySelectorAll(cfg.selector).forEach(check=>rememberSelection(check,false));
    }
  },true);

  function addBadge(row,label){
    if(!row) return;
    const b=row.querySelector('b') || row.querySelector('strong');
    if(!b || b.querySelector('.v580-self-badge')) return;

    const badge=document.createElement('span');
    badge.className='v580-self-badge';
    badge.textContent=label||'MI CORREO';
    b.appendChild(badge);
  }

  async function applyToBox(cfg){
    const box=document.getElementById(cfg.id);
    if(!box) return false;

    // Una reconstrucción del DOM no debe revivir destinatarios desmarcados.
    restoreSelections(box,cfg);
    const ownId=await resolveOwnRecipient();
    if(!ownId) return false;

    let found=false;

    [...box.querySelectorAll(cfg.selector)].forEach(check=>{
      const id=recipientId(check);
      if(!id || id!==ownId) return;

      found=true;
      addBadge(rowFor(check),cfg.label);

      // Solo marcar automáticamente una vez por reconstrucción del listado.
      // Si el usuario lo desmarca después, respetamos su decisión.
      const selectionWasManual=manualStates.has(selectionKey(cfg,id));
      if(cfg.autoSelect!==false && check.dataset.v580AutoApplied!=='1' && !selectionWasManual){
        check.dataset.v580AutoApplied='1';
        check.checked=true;
        check.dispatchEvent(new Event('change',{bubbles:true}));
      }
      // Incluso si una lista se vuelve a pintar, la selección manual prevalece.
      restoreSelections(box,cfg);
    });

    return found;
  }

  async function enhance(cfg){
    const box=document.getElementById(cfg.id);
    if(!box) return;

    setTimeout(()=>applyToBox(cfg),0);
    setTimeout(()=>applyToBox(cfg),120);

    if(observed.has(box)) return;

    const observer=new MutationObserver(mutations=>{
      if(!mutations.some(m=>m.type==='childList')) return;
      setTimeout(()=>applyToBox(cfg),0);
      setTimeout(()=>applyToBox(cfg),120);
    });

    observer.observe(box,{childList:true,subtree:true});
    observed.add(box);
  }

  function enhanceAll(){
    CONFIGS.forEach(enhance);
  }

  function addInfoNotes(){
    [
      'v560RequestMailPanel',
      'v560ReassignMailPanel',
      'v565ReturnMailPanel'
    ].forEach(id=>{
      const panel=document.getElementById(id);
      if(!panel || panel.querySelector('.v580-self-note')) return;

      const note=document.createElement('div');
      note.className='note v580-self-note';
      note.style.marginTop='6px';
      note.textContent=
        'Predeterminados del sistema: Coordinador de Archivo, Armando, Jaime y el usuario que realiza la operación. El correo del usuario actual se toma de su cuenta institucional vinculada.';

      const head=panel.querySelector('.v560-mail-head');
      if(head) head.insertAdjacentElement('afterend',note);
    });
  }

  function boot(){
    resolveOwnRecipient().finally(()=>{
      enhanceAll();
      addInfoNotes();
    });

    const bodyObserver=new MutationObserver(()=>{
      enhanceAll();
      addInfoNotes();
    });

    bodyObserver.observe(document.body,{childList:true,subtree:true});

    let runs=0;
    const timer=setInterval(()=>{
      enhanceAll();
      addInfoNotes();
      runs++;
      if(runs>=40) clearInterval(timer);
    },500);

    try{console.info('V580 · correo propio por vínculo de usuario ACTIVADO');}catch(_){}
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',boot,{once:true});
  }else{
    boot();
  }
})();
</script>










<script id="v586-mail-background-helper">
(function(){
  'use strict';

  window.v586DrainMailInBackground = function(source){
    try{
      const drain = window.v558ProcesarNotificacionesExternas;
      if(typeof drain !== 'function'){
        console.warn('V648 · procesador serializado de correo no disponible');
        return;
      }

      Promise.resolve(
        drain(true)
      ).then(r=>{
        const sent = Number(r?.enviadas || r?.data?.enviadas || 0);
        if(sent > 0){
          window.showToast?.(
            `✉ Correo procesado en segundo plano.`,
            4500
          );
        }
      }).catch(error=>{
        console.warn(
          'V648 · correo encolado; envío serializado pendiente:',
          error?.message || error
        );
      });
    }catch(error){
      console.warn('V648 · no se pudo iniciar el envío serializado:', error);
    }
  };
})();
</script>


<script id="v586-fast-mail-marker">
try{
  console.info('V586 · operaciones no esperan Gmail; correo se procesa en segundo plano');
}catch(_){}
</script>




<script id="v588-digital-mail-script">
(function(){
  'use strict';

  const COORD_EMAIL='ds_pa_temp208@produce.gob.pe';
  const DEFAULT_ARCHIVO_EMAILS=['agarciag@produce.gob.pe','jgradosp@produce.gob.pe'];
  let recipients=[];
  let requesterId='';
  let ownId='';
  let loaded=false;
  let loading=false;

  const $=id=>document.getElementById(id);
  const clean=v=>String(v??'').trim();
  const upper=v=>clean(v).toUpperCase();
  const escLocal=v=>String(v??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const normName=v=>clean(v)
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g,'')
    .replace(/[^A-Za-z0-9 ]+/g,' ')
    .replace(/\s+/g,' ')
    .trim()
    .toUpperCase();

  function nameMatch(name){
    const wanted=normName(name);
    if(!wanted)return null;
    const exact=recipients.find(r=>normName(r?.nombre)===wanted);
    if(exact)return exact;

    const wt=wanted.split(' ').filter(x=>x.length>=2);
    let best=null,bestMatches=0,bestScore=0;
    for(const r of recipients){
      const rt=new Set(normName(r?.nombre).split(' ').filter(x=>x.length>=2));
      const matches=wt.filter(t=>rt.has(t)).length;
      const score=matches/Math.max(wt.length,1);
      if(matches>=2 && (matches>bestMatches || (matches===bestMatches && score>bestScore))){
        best=r;bestMatches=matches;bestScore=score;
      }
    }
    return best;
  }

  function requesterName(){
    return clean($('v488DigitalModalRequester')?.textContent);
  }

  function defaultSubject(){
    const solicitante=requesterName()||'SOLICITANTE';
    const asunto=clean($('v488DigitalModalMeta')?.textContent).replace(/\s*·\s*COPIA DIGITAL\s*$/i,'');
    const base=`Copia digital atendida de ${solicitante}`;
    return asunto?`${base} - Asunto: ${asunto}`:base;
  }

  function selectedRows(){
    const ids=[...document.querySelectorAll('#v588DigitalMailRecipients input[data-v588-recipient]:checked')]
      .map(x=>String(x.value));
    return ids.map(id=>recipients.find(r=>String(r.id)===id)).filter(Boolean);
  }

  function renderSelected(){
    const selected=selectedRows();
    const count=`${selected.length} seleccionado${selected.length===1?'':'s'}`;
    if($('v588DigitalMailCount'))$('v588DigitalMailCount').textContent=count;
    if($('v588DigitalMailSelectedCount'))$('v588DigitalMailSelectedCount').textContent=count;

    const box=$('v588DigitalMailSelected');
    if(!box)return;
    if(!selected.length){
      box.innerHTML='<div class="note">Aún no hay destinatarios seleccionados.</div>';
      return;
    }

    const ordered=[...selected].sort((a,b)=>{
      const aid=String(a.id), bid=String(b.id);
      const ar=requesterId && aid===requesterId ? 0 : (ownId && aid===ownId ? 1 : 2);
      const br=requesterId && bid===requesterId ? 0 : (ownId && bid===ownId ? 1 : 2);
      return ar-br;
    });

    box.innerHTML=ordered.map(r=>{
      const id=String(r.id);
      const isTo=requesterId && id===requesterId;
      const isMe=ownId && id===ownId;
      const role=isTo
        ? '<span class="v588-mail-role v588-mail-role-to">PARA</span>'
        : '<span class="v588-mail-role v588-mail-role-cc">CC</span>';
      const me=isMe && !isTo
        ? '<span class="v588-mail-role v588-mail-role-me">QUIEN ATIENDE</span>'
        : '';
      return `<div class="v588-mail-selected-item">
        <div>
          <b>${escLocal(r.nombre||r.email)} ${role}${me}</b>
          <small>${escLocal(r.email||'')}</small>
        </div>
        <button type="button" class="v588-mail-remove" data-v588-remove="${escLocal(id)}" title="Quitar">×</button>
      </div>`;
    }).join('');
  }

  function applySearch(){
    const raw=String($('v588DigitalMailSearch')?.value||'')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .toUpperCase()
      .trim();

    const queryTokens=raw.split(/\s+/).filter(Boolean);

    document.querySelectorAll('#v588DigitalMailRecipients .v588-mail-recipient').forEach(row=>{
      const name=String(row.querySelector('b')?.textContent||'')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g,'')
        .toUpperCase()
        .trim();

      const email=String((row.querySelector('small')?.textContent||'').split('·')[0]||'')
        .toUpperCase()
        .trim();

      const nameTokens=name.split(/\s+/).filter(Boolean);

      const byName=queryTokens.length>0 &&
        queryTokens.every(q=>nameTokens.some(token=>token.startsWith(q)));

      const byEmail=email.includes(raw);
      const visible=!raw || byName || byEmail;

      row.style.setProperty('display',visible?'grid':'none','important');
    });
  }

  function renderRecipients(){
    const box=$('v588DigitalMailRecipients');
    if(!box)return;

    if(!recipients.length){
      box.innerHTML='<div class="note" style="padding:8px">No hay correos activos configurados por el Administrador.</div>';
      renderSelected();
      return;
    }

    const requester=nameMatch(requesterName());
    requesterId=requester?.id ? String(requester.id) : '';

    const coord=recipients.find(r=>clean(r?.email).toLowerCase()===COORD_EMAIL)||null;
    const armando=recipients.find(r=>clean(r?.email).toLowerCase()===DEFAULT_ARCHIVO_EMAILS[0])||null;
    const jaime=recipients.find(r=>clean(r?.email).toLowerCase()===DEFAULT_ARCHIVO_EMAILS[1])||null;
    const defaults=new Set([requester?.id,coord?.id,armando?.id,jaime?.id,ownId].filter(Boolean).map(String));

    box.innerHTML=recipients.map(r=>{
      const id=String(r.id);
      const checked=defaults.has(id);
      return `<label class="v588-mail-recipient">
        <input type="checkbox" data-v588-recipient value="${escLocal(id)}" ${checked?'checked':''}>
        <span><b>${escLocal(r.nombre||r.email)}</b><small>${escLocal(r.email||'')}${r.categoria?' · '+escLocal(r.categoria):''}</small></span>
      </label>`;
    }).join('');

    box.querySelectorAll('input[data-v588-recipient]').forEach(cb=>{
      cb.addEventListener('change',renderSelected);
    });
    renderSelected();
    applySearch();

    const status=$('v588DigitalMailStatus');
    if(status){
      status.textContent=requesterId
        ? 'PARA: solicitante · CC: Coordinador + Armando + Jaime + quien atiende. Puede agregar destinatarios adicionales.'
        : 'No se pudo vincular automáticamente el correo del solicitante. La entrega seguirá funcionando, pero revise el catálogo antes de enviar correo.';
    }
  }

  async function loadRecipients(force=false){
    if(loading)return;
    if(loaded && !force){renderRecipients();return;}
    loading=true;
    try{
      const [listResult,ownResult]=await Promise.all([
        sb.rpc('v560_listar_destinatarios_correo',{p_evento:'ATENCION'}),
        sb.rpc('v580_mi_destinatario_correo')
      ]);

      if(listResult.error)throw listResult.error;
      recipients=(Array.isArray(listResult.data)?listResult.data:[])
        .filter(r=>r?.id&&r?.email&&r?.activo!==false);

      const ownRow=Array.isArray(ownResult.data)?ownResult.data[0]:ownResult.data;
      ownId=String(ownRow?.destinatario_id||ownRow?.id||'');
      loaded=true;
      renderRecipients();
    }catch(error){
      console.warn('V588 · destinatarios copia digital:',error);
      const box=$('v588DigitalMailRecipients');
      if(box)box.innerHTML=`<div class="note" style="padding:8px">No se pudo cargar el catálogo: ${escLocal(error?.message||error)}</div>`;
    }finally{
      loading=false;
    }
  }

  function resetPanel(){
    if($('v588DigitalMailEnabled'))$('v588DigitalMailEnabled').checked=true;
    if($('v588DigitalMailSearch'))$('v588DigitalMailSearch').value='';
    if($('v588DigitalMailSubject'))$('v588DigitalMailSubject').value=defaultSubject();
    if($('v588DigitalMailStatus'))$('v588DigitalMailStatus').textContent='';
    loadRecipients(true);
  }

  async function enrichItem(draft){
    try{
      const {data,error}=await sb.rpc('v488_detalle_copias_digitales',{p_solicitud_id:draft.solicitudId});
      if(error)throw error;
      const rows=Array.isArray(data)?data:[];
      const row=rows.find(x=>String(x?.expediente_id||'')===String(draft.expedienteId||''))||null;
      if(row){
        return {
          id:String(draft.expedienteId||''),
          expediente:clean(row.expediente||draft.expediente),
          extension:clean(row.extension),
          rd:clean(row.rd),
          ultimo_folio:clean(row.ultimo_folio)
        };
      }
    }catch(error){
      console.warn('V588 · no se pudo enriquecer detalle digital:',error?.message||error);
    }
    return {
      id:String(draft.expedienteId||''),
      expediente:clean(draft.expediente),
      extension:'',
      rd:'',
      ultimo_folio:''
    };
  }

  function captureDraft(args){
    if(!$('v588DigitalMailEnabled')?.checked)return null;

    const selected=selectedRows();
    if(!selected.length)return null;

    const req=nameMatch(requesterName());
    if(!req || !selected.some(r=>String(r.id)===String(req.id))){
      const status=$('v588DigitalMailStatus');
      if(status)status.textContent='La copia se entregará sin correo porque el solicitante no está seleccionado como destinatario principal.';
      return null;
    }

    return {
      operationId:crypto?.randomUUID?.()||`${Date.now()}-${Math.random().toString(16).slice(2)}`,
      solicitudId:clean(args?.p_solicitud_id),
      expedienteId:clean(args?.p_expediente_id),
      solicitudNumero:clean($('v488DigitalModalReq')?.textContent),
      solicitante:requesterName(),
      asuntoSolicitud:clean($('v488DigitalModalMeta')?.textContent).replace(/\s*·\s*COPIA DIGITAL\s*$/i,''),
      atendidoPor:clean(args?.p_atendido_por),
      enlace:clean(args?.p_enlace),
      observacion:clean(args?.p_observacion),
      expediente:clean($('v488DigitalModalExp')?.textContent),
      subject:clean($('v588DigitalMailSubject')?.value)||defaultSubject(),
      recipients:selected.map(r=>({
        id:r.id,nombre:r.nombre,email:r.email,categoria:r.categoria
      }))
    };
  }

  function bodyFor(draft,item){
    const lines=[
      'Se ha atendido una solicitud de copia digital en el Sistema de Control y Trazabilidad de Expedientes.',
      '',
      `Solicitud: ${draft.solicitudNumero||'—'}`,
      `Solicitante: ${draft.solicitante||'—'}`,
      'Modalidad: COPIA DIGITAL',
      `Asunto de la solicitud: ${draft.asuntoSolicitud||'—'}`,
      `Atendido por: ${draft.atendidoPor||'ARCHIVO'}`,
      '',
      `Enlace de la copia digital: ${draft.enlace}`,
      ...(draft.observacion?['',`Observación: ${draft.observacion}`]:[]),
      '',
      'Expedientes:',
      `1. ${item.expediente||draft.expediente||'Expediente'}${item.extension?` · Ext. ${item.extension}`:''}${item.rd?` · R.D. ${item.rd}`:''}${item.ultimo_folio?` · Último folio ${item.ultimo_folio}`:''}`,
      '',
      'La copia digital quedó entregada en el sistema. La custodia física del expediente no ha sido modificada.'
    ];
    return lines.join('\n');
  }

  async function sendMail(draft){
    if(!draft)return;
    try{
      const item=await enrichItem(draft);
      const body=bodyFor(draft,item);

      const {data,error}=await sb.rpc('v589_encolar_correo_copia_digital',{
        p_operacion_id:draft.operationId,
        p_solicitud_id:draft.solicitudId,
        p_solicitud_numero:draft.solicitudNumero,
        p_expediente_id:draft.expedienteId,
        p_asunto_correo:draft.subject,
        p_cuerpo:body,
        p_destinatario_ids:draft.recipients.map(r=>r.id),
        p_metadata:{
          origen:'V588_HTML',
          modalidad:'COPIA DIGITAL',
          solicitud_id:draft.solicitudId,
          solicitud_numero:draft.solicitudNumero,
          solicitante:draft.solicitante,
          asunto_solicitud:draft.asuntoSolicitud,
          atendido_por:draft.atendidoPor,
          seleccionado_por:session?.user?.id||currentProfile?.id||null,
          copia_digital_enlace:draft.enlace,
          observacion:draft.observacion||null,
          cantidad_expedientes:1,
          expedientes:[item],
          destinatarios_detalle:draft.recipients
        }
      });
      if(error)throw error;

      const queued=Number(data?.encoladas||0);
      window.v586DrainMailInBackground?.('V588_COPIA_DIGITAL');

      window.showToast?.(
        queued>0
          ? 'Copia digital entregada · correo en proceso de envío.'
          : 'Copia digital entregada.',
        5500
      );
    }catch(error){
      console.warn('V588 · correo copia digital:',error);
      window.showToast?.(
        'La copia digital fue entregada, pero no se pudo encolar el correo: '+(error?.message||error),
        8000
      );
    }
  }

  function hookOpen(){
    const original=window.openDigitalCopyAttentionV488;
    if(typeof original!=='function'||original.__v588MailWrapped)return false;

    const wrapped=function(){
      const result=original.apply(this,arguments);
      setTimeout(resetPanel,0);
      return result;
    };
    wrapped.__v588MailWrapped=true;
    window.openDigitalCopyAttentionV488=wrapped;
    return true;
  }

  function hookRpc(){
    if(!sb||sb.__v588DigitalMailHooked||typeof sb.rpc!=='function')return false;

    const old=sb.rpc.bind(sb);
    sb.rpc=async function(name,args,options){
      const draft=name==='v488_entregar_copia_digital' ? captureDraft(args||{}) : null;
      const res=await old(name,args,options);

      if(draft && !res?.error){
        setTimeout(()=>sendMail(draft),0);
      }
      return res;
    };

    sb.__v588DigitalMailHooked=true;
    return true;
  }

  function bindUi(){
    $('v588DigitalMailSearch')?.addEventListener('input',applySearch);
    $('v588DigitalMailEnabled')?.addEventListener('change',()=>{
      const on=$('v588DigitalMailEnabled')?.checked!==false;
      ['v588DigitalMailSearch','v588DigitalMailSubject'].forEach(id=>{
        if($(id))$(id).disabled=!on;
      });
      const box=$('v588DigitalMailRecipients');
      if(box)box.style.opacity=on?'1':'.55';
    });

    $('v588DigitalMailSelected')?.addEventListener('click',ev=>{
      const btn=ev.target?.closest?.('[data-v588-remove]');
      if(!btn)return;
      const id=String(btn.dataset.v588Remove||'');
      const cb=document.querySelector(`#v588DigitalMailRecipients input[data-v588-recipient][value="${CSS.escape(id)}"]`);
      if(cb){
        cb.checked=false;
        renderSelected();
      }
    });
  }

  function boot(){
    bindUi();
    hookOpen();
    hookRpc();

    let tries=0;
    const timer=setInterval(()=>{
      hookOpen();
      hookRpc();
      tries++;
      if(tries>=40)clearInterval(timer);
    },500);

    try{console.info('V588 · correo para atención de COPIA DIGITAL activado');}catch(_){}
  }

  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});
  else boot();
})();
</script>






<style id="v591-unified-mail-style">
/* =========================================================
   V591 · ESTILO ÚNICO PARA TODOS LOS FLUJOS DE CORREO
   Referencia visual: módulo de COPIA DIGITAL.
   No modifica la lógica de destinatarios ni de envío.
   ========================================================= */

/* Panel general */
#v560RequestMailPanel,
#v560ReassignMailPanel,
#v565ReturnMailPanel,
#v572AttentionMailPanel{
  margin-top:12px!important;
  padding:12px!important;
  border:1px solid #cbd9e8!important;
  border-radius:10px!important;
  background:#f8fbff!important;
  box-sizing:border-box!important;
}

#v560RequestMailPanel *,
#v560ReassignMailPanel *,
#v565ReturnMailPanel *,
#v572AttentionMailPanel *,
#v566ReturnConfirmMailModal *{
  box-sizing:border-box!important;
}

/* Cabecera del correo */
#v560RequestMailPanel .v560-mail-head,
#v560ReassignMailPanel .v560-mail-head,
#v565ReturnMailPanel .v560-mail-head{
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
  gap:12px!important;
