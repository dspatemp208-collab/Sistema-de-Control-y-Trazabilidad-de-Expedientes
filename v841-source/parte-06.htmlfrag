}

.table-head,
#panelDetailWrap .table-head,
#stateDetailBox .table-head,
#tab-requests .table-head{
  background:#fbfcfe!important;
}

/* Filas: contraste suave, sin teñir toda la interfaz. */
tbody tr:nth-child(odd) td{background:#fff}
tbody tr:nth-child(even) td{background:#f7f9fc}
tbody tr:hover td{background:#eef5fb!important}

/* Tarjetas personales: conservar identidad, pero con tonos más suaves. */
#userPersonalKpis .kpi{
  box-shadow:0 2px 7px rgba(23,54,93,.05)!important;
  border-color:#d6e1eb!important;
}
#userKpiAllCard{background:#eef5fd!important}
#userKpiLoanCard{background:#eef7ff!important}
#userKpiPendingAttentionCard{background:#fff7dc!important}
#userKpiDigitalCopiesCard{background:#edf9f7!important}
#userKpiReturnRequestedCard{background:#fff3e7!important}
#userKpiReassignIncomingCard{background:#eef7ff!important}
#userKpiReassignRequestedCard{background:#f4efff!important}
