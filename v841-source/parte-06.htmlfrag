main.main section:not(.hidden) .module-sticky-piece,
main.main section:not(.hidden) .module-data-scroll,
main.main section:not(.hidden) .table-wrap,
#panelDetailWrap,#panelTable,#stateDetailBox,#stateDetailTable,#allTable,#requestsTable,#returnRequestsTable{
