      textV415(panelQuickFilter)!==filterSnapshot
    )return;

    const size=Number(typeof PAGE_SIZE!=='undefined'?PAGE_SIZE:70)||70;
    const from=Math.max(0,Number(page||0))*size;
    const to=from+size;

    panelCount=all.length;
    panelRows=all.slice(from,to);

    if(el('panelTitle')){
      el('panelTitle').textContent=
        `Expedientes de ${ownerSnapshot} · Pendientes por atender (${panelCount})`;
    }

    const first=panelCount?from+1:0;
    const last=Math.min(to,panelCount);
    if(el('pageInfo'))el('pageInfo').textContent=`${first} - ${last} de ${panelCount} registros`;

    if(el('panelTable')){
      el('panelTable').innerHTML=typeof renderUserPendingAttentionRows==='function'
        ?renderUserPendingAttentionRows(panelRows,true)
        :'<div class="empty">Sin datos.</div>';
    }

    if(typeof updateKpiQuickUI==='function')updateKpiQuickUI();
    if(typeof syncPanelReturnBulkUI==='function')syncPanelReturnBulkUI();
    try{
      if(typeof v179SavePanelSnapshot==='function' && typeof v179PanelCacheKey==='function'){
        v179SavePanelSnapshot(v179PanelCacheKey());
      }
    }catch(_){ }
  }

  // ----------------------------------------------------------
  // ADMINISTRADOR / ARCHIVO · detalle individual de la tarjeta.
  // Contador y listado quedan forzados a la MISMA fuente.
  // ----------------------------------------------------------
  window.loadPanel=async function(options={}){
    const fullAccessPending=
      typeof hasFullAccess==='function' && hasFullAccess() &&
      typeof isLimitedUser==='function' && !isLimitedUser() &&
      !(typeof isCoordinatorTeamWorkspaceV206==='function' &&
        isCoordinatorTeamWorkspaceV206()) &&
      typeof selectedOwnerIsUser==='function' && selectedOwnerIsUser() &&
      textV415(panelQuickFilter)==='pending_attention';

    if(fullAccessPending){
      return renderFullAccessPendingPanelV415(options);
    }

    if(typeof loadPanelBeforeV415==='function'){
      return loadPanelBeforeV415(options);
    }
  };

  // Limpiar vistas guardadas para que no sobreviva un conteo anterior.
  try{
    for(let i=sessionStorage.length-1;i>=0;i--){
      const key=sessionStorage.key(i)||'';
      if(
        key.startsWith('v207_user_summary_') ||
        key.startsWith('v637_user_summary_') ||
        key.startsWith('v233_owner_cards_') ||
        key.startsWith('v353_panel_')
      )sessionStorage.removeItem(key);
    }
  }catch(_){ }

  try{
    if(typeof invalidateCoordinatorPendingCacheV310==='function'){
      invalidateCoordinatorPendingCacheV310();
    }
    if(typeof invalidatePanelViewCacheV179==='function'){
      invalidatePanelViewCacheV179();
    }
  }catch(_){ }

  window.v415PendingLogicAudit=function(){
    return {
      rule:'Pendientes por atender = expedientes listos para atención',
      excluded:'Esperando devolución de otro custodio',
      ordinaryUser:'listar_pendientes_por_atender_inclusivo filtrado por solicitante',
      coordinatorSelf:'V310 pending_rows del propio coordinador',
      coordinatorTeam:'V310 pending_rows por integrante autorizado',
      adminArchiveCount:'misma fuente real, sin completar faltantes por total-atendidos',
      adminArchiveDetail:'misma fuente real filtrada por solicitante',
      requestAlerts:'conservan esperas de devolución; no se eliminan'
    };
  };
})();
</script>
<script id="v417-coordinator-pending-authorized-fallback">
(function(){
  'use strict';
  const oldTeamRows=window.coordinatorTeamRowsV218;
  const oldPendingCounts=window.loadCoordinatorPendingCountMapV409;
  const oldLoadPanel=window.loadPanel;
  const cache=new Map();
  const pendingType=type=>String(type||'').toUpperCase()==='PENDIENTES_POR_ATENDER';
  const normalize=value=>typeof norm==='function'?norm(value||''):String(value||'').trim().toUpperCase();
  const hasExpediente=row=>!!String(
    row?.expediente_id||row?.expediente||row?.numero_expediente||
    row?.nro_expediente||row?.expediente_numero||''
  ).trim();

  async function pendingFromAuthorizedRequests(nombre,search=''){
    const target=String(nombre||'').trim();
    if(!isCoordinatorTeamWorkspaceV206()||!coordinatorCanViewUserV205(target)){
      throw new Error('El integrante no pertenece al equipo autorizado.');
    }
    const key=normalize(target);
    let entry=cache.get(key);
    if(!entry||Date.now()-entry.at>20000){
      const headers=await coordinatorRequestRowsV211('',null);
      const mine=(headers||[]).filter(r=>normalize(r.solicitante)===key &&
        !['ENTREGA TOTAL','CERRADA POR ARCHIVO','CERRADO POR ARCHIVO',
          'CERRADA POR ADMINISTRADOR','CERRADO POR ADMINISTRADOR']
          .includes(normalize(r.estado_atencion||r.estado)));
      const rows=[];
      for(let i=0;i<mine.length;i+=4){
        const batch=await Promise.all(mine.slice(i,i+4).map(async header=>{
          const response=await sb.rpc('v211_coordinador_detalle_solicitud',
            {p_solicitud_id:header.id});
          if(response.error)throw response.error;
          const payload=v211JsonObject(response.data);
          const detailHeader=payload.header||{};
          return (Array.isArray(payload.items)?payload.items:[])
            .map(item=>typeof v214NormalizeRpcValue==='function'
              ?v214NormalizeRpcValue(item):item)
            .filter(item=>item&&typeof item==='object'&&!Array.isArray(item))
            .filter(item=>{
              const state=normalize(item.estado_item||item.estado_atencion||item.estado);
              return ['ACEPTADO','PENDIENTE POR ATENDER','REGISTRADA POR ARCHIVO'].includes(state) &&
                !item._cross_wait;
            })
            .map(item=>({
              ...item,
              expediente_id:item.expediente_id||null,
              expediente:item.expediente||item.numero_expediente||
                item.nro_expediente||item.expediente_numero||'',
              solicitud_id:header.id,
              solicitud_numero:header.numero||detailHeader.numero,
              solicitante:header.solicitante,
              asunto:item.asunto||header.asunto||detailHeader.asunto,
              fecha_solicitud:header.fecha_solicitud||detailHeader.fecha_solicitud,
              solicitud_created_at:header.solicitud_created_at||header.created_at||
                detailHeader.solicitud_created_at||detailHeader.created_at,
              _v417_authorized_detail:true
            }));
        }));
        batch.forEach(list=>rows.push(...list));
      }
      if(rows.some(row=>!hasExpediente(row))){
        throw new Error('La consulta autorizada devolvió pendientes sin identificador de expediente. No se mostrarán filas incompletas.');
      }
      const unique=new Map();
      rows.forEach(r=>{
        const id=String(r.solicitud_id||'')+'::'+String(r.expediente_id||r.expediente||'');
        if(!unique.has(id))unique.set(id,r);
      });
      entry={at:Date.now(),rows:[...unique.values()]};
      cache.set(key,entry);
    }
    const q=normalize(search);
    return entry.rows.filter(r=>!q||[
      r.expediente,r.extension,r.rd,r.ultimo_folio,r.solicitud_numero,
      r.asunto,r.solicitante,r.responsable_actual
    ].some(value=>normalize(value).includes(q)));
  }

  window.coordinatorTeamRowsV218=async function(nombre,type,search=''){
    if(!isCoordinatorTeamWorkspaceV206()||!pendingType(type)){
      return oldTeamRows(nombre,type,search);
    }
    try{
      const rows=await oldTeamRows(nombre,type,search);
      if(Array.isArray(rows)&&rows.length&&rows.every(hasExpediente))return rows;
      if(Array.isArray(rows)&&rows.length){
        console.warn('V418 · la consulta V310 devolvió filas sin expediente; se consulta el detalle autorizado.');
      }
    }catch(error){
      console.warn('V417 · consulta de pendientes V310 no disponible:',error?.message||error);
    }
    return pendingFromAuthorizedRequests(nombre,search);
  };

  window.loadCoordinatorPendingCountMapV409=async function(names=[]){
    if(!isCoordinatorTeamWorkspaceV206())return oldPendingCounts(names);
    const result=new Map();
    await Promise.all((names||[]).map(async nombre=>{
      try{
        const rows=await window.coordinatorTeamRowsV218(nombre,'PENDIENTES_POR_ATENDER','');
        result.set(nombre,rows.length);
      }catch(error){
        console.warn('V417 · contador de pendientes del equipo:',error?.message||error);
        result.set(nombre,0);
      }
    }));
    return result;
  };

  window.loadPanel=function(options={}){
    if(isCoordinatorTeamWorkspaceV206() && panelQuickFilter==='pending_attention'){
      return oldLoadPanel({...options,forceFresh:true});
    }
    return oldLoadPanel(options);
  };

  try{
    if(typeof invalidatePanelViewCacheV179==='function')invalidatePanelViewCacheV179();
    for(let i=sessionStorage.length-1;i>=0;i--){
      const key=sessionStorage.key(i)||'';
      if(key.startsWith('v353_panel_')||key.startsWith('v233_owner_cards_'))sessionStorage.removeItem(key);
    }
  }catch(_){ }
})();
</script>
<script id="v420-card-count-consistency">
(function(){
  'use strict';

  const previousLoadSummaryV420=window.loadSummary;
  const previousLoadOwnerUserKpisV420=window.loadOwnerUserKpis;
  const v420Text=value=>String(value??'').trim();
  const v420Norm=value=>typeof window.norm==='function'
    ?window.norm(value||'')
    :v420Text(value).toUpperCase();

  function v420CoordinatorTeam(){
    return typeof window.isCoordinatorTeamWorkspaceV206==='function' &&
      window.isCoordinatorTeamWorkspaceV206();
  }

  async function v420OwnerRows(nombre,tipo){
    const target=v420Text(nombre);
    if(!target)return [];

    if(v420CoordinatorTeam()){
      if(typeof window.coordinatorTeamRowsV218!=='function')return [];
      const rows=await window.coordinatorTeamRowsV218(target,tipo,'');
      return Array.isArray(rows)?rows:[];
    }

    const response=await sb.rpc('listar_tarjeta_usuario_admin_v5',{
      p_nombre:target,
      p_tipo:tipo,
      p_busqueda:null
    });
    if(response?.error)throw response.error;
    return Array.isArray(response?.data)?response.data:[];
  }

  async function v420PendingCount(nombre){
    const target=v420Text(nombre);
    if(!target)return 0;

    if(v420CoordinatorTeam()){
      const rows=await v420OwnerRows(target,'PENDIENTES_POR_ATENDER');
      return rows.length;
    }

    if(typeof window.loadPendingItemCountMapBySolicitanteV165==='function'){
      const map=await window.loadPendingItemCountMapBySolicitanteV165();
      if(map instanceof Map){
        if(map.has(target))return Number(map.get(target)||0);
        const key=v420Norm(target);
        for(const [name,count] of map.entries()){
          if(v420Norm(name)===key)return Number(count||0);
        }
      }
    }
    return 0;
  }

  function v420ApplyOwnerCounts(nombre,counts){
    if(v420Norm(typeof selectedOwner!=='undefined'?selectedOwner:'')!==v420Norm(nombre))return;

    const values={
      kTotal:counts.total_custodia,
      kLoan:counts.en_prestamo,
      kReassigned:counts.reasignados,
      kPendingAttention:counts.pendientes_por_atender,
      kPending:counts.devoluciones_pendientes_aceptacion,
      kReturnedHistory:counts.devoluciones_realizadas,
      kAlert:counts.alertas_30
    };

    Object.entries(values).forEach(([id,value])=>{
      const node=document.getElementById(id);
      if(node && Number.isFinite(Number(value)))node.textContent=String(Number(value));
    });

    try{
      const row=(ownerCardsRows||[]).find(x=>v420Norm(x?.nombre)===v420Norm(nombre));
      if(row){
        Object.assign(row,counts,{_summary_loading:false,_pending_loading:false});
        if(typeof renderOwnerCards==='function')renderOwnerCards();
      }
    }catch(_){ }

    try{ if(typeof updateKpiQuickUI==='function')updateKpiQuickUI(); }catch(_){ }
  }

  window.loadOwnerUserKpis=async function(nombre){
    const target=v420Text(nombre);
    if(!target||!sb||!session)return;

    try{
      if(typeof previousLoadOwnerUserKpisV420==='function'){
        await previousLoadOwnerUserKpisV420(target);
      }
    }catch(error){
      console.warn('V420 · resumen previo del usuario:',error?.message||error);
    }

    const metricDefs=[
      ['total_custodia','CUSTODIA'],
      ['en_prestamo','PRESTAMO'],
      ['reasignados','REASIGNADOS_A_MI'],
      ['devoluciones_pendientes_aceptacion','DEVOLUCION_SOLICITADA'],
      ['devoluciones_realizadas','DEVUELTOS_AL_ARCHIVO'],
      ['alertas_30','ALERTAS_30']
    ];

    const results=await Promise.allSettled([
      ...metricDefs.map(async ([key,type])=>{
        const rows=await v420OwnerRows(target,type);
        return [key,rows.length];
      }),
      v420PendingCount(target).then(count=>['pendientes_por_atender',count])
    ]);

    const counts={};
    for(const result of results){
      if(result.status==='fulfilled'){
        const [key,value]=result.value;
        counts[key]=Number(value||0);
      }else{
        console.warn('V420 · verificación de tarjeta:',result.reason?.message||result.reason);
      }
    }

    v420ApplyOwnerCounts(target,counts);
    return counts;
  };

  window.loadSummary=async function(){
    if(v420CoordinatorTeam()){
      try{
        if(typeof loadOwnerCards==='function')await loadOwnerCards();
        if(typeof renderSidebar==='function')renderSidebar();
        if(typeof renderKpis==='function')renderKpis();
      }catch(error){
        console.warn('V420 · resumen seguro del equipo:',error?.message||error);
      }
      return;
    }

    if(typeof previousLoadSummaryV420==='function'){
      return previousLoadSummaryV420();
    }
  };

  document.addEventListener('click',event=>{
    const card=event.target?.closest?.('#ownerCardsGrid .owner-user-card');
    if(!card)return;
    setTimeout(()=>{
      const target=v420Text(typeof selectedOwner!=='undefined'?selectedOwner:'');
      if(target)window.loadOwnerUserKpis(target).catch(error=>
        console.warn('V420 · verificación del usuario seleccionado:',error?.message||error)
      );
    },0);
  },true);

  try{
    for(let i=sessionStorage.length-1;i>=0;i--){
      const key=sessionStorage.key(i)||'';
      if(
        key.startsWith('v184_user_summary_') ||
        key.startsWith('v207_user_summary_') ||
        key.startsWith('v637_user_summary_') ||
        key.startsWith('v233_owner_cards_') ||
        key.startsWith('v353_panel_')
      )sessionStorage.removeItem(key);
    }
    if(typeof invalidatePanelViewCacheV179==='function')invalidatePanelViewCacheV179();
    if(typeof invalidateCoordinatorPendingCacheV310==='function')invalidateCoordinatorPendingCacheV310();
  }catch(_){ }

  window.v420CardConsistencyInfo=function(){
    return {
      requests:'cifra principal y detalle salen de allRequestRows',
      waitReturn:'cifra principal = solicitudes; desglose = expedientes',
      selectedOwner:'cada KPI se verifica contra la misma fuente que abre su detalle',
      coordinatorTeam:'sin resumen global de Administrador/Archivo',
      sql:'sin SQL nuevo; conserva V412/V310/V211 ya instalados'
    };
  };
})();
</script>
