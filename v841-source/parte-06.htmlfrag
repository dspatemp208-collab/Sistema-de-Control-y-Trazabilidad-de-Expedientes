            <tr><th>Consultas &gt; 1 s</th><td id="v605ServerSlow1">—</td><th>Consultas &gt; 5 s</th><td id="v605ServerSlow5">—</td></tr>
            <tr><th>Correos enviando</th><td id="v605MailSending">—</td><th>Pendiente más antiguo</th><td id="v605OldestMail">—</td></tr>
