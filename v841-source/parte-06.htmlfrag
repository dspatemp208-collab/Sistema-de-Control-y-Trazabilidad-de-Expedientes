#v530UserTraceSearch .v530-head{
  display:flex;justify-content:space-between;align-items:flex-start;
  gap:12px;flex-wrap:wrap;margin-bottom:7px
}
#v530UserTraceSearch .v530-title{font-size:14px;font-weight:850;color:#123f70}
#v530UserTraceSearch .v530-help{font-size:11px;color:#58718b;margin-top:2px}
#v530UserTraceSearch .v530-line{display:flex;gap:7px;align-items:center}
#v530UserTraceSearch input{
  flex:1;min-width:0;height:38px;border:1px solid #a9c5df;border-radius:8px;
  background:#f8fbfd;padding:0 12px;font-size:14px;color:#0c2e53;outline:none
}
#v530UserTraceSearch input:focus{border-color:#1b6fd1;box-shadow:0 0 0 2px rgba(27,111,209,.12)}
#v530UserTraceStatus{font-size:11px;color:#526b84;margin-top:6px;min-height:15px}
#v530UserTraceStatus.searching{color:#125aa5}
#v530UserTraceStatus.ok{color:#206b42}
#v530UserTraceStatus.error{color:#a12d2d}
.v530-trace-table{width:100%;border-collapse:collapse}
.v530-trace-table th,.v530-trace-table td{padding:9px 8px;vertical-align:middle}
.v530-trace-table .v530-relations{display:flex;gap:5px;flex-wrap:wrap;justify-content:center}
.v530-relation{
  display:inline-flex;align-items:center;border:1px solid #c7d6e5;border-radius:999px;
  background:#eef4fa;padding:3px 7px;font-size:10px;font-weight:800;color:#244d76;white-space:nowrap
}
.v530-relation.digital{background:#e4f7f5;border-color:#abdeda;color:#116b65}
.v530-relation.returned{background:#eef1f4;border-color:#d2dae1;color:#4d5d6c}
.v530-relation.reassigned{background:#eee9ff;border-color:#d8ccff;color:#6242a2}
.v530-relation.pending{background:#fff5d8;border-color:#eedb9b;color:#815f00}
.v530-relation.custody{background:#e5f2ff;border-color:#bad7f2;color:#235984}
.v530-current-state{font-weight:800;color:#163d67}
.v534-request-states{display:flex;gap:5px;flex-wrap:wrap;justify-content:center}
.v534-request-state{display:inline-flex;align-items:center;border-radius:999px;padding:3px 7px;font-size:10px;font-weight:850;white-space:nowrap;border:1px solid #c8d6e4;background:#eef4fa;color:#234d76}
.v534-request-state.delivered{background:#e7f5eb;border-color:#b8ddc3;color:#21613a}
.v534-request-state.pending{background:#fff5d8;border-color:#eedb9b;color:#815f00}
.v534-request-state.reassigned{background:#eee9ff;border-color:#d8ccff;color:#6242a2}
.v534-request-state.returned{background:#eef1f4;border-color:#d2dae1;color:#4d5d6c}
.v534-request-state.loan{background:#fff0c9;border-color:#ecd48a;color:#6f5300}
.v534-physical-state{font-weight:800;color:#163d67}
.v534-state-sub{display:block;margin-top:2px;font-size:9px;color:#60758a;font-weight:650}
@media(max-width:800px){
  #v530UserTraceSearch .v530-line{flex-wrap:wrap}
  #v530UserTraceSearch input{flex:1 1 100%}
}
</style>

<style id="v610-search-same-card-style">
.v610-search-card-result{margin:10px 0 14px;border:1px solid #cfdceb;border-radius:12px;background:#fff;overflow:hidden;box-shadow:0 2px 8px rgba(18,52,86,.05)}
.v610-search-card-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;background:#eef5fc;border-bottom:1px solid #d7e3ef;color:#12365f}
.v610-search-card-head>div{display:flex;align-items:center;gap:9px;flex-wrap:wrap}.v610-search-card-label{font-size:9px;font-weight:800;color:#60758a;text-transform:uppercase;letter-spacing:.04em}.v610-search-card-head strong{font-size:12px}.v610-search-card-exp{font-size:11px;font-weight:900;padding:4px 8px;border-radius:999px;background:#fff;border:1px solid #cbd9e7;white-space:nowrap}
.v610-search-card-body{overflow:auto}.v610-search-card-body>table,.v610-search-card-body .v225-complete-wrap table{margin:0}.v610-search-card-body .v216-exp-number-strip{display:none}
</style>
<script id="v530-user-trace-search-script">
(function(){
  'use strict';

  let timer=null;
  let seq=0;

  const $=id=>document.getElementById(id);
  const esc530=value=>String(value??'')
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#039;');
  const upper530=value=>String(value??'').trim().toUpperCase();

  function logicalKey530(value){
    const q=String(value??'').trim().replace(/\s+/g,'').replace(/[–—]/g,'-');
    const m=q.match(/^(\d+)-(\d{4})$/);
    if(!m)return '';
    return `${Number(m[1])}-${m[2]}`;
  }

  function rowNumber530(r){
    return String(r?.expediente||r?.numero_expediente||r?.nro_expediente||'').trim();
  }

  function physicalKey530(r){
    const id=String(r?.expediente_id||r?.id||'').trim();
    if(id && /^[0-9a-f-]{30,}$/i.test(id))return `ID:${id}`;
    return `${logicalKey530(rowNumber530(r))}|${upper530(r?.extension||'')}`;
  }

  function relationInfo530(type){
    const map={
      EN_CUSTODIA:['EN CUSTODIA','custody'],
      PRESTAMO:['PRÉSTAMO','custody'],
      PENDIENTES_POR_ATENDER:['SOLICITADO','pending'],
      DEVOLUCION_SOLICITADA:['DEVOLUCIÓN SOLICITADA','pending'],
      SOLICITUDES_REASIGNACION:['REASIGNACIÓN SOLICITADA','reassigned'],
      REASIGNACIONES_SOLICITADAS_POR_MI:['REASIGNACIÓN SOLICITADA POR MÍ','reassigned'],
      REASIGNADOS_POR_MI:['REASIGNADO POR MÍ','reassigned'],
      REASIGNADOS_A_MI:['REASIGNADO A MÍ','reassigned'],
      DEVUELTOS:['DEVUELTO AL ARCHIVO','returned'],
      ALERTAS_30:['ALERTA > 30 DÍAS','pending'],
      COPIAS_DIGITALES:['COPIA DIGITAL','digital']
    };
    return map[type]||[String(type||'RELACIONADO').replaceAll('_',' '),''];
  }

  function state530(r){
    return r?.estado_operativo||r?.ultimo_estado||r?.estado_actual||r?.estado||r?.estado_copia||'—';
  }
  function responsible530(r){
    return r?.responsable_actual||r?.responsable_actual_nombre||r?.responsable||r?.ubicacion_actual||r?.ubicacion||'—';
  }
  function lastDate530(r){
    return r?.fecha_ultimo_estado||r?.fecha_ultimo_movimiento||r?.ultima_fecha||r?.updated_at||r?.entregado_at||r?.fecha_solicitud||r?.created_at||null;
  }

  // V534: separar el estado de LA SOLICITUD/RELACIÓN del estado físico actual.
  function relationState530(row,relation){
    const rel=upper530(relation||row?._v530_relation||row?._v184_activity||'');
    const digital=upper530(row?.estado_copia);

    if(rel==='COPIAS_DIGITALES'){
      if(digital==='ENTREGADA')return ['COPIA DIGITAL ENTREGADA','delivered'];
      if(digital==='CERRADA')return ['COPIA DIGITAL CERRADA','returned'];
      return ['PENDIENTE POR ATENDER','pending'];
    }
    if(rel==='DEVUELTOS')return ['DEVUELTO AL ARCHIVO','returned'];
    if(rel==='DEVOLUCION_SOLICITADA')return ['DEVOLUCIÓN SOLICITADA','pending'];
    if(rel==='REASIGNADOS_POR_MI'||rel==='REASIGNADOS_A_MI'){
      return [row?.estado_operativo||row?.ultimo_estado||row?.estado_actual||row?.estado||'REASIGNADO','reassigned'];
    }
    if(rel==='SOLICITUDES_REASIGNACION'||rel==='REASIGNACIONES_SOLICITADAS_POR_MI'){
      return [row?.estado_solicitud||row?.estado_atencion||row?.estado||'PENDIENTE DE CONFIRMACIÓN','reassigned'];
    }
    if(rel==='PRESTAMO'){
      return [row?.estado_operativo||row?.ultimo_estado||row?.estado_actual||row?.estado||'EN PRÉSTAMO','loan'];
    }
    if(rel==='PENDIENTES_POR_ATENDER'){
      return [row?.estado_atencion||row?.estado_solicitud||row?.estado||'PENDIENTE POR ATENDER','pending'];
    }
    if(rel==='EN_CUSTODIA'){
      return [row?.estado_operativo||row?.ultimo_estado||row?.estado_actual||row?.estado||'EN CUSTODIA','loan'];
    }
    if(rel==='ALERTAS_30')return ['ALERTA > 30 DÍAS','pending'];

    const raw=row?.estado_atencion||row?.estado_solicitud||row?.estado_item||row?.estado||row?.estado_copia||'';
    return [raw||'RELACIONADO',''];
  }

  function requestStates530(item){
    const out=[];
    const seen=new Set();
    const candidates=Array.isArray(item?._v530_candidates)?item._v530_candidates:[];
    candidates.forEach(entry=>{
      const row=entry?.row||entry;
      const relation=entry?.relation||row?._v530_relation||row?._v184_activity||'';
      if(!relation)return;
      const [state,cls]=relationState530(row,relation);
      const key=upper530(relation)+'|'+upper530(state);
      if(seen.has(key))return;
      seen.add(key);
      out.push({relation,state,cls});
    });
    return out;
  }

  function hasPhysicalRelation530(item){
    const relations=[...(item?._v530_relations||[])].map(upper530);
    const physicalRelations=new Set([
      'EN_CUSTODIA','PRESTAMO','PENDIENTES_POR_ATENDER',
      'DEVOLUCION_SOLICITADA','SOLICITUDES_REASIGNACION',
      'REASIGNACIONES_SOLICITADAS_POR_MI','REASIGNADOS_POR_MI',
      'REASIGNADOS_A_MI','DEVUELTOS','ALERTAS_30'
    ]);
    return relations.some(r=>physicalRelations.has(r));
  }

  function digitalDeliveredOnly530(item){
    const relations=[...(item?._v530_relations||[])].map(upper530);
    if(!relations.includes('COPIAS_DIGITALES'))return false;
    if(hasPhysicalRelation530(item))return false;
    const states=requestStates530(item).map(s=>upper530(s.state));
    return states.includes('COPIA DIGITAL ENTREGADA');
  }

  function physicalState530(item){
    if(digitalDeliveredOnly530(item))return 'SIN CAMBIO FÍSICO';
    const physical=item?._v530_physical;
    return state530(physical||item);
  }

  function physicalResponsible530(item){
    if(digitalDeliveredOnly530(item))return 'NO APLICA';
    const physical=item?._v530_physical;
    return responsible530(physical||item);
  }

  function latestActivity530(item){
    const dates=[];
    const add=value=>{
      if(!value)return;
      const t=new Date(value).getTime();
      if(Number.isFinite(t))dates.push({t,value});
    };
    add(lastDate530(item?._v530_physical||null));
    (Array.isArray(item?._v530_candidates)?item._v530_candidates:[]).forEach(entry=>add(lastDate530(entry?.row||entry)));
    if(!dates.length)return lastDate530(item);
    dates.sort((a,b)=>b.t-a.t);
    return dates[0].value;
  }
  function time530(value){
    if(!value)return '—';
    try{
      if(typeof expSearchDateTime==='function')return expSearchDateTime(value);
      if(typeof fmtDate==='function')return fmtDate(value);
    }catch(_){ }
    return String(value);
  }

  function relationBadge530(type){
    const [label,cls]=relationInfo530(type);
    return `<span class="v530-relation ${cls}">${esc530(label)}</span>`;
  }

  function ensurePanel530(){
    const cards=$('userPersonalKpis');
    if(!cards)return false;

    let panel=$('v530UserTraceSearch');
    if(!panel){
      panel=document.createElement('div');
      panel.id='v530UserTraceSearch';
      panel.className='card';
      panel.innerHTML=`
        <div class="v530-head">
          <div>
            <div class="v530-title">🔎 Buscar en todo mi historial de expedientes</div>
            <div class="v530-help">Incluye solicitudes, préstamos, copias digitales, reasignaciones, devoluciones y expedientes que estuvieron bajo su custodia.</div>
          </div>
        </div>
        <div class="v530-line">
          <input id="v530UserTraceInput" autocomplete="off" spellcheck="false"
                 placeholder="Ej.: 36-2000 (no necesita ceros iniciales)" />
          <button class="btn" id="v530UserTraceBtn" type="button">🔎 Buscar</button>
          <button class="btn secondary" id="v530UserTraceClear" type="button">Limpiar</button>
        </div>
        <div id="v530UserTraceStatus">Escriba el número y año del expediente.</div>`;
      cards.parentNode.insertBefore(panel,cards);

      const input=$('v530UserTraceInput');
      input.addEventListener('input',()=>{
        clearTimeout(timer);
        const typed=input.value.trim();
        const key=logicalKey530(typed);
        if(!typed){setStatus530('Escriba el número y año del expediente.','');return;}
        if(!key){setStatus530('Complete el número y año. Ej.: 36-2000.','');return;}
        timer=setTimeout(()=>run530(false),120);
      });
      input.addEventListener('keydown',event=>{
        if(event.key==='Enter'){
          event.preventDefault();
          clearTimeout(timer);
          run530(true);
        }
      });
      $('v530UserTraceBtn').addEventListener('click',()=>run530(true));
      $('v530UserTraceClear').addEventListener('click',clear530);
    }

    return true;
  }

  function setStatus530(text,cls=''){
    const node=$('v530UserTraceStatus');
    if(!node)return;
    node.className=cls;
    node.textContent=text;
  }

  async function currentRows530(typed){
    try{
      if(typeof loadAllMyExpedientes!=='function')return [];
      const rows=await loadAllMyExpedientes(typed);
      return (Array.isArray(rows)?rows:[]).map(r=>({...r,_v530_relation:'EN_CUSTODIA'}));
    }catch(_){return [];}
  }

  async function digitalRows530(typed){
    try{
      if(typeof sb==='undefined'||!sb)return [];
      const {data,error}=await sb.rpc('v492_listar_mis_copias_digitales');
      if(error)return [];
      const key=logicalKey530(typed);
      return (Array.isArray(data)?data:[])
        .filter(r=>logicalKey530(r.expediente)===key)
        .map(r=>({
          ...r,
          id:r.expediente_id||r.id,
          expediente_id:r.expediente_id||r.id,
          estado:r.estado_copia==='ENTREGADA'?'COPIA DIGITAL ENTREGADA':(r.estado_copia||'COPIA DIGITAL'),
          _v530_relation:'COPIAS_DIGITALES'
        }));
    }catch(_){return [];}
  }

  async function physicalContext530(typed){
    try{
      if(typeof expSearchFindCandidates!=='function')return [];
      const result=await expSearchFindCandidates(typed,'');
      return Array.isArray(result?.rows)?result.rows:[];
    }catch(_){return [];}
  }

  function merge530(baseRows,currentRows,digitalRows,physicalRows){
    const map=new Map();

    function add(row,relation,isPhysical=false){
      if(!row)return;
      const key=physicalKey530(row);
      if(!key||key==='|')return;
      let item=map.get(key);
      if(!item){
        item={...row,_v530_relations:new Set(),_v530_candidates:[],_v530_physical:null};
        map.set(key,item);
      }

      const rel=relation||row._v530_relation||row._v184_activity||'';
      item._v530_candidates.push({row,relation:rel});
      if(isPhysical)item._v530_physical={...row};
      if(rel)item._v530_relations.add(rel);
      if(row._v184_activity)item._v530_relations.add(row._v184_activity);
      if(row._v530_relation)item._v530_relations.add(row._v530_relation);

      // Completar identificadores y metadatos sin pisar el contexto físico real.
      ['expediente_id','id','expediente','extension','rd','ultimo_folio']
        .forEach(field=>{
          if((item[field]===undefined||item[field]===null||item[field]==='') && row[field]!==undefined && row[field]!==null && row[field]!==''){
            item[field]=row[field];
          }
        });
    }

    (physicalRows||[]).forEach(r=>add(r,'',true));
    (baseRows||[]).forEach(r=>add(r,r._v184_activity||'',false));
    (currentRows||[]).forEach(r=>add(r,'EN_CUSTODIA',false));
    (digitalRows||[]).forEach(r=>add(r,'COPIAS_DIGITALES',false));

    return [...map.values()];
  }


  async function enrichClosedAdmin530(rows){
    const list=Array.isArray(rows)?rows:[];
    if(!list.length || typeof sb==='undefined' || !sb)return list;

    const ids=[...new Set(
      list.map(item=>String(
        item?.expediente_id||
        item?.id||
        item?._v530_physical?.expediente_id||
        item?._v530_physical?.id||
        ''
      ).trim()).filter(Boolean)
    )];

    if(!ids.length)return list;

    try{
      const {data,error}=await sb.rpc(
        'v679_cierre_admin_actual_busqueda',
        {p_expediente_ids:ids}
      );
      if(error)throw error;

      const map=new Map(
        (Array.isArray(data)?data:[]).map(r=>[
          String(r.expediente_id||''),
          r
        ])
      );

      return list.map(item=>{
        const id=String(
          item?.expediente_id||
          item?.id||
          item?._v530_physical?.expediente_id||
          item?._v530_physical?.id||
          ''
        );
        const closed=map.get(id);
        return closed
          ?{...item,_v679_closed_admin:closed}
          :item;
      });
    }catch(error){
      console.warn(
        'V679 · cierre administrativo en búsqueda:',
        error?.message||error
      );
      return list;
    }
  }

  function v610CardType530(candidate){
    const rel=String(
      candidate?.relation||
      candidate?.row?._v184_activity||
      candidate?.row?._v530_relation||
      ''
    ).trim().toUpperCase();
    return rel;
  }

  function v610CardPriority530(type){
    const order={
      PENDIENTES_POR_ATENDER:100,
      DEVOLUCION_SOLICITADA:90,
      PRESTAMO:80,
      REASIGNADOS_A_MI:70,
      REASIGNADOS_POR_MI:65,
      SOLICITUDES_REASIGNACION:60,
      REASIGNACIONES_SOLICITADAS_POR_MI:55,
      DEVUELTOS:50,
      ALERTAS_30:40,
      COPIAS_DIGITALES:30,
      EN_CUSTODIA:20
    };
    return Number(order[type]||0);
  }

  function v610PrimaryCardCandidate530(item){
    if(item?._v679_closed_admin){
      const physical=item?._v530_physical||item||{};
      return {
        relation:'CIERRE_ADMIN_ARCHIVO',
        row:{
          ...physical,
          ...item,
          estado:'EN CUSTODIA DEL ARCHIVO',
          responsable:'ARCHIVO',
          responsable_actual:'ARCHIVO',
          _v679_closed_admin:item._v679_closed_admin
        }
      };
    }

    const candidates=Array.isArray(item?._v530_candidates)
      ?item._v530_candidates.filter(x=>x?.row)
      :[];

    if(!candidates.length){
      return {
        row:item||{},
        relation:String(item?._v184_activity||item?._v530_relation||'EN_CUSTODIA')
      };
    }

    // La búsqueda debe reflejar la misma fila que alimenta la tarjeta.
    // Por eso se priorizan las filas provenientes de las tarjetas V184/V5
    // por encima del contexto físico global usado solo para trazabilidad.
    const cardCandidates=candidates.filter(x=>{
      const t=v610CardType530(x);
      return t && t!=='EN_CUSTODIA';
    });
    const pool=cardCandidates.length?cardCandidates:candidates;

    return [...pool].sort((a,b)=>{
      const pa=v610CardPriority530(v610CardType530(a));
      const pb=v610CardPriority530(v610CardType530(b));
      if(pb!==pa)return pb-pa;
      const ta=Date.parse(latestActivity530(a.row)||a.row?.updated_at||a.row?.created_at||0)||0;
      const tb=Date.parse(latestActivity530(b.row)||b.row?.updated_at||b.row?.created_at||0)||0;
      return tb-ta;
    })[0];
  }

  function v610CardLabel530(type){
    const labels={
      PRESTAMO:'PRÉSTAMOS',
      PENDIENTES_POR_ATENDER:'EXPEDIENTES PENDIENTES POR ATENDER',
      DEVOLUCION_SOLICITADA:'DEVOLUCIÓN SOLICITADA',
      SOLICITUDES_REASIGNACION:'REASIGNACIONES QUE ME SOLICITAN',
      REASIGNACIONES_SOLICITADAS_POR_MI:'REASIGNACIONES SOLICITADAS POR MÍ',
      REASIGNADOS_POR_MI:'REASIGNADOS POR MÍ',
      REASIGNADOS_A_MI:'REASIGNADOS A MÍ',
      DEVUELTOS:'DEVUELTOS AL ARCHIVO',
      ALERTAS_30:'ALERTAS > 30 DÍAS SIN MOVIMIENTO',
      COPIAS_DIGITALES:'COPIAS DIGITALES',
      CIERRE_ADMIN_ARCHIVO:'SOLICITUD CERRADA POR ADMINISTRADOR',
      EN_CUSTODIA:'TOTAL EN CUSTODIA'
    };
    return labels[type]||type||'EXPEDIENTES';
  }

  function v610DigitalCardTable530(rows){
    const list=Array.isArray(rows)?rows:[];
    if(!list.length)return '<div class="empty">No hay copias digitales para mostrar.</div>';
    return `<table>
      <thead><tr>
        <th>Expediente</th><th>Extensión</th><th>Solicitud</th><th class="subject-cell-v639">Asunto</th>
        <th>Fecha / hora solicitud</th><th>Estado</th><th>Copia digital</th><th>Atención</th><th></th>
      </tr></thead>
      <tbody>${list.map(r=>{
        const url=String(r?.enlace||'').trim();
        const delivered=String(r?.estado_copia||'').trim().toUpperCase()==='ENTREGADA'||!!url;
        const id=String(r?.solicitud_id||'').trim();
        return `<tr>
          <td><b>${esc530(r?.expediente||'—')}</b></td>
          <td>${esc530(r?.extension||'—')}</td>
          <td><b>${esc530(r?.solicitud_numero||'—')}</b></td>
          <td class="subject-cell-v639" title="${esc530(r?.asunto||'')}"><div class="subject-text-v639">${esc530(r?.asunto||'—')}</div></td>
          <td>${esc530(time530(r?.fecha_solicitud))}</td>
          <td><span class="v534-request-state">${esc530(r?.estado_copia||'COPIA DIGITAL')}</span></td>
          <td>${url?`<a class="btn secondary small" href="${esc530(url)}" target="_blank" rel="noopener">Abrir copia</a>`:'Aún no entregada'}</td>
          <td>${delivered?`${esc530(r?.atendido_por||'—')}<div class="note">${esc530(time530(r?.entregado_at))}</div>`:'—'}</td>
          <td>${id?`<button class="btn secondary small" type="button" onclick="openRequestDetail('${esc530(id)}')">Ver solicitud</button>`:'—'}</td>
        </tr>`;
      }).join('')}</tbody>
    </table>`;
  }

  function v679ClosedAdminTable530(row){
    const r=row||{};
    const c=r._v679_closed_admin||{};
    const exp=rowNumber530(r)||r.expediente||'—';
    const ext=r.extension||'—';
    const motivo=c.motivo_cierre||'Sin motivo registrado';
    const solicitud=c.solicitud_numero||'—';
    const solicitante=c.solicitante||currentProfile?.nombre_personal||'—';
    const cierre=time530(c.cerrado_at);
    const historialId=r.expediente_id||r.id||'';

    return `<table class="v679-closed-admin-table">
      <thead><tr>
        <th>N° expediente</th>
        <th>Ext.</th>
        <th>Estado actual</th>
        <th>Situación de la solicitud</th>
        <th>Solicitud</th>
        <th>Solicitado por</th>
        <th>Fecha de cierre</th>
        <th>Motivo</th>
        <th>Acciones</th>
      </tr></thead>
      <tbody><tr>
        <td><b>${esc530(exp)}</b></td>
        <td>${esc530(ext)}</td>
        <td>
          <span class="v679-state-archive">EN CUSTODIA DEL ARCHIVO</span>
          <small class="v679-state-note">Disponible para una nueva solicitud</small>
        </td>
        <td>
          <span class="v679-state-closed">CERRADA POR ADMINISTRADOR</span>
          <small class="v679-state-note">No fue entregado físicamente</small>
        </td>
        <td><b>${esc530(solicitud)}</b></td>
        <td>${esc530(solicitante)}</td>
        <td>${esc530(cierre)}</td>
        <td class="v679-close-reason">${esc530(motivo)}</td>
        <td>${historialId && typeof cycleHistoryButton==='function'
          ?cycleHistoryButton(historialId,r)
          :'—'
        }</td>
      </tr></tbody>
    </table>`;
  }

  function v610RenderSameCard530(type,row){
    const rows=[row||{}];

    try{
      if(type==='CIERRE_ADMIN_ARCHIVO'){
        return v679ClosedAdminTable530(row);
      }
      if(type==='PENDIENTES_POR_ATENDER' && typeof renderUserPendingAttentionRows==='function'){
        return renderUserPendingAttentionRows(rows,false);
      }
      if(type==='DEVUELTOS' && typeof renderOwnerHistoricalReturnsTable==='function'){
        return renderOwnerHistoricalReturnsTable(rows,currentProfile?.nombre_personal||'');
      }
      if(type==='SOLICITUDES_REASIGNACION' && typeof renderReceivedReassignTableV196==='function'){
        return renderReceivedReassignTableV196(rows);
      }
      if(type==='REASIGNACIONES_SOLICITADAS_POR_MI' && typeof renderSentReassignTableV197==='function'){
        return renderSentReassignTableV197(rows);
      }
      if(type==='COPIAS_DIGITALES'){
        return v610DigitalCardTable530(rows);
      }
      if(typeof recordTable==='function'){
        // V722: ejecutar V183 y sus complementos con el modo de la tarjeta
        // realmente encontrada, no con el que estaba abierto al buscar.
        return v722RenderCardRows(type,rows);
      }
    }catch(error){
      console.warn('V610 · render de tarjeta en búsqueda:',error?.message||error);
    }

    return `<div class="empty">Expediente localizado en ${esc530(v610CardLabel530(type))}.</div>`;
  }

  function render530(rows,key){
    const table=$('panelTable');
    if(!table)return;

    page=0;
    panelCount=rows.length;
    panelRows=rows;

    if($('panelTitle'))$('panelTitle').textContent=`Resultado de búsqueda · ${currentProfile?.nombre_personal||'Mi historial'}`;
    if($('pageInfo'))$('pageInfo').textContent=rows.length?`${rows.length} coincidencia${rows.length===1?'':'s'}`:'0 coincidencias';

    if(!rows.length){
      table.innerHTML=`<div class="empty">No se encontró el expediente <b>${esc530(key)}</b> en solicitudes, préstamos, copias digitales, reasignaciones, devoluciones ni custodia histórica disponible para su perfil.</div>`;
      return;
    }

    table.innerHTML=rows.map(item=>{
      const candidate=v610PrimaryCardCandidate530(item);
      const type=v610CardType530(candidate)||'EN_CUSTODIA';
      const row={...(candidate?.row||item)};

      // Mantener identificadores físicos conocidos, pero NO sustituir los datos
      // operativos propios de la tarjeta encontrada.
      if(!row.id && item?.id)row.id=item.id;
      if(!row.expediente_id && item?.expediente_id)row.expediente_id=item.expediente_id;
      if(!row.expediente && item?.expediente)row.expediente=item.expediente;
      if(!row.extension && item?.extension)row.extension=item.extension;
      if(!row.rd && item?.rd)row.rd=item.rd;
      if(!row.ultimo_folio && item?.ultimo_folio)row.ultimo_folio=item.ultimo_folio;

      const historicalClosed=type==='CIERRE_ADMIN_ARCHIVO';

      return `<section class="v610-search-card-result${historicalClosed?' v679-closed-admin-result':''}">
        <div class="v610-search-card-head">
          <div>
            <span class="v610-search-card-label">${historicalClosed?'Relación histórica con el usuario':'Información tomada de su tarjeta'}</span>
            <strong>${esc530(v610CardLabel530(type))}</strong>
          </div>
          <span class="v610-search-card-exp">${esc530(rowNumber530(row)||key||'—')}</span>
        </div>
        <div class="v610-search-card-body">
          ${v610RenderSameCard530(type,row)}
        </div>
      </section>`;
    }).join('');
  }

  async function run530(force){
    if(!ensurePanel530())return;
    const input=$('v530UserTraceInput');
    const typed=String(input?.value||'').trim();
    const key=logicalKey530(typed);

    if(!key){
      if(force)setStatus530('Ingrese número-año. Ej.: 36-2000.','error');
      return;
    }

    const mySeq=++seq;
    const btn=$('v530UserTraceBtn');
    if(btn){btn.disabled=true;btn.textContent='Buscando…';}
    setStatus530(`Buscando ${key} en toda su trazabilidad…`,'searching');

    // Mantener sincronizado el buscador histórico que ya usa el sistema.
    const hidden=$('searchInput');
    if(hidden)hidden.value=typed;

    try{
      const basePromise=(typeof window.v395FastUserSearch==='function')
        ?window.v395FastUserSearch(typed,key)
        :Promise.resolve([]);

      const [base,current,digital,physical]=await Promise.all([
        basePromise,
        currentRows530(typed),
        digitalRows530(typed),
        physicalContext530(typed)
      ]);

      if(mySeq!==seq)return;

      let rows=merge530(base,current,digital,physical)
        .filter(r=>logicalKey530(rowNumber530(r))===key);

      rows=await enrichClosedAdmin530(rows);
      if(typeof v723EnrichSearchResults==='function'){
        rows=await v723EnrichSearchResults(rows);
      }
      if(mySeq!==seq)return;

      render530(rows,key);
      setStatus530(
        rows.length
          ?`${rows.length} expediente${rows.length===1?'':'s'} localizado${rows.length===1?'':'s'}. Se revisaron todas las relaciones disponibles para su perfil.`
          :`No se encontraron relaciones con ${key}.`,
        rows.length?'ok':'error'
      );
    }catch(error){
      if(mySeq!==seq)return;
      console.error('V530 · buscador personal:',error);
      setStatus530(error?.message||'No se pudo realizar la búsqueda.','error');
    }finally{
      if(mySeq===seq && btn){btn.disabled=false;btn.textContent='🔎 Buscar';}
    }
  }

  async function clear530(){
    clearTimeout(timer);
    seq++;
    const input=$('v530UserTraceInput');
    if(input)input.value='';
    const hidden=$('searchInput');
    if(hidden)hidden.value='';
    setStatus530('Escriba el número y año del expediente.','');
    try{
      if(typeof showUserCard==='function'){
        await showUserCard('TODOS');
      }else if(typeof loadPanel==='function'){
        await loadPanel({forceFresh:false});
      }
    }catch(_){ }
    input?.focus();
  }

  window.v530RunUserTraceSearch=run530;
  window.v530ClearUserTraceSearch=clear530;

  // Etiquetas adicionales para el motor histórico existente.
  try{
    const baseLabel=window.userActivityLabelV184;
    if(typeof baseLabel==='function'){
      window.userActivityLabelV184=function(type){
        if(type==='COPIAS_DIGITALES')return 'COPIAS DIGITALES';
        if(type==='EN_CUSTODIA')return 'EN CUSTODIA';
        return baseLabel.apply(this,arguments);
      };
    }
  }catch(_){ }

  function boot530(){
    if(ensurePanel530())return;
    setTimeout(boot530,150);
  }

  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot530,{once:true});
  else boot530();
})();
</script>



<style id="v533-hide-old-user-search">
/* =========================================================
   V533 · PERFIL USUARIO
   Oculta SOLO el buscador antiguo superior.
   Conserva el buscador V530 de trazabilidad total.
   ========================================================= */
body.produce-user .v349-toolbar-search,
body.produce-user .field:has(#searchInput){
  display:none !important;
}
body.produce-user .main-sticky-header .actions > .v349-toolbar-search{
  margin:0 !important;
  padding:0 !important;
  min-height:0 !important;
  height:0 !important;
  overflow:hidden !important;
}
body.produce-user #v530UserTraceSearch{
  display:block !important;
}
</style>
<script id="v533-hide-old-user-search-script">
(function(){
  'use strict';
  function applyV533(){
    if(!document.body || !document.body.classList.contains('produce-user'))return;

    const oldInput=document.getElementById('searchInput');
    if(oldInput){
      const toolbar=oldInput.closest('.v349-toolbar-search');
      const field=oldInput.closest('.field');
      const target=toolbar||field;
      if(target){
        target.setAttribute('data-v533-old-search','hidden');
        target.style.setProperty('display','none','important');
      }
    }

    const trace=document.getElementById('v530UserTraceSearch');
    if(trace)trace.style.setProperty('display','none','important');
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',applyV533,{once:true});
  }else{
    applyV533();
  }
  window.addEventListener('load',applyV533,{once:true});
  setTimeout(applyV533,150);
  setTimeout(applyV533,700);
})();
</script>

