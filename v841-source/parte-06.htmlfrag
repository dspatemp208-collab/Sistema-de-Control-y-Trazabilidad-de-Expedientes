    margin:0!important;
    padding:8px 12px!important;
    gap:8px!important;
    white-space:nowrap!important;
    font-size:12px!important;
  }
}
</style>
<script id="v433-uniform-new-request-script">
(function(){
  'use strict';

  function isCoordinatorV433(){
    try{ if(typeof isCoordinatorProfileV403==='function') return !!isCoordinatorProfileV403(); }catch(_){ }
    try{ if(typeof isCoordinator==='function') return !!isCoordinator(); }catch(_){ }
    try{
      return String((window.currentProfile||{}).rol||(window.currentProfile||{}).perfil||'').trim().toUpperCase()==='COORDINADOR';
    }catch(_){ return false; }
  }

  function openNewRequestV433(){
    try{
      if(isCoordinatorV433() && typeof openCoordinatorNewRequestV396==='function'){
        openCoordinatorNewRequestV396();
        return;
      }
    }catch(_){ }
    try{
      if(typeof openNewRequestModal==='function'){
        openNewRequestModal();
        return;
      }
    }catch(_){ }
    try{ if(typeof showToast==='function') showToast('No se pudo abrir Nueva solicitud.'); }catch(_){ }
  }

  function destinationRequestButtonV433(nav){
    if(!nav) return null;

    /* Staff (Administrador/Archivo): usar la entrada personal Mis solicitudes. */
    const staff=document.getElementById('staffMySolicitudesV319');
    if(staff && staff.parentElement===nav && !staff.hidden) return staff;

    /* Coordinador / Usuario: usar la entrada visible Mis solicitudes. */
    const list=[...nav.querySelectorAll('button[data-destination="requests"]')]
      .filter(function(b){
        if(!b || b.id==='produceSideNewRequest') return false;
        const cs=window.getComputedStyle ? getComputedStyle(b) : null;
        return !b.hidden && (!cs || cs.display!=='none');
      });
    return list.length ? list[0] : null;
  }

  function syncNewRequestV433(){
    const nav=document.querySelector('.produce-nav');
    const btn=document.getElementById('produceSideNewRequest');
    if(!nav || !btn) return;

    /* Role UI antiguas pueden volver a colocar hidden; V433 lo normaliza. */
    if(btn.hidden) btn.hidden=false;
    btn.removeAttribute('hidden');
    btn.disabled=false;
    btn.setAttribute('aria-label','Nueva solicitud');
    btn.title='Registrar una nueva solicitud';
    btn.onclick=openNewRequestV433;

    const anchor=destinationRequestButtonV433(nav);
    if(anchor && anchor.nextElementSibling!==btn){
      anchor.insertAdjacentElement('afterend',btn);
    }

    /* Ocultar accesos duplicados sin eliminar su lógica histórica. */
    ['coordinatorNewRequestBtnV396','requestNewRequestBtn'].forEach(function(id){
      const el=document.getElementById(id);
      if(el){ el.hidden=true; el.style.setProperty('display','none','important'); }
    });

    const topSearch=document.getElementById('searchRequestBtn');
    if(topSearch){
      topSearch.hidden=true;
      topSearch.style.setProperty('display','none','important');
    }
  }

  function installV433(){
    syncNewRequestV433();
    [100,350,900,1600].forEach(function(ms){ setTimeout(syncNewRequestV433,ms); });

    const nav=document.querySelector('.produce-nav');
    if(nav && window.MutationObserver){
      let queued=false;
      const observer=new MutationObserver(function(){
        if(queued) return;
        queued=true;
        requestAnimationFrame(function(){
          queued=false;
          syncNewRequestV433();
        });
      });
      observer.observe(nav,{childList:true,subtree:true,attributes:true,attributeFilter:['hidden','class','style']});
    }

    if(window.MutationObserver && document.body){
      let queuedBody=false;
      const bodyObserver=new MutationObserver(function(){
        if(queuedBody) return;
        queuedBody=true;
        requestAnimationFrame(function(){
          queuedBody=false;
          syncNewRequestV433();
        });
      });
      bodyObserver.observe(document.body,{attributes:true,attributeFilter:['class']});
    }
  }

  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',installV433,{once:true});
  else installV433();
  window.addEventListener('load',syncNewRequestV433,{once:true});
  window.syncNewRequestV433=syncNewRequestV433;
})();
</script>
<style id="v446-global-new-request-style">
/* ============================================================
   V446 · NUEVA SOLICITUD VISIBLE EN TODOS LOS PERFILES
   - Se aplica sobre V444 limpia.
   - No modifica Supabase ni requiere SQL.
   - Evita depender del acceso lateral de V433.
   ============================================================ */

#v446GlobalNewRequestBtn{
  display:inline-flex!important;
  visibility:visible!important;
  opacity:1!important;
  align-items:center!important;
  justify-content:center!important;
  gap:7px!important;
  min-height:42px!important;
  padding:9px 16px!important;
  border:1px solid #1261ed!important;
  border-radius:8px!important;
  background:#176bff!important;
  color:#fff!important;
  font-weight:800!important;
  font-size:13px!important;
  white-space:nowrap!important;
  cursor:pointer!important;
  box-shadow:0 3px 9px rgba(50,99,153,.08)!important;
  order:-30!important;
}

#v446GlobalNewRequestBtn:hover{
  background:#0f5ee9!important;
}

#v446GlobalNewRequestBtn:disabled{
  opacity:.55!important;
  cursor:not-allowed!important;
}

/* Un solo acceso visible. Las acciones antiguas se conservan en el código,
   pero no compiten visualmente con el botón V446. */
#archiveNewRequestBtn,
#coordinatorNewRequestBtnV396,
#requestNewRequestBtn,
#produceSideNewRequest,
body.produce-user #searchRequestBtn,
body.produce-staff #searchRequestBtn,
body.produce-coordinator #searchRequestBtn,
body.produce-coordinator-self #searchRequestBtn{
  display:none!important;
}

/* Si las reglas históricas dejaron vacía/oculta la barra de acciones,
   V446 la recupera cuando contiene el nuevo botón. */
body.produce-user .main-sticky-header .actions:has(#v446GlobalNewRequestBtn),
body.produce-staff .main-sticky-header .actions:has(#v446GlobalNewRequestBtn),
body.produce-coordinator .main-sticky-header .actions:has(#v446GlobalNewRequestBtn),
body.produce-coordinator-self .main-sticky-header .actions:has(#v446GlobalNewRequestBtn){
  display:flex!important;
  visibility:visible!important;
  opacity:1!important;
  min-height:42px!important;
  align-items:center!important;
  gap:8px!important;
  flex-wrap:wrap!important;
}

body.v170-task-layer #backgroundReviewText::after{
  content:" · V637 REASIGNACIONES ACTIVAS · TODOS LOS PERFILES"!important;
}

@media(max-width:700px){
  #v446GlobalNewRequestBtn{
    width:100%!important;
    min-height:44px!important;
  }
}
</style>
<script id="v446-global-new-request-script">
(function(){
  'use strict';

  function profileV446(){
    try{
      if(typeof currentProfile!=='undefined' && currentProfile){
        return currentProfile;
      }
    }catch(_){}

    try{
      return window.currentProfile||null;
    }catch(_){
      return null;
    }
  }

  function profileActiveV446(){
    const p=profileV446();
    return !!p && p.activo!==false;
  }

  function isCoordinatorV446(){
    try{
      if(typeof isCoordinatorProfileV403==='function'){
        return !!isCoordinatorProfileV403();
      }
    }catch(_){}

    try{
      if(typeof isCoordinator==='function'){
        return !!isCoordinator();
      }
    }catch(_){}

    const p=profileV446()||{};
    return String(p.rol||p.perfil||'')
      .trim()
      .toUpperCase()==='COORDINADOR';
  }

  function openNewRequestV446(){
    if(!profileActiveV446()){
      try{
        if(typeof showToast==='function'){
          showToast('Cuenta sin acceso.');
        }else{
          alert('Cuenta sin acceso.');
        }
      }catch(_){}
      return;
    }

    try{
      if(
        isCoordinatorV446() &&
        typeof openCoordinatorNewRequestV396==='function'
      ){
        openCoordinatorNewRequestV396();
        return;
      }
    }catch(error){
      console.warn('V446 · flujo coordinador:',error);
    }

    try{
      if(typeof openNewRequestModal==='function'){
        openNewRequestModal();
        return;
      }
    }catch(error){
      console.error('V446 · Nueva solicitud:',error);
    }

    try{
      if(typeof showToast==='function'){
        showToast('No se pudo abrir Nueva solicitud.');
      }else{
        alert('No se pudo abrir Nueva solicitud.');
      }
    }catch(_){}
  }

  function ensureButtonV446(){
    const actions=document.querySelector('.main-sticky-header .actions');
    if(!actions)return null;

    let btn=document.getElementById('v446GlobalNewRequestBtn');

    if(!btn){
      btn=document.createElement('button');
      btn.type='button';
      btn.id='v446GlobalNewRequestBtn';
      btn.className='btn';
      btn.innerHTML='<span aria-hidden="true">＋</span><span>Nueva solicitud</span>';
      btn.setAttribute('aria-label','Nueva solicitud de expedientes');
      btn.title='Registrar una nueva solicitud de expedientes';
    }

    if(btn.parentElement!==actions){
      actions.insertBefore(btn,actions.firstChild);
    }else if(actions.firstElementChild!==btn){
      actions.insertBefore(btn,actions.firstChild);
    }

    const active=profileActiveV446();

    btn.onclick=openNewRequestV446;
    btn.hidden=!active;
    btn.disabled=!active;

    if(active){
      btn.removeAttribute('hidden');
      btn.style.setProperty('display','inline-flex','important');
    }else{
      btn.style.setProperty('display','none','important');
    }

    /* Neutralizar accesos históricos duplicados.
       No se eliminan: solo se ocultan. */
    [
      'archiveNewRequestBtn',
      'coordinatorNewRequestBtnV396',
      'requestNewRequestBtn',
      'produceSideNewRequest',
      'searchRequestBtn'
    ].forEach(function(id){
      const old=document.getElementById(id);
      if(!old || old===btn)return;
      old.hidden=true;
      old.style.setProperty('display','none','important');
    });

    return btn;
  }

  function syncV446(){
    ensureButtonV446();
  }

  function bootV446(){
    syncV446();

    [80,250,600,1200,2200].forEach(function(ms){
      setTimeout(syncV446,ms);
    });

    if(window.MutationObserver){
      const header=document.querySelector('.main-sticky-header');

      if(header){
        let queued=false;
        new MutationObserver(function(){
          if(queued)return;
          queued=true;
          requestAnimationFrame(function(){
            queued=false;
            syncV446();
          });
        }).observe(
          header,
          {
            childList:true,
            subtree:true,
            attributes:true,
            attributeFilter:['class','style','hidden']
          }
        );
      }

      if(document.body){
        let queuedBody=false;
        new MutationObserver(function(){
          if(queuedBody)return;
          queuedBody=true;
          requestAnimationFrame(function(){
            queuedBody=false;
            syncV446();
          });
        }).observe(
          document.body,
          {
            attributes:true,
            attributeFilter:['class']
          }
        );
      }
    }
  }

  if(document.readyState==='loading'){
    document.addEventListener(
      'DOMContentLoaded',
      bootV446,
      {once:true}
    );
  }else{
    bootV446();
  }

  window.addEventListener(
    'load',
    syncV446,
    {once:true}
  );

  window.syncNewRequestV446=syncV446;
})();
</script>
<style id="v459-natural-flow-canonical">
/* V459 · Flujo natural canónico: sin capas sticky internas ni contención de pintado. */
main.main section:not(.hidden),
main.main section:not(.hidden) .card,
main.main section:not(.hidden) .table-wrap,
