<style id="v545-alerts-all-profiles-style">
#desktopNotifyBtnV467.v545-active-all{
  background:#e9f8ef!important;
  color:#17613a!important;
  border-color:#86c9a2!important;
}
</style>
<script id="v545-alerts-all-profiles-script">
(function(){
  'use strict';

  const KEY='v467_desktop_notifications_enabled';
  let lastProfile='';
  let busy=false;

  function currentProfileKey(){
    try{
      return String(
        window.session?.user?.id ||
        window.currentProfile?.id ||
        window.currentProfile?.email ||
        ''
      );
    }catch(_){return '';}
  }

  function syncPermission(){
    const btn=document.getElementById('desktopNotifyBtnV467');
    if(!btn)return;

    if(!('Notification' in window)){
      btn.textContent='🔕 Avisos PC no disponibles';
      btn.classList.remove('v545-active-all');
      return;
    }

    if(Notification.permission==='granted'){
      // V545: si el navegador YA concedió permiso, los avisos quedan
      // activos para cualquier perfil que inicie sesión en este navegador.
      try{localStorage.setItem(KEY,'1');}catch(_){}
      btn.textContent='🔔 Avisos PC activos';
      btn.classList.add('v545-active-all','v467-active','v483-native-ok');
      btn.classList.remove('v467-waiting','v467-blocked','v483-native-warn');
      btn.title='Avisos nativos activos para todos los perfiles en este navegador.';
      return;
    }

    if(Notification.permission==='denied'){
      btn.textContent='🔕 Avisos PC bloqueados';
      btn.classList.remove('v545-active-all');
      btn.title='Chrome/Edge tiene bloqueadas las notificaciones para este sitio.';
      return;
    }

    btn.textContent='🔔 Activar avisos PC';
    btn.classList.remove('v545-active-all');
    btn.title='Pulse una vez para autorizar avisos de Windows/Chrome. Luego quedarán activos para todos los perfiles de este navegador.';
  }

  async function refreshAlertsForProfile(){
    if(busy)return;
    const key=currentProfileKey();
    if(!key)return;
    busy=true;
    try{
      syncPermission();
      const jobs=[];
      try{if(typeof window.loadNotifications==='function')jobs.push(window.loadNotifications(true));}catch(_){}
      try{if(typeof window.loadInternalReassignRequests==='function')jobs.push(window.loadInternalReassignRequests(true));}catch(_){}
      try{if(typeof window.loadOperationalAlerts==='function')jobs.push(window.loadOperationalAlerts(true));}catch(_){}
      try{if(typeof window.loadArchiveDeliveryRequests==='function')jobs.push(window.loadArchiveDeliveryRequests(true));}catch(_){}
      if(jobs.length)await Promise.allSettled(jobs);
      try{if(typeof window.refreshPersistentReassignmentNotificationsV483==='function')await window.refreshPersistentReassignmentNotificationsV483();}catch(_){}
      try{if(typeof window.updateAlertsBadge==='function')window.updateAlertsBadge();}catch(_){}
    }finally{busy=false;}
  }

  function profileWatch(){
    const key=currentProfileKey();
    if(key && key!==lastProfile){
      lastProfile=key;
      setTimeout(refreshAlertsForProfile,250);
      setTimeout(refreshAlertsForProfile,1600);
    }else{
      syncPermission();
    }
  }

  // No se intenta pedir permiso automáticamente: el navegador exige
  // que el usuario lo autorice mediante un clic. Si ya está concedido,
  // V545 reactiva la marca local automáticamente.
  window.v545SyncDesktopAlerts=syncPermission;
  window.v545RefreshProfileAlerts=refreshAlertsForProfile;

  setInterval(profileWatch,2000);
  // V602: foco/visibilidad solo sincronizan el permiso visual. Las fuentes de
  // alertas se cargan al cambiar realmente de perfil o mediante V170/cambio.
  window.addEventListener('focus',syncPermission,{passive:true});
  document.addEventListener('visibilitychange',()=>{if(!document.hidden)syncPermission();});

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',()=>{
      syncPermission();
      setTimeout(profileWatch,500);
    },{once:true});
  }else{
    syncPermission();
    setTimeout(profileWatch,500);
  }
})();
</script>

<style id="v546-personal-alert-center-style">
/* V546 · Centro de alertas adaptado a Usuario/Coordinador */
body.v546-personal-alerts #alertsModal .v364-summary-card.is-new,
body.v546-personal-alerts #alertsModal [data-v364-filter="new"],
body.v546-personal-alerts #alertsModal #v364NewSection{display:none!important}
body.v546-personal-alerts #alertsModal .v364-summary{grid-template-columns:repeat(2,minmax(0,1fr))!important}
body.v546-personal-alerts #alertsModal .v364-summary-card.is-action{border-left-color:#2d7dc0!important}
body.v546-personal-alerts #alertsModal .v364-summary-card.is-notice{border-left-color:#7a58d1!important}
.v546-personal-notice-tag{display:inline-flex;align-items:center;padding:2px 7px;border-radius:999px;font-size:9px;font-weight:850;background:#e5f5ee;color:#176344;border:1px solid #b9dfce}
@media(max-width:700px){body.v546-personal-alerts #alertsModal .v364-summary{grid-template-columns:1fr!important}}
</style>
<script id="v546-personal-alert-center-script">
(function(){
  'use strict';

  let personalRows=[];
  let loading=false;
  let loadedAt=0;
  const TTL=60000;

  const up=v=>String(v??'').trim().toUpperCase();
  const clean=v=>String(v??'').trim();
  const escJs=v=>String(v??'').replace(/\\/g,'\\\\').replace(/'/g,"\\'").replace(/\r?\n/g,' ');

  function role(){
    try{return up(currentProfile?.rol||'');}catch(_){return '';}
  }
  function isPersonal(){return ['USUARIO','COORDINADOR'].includes(role());}
  function userId(){
    try{return String(session?.user?.id||currentProfile?.id||'anon');}catch(_){return 'anon';}
  }
  function seenKey(){return 'v546_personal_alerts_seen_'+userId();}
  function notifiedKey(){return 'v546_personal_alerts_notified_'+userId();}
  function loadSet(key){
    try{const x=JSON.parse(localStorage.getItem(key)||'[]');return new Set(Array.isArray(x)?x:[]);}catch(_){return new Set();}
  }
  function saveSet(key,set){
    try{localStorage.setItem(key,JSON.stringify([...set].slice(-500)));}catch(_){}
  }
  function asTime(v){const n=new Date(v||0).getTime();return Number.isFinite(n)?n:0;}
  function requestId(r){return String(r?.id||r?.solicitud_id||'');}
  function eventDate(r){
    return r?.entregado_at||r?.fecha_ultima_atencion||r?.ultima_atencion||r?.updated_at||r?.fecha_atencion||r?.fecha_entrega||r?.created_at||r?.fecha_solicitud||null;
  }

  function markRead(id){
    const seen=loadSet(seenKey());seen.add(String(id));saveSet(seenKey(),seen);
    const row=personalRows.find(x=>x.id===String(id));if(row){row.unread=false;row.read=true;}
    try{renderV364Alerts(true);}catch(_){}
  }
  window.v546MarkPersonalNoticeRead=markRead;

  window.v546OpenPersonalRequest=function(id,request){
    markRead(id);
    try{closeAlertsModal();}catch(_){}
    try{if(typeof openRequestDetail==='function')openRequestDetail(String(request));}catch(_){}
  };
  window.v546OpenDigitalCopy=function(id,url,request){
    markRead(id);
    const safe=clean(url);
    if(/^https?:\/\//i.test(safe)){
      try{window.open(safe,'_blank','noopener,noreferrer');return;}catch(_){}
    }
    try{closeAlertsModal();}catch(_){}
    try{if(typeof openRequestDetail==='function')openRequestDetail(String(request));}catch(_){}
  };

  function maybeNativeNotify(rows){
    try{
      if(!('Notification' in window)||Notification.permission!=='granted')return;
      if(typeof v467IsEnabled==='function'&&!v467IsEnabled())return;
      const notified=loadSet(notifiedKey());
      const now=Date.now();
      let sent=0;
      rows.filter(r=>r.unread).sort((a,b)=>asTime(b.date)-asTime(a.date)).forEach(r=>{
        if(sent>=3||notified.has(r.id))return;
        const t=asTime(r.date);
        if(!t||now-t>48*60*60*1000)return;
        try{
          const n=new Notification('🔔 '+(r.title||'Novedad de expediente'),{
            body:r.message||'Tiene una novedad en el Sistema de Control y Trazabilidad de Expedientes.',
            tag:'v546-'+r.id,
            requireInteraction:false
          });
          n.onclick=()=>{try{window.focus();n.close();}catch(_){}};
          notified.add(r.id);sent++;
        }catch(_){}
      });
      saveSet(notifiedKey(),notified);
    }catch(_){}
  }

  async function loadPersonalNotices(force=false){
    if(!isPersonal()||typeof sb==='undefined'||!sb||typeof session==='undefined'||!session){personalRows=[];return [];}
    if(loading)return personalRows;
    if(!force&&personalRows.length&&Date.now()-loadedAt<TTL)return personalRows;
    loading=true;
    const rows=[];
    const seen=loadSet(seenKey());

    try{
      // 1) Copias digitales: fuente más precisa para saber si el enlace fue entregado.
      try{
        const result=await sb.rpc('v492_listar_mis_copias_digitales');
        if(!result.error){
          (Array.isArray(result.data)?result.data:[]).forEach(r=>{
            if(up(r?.estado_copia)!=='ENTREGADA')return;
            const id='digital:'+String(r.solicitud_id||'')+':'+String(r.expediente_id||'')+':ENTREGADA';
            const unread=!seen.has(id);
            const url=clean(r.enlace);
            rows.push({
              kind:'notice',id,source:'v546-digital',
              title:`${r.expediente||'Expediente'} · copia digital disponible`,
              type:'COPIA DIGITAL',expediente:r.expediente||'',solicitud:r.solicitud_numero||'',
              message:`La copia digital fue entregada${r.atendido_por?' por '+r.atendido_por:''}.`,
              date:r.entregado_at||r.fecha_solicitud||null,unread,read:!unread,
              primaryLabel:url?'Abrir copia':'Ver solicitud',
              primaryAction:url
                ?`v546OpenDigitalCopy('${escJs(id)}','${escJs(url)}','${escJs(r.solicitud_id)}')`
                :`v546OpenPersonalRequest('${escJs(id)}','${escJs(r.solicitud_id)}')`,
              secondaryLabel:unread?'Marcar como leída':'',
              secondaryAction:unread?`v546MarkPersonalNoticeRead('${escJs(id)}')`:''
            });
          });
        }
      }catch(error){console.warn('V546 · copias digitales:',error?.message||error);}

      // 2) Solicitudes propias atendidas o cerradas. No duplicar COPIA DIGITAL.
      try{
        const result=await sb.rpc('listar_solicitudes_prestamo',{p_busqueda:null,p_estado:null});
        if(!result.error){
          let list=Array.isArray(result.data)?result.data:[];
          try{if(typeof requestsVisibleForCurrentProfile==='function')list=requestsVisibleForCurrentProfile(list);}catch(_){}
          list.forEach(r=>{
            if(up(r?.modalidad)==='COPIA DIGITAL')return;
            const state=up(r?.estado_atencion||r?.estado||'');
            let title='',message='',type='SOLICITUD';
            if(state==='ENTREGA TOTAL'){
              title=`${r.numero||'Solicitud'} · atención completada`;
              message='Los expedientes de esta solicitud fueron entregados.';
            }else if(state==='ENTREGA PARCIAL'){
              title=`${r.numero||'Solicitud'} · atención parcial`;
              message='Parte de los expedientes solicitados ya fue atendida.';
            }else if(['CERRADA POR ARCHIVO','CERRADO POR ARCHIVO'].includes(state)){
              title=`${r.numero||'Solicitud'} · devolución confirmada`;
              message='Archivo confirmó la recepción y cierre del ciclo.';
              type='DEVOLUCIÓN';
            }else{
              return;
            }
            const rid=requestId(r);if(!rid)return;
            const id='request:'+rid+':'+state;
            const unread=!seen.has(id);
            rows.push({
              kind:'notice',id,source:'v546-request',title,type,
              solicitud:r.numero||'',message,date:eventDate(r),unread,read:!unread,
              primaryLabel:'Ver solicitud',
              primaryAction:`v546OpenPersonalRequest('${escJs(id)}','${escJs(rid)}')`,
              secondaryLabel:unread?'Marcar como leída':'',
              secondaryAction:unread?`v546MarkPersonalNoticeRead('${escJs(id)}')`:''
            });
          });
        }
      }catch(error){console.warn('V546 · solicitudes personales:',error?.message||error);}
    }finally{
      personalRows=rows.sort((a,b)=>asTime(b.date)-asTime(a.date));
      loadedAt=Date.now();loading=false;
      maybeNativeNotify(personalRows);
    }
    return personalRows;
  }
  window.loadV546PersonalNotices=loadPersonalNotices;

  // Añadir novedades personales al flujo existente de avisos.
  const baseNoticeRows=typeof v364NoticeRows==='function'?v364NoticeRows:null;
  if(baseNoticeRows){
    v364NoticeRows=function(){
      const base=baseNoticeRows()||[];
      if(!isPersonal())return base;
      const byId=new Map();
      [...personalRows,...base].forEach(x=>{if(x?.id&&!byId.has(String(x.id)))byId.set(String(x.id),x);});
      return [...byId.values()].sort((a,b)=>asTime(b.date)-asTime(a.date));
    };
  }

  function adaptLabels(){
    const personal=isPersonal();
    document.body.classList.toggle('v546-personal-alerts',personal);
    if(!personal)return;
    const modal=document.getElementById('alertsModal');if(!modal)return;
    const subtitle=modal.querySelector('.alerts-modal-subtitle');
    if(subtitle)subtitle.textContent='Aquí verá acciones pendientes y novedades relacionadas con sus expedientes.';
    const totalLabel=modal.querySelector('.alerts-total-label');if(totalLabel)totalLabel.textContent='PENDIENTES Y NOVEDADES';
    const actionText=modal.querySelector('.v364-summary-card.is-action .v364-summary-text');if(actionText)actionText.textContent='ACCIONES PENDIENTES';
    const noticeText=modal.querySelector('.v364-summary-card.is-notice .v364-summary-text');if(noticeText)noticeText.textContent='NOVEDADES SIN LEER';
    const tabTasks=modal.querySelector('[data-v364-filter="tasks"]');if(tabTasks)tabTasks.textContent='Acciones pendientes';
    const tabNotices=modal.querySelector('[data-v364-filter="notices"]');if(tabNotices)tabNotices.textContent='Novedades';
    const taskHead=modal.querySelector('#v364TaskSection .v364-section-head strong');if(taskHead)taskHead.textContent='Acciones pendientes';
    const taskSmall=modal.querySelector('#v364TaskSection .v364-section-head small');if(taskSmall)taskSmall.textContent='Reasignaciones, devoluciones u otras acciones que requieren su intervención.';
    const noticeHead=modal.querySelector('#v364NoticeSection .v364-section-head strong');if(noticeHead)noticeHead.textContent='Novedades de mis expedientes';
    const noticeSmall=modal.querySelector('#v364NoticeSection .v364-section-head small');if(noticeSmall)noticeSmall.textContent='Copias digitales entregadas, solicitudes atendidas y otros cambios para su conocimiento.';
  }

  const baseRender=typeof renderV364Alerts==='function'?renderV364Alerts:null;
  if(baseRender){
    renderV364Alerts=function(force=false){
      const out=baseRender(force);
      adaptLabels();
      if(isPersonal()){
        try{
          const tasks=typeof v364TaskRows==='function'?v364TaskRows():[];
          const notices=typeof v364NoticeRows==='function'?v364NoticeRows():[];
          const unread=notices.filter(x=>x.unread);
          const st=document.getElementById('v364Status');
          if(st&&!v364Refreshing){
            st.textContent=(tasks.length+unread.length)
              ?`${tasks.length} acción(es) pendiente(s) · ${unread.length} novedad(es) sin leer.`
              :'No tiene acciones ni novedades pendientes.';
          }
          const total=document.getElementById('alertsUnreadText');
          if(total)total.textContent=String(tasks.length+unread.length);
        }catch(_){}
      }
      return out;
    };
    window.renderV361Alerts=renderV364Alerts;
  }

  const baseRefresh=typeof refreshV364Alerts==='function'?refreshV364Alerts:null;
  if(baseRefresh){
    refreshV364Alerts=async function(manual=false){
      if(!isPersonal())return await baseRefresh(manual);
      await Promise.allSettled([baseRefresh(manual),loadPersonalNotices(true)]);
      try{renderV364Alerts(true);}catch(_){}
    };
    window.refreshV361Alerts=refreshV364Alerts;
  }

  const baseOpen=window.openAlertsModal;
  window.openAlertsModal=async function(){
    adaptLabels();
    if(typeof baseOpen==='function')baseOpen.apply(this,arguments);
    if(isPersonal()){
      await loadPersonalNotices(false);
      try{renderV364Alerts(true);}catch(_){}
    }
  };

  // Sincronizar avisos personales periódicamente sin saturar Supabase.
  setInterval(()=>{
    if(document.hidden||!isPersonal()||!document.getElementById('alertsModal')?.classList.contains('show'))return;
    if(Date.now()-loadedAt<TTL)return;
    if(window.v601Protection && !window.v601Protection.canPoll('v546'))return;
    loadPersonalNotices(true).then(()=>{try{renderV364Alerts(true);}catch(_){}}).catch(()=>{});
  },60000);

  setTimeout(()=>{adaptLabels();if(isPersonal())loadPersonalNotices(false).catch(()=>{});},500);
})();
</script>



<style id="v549-alert-drawer-style">
/* ============================================================
   V549 · BANDEJA LATERAL DE AVISOS
   Sustituye los avisos flotantes apilados de V547/V548.
   ============================================================ */
#v549AlertBackdrop{
  position:fixed;inset:0;background:rgba(12,34,57,.28);z-index:12040;
  opacity:0;visibility:hidden;transition:opacity .18s ease,visibility .18s ease;
}
#v549AlertBackdrop.show{opacity:1;visibility:visible}
#v549AlertDrawer{
  position:fixed;top:0;right:0;height:100dvh;width:min(430px,94vw);
  background:#eef4f9;border-left:1px solid #bed0e1;z-index:12050;
  box-shadow:-18px 0 42px rgba(12,34,57,.22);
  transform:translateX(104%);transition:transform .22s ease;
  display:flex;flex-direction:column;overflow:hidden;
}
#v549AlertDrawer.show{transform:translateX(0)}
.v549-drawer-head{
  flex:none;padding:16px 16px 12px;background:#f5f9fc;border-bottom:1px solid #ccd9e6;
}
.v549-head-row{display:flex;align-items:center;gap:10px}
.v549-head-icon{width:38px;height:38px;border-radius:12px;background:#dfeaf5;display:flex;align-items:center;justify-content:center;font-size:20px}
.v549-head-copy{min-width:0;flex:1}
.v549-head-copy h3{margin:0;color:#153b62;font-size:18px;line-height:1.15}
.v549-head-copy p{margin:3px 0 0;color:#667d93;font-size:10.5px;line-height:1.3}
.v549-total-badge{min-width:30px;height:28px;padding:0 8px;border-radius:999px;background:#174b78;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-weight:900;font-size:12px}
.v549-close-drawer{width:34px;height:34px;border:1px solid #c4d3e1;background:#f8fbfd;border-radius:9px;color:#355875;font-size:19px;cursor:pointer;display:flex;align-items:center;justify-content:center}
.v549-close-drawer:hover{background:#e5eef6}
.v549-tabs{display:flex;gap:6px;margin-top:12px;overflow-x:auto;scrollbar-width:none}
.v549-tabs::-webkit-scrollbar{display:none}
.v549-filter{border:1px solid #c7d5e3;background:#f8fbfd;color:#355875;border-radius:999px;padding:6px 10px;font-size:10.5px;font-weight:800;cursor:pointer;white-space:nowrap}
.v549-filter.active{background:#174f80;color:#fff;border-color:#174f80}
.v549-drawer-body{flex:1;overflow:auto;padding:12px;scrollbar-width:thin}
.v549-empty{min-height:180px;border:1px dashed #c4d5e5;border-radius:12px;background:#f4f8fb;color:#74879a;display:flex;align-items:center;justify-content:center;text-align:center;padding:22px;font-size:12px}
.v549-alert-list{display:flex;flex-direction:column;gap:8px}
.v549-item{background:#f7fbfe;border:1px solid #cbdbea;border-left:4px solid #2d7dc0;border-radius:11px;overflow:hidden}
.v549-item.notice{border-left-color:#7257ca}
.v549-item.digital{border-left-color:#13867a}
.v549-item.high{border-left-color:#cf2639}
.v549-item-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;padding:10px 11px 5px}
.v549-item-title{font-size:12px;font-weight:900;color:#163b61;line-height:1.25}
.v549-item-badge{flex:none;padding:2px 7px;border-radius:999px;background:#e7f0f8;color:#275c8a;font-size:8px;font-weight:900;white-space:nowrap}
.v549-item.notice .v549-item-badge{background:#eee9ff;color:#5943a7}
.v549-item.digital .v549-item-badge{background:#dff3ef;color:#11655c}
.v549-item-body{padding:2px 11px 9px;color:#536d86;font-size:10.5px;line-height:1.4}
.v549-item-exp{font-size:11.5px;font-weight:900;color:#173b61;margin-bottom:3px}
.v549-item-meta{color:#6c8094;margin-top:3px}
.v549-item-message{margin-top:5px;color:#48647e}
.v549-item-actions{display:flex;justify-content:flex-end;gap:6px;padding:7px 10px 9px;border-top:1px solid #dce7f0;background:#f0f6fa}
.v549-item-actions .btn{font-size:10px!important;padding:6px 9px!important}
.v549-drawer-foot{flex:none;padding:10px 12px;background:#f5f9fc;border-top:1px solid #cddae6;display:flex;align-items:center;justify-content:space-between;gap:8px}
.v549-foot-note{font-size:9.5px;color:#6e8295;line-height:1.3}
#v549BellPill{
  position:fixed;right:18px;bottom:18px;z-index:12020;border:0;border-radius:999px;
  min-width:48px;height:48px;padding:0 12px;background:#174f80;color:#fff;box-shadow:0 10px 28px rgba(18,52,86,.25);
  display:flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;font-weight:900;
}
#v549BellPill .v549-pill-icon{font-size:18px}
#v549BellPill .v549-pill-count{font-size:12px;min-width:18px;height:18px;border-radius:999px;background:#e50025;color:#fff;display:inline-flex;align-items:center;justify-content:center;padding:0 4px}
#v549BellPill.zero .v549-pill-count{background:#6e8295}
#v549BellPill:hover{background:#123f68}
body.v549-drawer-open{overflow:hidden!important}
@media(max-width:700px){
  #v549AlertDrawer{width:min(94vw,430px)}
  #v549BellPill{right:10px;bottom:10px;height:44px;min-width:44px;padding:0 10px}
}
</style>
<div id="v549AlertBackdrop" aria-hidden="true"></div>
<aside id="v549AlertDrawer" role="dialog" aria-modal="true" aria-label="Bandeja de avisos" aria-hidden="true">
  <div class="v549-drawer-head">
    <div class="v549-head-row">
      <div class="v549-head-icon">🔔</div>
      <div class="v549-head-copy"><h3>Avisos</h3><p>Acciones pendientes y novedades de sus expedientes.</p></div>
      <span class="v549-total-badge" id="v549DrawerCount">0</span>
      <button class="v549-close-drawer" type="button" aria-label="Cerrar avisos" title="Cerrar">×</button>
    </div>
    <div class="v549-tabs" role="tablist" aria-label="Filtros de avisos">
      <button class="v549-filter active" data-filter="all" type="button">Todos <span id="v549AllCount">0</span></button>
      <button class="v549-filter" id="v550RequestFilter" data-filter="request" type="button" hidden>Solicitudes <span id="v550RequestCount">0</span></button>
      <button class="v549-filter" data-filter="task" type="button"><span id="v550TaskLabel">Pendientes</span> <span id="v549TaskCount">0</span></button>
      <button class="v549-filter" data-filter="notice" type="button"><span id="v550NoticeLabel">Novedades</span> <span id="v549NoticeCount">0</span></button>
    </div>
  </div>
  <div class="v549-drawer-body"><div id="v549AlertList"></div></div>
  <div class="v549-drawer-foot">
    <span class="v549-foot-note">Las acciones pendientes permanecen hasta ser atendidas.</span>
    <button class="btn secondary small" id="v549OpenFullCenter" type="button">Centro de alertas</button>
  </div>
</aside>
<button id="v549BellPill" class="zero" type="button" aria-label="Abrir avisos" title="Abrir avisos"><span class="v549-pill-icon">🔔</span><span class="v549-pill-count" id="v549PillCount">0</span></button>
<script id="v549-alert-drawer-script">
(function(){
  'use strict';
  let filter='all',busy=false,timer=null,drawerOpen=false,lastRole='';
  const up=v=>String(v??'').trim().toUpperCase();
  const html=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
  const jsEsc=v=>String(v??'').replace(/\\/g,'\\\\').replace(/'/g,"\\'").replace(/\r?\n/g,' ');
  const baseOpenCenterV549=window.openAlertsModal;

  function role(){try{return up(currentProfile?.rol||'');}catch(_){return '';}}
  function personalRole(){return ['USUARIO','COORDINADOR'].includes(role());}
  function operationalRole(){return ['ARCHIVO','ADMINISTRADOR'].includes(role());}

  function personalTaskAllowed(r){
    if(!r||r.kind!=='action')return false;
    const id=String(r.id||'').toLowerCase();
    const type=up(r.type||'');
    if(id.startsWith('reassign:')||id.startsWith('return:')||id.startsWith('cross:')||id.startsWith('loan:'))return true;
    return [
      'REASIGNACIÓN','REASIGNACION','DEVOLUCIÓN / RECEPCIÓN','DEVOLUCION / RECEPCION',
      'SOLICITUD ENTRE ÁREAS','SOLICITUD ENTRE AREAS','CONTROL DE PRÉSTAMOS','CONTROL DE PRESTAMOS',
      'PRÉSTAMO MAYOR 30 DÍAS','PRESTAMO MAYOR 30 DIAS'
    ].some(x=>type.includes(x));
  }
  function personalNoticeAllowed(r){
    if(!r)return false;
    const source=String(r.source||'').toLowerCase();
    const type=up(r.type||'');
    if(source.startsWith('v546-'))return true;
    if(['location','reassignment'].includes(source))return true;
    return ['COPIA DIGITAL','UBICACIÓN','UBICACION','REASIGNACIÓN','REASIGNACION','SOLICITUD','DEVOLUCIÓN','DEVOLUCION'].includes(type);
  }

  // Separación estricta de tareas por perfil.
  const baseTaskRowsV550=typeof v364TaskRows==='function'?v364TaskRows:null;
  if(baseTaskRowsV550){
    v364TaskRows=function(){
      const base=Array.isArray(baseTaskRowsV550())?baseTaskRowsV550():[];
      if(!personalRole())return base.filter(r=>r&&r.kind==='action');
      let legacy=[];
      try{legacy=typeof v361BuildLegacyTasks==='function'?(v361BuildLegacyTasks()||[]):[];}catch(_){legacy=[];}
      const map=new Map();
      [...legacy,...base].filter(personalTaskAllowed).forEach(r=>{
        const key=String(r.id||[r.type,r.expediente,r.date].join('|'));
        if(!map.has(key))map.set(key,r);
      });
      return [...map.values()].sort((a,b)=>{
        const ah=Number(!!a.high),bh=Number(!!b.high);if(ah!==bh)return bh-ah;
        return (new Date(b.date||0).getTime()||0)-(new Date(a.date||0).getTime()||0);
      });
    };
  }

  // Separación estricta de avisos personales. Archivo/Admin no hereda novedades personales V546.
  const baseNoticeRowsV550=typeof v364NoticeRows==='function'?v364NoticeRows:null;
  if(baseNoticeRowsV550){
    v364NoticeRows=function(){
      const rows=Array.isArray(baseNoticeRowsV550())?baseNoticeRowsV550():[];
      if(personalRole())return rows.filter(personalNoticeAllowed);
      return rows.filter(r=>!String(r?.source||'').toLowerCase().startsWith('v546-'));
    };
  }

  function operationalRequests(){
    if(!operationalRole())return [];
    let rows=[];
    try{rows=typeof v364BuildNewRequests==='function'?(v364BuildNewRequests()||[]):[];}catch(_){rows=[];}
    return rows.map(r=>({
      kind:'request',
      id:'incoming:'+String(r.id||r.solicitudId||''),
      title:`${r.numero||'Solicitud'} · nueva solicitud recibida`,
      type:'NUEVA SOLICITUD',
      solicitud:r.numero||'',
      person:r.solicitante||'',
      message:[`${Number(r.total||0)} expediente(s)`,r.modalidad||'',r.asunto||''].filter(Boolean).join(' · '),
      date:r.date||null,
      actionLabel:'Ver / gestionar',
      action:(r.id&&r.solicitudId)?`openV364NewRequest('${jsEsc(r.id)}','${jsEsc(r.solicitudId)}')`:(r.solicitudId?`openRequestDetail('${jsEsc(r.solicitudId)}')`:'')
    }));
  }

  function configureRoleUi(){
    const personal=personalRole();
    const op=operationalRole();
    const requestBtn=document.getElementById('v550RequestFilter');
    if(requestBtn)requestBtn.hidden=!op;
    const taskLabel=document.getElementById('v550TaskLabel');
    if(taskLabel)taskLabel.textContent=personal?'Acciones':'Tareas';
    const noticeLabel=document.getElementById('v550NoticeLabel');
    if(noticeLabel)noticeLabel.textContent=personal?'Novedades':'Avisos';
    const copy=document.querySelector('#v549AlertDrawer .v549-head-copy p');
    if(copy)copy.textContent=personal
      ?'Acciones y novedades relacionadas únicamente con sus expedientes.'
      :'Solicitudes recibidas y tareas operativas de Archivo.';
    const foot=document.querySelector('#v549AlertDrawer .v549-foot-note');
    if(foot)foot.textContent=personal
      ?'Sus acciones pendientes permanecen hasta ser atendidas.'
      :'Las solicitudes recibidas se mantienen separadas de las novedades personales de los usuarios.';
    if(personal&&filter==='request')filter='all';
    document.querySelectorAll('#v549AlertDrawer .v549-filter').forEach(btn=>btn.classList.toggle('active',(btn.dataset.filter||'all')===filter));
  }

  function currentRows(){
    let tasks=[],notices=[];
    try{tasks=typeof v364TaskRows==='function'?(v364TaskRows()||[]):[];}catch(_){}
    try{notices=typeof v364NoticeRows==='function'?(v364NoticeRows()||[]):[];}catch(_){}
    notices=notices.filter(x=>x&&x.unread);
    const requests=operationalRequests();
    return {requests,tasks,notices};
  }
  function dateText(v){
    if(!v)return '';
    try{
      const d=typeof fmtDate==='function'?fmtDate(v):'';
      const has=typeof masterValueHasExplicitTime==='function'?masterValueHasExplicitTime(v):true;
      const t=has&&typeof fmtTime==='function'?fmtTime(v):'';
      return [d,t].filter(Boolean).join(' · ');
    }catch(_){return '';}
  }
  function safeAction(code,label,secondary=false){
    if(!code)return '';
    const cls=secondary?'btn secondary small':'btn small';
    return `<button class="${cls}" type="button" onclick="${code};setTimeout(()=>window.v549RefreshAlerts?.(true),200)">${html(label||'Ver')}</button>`;
  }
  function item(row,kind){
    const notice=kind==='notice',request=kind==='request',digital=up(row?.type)==='COPIA DIGITAL';
    const cls=['v549-item'];if(notice)cls.push('notice');if(request)cls.push('request');if(digital)cls.push('digital');if(row?.high)cls.push('high');
    const title=row?.title||(request?'Nueva solicitud recibida':notice?'Novedad de expediente':'Acción pendiente');
    const badge=row?.type||(request?'SOLICITUD':notice?'NOVEDAD':'PENDIENTE');
    const meta=[];
    if(row?.solicitud)meta.push(`Solicitud: <b>${html(row.solicitud)}</b>`);
    if(row?.person)meta.push(`${request?'Solicitante':'Usuario'}: <b>${html(row.person)}</b>`);
    const dt=dateText(row?.date);if(dt)meta.push(html(dt));
    const actions=[];
    if(row?.secondaryAction)actions.push(safeAction(row.secondaryAction,row.secondaryLabel||'Marcar como leída',true));
    if(row?.action)actions.push(safeAction(row.action,row.actionLabel||'Gestionar',false));
    else if(row?.primaryAction)actions.push(safeAction(row.primaryAction,row.primaryLabel||'Ver',false));
    return `<article class="${cls.join(' ')}">
      <div class="v549-item-top"><div class="v549-item-title">${request?'📥':notice?'🔔':'✓'} ${html(title)}</div><span class="v549-item-badge">${html(badge)}</span></div>
      <div class="v549-item-body">
        ${row?.expediente?`<div class="v549-item-exp">Expediente ${html(row.expediente)}</div>`:''}
        ${meta.length?`<div class="v549-item-meta">${meta.join(' · ')}</div>`:''}
        ${row?.message?`<div class="v549-item-message">${html(row.message)}</div>`:''}
      </div>
      ${actions.length?`<div class="v549-item-actions">${actions.join('')}</div>`:''}
    </article>`;
  }
  function rowsForFilter(){
    const {requests,tasks,notices}=currentRows();
    const all=[
      ...requests.map(row=>({row,kind:'request'})),
      ...tasks.map(row=>({row,kind:'task'})),
      ...notices.map(row=>({row,kind:'notice'}))
    ].sort((a,b)=>{
      const ah=Number(!!a.row?.high),bh=Number(!!b.row?.high);if(ah!==bh)return bh-ah;
      return (new Date(b.row?.date||0).getTime()||0)-(new Date(a.row?.date||0).getTime()||0);
    });
    const visible=filter==='all'?all:all.filter(x=>x.kind===filter);
    return {requests,tasks,notices,visible};
  }
  function updateCounts(requests,tasks,notices){
    const total=requests.length+tasks.length; // V790: solo acciones; novedades se separan
    [
      ['v549DrawerCount',total],['v549AllCount',total+notices.length],['v550RequestCount',requests.length],
      ['v549TaskCount',tasks.length],['v549NoticeCount',notices.length],['v549PillCount',total]
    ].forEach(([id,n])=>{const el=document.getElementById(id);if(el)el.textContent=String(n);});
    document.getElementById('v549BellPill')?.classList.toggle('zero',total===0);
    try{const p=document.getElementById('produceAlerts');if(p)p.textContent=String(total);}catch(_){}
  }
  function render(){
    configureRoleUi();
    const host=document.getElementById('v549AlertList');if(!host)return;
    const {requests,tasks,notices,visible}=rowsForFilter();updateCounts(requests,tasks,notices);
    if(!visible.length){
      const empty=filter==='request'?'No hay nuevas solicitudes recibidas.':filter==='task'?(personalRole()?'No tiene acciones pendientes.':'No hay tareas operativas pendientes.'):filter==='notice'?(personalRole()?'No tiene novedades sin leer.':'No hay avisos operativos sin leer.'):(personalRole()?'No tiene avisos personales pendientes.':'No hay solicitudes ni tareas operativas pendientes.');
      host.innerHTML=`<div class="v549-empty">${empty}</div>`;
      return;
    }
    host.innerHTML=`<div class="v549-alert-list">${visible.map(x=>item(x.row,x.kind)).join('')}</div>`;
  }
  function setOpen(value){
    drawerOpen=!!value;
    const drawer=document.getElementById('v549AlertDrawer'),back=document.getElementById('v549AlertBackdrop');
    drawer?.classList.toggle('show',drawerOpen);back?.classList.toggle('show',drawerOpen);
    drawer?.setAttribute('aria-hidden',drawerOpen?'false':'true');back?.setAttribute('aria-hidden',drawerOpen?'false':'true');
    document.body.classList.toggle('v549-drawer-open',drawerOpen);
    if(drawerOpen){sync(true).catch(()=>{});setTimeout(()=>document.querySelector('#v549AlertDrawer .v549-close-drawer')?.focus(),60);}
  }
  window.v549OpenAlertDrawer=()=>setOpen(true);
  window.v549CloseAlertDrawer=()=>setOpen(false);
  window.v549OpenFullAlertCenter=async function(){
    setOpen(false);
    if(typeof baseOpenCenterV549==='function')await baseOpenCenterV549();
  };

  async function sync(force=false){
    if(busy)return;
    try{if(typeof session==='undefined'||!session)return;}catch(_){return;}
    busy=true;
    try{
      const nowRole=role();
      if(nowRole!==lastRole){lastRole=nowRole;filter='all';configureRoleUi();}
      const jobs=[];
      // V551 · Las fuentes de tareas se recargan siempre para que una acción
      // ya atendida desaparezca de la bandeja sin conservar datos en caché.
      if(typeof loadV170Tasks==='function')jobs.push(loadV170Tasks(true,true));
      if(typeof loadCrossAreaWaits==='function')jobs.push(loadCrossAreaWaits(true,true));
      if(personalRole()){
        if(typeof loadInternalReassignRequests==='function')jobs.push(loadInternalReassignRequests(!!force));
        if(typeof loadNotifications==='function')jobs.push(loadNotifications(!!force));
        if(typeof loadLocationAlerts==='function')jobs.push(loadLocationAlerts());
        if(typeof window.loadV546PersonalNotices==='function')jobs.push(window.loadV546PersonalNotices(!!force));
        if(typeof loadArchiveDeliveryRequests==='function')jobs.push(loadArchiveDeliveryRequests(!!force));
      }else if(operationalRole()){
        if(typeof window.loadV362RequestAlerts==='function')jobs.push(window.loadV362RequestAlerts({silent:true}));
        if(typeof loadOperationalAlerts==='function')jobs.push(loadOperationalAlerts(!!force));
        if(typeof loadArchiveDeliveryRequests==='function')jobs.push(loadArchiveDeliveryRequests(!!force));
        if(typeof loadInternalReassignRequests==='function')jobs.push(loadInternalReassignRequests(!!force));
        if(typeof loadLocationAlerts==='function')jobs.push(loadLocationAlerts());
      }
      await Promise.allSettled(jobs);
      try{if(typeof renderV364Alerts==='function')renderV364Alerts(true);}catch(_){}
      render();
    }finally{busy=false;}
  }
  window.v549RefreshAlerts=sync;

  function bind(){
    document.getElementById('v549BellPill')?.addEventListener('click',()=>setOpen(true));
    document.querySelector('#v549AlertDrawer .v549-close-drawer')?.addEventListener('click',()=>setOpen(false));
    document.getElementById('v549AlertBackdrop')?.addEventListener('click',()=>setOpen(false));
    document.getElementById('v549OpenFullCenter')?.addEventListener('click',()=>window.v549OpenFullAlertCenter());
    document.querySelectorAll('#v549AlertDrawer .v549-filter').forEach(btn=>btn.addEventListener('click',()=>{
      filter=btn.dataset.filter||'all';
      document.querySelectorAll('#v549AlertDrawer .v549-filter').forEach(x=>x.classList.toggle('active',x===btn));render();
    }));
    document.addEventListener('click',ev=>{
      const target=ev.target?.closest?.('.produce-bell,#alertsBtn,#userOnlyAlertsBtn');
      if(!target)return;
      ev.preventDefault();ev.stopImmediatePropagation();setOpen(true);
    },true);
    document.addEventListener('keydown',ev=>{if(ev.key==='Escape'&&drawerOpen){ev.preventDefault();setOpen(false);}});
  }
  function start(){
    configureRoleUi();bind();sync(true).catch(()=>{});clearInterval(timer);timer=null;
    // V602: la bandeja ya no hace polling periódico. Se actualiza al abrirse,
    // tras operaciones y cuando el gestor central detecta un cambio real.
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();
  document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'){try{render();}catch(_){}}});
})();
</script>


<style id="v550-role-separated-alerts-style">
/* V550 · separación visual entre flujo personal y flujo operativo */
#v549AlertDrawer .v549-item.request{border-left-color:#1f6fb2;background:#f5faff}
#v549AlertDrawer .v549-item.request .v549-item-badge{background:#dcecff;color:#175184;border-color:#bdd9f4}
#v549AlertDrawer .v549-filter[hidden]{display:none!important}
</style>

<style id="v551-live-alert-prune-style">
/* V551 · las acciones resueltas se retiran de forma natural al refrescar. */
#v549AlertDrawer .v549-foot-note{max-width:260px}
</style>
<script id="v551-live-alert-prune-script">
(function(){
  'use strict';
  let pruning=false;
  let lastProfile='';
  let delayedTimers=[];

  const up=v=>String(v??'').trim().toUpperCase();
  const role=()=>{try{return up(currentProfile?.rol||'');}catch(_){return '';}};
  const isOperational=()=>['ARCHIVO','ADMINISTRADOR'].includes(role());

  function profileKey(){
    try{return [session?.user?.id||'',currentProfile?.id||'',role()].join('|');}
    catch(_){return role();}
  }

  function requestOperationalState(row){
    return up(row?.estado_atencion||row?.estado||'');
  }

  // Una alerta de "nueva solicitud" solo sigue vigente mientras la solicitud
  // realmente continúe esperando su primera atención. Si fue atendida desde
  // cualquier otra pantalla, se marca como vista y se elimina de la bandeja.
  async function pruneResolvedIncomingRequests(){
    if(!isOperational() || typeof sb==='undefined' || !sb ||
       !Array.isArray(window.v362RequestAlertRows) || !window.v362RequestAlertRows.length){
      return false;
    }

    const rows=window.v362RequestAlertRows.slice();
    const ids=[...new Set(rows.map(r=>String(r?.solicitud_id||'').trim()).filter(Boolean))];
    if(!ids.length)return false;

    let data=[];
    try{
      const res=await sb.from('solicitudes_prestamo')
        .select('id,numero,estado,estado_atencion')
        .in('id',ids);
      if(res.error)throw res.error;
      data=Array.isArray(res.data)?res.data:[];
    }catch(error){
      console.warn('V551 · depuración de nuevas solicitudes:',error?.message||error);
      return false;
    }

    const byId=new Map(data.map(r=>[String(r.id||''),r]));
    const keep=[];
    const stale=[];
    const activeStates=new Set([
      '', 'PENDIENTE', 'PENDIENTE POR ATENDER',
      'REGISTRADO POR USUARIO','REGISTRADA POR USUARIO',
      'REGISTRADO POR ARCHIVO','REGISTRADA POR ARCHIVO'
    ]);

    rows.forEach(alertRow=>{
      const header=byId.get(String(alertRow?.solicitud_id||''));
      if(!header){keep.push(alertRow);return;}
      const state=requestOperationalState(header);
      if(activeStates.has(state))keep.push(alertRow);
      else stale.push(alertRow);
    });

    if(!stale.length)return false;

    // Registrar también en Supabase que la alerta ya no debe volver a llegar.
    if(typeof sb?.rpc==='function'){
      await Promise.allSettled(stale.map(r=>{
        const id=String(r?.alerta_id||'').trim();
        return id
          ?sb.rpc('marcar_alerta_nueva_solicitud_vista_v362',{p_alerta_id:id})
          :Promise.resolve();
      }));
    }

    window.v362RequestAlertRows=keep;
    try{if(typeof v362RenderRequestAlerts==='function')v362RenderRequestAlerts();}catch(_){}
    return true;
  }

  async function forceLiveSources(){
    const jobs=[];
    try{if(typeof loadV170Tasks==='function')jobs.push(loadV170Tasks(true,true));}catch(_){}
    try{if(typeof loadCrossAreaWaits==='function')jobs.push(loadCrossAreaWaits(true,true));}catch(_){}
    try{if(typeof loadInternalReassignRequests==='function')jobs.push(loadInternalReassignRequests(true));}catch(_){}
    try{if(typeof loadArchiveDeliveryRequests==='function')jobs.push(loadArchiveDeliveryRequests(true));}catch(_){}
    try{if(typeof loadOperationalAlerts==='function')jobs.push(loadOperationalAlerts(true));}catch(_){}
    try{if(typeof loadNotifications==='function')jobs.push(loadNotifications(true));}catch(_){}
    try{if(typeof loadLocationAlerts==='function')jobs.push(loadLocationAlerts());}catch(_){}
    try{if(isOperational()&&typeof window.loadV362RequestAlerts==='function')jobs.push(window.loadV362RequestAlerts({silent:true}));}catch(_){}
    try{if(!isOperational()&&typeof window.loadV546PersonalNotices==='function')jobs.push(window.loadV546PersonalNotices(true));}catch(_){}
    if(jobs.length)await Promise.allSettled(jobs);
  }

  const baseRefresh=window.v549RefreshAlerts;
  if(typeof baseRefresh==='function'){
    window.v549RefreshAlerts=async function(force=false){
      if(pruning)return await baseRefresh(force);
      if(!force && window.v601Protection && !window.v601Protection.canPoll('v551'))return false;
      pruning=true;
      try{
        // V601: baseRefresh ya actualiza las fuentes. Evitamos forceLiveSources +
        // un segundo baseRefresh, que triplicaban consultas en cada ciclo.
        await baseRefresh(force);
        const changed=false; // V790: la RPC V362 filtra pendientes reales; no ocultar expedientes ACEPTADOS aún sin entrega.
        if(changed){
          try{if(typeof renderV364Alerts==='function')renderV364Alerts(true);}catch(_){}
        }
        return changed;
      }finally{pruning=false;}
    };
  }

  function scheduleRefresh(){
    delayedTimers.forEach(clearTimeout);delayedTimers=[];
    [400,1800].forEach(ms=>{
      delayedTimers.push(setTimeout(()=>{
        Promise.resolve(window.v549RefreshAlerts?.(true)).catch(()=>{});
      },ms));
    });
  }
  window.v551RefreshResolvedAlerts=scheduleRefresh;

  // Cualquier acción operativa puede terminar una tarea desde un modal distinto
  // a la bandeja. Después del clic se reconsulta el estado real varias veces,
  // permitiendo que la operación asíncrona termine antes de depurarla.
  document.addEventListener('click',ev=>{
    const btn=ev.target?.closest?.('button');
    if(!btn)return;
    const txt=up(btn.textContent||btn.getAttribute('title')||'');
    if(!/(CONFIRMAR|ACEPTAR|RECHAZAR|CANCELAR|DEVOLVER|REASIGNAR|ENTREGAR|RECIBIR|GUARDAR|ATENDER|VINCULAR)/.test(txt))return;
    scheduleRefresh();
  },true);

  function adaptFoot(){
    const foot=document.querySelector('#v549AlertDrawer .v549-foot-note');
    if(foot)foot.textContent='Las acciones ya atendidas se retiran automáticamente. Las novedades informativas permanecen hasta ser leídas.';
  }

  // Si cambia usuario/perfil, no conservar la fotografía de pendientes del
  // perfil anterior.
  setInterval(()=>{
    const key=profileKey();
    if(key!==lastProfile){lastProfile=key;setTimeout(()=>window.v549RefreshAlerts?.(true),250);}
    adaptFoot();
  },120000);

  // V602: recuperar foco/visibilidad no vuelve a descargar todas las fuentes.
  window.addEventListener('focus',adaptFoot,{passive:true});
  document.addEventListener('visibilitychange',()=>{if(!document.hidden)adaptFoot();});

  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>{adaptFoot();setTimeout(()=>window.v549RefreshAlerts?.(true),700);},{once:true});
  else{adaptFoot();setTimeout(()=>window.v549RefreshAlerts?.(true),700);}
})();
</script>


<style id="v552-single-persistent-alert-bell-style">
/* ============================================================
   V552 · UNA SOLA CAMPANA DE AVISOS
   - Oculta exclusivamente la campana del encabezado PRODUCE.
   - Mantiene la campana flotante inferior como acceso global.
   ============================================================ */
.produce-topbar .produce-bell,
#produceTopbar .produce-bell,
.produce-bell{
  display:none!important;
}

/* La campana inferior pertenece al shell global, no a una vista concreta. */
#v549BellPill{
  display:flex!important;
  position:fixed!important;
  right:18px!important;
  bottom:18px!important;
  z-index:12020!important;
  visibility:visible!important;
  opacity:1!important;
}
@media(max-width:700px){
  #v549BellPill{right:10px!important;bottom:10px!important}
}
</style>
<script id="v552-single-persistent-alert-bell-script">
(function(){
  'use strict';
  function keepSingleBell(){
    // La superior queda anulada incluso si el encabezado se reconstruye.
    document.querySelectorAll('.produce-bell').forEach(el=>{
      el.style.setProperty('display','none','important');
      el.setAttribute('aria-hidden','true');
      el.tabIndex=-1;
    });
    // La inferior se conserva como acceso global al cambiar de módulo/vista.
    const pill=document.getElementById('v549BellPill');
    if(pill){
      pill.style.setProperty('display','flex','important');
      pill.style.setProperty('position','fixed','important');
      pill.removeAttribute('aria-hidden');
    }
  }

  const observer=new MutationObserver(()=>keepSingleBell());
  function start(){
    keepSingleBell();
    observer.observe(document.body,{childList:true,subtree:true});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});
  else start();

  // Refuerzo después de cambios de pestaña/módulo del sistema.
  document.addEventListener('click',()=>setTimeout(keepSingleBell,0),true);
  window.addEventListener('focus',keepSingleBell,{passive:true});
})();
</script>


<style id="v554-global-alert-bell-style">
/* ============================================================
   V554 · CAMPANA GLOBAL PERSISTENTE ENTRE PANTALLAS
   - Una sola campana inferior.
   - Se mantiene visible al navegar por cualquier módulo.
   - La bandeja se cierra al cambiar de pantalla para no superponer contenido.
   ============================================================ */
.produce-bell{display:none!important}
#v549BellPill{
  display:flex!important;
  position:fixed!important;
  right:18px!important;
  bottom:18px!important;
  z-index:2147483000!important;
  visibility:visible!important;
  opacity:1!important;
  pointer-events:auto!important;
}
#v549AlertBackdrop{z-index:2147483001!important}
#v549AlertDrawer{z-index:2147483002!important}
@media(max-width:700px){
  #v549BellPill{right:10px!important;bottom:10px!important}
}
</style>
<script id="v554-global-alert-bell-script">
(function(){
  'use strict';
  let observer=null;
  let navTimer=null;
  let lastView='';

  function hideTopBell(){
    document.querySelectorAll('.produce-bell').forEach(el=>{
      el.style.setProperty('display','none','important');
      el.setAttribute('aria-hidden','true');
      el.tabIndex=-1;
    });
  }

  function moveGlobalAlertUiToBody(){
    const back=document.getElementById('v549AlertBackdrop');
    const drawer=document.getElementById('v549AlertDrawer');
    const pill=document.getElementById('v549BellPill');

    // Dejarlos directamente bajo BODY evita que desaparezcan cuando una vista
    // sustituye el contenido de su contenedor principal.
    [back,drawer,pill].forEach(el=>{
      if(el && el.parentElement!==document.body){
        try{document.body.appendChild(el);}catch(_){}
      }
    });

    if(pill){
      pill.style.setProperty('display','flex','important');
      pill.style.setProperty('position','fixed','important');
      pill.style.setProperty('visibility','visible','important');
      pill.style.setProperty('opacity','1','important');
      pill.removeAttribute('aria-hidden');
    }
  }

  function currentViewSignature(){
    try{
      const selected=[...document.querySelectorAll('.sidebar .active, aside .active, nav .active')]
        .map(x=>(x.textContent||'').trim()).filter(Boolean).join('|');
      const role=String(window.currentProfile?.rol||'');
      return role+'|'+selected+'|'+String(location.hash||'');
    }catch(_){return String(location.hash||'');}
  }

  function closeDrawerForNavigation(){
    try{
      if(typeof window.v549CloseAlertDrawer==='function')window.v549CloseAlertDrawer();
      else{
        document.getElementById('v549AlertDrawer')?.classList.remove('show');
        document.getElementById('v549AlertBackdrop')?.classList.remove('show');
        document.body.classList.remove('v549-drawer-open');
      }
    }catch(_){}
  }

  function reinforce(){
    hideTopBell();
    moveGlobalAlertUiToBody();
  }

  function afterNavigation(){
    closeDrawerForNavigation();
    reinforce();
    setTimeout(reinforce,60);
    setTimeout(reinforce,250);
    setTimeout(()=>{
      // V602: cambiar de módulo no descarga de nuevo todas las alertas.
      reinforce();
    },650);
  }

  function bindNavigationWatcher(){
    document.addEventListener('click',ev=>{
      // No tratar como navegación los controles propios de la bandeja.
      if(ev.target?.closest?.('#v549AlertDrawer,#v549BellPill,#v549AlertBackdrop'))return;
      const nav=ev.target?.closest?.(
        '.sidebar a,.sidebar button,aside a,aside button,nav a,nav button,[data-tab],[data-view],[data-section]'
      );
      if(!nav)return;
      clearTimeout(navTimer);
      navTimer=setTimeout(afterNavigation,40);
    },true);

    // Algunos módulos cambian por funciones JS sin un enlace tradicional.
    setInterval(()=>{
      const sig=currentViewSignature();
      if(!lastView){lastView=sig;reinforce();return;}
      if(sig!==lastView){
        lastView=sig;
        afterNavigation();
      }else{
        reinforce();
      }
    },750);
  }

  function start(){
    reinforce();
    bindNavigationWatcher();

    observer=new MutationObserver(()=>reinforce());
    observer.observe(document.body,{childList:true,subtree:true});

    window.addEventListener('focus',()=>{
      reinforce();
      // V603: el gestor central ya realiza la comprobación ligera.
      // Recuperar foco no vuelve a descargar todas las fuentes de alertas.
    },{passive:true});

    document.addEventListener('visibilitychange',()=>{
      if(!document.hidden){
        reinforce();
      }
    });
  }

  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});
  else start();
})();
</script>



<style id="v555-background-native-alerts-style">
/* V555 · refuerzo de avisos nativos cuando la ventana no está visible */
#desktopNotifyBtnV467.v555-background-ready{box-shadow:0 0 0 2px rgba(27,111,177,.12)}
</style>
<script id="v555-background-native-alerts-script">
(function(){
  'use strict';

  const CHECK_MS=120000;
  const REMIND_MS=5*60*1000;
  const MAX_PER_ROUND=3;
  const live=new Map();
  const retryAt=new Map();
  let busy=false;
  let timer=null;
  let lastProfile='';

  const up=v=>String(v??'').trim().toUpperCase();
  const clean=v=>String(v??'').trim();

  function role(){try{return up(currentProfile?.rol||'');}catch(_){return '';}}
  function operational(){return ['ARCHIVO','ADMINISTRADOR'].includes(role());}
  function personal(){return ['USUARIO','COORDINADOR'].includes(role());}
  function profileKey(){
    try{return String(session?.user?.id||'anon')+'|'+String(currentProfile?.id||currentProfile?.nombre||'')+'|'+role();}
    catch(_){return role()||'anon';}
  }
  function background(){
    try{return document.hidden || !document.hasFocus();}
    catch(_){return document.hidden;}
  }
  function supported(){return 'Notification' in window;}
  function enabled(){
    if(!supported() || Notification.permission!=='granted')return false;
    try{
      if(typeof v467IsEnabled==='function')return !!v467IsEnabled();
    }catch(_){ }
    return true;
  }
  function dateMs(v){const n=new Date(v||0).getTime();return Number.isFinite(n)?n:0;}

  function requestRows(){
    if(!operational())return [];
    try{return typeof v364BuildNewRequests==='function'?(v364BuildNewRequests()||[]):[];}
    catch(_){return [];}
  }
  function taskRows(){
    let rows=[];
    try{rows=typeof v364TaskRows==='function'?(v364TaskRows()||[]):[];}catch(_){rows=[];}
    return rows.filter(r=>{
      if(!r)return false;
      // V483 ya administra de manera persistente las reasignaciones nativas.
      const type=up(r.type||'');
      const id=String(r.id||'').toLowerCase();
      if(type.includes('REASIGN') || id.startsWith('reassign:'))return false;
      return true;
    });
  }
  function noticeRows(){
    let rows=[];
    try{rows=typeof v364NoticeRows==='function'?(v364NoticeRows()||[]):[];}catch(_){rows=[];}
    return rows.filter(r=>{
      if(!r || !r.unread)return false;
      const source=String(r.source||'').toLowerCase();
      // V546 ya genera el aviso nativo de las novedades personales.
      if(personal() && source.startsWith('v546-'))return false;
      // Avisos de reasignación ya están cubiertos por V483.
      const type=up(r.type||'');
      if(type.includes('REASIGN'))return false;
      return true;
    });
  }

  function normalize(){
    const out=[];
    requestRows().forEach(r=>out.push({
      kind:'request',
      key:'request:'+(r.id||r.solicitudId||r.numero||''),
      date:r.date||null,
      title:'📥 Nueva solicitud recibida',
      body:[
        r.numero?`Solicitud: ${r.numero}`:'',
        r.solicitante?`Solicitante: ${r.solicitante}`:'',
        Number(r.total||0)?`${Number(r.total)} expediente(s)`:'',
        r.modalidad?`Modalidad: ${r.modalidad}`:''
      ].filter(Boolean).join('\n'),
      sticky:true
    }));

    taskRows().forEach(r=>out.push({
      kind:'task',
      key:'task:'+String(r.id||[r.type,r.expediente,r.solicitud,r.date].join('|')),
      date:r.date||null,
      title:'⏳ '+clean(r.title||r.type||'Acción pendiente'),
      body:[
        r.expediente?`Expediente: ${r.expediente}`:'',
        r.solicitud?`Solicitud: ${r.solicitud}`:'',
        r.person?`Usuario: ${r.person}`:'',
        r.message||''
      ].filter(Boolean).join('\n'),
      sticky:true
    }));

    noticeRows().forEach(r=>out.push({
      kind:'notice',
      key:'notice:'+String(r.id||[r.type,r.expediente,r.solicitud,r.date].join('|')),
      date:r.date||null,
      title:'🔔 '+clean(r.title||r.type||'Novedad de expediente'),
      body:[
        r.expediente?`Expediente: ${r.expediente}`:'',
        r.solicitud?`Solicitud: ${r.solicitud}`:'',
        r.message||''
      ].filter(Boolean).join('\n'),
      sticky:false
    }));

    const map=new Map();
    out.forEach(x=>{if(x.key&&!map.has(x.key))map.set(x.key,x);});
    return [...map.values()].sort((a,b)=>dateMs(b.date)-dateMs(a.date));
  }

  function notificationTag(item){
    return ('v555-'+profileKey()+'-'+item.key).replace(/[^a-zA-Z0-9:_|.-]/g,'_').slice(0,220);
  }

  function closeResolved(currentKeys){
    [...live.keys()].forEach(key=>{
      if(currentKeys.has(key))return;
      const n=live.get(key);
      try{n.__v555Resolved=true;n.close();}catch(_){ }
      live.delete(key);
      retryAt.delete(key);
    });
    [...retryAt.keys()].forEach(key=>{if(!currentKeys.has(key))retryAt.delete(key);});
  }

  function openSystemOnClick(n){
    n.onclick=()=>{
      try{window.focus();}catch(_){ }
      setTimeout(()=>{
        try{window.v549OpenAlertDrawer?.();}catch(_){ }
        try{window.v549RefreshAlerts?.(true);}catch(_){ }
      },120);
      try{n.close();}catch(_){ }
    };
  }

  function show(item){
    if(!enabled() || !background())return false;
    if(live.has(item.key))return false;
    const retry=retryAt.get(item.key)||0;
    if(retry>Date.now())return false;

    try{
      const options={
        body:item.body||'Tiene una acción pendiente en el Sistema de Control y Trazabilidad de Expedientes.',
        tag:notificationTag(item),
        renotify:true,
        requireInteraction:!!item.sticky,
        silent:false
      };
      const n=new Notification(item.title||'Sistema de Control y Trazabilidad de Expedientes',options);
      n.__v555Resolved=false;
      openSystemOnClick(n);
      n.onclose=()=>{
        live.delete(item.key);
        if(!n.__v555Resolved){
          retryAt.set(item.key,Date.now()+(item.kind==='notice'?15*60*1000:REMIND_MS));
        }
      };
      live.set(item.key,n);
      retryAt.delete(item.key);
      return true;
    }catch(error){
      console.warn('V555 · notificación nativa:',error?.message||error);
      return false;
    }
  }

  function showSummary(extra){
    if(!extra || !enabled() || !background())return;
    const key='summary:'+profileKey();
    if(live.has(key))return;
    try{
      const n=new Notification('🔔 Avisos pendientes',{
        body:`Tiene ${extra} aviso(s) adicional(es) pendiente(s). Abra la bandeja del sistema para revisarlos.`,
        tag:'v555-summary-'+profileKey().replace(/[^a-zA-Z0-9_.-]/g,'_'),
        renotify:true,
        requireInteraction:false,
        silent:false
      });
      n.__v555Resolved=false;
      openSystemOnClick(n);
      n.onclose=()=>{live.delete(key);};
      live.set(key,n);
    }catch(_){ }
  }

  async function refreshSources(){
    try{if(typeof window.v549RefreshAlerts==='function')await window.v549RefreshAlerts(true);}catch(_){ }
    // Refuerzos específicos si la bandeja global aún no se inicializó.
    const jobs=[];
    try{if(operational()&&typeof window.loadV362RequestAlerts==='function')jobs.push(window.loadV362RequestAlerts({silent:true}));}catch(_){ }
    try{if(typeof loadOperationalAlerts==='function')jobs.push(loadOperationalAlerts(true));}catch(_){ }
    try{if(typeof loadArchiveDeliveryRequests==='function')jobs.push(loadArchiveDeliveryRequests(true));}catch(_){ }
    try{if(typeof loadCrossAreaWaits==='function')jobs.push(loadCrossAreaWaits(true,true));}catch(_){ }
    if(jobs.length)await Promise.allSettled(jobs);
  }

  async function scan(force=false){
    if(busy || !background() || !enabled() || navigator.onLine===false)return;
    busy=true;
    try{
      const pk=profileKey();
      if(pk!==lastProfile){
        lastProfile=pk;
        // Al cambiar de perfil cerrar avisos del perfil anterior.
        [...live.values()].forEach(n=>{try{n.__v555Resolved=true;n.close();}catch(_){ }});
        live.clear();retryAt.clear();
      }
      await refreshSources();
      const rows=normalize();
      const keys=new Set(rows.map(x=>x.key));
      closeResolved(keys);

      let shown=0;
      for(const item of rows){
        if(shown>=MAX_PER_ROUND)break;
        if(show(item))shown++;
      }
      const waiting=Math.max(0,rows.length-shown-live.size);
      if(shown>=MAX_PER_ROUND && rows.length>MAX_PER_ROUND)showSummary(rows.length-MAX_PER_ROUND);
    }finally{busy=false;}
  }
  window.v555CheckBackgroundAlerts=scan;

  function reflectButton(){
    const btn=document.getElementById('desktopNotifyBtnV467');
    if(!btn)return;
    btn.classList.toggle('v555-background-ready',enabled());
    if(enabled())btn.title='Avisos de Windows activos. También se muestran cuando el navegador está minimizado o en segundo plano.';
  }

  let lastLightSignature='';
  async function lightBackgroundCheck(force=false){
    if(busy || !background() || !enabled() || navigator.onLine===false)return;
    if(window.v601Protection && !window.v601Protection.canPoll('v555-light'))return;
    let before='';
    try{before=JSON.stringify({t:v170TaskTotal,u:v170TaskUnread,b:v170TaskCountsByType||{}});}catch(_){ }
    try{if(typeof loadV170TaskCounters==='function')await loadV170TaskCounters(true);}catch(_){return;}
    let after='';
    try{after=JSON.stringify({t:v170TaskTotal,u:v170TaskUnread,b:v170TaskCountsByType||{}});}catch(_){ }
    if(!lastLightSignature){lastLightSignature=after||before;return;}
    if(force || (after && after!==lastLightSignature)){
      lastLightSignature=after;
      // Solo ante cambio real se cargan los detalles necesarios para Windows.
      await scan(true);
    }
  }

  function start(){
    reflectButton();
    clearInterval(timer);
    timer=setInterval(()=>{
      reflectButton();
      if(document.hidden)lightBackgroundCheck(false).catch(()=>{});
    },CHECK_MS);

    document.addEventListener('visibilitychange',()=>{
      reflectButton();
      if(document.hidden)setTimeout(()=>lightBackgroundCheck(false).catch(()=>{}),250);
    });
    window.addEventListener('blur',()=>setTimeout(()=>{if(!document.hasFocus())lightBackgroundCheck(false).catch(()=>{});},500),{passive:true});
    window.addEventListener('online',()=>{if(background())lightBackgroundCheck(false).catch(()=>{});},{passive:true});
    window.addEventListener('focus',reflectButton,{passive:true});
  }

  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});
  else start();
})();
</script>



<style id="v556-compact-live-alerts-style">
/* ============================================================
   V556 · AVISOS COMPACTOS + APARICIÓN INMEDIATA
   ============================================================ */
#v549AlertDrawer{
  width:min(395px,92vw)!important;
}
#v549AlertDrawer .v549-drawer-head{padding:12px 12px 9px!important}
#v549AlertDrawer .v549-head-icon{width:32px!important;height:32px!important;border-radius:10px!important;font-size:17px!important}
#v549AlertDrawer .v549-head-copy h3{font-size:16px!important}
#v549AlertDrawer .v549-head-copy p{font-size:9.5px!important;line-height:1.2!important}
#v549AlertDrawer .v549-total-badge{height:24px!important;min-width:26px!important;font-size:11px!important}
#v549AlertDrawer .v549-close-drawer{width:30px!important;height:30px!important}
#v549AlertDrawer .v549-tabs{margin-top:8px!important;gap:5px!important}
#v549AlertDrawer .v549-filter{padding:5px 8px!important;font-size:9.5px!important}
#v549AlertDrawer .v549-drawer-body{padding:8px!important}
#v549AlertDrawer .v549-alert-list{gap:6px!important}
#v549AlertDrawer .v549-item{
  border-radius:9px!important;
  box-shadow:0 1px 3px rgba(17,58,93,.05)!important;
}
#v549AlertDrawer .v549-item-top{padding:7px 8px 3px!important;gap:6px!important}
#v549AlertDrawer .v549-item-title{font-size:11px!important;line-height:1.18!important}
#v549AlertDrawer .v549-item-badge{font-size:7.5px!important;padding:2px 6px!important}
#v549AlertDrawer .v549-item-body{padding:1px 8px 6px!important;font-size:9.5px!important;line-height:1.3!important}
#v549AlertDrawer .v549-item-exp{font-size:10.5px!important;margin-bottom:2px!important}
#v549AlertDrawer .v549-item-meta{margin-top:1px!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
#v549AlertDrawer .v549-item-message{
  margin-top:3px!important;
  display:-webkit-box!important;
  -webkit-box-orient:vertical!important;
  -webkit-line-clamp:2!important;
  overflow:hidden!important;
}
#v549AlertDrawer .v549-item-actions{padding:5px 7px 6px!important;gap:5px!important}
#v549AlertDrawer .v549-item-actions .btn{font-size:9px!important;padding:5px 8px!important;min-height:26px!important}
#v549AlertDrawer .v549-drawer-foot{padding:7px 9px!important}
#v549AlertDrawer .v549-foot-note{font-size:8.5px!important}

/* Si el título ya contiene el expediente, no repetir la línea Expediente ... */
#v549AlertDrawer .v549-item.v556-no-duplicate-exp .v549-item-exp{display:none!important}

/* Resaltado breve cuando acaba de llegar un aviso. */
@keyframes v556FlashNewAlert{
  0%{box-shadow:0 0 0 0 rgba(31,111,178,.38);transform:translateY(-1px)}
  55%{box-shadow:0 0 0 5px rgba(31,111,178,.08)}
  100%{box-shadow:0 1px 3px rgba(17,58,93,.05);transform:none}
}
#v549AlertDrawer .v549-item.v556-new-arrival{animation:v556FlashNewAlert 1.15s ease}

/* Vista previa única: nunca se apilan avisos flotantes. */
#v556LivePreview{
  position:fixed!important;
  right:18px!important;
  bottom:76px!important;
  z-index:2147483004!important;
  width:min(330px,calc(100vw - 28px));
  padding:9px 10px;
  border:1px solid #bad2e6;
  border-left:4px solid #1f6fb2;
  border-radius:11px;
  background:#f7fbff;
  color:#173b61;
  box-shadow:0 12px 30px rgba(15,50,82,.22);
  opacity:0;
  visibility:hidden;
  transform:translateY(8px) scale(.98);
  transition:opacity .16s ease,transform .16s ease,visibility .16s ease;
  cursor:pointer;
}
#v556LivePreview.show{opacity:1;visibility:visible;transform:none}
#v556LivePreview .v556-preview-top{display:flex;align-items:center;gap:7px}
#v556LivePreview .v556-preview-icon{font-size:15px}
#v556LivePreview .v556-preview-title{font-size:10.5px;font-weight:900;line-height:1.2;min-width:0;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#v556LivePreview .v556-preview-count{font-size:8px;font-weight:900;background:#174f80;color:#fff;border-radius:999px;padding:2px 6px}
#v556LivePreview .v556-preview-text{font-size:9px;color:#5a7187;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#v556LivePreview .v556-preview-close{border:0;background:transparent;color:#6e8295;font-size:15px;line-height:1;padding:0 1px;cursor:pointer}

@media(max-width:700px){
  #v549AlertDrawer{width:min(365px,94vw)!important}
  #v556LivePreview{right:10px!important;bottom:64px!important;width:min(315px,calc(100vw - 20px))}
}
</style>
<div id="v556LivePreview" role="status" aria-live="polite" aria-atomic="true">
  <div class="v556-preview-top">
    <span class="v556-preview-icon">🔔</span>
    <span class="v556-preview-title">Nuevo aviso</span>
    <span class="v556-preview-count">1 nuevo</span>
    <button class="v556-preview-close" type="button" aria-label="Cerrar vista previa">×</button>
  </div>
  <div class="v556-preview-text">Tiene una nueva acción pendiente.</div>
</div>
<script id="v556-compact-live-alerts-script">
(function(){
  'use strict';
  const CHANNEL='produce-alertas-live-v556';
  const STORAGE_SIGNAL='produce_alertas_live_v556_signal';
  let bc=null;
  let previewTimer=null;
  let lastTotal=null;
  let lastTopSignature='';
  let refreshTimer=null;
  let wrapping=false;

  const clean=v=>String(v??'').trim();
  const up=v=>clean(v).toUpperCase();

  function totalCount(){
    const n=Number(document.getElementById('v549PillCount')?.textContent||0);
    return Number.isFinite(n)?n:0;
  }
  function drawerIsOpen(){
    return !!document.getElementById('v549AlertDrawer')?.classList.contains('show');
  }
  function topCardInfo(){
    const card=document.querySelector('#v549AlertList .v549-item');
    if(!card)return {card:null,title:'Nuevo aviso',text:'Tiene una nueva acción pendiente.',signature:''};
    const title=clean(card.querySelector('.v549-item-title')?.textContent)||'Nuevo aviso';
    const exp=clean(card.querySelector('.v549-item-exp')?.textContent);
    const meta=clean(card.querySelector('.v549-item-meta')?.textContent);
    const msg=clean(card.querySelector('.v549-item-message')?.textContent);
    return {card,title,text:[exp,meta,msg].filter(Boolean).join(' · '),signature:[title,exp,meta,msg].join('|')};
  }
  function compactCards(){
    document.querySelectorAll('#v549AlertList .v549-item').forEach(card=>{
      const title=up(card.querySelector('.v549-item-title')?.textContent);
      const expEl=card.querySelector('.v549-item-exp');
      const exp=up(expEl?.textContent?.replace(/^EXPEDIENTE\s+/i,''));
      card.classList.toggle('v556-no-duplicate-exp',!!exp&&title.includes(exp));
    });
  }
  function hidePreview(){
    const p=document.getElementById('v556LivePreview');
    if(p)p.classList.remove('show');
    clearTimeout(previewTimer);previewTimer=null;
  }
  function showPreview(increase){
    const p=document.getElementById('v556LivePreview');if(!p)return;
    const info=topCardInfo();
    p.querySelector('.v556-preview-title').textContent=info.title;
    p.querySelector('.v556-preview-text').textContent=info.text||'Tiene una nueva acción pendiente.';
    p.querySelector('.v556-preview-count').textContent=(increase>1?increase+' nuevos':'1 nuevo');
    p.classList.add('show');
    clearTimeout(previewTimer);
    previewTimer=setTimeout(hidePreview,6500);
  }
  function markTopNew(){
    const info=topCardInfo();
    if(!info.card)return;
    info.card.classList.remove('v556-new-arrival');
    void info.card.offsetWidth;
    info.card.classList.add('v556-new-arrival');
    setTimeout(()=>info.card?.classList.remove('v556-new-arrival'),1400);
  }
  function afterRender(source){
    compactCards();
    const now=totalCount();
    const info=topCardInfo();
    if(lastTotal===null){lastTotal=now;lastTopSignature=info.signature;return;}
    const increase=Math.max(0,now-lastTotal);
    const topChanged=!!info.signature&&info.signature!==lastTopSignature;
    if(increase>0 || (source==='signal'&&topChanged)){
      if(drawerIsOpen()){
        markTopNew();
        try{document.querySelector('#v549AlertDrawer .v549-drawer-body')?.scrollTo({top:0,behavior:'smooth'});}catch(_){ }
      }else{
        showPreview(Math.max(1,increase));
      }
    }
    lastTotal=now;
    lastTopSignature=info.signature;
  }
  async function refresh(source='poll'){
    if(refresh.__busy)return;
    if((source==='poll'||source==='background') && window.v601Protection && !window.v601Protection.canPoll('v556'))return;
    refresh.__busy=true;
    try{
      // V601: visible = bandeja; segundo plano = avisos nativos. Nunca ambas rutas a la vez.
      if(document.hidden){
        if(typeof window.v555CheckBackgroundAlerts==='function')await window.v555CheckBackgroundAlerts(true);
      }else{
        if(typeof window.v549RefreshAlerts==='function')await window.v549RefreshAlerts(true);
      }
    }catch(_){
    }finally{
      refresh.__busy=false;
      setTimeout(()=>afterRender(source),60);
    }
  }
  refresh.__busy=false;

  function signal(reason){
    const payload={reason:reason||'update',at:Date.now(),sender:clean(window.currentProfile?.nombre_personal||window.currentProfile?.rol||'')};
    try{bc?.postMessage(payload);}catch(_){ }
    try{localStorage.setItem(STORAGE_SIGNAL,JSON.stringify(payload));}catch(_){ }
    setTimeout(()=>refresh('signal'),120);
    setTimeout(()=>refresh('signal'),1200);
  }
  window.v556SignalNewAlert=signal;

  function setupChannel(){
    try{
      if('BroadcastChannel' in window){
        bc=new BroadcastChannel(CHANNEL);
        bc.onmessage=()=>{ refresh('signal'); };
      }
    }catch(_){bc=null;}
    window.addEventListener('storage',ev=>{
      if(ev.key===STORAGE_SIGNAL&&ev.newValue){refresh('signal');}
    });
  }

  function wrapSendFunction(name){
    const original=window[name];
    if(typeof original!=='function'||original.__v556Wrapped)return;
    const wrapped=async function(){
      const before=Date.now();
      try{return await original.apply(this,arguments);}
      finally{
        // La señal no crea una alerta; solo obliga a los otros perfiles a consultar
        // inmediatamente. Si la operación falló, la consulta no encontrará nada nuevo.
        if(Date.now()>=before)signal(name);
      }
    };
    wrapped.__v556Wrapped=true;
    wrapped.__v556Original=original;
    window[name]=wrapped;
  }

  function wrapKnownSenders(){
    if(wrapping)return;wrapping=true;
    try{
      [
        'saveNewRequest',
        'requestInternalReassignBulkSelected',
        'confirmInternalReassignRequest',
        'confirmInternalReassignment',
        'acceptInternalReassignRequest',
        'requestReturnSelected',
        'confirmArchiveReturn'
      ].forEach(wrapSendFunction);
    }finally{wrapping=false;}
  }

  function setupDomObserver(){
    const host=document.getElementById('v549AlertList');
    if(!host)return;
    const obs=new MutationObserver(()=>{
      compactCards();
      setTimeout(()=>afterRender('dom'),20);
    });
    obs.observe(host,{childList:true,subtree:true,characterData:true});
  }

  function setupPreview(){
    const p=document.getElementById('v556LivePreview');
    p?.addEventListener('click',ev=>{
      if(ev.target?.closest?.('.v556-preview-close')){ev.stopPropagation();hidePreview();return;}
      hidePreview();
      try{window.v549OpenAlertDrawer?.();}catch(_){ }
    });
  }

  function startFastSync(){
    clearInterval(refreshTimer);
    refreshTimer=null;
    // V602: sin polling de detalles. BroadcastChannel/storage y los wrappers de
    // operaciones conservan la reacción inmediata; V170 realiza el pulso ligero.
    wrapKnownSenders();
  }

  function start(){
    setupChannel();
    setupPreview();
    wrapKnownSenders();
    setupDomObserver();
    compactCards();
    lastTotal=totalCount();
    lastTopSignature=topCardInfo().signature;
    startFastSync();
    setTimeout(()=>refresh('startup'),500);
  }

  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});
  else start();

  window.addEventListener('focus',()=>setTimeout(()=>afterRender('focus'),80),{passive:true});
  document.addEventListener('visibilitychange',()=>{if(!document.hidden)setTimeout(()=>afterRender('focus'),80);});
})();
</script>



<style id="v557-bell-visible-with-drawer-style">
/* ============================================================
   V557 · CAMPANA SIEMPRE VISIBLE
   Cuando la bandeja está abierta, la campana se desplaza al borde
   izquierdo del panel en lugar de quedar oculta debajo de él.
   ============================================================ */
#v549BellPill{
  z-index:2147483005!important;
  transition:right .22s ease,left .22s ease,transform .18s ease,background .18s ease!important;
}
body.v549-drawer-open #v549BellPill{
  right:min(448px,calc(94vw + 12px))!important;
  bottom:18px!important;
  background:#123f68!important;
  box-shadow:0 10px 28px rgba(18,52,86,.34)!important;
}
body.v549-drawer-open #v549BellPill:hover{transform:scale(1.04)}
body.v549-drawer-open #v549BellPill::before{
  content:'Cerrar avisos';
  position:absolute;
  right:calc(100% + 8px);
  top:50%;
  transform:translateY(-50%);
  padding:5px 8px;
  border-radius:7px;
  background:#173b61;
  color:#fff;
  font-size:9px;
  font-weight:800;
  white-space:nowrap;
  opacity:0;
  pointer-events:none;
  transition:opacity .15s ease;
}
body.v549-drawer-open #v549BellPill:hover::before{opacity:1}
@media(max-width:700px){
  body.v549-drawer-open #v549BellPill{
    right:auto!important;
    left:10px!important;
    bottom:10px!important;
  }
  body:not(.v549-drawer-open) #v549BellPill{left:auto!important}
  body.v549-drawer-open #v549BellPill::before{display:none!important}
}
</style>
<script id="v557-bell-visible-with-drawer-script">
(function(){
  'use strict';

  function isOpen(){
    return document.body.classList.contains('v549-drawer-open') ||
      document.getElementById('v549AlertDrawer')?.classList.contains('show');
  }

  function syncBell(){
    const pill=document.getElementById('v549BellPill');
    if(!pill)return;
    const open=isOpen();
    pill.style.setProperty('display','flex','important');
    pill.style.setProperty('visibility','visible','important');
    pill.style.setProperty('opacity','1','important');
    pill.setAttribute('aria-label',open?'Cerrar avisos':'Abrir avisos');
    pill.setAttribute('title',open?'Cerrar avisos':'Abrir avisos');
    pill.dataset.v557Open=open?'1':'0';
  }

  // Captura antes del listener antiguo de V549. Así la misma campana
  // funciona como abrir/cerrar sin que V549 vuelva a abrirla inmediatamente.
  document.addEventListener('click',function(ev){
    const pill=ev.target?.closest?.('#v549BellPill');
    if(!pill)return;
    ev.preventDefault();
    ev.stopImmediatePropagation();
    if(isOpen()){
      try{window.v549CloseAlertDrawer?.();}catch(_){ }
    }else{
      try{window.v549OpenAlertDrawer?.();}catch(_){ }
    }
    setTimeout(syncBell,0);
    setTimeout(syncBell,80);
  },true);

  const observer=new MutationObserver(syncBell);
  function start(){
    syncBell();
    observer.observe(document.body,{attributes:true,attributeFilter:['class'],childList:true,subtree:true});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});
  else start();

  window.addEventListener('focus',syncBell,{passive:true});
})();
</script>



<style id="v558-external-notification-style">
#v558ExternalNotifyTestBtn.v558-ok{border-color:#78b899!important;background:#eef9f3!important;color:#17663f!important}
#v558ExternalNotifyTestBtn.v558-error{border-color:#e7a0a0!important;background:#fff3f3!important;color:#9d2323!important}
</style>
<script id="v558-external-notification-script">
(function(){
  'use strict';
  const FN='procesar-notificaciones-externas';
  let busy=false,lastRun=0;
  const up=v=>String(v??'').trim().toUpperCase();

  function hasSession(){
    try{return !!(sb && session?.user?.id);}catch(_){return false;}
  }
  async function invokeAuthenticated(body){
    if(!sb)throw new Error('Supabase no está conectado');
    let token='';
    try{token=String(session?.access_token||'').trim();}catch(_){ }
    if(!token){
      const {data,error}=await sb.auth.getSession();
      if(error)throw error;
      token=String(data?.session?.access_token||'').trim();
    }
    if(!token)throw new Error('No hay sesión autenticada para enviar la notificación');

    const cfg=typeof config==='function'?config():null;
    const base=String(cfg?.url||'').trim().replace(/\/+$/,'');
    if(!base)throw new Error('No se encontró la URL de Supabase');

    // V563: envío simple CORS (text/plain) para evitar el preflight OPTIONS
    // que estaba siendo rechazado con 401 antes de llegar a la Edge Function.
    const response=await fetch(`${base}/functions/v1/${FN}`,{
      method:'POST',
      headers:{'Content-Type':'text/plain;charset=UTF-8'},
      body:JSON.stringify({...body,access_token:token,source:'V563_HTML'})
    });
    const raw=await response.text();
    let data=null;
    try{data=raw?JSON.parse(raw):null;}catch(_){data={raw};}
    if(!response.ok){
      const msg=data?.error||data?.message||`HTTP ${response.status}`;
      return {data:null,error:new Error(msg)};
    }
    return {data,error:null};
  }
  window.v562InvokeExternalFunction=invokeAuthenticated;
  window.v563InvokeExternalFunction=invokeAuthenticated;
  async function drain(force=false){
    // V726: evita ráfagas de HTTP 503 cuando Gmail indica OAuth revocado.
    if(window.v726MailPaused?.())return {ok:false,estado:'BLOQUEADO_OAUTH',error:'Gmail requiere nueva autorización; cola preservada.'};
    if(!hasSession()||busy)return null;
    const now=Date.now();
    if(!force && now-lastRun<12000)return null;
    busy=true;lastRun=now;
    try{
      const {data,error}=await invokeAuthenticated({mode:'drain',limit:16,source:'V563_HTML'});
      if(error)throw error;
      return data||null;
    }catch(error){
      // El sistema principal no se bloquea si la Edge Function aún no fue instalada
      // o si Gmail está temporalmente indisponible. La cola queda pendiente en Supabase.
      console.warn('V558 · envío externo pendiente:',error?.message||error);
      return null;
    }finally{busy=false;}
  }
  window.v558ProcesarNotificacionesExternas=drain;

  function scheduleDrain(){
    [1800,6500].forEach(ms=>setTimeout(()=>drain(true).catch(()=>{}),ms));
  }
  window.v558ProgramarEnvioExterno=scheduleDrain;

  function wrapAsync(name){
    const original=window[name];
    if(typeof original!=='function'||original.__v558Wrapped)return;
    const wrapped=async function(){
      try{return await original.apply(this,arguments);}
      finally{try{await drain(true);}catch(_){ }scheduleDrain();}
    };
    wrapped.__v558Wrapped=true;
    window[name]=wrapped;
  }

  function wrapKnownActions(){
    [
      'saveNewRequest',
      'respondInternalReassign',
      'confirmInternalReassignFromPanelV196',
      'confirmInternalReassignFromAlert',
      'rejectInternalReassignFromPanelV196',
      'confirmSelectedReturnRequests',
      'v504ConfirmSelectedReturns',
      'confirmArchiveDeliveryReceived',
      'requestArchiveDeliveryItems'
    ].forEach(wrapAsync);

    if(typeof window.deliverDigitalCopyV488==='function'&&!window.deliverDigitalCopyV488.__v558Wrapped){
      const original=window.deliverDigitalCopyV488;
      const wrapped=async function(){try{return await original.apply(this,arguments);}finally{try{await drain(true);}catch(_){ }scheduleDrain();}};
      wrapped.__v558Wrapped=true;
      window.deliverDigitalCopyV488=wrapped;
    }
  }

  function relevantAction(target){
    const btn=target?.closest?.('button');
    if(!btn)return false;
    const signature=up([
      btn.id||'',btn.textContent||'',btn.getAttribute('onclick')||'',btn.title||''
    ].join(' '));
    return /(ENVIAR SOLICITUD|SOLICITAR REASIGN|REASIGNAR|ACEPTAR REASIGN|RECHAZAR|DEVOLVER|CONFIRMAR RECEPCI|ENTREGAR Y CERRAR|ENTREGAR COPIA|SOLICITAR ENTREGA)/.test(signature);
  }

  document.addEventListener('click',ev=>{
    if(relevantAction(ev.target))scheduleDrain();
  },true);

  async function testEmail(btn){
    if(!hasSession())return;
    const old=btn.textContent;
    btn.disabled=true;btn.classList.remove('v558-ok','v558-error');btn.textContent='✉ Enviando prueba...';
    try{
      const {data,error}=await invokeAuthenticated({mode:'test'});
      if(error)throw error;
      if(!data?.ok)throw new Error(data?.error||'No se pudo enviar la prueba');
      btn.classList.add('v558-ok');btn.textContent='✓ Correo externo enviado';
      try{window.showToast?.('Correo de prueba enviado a '+(data.to||'su cuenta')+'.',6500);}catch(_){ }
    }catch(error){
      btn.classList.add('v558-error');btn.textContent='⚠ Revisar correo externo';
      try{window.showToast?.('Notificación externa aún no está configurada: '+(error?.message||error),9000);}catch(_){ }
    }finally{
      btn.disabled=false;
      setTimeout(()=>{btn.textContent=old;btn.classList.remove('v558-ok','v558-error');},8000);
    }
  }

  function ensureTestButton(){
    const role=up(currentProfile?.rol||'');
    const anchor=document.getElementById('desktopNotifyBtnV467');
    let btn=document.getElementById('v558ExternalNotifyTestBtn');
    if(!anchor)return;
    if(!btn){
      btn=document.createElement('button');
      btn.type='button';
      btn.id='v558ExternalNotifyTestBtn';
      btn.className='btn secondary';
      btn.textContent='✉ Probar correo externo';
      btn.title='Envía un correo de prueba mediante la Edge Function segura de Supabase.';
      btn.addEventListener('click',()=>testEmail(btn));
      anchor.insertAdjacentElement('afterend',btn);
    }
    btn.style.display=['ADMINISTRADOR','ARCHIVO'].includes(role)?'':'none';
  }

  function externalParams(){
    try{
      const q=new URLSearchParams(location.search);
      return {evento:q.get('v558_evento')||'',id:q.get('v558_id')||''};
    }catch(_){return {evento:'',id:''};}
  }
  function clearExternalParams(){
    try{
      const u=new URL(location.href);
      u.searchParams.delete('v558_evento');u.searchParams.delete('v558_id');
      history.replaceState(history.state,'',u.pathname+u.search+u.hash);
    }catch(_){ }
  }
  function openExternalEvent(){
    const p=externalParams();
    if(!p.evento||!hasSession())return false;
    try{
      if(typeof window.v549OpenAlertDrawer==='function')window.v549OpenAlertDrawer();
      else if(typeof window.openAlertsModal==='function')window.openAlertsModal();
      try{window.v549RefreshAlerts?.(true);}catch(_){ }
      try{window.showToast?.('Aviso externo abierto: '+p.evento.replaceAll('_',' ')+'.',4500);}catch(_){ }
      clearExternalParams();
      return true;
    }catch(_){return false;}
  }

  function boot(){
    wrapKnownActions();ensureTestButton();
    setTimeout(()=>{wrapKnownActions();ensureTestButton();drain(true).catch(()=>{});openExternalEvent();},1000);
    setTimeout(openExternalEvent,2500);
    setInterval(()=>{
      wrapKnownActions();ensureTestButton();
      if(document.visibilityState==='visible' &&
         (!window.v601Protection || window.v601Protection.canPoll('mail-safety'))){
        // V602: el envío normal sigue siendo inmediato por operación. Este barrido
        // es solo una red de seguridad para reintentos pendientes.
        drain(false).catch(()=>{});
      }
    },600000);
    window.addEventListener('focus',()=>{setTimeout(openExternalEvent,250);},{passive:true});
    window.addEventListener('online',()=>setTimeout(()=>drain(true).catch(()=>{}),500),{passive:true});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>

<!-- V563: corrige sesión global e invocación autenticada de Edge Function -->
<style id="v560-mail-style">
#v558ExternalNotifyTestBtn{display:none!important}
.v560-mail-panel{border:1px solid #cbd5e1;background:#f8fafc;border-radius:12px;padding:12px}
.v560-mail-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap}
.v560-mail-switch{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:800;color:#173b61;cursor:pointer}
.v560-mail-switch input{width:17px;height:17px}
.v560-mail-content{margin-top:10px;display:grid;grid-template-columns:minmax(280px,1fr) minmax(300px,1.15fr);gap:10px}
.v560-mail-content.hidden{display:none!important}
.v560-recipient-list{display:flex;flex-direction:column;gap:6px;max-height:150px;overflow:auto;border:1px solid #dbe3ec;border-radius:9px;padding:8px;background:#fff}
.v560-recipient-item{display:grid;grid-template-columns:18px minmax(0,1fr);gap:7px;align-items:start;padding:6px;border-radius:7px}
.v560-recipient-item:hover{background:#f1f5f9}
.v560-recipient-item input{margin-top:2px}
.v560-recipient-item b{display:block;font-size:12px;color:#173b61}
.v560-recipient-item small{display:block;font-size:10px;color:#64748b;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.v560-mail-admin-table{max-height:360px;overflow:auto;border:1px solid #e2e8f0;border-radius:10px}
.v560-mail-admin-table table{width:100%;border-collapse:collapse}
.v560-mail-admin-table th,.v560-mail-admin-table td{padding:8px;border-bottom:1px solid #eef2f7;font-size:11px;text-align:left;vertical-align:top}
.v560-badge{display:inline-flex;padding:2px 6px;border-radius:999px;font-size:9px;font-weight:800;background:#e8eef5;color:#173b61}
@media(max-width:800px){.v560-mail-content{grid-template-columns:1fr}}
</style>
<script id="v560-selectable-email-script">
(function(){
  'use strict';
  const FN='procesar-notificaciones-externas';
  const q=id=>document.getElementById(id);
  const safe=v=>String(v??'').trim();
  const up=v=>safe(v).toUpperCase();
  const escHtml=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  let requestRecipients=[];
  let reassignRecipients=[];
  let adminRecipients=[];
  let adminEditingId=null;

  function activeSession(){
    try{return !!(sb && session?.user?.id)}catch(_){return false}
  }
  function isAdminV560(){
    try{return up(currentProfile?.rol)==='ADMINISTRADOR'}catch(_){return false}
  }
  function selectedIds(containerId){
    return [...document.querySelectorAll(`#${containerId} input[data-v560-recipient]:checked`)].map(x=>x.value).filter(Boolean);
  }
  function selectedNames(containerId){
    return [...document.querySelectorAll(`#${containerId} input[data-v560-recipient]:checked`)].map(x=>x.dataset.name||'').filter(Boolean);
  }
  function selectedRecipientDetails(containerId, rows){
    const ids=new Set(selectedIds(containerId));
    return (Array.isArray(rows)?rows:[])
      .filter(r=>ids.has(String(r.id)))
      .map(r=>({
        id:r.id,
        nombre:safe(r.nombre)||'Destinatario',
        email:safe(r.email),
        categoria:safe(r.categoria)||'OTRO'
      }));
  }
  function recipientMailLines(recipients){
    const list=Array.isArray(recipients)?recipients:[];
    return list.map((r,i)=>{
      const nombre=safe(r?.nombre)||'Destinatario';
      const email=safe(r?.email);
      return `${i+1}. ${nombre}${email?` <${email}>`:''}`;
    });
  }
  function requestItems(){
    try{return JSON.parse(q('newRequestModal')?.dataset.items||'[]')}catch(_){return []}
  }
  function expLabel(x){
    const e=safe(x?.expediente)||'—';
    const ext=safe(x?.extension);
    const rd=safe(x?.rd);
    const folio=safe(x?.ultimo_folio);

    return [
      e,
      ext ? `Ext. ${ext}` : '',
      rd ? `R.D. ${rd}` : '',
      folio ? `Último folio ${folio}` : ''
    ].filter(Boolean).join(' · ');
  }
  
  function v582UpdateRouting(containerId){
    const box=q(containerId);
    if(!box) return;
    const panel=q('#v582RequestRouting');
    if(!panel || containerId!=='v560RequestMailRecipients') return;

    const checked=[...box.querySelectorAll('input[data-v560-recipient]:checked')];
    const items=checked.map(el=>({
      id:String(el.value||''),
      nombre:String(el.dataset.name||'').trim(),
      email:String(el.dataset.email||'').trim().toLowerCase()
    }));

    let principal=items.find(x=>x.email==='ds_pa_temp208@produce.gob.pe') || items[0] || null;
    const cc=items.filter(x=>!principal || x.id!==principal.id);

    const toNode=panel.querySelector('[data-v582-to]');
    const ccNode=panel.querySelector('[data-v582-cc]');
    if(toNode){
      toNode.innerHTML=principal
        ? `<span class="chip"><b>${escHtml(principal.nombre)}</b>${principal.email?` · ${escHtml(principal.email)}`:''}</span>`
        : 'Sin destinatario principal seleccionado.';
    }
    if(ccNode){
      ccNode.innerHTML=cc.length
        ? cc.map(x=>`<span class="chip"><b>${escHtml(x.nombre)}</b>${x.email?` · ${escHtml(x.email)}`:''}</span>`).join('')
        : 'Sin destinatarios en copia.';
    }
  }

function renderRecipients(containerId, rows){
    const box=q(containerId); if(!box)return;
    if(!rows.length){
      box.innerHTML='<span class="note">No hay correos activos configurados por el Administrador.</span>';
      return;
    }
    const evento = containerId==='v560RequestMailRecipients' ? 'SOLICITUD' : 'REASIGNACION';
    const defaults=(Array.isArray(rows)?rows:[]).filter(r=>r.predeterminado);
    let principalId='';
    if(evento==='SOLICITUD'){
      const coord=defaults.find(r=>safe(r.email).toLowerCase()==='ds_pa_temp208@produce.gob.pe');
      principalId=String(coord?.id||defaults[0]?.id||'');
    }
    box.innerHTML=rows.map(r=>{
      const mail=safe(r.email).toLowerCase();
      const checked = evento==='SOLICITUD'
        ? !!r.predeterminado
        : mail==='ds_pa_temp208@produce.gob.pe';
      const principal = evento==='SOLICITUD'
        ? (checked && String(r.id)===principalId)
        : false;
      const badge=principal
        ? '<span class="v581-mail-role v581-mail-role-to">PARA</span>'
        : (checked ? '<span class="v581-mail-role v581-mail-role-cc">CC</span>' : '');
      return `<label class="v560-recipient-item">
        <input type="checkbox" data-v560-recipient value="${escHtml(r.id)}" data-name="${escHtml(r.nombre)}" data-email="${escHtml(r.email)}" ${checked?'checked':''}>
        <span><b>${escHtml(r.nombre)} ${badge}</b><small>${escHtml(r.email)} · ${escHtml(r.categoria||'OTRO')}</small></span>
      </label>`;
    }).join('');
  }
  async function loadRecipients(evento){
    if(!activeSession())return [];
    const {data,error}=await sb.rpc('v560_listar_destinatarios_correo',{p_evento:evento});
    if(error)throw error;
    return Array.isArray(data)?data:[];
  }

  window.v560SyncRequestMailUI=function(){
    const enabled=!!q('v560RequestMailEnabled')?.checked;
    q('v560RequestMailContent')?.classList.toggle('hidden',!enabled);
    const btn=q('rqSaveBtn');
    if(btn&&!window.__editingRequestId){
      btn.textContent=enabled?'Registrar solicitud y enviar correo':'Enviar solicitud';
    }
  };
  window.v560SyncReassignMailUI=function(){
    const enabled=!!q('v560ReassignMailEnabled')?.checked;
    q('v560ReassignMailContent')?.classList.toggle('hidden',!enabled);
    const btn=q('bulkReassignSubmitBtn');
    if(btn && bulkReassignRows?.length){
      btn.textContent=enabled
        ?`REASIGNAR ${bulkReassignRows.length} EXPEDIENTE${bulkReassignRows.length===1?'':'S'} + CORREO`
        :`REASIGNAR ${bulkReassignRows.length} EXPEDIENTE${bulkReassignRows.length===1?'':'S'}`;
    }
  };

  function defaultRequestSubject(){
    const solicitante=safe(q('rqSolicitante')?.value||currentProfile?.nombre_personal||'').trim();
    const asunto=safe(q('rqAsunto')?.value).trim();
    const modalidad=safe(q('rqModalidad')?.value).trim()||'PRÉSTAMO';
    if(solicitante && asunto)return `Solicitud de expedientes de ${solicitante} - Asunto: ${asunto}`;
    if(solicitante)return `Solicitud de expedientes de ${solicitante} - Modalidad: ${modalidad}`;
    return asunto?`Solicitud de expedientes · ${asunto}`:`Solicitud de expedientes · ${modalidad}`;
  }
  function defaultReassignSubject(){
    const actor=safe(currentProfile?.nombre_personal||currentProfile?.email||session?.user?.email)||'USUARIO';
    const target=safe(q('bulkReassignTarget')?.value);
    const rows=Array.isArray(bulkReassignRows)?bulkReassignRows:[];
    // V753: el asunto del correo se basa en la atención que recibirá cada expediente,
    // no en el asunto original de la solicitud.
    const asuntos=[...new Set(rows.map(x=>
      safe(x?._v752_nuevo || x?._v752_asunto || x?.asunto || x?.asunto_solicitud)
    ).filter(Boolean))];
    const base=target?`Reasignación de expedientes de ${actor} a ${target}`:`Reasignación de expedientes de ${actor}`;
    const suffix=asuntos.length===1?` - Asunto de atención: ${asuntos[0]}`:
      (asuntos.length>1?' - Asuntos de atención por expediente':'');
    return (base+suffix).slice(0,180);
  }
  function maybeFillRequestSubject(force=false){
    const input=q('v560RequestMailSubject'); if(!input)return;
    if(force||input.dataset.manual!=='1')input.value=defaultRequestSubject();
  }
  function maybeFillReassignSubject(force=false){
    const input=q('v560ReassignMailSubject'); if(!input)return;
    if(force||input.dataset.manual!=='1')input.value=defaultReassignSubject();
  }
  window.v753RefreshReassignSubject=function(){maybeFillReassignSubject(false);};

  async function prepareRequestMail(){
    const panel=q('v560RequestMailPanel'); if(!panel)return;
    if(window.__editingRequestId){panel.classList.add('hidden');return}
    panel.classList.remove('hidden');
    try{
      requestRecipients=await loadRecipients('SOLICITUD');
      renderRecipients('v560RequestMailRecipients',requestRecipients);
      await window.v796PrepararGrupoCorreo?.('SOLICITUD');
      const cb=q('v560RequestMailEnabled');
      if(cb)cb.checked=requestRecipients.some(x=>x.predeterminado);
      const sub=q('v560RequestMailSubject'); if(sub)sub.dataset.manual='';
      maybeFillRequestSubject(true);
      window.v560SyncRequestMailUI();
    }catch(error){
      console.warn('V560 destinatarios solicitud:',error);
      if(q('v560RequestMailRecipients'))q('v560RequestMailRecipients').innerHTML='<span class="note">No se pudo cargar el catálogo de correos.</span>';
      if(q('v560RequestMailEnabled'))q('v560RequestMailEnabled').checked=false;
      window.v560SyncRequestMailUI();
    }
  }
  async function prepareReassignMail(){
    try{
      reassignRecipients=await loadRecipients('REASIGNACION');
      renderRecipients('v560ReassignMailRecipients',reassignRecipients);
      v585BindReassignTarget();
      await window.v796PrepararGrupoCorreo?.('REASIGNACION');
      setTimeout(v585ApplyReassignTarget,0);
      const cb=q('v560ReassignMailEnabled');
      if(cb)cb.checked=reassignRecipients.some(x=>x.predeterminado);
      const sub=q('v560ReassignMailSubject'); if(sub)sub.dataset.manual='';
      maybeFillReassignSubject(true);
      window.v560SyncReassignMailUI();
    }catch(error){
      console.warn('V560 destinatarios reasignación:',error);
      if(q('v560ReassignMailRecipients'))q('v560ReassignMailRecipients').innerHTML='<span class="note">No se pudo cargar el catálogo de correos.</span>';
      if(q('v560ReassignMailEnabled'))q('v560ReassignMailEnabled').checked=false;
      window.v560SyncReassignMailUI();
    }
  }


  function v585NormName(value){
    return safe(value)
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .replace(/[^A-Za-z0-9 ]+/g,' ')
      .replace(/\s+/g,' ')
      .trim()
      .toUpperCase();
  }

  function v585ApplyReassignTarget(){
    // V797: no mezclar el responsable automático del flujo con los integrantes
    // exactos de un grupo personal al elegirlo o al abrir el formulario.
    if(window.v798GrupoCorreoActivo?.('REASIGNACION'))return;
    const box=q('v560ReassignMailRecipients');
    const select=q('bulkReassignTarget');
    if(!box||!select)return;

    const option=select.options?.[select.selectedIndex];
    const target=v585NormName(option?.textContent||select.value||'');
    const checks=[...box.querySelectorAll('input[data-v560-recipient]')];

    // Quitar únicamente el responsable anterior agregado automáticamente.
    checks.forEach(cb=>{
      if(cb.dataset.v585TargetAuto==='1'){
        cb.checked=false;
        delete cb.dataset.v585TargetAuto;
      }
    });

    if(target && !target.includes('SELECCIONE NUEVO RESPONSABLE')){
      let best=null;
      let bestScore=0;
      const targetTokens=target.split(' ').filter(x=>x.length>=2);

      checks.forEach(cb=>{
        const row=cb.closest('label');
        const name=v585NormName(cb.dataset.name||row?.querySelector('b')?.textContent||'');
        const tokens=new Set(name.split(' ').filter(x=>x.length>=2));
        const matches=targetTokens.filter(t=>tokens.has(t)).length;
        const score=matches/Math.max(targetTokens.length,1);
        if(name===target || (matches>=2 && score>bestScore)){
          best=cb;
          bestScore=name===target ? 99 : score;
        }
      });

      if(best){
        best.checked=true;
        best.dataset.v585TargetAuto='1';
        best.dispatchEvent(new Event('change',{bubbles:true}));
      }
    }

    // El Coordinador siempre queda en copia.
    checks.forEach(cb=>{
      if(String(cb.dataset.email||'').toLowerCase()==='ds_pa_temp208@produce.gob.pe' && !cb.checked){
        cb.checked=true;
        cb.dispatchEvent(new Event('change',{bubbles:true}));
      }
    });
  }

  function v585BindReassignTarget(){
    const el=q('bulkReassignTarget');
    if(!el||el.dataset.v585MailBound==='1')return;
    el.dataset.v585MailBound='1';
    el.addEventListener('change',()=>setTimeout(v585ApplyReassignTarget,0));
  }

  window.v796ReaplicarResponsable = v585ApplyReassignTarget;

  window.v560CaptureRequestMailDraft=function(ctx={}){
    const enabled=!!q('v560RequestMailEnabled')?.checked;
    if(!enabled)return {enabled:false};
    const ids=selectedIds('v560RequestMailRecipients');
    const subject=safe(q('v560RequestMailSubject')?.value)||defaultRequestSubject();
    if(!ids.length){
      return {enabled:true,invalid:'Seleccione al menos un destinatario de correo.'};
    }
    return {
      enabled:true,
      ids,
      names:selectedNames('v560RequestMailRecipients'),
      recipients:selectedRecipientDetails('v560RequestMailRecipients',requestRecipients),
      subject
    };
  };
  window.v560CaptureReassignMailDraft=function(ctx={}){
    const enabled=!!q('v560ReassignMailEnabled')?.checked;
    if(!enabled)return {enabled:false};
    const ids=selectedIds('v560ReassignMailRecipients');
    // V753: si el usuario no personalizó el título, generar el asunto con los
    // valores seleccionados AHORA, incluso si el catálogo cambió tras abrir el modal.
    const subject=q('v560ReassignMailSubject')?.dataset.manual==='1'
      ?(safe(q('v560ReassignMailSubject')?.value)||defaultReassignSubject())
      :defaultReassignSubject();
    if(!ids.length)return {enabled:true,invalid:'Seleccione al menos un destinatario de correo.'};
    return {
      enabled:true,
      ids,
      names:selectedNames('v560ReassignMailRecipients'),
      recipients:selectedRecipientDetails('v560ReassignMailRecipients',reassignRecipients),
      subject,
      operationId:crypto.randomUUID()
    };
  };

  async function queueAndDrain(payload){
    const {data,error}=await sb.rpc('v560_encolar_correo_operacion',payload);
    if(error)throw error;

    const queued=Number(data?.encoladas||0);

    // V586: la solicitud/reasignación no espera la respuesta de Gmail.
    // Primero se garantiza que el correo quede en la cola y luego el drenaje
    // continúa en segundo plano.
    window.v586DrainMailInBackground?.('V586_V560_HTML');

    return {
      ok:true,
      queued,
      sent:0,
      processing:queued>0,
      data
    };
  }

  window.v560EnqueueRequestMail=async function(ctx){
    const items=Array.isArray(ctx?.items)?ctx.items:[];
    const numero=safe(ctx?.data?.numero||ctx?.data?.solicitud_numero);
    const requestId=safe(ctx?.data?.id||ctx?.data?.solicitud_id)||crypto.randomUUID();
    const lines=items.map((x,i)=>`${i+1}. ${expLabel(x)}`);
    const body=[
      'Se ha registrado una nueva solicitud en el Sistema de Control y Trazabilidad de Expedientes.',
      '',
      `Solicitud: ${numero||'Registrada en el sistema'}`,
      `Solicitante: ${safe(ctx?.solicitante)||'—'}`,
      `Modalidad: ${safe(ctx?.modalidad)||'—'}`,
      `Asunto de la solicitud: ${safe(ctx?.asunto)||'—'}`,
      `Cantidad de expedientes: ${items.length}`,
      '',
      'Destinatarios notificados:',
      ...recipientMailLines(ctx?.draft?.recipients),
      '',
      'Expedientes:',
      ...lines,
      ...(safe(ctx?.observacion)?['',`Observación: ${safe(ctx.observacion)}`]:[]),
      '',
      'La solicitud quedó registrada. Revise el sistema para su atención.'
    ].join('\n');
    return queueAndDrain({
      p_evento:'NUEVA_SOLICITUD',
      p_referencia_id:requestId,
      p_referencia_numero:numero,
      p_asunto_correo:safe(ctx?.draft?.subject)||defaultRequestSubject(),
      p_cuerpo:body,
      p_destinatario_ids:ctx?.draft?.ids||[],
      p_metadata:{
        origen:'V560_HTML',modalidad:ctx?.modalidad||null,asunto_solicitud:ctx?.asunto||null,
        solicitante:ctx?.solicitante||null,cantidad_expedientes:items.length,
        expedientes:items.map(x=>({
          expediente:x.expediente||null,
          extension:x.extension||null,
          rd:x.rd||null,
          ultimo_folio:x.ultimo_folio||null
        })),
        destinatarios_seleccionados:ctx?.draft?.names||[],
        destinatarios_detalle:ctx?.draft?.recipients||[]
      }
    });
  };

  window.v560EnqueueReassignMail=async function(ctx){
    const items=Array.isArray(ctx?.items)?ctx.items:[];
    const source=safe(currentProfile?.nombre_personal||currentProfile?.email||session?.user?.email)||'Usuario';
    // V753: el correo debe describir la finalidad de atención POR EXPEDIENTE.
    // _v752_asunto se consulta al servidor ANTES de efectuar la reasignación;
    // _v752_nuevo es lo que seleccionó el usuario en el formulario.
    const details=items.map(x=>{
      const anterior=safe(x?._v752_asunto||x?.asunto||x?.asunto_solicitud);
      const elegido=safe(x?._v752_nuevo);
      const actual=elegido||anterior;
      return {anterior,actual,cambio:!!elegido && elegido!==anterior};
    });
    const lines=items.flatMap((x,i)=>[
      `${i+1}. ${expLabel(x)}`,
      `   Asunto anterior: ${details[i].anterior||'No registrado'}`,
      `   Asunto para el nuevo responsable: ${details[i].actual||'No registrado'}${details[i].cambio?' (nuevo)':' (se mantiene)'}`
    ]);
    const opId=safe(ctx?.draft?.operationId)||crypto.randomUUID();
    const body=[
      'Se ha registrado una reasignación de expedientes en el Sistema de Control y Trazabilidad de Expedientes.',
      '',
      `Responsable que reasigna: ${source}`,
      `Nuevo responsable: ${safe(ctx?.nuevo)||'—'}`,
      `Fecha de reasignación: ${new Date().toLocaleString('es-PE',{timeZone:'America/Lima'})}`,
      `Cantidad de expedientes: ${items.length}`,
      '',
      'Destinatarios notificados:',
      ...recipientMailLines(ctx?.draft?.recipients),
      '',
      'Expedientes y asuntos de atención:',
      ...lines,
      ...(safe(ctx?.observacion)?['',`Observación: ${safe(ctx.observacion)}`]:[]),
      '',
      'El asunto original de la solicitud y el cargo correspondiente permanecen sin modificaciones.',
      'Revise el sistema para consultar la trazabilidad de la reasignación.'
    ].join('\n');
    return queueAndDrain({
      p_evento:'REASIGNACION',
      p_referencia_id:opId,
      p_referencia_numero:'',
      p_asunto_correo:safe(ctx?.draft?.subject)||defaultReassignSubject(),
      p_cuerpo:body,
      p_destinatario_ids:ctx?.draft?.ids||[],
      p_metadata:{
        origen:'V560_HTML',responsable_origen:source,nuevo_responsable:ctx?.nuevo||null,
        cantidad_expedientes:items.length,
        expedientes:items.map(x=>({
          id:x.id||null,
          expediente:x.expediente||null,
          extension:x.extension||null,
          rd:x.rd||null,
          ultimo_folio:x.ultimo_folio||null,
          asunto_anterior:details[items.indexOf(x)]?.anterior||null,
          asunto_nuevo:details[items.indexOf(x)]?.actual||null,
          asunto_modificado:!!details[items.indexOf(x)]?.cambio
        })),
        destinatarios_seleccionados:ctx?.draft?.names||[],
        destinatarios_detalle:ctx?.draft?.recipients||[]
      }
    });
  };

  function ensureAdminButton(){
    const anchor=q('subjectsBtn');
    if(!anchor)return;
    let btn=q('v560MailAdminBtn');
    if(!btn){
      btn=document.createElement('button');
      btn.type='button';btn.id='v560MailAdminBtn';btn.className='btn secondary';
      btn.textContent='✉ Correos de notificación';
      btn.onclick=()=>window.v560OpenMailAdmin();
      anchor.insertAdjacentElement('afterend',btn);
    }
    btn.style.display=isAdminV560()?'':'none';
  }
  function ensureAdminModal(){
    if(q('v560MailAdminModal'))return;
    document.body.insertAdjacentHTML('beforeend',`<div class="modal" id="v560MailAdminModal" onclick="closeModalFromBackdrop(event,this)">
      <div class="modal-box" style="max-width:1050px">
        <div class="modal-head"><div><h2>Correos de notificación</h2><div class="note">Solo el Administrador registra, edita, activa o desactiva correos. Si un correo se vuelve a activar, revise la vinculación del usuario en Supabase.</div></div><button class="btn secondary small" type="button" onclick="v560CloseMailAdmin()">Cerrar</button></div>
        <div class="form-grid">
          <div class="field span2"><label>Nombre *</label><input id="v560AdminMailName" placeholder="Ej.: Coordinador de Archivo"></div>
          <div class="field span2"><label>Correo de notificación *</label><input id="v560AdminMailEmail" type="email" placeholder="correo@dominio.gob.pe"></div>
          <div class="field"><label>Tipo</label><select id="v560AdminMailCategory"><option>COORDINADOR</option><option>ARCHIVO</option><option>USUARIO</option><option>OTRO</option></select></div>
          <div class="field"><label>Estado</label><select id="v560AdminMailActive"><option value="true">ACTIVO</option><option value="false">INACTIVO</option></select></div>
          <div class="field span2"><label><input id="v560AdminMailDefaultRequest" type="checkbox"> Predeterminado en solicitudes</label><label style="margin-top:8px"><input id="v560AdminMailDefaultReassign" type="checkbox"> Predeterminado en reasignaciones</label><label style="margin-top:8px"><input id="v615AdminMailDefaultReturn" type="checkbox"> Predeterminado en devoluciones</label></div>
          <div class="field span2"><label>Observación</label><input id="v560AdminMailObs" placeholder="Opcional"></div>
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;margin:10px 0"><button class="btn secondary" type="button" onclick="v560ResetMailAdminForm()">Nuevo</button><button class="btn" type="button" onclick="v560SaveMailRecipient()">Guardar destinatario</button></div>
        <div class="v560-mail-admin-table" id="v560MailAdminTable"><div class="empty">Cargando...</div></div>
        <div class="modal-foot"><span class="note" id="v560MailAdminStatus"></span><button class="btn secondary" type="button" onclick="v560CloseMailAdmin()">Cerrar</button></div>
      </div></div>`);
  }
  window.v560ResetMailAdminForm=function(){
    adminEditingId=null;
    if(q('v560AdminMailName'))q('v560AdminMailName').value='';
    if(q('v560AdminMailEmail'))q('v560AdminMailEmail').value='';
    if(q('v560AdminMailCategory'))q('v560AdminMailCategory').value='OTRO';
    if(q('v560AdminMailActive'))q('v560AdminMailActive').value='true';
    if(q('v560AdminMailDefaultRequest'))q('v560AdminMailDefaultRequest').checked=false;
    if(q('v560AdminMailDefaultReassign'))q('v560AdminMailDefaultReassign').checked=false;
    if(q('v615AdminMailDefaultReturn'))q('v615AdminMailDefaultReturn').checked=false;
    if(q('v560AdminMailObs'))q('v560AdminMailObs').value='';
    if(q('v560MailAdminStatus'))q('v560MailAdminStatus').textContent='';
  };
  function renderAdminTable(){
    const box=q('v560MailAdminTable'); if(!box)return;
    if(!adminRecipients.length){box.innerHTML='<div class="empty">No hay destinatarios registrados.</div>';return}
    box.innerHTML=`<table><thead><tr><th>Nombre</th><th>Correo</th><th>Tipo</th><th>Predeterminado</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>${adminRecipients.map(r=>`<tr>
      <td><b>${escHtml(r.nombre)}</b></td><td>${escHtml(r.email)}</td><td><span class="v560-badge">${escHtml(r.categoria)}</span></td>
      <td>${[r.predeterminado_solicitud?'Solicitud':'',r.predeterminado_reasignacion?'Reasignación':'',r.predeterminado_devoluciones?'Devolución':''].filter(Boolean).join(' · ')||'—'}</td>
      <td>${r.activo?'<span class="pill returned">ACTIVO</span>':'<span class="pill">INACTIVO</span>'}</td>
      <td><button class="btn secondary small" type="button" onclick="v560EditMailRecipient('${r.id}')">Editar</button> <button class="btn secondary small" type="button" onclick="v560ToggleMailRecipient('${r.id}',${r.activo?'false':'true'})">${r.activo?'Desactivar':'Activar'}</button></td>
    </tr>`).join('')}</tbody></table>`;
  }
  async function loadAdminRecipients(){
    const {data,error}=await sb.rpc('v615_admin_listar_destinatarios');
    if(error)throw error;
    adminRecipients=Array.isArray(data)?data:[];renderAdminTable();
  }
  window.v560OpenMailAdmin=async function(){
    if(!isAdminV560()){showToast?.('Solo el Administrador puede administrar correos.');return}
    ensureAdminModal();window.v560ResetMailAdminForm();q('v560MailAdminModal')?.classList.add('show');
    try{await loadAdminRecipients()}catch(e){q('v560MailAdminStatus').textContent=e?.message||String(e)}
  };
  window.v560CloseMailAdmin=function(){q('v560MailAdminModal')?.classList.remove('show')};
  window.v560EditMailRecipient=function(id){
    const r=adminRecipients.find(x=>String(x.id)===String(id));if(!r)return;
    adminEditingId=r.id;q('v560AdminMailName').value=r.nombre||'';q('v560AdminMailEmail').value=r.email||'';q('v560AdminMailCategory').value=r.categoria||'OTRO';q('v560AdminMailActive').value=String(!!r.activo);q('v560AdminMailDefaultRequest').checked=!!r.predeterminado_solicitud;q('v560AdminMailDefaultReassign').checked=!!r.predeterminado_reasignacion;if(q('v615AdminMailDefaultReturn'))q('v615AdminMailDefaultReturn').checked=!!r.predeterminado_devoluciones;q('v560AdminMailObs').value=r.observacion||'';
  };
  window.v560SaveMailRecipient=async function(){
    try{
      const name=safe(q('v560AdminMailName')?.value), email=safe(q('v560AdminMailEmail')?.value).toLowerCase();
      if(!name||!email)throw new Error('Complete nombre y correo.');
      const {error}=await sb.rpc('v615_admin_guardar_destinatario',{
        p_id:adminEditingId,p_nombre:name,p_email:email,p_categoria:q('v560AdminMailCategory')?.value||'OTRO',
        p_activo:q('v560AdminMailActive')?.value==='true',p_predeterminado_solicitud:!!q('v560AdminMailDefaultRequest')?.checked,
        p_predeterminado_reasignacion:!!q('v560AdminMailDefaultReassign')?.checked,
        p_predeterminado_devoluciones:!!q('v615AdminMailDefaultReturn')?.checked,
        p_observacion:safe(q('v560AdminMailObs')?.value)||null
      });
      if(error)throw error;window.v560ResetMailAdminForm();await loadAdminRecipients();showToast?.('Correo de notificación guardado.');
    }catch(e){q('v560MailAdminStatus').textContent=e?.message||String(e)}
  };
  window.v560ToggleMailRecipient=async function(id,active){
    const status=q('v560MailAdminStatus');
    if(status)status.textContent='Guardando cambio de destinatario...';
    try{
      const {error}=await sb.rpc('v560_admin_cambiar_estado_destinatario',{p_id:id,p_activo:!!active});
      if(error)throw error;
      await loadAdminRecipients();
      const actual=adminRecipients.find(r=>String(r.id)===String(id));
      if(!actual || Boolean(actual.activo)!==Boolean(active)){
        throw new Error('Supabase no conservó el estado solicitado. Revise el vínculo del destinatario con el usuario y las reglas de sincronización.');
      }
      if(status)status.textContent=active?'Destinatario activado y verificado.':'Destinatario desactivado y verificado.';
      // Detectar reactivaciones posteriores del servidor, no ocultarlas con estados locales.
      setTimeout(async()=>{
        if(!q('v560MailAdminModal')?.classList.contains('show'))return;
        try{
          await loadAdminRecipients();
          const current=adminRecipients.find(r=>String(r.id)===String(id));
          if(current && Boolean(current.activo)!==Boolean(active) && status){
            status.textContent='ATENCIÓN: el destinatario volvió a cambiar en Supabase. Es necesario corregir la vinculación del usuario en la base de datos.';
          }
        }catch(_){/* No bloquear la interfaz si falla una comprobación */}
      },2200);
    }catch(e){if(status)status.textContent=e?.message||String(e)}
  };
  function hookOpeners(){
    if(typeof window.openNewRequestModal==='function'&&!window.openNewRequestModal.__v560){
      const old=window.openNewRequestModal;
      const wrapped=async function(){const r=await old.apply(this,arguments);setTimeout(prepareRequestMail,40);return r};
      wrapped.__v560=true;window.openNewRequestModal=wrapped;
    }
    if(typeof window.openBulkReassignModal==='function'&&!window.openBulkReassignModal.__v560){
      const old=window.openBulkReassignModal;
      const wrapped=async function(){const r=await old.apply(this,arguments);setTimeout(prepareReassignMail,60);return r};
      wrapped.__v560=true;window.openBulkReassignModal=wrapped;
    }
  }
  function bindSubjectHelpers(){
    q('rqAsunto')?.addEventListener('change',()=>maybeFillRequestSubject(false));
    q('rqModalidad')?.addEventListener('change',()=>maybeFillRequestSubject(false));
    q('rqSolicitante')?.addEventListener('change',()=>maybeFillRequestSubject(false));
    q('bulkReassignTarget')?.addEventListener('change',()=>maybeFillReassignSubject(false));
  }
  function boot(){
    ensureAdminModal();ensureAdminButton();hookOpeners();bindSubjectHelpers();
    setInterval(()=>{ensureAdminButton();hookOpeners()},2500);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>
<!-- V564: el cuerpo del correo muestra todos los destinatarios seleccionados -->


<!-- V565: correo seleccionable para devolución múltiple -->
<style id="v565-return-mail-style">
#v565ReturnMailPanel{margin-top:12px}
#v565ReturnMailPanel .v565-note{font-size:10px;color:#64748b;margin-top:7px;line-height:1.45}
</style>
<script id="v565-return-mail-script">
(function(){
  'use strict';
  const q=id=>document.getElementById(id);
  const safe=v=>String(v??'').trim();
  const up=v=>safe(v).toUpperCase();
  const escHtml=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  let returnRecipients=[];

  function ensurePanel(){
    if(q('v565ReturnMailPanel'))return;
    const table=q('bulkReturnTable');
    if(!table)return;
    table.insertAdjacentHTML('afterend',`<div class="v560-mail-panel" id="v565ReturnMailPanel">
      <div class="v560-mail-head">
        <div><b>✉ Notificación por correo</b><div class="note">Opcional. Se enviará un solo correo con todos los expedientes incluidos en esta devolución.</div></div>
        <label class="v560-mail-switch"><input type="checkbox" id="v565ReturnMailEnabled" onchange="v565SyncReturnMailUI()"> Enviar correo</label>
      </div>
      <div class="v560-mail-content hidden" id="v565ReturnMailContent">
        <div class="field">
          <label>Destinatarios autorizados</label>
          <div class="v560-recipient-list" id="v565ReturnMailRecipients"><span class="note">Cargando...</span></div>
        </div>
        <div class="field">
          <label>Asunto del correo *</label>
          <input id="v565ReturnMailSubject" placeholder="Solicitud de devolución de expedientes" oninput="this.dataset.manual='1'">
          <div class="v565-note">El correo informa que la devolución fue solicitada. La custodia permanece con el usuario hasta que Archivo confirme la recepción física.</div><div class="v565-note"><b>Predeterminados:</b> Coordinador de Archivo + Armando + Jaime + <b>quien devuelve</b>.</div>
        </div>
      </div>
    </div>`);
  }

  function selectedIds(){
    return [...document.querySelectorAll('#v565ReturnMailRecipients input[data-v565-recipient]:checked')].map(x=>x.value).filter(Boolean);
  }
  function selectedDetails(){
    const ids=new Set(selectedIds());
    return returnRecipients.filter(r=>ids.has(String(r.id))).map(r=>({
      id:r.id,nombre:safe(r.nombre)||'Destinatario',email:safe(r.email),categoria:safe(r.categoria)||'OTRO'
    }));
  }
  function recipientLines(list){
    return (Array.isArray(list)?list:[]).map((r,i)=>`${i+1}. ${safe(r.nombre)||'Destinatario'}${safe(r.email)?` <${safe(r.email)}>`:''}`);
  }
  function expLine(x,i){
    const exp=safe(x?.expediente)||'—';
    const ext=safe(x?.extension);
    const rd=safe(x?.rd);
    const folio=safe(x?.ultimo_folio);
    const cargo=safe(x?.cargo_numero||x?.cargo);
    return `${i+1}. ${exp}${ext?` · Ext. ${ext}`:''}${cargo?` · Cargo ${cargo}`:''}${rd?` · R.D. ${rd}`:''}${folio?` · Último folio ${folio}`:''}`;
  }
  function defaultSubject(){
    const name=safe(currentProfile?.nombre_personal||currentProfile?.email||session?.user?.email)||'USUARIO';
    const rows=Array.isArray(bulkReturnRows)?bulkReturnRows:[];
    const asuntos=[...new Set(rows.map(x=>safe(x?.asunto||x?.asunto_solicitud)).filter(Boolean))];
    const asunto=asuntos.length===1?asuntos[0]:'';
    const base=`Solicitud de devolución de expedientes de ${name}`;
    return asunto?`${base} - Asunto: ${asunto}`:base;
  }
  function renderRecipients(){
    const box=q('v565ReturnMailRecipients'); if(!box)return;
    if(!returnRecipients.length){
      box.innerHTML='<span class="note">No hay correos activos configurados por el Administrador.</span>';
      return;
    }
    box.innerHTML=returnRecipients.map(r=>{
      const checked=safe(r.email).toLowerCase()==='ds_pa_temp208@produce.gob.pe';
      return `<label class="v560-recipient-item">
        <input type="checkbox" data-v565-recipient value="${escHtml(r.id)}" data-name="${escHtml(r.nombre)}" data-email="${escHtml(r.email)}" ${checked?'checked':''}>
        <span><b>${escHtml(r.nombre)}</b><small>${escHtml(r.email)} · ${escHtml(r.categoria||'OTRO')}</small></span>
      </label>`;
    }).join('');
  }

  window.v565SyncReturnMailUI=function(){
    const enabled=!!q('v565ReturnMailEnabled')?.checked;
    q('v565ReturnMailContent')?.classList.toggle('hidden',!enabled);
    const btn=q('bulkReturnSubmitBtn');
    if(btn && Array.isArray(bulkReturnRows) && bulkReturnRows.length){
      const n=bulkReturnRows.length;
      btn.textContent=enabled?`DEVOLVER ${n} EXPEDIENTE${n===1?'':'S'} + CORREO`:`DEVOLVER ${n} EXPEDIENTE${n===1?'':'S'}`;
    }
  };

  async function prepareReturnMail(){
    ensurePanel();
    try{
      const {data,error}=await sb.rpc('v560_listar_destinatarios_correo',{p_evento:'DEVOLUCION'});
      if(error)throw error;
      returnRecipients=Array.isArray(data)?data:[];
      renderRecipients();
      const cb=q('v565ReturnMailEnabled');
      if(cb)cb.checked=returnRecipients.length>0;
      const subject=q('v565ReturnMailSubject');
      if(subject){subject.dataset.manual='';subject.value=defaultSubject();}
      window.v565SyncReturnMailUI();
    }catch(error){
      console.warn('V565 destinatarios devolución:',error);
      if(q('v565ReturnMailRecipients'))q('v565ReturnMailRecipients').innerHTML='<span class="note">No se pudo cargar el catálogo de correos.</span>';
      if(q('v565ReturnMailEnabled'))q('v565ReturnMailEnabled').checked=false;
      window.v565SyncReturnMailUI();
    }
  }

  function captureDraft(){
    const enabled=!!q('v565ReturnMailEnabled')?.checked;
    if(!enabled)return {enabled:false};
    const ids=selectedIds();
    if(!ids.length)return {enabled:true,invalid:'Seleccione al menos un destinatario de correo.'};
    return {
      enabled:true,
      ids,
      recipients:selectedDetails(),
      subject:safe(q('v565ReturnMailSubject')?.value)||defaultSubject(),
      operationId:crypto.randomUUID()
    };
  }

  async function enqueueAndDrain(draft,items){
    const source=safe(currentProfile?.nombre_personal||currentProfile?.email||session?.user?.email)||'Usuario';
    const body=[
      'Se ha registrado una solicitud de devolución de expedientes en el Sistema de Control y Trazabilidad de Expedientes.',
      '',
      `Responsable que devuelve: ${source}`,
      `Cantidad de expedientes: ${items.length}`,
      'Estado: PENDIENTE DE RECEPCIÓN POR ARCHIVO',
      '',
      'Destinatarios notificados:',
      ...recipientLines(draft.recipients),
      '',
      'Expedientes:',
      ...items.map(expLine),
      '',
      'La custodia permanece con el usuario hasta que Archivo confirme la recepción física en el sistema.'
    ].join('\n');

    const {data,error}=await sb.rpc('v565_encolar_correo_devolucion',{
      p_referencia_id:draft.operationId,
      p_asunto_correo:draft.subject,
      p_cuerpo:body,
      p_destinatario_ids:draft.ids,
      p_metadata:{
        origen:'V578_HTML',
        responsable_origen:source,
        cantidad_expedientes:items.length,
        expedientes:items.map(x=>({
          id:x.id||null,expediente:x.expediente||null,extension:x.extension||null,
          solicitud_id:x.solicitud_id||null,solicitud_numero:x.solicitud_numero||null,
          cargo_numero:x.cargo_numero||x.cargo||null,rd:x.rd||null,ultimo_folio:x.ultimo_folio||null
        })),
        destinatarios_detalle:draft.recipients
      }
    });
    if(error)throw error;

    const queued=Number(data?.encoladas||0);

    // V586: no bloquear la devolución mientras Gmail procesa el mensaje.
    window.v586DrainMailInBackground?.('V586_V565_HTML');

    return {queued,sent:0,processing:queued>0};
  }

  function hook(){
    ensurePanel();
    if(typeof openBulkReturnModal==='function'&&!openBulkReturnModal.__v565){
      const oldOpen=openBulkReturnModal;
      const wrappedOpen=async function(){
        const r=await oldOpen.apply(this,arguments);
        setTimeout(prepareReturnMail,60);
        return r;
      };
      wrappedOpen.__v565=true;
      openBulkReturnModal=wrappedOpen;
    }

    if(typeof submitBulkReturn==='function'&&!submitBulkReturn.__v565){
      const oldSubmit=submitBulkReturn;
      const wrappedSubmit=async function(){
        const draft=captureDraft();
        if(draft.invalid){
          if(q('bulkReturnStatus'))q('bulkReturnStatus').textContent=draft.invalid;
          return;
        }
        const snapshot=(Array.isArray(bulkReturnRows)?bulkReturnRows:[]).map(x=>({...x}));
        const wasOpen=q('bulkReturnModal')?.classList.contains('show');
        const result=await oldSubmit.apply(this,arguments);
        const success=wasOpen && !q('bulkReturnModal')?.classList.contains('show');
        if(success && draft.enabled && snapshot.length){
          try{
            const mail=await enqueueAndDrain(draft,snapshot);
            if(mail.sent>0)showToast?.(`Devolución registrada. Aviso en cola para ${mail.sent} destinatario${mail.sent===1?'':'s'}.`,6500);
            else if(mail.processing)showToast?.('Devolución registrada. El correo se está enviando en segundo plano.',5500);
            else showToast?.('Devolución registrada. El correo quedó pendiente de envío.',6500);
          }catch(error){
            console.warn('V565 devolución registrada; error de correo:',error);
            showToast?.('Devolución registrada correctamente. No se pudo enviar el correo; revise la cola de notificaciones.',8000);
          }
        }
        return result;
      };
      wrappedSubmit.__v565=true;
      submitBulkReturn=wrappedSubmit;
    }
  }

  function boot(){
    try{console.info('V578 · correo de devolución · hook corregido');}catch(_){ }
    hook();
    setInterval(hook,2500);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>


<!-- =========================================================
     V566 · CORREO DESPUÉS DE CONFIRMAR DEVOLUCIÓN
     La recepción física se confirma primero. Luego Archivo puede
     enviar una constancia por correo a destinatarios autorizados.
     ========================================================= -->
<style id="v566-return-confirm-mail-style">
#v566ReturnConfirmMailModal .v566-mail-grid{display:grid;grid-template-columns:minmax(300px,.9fr) minmax(380px,1.25fr);gap:12px;margin-top:10px}
#v566ReturnConfirmMailModal .v566-mail-box{border:1px solid #d8e3ef;border-radius:10px;background:#f8fbff;padding:10px}
#v566ReturnConfirmMailModal .v566-recipient{display:flex;align-items:flex-start;gap:8px;padding:7px 8px;border-bottom:1px solid #e7eef6}
#v566ReturnConfirmMailModal .v566-recipient:last-child{border-bottom:0}
#v566ReturnConfirmMailModal .v566-recipient small{display:block;color:#64748b;margin-top:2px}
#v566ReturnConfirmMailModal .v566-subject{width:100%;box-sizing:border-box}
#v566ReturnConfirmMailModal .v566-exp-list{max-height:230px;overflow:auto;margin-top:8px}
#v566ReturnConfirmMailModal .v566-exp-row{display:grid;grid-template-columns:38px 1fr 110px 125px;gap:8px;padding:7px 8px;border-bottom:1px solid #edf2f7;font-size:12px}
#v566ReturnConfirmMailModal .v566-exp-row:last-child{border-bottom:0}
#v566ReturnConfirmMailModal .v566-ok{color:#17663f;font-weight:700}
#v566ReturnConfirmMailModal .v566-error{color:#9d2323;font-weight:700}
@media(max-width:850px){#v566ReturnConfirmMailModal .v566-mail-grid{grid-template-columns:1fr}}
</style>
<!-- V622: confirmación de recepción sin monkeypatch global de RPC + estabilidad de tarjetas -->
<script id="v566-return-confirm-mail-script">
(function(){
  'use strict';
  const VERSION='V566';
  let pendingMap=new Map();
  let pendingTimer=null;
  let activeBatch=null;
  let recipients=[];
  const v648InstalledConfirmHooks=new Set();
  let v648RecentReturnFingerprint='';
  let v648RecentReturnAt=0;

  const q=id=>document.getElementById(id);
  const txt=v=>String(v??'').trim();
  const upper=v=>txt(v).toUpperCase();
  const escLocal=v=>txt(v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const profileName=()=>txt(window.currentProfile?.nombre_personal||window.currentProfile?.nombre||window.session?.user?.email||'ARCHIVO');

  function ensureModal(){
    if(q('v566ReturnConfirmMailModal'))return;
    const div=document.createElement('div');
    div.className='modal';
    div.id='v566ReturnConfirmMailModal';
    div.setAttribute('onclick','if(event.target===this)window.v566CloseReturnConfirmMail?.()');
    div.innerHTML=`
      <div class="modal-box" style="max-width:1040px;width:95vw">
        <div class="modal-head">
          <div>
            <h2>✓ Devolución confirmada por Archivo</h2>
            <div class="note">La recepción física ya quedó registrada. El correo de confirmación se envía automáticamente; esta ventana solo se utiliza si es necesario reintentar el envío.</div>
          </div>
          <button class="btn secondary small" type="button" onclick="window.v566CloseReturnConfirmMail?.()">Cerrar</button>
        </div>

        <div class="v566-mail-grid">
          <div class="v566-mail-box">
            <b>Destinatarios autorizados</b>
            <div class="note" style="margin:4px 0 7px">Los destinatarios se determinan automáticamente según la devolución confirmada y la configuración institucional.</div>
            <div id="v566ConfirmRecipients"><div class="empty">Cargando destinatarios...</div></div>
          </div>
          <div class="v566-mail-box">
            <label style="font-weight:800;font-size:11px">ASUNTO DEL CORREO *</label>
            <input class="v566-subject" id="v566ConfirmSubject" style="margin-top:5px" />
            <div class="note" style="margin-top:8px">Automático: PARA usuario que devolvió · CC Coordinador + Armando + Jaime + quien confirma.</div>
          </div>
        </div>

        <div class="card table-wrap" style="margin-top:12px">
          <div class="table-head">
            <strong>Expedientes recibidos por Archivo</strong>
            <span id="v566ConfirmCount">0 expedientes</span>
          </div>
          <div class="v566-exp-list" id="v566ConfirmExpList"></div>
        </div>

        <div class="note" id="v566ConfirmStatus" style="margin-top:10px"></div>
        <div class="modal-foot">
          <button class="btn secondary" type="button" onclick="window.v566CloseReturnConfirmMail?.()">Cerrar</button>
          <button class="btn" id="v566ConfirmSendBtn" type="button" onclick="window.v566SendReturnConfirmMail?.()">↻ Reintentar envío de correo</button>
        </div>
      </div>`;
    document.body.appendChild(div);
  }

  function localRows(){
    const pools=[];
    try{if(Array.isArray(requestDetailRows))pools.push(...requestDetailRows);}catch(_){}
    try{if(Array.isArray(returnRequestRows))pools.push(...returnRequestRows);}catch(_){}
    try{if(Array.isArray(panelRows))pools.push(...panelRows);}catch(_){}
    try{if(Array.isArray(masterRows))pools.push(...masterRows);}catch(_){}
    try{if(Array.isArray(bulkReturnRows))pools.push(...bulkReturnRows);}catch(_){}
    return pools;
  }

  function snapshotById(id){
    const key=String(id||'');
    const r=localRows().find(x=>String(x?.expediente_id||x?.id||'')===key)||{};
    return {
      id:key,
      expediente:txt(r.expediente||r.numero_expediente||''),
      extension:txt(r.extension||r.ext||''),
      cargo:txt(r.cargo||r.cargo_numero||''),
      ultimo_folio:txt(r.ultimo_folio||''),
      responsable:txt(r.responsable_actual||r.responsable||r.ubicacion_actual||''),
      solicitud_numero:txt(r.solicitud_numero||r.numero_solicitud||'')
    };
  }

  async function completeSnapshots(items){
    const ids=[...new Set(items.map(x=>x.id).filter(Boolean))];
    if(!ids.length)return items;
    try{
      const {data,error}=await sb.from('expedientes').select('*').in('id',ids);
      if(error)throw error;
      const by=new Map((data||[]).map(x=>[String(x.id),x]));
      return items.map(x=>{
        const d=by.get(String(x.id))||{};
        return {
          ...x,
          expediente:x.expediente||txt(d.expediente||d.numero||''),
          extension:x.extension||txt(d.extension||''),
          cargo:x.cargo||txt(d.cargo||d.cargo_numero||''),
          ultimo_folio:x.ultimo_folio||txt(d.ultimo_folio||'')
        };
      });
    }catch(error){
      console.warn('V566 detalle expedientes:',error?.message||error);
      return items;
    }
  }

  async function loadRecipients(){
    recipients=[];
    const box=q('v566ConfirmRecipients');
    if(box)box.innerHTML='<div class="empty">Cargando destinatarios...</div>';
    try{
      const {data,error}=await sb.rpc('v560_listar_destinatarios_correo',{p_evento:'CONFIRMACION_DEVOLUCION'});
      if(error)throw error;
      recipients=(data||[]).filter(x=>x?.id&&x?.email);
      if(!box)return;
      if(!recipients.length){
        box.innerHTML='<div class="empty">No hay correos activos configurados por el Administrador.</div>';
        return;
      }
      box.innerHTML=recipients.map((r,i)=>{
        return `<label class="v566-recipient">
          <input type="checkbox" class="v566-recipient-check" value="${escLocal(r.id)}">
          <span><b>${escLocal(r.nombre||r.email)}</b><small>${escLocal(r.email)}${r.categoria?' · '+escLocal(r.categoria):''}</small></span>
        </label>`;
      }).join('');
      v585ApplyConfirmDefaults();
    }catch(error){
      console.warn('V566 destinatarios:',error);
      if(box)box.innerHTML=`<div class="empty">No se pudieron cargar los destinatarios: ${escLocal(error?.message||error)}</div>`;
    }
  }


  function v585ConfirmNorm(value){
    return txt(value)
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .replace(/[^A-Za-z0-9 ]+/g,' ')
      .replace(/\s+/g,' ')
      .trim()
      .toUpperCase();
  }

  function v585FindConfirmRecipientByName(name){
    const wanted=v585ConfirmNorm(name);
    if(!wanted)return null;
    const wt=wanted.split(' ').filter(x=>x.length>=2);
    let best=null,bestScore=0;
    for(const r of recipients){
      const rn=v585ConfirmNorm(r?.nombre);
      if(rn===wanted)return r;
      const rt=new Set(rn.split(' ').filter(x=>x.length>=2));
      const matches=wt.filter(t=>rt.has(t)).length;
      const score=matches/Math.max(wt.length,1);
      if(matches>=2 && score>bestScore){best=r;bestScore=score;}
    }
    return best;
  }

  function v585ApplyConfirmDefaults(){
    const box=q('v566ConfirmRecipients');
    if(!box||!recipients.length)return;

    const returnedNames=[...new Set(
      (activeBatch?.items||[])
        .map(x=>txt(x?.responsable))
        .filter(Boolean)
    )];

    const returnedRecipients=returnedNames
      .map(v585FindConfirmRecipientByName)
      .filter(Boolean);

    const coordinator=recipients.find(r=>txt(r?.email).toLowerCase()==='ds_pa_temp208@produce.gob.pe')||null;
    const armando=recipients.find(r=>txt(r?.email).toLowerCase()==='agarciag@produce.gob.pe')||null;
    const jaime=recipients.find(r=>txt(r?.email).toLowerCase()==='jgradosp@produce.gob.pe')||null;
    const confirmer=v585FindConfirmRecipientByName(profileName());

    const wanted=new Set(
      [...returnedRecipients,coordinator,armando,jaime,confirmer]
        .filter(Boolean)
        .map(r=>String(r.id))
    );
    const firstReturnedId=returnedRecipients[0]?String(returnedRecipients[0].id):'';

    box.querySelectorAll('input.v566-recipient-check').forEach(cb=>{
      const id=String(cb.value);
      if(wanted.has(id)){
        cb.checked=true;
        cb.dataset.v585Auto='1';

        // V620: usuario que devolvió = PARA; los demás destinatarios automáticos = CC.
        cb.dataset.v592Role=(firstReturnedId && id===firstReturnedId)?'TO':'CC';
        cb.dispatchEvent(new Event('change',{bubbles:true}));
      }
    });
  }

  function selectedRecipients(){
    const ids=[...document.querySelectorAll('#v566ConfirmRecipients .v566-recipient-check:checked')].map(x=>x.value);
    return recipients.filter(r=>ids.includes(String(r.id)));
  }

  function defaultSubject(batch){
    const n=batch?.items?.length||0;
    const usuarios=[...new Set((batch?.items||[]).map(x=>txt(x?.responsable)).filter(Boolean))];
    const quien=usuarios.length?usuarios.join(' / '):'USUARIO';
    const base=`Recepción confirmada de expedientes de ${quien}`;
    return n>1?`${base} - ${n} expedientes`:base;
  }

  function renderBatch(batch){
    q('v566ConfirmCount').textContent=`${batch.items.length} expediente${batch.items.length===1?'':'s'}`;
    q('v566ConfirmSubject').value=defaultSubject(batch);
    q('v566ConfirmStatus').textContent='';
    q('v566ConfirmExpList').innerHTML=batch.items.map((x,i)=>`<div class="v566-exp-row">
      <b>${i+1}.</b>
      <span><b>${escLocal(x.expediente||x.id||'Expediente')}</b>${x.extension?' · Ext. '+escLocal(x.extension):''}</span>
      <span>${x.cargo?'Cargo '+escLocal(x.cargo):'Cargo —'}</span>
      <span>${x.ultimo_folio?'Últ. folio '+escLocal(x.ultimo_folio):'Últ. folio —'}</span>
    </div>`).join('');
  }

  async function openBatch(){
    clearTimeout(pendingTimer);pendingTimer=null;
    const raw=[...pendingMap.values()];
    pendingMap.clear();
    if(!raw.length)return;
    ensureModal();
    const items=await completeSnapshots(raw);
    activeBatch={
      id:(crypto?.randomUUID?.()||(`${Date.now()}-${Math.random().toString(16).slice(2)}`)),
      items,
      confirmedBy:profileName(),
      locations:[...new Set(items.map(x=>x.location).filter(Boolean))],
      observations:[...new Set(items.map(x=>x.observation).filter(Boolean))],
      solicitudes:[...new Set(items.map(x=>x.solicitud_id).filter(Boolean))]
    };
    renderBatch(activeBatch);
    await loadRecipients();

    // V620: la confirmación física dispara el correo automáticamente.
    // La ventana solo aparece si el envío necesita reintento.
    await sendMail(true);
  }

  function queueConfirmed(args,data){
    const ids=Array.isArray(args?.p_expediente_ids)?args.p_expediente_ids:[];
    ids.forEach(id=>{
      const s=snapshotById(id);
      pendingMap.set(String(id),{
        ...s,
        id:String(id),
        solicitud_id:txt(args?.p_solicitud_id||''),
        location:txt(args?.p_ubicacion_retorno||''),
        observation:txt(args?.p_observacion||''),
        confirmed_count:Number(data?.devueltos||0)
      });
    });
    clearTimeout(pendingTimer);
    pendingTimer=setTimeout(openBatch,650);
  }

  function v621GetSupabaseClient(){
    // El sistema principal declara `let sb` en el ámbito global del documento.
    // No siempre existe `window.sb`; por eso V620 no capturaba la confirmación.
    try{
      if(typeof sb!=='undefined' && sb && typeof sb.rpc==='function')return sb;
    }catch(_){ }
    try{
      if(window.sb && typeof window.sb.rpc==='function')return window.sb;
    }catch(_){ }
    return null;
  }

  function v622NormalizeAction(value){
    return txt(value)
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .toUpperCase();
  }

  function v622CandidateIds(functionName){
    try{
      if(functionName==='confirmSelectedReturnRequests'){
        return [...new Set((returnRequestRows||[])
          .filter(r=>returnRequestSelectedKeys?.has?.(returnRequestKey(r)))
          .map(r=>String(r?.expediente_id||'')).filter(Boolean))];
      }
      if(functionName==='confirmReturnItems'){
        return [...new Set([...(requestSelectedIds||new Set())].map(String).filter(Boolean))];
      }
      if(functionName==='confirmPanelBulkReturns' || functionName==='confirmMasterBulkReturns'){
        return [...new Set([...(selectedIds||new Set())].map(String).filter(Boolean))];
      }
    }catch(error){
      console.warn('V622 candidatos confirmación:',error?.message||error);
    }
    return [];
  }

  async function v622ConfirmedMovements(ids,startedAt){
    const unique=[...new Set((ids||[]).map(String).filter(Boolean))];
    if(!unique.length)return [];
    try{
      const client=v621GetSupabaseClient();
      if(!client)return [];
      const since=new Date(Math.max(0,Number(startedAt||Date.now())-2500)).toISOString();
      const {data,error}=await client
        .from('movimientos_prestamo')
        .select('solicitud_id,expediente_id,expediente,desde,hacia,accion,created_at')
        .in('expediente_id',unique)
        .gte('created_at',since)
        .order('created_at',{ascending:false});
      if(error)throw error;
      const seen=new Set();
      return (data||[]).filter(row=>{
        const action=v622NormalizeAction(row?.accion);
        if(!(action.includes('DEVOLUCION CONFIRMADA')||action.includes('RECIBIDO EN ARCHIVO')))return false;
        const id=String(row?.expediente_id||'');
        if(!id||seen.has(id))return false;
        seen.add(id);
        return true;
      });
    }catch(error){
      console.warn('V622 verificación post recepción:',error?.message||error);
      return [];
    }
  }

  function v622QueueConfirmedMovements(movements){
    for(const m of (movements||[])){
      const id=String(m?.expediente_id||'');
      if(!id)continue;
      const s=snapshotById(id);
      pendingMap.set(id,{
        ...s,
        id,
        expediente:s.expediente||txt(m?.expediente||''),
        solicitud_id:txt(m?.solicitud_id||''),
        responsable:txt(m?.desde||s.responsable||''),
        location:txt(m?.hacia||''),
        observation:'',
        confirmed_count:1
      });
    }
    if(!pendingMap.size)return;
    clearTimeout(pendingTimer);
    pendingTimer=setTimeout(openBatch,500);
  }

  function v622WrapConfirmFunction(name){
    if(v648InstalledConfirmHooks.has(name))return false;
    const original=window[name];
    if(typeof original!=='function')return false;
    const wrapped=async function(){
      const candidateIds=v622CandidateIds(name);
      const startedAt=Date.now();
      const result=await original.apply(this,arguments);
      try{
        if(candidateIds.length){
          const confirmed=await v622ConfirmedMovements(candidateIds,startedAt);
          if(confirmed.length)v622QueueConfirmedMovements(confirmed);
        }
      }catch(error){
        console.warn('V622 correo post recepción:',error?.message||error);
      }
      return result;
    };
    wrapped.__v622ConfirmMailWrapped=true;
    wrapped.__v622Original=original;
    window[name]=wrapped;
    v648InstalledConfirmHooks.add(name);
    return true;
  }

  function installConfirmationHooks(){
    const names=[
      'confirmSelectedReturnRequests',
      'confirmReturnItems',
      'confirmPanelBulkReturns',
      'confirmMasterBulkReturns'
    ];
    let installed=0;
    names.forEach(name=>{if(v622WrapConfirmFunction(name))installed+=1;});
    return installed;
  }

  function buildBody(batch,selected){
    const lines=[];
    lines.push('Archivo confirmó la recepción física de la devolución en el Sistema de Control y Trazabilidad de Expedientes.','');
    lines.push(`Confirmado por: ${batch.confirmedBy||'ARCHIVO'}`);
    if(batch.locations.length)lines.push(`Ubicación de retorno: ${batch.locations.join(' / ')}`);
    lines.push(`Cantidad de expedientes: ${batch.items.length}`);
    lines.push('Estado final: DEVUELTO AL ARCHIVO','');
    lines.push('Destinatarios notificados:');
    selected.forEach((r,i)=>lines.push(`${i+1}. ${r.nombre||r.email} <${r.email}>`));
    lines.push('','Expedientes:');
    batch.items.forEach((x,i)=>{
      let row=`${i+1}. ${x.expediente||x.id||'Expediente'}`;
      if(x.extension)row+=` · Ext. ${x.extension}`;
      if(x.cargo)row+=` · Cargo ${x.cargo}`;
      if(x.ultimo_folio)row+=` · Último folio ${x.ultimo_folio}`;
      if(x.responsable)row+=` · Devuelto por ${x.responsable}`;
      lines.push(row);
    });
    if(batch.observations.length)lines.push('',`Observación de recepción: ${batch.observations.join(' / ')}`);
    lines.push('','La custodia física de los expedientes ha sido confirmada por Archivo.');
    return lines.join('\n');
  }

  function v648ReturnFingerprint(batch){
    const ids=[...new Set((batch?.items||[]).map(x=>String(x?.id||x?.expediente||'').trim()).filter(Boolean))].sort();
    const solicitudes=[...new Set((batch?.solicitudes||[]).map(x=>String(x||'').trim()).filter(Boolean))].sort();
    const responsables=[...new Set((batch?.items||[]).map(x=>txt(x?.responsable)).filter(Boolean))].sort();
    return [ids.join('|'),solicitudes.join('|'),responsables.join('|'),txt(batch?.confirmedBy),[...(batch?.locations||[])].sort().join('|')].join('::');
  }

  async function sendMail(auto=false){
    if(!activeBatch)return;
    const status=q('v566ConfirmStatus');
    const btn=q('v566ConfirmSendBtn');
    const selected=selectedRecipients();
    const subject=txt(q('v566ConfirmSubject')?.value);
    if(!selected.length){
      const msg='No se pudo determinar ningún destinatario para el correo de confirmación.';
      if(status){status.className='note v566-error';status.textContent=msg;}
      if(auto){
        q('v566ReturnConfirmMailModal')?.classList.add('show');
        window.showToast?.('La recepción quedó confirmada. Revise los destinatarios del correo.',7500);
      }
      return;
    }
    if(!subject){
      const msg='No se pudo generar el asunto del correo de confirmación.';
      if(status){status.className='note v566-error';status.textContent=msg;}
      if(auto){
        q('v566ReturnConfirmMailModal')?.classList.add('show');
        window.showToast?.('La recepción quedó confirmada. El correo requiere revisión.',7500);
      }
      return;
    }
    const v648Fingerprint=v648ReturnFingerprint(activeBatch);
    const v648Now=Date.now();
    if(v648Fingerprint && v648RecentReturnFingerprint===v648Fingerprint && (v648Now-v648RecentReturnAt)<45000){
      if(status){status.className='note v566-ok';status.textContent='La confirmación ya fue procesada. Se evitó un correo duplicado.';}
      try{console.info('V648 · correo duplicado de devolución bloqueado en navegador',v648Fingerprint);}catch(_){ }
      return {ok:true,encoladas:0,duplicada_bloqueada:true};
    }

    v648RecentReturnFingerprint=v648Fingerprint;
    v648RecentReturnAt=v648Now;

    if(btn)btn.disabled=true;
    if(status){status.className='note';status.textContent=auto?'Encolando correo automático de confirmación...':'Preparando y enviando correo...';}
    try{
      const body=buildBody(activeBatch,selected);
      const {data,error}=await sb.rpc('v566_encolar_correo_devolucion_confirmada',{
        p_referencia_id:activeBatch.id,
        p_asunto_correo:subject,
        p_cuerpo:body,
        p_destinatario_ids:selected.map(x=>x.id),
        p_metadata:{
          origen:'V622_HTML_AUTO',
          confirmado_por:activeBatch.confirmedBy,
          devuelto_por:txt(activeBatch.items?.[0]?.responsable||''),
          usuario_devolucion:txt(activeBatch.items?.[0]?.responsable||''),
          usuarios_que_devolvieron:[...new Set((activeBatch.items||[]).map(x=>txt(x?.responsable)).filter(Boolean))],
          cantidad_expedientes:activeBatch.items.length,
          ubicaciones_retorno:activeBatch.locations,
          solicitudes:activeBatch.solicitudes,
          expedientes:activeBatch.items,
          destinatarios_detalle:selected.map(x=>({id:x.id,nombre:x.nombre,email:x.email,categoria:x.categoria}))
        }
      });
      if(error)throw error;

      const queued=Number(data?.encoladas||0);
      const duplicateBlocked=!!data?.duplicada_bloqueada;

      // V648: solo iniciar drenaje si realmente se creó una nueva cola.
      if(queued>0){
        window.v586DrainMailInBackground?.('V648_V566_HTML');
      }

      if(status){
        status.className='note v566-ok';
        status.textContent=duplicateBlocked
          ? 'La confirmación ya había sido procesada. Se evitó un correo duplicado.'
          : queued>0
            ? 'Devolución confirmada. El correo se está enviando en segundo plano.'
            : 'Devolución confirmada.';
      }
      window.showToast?.(
        duplicateBlocked
          ? 'Devolución confirmada · correo duplicado evitado.'
          : queued>0
            ? 'Devolución confirmada · correo en proceso de envío.'
            : 'Devolución confirmada.',
        5500
      );
      setTimeout(()=>window.v566CloseReturnConfirmMail?.(),700);
      return data;
    }catch(error){
      if(v648RecentReturnFingerprint===v648Fingerprint){
        v648RecentReturnFingerprint='';
        v648RecentReturnAt=0;
      }
      console.warn('V622 envío automático de confirmación:',error);
      if(status){status.className='note v566-error';status.textContent='La devolución ya está confirmada, pero no se pudo preparar el correo: '+(error?.message||error);}
      if(auto){
        q('v566ReturnConfirmMailModal')?.classList.add('show');
      }
      window.showToast?.('La devolución está confirmada. El correo requiere reintento.',7500);
    }finally{if(btn)btn.disabled=false;}
  }

  window.v566CloseReturnConfirmMail=function(){q('v566ReturnConfirmMailModal')?.classList.remove('show');activeBatch=null;};
  window.v566SendReturnConfirmMail=sendMail;

  function boot(){
    ensureModal();
    installConfirmationHooks();
    const timer=setInterval(()=>{
      installConfirmationHooks();
    },1200);
    setTimeout(()=>clearInterval(timer),12000);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>



<!-- V568: buscador manual de destinatarios para solicitudes, reasignaciones y devoluciones -->
<style id="v568-recipient-search-style">
.v568-recipient-tools{display:flex;align-items:center;gap:8px;margin:0 0 8px 0;flex-wrap:wrap}
.v568-recipient-search{flex:1 1 280px;min-width:220px;height:36px;border:1px solid #cbd8e6;border-radius:8px;padding:0 11px;font-size:12px;background:#fff;color:#173b61;outline:none}
.v568-recipient-search:focus{border-color:#2d6ca2;box-shadow:0 0 0 2px rgba(45,108,162,.10)}
.v568-recipient-count{font-size:11px;font-weight:800;color:#315b82;white-space:nowrap}
.v568-recipient-clear{height:34px;padding:0 10px;border:1px solid #cbd8e6;border-radius:8px;background:#fff;color:#315b82;font-size:11px;font-weight:800;cursor:pointer}
.v568-recipient-clear:hover{background:#f4f8fc}
.v568-no-results{display:none;padding:9px 10px;border:1px dashed #c8d6e5;border-radius:8px;color:#64748b;font-size:11px;background:#f8fbff;margin-top:6px}
.v568-recipient-tools + .v560-recipient-list,
.v568-recipient-tools + #v566ConfirmRecipients{margin-top:0}
</style>
<script id="v568-recipient-search-script">
(function(){
  'use strict';
  const CONFIGS=[
    {id:'v560RequestMailRecipients', selector:'input[data-v560-recipient]'},
    {id:'v560ReassignMailRecipients', selector:'input[data-v560-recipient]'},
    {id:'v565ReturnMailRecipients', selector:'input[data-v565-recipient]'},
    {id:'v566ConfirmRecipients', selector:'input.v566-recipient-check'}
  ];
  const norm=v=>String(v??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();

  function recipientRows(box){
    return [...box.querySelectorAll('label.v560-recipient-item, label.v566-recipient')];
  }
  function checks(box,cfg){return [...box.querySelectorAll(cfg.selector)]}

  function updateCount(box,cfg){
    const tools=box.previousElementSibling;
    if(!tools?.classList?.contains('v568-recipient-tools'))return;
    const n=checks(box,cfg).filter(x=>x.checked).length;
    const count=tools.querySelector('.v568-recipient-count');
    if(count)count.textContent=`${n} seleccionado${n===1?'':'s'}`;
  }

  function v594RecipientMatch(row,term){
    if(!term)return true;

    const nameEl=row.querySelector('b');
    const smallEl=row.querySelector('small');

    const name=norm(nameEl?.textContent||'');
    const email=norm((smallEl?.textContent||'').split('·')[0]||'');

    const nameTokens=name.split(/\s+/).filter(Boolean);
    const queryTokens=term.split(/\s+/).filter(Boolean);

    // Cada bloque escrito debe coincidir con el inicio de algún nombre/apellido.
    // Ej.: "ar" -> Armando; "gar" -> García; "ar gar" -> Armando García.
    const byName=queryTokens.length>0 &&
      queryTokens.every(q=>nameTokens.some(token=>token.startsWith(q)));

    // El correo mantiene búsqueda parcial normal.
    const byEmail=email.includes(term);

    return byName || byEmail;
  }

  function applyFilter(box){
    const tools=box.previousElementSibling;
    if(!tools?.classList?.contains('v568-recipient-tools'))return;
    const input=tools.querySelector('.v568-recipient-search');
    const term=norm(input?.value);
    let visible=0;

    recipientRows(box).forEach(row=>{
      const show=v594RecipientMatch(row,term);

      // V594: el estilo unificado usa display:grid !important.
      // El filtro debe aplicar la misma prioridad para poder ocultar filas.
      row.style.setProperty('display',show?'grid':'none','important');

      if(show)visible++;
    });

    let empty=tools.nextElementSibling===box ? box.nextElementSibling : null;
    if(!empty?.classList?.contains('v568-no-results')){
      empty=document.createElement('div');
      empty.className='v568-no-results';
      empty.textContent='No se encontraron destinatarios por nombre, apellido o correo.';
      box.insertAdjacentElement('afterend',empty);
    }
    empty.style.display=(term && visible===0)?'block':'none';
  }

  function resetManualSelection(box,cfg){
    // V585: conservar destinatarios predeterminados de cada flujo.
    // El buscador solo filtra y actualiza el contador.
    updateCount(box,cfg);
    applyFilter(box);
  }

  function enhance(cfg){
    const box=document.getElementById(cfg.id);
    if(!box)return;
    if(!box.dataset.v568Enhanced){
      const tools=document.createElement('div');
      tools.className='v568-recipient-tools';
      tools.innerHTML=`
        <input class="v568-recipient-search" type="search" autocomplete="off" placeholder="Buscar por nombre, apellido o correo..." aria-label="Buscar destinatario">
        <span class="v568-recipient-count">0 seleccionados</span>
        <button class="v568-recipient-clear" type="button">Quitar selección</button>`;
      box.insertAdjacentElement('beforebegin',tools);
      tools.querySelector('.v568-recipient-search')?.addEventListener('input',()=>applyFilter(box));
      tools.querySelector('.v568-recipient-clear')?.addEventListener('click',()=>{
        checks(box,cfg).forEach(x=>x.checked=false);
        updateCount(box,cfg);
      });
      box.addEventListener('change',e=>{
        if(e.target?.matches?.(cfg.selector))updateCount(box,cfg);
      });
      box.dataset.v568Enhanced='1';
      resetManualSelection(box,cfg);

      const obs=new MutationObserver(muts=>{
        if(!muts.some(m=>m.type==='childList'))return;
        requestAnimationFrame(()=>resetManualSelection(box,cfg));
      });
      obs.observe(box,{childList:true,subtree:false});
    }
  }

  function enhanceAll(){CONFIGS.forEach(enhance)}
  const bodyObs=new MutationObserver(()=>enhanceAll());
  function boot(){
    enhanceAll();
    bodyObs.observe(document.body,{childList:true,subtree:true});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});
  else boot();
})();
</script>

