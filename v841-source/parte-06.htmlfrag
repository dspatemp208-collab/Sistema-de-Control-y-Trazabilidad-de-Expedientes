<script id="v595-conas-mail-script">
(function(){
  'use strict';

  const COORD_EMAIL='ds_pa_temp208@produce.gob.pe';
  const DEFAULT_ARCHIVO_EMAILS=[
    'agarciag@produce.gob.pe',
    'jgradosp@produce.gob.pe'
  ];

  let recipients=[];
  let ownId='';
  let loaded=false;
  let loading=false;

  const $=id=>document.getElementById(id);
  const clean=v=>String(v??'').trim();
  const lower=v=>clean(v).toLowerCase();
  const upper=v=>clean(v).toUpperCase();
  const escLocal=v=>String(v??'').replace(/[&<>"]/g,c=>({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'
  }[c]));

  function normName(value){
    return clean(value)
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .replace(/[^A-Za-z0-9 ]+/g,' ')
      .replace(/\s+/g,' ')
      .trim()
      .toUpperCase();
  }

  function currentActorName(){
    return clean(currentProfile?.nombre_personal||currentProfile?.nombre||'');
  }

  function selectedRows(){
    const ids=[...document.querySelectorAll(
      '#v595ConasMailRecipients input[data-v595-recipient]:checked'
    )].map(x=>String(x.value));

    return ids
      .map(id=>recipients.find(r=>String(r.id)===id))
      .filter(Boolean);
  }

  function roleFor(r){
    return lower(r?.email)===COORD_EMAIL ? 'TO' : 'CC';
  }

  function renderSelected(){
    const selected=selectedRows().sort((a,b)=>{
      const ar=roleFor(a)==='TO'?0:1;
      const br=roleFor(b)==='TO'?0:1;
      return ar-br;
    });

    const count=`${selected.length} seleccionado${selected.length===1?'':'s'}`;
    if($('v595ConasMailCount'))$('v595ConasMailCount').textContent=count;
    if($('v595ConasMailSelectedCount'))$('v595ConasMailSelectedCount').textContent=count;

    const box=$('v595ConasMailSelected');
    if(!box)return;

    if(!selected.length){
      box.innerHTML='<div class="note">Aún no hay destinatarios seleccionados.</div>';
      return;
    }

    box.innerHTML=selected.map(r=>{
      const id=String(r.id);
      const role=roleFor(r);
      const isActor=ownId && id===ownId;

      return `<div class="v595-mail-selected-item">
        <div>
          <b>
            <span>${escLocal(r.nombre||r.email)}</span>
            <span class="v595-mail-role ${role==='TO'?'v595-mail-role-to':'v595-mail-role-cc'}">${role==='TO'?'PARA':'CC'}</span>
            ${isActor?'<span class="v595-mail-role v595-mail-role-actor">QUIEN DERIVA</span>':''}
          </b>
          <small>${escLocal(r.email||'')}</small>
        </div>
        <button type="button" class="v595-mail-remove"
                data-v595-remove="${escLocal(id)}" title="Quitar">×</button>
      </div>`;
    }).join('');
  }

  function matchesSearch(row,raw){
    if(!raw)return true;

    const normalized=normName(raw);
    const queryTokens=normalized.split(/\s+/).filter(Boolean);

    const name=normName(row.querySelector('b')?.textContent||'');
    const nameTokens=name.split(/\s+/).filter(Boolean);

    const email=upper(
      (row.querySelector('small')?.textContent||'').split('·')[0]||''
    );

    const byName=queryTokens.length>0 &&
      queryTokens.every(q=>nameTokens.some(token=>token.startsWith(q)));

    const byEmail=email.includes(upper(raw));

    return byName||byEmail;
  }

  function applySearch(){
    const raw=clean($('v595ConasMailSearch')?.value);

    document.querySelectorAll(
      '#v595ConasMailRecipients .v595-mail-recipient'
    ).forEach(row=>{
      const visible=matchesSearch(row,raw);
      row.style.setProperty(
        'display',
        visible?'grid':'none',
        'important'
      );
    });
  }

  function defaultSubject(){
    const actor=clean(currentProfile?.nombre_personal||currentProfile?.email)||'USUARIO';
    const memo=clean($('bulkConasMemo')?.value);
    const base=`Derivación al CONAS de ${actor}`;
    return memo?`${base} - Memorando: ${memo}`:base;
  }

  function applyDefaults(){
    const box=$('v595ConasMailRecipients');
    if(!box)return;

    const defaults=new Set();

    for(const r of recipients){
      const mail=lower(r?.email);
      if(mail===COORD_EMAIL || DEFAULT_ARCHIVO_EMAILS.includes(mail)){
        defaults.add(String(r.id));
      }
    }

    if(ownId)defaults.add(String(ownId));

    box.querySelectorAll('input[data-v595-recipient]').forEach(cb=>{
      cb.checked=defaults.has(String(cb.value));
    });

    renderSelected();
  }

  function renderRecipients(){
    const box=$('v595ConasMailRecipients');
    if(!box)return;

    if(!recipients.length){
      box.innerHTML='<div class="note" style="padding:8px">No hay correos activos configurados por el Administrador.</div>';
      renderSelected();
      return;
    }

    box.innerHTML=recipients.map(r=>`
      <label class="v595-mail-recipient">
        <input type="checkbox" data-v595-recipient
               value="${escLocal(r.id)}"
               data-email="${escLocal(r.email)}"
               data-name="${escLocal(r.nombre)}">
        <span>
          <b>${escLocal(r.nombre||r.email)}</b>
          <small>${escLocal(r.email)}${r.categoria?' · '+escLocal(r.categoria):''}</small>
        </span>
      </label>
    `).join('');

    box.querySelectorAll('input[data-v595-recipient]').forEach(cb=>{
      cb.addEventListener('change',renderSelected);
    });

    applyDefaults();
    applySearch();
  }

  async function loadRecipients(force=false){
    if(loading)return;
    if(loaded&&!force){
      renderRecipients();
      return;
    }

    loading=true;
    try{
      const [listResult,ownResult]=await Promise.all([
        sb.rpc('v560_listar_destinatarios_correo',{p_evento:'SOLICITUD'}),
        sb.rpc('v580_mi_destinatario_correo')
      ]);

      if(listResult.error)throw listResult.error;

      recipients=(Array.isArray(listResult.data)?listResult.data:[])
        .filter(r=>r?.id&&r?.email&&r?.activo!==false);

      const ownRow=Array.isArray(ownResult.data)
        ? ownResult.data[0]
        : ownResult.data;

      ownId=String(
        ownRow?.destinatario_id ||
        ownRow?.id ||
        ''
      );

      loaded=true;
      renderRecipients();

      const status=$('v595ConasMailStatus');
      if(status){
        status.textContent=ownId
          ? `Predeterminados cargados. ${currentActorName()||'El usuario actual'} figura como QUIEN DERIVA.`
          : 'Predeterminados cargados. El usuario actual no tiene un correo de notificación vinculado.';
      }
    }catch(error){
      console.warn('V595 · destinatarios CONAS:',error);
      const box=$('v595ConasMailRecipients');
      if(box){
        box.innerHTML=`<div class="note" style="padding:8px">No se pudo cargar el catálogo: ${escLocal(error?.message||error)}</div>`;
      }
    }finally{
      loading=false;
    }
  }

  function prepare(){
    if($('v595ConasMailEnabled'))$('v595ConasMailEnabled').checked=true;
    if($('v595ConasMailSearch'))$('v595ConasMailSearch').value='';
    if($('v595ConasMailSubject'))$('v595ConasMailSubject').value=defaultSubject();
    if($('v595ConasMailStatus'))$('v595ConasMailStatus').textContent='';
    loadRecipients(true);
  }

  function capture(observation){
    if(!$('v595ConasMailEnabled')?.checked)return null;

    const selected=selectedRows();
    if(!selected.length)return null;

    const rows=Array.isArray(window.bulkConasRows)
      ? window.bulkConasRows
      : (typeof bulkConasRows!=='undefined' ? bulkConasRows : []);

    if(!rows.length)return null;

    const operationId=crypto?.randomUUID?.()||
      `${Date.now()}-${Math.random().toString(16).slice(2)}`;

    return {
      operationId,
      subject:clean($('v595ConasMailSubject')?.value)||defaultSubject(),
      observation:clean(observation),
      actorName:currentActorName(),
      recipients:selected.map(r=>({
        id:r.id,
        nombre:r.nombre,
        email:r.email,
        categoria:r.categoria
      })),
      items:rows.map(r=>({
        id:r.id,
        expediente:clean(r.expediente),
        extension:clean(r.extension),
        rd:clean(r.rd),
        ultimo_folio:clean(r.ultimo_folio),
        responsable_actual:clean(r.responsable),
        cargo:clean(r.cargo)
      }))
    };
  }

  function bodyFor(draft){
    const lines=[
      'Se comunica la derivación de expediente(s) al Consejo de Apelación de Sanciones (CONAS), conforme al movimiento registrado en el Sistema de Control y Trazabilidad de Expedientes.',
      '',
      `Derivado por: ${draft.actorName||'USUARIO DEL SISTEMA'}`,
      `Cantidad de expedientes: ${draft.items.length}`,
      ...(draft.observation?[
        `Observación: ${draft.observation}`
      ]:[]),
      '',
      'Expedientes:'
    ];

    draft.items.forEach((r,i)=>{
      lines.push(
        `${i+1}. ${r.expediente||'—'}${r.extension?` · Ext. ${r.extension}`:''}${r.rd?` · R.D. ${r.rd}`:''}${r.ultimo_folio?` · Último folio ${r.ultimo_folio}`:''}`
      );
    });

    lines.push(
      '',
      'Este correo tiene carácter de comunicación. La derivación fue registrada previamente en el sistema.'
    );

    return lines.join('\n');
  }

  async function send(draft){
    if(!draft)return;

    try{
      const {data,error}=await sb.rpc('v590_encolar_comunicacion_conas',{
        p_operacion_id:draft.operationId,
        p_asunto_correo:draft.subject,
        p_cuerpo:bodyFor(draft),
        p_destinatario_ids:draft.recipients.map(r=>r.id),
        p_metadata:{
          origen:'V595_HTML',
          evento:'COMUNICACION_CONAS',
          destino:'CONAS',
          derivado_por:draft.actorName||null,
          seleccionado_por:session?.user?.id||currentProfile?.id||null,
          observacion:draft.observation||null,
          cantidad_expedientes:draft.items.length,
          expedientes:draft.items,
          destinatarios_detalle:draft.recipients
        }
      });

      if(error)throw error;

      const queued=Number(data?.encoladas||0);

      // El correo no bloquea la derivación.
      window.v586DrainMailInBackground?.('V595_COMUNICACION_CONAS');

      if(queued>0){
        window.showToast?.(
          'Derivación registrada · comunicación por correo en proceso de envío.',
          5500
        );
      }
    }catch(error){
      console.warn('V595 · comunicación CONAS:',error);
      window.showToast?.(
        'La derivación al CONAS quedó registrada, pero no se pudo encolar la comunicación: '+
        (error?.message||error),
        8000
      );
    }
  }

  function clearSelection(){
    document.querySelectorAll(
      '#v595ConasMailRecipients input[data-v595-recipient]'
    ).forEach(cb=>cb.checked=false);
    renderSelected();
  }

  function bind(){
    $('v595ConasMailSearch')?.addEventListener('input',applySearch);
    $('v595ConasMailClear')?.addEventListener('click',clearSelection);

    $('v595ConasMailSelected')?.addEventListener('click',ev=>{
      const btn=ev.target?.closest?.('[data-v595-remove]');
      if(!btn)return;

      const id=String(btn.dataset.v595Remove||'');
      const cb=document.querySelector(
        `#v595ConasMailRecipients input[data-v595-recipient][value="${CSS.escape(id)}"]`
      );

      if(cb){
        cb.checked=false;
        renderSelected();
      }
    });

    $('v595ConasMailEnabled')?.addEventListener('change',()=>{
      const on=$('v595ConasMailEnabled')?.checked!==false;
      ['v595ConasMailSearch','v595ConasMailSubject','v595ConasMailClear']
        .forEach(id=>{
          if($(id))$(id).disabled=!on;
        });

      const box=$('v595ConasMailRecipients');
      if(box)box.style.opacity=on?'1':'.55';
    });
  }

  window.v595PrepareConasMail=prepare;
  window.v595CaptureConasMailDraft=capture;
  window.v595SendConasCommunication=send;

  function boot(){
    bind();
    try{
      console.info('V595 · comunicación por correo para derivación al CONAS activada');
    }catch(_){}
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',boot,{once:true});
  }else{
    boot();
  }
})();
</script>


<style id="v596-derivation-mail-style">
#v595ConasMailPanel{display:none!important}
.v596-deriv-mail{margin-top:12px;padding:12px;border:1px solid #cbd9e8;border-radius:10px;background:#f8fbff}
.v596-deriv-mail *{box-sizing:border-box}
.v596-mail-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:8px}
.v596-mail-head strong{font-size:15px;color:#0b3565}
.v596-mail-toggle{display:flex!important;align-items:center;gap:7px;width:auto!important;margin:0!important;font-size:12px!important;font-weight:800!important}
.v596-mail-toggle input{width:17px!important;height:17px!important;margin:0!important}
.v596-mail-note{padding:8px 10px;border:1px solid #dbe6f1;border-radius:8px;background:#fff;font-size:10px;line-height:1.4;color:#516b86;margin-bottom:10px}
.v596-mail-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.12fr);gap:12px;align-items:start}
.v596-mail-grid label{display:block;margin:0 0 5px;font-size:9px;font-weight:800;text-transform:uppercase;color:#536d89}
.v596-mail-tools{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center}
.v596-mail-tools input,.v596-mail-subject{width:100%;min-width:0;height:38px;padding:7px 10px;border:1px solid #b9cbe0;border-radius:8px;background:#fff;font-size:12px;color:#173a5e}
.v596-mail-count{font-size:10px;font-weight:850;color:#173f6b;white-space:nowrap}
.v596-recipient-list{margin-top:7px;max-height:195px;overflow:auto;border:1px solid #d7e1ec;border-radius:8px;background:#fff}
.v596-recipient{display:grid;grid-template-columns:20px minmax(0,1fr);gap:8px;align-items:center;padding:8px 9px;border-bottom:1px solid #edf2f7;cursor:pointer}
.v596-recipient:last-child{border-bottom:0}.v596-recipient:hover{background:#f5f9fd}
.v596-recipient input{width:15px!important;height:15px!important;margin:0!important}
.v596-recipient b{display:block;font-size:11px;color:#123d6b}.v596-recipient small{display:block;font-size:9px;color:#58708a;margin-top:2px}
.v596-selected-box{margin-top:8px;border:1px solid #d7e1ec;border-radius:8px;background:#fff;overflow:hidden}
.v596-selected-head{display:flex;justify-content:space-between;gap:8px;padding:8px 10px;background:#edf5fb;border-bottom:1px solid #d7e1ec;font-size:9px;color:#234d77}
.v596-selected-list{display:grid;gap:6px;padding:7px;max-height:195px;overflow:auto}
.v596-selected-item{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:7px 8px;border:1px solid #dbe5ef;border-radius:7px}
.v596-selected-item b{display:flex;align-items:center;gap:5px;flex-wrap:wrap;font-size:10px;color:#173f6b}.v596-selected-item small{display:block;font-size:9px;color:#5c7188}
.v596-badge{display:inline-flex;padding:1px 6px;border-radius:999px;font-size:8px;font-weight:900}
.v596-to{background:#e7f1ff;border:1px solid #9fc4f2;color:#0b4f91}.v596-cc{background:#f3f5f7;border:1px solid #cbd5df;color:#425466}.v596-actor{background:#eef6ff;border:1px solid #b8d4ee;color:#245d8d}
.v596-remove{width:28px;height:28px;padding:0;border:1px solid #d4deea;border-radius:7px;background:#fff;color:#355474;cursor:pointer}
@media(max-width:820px){.v596-mail-grid{grid-template-columns:1fr}}
</style>


<script id="v596-memo-live-validation">
(function(){
  function bind(id,fn){
    const x=document.getElementById(id);
    if(x&&x.dataset.v596Bound!=='1'){
      x.dataset.v596Bound='1';
      x.addEventListener('input',()=>{try{window[fn]?.()}catch(_){}});
    }
  }
  function boot(){
    bind('bulkConasMemo','syncBulkConasState');
    bind('bulkDvcMemo','syncBulkDvcState');
    bind('bulkInstructionMemo','syncBulkInstructionState');
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>


<script id="v596-derivation-mail-module">
(function(){
  'use strict';
  const COORD='ds_pa_temp208@produce.gob.pe';
  const ARCHIVO=['agarciag@produce.gob.pe','jgradosp@produce.gob.pe'];
  const flows={
    CONAS:{table:'bulkConasTable',memo:'bulkConasMemo',obs:'bulkConasObservation',rows:()=>typeof bulkConasRows!=='undefined'?bulkConasRows:[]},
    DVC:{table:'bulkDvcTable',memo:'bulkDvcMemo',obs:'bulkDvcObservation',rows:()=>typeof bulkDvcRows!=='undefined'?bulkDvcRows:[]},
    INSTRUCCION:{table:'bulkInstructionTable',memo:'bulkInstructionMemo',obs:'bulkInstructionObservation',rows:()=>typeof bulkInstructionRows!=='undefined'?bulkInstructionRows:[]}
  };
  const states={};
  const clean=v=>String(v??'').trim();
  const lower=v=>clean(v).toLowerCase();
  const upper=v=>clean(v).toUpperCase();
  const norm=v=>clean(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^A-Za-z0-9 ]+/g,' ').replace(/\s+/g,' ').trim().toUpperCase();
  const esc=v=>String(v??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const label=d=>d==='INSTRUCCION'?'Instrucción':d;

  function ids(dest){const p='v596'+dest[0]+dest.slice(1).toLowerCase();return {panel:p+'Mail',enabled:p+'Enabled',search:p+'Search',count:p+'Count',recips:p+'Recipients',subject:p+'Subject',selected:p+'Selected',selectedCount:p+'SelectedCount',status:p+'Status'}}

  function ensurePanel(dest){
    const f=flows[dest],i=ids(dest); if(document.getElementById(i.panel))return;
    const table=document.getElementById(f.table), foot=table?.parentElement?.querySelector('.modal-foot'); if(!foot)return;
    const sec=document.createElement('section');sec.className='v596-deriv-mail';sec.id=i.panel;
    sec.innerHTML=`<div class="v596-mail-head"><strong>✉ Comunicación por correo</strong><label class="v596-mail-toggle"><input id="${i.enabled}" type="checkbox" checked><span>Enviar correo</span></label></div>
      <div class="v596-mail-note"><b>PARA:</b> Coordinador de Archivo · <b>CC:</b> Armando + Jaime + quien deriva + adicionales. El correo es solo comunicación.</div>
      <div class="v596-mail-grid"><div><label>Destinatarios autorizados</label><div class="v596-mail-tools"><input id="${i.search}" placeholder="Buscar por nombre, apellido o correo..."><span class="v596-mail-count" id="${i.count}">0 seleccionados</span></div><div class="v596-recipient-list" id="${i.recips}"></div></div>
      <div><label>Asunto del correo *</label><input class="v596-mail-subject" id="${i.subject}"><div class="v596-selected-box"><div class="v596-selected-head"><b>DESTINATARIOS SELECCIONADOS</b><span id="${i.selectedCount}">0 seleccionados</span></div><div class="v596-selected-list" id="${i.selected}"></div></div></div></div>
      <div class="note" id="${i.status}" style="margin-top:8px"></div>`;
    foot.parentElement.insertBefore(sec,foot); bind(dest);
  }

  function selected(dest){const s=states[dest]||{},i=ids(dest),box=document.getElementById(i.recips);if(!box)return [];return [...box.querySelectorAll('input[data-v596-recipient]:checked')].map(cb=>s.recipients?.find(r=>String(r.id)===String(cb.value))).filter(Boolean)}
  function renderSelected(dest){
    const s=states[dest]||{},i=ids(dest),list=document.getElementById(i.selected),arr=selected(dest); const c=`${arr.length} seleccionado${arr.length===1?'':'s'}`;
    if(document.getElementById(i.count))document.getElementById(i.count).textContent=c;if(document.getElementById(i.selectedCount))document.getElementById(i.selectedCount).textContent=c;if(!list)return;
    if(!arr.length){list.innerHTML='<div class="note">Aún no hay destinatarios seleccionados.</div>';return}
    arr.sort((a,b)=>(lower(a.email)===COORD?0:1)-(lower(b.email)===COORD?0:1));
    list.innerHTML=arr.map(r=>{const to=lower(r.email)===COORD,actor=s.ownId&&String(r.id)===String(s.ownId);return `<div class="v596-selected-item"><div><b><span>${esc(r.nombre||r.email)}</span><span class="v596-badge ${to?'v596-to':'v596-cc'}">${to?'PARA':'CC'}</span>${actor?'<span class="v596-badge v596-actor">QUIEN DERIVA</span>':''}</b><small>${esc(r.email)}</small></div><button class="v596-remove" type="button" data-remove="${esc(r.id)}">×</button></div>`}).join('')
  }
  function applySearch(dest){const i=ids(dest),q=norm(document.getElementById(i.search)?.value),qt=q.split(/\s+/).filter(Boolean);document.querySelectorAll('#'+i.recips+' .v596-recipient').forEach(row=>{const nt=norm(row.querySelector('b')?.textContent).split(/\s+/).filter(Boolean),mail=upper((row.querySelector('small')?.textContent||'').split('·')[0]||'');const show=!q||(qt.length&&qt.every(x=>nt.some(t=>t.startsWith(x))))||mail.includes(q);row.style.setProperty('display',show?'grid':'none','important')})}
  function render(dest){const s=states[dest]||{},i=ids(dest),box=document.getElementById(i.recips);if(!box)return;box.innerHTML=(s.recipients||[]).map(r=>`<label class="v596-recipient"><input type="checkbox" data-v596-recipient value="${esc(r.id)}"><span><b>${esc(r.nombre||r.email)}</b><small>${esc(r.email)}${r.categoria?' · '+esc(r.categoria):''}</small></span></label>`).join('');const defs=new Set((s.recipients||[]).filter(r=>lower(r.email)===COORD||ARCHIVO.includes(lower(r.email))||String(r.id)===String(s.ownId||'')).map(r=>String(r.id)));box.querySelectorAll('input[data-v596-recipient]').forEach(cb=>{cb.checked=defs.has(String(cb.value));cb.addEventListener('change',()=>renderSelected(dest))});renderSelected(dest);applySearch(dest)}
  async function load(dest,force=false){ensurePanel(dest);const s=states[dest]||(states[dest]={});if(s.loading)return;if(s.loaded&&!force){render(dest);return}s.loading=true;try{const [a,b]=await Promise.all([sb.rpc('v560_listar_destinatarios_correo',{p_evento:'SOLICITUD'}),sb.rpc('v580_mi_destinatario_correo')]);if(a.error)throw a.error;s.recipients=(Array.isArray(a.data)?a.data:[]).filter(r=>r?.id&&r?.email&&r?.activo!==false);const own=Array.isArray(b.data)?b.data[0]:b.data;s.ownId=String(own?.destinatario_id||own?.id||'');s.loaded=true;render(dest)}catch(e){document.getElementById(ids(dest).status).textContent='No se pudo cargar correos: '+(e?.message||e)}finally{s.loading=false}}
  function subject(dest){const f=flows[dest],actor=clean(currentProfile?.nombre_personal||currentProfile?.email)||'USUARIO',memo=clean(document.getElementById(f.memo)?.value),base=`Derivación a ${label(dest)} de ${actor}`;return memo?`${base} - Memorando: ${memo}`:base}
  function prepare(dest){ensurePanel(dest);const i=ids(dest);document.getElementById(i.enabled).checked=true;document.getElementById(i.search).value='';document.getElementById(i.subject).value=subject(dest);load(dest,true)}
  function capture(dest){const f=flows[dest],i=ids(dest),memo=clean(document.getElementById(f.memo)?.value),rows=f.rows();if(!memo||!rows.length)return null;const enabled=document.getElementById(i.enabled)?.checked!==false,rec=enabled?selected(dest):[];return {destino:dest,operationId:crypto?.randomUUID?.()||`${Date.now()}-${Math.random().toString(16).slice(2)}`,memo,subject:clean(document.getElementById(i.subject)?.value)||subject(dest),observation:clean(document.getElementById(f.obs)?.value),actor:clean(currentProfile?.nombre_personal),recipients:rec,items:rows.map(r=>({id:r.id,expediente:clean(r.expediente),extension:clean(r.extension),rd:clean(r.rd),ultimo_folio:clean(r.ultimo_folio)}))}}
  function body(d){const lines=[`Se comunica la derivación de expediente(s) a ${label(d.destino)} conforme al movimiento registrado en el Sistema de Control y Trazabilidad de Expedientes.`,'',`Memorando: ${d.memo}`,`Derivado por: ${d.actor||'USUARIO DEL SISTEMA'}`,`Cantidad de expedientes: ${d.items.length}`,...(d.observation?[`Observación: ${d.observation}`]:[]),'','Expedientes:'];d.items.forEach((r,n)=>lines.push(`${n+1}. ${r.expediente||'—'}${r.extension?` · Ext. ${r.extension}`:''}${r.rd?` · R.D. ${r.rd}`:''}${r.ultimo_folio?` · Último folio ${r.ultimo_folio}`:''}`));lines.push('','Este correo tiene carácter de comunicación. La derivación fue registrada previamente en el sistema.');return lines.join('\n')}
  async function finalize(d){if(!d)return;try{const {data,error}=await sb.rpc('v591_registrar_derivacion_memorando',{p_destino:d.destino,p_operacion_id:d.operationId,p_numero_memorando:d.memo,p_expediente_ids:d.items.map(x=>x.id),p_asunto_correo:d.subject,p_cuerpo:body(d),p_destinatario_ids:d.recipients.map(r=>r.id),p_metadata:{origen:'V596_HTML',destino:d.destino,derivado_por:d.actor||null,seleccionado_por:session?.user?.id||currentProfile?.id||null,observacion:d.observation||null,cantidad_expedientes:d.items.length,expedientes:d.items,destinatarios_detalle:d.recipients,numero_memorando:d.memo}});if(error)throw error;if(Number(data?.encoladas||0)>0)window.v586DrainMailInBackground?.('V596_DERIVACION_'+d.destino)}catch(e){console.warn('V596 memo/comunicación:',e);window.showToast?.('La derivación fue registrada, pero no se pudo guardar/enviar la comunicación del memorando: '+(e?.message||e),8000)}}
  function bind(dest){const i=ids(dest);document.getElementById(i.search)?.addEventListener('input',()=>applySearch(dest));document.getElementById(i.selected)?.addEventListener('click',ev=>{const b=ev.target?.closest?.('[data-remove]');if(!b)return;const cb=document.querySelector('#'+i.recips+' input[value="'+CSS.escape(String(b.dataset.remove||''))+'"]');if(cb){cb.checked=false;renderSelected(dest)}})}
  window.v596PrepareDerivationMail=prepare;window.v596CaptureDerivation=capture;window.v596FinalizeDerivation=finalize;
  function boot(){['CONAS','DVC','INSTRUCCION'].forEach(ensurePanel);try{console.info('V596 · Memorando y comunicación para CONAS/DVC/Instrucción activados')}catch(_){}}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>









<script id="v601-supabase-protection-layer">
(function(){
  'use strict';
  const state={
    consecutiveFailures:0,
    blockedUntil:0,
    lastFailureAt:0,
    lastSuccessAt:0,
    lastSource:'',
    mode:'NORMAL'
  };
  const now=()=>Date.now();
  function recalc(){
    if(state.blockedUntil>now())state.mode='PROTECCION';
    else if(state.mode==='PROTECCION'){state.mode='RECUPERACION';state.consecutiveFailures=Math.min(state.consecutiveFailures,1);}
    return state.mode;
  }
  function canPoll(source=''){
    recalc();
    if(navigator.onLine===false)return false;
    if(state.blockedUntil>now())return false;
    return true;
  }
  function reportFailure(source=''){
    state.consecutiveFailures+=1;
    state.lastFailureAt=now();
    state.lastSource=String(source||'');
    if(state.consecutiveFailures>=5){state.blockedUntil=now()+5*60*1000;state.mode='PROTECCION';}
    else if(state.consecutiveFailures>=3){state.blockedUntil=now()+2*60*1000;state.mode='PROTECCION';}
    try{
      if(state.mode==='PROTECCION'){
        const bar=document.getElementById('backgroundReviewText');
        if(bar)bar.textContent='Modo protección: consultas automáticas pausadas temporalmente.';
      }
    }catch(_){ }
  }
  function reportSuccess(source=''){
    state.lastSuccessAt=now();
    state.lastSource=String(source||'');
    if(state.blockedUntil<=now()){
      state.consecutiveFailures=0;
      state.blockedUntil=0;
      state.mode='NORMAL';
    }
  }
  function reset(){
    state.consecutiveFailures=0;state.blockedUntil=0;state.mode='NORMAL';state.lastSource='manual';
  }
  window.v601Protection={canPoll,reportFailure,reportSuccess,reset,state};
  window.v601PerformanceInfo=function(){
    recalc();
    return {
      version:'V602',
      objetivo_usuarios:30,
      objetivo_expedientes:20000,
      refresco_pasivo_segundos:60,
      refresco_reposo:'V170 contador compacto; ubicación cada 120 s',
      alertas_periodicas_detalle:'DESACTIVADAS; se cargan al abrir/cambiar',
      sincronizacion_visible_periodica:'DESACTIVADA; Realtime + cambio V170',
      correo_seguridad_segundos:600,
      rpc_legacy_mis_notificaciones_reasignacion:'DESACTIVADA',
      modo_proteccion:state.mode,
      fallos_consecutivos:state.consecutiveFailures,
      bloqueado_hasta:state.blockedUntil?new Date(state.blockedUntil).toISOString():null,
      pestaña_visible:!document.hidden,
      online:navigator.onLine!==false
    };
  };
  window.addEventListener('online',()=>{
    if(state.blockedUntil<=now())state.mode='RECUPERACION';
  },{passive:true});
  try{console.info('V602 · refresco inteligente/protección Supabase activo',window.v601PerformanceInfo());}catch(_){ }
})();
</script>
<script id="v602-smart-refresh-info">
(function(){
  'use strict';
  window.v602PerformanceInfo=function(){
    const s=window.v602RefreshStats||{};
    return {
      version:'V602',
      estrategia:'poll ligero + refresco dirigido por cambios + Supabase Realtime',
      reposo_objetivo:'1 RPC V170/min; ubicación máx. 1 cada 2 min',
      polling_detalle_alertas:false,
      polling_visible_completo:false,
      correo_reintento_segundos:600,
      pulsos_reposo:Number(s.idlePulses||0),
      rafagas_por_cambio:Number(s.changeBursts||0),
      controles_ubicacion:Number(s.locationChecks||0),
      ultima_revision:s.lastPulseAt?new Date(s.lastPulseAt).toISOString():null,
      ultimo_cambio:s.lastChangeAt?new Date(s.lastChangeAt).toISOString():null,
      proteccion:window.v601Protection?.state?.mode||'NORMAL'
    };
  };
})();
