#userKpiReassignedToCard{background:#f3efff!important}
#userKpiReturnedCard{background:#ebf8f1!important}
#userKpiAlertCard{background:#fff0f1!important}

/* Barra superior y buscadores sobre una superficie blanca. */
.topbar,
.statusbar,
#ownerSearchTools,
#userQuickSearchArea{
  background:transparent!important;
}

/* En pantallas pequeñas, mantener el mismo fondo neutro. */
