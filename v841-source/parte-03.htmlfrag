  }));

  closeRequestSearchModal();
  openNewRequestModal(items,true);
}

function closeRequestSearchModal(){
  requestLookupSequence++;
  el('requestSearchModal').classList.remove('show');
}



function excelHeaderNorm(v){
  return String(v??'')
    .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    .toUpperCase().trim().replace(/\s+/g,' ');
}

function excelExpedienteFromValue(v){
  const s=String(v??'').trim().toUpperCase();
  if(!s)return '';

  // Ej.: 78-2025 / 0078-2025 / 132456-2005 / EXP. 0078-2025 / 0078/2025
  const m=s.match(/(?:EXP(?:EDIENTE)?\.?\s*(?:N[°ºO.]*)?\s*)?(\d+)\s*[-\/]\s*((?:19|20)\d{2})/i);
  if(!m)return '';

  return String(m[1]).padStart(4,'0')+'-'+m[2];
}

function detectExpedientesFromWorkbook(workbook){
  const detected=[];
  let duplicates=0;
  const seen=new Map();

  for(const sheetName of workbook.SheetNames){
    const ws=workbook.Sheets[sheetName];
    const rows=XLSX.utils.sheet_to_json(ws,{header:1,raw:false,defval:''});
    if(!rows.length)continue;

    // Buscar encabezados en las primeras 15 filas.
    let headerRow=-1, expCol=-1, yearCol=-1;

    for(let r=0;r<Math.min(rows.length,15);r++){
      const hdr=(rows[r]||[]).map(excelHeaderNorm);
      const e=hdr.findIndex(x=>
        x==='EXPEDIENTE' ||
        x.includes('NRO EXPEDIENTE') ||
        x.includes('NUMERO EXPEDIENTE') ||
        x.includes('N° EXPEDIENTE') ||
        x.includes('N EXPEDIENTE')
      );
      if(e>=0){
        headerRow=r;
        expCol=e;
        yearCol=hdr.findIndex(x=>x==='AÑO'||x==='ANO'||x.includes('AÑO EXP')||x.includes('ANO EXP'));
        break;
      }
    }

    const add=(exp,rowNum,sourceValue)=>{
      if(!exp)return;
      if(seen.has(exp)){
        duplicates++;
        return;
      }
      seen.set(exp,true);
      detected.push({
        expediente:exp,
        hoja:sheetName,
        fila:rowNum+1,
        origen:String(sourceValue??'')
      });
    };

    if(expCol>=0){
      for(let r=headerRow+1;r<rows.length;r++){
        const row=rows[r]||[];
        const rawExp=row[expCol];
        let exp=excelExpedienteFromValue(rawExp);

        // Si número y año están en columnas separadas.
        if(!exp && yearCol>=0){
          const num=String(rawExp??'').trim().replace(/\D/g,'');
          const year=String(row[yearCol]??'').trim().match(/(?:19|20)\d{2}/)?.[0]||'';
          if(num && year){
            const cleanNum=(num.replace(/^0+(?=\d)/,'')||'0'); exp=(cleanNum.length<4?cleanNum.padStart(4,'0'):cleanNum)+'-'+year;
          }
        }
        add(exp,r,rawExp);
      }
    }else{
      // Sin cabecera reconocible: escaneo conservador de celdas.
      rows.forEach((row,r)=>{
        (row||[]).forEach(cell=>{
          const s=String(cell??'').trim();
          if(!s)return;
          const exp=excelExpedienteFromValue(s);
          // Solo aceptar si la celda parece contener realmente un expediente.
          if(exp && (
            /^\s*(?:EXP(?:EDIENTE)?\.?\s*(?:N[°ºO.]*)?\s*)?\d+\s*[-\/]\s*(?:19|20)\d{2}/i.test(s)
          )){
            add(exp,r,cell);
          }
        });
      });
    }
  }

  return {detected,duplicates};
}

async function importRequestExcel(file){
  if(!file)return;

  if(typeof XLSX==='undefined'){
    el('requestLookupStatus').textContent='No se pudo cargar el lector de Excel. Recargue la página e intente nuevamente.';
    return;
  }

  const name=(file.name||'').toLowerCase();
  if(!/\.(xlsx|xls|csv)$/.test(name)){
    el('requestLookupStatus').textContent='Seleccione un archivo XLSX, XLS o CSV.';
    return;
  }

  el('requestLookupStatus').textContent='Leyendo Excel y comparando expedientes...';
  el('requestExcelResults').innerHTML='<div class="empty">Procesando archivo...</div>';

  try{
    const buffer=await file.arrayBuffer();
    const wb=XLSX.read(buffer,{type:'array'});
    const {detected,duplicates}=detectExpedientesFromWorkbook(wb);

    requestExcelDuplicates=duplicates;

    if(!detected.length){
      requestExcelRows=[];
      requestExcelMissing=[];
      renderRequestExcelResults();
      el('requestLookupStatus').textContent=
        'No se detectaron números de expediente. Verifique que el Excel tenga una columna EXPEDIENTE (ej. 0078-2025 o 132456-2005) o columnas EXPEDIENTE + AÑO.';
      return;
    }

    const expedientes=detected.map(x=>x.expediente);

    const {data,error}=await sb.rpc('buscar_expedientes_lote_para_solicitud_v2',{
      p_expedientes:expedientes
    });

    if(error)throw error;

    const sourceMap=new Map(detected.map(x=>[x.expediente,x]));
    requestExcelRows=(data||[]).map(x=>({
      ...x,
      ...(sourceMap.get(x.expediente_buscado)||{})
    }));
    requestExcelRows=await annotateInternalReassignEligibility(requestExcelRows);
    requestExcelRows=await annotateReferralsV124(requestExcelRows);

    // V506 · La carga Excel debe respetar la misma regla que la búsqueda manual:
    // un expediente ya DEVUELTO AL ARCHIVO puede iniciar un nuevo ciclo.
    const v506ExcelUnique=requestExcelRows.filter(x=>
      x?.encontrado && Number(x?.coincidencias)===1 && x?.id
    );
    if(v506ExcelUnique.length){
      try{
        const validatedV506=v506NormalizeReturnedAvailability(
          await validateRequestRowsFastV188(v506ExcelUnique)
        );
        const byIdV506=new Map(
          validatedV506.map(x=>[String(x.id||''),x])
        );
        requestExcelRows=requestExcelRows.map(x=>{
          const validated=byIdV506.get(String(x?.id||''));
          return validated?{...x,...validated}:x;
        });
      }catch(error){
        console.warn('V506 · validación Excel de nuevo ciclo:',error?.message||error);
      }
    }

    requestExcelMissing=requestExcelRows
      .filter(x=>!x.encontrado)
      .map(x=>x.expediente_buscado);

    // Agregar automáticamente los existentes, únicos y disponibles.
    let added=0;
    let already=0;

    requestExcelRows.forEach(x=>{
      if(!x.encontrado || Number(x.coincidencias)!==1 || !x.disponible || !x.id)return;

      const item={
        id:x.id,
        expediente:x.expediente,
        extension:x.extension||null,
        rd:x.rd||null,
        estado:x.estado||null,
        disponible:true,
        solicitud_interna:!!x.solicitud_interna,
        solicitud_otra_area:!!x.solicitud_otra_area,
        area_trabajo:x.area_trabajo||null,
        responsable_actual:x.responsable_actual||null,
        _nuevo:false
      };

      const key=requestDraftKey(item);
      if(requestDraftItems.some(d=>requestDraftKey(d)===key)){
        already++;
        return;
      }

      requestDraftItems.push(item);
      added++;
    });

    renderRequestDraft();
    updateRequestLookupSelection();
    renderRequestExcelResults();

    el('requestLookupStatus').textContent=
      `${detected.length} expediente(s) detectado(s) · ${added} existente(s) agregado(s) automáticamente`+
      (already?` · ${already} ya estaba(n) agregado(s)`:'')+
      (requestExcelMissing.length?` · ${requestExcelMissing.length} no encontrado(s)`:'')+
      '.';

  }catch(err){
    console.error(err);
    el('requestLookupStatus').textContent=err?.message||'No se pudo procesar el Excel.';
    el('requestExcelResults').innerHTML='<div class="empty">No se pudo procesar el archivo.</div>';
  }
}

function requestExcelStatus(x){
  if(!x.encontrado)return '<span class="pill alert">NO ENCONTRADO</span>';
  if(Number(x.coincidencias)>1)return '<span class="pill alert">VARIAS COINCIDENCIAS</span>';
  const custodyV791=requestCustodyAvailabilityHtmlV791(x);
  if(custodyV791)return custodyV791;
  if(x.solicitud_interna)return '<span class="pill alert">REASIGNACIÓN AL CUSTODIO</span>';
  if(x.solicitud_otra_area)return '<span class="pill alert">VERIFICAR REASIGNACIÓN</span>';
  if(!x.disponible)return `<span class="pill alert">${esc(x.motivo||'NO DISPONIBLE')}</span>`;
  return '<span class="pill returned">ENCONTRADO</span>';
}

function renderRequestExcelResults(){
  const box=el('requestExcelSummary');
  const results=el('requestExcelResults');
  if(!box||!results)return;

  const total=requestExcelRows.length;
  const found=requestExcelRows.filter(x=>x.encontrado&&Number(x.coincidencias)===1).length;
  const available=requestExcelRows.filter(x=>x.encontrado&&Number(x.coincidencias)===1&&x.disponible).length;
  const missing=requestExcelRows.filter(x=>!x.encontrado).length;
  const unavailable=requestExcelRows.filter(x=>x.encontrado&&(!x.disponible||Number(x.coincidencias)>1)).length;

  box.classList.remove('hidden');
  box.innerHTML=`<div class="excel-import-summary">
    <div class="excel-stat"><span>Detectados</span><b>${total}</b></div>
    <div class="excel-stat"><span>Encontrados</span><b>${found}</b></div>
    <div class="excel-stat"><span>Agregables</span><b>${available}</b></div>
    <div class="excel-stat danger"><span>No encontrados</span><b>${missing}</b></div>
    <div class="excel-stat warn"><span>Duplicados Excel</span><b>${requestExcelDuplicates}</b></div>
  </div>`;

  if(!total){
    results.innerHTML='<div class="empty">No se detectaron expedientes.</div>';
    return;
  }

  results.innerHTML=`<div class="excel-result-table"><table>
    <thead>
      <tr>
        <th>Expediente detectado</th>
        <th>Hoja</th>
        <th>Fila</th>
        <th>Resultado</th>
        <th>Estado actual</th>
        <th>Responsable actual / ubicación</th>
        <th>Ext.</th>
        <th>R.D.</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      ${requestExcelRows.map((x,i)=>`<tr>
        <td><b>${esc(x.expediente_buscado||x.expediente||'')}</b></td>
        <td>${esc(x.hoja||'—')}</td>
        <td>${esc(x.fila||'—')}</td>
        <td>
          ${requestExcelStatus(x)}
          ${!x.disponible && x.encontrado
            ?`<span class="request-custody-warning">${esc(x.motivo||'NO DISPONIBLE')}</span>`
            :''}
        </td>
        <td>${esc(stateDisplayName(requestLatestStateValueV793(x)))}</td>
        <td class="request-owner-current">${requestOwnerWithAreaV785(x)}</td>
        <td>${esc(x.extension||'—')}</td>
        <td>${esc(x.rd||'—')}</td>
        <td>
          ${!x.encontrado
            ?`<button class="btn secondary small" onclick="addMissingExcelExpediente(${i})">Agregar como nuevo</button>`
            :Number(x.coincidencias)>1
              ?`<button class="btn secondary small" onclick="searchExcelAmbiguous(${i})">Revisar</button>`
              :''}
        </td>
      </tr>`).join('')}
    </tbody>
  </table></div>
  ${missing?`<div style="margin-top:8px">
    <button class="btn secondary small" onclick="addAllMissingExcelExpedientes()">+ Agregar todos los no encontrados como nuevos</button>
  </div>`:''}`;
}

function addMissingExcelExpediente(index){
  const x=requestExcelRows[index];
  if(!x || x.encontrado)return;

  const item={
    id:null,
    expediente:x.expediente_buscado,
    extension:null,
    rd:null,
    ultimo_folio:null,
    observacion:'Registrado desde carga masiva de Excel',
    estado:'PENDIENTE POR ATENDER',
    _nuevo:true
  };

  const key=requestDraftKey(item);
  if(!requestDraftItems.some(d=>requestDraftKey(d)===key)){
    requestDraftItems.push(item);
  }

  renderRequestDraft();
  updateRequestLookupSelection();
  showToast(`${x.expediente_buscado} agregado como nuevo`);
}

function addAllMissingExcelExpedientes(){
  let added=0;

  requestExcelRows.filter(x=>!x.encontrado).forEach(x=>{
    const item={
      id:null,
      expediente:x.expediente_buscado,
      extension:null,
      rd:null,
      ultimo_folio:null,
      observacion:'Registrado desde carga masiva de Excel',
      estado:'PENDIENTE POR ATENDER',
      _nuevo:true
    };
    const key=requestDraftKey(item);

    if(!requestDraftItems.some(d=>requestDraftKey(d)===key)){
      requestDraftItems.push(item);
      added++;
    }
  });

  renderRequestDraft();
  updateRequestLookupSelection();
  showToast(`${added} expediente(s) no encontrado(s) agregado(s) como nuevos`);
}

function searchExcelAmbiguous(index){
  const x=requestExcelRows[index];
  if(!x)return;
  el('requestLookupInput').value=x.expediente_buscado;
  if(el('requestLookupExtension'))el('requestLookupExtension').value=canonicalRequestExtension(x.extension_solicitada||x.extension||'');
  updateRequestExtensionRequirementV265();
  searchRequestCandidates();
  el('requestLookupResults')?.scrollIntoView({behavior:'auto',block:'start'});
}

function normalizeRequestExpediente(value){
  const raw=(value||'').trim().toUpperCase().replace(/\s+/g,'');
  const m=raw.match(/^(\d+)-(\d{4})$/);
  if(!m)return raw;
  return m[1].padStart(4,'0')+'-'+m[2];
}

function showNewExpRequestOption(show,expediente='',extension='',mode='new'){
  const box=el('newExpRequestBox');
  if(!box)return;

  box.classList.toggle('hidden',!show);

  if(show){
    const isVariant=mode==='variant';
    const exp=normalizeRequestExpediente(expediente);
    const ext=canonicalRequestExtension(extension);

    el('newReqExpediente').value=exp;
    el('newReqExtension').value=ext;
    updateNewRequestExtensionRequirementV265();
    el('newReqRd').value='';
    el('newReqFolio').value='';
    el('newReqExpObs').value=isVariant
      ?`Nueva variante solicitada: ${exp}${ext?' · '+ext:''}`
      :'';

    if(el('newExpRequestTitle')){
      el('newExpRequestTitle').textContent=isVariant
        ?'Nueva variante del expediente'
        :'El expediente no está registrado';
    }

    if(el('newExpRequestNote')){
      el('newExpRequestNote').innerHTML=isVariant
        ?`El número <b>${esc(exp)}</b> ya existe con otra extensión, pero <b>${esc(ext||'SIN EXTENSIÓN')}</b> no está registrada. Puede agregar esta variante a la solicitud sin modificar la variante existente.`
        :'Puede registrarlo por primera vez y agregarlo a la misma solicitud. Archivo verificará el expediente antes de atenderlo.';
    }

    if(el('newExpRequestAddBtn')){
      el('newExpRequestAddBtn').textContent=isVariant
        ?`+ Agregar ${exp}${ext?' · '+ext:''} a la solicitud`
        :'+ Agregar expediente nuevo a la solicitud';
    }
  }
}

async function openNewFirstTimeRequest(){
  if(isLimitedUser() && !currentProfile?.nombre_personal){
    alert('Su cuenta no está asociada a un nombre de personal.');
    return;
  }

  const expediente=normalizeRequestExpediente(el('newReqExpediente').value);

  if(!/^\d+-\d{4}$/.test(expediente)){
    el('requestLookupStatus').textContent='Use el formato NÚMERO-AÑO. Ej.: 0352-2026 o 132456-2005.';
    return;
  }

  const newExtension=canonicalRequestExtension(el('newReqExtension').value.trim());
  const extensionValidation=requestExtensionValidationV265(expediente,newExtension);
  if(extensionValidation.required&&!extensionValidation.ok){
    el('requestLookupStatus').textContent=requestExtensionRuleMessageV265(expediente,newExtension);
    el('newReqExtension')?.focus();
    return;
  }

  const item={
    id:null,
    expediente,
    extension:newExtension||null,
    rd:el('newReqRd').value.trim()||null,
    ultimo_folio:el('newReqFolio').value.trim()||null,
    observacion:el('newReqExpObs').value.trim()||null,
    estado:'PENDIENTE POR ATENDER',
    _nuevo:true
  };

  const key=requestDraftKey(item);

  if(requestDraftItems.some(x=>requestDraftKey(x)===key)){
    el('requestLookupStatus').textContent=`${expediente} ya está agregado a esta solicitud.`;
    return;
  }

  requestDraftItems.push(item);
  renderRequestDraft();

  const addedExtension=String(item.extension||'').trim();

  el('requestLookupStatus').textContent=
    `${expediente}${addedExtension?' · '+addedExtension:''} agregado. Puede buscar y agregar otro expediente.`;
  el('requestLookupInput').value='';
  if(el('requestLookupExtension'))el('requestLookupExtension').value='';
  el('requestLookupResults').innerHTML='<div class="empty">Busque otro expediente para agregarlo.</div>';
  showNewExpRequestOption(false);
  requestSearchRows=[];
  requestSearchSelectedIds.clear();
  updateRequestLookupSelection();
  el('requestLookupInput').focus();
}

function normalizeRequestExtension(value){
  return String(value||'')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g,'')
    .toUpperCase()
    .trim()
    .replace(/\s+/g,' ');
}

function canonicalRequestExtension(value){
  const normalized=normalizeRequestExtension(value);
  const key=normalized.replace(/[^A-Z0-9]/g,'');

  // En algunos registros puede aparecer DSF y en otros DSF-PA.
  // Para la búsqueda se consideran la misma sigla.
  if(key==='DSF' || key==='DSFPA')return 'DSF-PA';

  return normalized;
}

function requestExtensionKey(value){
  return canonicalRequestExtension(value)
    .replace(/[^A-Z0-9]/g,'');
}

function requestValidExtensionsForExpediente(expediente){
  const m=String(expediente||'').match(/^(\d+)-(\d{4})$/);
  if(!m)return null;

  const year=Number(m[2]);

  // V332 · Regla institucional de extensión/sigla por año.
  // Años de transición conservan ambas siglas válidas.
  if(year>=2000 && year<=2005)return ['DINSECOVI'];
  if(year===2006)return ['DINSECOVI','DIGSECOVI'];
  if(year>=2007 && year<=2011)return ['DIGSECOVI'];
  if(year===2012)return ['DIGSECOVI','DGS'];
  if(year>=2013 && year<=2016)return ['DGS'];
  if(year===2017)return ['DGS','DSF-PA'];
  if(year>=2018 && year<=2026)return ['DSF-PA'];

  return null;
}

function requestExtensionRequiredV265(expediente){
  return Array.isArray(requestValidExtensionsForExpediente(expediente));
}

function requestExtensionValidationV265(expediente,extension){
  const allowed=requestValidExtensionsForExpediente(expediente);
  if(!allowed)return {required:false,ok:true,allowed:[]};

  const ext=canonicalRequestExtension(extension||'');
  if(!ext){
    return {required:true,ok:false,reason:'missing',allowed};
  }

  const ok=allowed.some(x=>requestExtensionKey(x)===requestExtensionKey(ext));
  return {required:true,ok,reason:ok?'':'invalid',allowed};
}

function requestExtensionRuleMessageV265(expediente,extension=''){
  const v=requestExtensionValidationV265(expediente,extension);
  if(!v.required)return '';
  const opts=v.allowed.join(' / ');
  if(v.reason==='missing')return `La extensión es obligatoria para ${String(expediente||'').slice(-4)}. Seleccione o escriba: ${opts}.`;
  if(v.reason==='invalid')return `La extensión indicada no corresponde al año ${String(expediente||'').slice(-4)}. Opciones válidas: ${opts}.`;
  return '';
}

function updateRequestExtensionRequirementV265(){
  const q=normalizeRequestExpediente(el('requestLookupInput')?.value||'');
  const extEl=el('requestLookupExtension');
  const label=el('requestLookupExtensionLabel');
  const help=el('requestLookupExtensionHelp');
  if(!extEl||!label||!help)return;

  const allowed=requestValidExtensionsForExpediente(q);
  const required=Array.isArray(allowed);
  extEl.required=required;

  if(required){
    label.textContent='Extensión / sigla *';
    help.innerHTML=`<b>Obligatoria para ${esc(q.slice(-4))}.</b> Opciones válidas: <b>${esc(allowed.join(' / '))}</b>.`;
    extEl.placeholder=allowed.join(' / ');
    extEl.style.borderColor='#c58b19';
    extEl.style.background='#fffdf5';
  }else{
    label.textContent='Extensión / sigla';
    help.textContent='Seleccione la sigla que corresponde al año del expediente.';
    extEl.placeholder='Ej.: DGS, DIGSECOVI, DINSECOVI, DSF-PA';
    extEl.style.borderColor='';
    extEl.style.background='';
  }
}

function updateNewRequestExtensionRequirementV265(){
  const q=normalizeRequestExpediente(el('newReqExpediente')?.value||'');
  const extEl=el('newReqExtension');
  const label=el('newReqExtensionLabel');
  const help=el('newReqExtensionHelp');
  if(!extEl||!label||!help)return;

  const allowed=requestValidExtensionsForExpediente(q);
  const required=Array.isArray(allowed);
  extEl.required=required;
  if(required){
    label.textContent='Extensión *';
    help.innerHTML=`Obligatoria para ${esc(q.slice(-4))}: <b>${esc(allowed.join(' / '))}</b>.`;
    extEl.placeholder=allowed.join(' / ');
    extEl.style.borderColor='#c58b19';
    extEl.style.background='#fffdf5';
  }else{
    label.textContent='Extensión';
    help.textContent='Seleccione la sigla que corresponde al año del expediente.';
    extEl.placeholder='Opcional';
    extEl.style.borderColor='';
    extEl.style.background='';
  }
}

function requestDraftExtensionIssueV265(items){
  for(const item of (items||[])){
    const expediente=normalizeRequestExpediente(item?.expediente||'');
    const extension=canonicalRequestExtension(item?.extension||'');
    const v=requestExtensionValidationV265(expediente,extension);
    if(v.required&&!v.ok){
      return {item,expediente,extension,validation:v,message:requestExtensionRuleMessageV265(expediente,extension)};
    }
  }
  return null;
}

function requestExtensionIsValidForExpediente(expediente,extension){
  const allowed=requestValidExtensionsForExpediente(expediente);

  // Para años sin regla especial no bloqueamos extensiones existentes/nuevas.
  if(!allowed)return true;

  const wanted=requestExtensionKey(extension);

  return allowed.some(
    x=>requestExtensionKey(x)===wanted
  );
}

function parseRequestLookupNumberAndExtension(rawValue,extensionValue=''){
  const raw=String(rawValue||'').trim();
  let extension=canonicalRequestExtension(extensionValue);

  // Permitir también: "0123-2006 DGS"
  // El campo separado sigue siendo la forma recomendada.
  const match=raw.match(
    /^\s*(\d+\s*-\s*[12]\d{3})(?:\s+(.+))?\s*$/i
  );

  if(match){
    const expediente=normalizeRequestExpediente(
      match[1].replace(/\s+/g,'')
    );

    if(!extension && match[2]){
      extension=canonicalRequestExtension(match[2]);
    }

    return {expediente,extension};
  }

  return {
    expediente:normalizeRequestExpediente(raw),
    extension
  };
}

function requestRowsMatchingExtension(rows,extension){
  const wanted=requestExtensionKey(extension);
  const list=Array.isArray(rows)?rows:[];

  if(!wanted)return list;

  // La coincidencia exacta tiene prioridad absoluta.
  const exact=list.filter(
    r=>requestExtensionKey(r.extension||'')===wanted
  );

  if(exact.length)return exact;

  // Como respaldo, admitir coincidencia textual equivalente
  // solo cuando no existe una exacta.
  const similar=list.filter(r=>{
    const current=requestExtensionKey(r.extension||'');
    if(!current)return false;
    return current.includes(wanted) || wanted.includes(current);
  });

  return similar;
}

function requestRegisteredExtensions(rows){
  return [...new Set(
    (rows||[])
      .map(r=>canonicalRequestExtension(r.extension||''))
      .filter(Boolean)
  )].sort((a,b)=>a.localeCompare(b,'es'));
}


// =========================================================
// V330 · EXTENSIONES EN DESPLEGABLE PARA BÚSQUEDA
// - Muestra extensiones válidas/reales como opciones.
// - Para 2006, 2012 y 2017 incluye de inmediato las opciones institucionales.
// - Para otros años consulta las extensiones ya registradas del expediente.
// =========================================================
let requestExtensionDropdownTimerV330=null;
let requestExtensionDropdownSeqV330=0;

function setRequestExtensionDropdownV330(values,preserveValue=true){
  const sel=el('requestLookupExtension');
  if(!sel)return;

  const previous=preserveValue?canonicalRequestExtension(sel.value||''):'';
  const unique=[...new Set((values||[])
    .map(x=>canonicalRequestExtension(x||''))
    .filter(Boolean))]
    .sort((a,b)=>a.localeCompare(b,'es'));

  sel.innerHTML='<option value="">Seleccione extensión</option>'+
    unique.map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join('');

  if(previous && unique.some(x=>requestExtensionKey(x)===requestExtensionKey(previous))){
    const exact=unique.find(x=>requestExtensionKey(x)===requestExtensionKey(previous));
    sel.value=exact||'';
  }else{
    sel.value='';
  }
}

function requestDefaultExtensionV331(expediente){
  const m=String(expediente||'').match(/^(\d+)-(\d{4})$/);
  if(!m)return '';
  const year=Number(m[2]);
  if(year>=2000 && year<=2005)return 'DINSECOVI';
  if(year>=2007 && year<=2011)return 'DIGSECOVI';
  if(year>=2013 && year<=2016)return 'DGS';
  if(year>=2018 && year<=2026)return 'DSF-PA';
  // 2006, 2012 y 2017 son años de transición: el usuario elige entre dos siglas válidas.
  return '';
}

function selectDefaultRequestExtensionV331(expediente){
  const sel=el('requestLookupExtension');
  if(!sel || sel.value)return;
  const def=requestDefaultExtensionV331(expediente);
  if(!def)return;
  const match=[...sel.options].find(o=>requestExtensionKey(o.value)===requestExtensionKey(def));
  if(match)sel.value=match.value;
}

function applyRequestExtensionOptionsFromRowsV330(expediente,rows,preserveValue=true){
  const allowed=requestValidExtensionsForExpediente(expediente)||[];
  const defaultExt=requestDefaultExtensionV331(expediente);
  const exactRows=(rows||[]).filter(r=>
    normalizeRequestExpediente(r?.expediente||r?.numero_expediente||'')===expediente
  );
  const registered=requestRegisteredExtensions(exactRows.length?exactRows:(rows||[]));
  setRequestExtensionDropdownV330([...allowed,...(defaultExt?[defaultExt]:[]),...registered],preserveValue);
  selectDefaultRequestExtensionV331(expediente);
}

async function refreshRequestExtensionDropdownV330(){
  const seq=++requestExtensionDropdownSeqV330;
  const q=normalizeRequestExpediente(el('requestLookupInput')?.value||'');
  const allowed=requestValidExtensionsForExpediente(q)||[];
  const defaultExt=requestDefaultExtensionV331(q);

  // Mostrar inmediatamente las extensiones regladas por año y seleccionar por defecto cuando el año tiene una sola sigla.
  setRequestExtensionDropdownV330([...allowed,...(defaultExt?[defaultExt]:[])],true);
  selectDefaultRequestExtensionV331(q);

  if(q.length<4)return;

  try{
    const {data,error}=await sb.rpc('buscar_expedientes_para_solicitud_v2',{p_busqueda:q});
    if(seq!==requestExtensionDropdownSeqV330)return;
    if(error)return;
    applyRequestExtensionOptionsFromRowsV330(q,data||[],true);
  }catch(_){
    // El desplegable sigue operativo con las opciones institucionales conocidas.
  }
}

function scheduleRequestExtensionDropdownV330(){
  clearTimeout(requestExtensionDropdownTimerV330);
  requestExtensionDropdownTimerV330=setTimeout(refreshRequestExtensionDropdownV330,220);
}

function matchReferralAuthorV125(authors,destination,item,row){
  const key={CONAS:'movimiento_conas_id',DVC:'movimiento_dvc_id','INSTRUCCIÓN':'movimiento_instruccion_id'}[destination];
  const movement=item[key]||item.movimiento_id||(destination==='INSTRUCCIÓN'?row._instruction_movimiento_id:null);
  const date=item.fecha_derivacion||row['fecha_derivacion_'+({CONAS:'conas',DVC:'dvc','INSTRUCCIÓN':'instruccion'}[destination])]||null;
  const candidates=authors.filter(a=>String(a.expediente_id)===String(row.id||row.expediente_id)&&a.destino===destination);
  let matches=[];
  if(movement!=null)matches=candidates.filter(a=>String(a.movimiento_id)===String(movement));
  else if(date){
    matches=candidates.filter(a=>String(a.fecha_derivacion)===String(date));
    if(!matches.length && /[T ]\d{2}:/.test(String(date))){
      const t=Date.parse(date);
      if(Number.isFinite(t))matches=candidates.filter(a=>Date.parse(a.fecha_derivacion)===t);
    }
  }
  // Never substitute the sender of a previous cycle when the match is ambiguous.
  return matches.length===1?String(matches[0].enviado_por||'').trim():'';
}
async function loadReferralAuthorsV125(ids){
  const rows=[];
  for(let i=0;i<ids.length;i+=80){
    const {data,error}=await sb.rpc('consultar_autores_derivaciones_v125',{p_expediente_ids:ids.slice(i,i+80)});
    if(error)throw error;
    if(!Array.isArray(data))throw Error('Respuesta de autores inválida');
    rows.push(...data);
  }
  return rows;
}

function requestReferralDestinationV124(row){
  const owner=norm(row.responsable_actual||'');
  const state=norm(row.estado_operativo||row.ultimo_estado||row.estado||'');
  if(owner==='INSTRUCCIÓN'||owner==='INSTRUCCION'||/^DERIVADO A INSTRUCCI[ÓO]N$/.test(state))return 'INSTRUCCIÓN';
  if(['CONAS','ELEVADO AL CONAS'].includes(owner)||/^DERIVADO (AL|A) CONAS$/.test(state))return 'CONAS';
  if(['DVC','VDC'].includes(owner)||/^DERIVADO A (LA )?(DVC|VDC)$/.test(state))return 'DVC';
  return '';
}
function requestReferralTextV124(row){
  return `NO DISPONIBLE · En ${row._referralDestination}. Pendiente de retorno.`+
    (row._referralSender?` Enviado por: ${row._referralSender}.`:' Autor del envío no disponible para esta consulta.');
}
function requestReferralHtmlV124(row){
  return `<span class="pill alert">NO DISPONIBLE · ${esc(row._referralDestination)}</span><span class="active-request-brief">Pendiente de retorno${row._referralSender?` · Enviado por: ${esc(row._referralSender)}`:' · Autor del envío no disponible'}</span>`;
}
async function annotateReferralsV124(rows,strict=false,fast=false){
  const list=Array.isArray(rows)?rows:[];
  const ids=[...new Set(list.map(r=>r.id||r.expediente_id).filter(Boolean))];
  if(!ids.length)return list;
  const specs=[['CONAS','listar_derivados_conas'],['DVC','listar_derivados_dvc'],['INSTRUCCIÓN','listar_derivados_instruccion']];

  const searchNumbers=[...new Set(
    list.map(r=>String(r?.expediente||'').trim()).filter(Boolean)
  )];

  const targetedSearch=
    searchNumbers.length===1
      ?searchNumbers[0]
      :null;

  const results=await Promise.allSettled(specs.map(async([destination,rpc])=>{
    const {data,error}=await sb.rpc(rpc,{p_busqueda:targetedSearch});
    if(error)throw error;
    if(!Array.isArray(data))throw Error('Respuesta de derivaciones incompleta');
    return {destination,rows:data};
  }));
  const active=new Map();
  for(const result of results){
    if(result.status!=='fulfilled')continue;
    for(const item of result.value.rows){
      const id=String(item.expediente_id||'');
      if(!ids.some(x=>String(x)===id))continue;
      const previous=active.get(id);
      if(!previous||String(item.fecha_derivacion||'')>String(previous.item.fecha_derivacion||''))active.set(id,{destination:result.value.destination,item});
    }
  }
  // V188 · Fast path para el buscador de Nueva solicitud.
  // La disponibilidad y el destino son críticos; el nombre exacto del autor
  // de la derivación es secundario y no debe demorar la búsqueda.
  if(fast){
    return list.map(row=>{
      const found=active.get(String(row.id||row.expediente_id||''));
      const destination=
        found?.destination||
        requestReferralDestinationV124(row);

      if(!destination){
        if(
          strict &&
          results.some(x=>x.status==='rejected')
        ){
          return {...row,_referralUnverified:true};
        }
        return row;
      }

      const item=found?.item||{};

      const next={
        ...row,
        disponible:false,
        solicitud_interna:false,
        solicitud_otra_area:false,
        usar_reasignacion_interna:false,
        _referralDestination:destination,
        _referralSender:String(
          item.derivado_por_nombre||
          item.responsable_origen||
          ''
        ).trim()||null
      };

      next.motivo=requestReferralTextV124(next);
      return next;
    });
  }

  let authors=[];
  try{authors=await loadReferralAuthorsV125(ids);}
  catch(error){console.warn('Consulta de autores no disponible; usando la derivación vigente.',error?.message||error);}
  // Respaldo de lectura bajo los permisos de la sesión, sin requerir instalar una RPC.
  const missing=ids.filter(id=>{
    const row=list.find(r=>String(r.id||r.expediente_id)===String(id));
    const found=active.get(String(id));
    const destination=found?.destination||requestReferralDestinationV124(row);
    return destination&&!matchReferralAuthorV125(authors,destination,found?.item||{},row);
  });
  if(missing.length){
    const tables=[['CONAS','movimientos_conas'],['DVC','movimientos_dvc'],['INSTRUCCIÓN','movimientos_instruccion']];
    const direct=await Promise.allSettled(tables.map(async([destination,table])=>{
      const result=[];
      for(let i=0;i<missing.length;i+=80){
        const {data,error}=await sb.from(table).select('*').in('expediente_id',missing.slice(i,i+80));
        if(error)throw error;
        result.push(...(data||[]).map(m=>({...m,destino:destination,movimiento_id:m.id})));
      }
      return result;
    }));
    const movements=direct.filter(r=>r.status==='fulfilled').flatMap(r=>r.value);
    const userIds=[...new Set(movements.filter(m=>!m.derivado_por_nombre).map(m=>m.derivado_por).filter(Boolean))];
    const profiles=new Map();
    for(let i=0;i<userIds.length;i+=80){
      try{
        const {data,error}=await sb.from('perfiles_usuario').select('id,nombre_personal').in('id',userIds.slice(i,i+80));
        if(!error)(data||[]).forEach(p=>profiles.set(String(p.id),p.nombre_personal));
      }catch(error){console.warn('No se pudo consultar el nombre del derivante.',error);}
    }
    for(const m of movements){
      const sender=String(m.derivado_por_nombre||profiles.get(String(m.derivado_por))||'').trim();
      if(sender&&!authors.some(a=>String(a.expediente_id)===String(m.expediente_id)&&a.destino===m.destino&&String(a.movimiento_id)===String(m.movimiento_id)&&a.enviado_por)){
        authors=authors.filter(a=>!(String(a.expediente_id)===String(m.expediente_id)&&a.destino===m.destino&&String(a.movimiento_id)===String(m.movimiento_id)));
        authors.push({...m,enviado_por:sender});
      }
    }
  }
  return list.map(row=>{
    const found=active.get(String(row.id||row.expediente_id||''));
    const destination=found?.destination||requestReferralDestinationV124(row);
    if(!destination){
      if(strict&&results.some(x=>x.status==='rejected'))return {...row,_referralUnverified:true};
      return row;
    }
    const item=found?.item||{};
    const next={...row,disponible:false,solicitud_interna:false,solicitud_otra_area:false,
      usar_reasignacion_interna:false,_referralDestination:destination,
      _referralSender:String(item.derivado_por_nombre||'').trim()||matchReferralAuthorV125(authors,destination,item,row)||String(item.responsable_origen||'').trim()||null};
    next.motivo=requestReferralTextV124(next);
    return next;
  });
}

// ============================================================
// V324 · CIERRE ADMINISTRATIVO NO BLOQUEA UNA NUEVA SOLICITUD
// El cierre del Administrador pertenece al ciclo anterior. Para evitar que
// una RPC antigua siga tratándolo como "activo", se contrasta también el
// estado actual de la cabecera de solicitudes_prestamo cuando está disponible.
// ============================================================
function requestClosedByAdminStateV324(value){
  return [
    'CERRADO POR ADMINISTRADOR',
    'CERRADA POR ADMINISTRADOR'
  ].includes(norm(value||''));
}

function requestHistoricalTerminalStateV324(value){
  return [
    'CERRADO POR ADMINISTRADOR',
    'CERRADA POR ADMINISTRADOR',
    'CERRADO POR ARCHIVO',
    'CERRADA POR ARCHIVO',
    'CANCELADO',
    'CANCELADA',
    'ANULADO',
    'ANULADA',
    'DEVUELTO',
    'DEVUELTO AL ARCHIVO'
  ].includes(norm(value||''));
}

function requestCandidateStatesV324(req,header=null){
  return [
    req?.estado_item,
    req?.estado,
    req?.estado_atencion,
    req?.estado_solicitud,
    req?.solicitud_estado,
    req?.estado_ciclo,
    header?.estado_item,
    header?.estado,
    header?.estado_atencion,
    header?.estado_solicitud,
    header?.solicitud_estado,
    header?.estado_ciclo
  ].map(x=>norm(x||'')).filter(Boolean);
}

function requestIsTerminalForNewCycleV324(req,header=null){
  return requestCandidateStatesV324(req,header)
    .some(requestHistoricalTerminalStateV324);
}

function requestIsClosedByAdminV324(req,header=null){
  return requestCandidateStatesV324(req,header)
    .some(requestClosedByAdminStateV324);
}

function requestNumberV324(req){
  return String(
    req?.solicitud_numero||
    req?.numero_solicitud||
    req?.numero||
    ''
  ).trim();
}

function requestIdV324(req){
  return String(
    req?.solicitud_id||
    req?.solicitud_prestamo_id||
    req?.request_id||
    ''
  ).trim();
}

async function loadRequestHeadersV324(byId){
  const requestIds=[];
  const requestNumbers=[];

  for(const list of byId.values()){
    for(const req of (list||[])){
      const id=requestIdV324(req);
      const num=requestNumberV324(req);
      if(id)requestIds.push(id);
      if(num)requestNumbers.push(num);
    }
  }

  const ids=[...new Set(requestIds)];
  const numbers=[...new Set(requestNumbers)];
  const headersById=new Map();
  const headersByNumber=new Map();

  // Esta verificación es complementaria. Si RLS no permite consultar la
  // cabecera, la búsqueda continúa usando la información de la RPC V119.
  try{
    for(let i=0;i<ids.length;i+=80){
      const {data,error}=await sb
        .from('solicitudes_prestamo')
        .select('id,numero,estado,estado_atencion')
        .in('id',ids.slice(i,i+80));
      if(error)throw error;
      (data||[]).forEach(r=>{
        if(r?.id)headersById.set(String(r.id),r);
        if(r?.numero)headersByNumber.set(String(r.numero).trim(),r);
      });
    }

    const missingNumbers=numbers.filter(n=>!headersByNumber.has(n));
    for(let i=0;i<missingNumbers.length;i+=80){
      const {data,error}=await sb
        .from('solicitudes_prestamo')
        .select('id,numero,estado,estado_atencion')
        .in('numero',missingNumbers.slice(i,i+80));
      if(error)throw error;
      (data||[]).forEach(r=>{
        if(r?.id)headersById.set(String(r.id),r);
        if(r?.numero)headersByNumber.set(String(r.numero).trim(),r);
      });
    }
  }catch(error){
    console.warn('V324 · No se pudo contrastar cabeceras de solicitudes:',error?.message||error);
  }

  return {headersById,headersByNumber};
}

function requestHeaderForV324(req,headers){
  const id=requestIdV324(req);
  const num=requestNumberV324(req);
  return (
    (id?headers.headersById.get(id):null)||
    (num?headers.headersByNumber.get(num):null)||
    null
  );
}

// ============================================================
// V325 · VALIDACIÓN SEGURA DEL ESTADO REAL DE LA SOLICITUD
//
// V324 intentaba contrastar directamente solicitudes_prestamo. Eso funciona
// para ARCHIVO/ADMIN, pero un USUARIO no necesariamente puede leer la cabecera
// de una solicitud creada por otra persona debido a RLS. El resultado era que
// una solicitud ya CERRADA POR ADMINISTRADOR podía seguir llegando desde la
// RPC V119 como si estuviera activa.
//
// La RPC v325_estado_solicitudes_busqueda expone únicamente id/número/estado
// y permite comprobar de forma segura si el ciclo anterior está realmente
// cerrado, sin revelar el detalle privado de la solicitud.
// ============================================================
async function loadRequestHeadersV325(byId){
  const headers=await loadRequestHeadersV324(byId);
  const ids=[];
  const numbers=[];

  for(const list of byId.values()){
    for(const req of (list||[])){
      const id=requestIdV324(req);
      const num=requestNumberV324(req);
      if(id)ids.push(id);
      if(num)numbers.push(num);
    }
  }

  const uniqueIds=[...new Set(ids)].slice(0,100);
  const uniqueNumbers=[...new Set(numbers)].slice(0,100);

  if(!uniqueIds.length && !uniqueNumbers.length)return headers;

  try{
    const {data,error}=await sb.rpc(
      'v325_estado_solicitudes_busqueda',
      {
        p_solicitud_ids:uniqueIds.length?uniqueIds:null,
        p_numeros:uniqueNumbers.length?uniqueNumbers:null
      }
    );

    if(error)throw error;

    (Array.isArray(data)?data:[]).forEach(r=>{
      const normalized={
        id:r?.solicitud_id||r?.id||null,
        numero:r?.numero||null,
        estado:r?.estado||null,
        estado_atencion:r?.estado_atencion||null,
        cerrado_terminal:!!r?.cerrado_terminal,
        cerrado_admin:!!r?.cerrado_admin
      };

      if(normalized.id){
        headers.headersById.set(String(normalized.id),normalized);
      }
      if(normalized.numero){
        headers.headersByNumber.set(String(normalized.numero).trim(),normalized);
      }
    });
  }catch(error){
    // Compatibilidad: si todavía no se ejecutó el SQL V325, el sistema no se
    // cae. Conserva el comportamiento V324 y deja el aviso en consola.
    console.warn(
      'V325 · Falta o falló v325_estado_solicitudes_busqueda:',
      error?.message||error
    );
  }

  return headers;
}


// ============================================================
// V326 · VALIDACIÓN DEL ESTADO POR SOLICITUD + EXPEDIENTE
//
// El cierre administrativo se registra en solicitud_expedientes.estado.
// La cabecera de solicitudes_prestamo puede conservar un estado anterior
// (por ejemplo ACEPTADO), por lo que revisar únicamente la cabecera no basta.
// Esta validación mínima y segura decide por cada expediente si el ciclo
// anterior ya terminó y, por tanto, no debe bloquear una nueva solicitud.
// ============================================================
async function loadRequestItemStatesV326(byId){
  const requestIds=[];
  const requestNumbers=[];
  const expedienteIds=[...new Set([...byId.keys()].map(x=>String(x||'').trim()).filter(Boolean))];

  for(const list of byId.values()){
    for(const req of (list||[])){
      const id=requestIdV324(req);
      const num=requestNumberV324(req);
      if(id)requestIds.push(id);
      if(num)requestNumbers.push(num);
    }
  }

  const ids=[...new Set(requestIds)].slice(0,150);
  const numbers=[...new Set(requestNumbers)].slice(0,150);
  const exps=expedienteIds.slice(0,150);
  const byRequestExp=new Map();
  const byNumberExp=new Map();

  if((!ids.length && !numbers.length) || !exps.length){
    return {byRequestExp,byNumberExp};
  }

  try{
    const {data,error}=await sb.rpc(
      'v326_estado_solicitud_expediente_busqueda',
      {
        p_solicitud_ids:ids.length?ids:null,
        p_numeros:numbers.length?numbers:null,
        p_expediente_ids:exps
      }
    );
    if(error)throw error;

    (Array.isArray(data)?data:[]).forEach(r=>{
      const row={
        solicitud_id:String(r?.solicitud_id||'').trim(),
        numero:String(r?.numero||'').trim(),
        expediente_id:String(r?.expediente_id||'').trim(),
        estado_solicitud:r?.estado_solicitud||null,
        estado_atencion:r?.estado_atencion||null,
        estado_item:r?.estado_item||null,
        cerrado_terminal:!!r?.cerrado_terminal,
        cerrado_admin:!!r?.cerrado_admin
      };
      if(!row.expediente_id)return;
      if(row.solicitud_id)byRequestExp.set(`${row.solicitud_id}::${row.expediente_id}`,row);
      if(row.numero)byNumberExp.set(`${row.numero}::${row.expediente_id}`,row);
    });
  }catch(error){
    console.warn(
      'V326 · Falta o falló v326_estado_solicitud_expediente_busqueda:',
      error?.message||error
    );
  }

  return {byRequestExp,byNumberExp};
}

function requestItemStateForV326(expedienteId,req,states){
  const exp=String(expedienteId||'').trim();
  const id=requestIdV324(req);
  const num=requestNumberV324(req);
  if(!exp)return null;
  return (
    (id?states.byRequestExp.get(`${id}::${exp}`):null)||
    (num?states.byNumberExp.get(`${num}::${exp}`):null)||
    null
  );
}

function activeRequestNoticeText(row){
  if(row._activeLookupFailed)return 'No se pudo verificar si tiene una solicitud activa. Vuelva a buscar.';
  return (row._activeRequests||[]).map(r=>
    `Solicitado por ${r.solicitante||'usuario no informado'} · ${r.fecha_solicitud?fmtDate(r.fecha_solicitud):'fecha no informada'} · ${requestStateDisplayName(r.estado_item||r.estado_atencion||r.estado||'NO INFORMADO')}`
  ).join(' / ');
}
function activeRequestNoticeHtml(row){
  const label=row._activeLookupFailed?'VERIFICACIÓN PENDIENTE':'SOLICITUD ACTIVA';
  return `<span class="pill alert">${label}</span><span class="active-request-brief">${esc(activeRequestNoticeText(row))}</span>`;
}


function existingPendingReassignHtmlV481(row){
  const pending=row?._existingPendingReassignV481||{};
  const owner=
    pending.responsable_actual_nombre||
    row?.responsable_actual||
    'responsable actual';

  const when=pending.created_at
    ?`${fmtDate(pending.created_at)}${masterValueHasExplicitTime(pending.created_at)?' · '+fmtTime(pending.created_at):''}`
    :'fecha no informada';

  return `<span class="pill alert">REASIGNACIÓN YA SOLICITADA</span>
    <span class="request-custody-warning">
      La solicitud de reasignación ya fue enviada a <b>${esc(owner)}</b>
      el ${esc(when)} y continúa <b>PENDIENTE</b>.<br>
      No se genera una segunda solicitud para el mismo expediente.
    </span>`;
}


// ============================================================
// V327 · FUENTE REAL DE SOLICITUDES ACTIVAS
// consultar_solicitudes_activas_busqueda_v327 ya descarta en Supabase los
// ítems CERRADO POR ADMINISTRADOR y demás estados terminales. De esta forma
// un ciclo histórico nunca vuelve a bloquear una nueva solicitud.
// ============================================================
async function annotateActiveRequestsV119(rows){
  if(!rows.length)return rows;
  const ids=[...new Set(rows.map(r=>r.id).filter(Boolean))];
  const byId=new Map();
  // V328: recordar si la fuente primaria V327 respondió correctamente.
  // Cuando V327 devuelve [] para un expediente, ese resultado es definitivo:
  // no existe una solicitud activa que deba bloquear un nuevo ciclo.
  let v327SourceConfirmed=true;
  try{
    for(let i=0;i<ids.length;i+=80){
      const chunk=ids.slice(i,i+80);
      // V327: la fuente primaria ya excluye ciclos terminales (incluido
      // CERRADO POR ADMINISTRADOR) directamente desde solicitud_expedientes.
      // Si la RPC aún no está instalada, se conserva V119 como respaldo.
      let data=null;
      let error=null;
      ({data,error}=await sb.rpc('consultar_solicitudes_activas_busqueda_v327',{p_expediente_ids:chunk.map(String)}));
      if(error){
        v327SourceConfirmed=false;
        console.warn('V327 · RPC activa no disponible; usando V119:',error?.message||error);
        ({data,error}=await sb.rpc('consultar_solicitudes_activas_busqueda_v119',{p_expediente_ids:chunk}));
      }
      if(error)throw error;
      if(!Array.isArray(data))throw Error('Respuesta de verificación inválida');
      data.forEach(r=>{if(Array.isArray(r.solicitudes))byId.set(String(r.expediente_id),r.solicitudes)});
      // V327 devuelve siempre una fila por expediente consultado, incluso si
      // no tiene solicitudes activas; por eso [] significa DISPONIBLE.
      if(chunk.some(id=>!byId.has(String(id))))throw Error('Verificación incompleta');
    }

    const headers=await loadRequestHeadersV325(byId);
    const itemStatesV326=await loadRequestItemStatesV326(byId);

    return rows.map(r=>{
      const rawRequests=byId.get(String(r.id))||[];
      const requests=[];
      const closedRequests=[];
      let closedAdminHistory=false;

      for(const req of rawRequests){
        const header=requestHeaderForV324(req,headers);
        const itemState=requestItemStateForV326(String(r.id),req,itemStatesV326);
        const evaluatedReq=itemState
          ?{
              ...req,
              estado_item:itemState.estado_item||req?.estado_item||null,
              estado:itemState.estado_solicitud||req?.estado||null,
              estado_atencion:itemState.estado_atencion||req?.estado_atencion||null
            }
          :req;

        const terminal=!!itemState?.cerrado_terminal || requestIsTerminalForNewCycleV324(evaluatedReq,header);
        const closedByAdmin=!!itemState?.cerrado_admin || requestIsClosedByAdminV324(evaluatedReq,header);

        if(terminal){
          closedRequests.push(evaluatedReq);
          if(closedByAdmin)closedAdminHistory=true;
        }else{
          requests.push(evaluatedReq);
        }
      }

      const physical=norm(r.estado_operativo||r.ultimo_estado||r.estado||'');
      const next={
        ...r,
        _activeRequests:requests,
        _closedRequestsV322:closedRequests,
        _closedAdminHistoryV324:closedAdminHistory,
        _activeLookupFailed:false
      };

      // ========================================================
      // V328 · LIBERAR EL BLOQUEO OBSOLETO DE LA BÚSQUEDA BASE
      //
      // buscar_expedientes_para_solicitud_v2 puede devolver disponible=false
      // y un motivo "SOLICITUD ACTIVA..." basado en un ciclo histórico.
      // Si la RPC V327 confirmó [] para este expediente, ese bloqueo ya no es
      // válido. Se elimina únicamente ese motivo de solicitud activa; los
      // bloqueos físicos reales (préstamo, reasignación, derivaciones, etc.)
      // continúan intactos.
      // ========================================================
      const baseReason=String(next.motivo||'').toUpperCase();
      const staleActiveRequestBlock=
        v327SourceConfirmed &&
        rawRequests.length===0 &&
        (baseReason.includes('SOLICITUD ACTIVA') ||
         baseReason.includes('SOLICITUD VIGENTE') ||
         baseReason.includes('YA TIENE UNA SOLICITUD'));

      if(staleActiveRequestBlock){
        const physicallyOutsideArchive=[
          'EN PRÉSTAMO','REASIGNADO','DEVOLUCIÓN SOLICITADA',
          'DERIVADO AL CONAS','DERIVADO A CONAS',
          'DERIVADO A LA DVC','DERIVADO A DVC',
          'DERIVADO A INSTRUCCIÓN','DERIVADO A INSTRUCCION'
        ].includes(physical);

        if(!physicallyOutsideArchive && !next._referralDestination && !next._instruction_active){
          next.disponible=true;
          next.solicitud_interna=false;
          next.solicitud_otra_area=false;
          next.usar_reasignacion_interna=false;
          next._v328_resolicitable=true;
          next.motivo='El ciclo anterior ya no está activo. Puede generar una nueva solicitud independiente.';
        }
      }

      // Solamente una solicitud realmente vigente puede bloquear un nuevo ciclo.
      const blocked=requests.length>0 &&
        ['DEVUELTO','DEVUELTO AL ARCHIVO','CUSTODIA','PENDIENTE POR ATENDER'].includes(physical);

      if(blocked){
        next.disponible=false;
        next.motivo=activeRequestNoticeText(next);
        return next;
      }

      // Si el único antecedente es un cierre administrativo, el expediente
      // puede volver a pedirse. Se conserva íntegro el historial anterior.
      if(!requests.length && closedAdminHistory){
        const owner=norm(next.responsable_actual||next.responsable||'');
        const physicallyOutsideArchive=[
          'EN PRÉSTAMO','REASIGNADO','DEVOLUCIÓN SOLICITADA',
          'DERIVADO AL CONAS','DERIVADO A CONAS',
          'DERIVADO A LA DVC','DERIVADO A DVC',
          'DERIVADO A INSTRUCCIÓN','DERIVADO A INSTRUCCION'
        ].includes(physical);

        if(!physicallyOutsideArchive && !next._referralDestination && !next._instruction_active){
          next.disponible=true;
          next.solicitud_interna=false;
          next.solicitud_otra_area=false;
          next.usar_reasignacion_interna=false;
          next._v324_resolicitable=true;
          next.motivo='La solicitud anterior fue cerrada por el Administrador. Puede generar una nueva solicitud independiente.';
        }else if((owner==='ARCHIVO'||owner.includes('ARCHIVO')) && !next._referralDestination && !next._instruction_active){
          next.disponible=true;
          next._v324_resolicitable=true;
          next.motivo='La solicitud anterior fue cerrada por el Administrador. Puede generar una nueva solicitud independiente.';
        }
      }

      return next;
    });
  }catch(error){
    console.warn('Verificación de solicitud activa:',error?.message||error);
    return rows.map(r=>({...r,disponible:false,_activeLookupFailed:true,
      motivo:'No se pudo verificar si tiene una solicitud activa. Vuelva a buscar. Si persiste, Archivo debe comprobar que la consulta V119 esté instalada.'}));
  }
}

// ============================================================
/* V187 · BÚSQUEDA RÁPIDA PARA NUEVA SOLICITUD
   - caché temporal por expediente/extensión
   - evita repetir consultas si el usuario busca el mismo expediente
   - conserva exactitud: caché corta de 30 segundos
*/
const V187_REQUEST_LOOKUP_CACHE_TTL=30000;
const v187RequestLookupCache=new Map();

function requestLookupCacheKeyV187(expediente,extension=''){
  return `${norm(expediente||'')}::${norm(extension||'')}`;
}

function getRequestLookupCacheV187(expediente,extension=''){
  const key=requestLookupCacheKeyV187(expediente,extension);
  const cached=v187RequestLookupCache.get(key);

  if(
    !cached ||
    (Date.now()-cached.savedAt)>V187_REQUEST_LOOKUP_CACHE_TTL
  ){
    if(cached)v187RequestLookupCache.delete(key);
    return null;
  }

  return {
    rows:(cached.rows||[]).map(r=>({...r})),
    baseRows:(cached.baseRows||[]).map(r=>({...r})),
    registeredExtensions:[...(cached.registeredExtensions||[])]
  };
}

function setRequestLookupCacheV187(expediente,extension,payload){
  const key=requestLookupCacheKeyV187(expediente,extension);
  v187RequestLookupCache.set(key,{
    savedAt:Date.now(),
    rows:(payload.rows||[]).map(r=>({...r})),
    baseRows:(payload.baseRows||[]).map(r=>({...r})),
    registeredExtensions:[...(payload.registeredExtensions||[])]
  });
}

function invalidateRequestLookupCacheV187(){
  v187RequestLookupCache.clear();
}

let internalReassignLoadedAtV187=0;

let requestLookupSequence=0;
function invalidateRequestLookup(){
  requestLookupSequence++;
  requestSearchRows=[];
  requestSearchSelectedIds.clear();
  updateRequestLookupSelection();
  showNewExpRequestOption(false);
  el('requestLookupStatus').textContent='Pulsa Buscar para consultar el número y la extensión indicados.';
  el('requestLookupResults').innerHTML='<div class="empty">Listo para una nueva búsqueda.</div>';
}

// ============================================================
// V506 · DEVUELTO AL ARCHIVO = NUEVO CICLO SOLICITABLE
//
// Regla:
// - Si el expediente ya está físicamente en CUSTODIA / ARCHIVO o DEVUELTO
//   AL ARCHIVO, un pedido del ciclo ANTERIOR no puede seguir bloqueándolo.
// - Solo una solicitud realmente creada DESPUÉS de la última devolución
//   conserva el bloqueo.
// - Se aplica a búsqueda manual y carga Excel.
// ============================================================
function v506DateMs(value){
  if(!value)return NaN;
  const s=String(value).trim();
  if(!s)return NaN;

  // dd/mm/yyyy [hh:mm]
  let m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})(?:\s+[·-]?\s*(\d{1,2}):(\d{2})(?::(\d{2}))?)?/);
  if(m){
    return new Date(
      Number(m[3]),Number(m[2])-1,Number(m[1]),
      Number(m[4]||0),Number(m[5]||0),Number(m[6]||0)
    ).getTime();
  }

  const parsed=Date.parse(s);
  return Number.isFinite(parsed)?parsed:NaN;
}

function v506ReturnDateValue(row){
  return (
    row?.fecha_devolucion ||
    row?.fecha_ultimo_estado ||
    row?.fecha_retorno ||
    row?.updated_at ||
    null
  );
}

function v506RequestDateValue(req){
  return (
    req?.fecha_solicitud ||
    req?.solicitud_created_at ||
    req?.created_at ||
    req?.fecha_registro ||
    req?.updated_at ||
    null
  );
}

function v506RequestBelongsToOldCycle(req,row){
  const returned=v506DateMs(v506ReturnDateValue(row));
  const requested=v506DateMs(v506RequestDateValue(req));

  if(!Number.isFinite(returned) || !Number.isFinite(requested))return false;

  // Estrictamente anterior. Si ambos valores solo tienen fecha y coinciden,
  // se conserva el bloqueo por seguridad porque no puede saberse cuál ocurrió primero.
  return requested < returned;
}

function v506NormalizeReturnedAvailability(rows){
  return (Array.isArray(rows)?rows:[]).map(raw=>{
    const row={...raw};

    if(
      typeof isReturnedToArchiveForNewRequestV422!=='function' ||
      !isReturnedToArchiveForNewRequestV422(row) ||
      row?._activeLookupFailed ||
      row?._referralDestination ||
      row?._instruction_active ||
      row?._existingPendingReassignV481
    ){
      return row;
    }

    const active=Array.isArray(row._activeRequests)?row._activeRequests:[];
    const current=active.filter(req=>!v506RequestBelongsToOldCycle(req,row));

    // Si todas las solicitudes "activas" son anteriores a la última devolución,
    // pertenecen al ciclo cerrado y dejan de bloquear el nuevo pedido.
    if(active.length && current.length===0){
      row._activeRequests=[];
      row.disponible=true;
      row.solicitud_interna=false;
      row.solicitud_otra_area=false;
      row.usar_reasignacion_interna=false;
      row.responsable_actual='ARCHIVO';
      row.area_trabajo=null;
      row._v506_returned_resolicitable=true;
      row.estado_operativo='DEVUELTO AL ARCHIVO';
      row.motivo='DISPONIBLE · El expediente ya fue devuelto al Archivo. Puede generar una nueva solicitud independiente.';
      return row;
    }

    // Si no existe ninguna solicitud activa comprobada, el estado físico en Archivo
    // también libera cualquier "NO DISPONIBLE" heredado de la búsqueda base.
    if(active.length===0){
      row.disponible=true;
      row.solicitud_interna=false;
      row.solicitud_otra_area=false;
      row.usar_reasignacion_interna=false;
      row.responsable_actual='ARCHIVO';
      row.area_trabajo=null;
      row._v506_returned_resolicitable=true;
      row.estado_operativo='DEVUELTO AL ARCHIVO';
      row.motivo='DISPONIBLE · Expediente bajo custodia de Archivo. Puede generar una nueva solicitud independiente.';
      return row;
    }

    // Hay una solicitud posterior a la devolución: esa sí sigue vigente.
    row._activeRequests=current;
    row.disponible=false;
    if(typeof activeRequestNoticeText==='function'){
      row.motivo=activeRequestNoticeText(row)||row.motivo;
    }
    return row;
  });
}

// ============================================================
// V188 · FAST PATH DEL BUSCADOR DE NUEVA SOLICITUD
//
// Para una búsqueda normal:
//  1) consultar primero el expediente;
//  2) mostrarlo inmediatamente como "VERIFICANDO...";
//  3) ejecutar las validaciones restantes en paralelo;
//  4) resolver acumulados solo si la búsqueda directa no encontró filas.
//
// Esto reduce de forma importante los viajes secuenciales a Supabase.
// ============================================================

// V422 · Un expediente que ya fue DEVUELTO AL ARCHIVO está nuevamente
// bajo custodia física de Archivo. En ese caso corresponde una NUEVA
// SOLICITUD NORMAL; nunca una solicitud de reasignación directa.
function isReturnedToArchiveForNewRequestV422(r){
  if(!r)return false;

  const state=norm(
    r.estado_operativo ||
    r.ultimo_estado ||
    r.estado ||
    operationalStatus(r) ||
    ''
  );

  const owner=norm(
    requestCurrentCustodianV120(
      state,
      r.responsable_actual || r.responsable || ''
    ) || ''
  );

  // V660 · El atajo de búsqueda exacta puede partir directamente del maestro.
  // En ese caso `ultimo_estado` puede ser un antecedente administrativo
  // (p. ej. CERRADO POR ADMINISTRADOR), aunque físicamente el expediente ya
  // esté en CUSTODIA de ARCHIVO DE GESTIÓN. La disponibilidad física debe
  // evaluarse también con el estado maestro y la ubicación real.
  const masterState=norm(r.estado||'');
  const rawOwner=norm(r.responsable_actual||r.responsable||'');
  const physicallyInArchive=
    masterState==='CUSTODIA' &&
    (rawOwner==='ARCHIVO' || rawOwner.includes('ARCHIVO'));

  return (
    ['DEVUELTO AL ARCHIVO','DEVUELTO'].includes(state) ||
    (state==='CUSTODIA' && (owner==='ARCHIVO' || owner.includes('ARCHIVO'))) ||
    physicallyInArchive
  );
}

function isDirectReassignRowV191(r){
  return !!(
    canRequestDirectReassignV466() &&
    r &&
    !r._existingPendingReassignV481 &&
    !r._activeLookupFailed && !r._instruction_active &&
    !isReturnedToArchiveForNewRequestV422(r) &&
    r.solicitud_interna &&
    r.usar_reasignacion_interna &&
    !r._referralDestination
  );
}

// V785 · El responsable se identifica una sola vez: nombre y área en su columna.
// La disponibilidad solo explica el tipo de acción, sin repetir personas.
function requestOwnerWithAreaV785(r,ownerOverride){
  const owner=String(ownerOverride??r?.responsable_actual??r?.responsable??'').trim()||'—';
  let area='';
  try{
    if(typeof catalogPersonByName==='function'){
      const person=catalogPersonByName(owner);
      area=String(person?.area_trabajo||'').trim();
    }
  }catch(_){ }
  if(!area){
    // La fila puede venir directamente de la consulta de Supabase.
    area=String(r?.area_trabajo||'').trim();
  }
  const id=String(r?.expediente_id||r?.id||'').trim();
  const areaText=area?'Área: '+area:'Área no registrada';
  return `<span class="v785-owner-name">${esc(owner)}</span>`+
    `<span class="v785-owner-area"${id?` data-v785-owner-id="${esc(id)}"`:''}>${esc(areaText)}</span>`;
}
// V791 · La disponibilidad describe la custodia física y la acción autorizada.
// Nunca deducir el custodio del SOLICITANTE de un ciclo histórico; usar el
// responsable ACTUAL validado por la búsqueda y las fuentes de custodia.
function requestCurrentOtherCustodianV791(r){
  if(!r || r._v188_verifying || r._activeLookupFailed || r._referralDestination || r._instruction_active)return null;
  if(typeof isReturnedToArchiveForNewRequestV422==='function' && isReturnedToArchiveForNewRequestV422(r))return null;
  const modalidad=norm(el('rqModalidad')?.value||'PRÉSTAMO');
  if(modalidad==='COPIA DIGITAL')return null; // no cambia la custodia física

  const state=norm(r.estado_operativo||r.ultimo_estado||r.estado||'');
  if(!['EN PRÉSTAMO','REASIGNADO','DEVOLUCIÓN SOLICITADA','CUSTODIA'].includes(state)
     && !r.solicitud_interna)return null;

  const current=String(requestCurrentCustodianV120(
    state, r.responsable_actual||r.responsable||''
  )||'').trim();
  if(!current || ['ARCHIVO','ARCHIVO DE GESTIÓN','ARCHIVO CENTRAL','POR VERIFICAR',
      'SAN LUIS','INSTRUCCIÓN','CONAS','DVC','DSF-PA'].includes(norm(current)))return null;

  // Solo nombres personales verificados. Una ubicación o el autor de la
  // solicitud antigua no son prueba de tenencia física.
  const self=norm(current)===norm(currentProfile?.nombre_personal||'');
  let profile=null;
  try{profile=custodianProfileByNameV236(current)}catch(_){profile=null}
  const known=self || r._v792_reasignacion_validada===true ||
    (!!profile && (isDirectReassignCustodianRoleV236(profile.rol) ||
      (r.solicitud_interna && r.usar_reasignacion_interna)));
  if(!known && !(r.solicitud_interna && r.usar_reasignacion_interna))return null;
  return {nombre:current,propio:self,habilitada:!self && isDirectReassignRowV191(r) &&
    !r._existingPendingReassignV481};
}
// V792 · Mensaje compacto: la columna Responsable ya identifica al custodio.
// Mostrar solo el trámite que corresponde; nunca "Solicitud activa" por el
// préstamo vigente que es el origen de la reasignación.
function requestCustodyAvailabilityHtmlV791(r){
  const custody=requestCurrentOtherCustodianV791(r);
  if(!custody)return '';
  if(custody.propio){
    return '<span class="pill">EN TU PODER</span>';
  }
  return '<span class="v792-requiere-reasignacion" title="El expediente está en poder de otro usuario. No corresponde solicitar préstamo al Archivo.">REQUIERE REASIGNACIÓN</span>';
}
function requestCustodyStatusTextV791(r){
  const data=requestCurrentOtherCustodianV791(r);
  if(!data)return '';
  if(data.propio)return 'Este expediente ya se encuentra bajo tu custodia.';
  const persona=data.nombre;
  return data.habilitada
    ?`Expediente en poder de ${persona}. Requiere reasignación: selecciónalo para solicitarla al custodio actual. No corresponde pedirlo al Archivo.`
    :`Expediente en poder de ${persona}. Requiere reasignación al custodio actual; no corresponde solicitar un préstamo al Archivo. Utiliza un perfil autorizado.`;
}
function directReassignAvailabilityHtmlV191(r){
  return requestCustodyAvailabilityHtmlV791(r)||
    '<span class="pill returned">REASIGNACIÓN DIRECTA</span>';
}

function requestMergeRowsByIdV188(baseRows,...variants){
  const map=new Map(
    (baseRows||[]).map(r=>[
      String(r.id||r.expediente_id||''),
      {...r}
    ])
  );

  variants.forEach(rows=>{
    (Array.isArray(rows)?rows:[]).forEach(r=>{
      const key=String(r.id||r.expediente_id||'');
      if(!key)return;

      const current=map.get(key)||{};
      map.set(key,{...current,...r});
    });
  });

  return [...map.values()];
}

function renderRequestPreliminaryV188(rows){
  requestSearchRows=(rows||[]).map(r=>({
    ...r,
    _v188_verifying:true
  }));

  requestSearchSelectedIds.clear();

  el('requestLookupStatus').textContent=
    requestSearchRows.length===1
      ?'Expediente encontrado. Verificando disponibilidad...'
      :`${requestSearchRows.length} variantes encontradas. Verificando disponibilidad...`;

  renderRequestLookupResults();
}

async function validateRequestRowsFastV188(baseRows){
  let rows=Array.isArray(baseRows)?baseRows:[];
  if(!rows.length)return rows;

  // Primera y única dependencia necesaria:
  // completar el estado/custodia vigente.
  const custodyRows=await enrichRequestCustodyContext(rows);

  // El resto de validaciones ya puede ejecutarse simultáneamente.
  const jobs=[
    annotateActiveRequestsV119(custodyRows),
    annotateReferralsV124(custodyRows,false,true)
  ];

  const needsDirectReassignV481=canRequestDirectReassignV466();
  const needsInstructionReturnV481=hasFullAccess();

  if(needsDirectReassignV481){
    jobs.push(
      annotateInternalReassignEligibility(custodyRows),
      filterAlreadyRequestedInternalReassign(custodyRows)
    );
  }

  // ARCHIVO conserva además su flujo especial de retorno desde Instrucción.
  if(needsInstructionReturnV481){
    jobs.push(
      annotateInstructionReturnEligibility(custodyRows)
    );
  }

  const settled=await Promise.allSettled(jobs);

  let activeRows=custodyRows;
  let referralRows=custodyRows;
  let internalRows=custodyRows;
  let filteredRows=custodyRows;
  let instructionRows=custodyRows;

  let cursor=0;

  if(settled[cursor]?.status==='fulfilled'){
    activeRows=settled[cursor].value;
  }
  cursor++;

  if(settled[cursor]?.status==='fulfilled'){
    referralRows=settled[cursor].value;
  }
  cursor++;

  if(needsDirectReassignV481){
    if(settled[cursor]?.status==='fulfilled'){
      internalRows=settled[cursor].value;
    }
    cursor++;

    if(settled[cursor]?.status==='fulfilled'){
      filteredRows=settled[cursor].value;
    }
    cursor++;
  }

  if(needsInstructionReturnV481){
    if(settled[cursor]?.status==='fulfilled'){
      instructionRows=settled[cursor].value;
    }
    cursor++;
  }

  // Precedencia:
  // custodia -> reasignación interna -> instrucción -> solicitud activa
  // -> derivaciones. Las derivaciones quedan al final porque son bloqueo físico.
  // V191 · La solicitud activa que originó la custodia del usuario actual
  // NO debe bloquear una nueva solicitud de reasignación.
  // Por eso la elegibilidad de REASIGNACIÓN DIRECTA se aplica DESPUÉS
  // de la consulta de solicitudes activas. Una derivación externa sigue
  // teniendo la última palabra porque el expediente ya no está con el usuario.
  let merged=requestMergeRowsByIdV188(
    custodyRows,
    activeRows,
    instructionRows,
    internalRows,
    referralRows
  );

  if(needsDirectReassignV481){
    // V481 · filteredRows ya no elimina solicitudes pendientes:
    // las conserva anotadas para explicar el bloqueo sin duplicarlas.
    const filteredMap=new Map(
      (filteredRows||[]).map(r=>[
        String(r.id||r.expediente_id||''),
        r
      ])
    );

    merged=merged.map(r=>{
      const key=String(r.id||r.expediente_id||'');
      const filtered=filteredMap.get(key);
      return filtered
        ?{...r,...filtered}
        :r;
    });
  }

  // V329 · La validación de solicitudes activas es la autoridad para decidir
  // si un cierre administrativo todavía bloquea un nuevo ciclo. Durante la
  // combinación de validaciones, referralRows/internalRows nacen de custodyRows
  // y pueden volver a copiar el `disponible=false` legado de la búsqueda base.
  // Guardamos el resultado V327/V328 por expediente y lo reaplicamos al final,
  // después de combinar todas las fuentes.
  const activeValidationById=new Map(
    (activeRows||[]).map(x=>[
      String(x?.id||x?.expediente_id||''),
      x
    ])
  );

  // V792: la unión de filas priorizaba la copia del buscador/derivaciones
  // por encima de la verificación de reasignación. Mantener su resultado
  // por ID y restablecerlo al FINAL (sin omitir bloqueos legítimos).
  const reassignValidatedByIdV792=new Map(
    (needsDirectReassignV481?internalRows:[]).map(x=>[
      String(x?.id||x?.expediente_id||''),x
    ])
  );

  return merged.map(r=>{
    const next={...r};
    const key=String(next.id||next.expediente_id||'');
    const activeValidated=activeValidationById.get(key)||null;

    // V329 · Si V327 confirmó que ya NO existe solicitud activa y V328 marcó
    // el expediente como resolicitable, no permitir que otra anotación vuelva
    // a restaurar el bloqueo histórico "SOLICITUD ACTIVA...".
    if(
      activeValidated?._v328_resolicitable &&
      activeValidated?.disponible &&
      !next._referralDestination &&
      !next._instruction_active
    ){
      next.disponible=true;
      next.solicitud_interna=false;
      next.solicitud_otra_area=false;
      next.usar_reasignacion_interna=false;
      next._v328_resolicitable=true;
      next._v329_resolicitable=true;
      next._activeRequests=[];
      next._activeLookupFailed=false;
      next.motivo=activeValidated.motivo||
        'El ciclo anterior ya no está activo. Puede generar una nueva solicitud independiente.';
    }

    // V422 · Protección final: un expediente físicamente DEVUELTO AL ARCHIVO
    // debe continuar por solicitud normal aunque alguna fuente auxiliar haya
    // devuelto responsable/área con datos históricos.
    if(isReturnedToArchiveForNewRequestV422(next)){
      next.solicitud_interna=false;
      next.solicitud_otra_area=false;
      next.usar_reasignacion_interna=false;
      next.responsable_actual='ARCHIVO';
      next.area_trabajo=null;
      if(next.disponible){
        next.motivo='DISPONIBLE · Expediente devuelto al Archivo. Puede generar una nueva solicitud de préstamo.';
      }
    }

    // V792 · La solicitud de préstamo VIGENTE no bloquea la reasignación.
    // La autorización se restablece después de unir todas las fuentes,
    // únicamente cuando la validación original la habilitó y no hay otra
    // reasignación pendiente, derivación externa ni devolución a Archivo.
    const internaVerificadaV792=reassignValidatedByIdV792.get(key);
    const modalidadV792=norm(el('rqModalidad')?.value||'PRÉSTAMO');
    const puedeRestituirV792=
      canRequestDirectReassignV466() && modalidadV792==='PRÉSTAMO' &&
      internaVerificadaV792?._v792_reasignacion_validada===true &&
      !next._existingPendingReassignV481 &&
      !next._activeLookupFailed && !next._referralDestination &&
      !next._instruction_active && !next._v188_verifying &&
      !isReturnedToArchiveForNewRequestV422(next);
    if(puedeRestituirV792){
      next.disponible=true;
      next.solicitud_interna=true;
      next.solicitud_otra_area=false;
      next.usar_reasignacion_interna=true;
      next._v792_reasignacion_validada=true;
      next.responsable_actual=internaVerificadaV792.responsable_actual||next.responsable_actual;
    }

    // V191 · Expediente con OTRO USUARIO:
    // aunque exista una solicitud activa del ciclo que lo mantiene en préstamo,
    // debe poder seleccionarse para solicitar su REASIGNACIÓN DIRECTA.
    if(isDirectReassignRowV191(next) && !next._existingPendingReassignV481){
      next.disponible=true;
      next.solicitud_otra_area=false;
      next.motivo=
        `REASIGNACIÓN DIRECTA · Actualmente con ${next.responsable_actual||'otro usuario'}. `+
        'Seleccione para enviar la solicitud de reasignación.';
    }

    if(next._existingPendingReassignV481){
      next.disponible=false;
      next.solicitud_interna=true;
      next.usar_reasignacion_interna=true;
    }

    delete next._v188_verifying;
    return next;
  });
}

async function searchRequestCandidates(){
  const lookupSequence=++requestLookupSequence;
  const lookupIsCurrent=()=>lookupSequence===requestLookupSequence;

  requestSearchRows=[];
  requestSearchSelectedIds.clear();
  updateRequestLookupSelection();

  const t0=performance.now();

  try{
    const raw=el('requestLookupInput').value.trim();
    const extensionRaw=el('requestLookupExtension')?.value||'';

    const parsed=parseRequestLookupNumberAndExtension(
      raw,
      extensionRaw
    );

    const q=parsed.expediente;
    const extension=parsed.extension;

    if(q.length<4){
      el('requestLookupStatus').textContent=
        'Ingrese al menos 4 caracteres.';
      showNewExpRequestOption(false);
      return;
    }

    el('requestLookupInput').value=q;
    updateRequestExtensionRequirementV265();

    const extensionPolicy=requestExtensionValidationV265(q,extension);
    if(extensionPolicy.required&&!extensionPolicy.ok){
      const msg=requestExtensionRuleMessageV265(q,extension);
      el('requestLookupStatus').textContent=msg;
      el('requestLookupResults').innerHTML=`<div class="request-extension-warning"><b>Extensión obligatoria.</b><br>${esc(msg)}</div>`;
      showNewExpRequestOption(false);
      el('requestLookupExtension')?.focus();
      return;
    }

    if(el('requestLookupExtension')){
      el('requestLookupExtension').value=extension;
    }

    el('requestLookupStatus').textContent=
      extension
        ?`Buscando ${q} · ${extension}...`
        :`Buscando ${q}...`;

    el('requestLookupResults').innerHTML=
      '<div class="empty">Localizando expediente...</div>';

    showNewExpRequestOption(false);

    let effectiveSearch=q;
    let effectiveExtension=extension;
    let accumulatedResolution=null;

    // 1. CACHÉ
    const cachedLookup=getRequestLookupCacheV187(q,extension);

    if(cachedLookup && Array.isArray(cachedLookup.rows) && cachedLookup.rows.length){
      requestSearchRows=v506NormalizeReturnedAvailability(cachedLookup.rows);
      requestSearchSelectedIds.clear();

      if(effectiveExtension){
        requestSearchRows=requestRowsMatchingExtension(
          requestSearchRows,
          effectiveExtension
        );
      }

      renderRequestLookupResults();

      console.info(
        `[V579 búsqueda] caché válida: ${Math.round(performance.now()-t0)} ms`
      );
      return;
    }

    // V579 · Nunca reutilizar una búsqueda vacía.
    // Si el primer intento no encontró filas, un segundo clic en Buscar
    // vuelve a consultar Supabase inmediatamente.
    if(cachedLookup && (!cachedLookup.rows || !cachedLookup.rows.length)){
      v187RequestLookupCache.delete(
        requestLookupCacheKeyV187(q,extension)
      );
    }

    // 2. BÚSQUEDA DIRECTA
    // No bloquear una búsqueda normal esperando la resolución de acumulados.
    let searchResult=null;

    // V501 · Para un número completo, consultar primero directamente el
    // registro maestro. Evita esperar el RPC de búsqueda general cuando el
    // usuario ya escribió exactamente NÚMERO-AÑO. Si RLS no permite esta
    // lectura o no hay coincidencia, se conserva automáticamente el RPC.
    if(/^\d+-\d{4}$/.test(q)){
      try{
        const direct=await sb
          .from('expedientes')
          .select('*')
          .eq('expediente',q)
          .limit(30);
        if(!direct?.error && Array.isArray(direct?.data) && direct.data.length){
          searchResult=direct;
          console.info(`[V501 búsqueda exacta] registro maestro: ${Math.round(performance.now()-t0)} ms`);
        }
      }catch(_){ }
    }

    if(!searchResult){
      searchResult=await sb.rpc(
        'buscar_expedientes_para_solicitud_v2',
        {p_busqueda:q}
      );
    }

    if(!lookupIsCurrent())return;

    if(searchResult?.error){
      el('requestLookupStatus').textContent=searchResult.error.message;
      el('requestLookupResults').innerHTML=
        '<div class="empty">No se pudo realizar la búsqueda.</div>';
      return;
    }

    let baseRows=searchResult?.data||[];

    // V330 · Mantener el selector de extensión sincronizado con las variantes encontradas.
    applyRequestExtensionOptionsFromRowsV330(q,baseRows,true);

    console.info(
      `[V188 búsqueda] base: ${Math.round(performance.now()-t0)} ms`
    );

    // 3. SOLO SI NO HUBO COINCIDENCIA DIRECTA:
    // revisar si el número buscado es un expediente acumulado.
    if(!baseRows.length){
      const resolved=await resolveAccumulatedLookup(q,extension);

      if(!lookupIsCurrent())return;

      if(resolved?._ambiguous_accumulated){
        const variants=resolved.variants||[];

        const detail=variants.map(v=>{
          const ext=v.extension_acumulado||'SIN EXTENSIÓN';
          const principal=v.expediente_principal||'—';
          const principalExt=v.extension_principal||'SIN EXTENSIÓN';

          return `<div style="margin-top:4px">
            • <b>${esc(q)} · ${esc(ext)}</b>
            → principal <b>${esc(principal)} · ${esc(principalExt)}</b>
          </div>`;
        }).join('');

        el('requestLookupStatus').textContent=
          `El número ${q} tiene más de una variante acumulada. Indique la extensión.`;

        el('requestLookupResults').innerHTML=
          `<div class="request-extension-warning">
            <b>La extensión es necesaria para identificar el expediente físico.</b>
            ${detail}
          </div>`;

        showNewExpRequestOption(false);
        updateRequestLookupSelection();
        return;
      }

      if(resolved?.es_acumulado && resolved?.expediente_principal){
        accumulatedResolution=resolved;
        effectiveSearch=resolved.expediente_principal;
        effectiveExtension=resolved.extension_principal||'';

        const principalResult=await sb.rpc(
          'buscar_expedientes_para_solicitud_v2',
          {p_busqueda:effectiveSearch}
        );

        if(!lookupIsCurrent())return;

        if(principalResult?.error){
          throw principalResult.error;
        }

        baseRows=principalResult?.data||[];
      }
    }

    const registeredExtensions=
      requestRegisteredExtensions(baseRows);

    // Si se indicó una extensión, acotar antes de las validaciones
    // para consultar solamente la variante necesaria.
    let validationBase=baseRows;

    if(effectiveExtension){
      const matching=requestRowsMatchingExtension(
        validationBase,
        effectiveExtension
      );

      // Si la extensión existe, validar exclusivamente esa fila.
      // Si no existe, conservar baseRows para el mensaje de nueva variante.
      if(matching.length){
        validationBase=matching;
      }
    }

    // 4. MOSTRAR DE INMEDIATO LO QUE SE ENCONTRÓ.
    if(validationBase.length){
      let preliminary=validationBase;

      if(accumulatedResolution){
        preliminary=preliminary.map(row=>({
          ...row,
          _busqueda_acumulada:true,
          _numero_solicitado_original:q,
          _extension_solicitada_original:extension||'',
          _expediente_principal_resuelto:
            accumulatedResolution.expediente_principal,
          _extension_principal_resuelta:
            accumulatedResolution.extension_principal||''
        }));
      }

      renderRequestPreliminaryV188(preliminary);
    }

    // 5. VALIDAR EN PARALELO
    let searchedRows=validationBase.length
      ?v506NormalizeReturnedAvailability(
          await validateRequestRowsFastV188(validationBase)
        )
      :[];

    if(!lookupIsCurrent())return;

    if(accumulatedResolution){
      searchedRows=searchedRows.map(row=>({
        ...row,
        _busqueda_acumulada:true,
        _numero_solicitado_original:q,
        _extension_solicitada_original:extension||'',
        _expediente_principal_resuelto:
          accumulatedResolution.expediente_principal,
        _extension_principal_resuelta:
          accumulatedResolution.extension_principal||''
      }));
    }

    if(effectiveExtension){
      searchedRows=requestRowsMatchingExtension(
        searchedRows,
        effectiveExtension
      );
    }

    requestSearchRows=searchedRows;
    requestSearchSelectedIds.clear();

    // V501 · Si la búsqueda fue exacta y existe una sola variante disponible,
    // dejarla seleccionada automáticamente. El usuario solo pulsa Agregar y
    // puede continuar con el siguiente número.
    if(
      /^\d+-\d{4}$/.test(q) &&
      requestSearchRows.length===1 &&
      typeof requestLookupRowCanSelectV193==='function' &&
      requestLookupRowCanSelectV193(requestSearchRows[0])
    ){
      requestSearchSelectedIds.add(requestSearchRows[0].id);
    }

    // V579 · Guardar en caché únicamente resultados efectivos.
    // Los resultados vacíos no deben impedir una segunda búsqueda.
    if(requestSearchRows.length){
      setRequestLookupCacheV187(
        q,
        extension,
        {
          rows:requestSearchRows,
          baseRows,
          registeredExtensions
        }
      );
    }else{
      v187RequestLookupCache.delete(
        requestLookupCacheKeyV187(q,extension)
      );
    }

    console.info(
      `[V188 búsqueda] total validado: ${Math.round(performance.now()-t0)} ms`
    );

    // 6. CASOS SIN RESULTADO FINAL
    if(!requestSearchRows.length){
      if(isLimitedUser()){
        if(
          !internalReassignLoadedAtV187 ||
          (Date.now()-internalReassignLoadedAtV187)>20000
        ){
          await loadInternalReassignRequests(true);
        }

        if(!lookupIsCurrent())return;

        const pendingIds=pendingSentInternalReassignIds();

        const rawIds=baseRows
          .map(x=>String(x.id||''))
          .filter(Boolean);

        const hiddenByPending=rawIds.some(
          id=>pendingIds.has(id)
        );

        if(hiddenByPending && !extension){
          el('requestLookupStatus').textContent=
            'La solicitud de reasignación de este expediente ya fue enviada y se encuentra pendiente de respuesta.';

          el('requestLookupResults').innerHTML=
            '<div class="empty">Este expediente ya no se muestra como disponible porque su reasignación interna está pendiente.</div>';

          showNewExpRequestOption(false);
          updateRequestLookupSelection();
          return;
        }
      }

      if(extension && baseRows.length){
        const extensionText=registeredExtensions.length
          ?registeredExtensions.join(', ')
          :'SIN EXTENSIÓN REGISTRADA';

        const allowed=requestValidExtensionsForExpediente(q);

        const validForYear=requestExtensionIsValidForExpediente(
          q,
          extension
        );

        if(!validForYear){
          const allowedText=(allowed||[]).join(', ')||'—';

          el('requestLookupStatus').textContent=
            `La extensión ${extension} no corresponde a las reglas registradas para ${q}.`;

          el('requestLookupResults').innerHTML=
            `<div class="request-extension-warning">
              <b>Revise la extensión antes de continuar.</b><br>
              Extensión ingresada: <b>${esc(extension)}</b><br>
              Extensiones válidas para ${esc(q)}:
              <b>${esc(allowedText)}</b>.<br>
              Variantes que actualmente existen en la base:
              <b>${esc(extensionText)}</b>.
            </div>`;

          showNewExpRequestOption(false);
          updateRequestLookupSelection();
          return;
        }

        el('requestLookupStatus').textContent=
          `El expediente ${q} existe, pero la variante ${extension} todavía no está registrada. Puede agregarla y solicitarla.`;

        // V789: para el Administrador, un registro sin extensión puede corregirse
        // sobre su mismo UUID, sin crear una segunda variante ni alterar el préstamo.
        const v789Oferta=typeof window.v789ExtensionOffer==='function'
          ?window.v789ExtensionOffer(baseRows,q,extension):'';
        el('requestLookupResults').innerHTML=
          `<div class="request-extension-warning">
            <b>${v789Oferta?'El expediente ya existe sin extensión.':'Se encontró el mismo número con otra extensión.'}</b><br>
            Extensión consultada: <b>${esc(q)} · ${esc(extension)}</b><br>
            Variantes registradas: <b>${esc(extensionText)}</b>.<br>
            ${v789Oferta||`<span style="color:#166534;font-weight:800">
              La nueva variante se registrará por separado y no modificará las existentes.
            </span>`}
          </div>`;

        showNewExpRequestOption(
          !v789Oferta,
          q,
          extension,
          'variant'
        );

        updateRequestLookupSelection();
        return;
      }

      if(/^\d+-\d{4}$/.test(q)){
        el('requestLookupStatus').textContent=
          'El expediente no está registrado. Puede ingresarlo por primera vez.';

        el('requestLookupResults').innerHTML=
          '<div class="empty">No existe en la base de datos.</div>';

        showNewExpRequestOption(
          true,
          q,
          extension,
          'new'
        );

        updateRequestLookupSelection();
        return;
      }
    }

    renderRequestLookupResults();

  }catch(error){
    if(!lookupIsCurrent())return;

    el('requestLookupStatus').textContent=
      'No se pudo completar la búsqueda. Inténtalo nuevamente.';

    el('requestLookupResults').innerHTML=
      '<div class="empty">Comprueba tu conexión y vuelve a buscar.</div>';

    console.error('Búsqueda de expedientes:',error);
  }
}

function fillInstructionRequestReturnLocations(){
  const sel=el('instructionRequestReturnLocation');
  if(!sel)return;

  const names=(catalogo||[])
    .filter(
      x=>x.activo!==false &&
         x.tipo!=='PERSONAL'
    )
    .map(x=>String(x.nombre||'').trim())
    .filter(Boolean);

  const unique=[...new Set(names)];

  sel.innerHTML=unique.length
    ?unique.map(
      n=>`<option value="${esc(n)}">${esc(n)}</option>`
    ).join('')
    :'<option value="ARCHIVO">ARCHIVO</option>';

  const archive=[...sel.options].find(
    o=>norm(o.value)==='ARCHIVO'
  ) || [...sel.options].find(
    o=>norm(o.value).includes('ARCHIVO')
  );

  if(archive)sel.value=archive.value;
}

function openInstructionReturnFromRequest(expedienteId){
  if(!hasFullAccess()){
    alert(
      'Solo ARCHIVO o ADMINISTRADOR puede aceptar el retorno físico desde Instrucción.'
    );
    return;
  }

  const row=(requestSearchRows||[]).find(
    x=>String(x.id)===String(expedienteId)
  );

  if(!row || !row._instruction_active){
    alert(
      'El expediente ya no figura como derivado activo a Instrucción. Vuelva a buscarlo.'
    );
    return;
  }

  requestInstructionReturnRow=row;

  fillInstructionRequestReturnLocations();

  el('instructionRequestReturnExpediente').textContent=
    `${row.expediente||'Expediente'} · Ciclo ${Number(row._instruction_ciclo||1)}`;

  el('instructionRequestReturnContext').innerHTML=
    `Derivado a Instrucción: <b>${fmtDate(row._instruction_fecha_derivacion)}${masterValueHasExplicitTime(row._instruction_fecha_derivacion)?' · '+fmtTime(row._instruction_fecha_derivacion):''}</b>`+
    ` · Días en Instrucción: <b>${Number(row._instruction_dias||0)}</b>`+
    (row._instruction_origen
      ?` · Responsable de origen: <b>${esc(row._instruction_origen)}</b>`
      :'')+
    (row._instruction_cargo
      ?` · Cargo anterior: <b>${esc(row._instruction_cargo)}</b>`
      :'');

  el('instructionRequestReturnExtension').value=
    String(row.extension||'');

  el('instructionRequestReturnRd').value=
    String(row.rd||'');

  el('instructionRequestReturnFolio').value=
    String(
      row._instruction_folio||
      row.ultimo_folio||
      ''
    );

  el('instructionRequestReturnObservation').value='';

  el('instructionRequestReturnStatus').textContent=
    'Confirme que el expediente ya fue recibido físicamente por Archivo.';

  el('instructionRequestReturnConfirmBtn').disabled=false;
  el('instructionRequestReturnConfirmBtn').textContent=
    '✓ Aceptar retorno y agregar a solicitud';

  el('instructionRequestReturnModal')?.classList.add('show');

  setTimeout(
    ()=>el('instructionRequestReturnFolio')?.focus(),
    80
  );
}

function closeInstructionRequestReturnModal(){
  el('instructionRequestReturnModal')?.classList.remove('show');
  requestInstructionReturnRow=null;
}

async function confirmInstructionRequestReturn(){
  const row=requestInstructionReturnRow;

  if(!row || !row.id){
    alert('No se pudo identificar el expediente.');
    return;
  }

  if(!hasFullAccess()){
    alert(
      'Solo ARCHIVO o ADMINISTRADOR puede registrar el retorno desde Instrucción.'
    );
    return;
  }

  const location=
    (el('instructionRequestReturnLocation')?.value||'').trim();

  const extension=
    (el('instructionRequestReturnExtension')?.value||'').trim();

  const rd=
    (el('instructionRequestReturnRd')?.value||'').trim();

  const folio=
    (el('instructionRequestReturnFolio')?.value||'').trim();

  const observation=
    (el('instructionRequestReturnObservation')?.value||'').trim();

  if(!location){
    el('instructionRequestReturnStatus').textContent=
      'Seleccione la ubicación física de retorno.';
    return;
  }

  if(!folio){
    el('instructionRequestReturnStatus').textContent=
      'El Último folio es obligatorio.';
    el('instructionRequestReturnFolio')?.focus();
    return;
  }

  const btn=el('instructionRequestReturnConfirmBtn');

  btn.disabled=true;
  btn.textContent='Registrando retorno...';

  el('instructionRequestReturnStatus').textContent=
    'Registrando RETORNO DE INSTRUCCIÓN / NUEVO INGRESO...';

  const {data,error}=await sb.rpc(
    'registrar_retorno_instruccion',
    {
      p_items:[{
        expediente_id:row.id,
        extension:extension||null,
        rd:rd||null,
        ultimo_folio:folio,
        observacion:observation||null
      }],
      p_ubicacion_retorno:location,
      p_observacion:observation||null
    }
  );

  if(error){
    el('instructionRequestReturnStatus').textContent=
      'NO SE REGISTRÓ: '+error.message;

    btn.disabled=false;
    btn.textContent='✓ Aceptar retorno y agregar a solicitud';
    return;
  }

  // El MISMO expediente maestro entra ahora en un NUEVO CICLO.
  const item={
    ...row,

    extension:extension||row.extension||null,
    rd:rd||row.rd||null,
    ultimo_folio:folio,

    estado:'RETORNO DE INSTRUCCIÓN',
    estado_operativo:'RETORNO DE INSTRUCCIÓN',

    responsable_actual:location,
    responsable:location,

    disponible:true,
    motivo:null,

    solicitud_interna:false,
    solicitud_otra_area:false,

    retorno_instruccion:true,
    ciclo_instruccion:Number(row._instruction_ciclo||1),

    _instruction_active:false,
    _nuevo:false
  };

  const key=requestDraftKey(item);

  if(!requestDraftItems.some(
    x=>requestDraftKey(x)===key
  )){
    requestDraftItems.push(item);
  }

  // Actualizar la fila visible sin obligar a buscar nuevamente.
  requestSearchRows=requestSearchRows.map(x=>
    String(x.id)===String(row.id)
      ?item
      :x
  );

  requestSearchSelectedIds.delete(row.id);

  el('instructionRequestReturnModal')?.classList.remove('show');
  requestInstructionReturnRow=null;

  renderRequestDraft();
  renderRequestLookupResults();
  updateRequestLookupSelection();

  el('requestLookupStatus').textContent=
    `${item.expediente} retornó de Instrucción y fue agregado a esta nueva solicitud. `+
    `Puede continuar o agregar más expedientes.`;

  showToast(
    `${item.expediente}: retorno de Instrucción registrado y agregado`
  );

  // Refrescar otras vistas sin interrumpir la preparación de esta solicitud.
  Promise.all([
    loadInstructionFolder(),
    loadPanel(),
    loadAll(),
    loadStates(),
    loadHistory()
  ]).catch(err=>console.warn(err));
}

function requestDraftKey(item){
  if(item.id)return 'ID:'+item.id;
  return 'EXP:'+norm(item.expediente)+'|'+norm(item.extension||'');
}


function requestLookupRowCanSelectV193(row){
  if(!row)return false;

  // V481 · evitar duplicar una reasignación ya pendiente.
  if(row._existingPendingReassignV481)return false;

  const expediente=normalizeRequestExpediente(row.expediente||'');
  const extValidation=requestExtensionValidationV265(expediente,row.extension||'');
  if(extValidation.required&&!extValidation.ok)return false;

  const already=requestDraftItems.some(
    x=>requestDraftKey(x)===requestDraftKey(row)
  );

  return !row._v188_verifying && !row._activeLookupFailed &&
    !row._referralDestination && !row._instruction_active &&
    !!row.disponible && !already;
}

function toggleRequestLookupRowV193(id,event){
  // No duplicar el comportamiento si el clic fue directamente sobre
  // checkbox, botón, enlace, input, select o textarea.
  if(
    event?.target?.closest(
      'input,button,a,select,textarea,label'
    )
  ){
    return;
  }

  const row=requestSearchRows.find(
    r=>String(r.id)===String(id)
  );

  if(!requestLookupRowCanSelectV193(row))return;

  const next=!requestSearchSelectedIds.has(id);
  toggleRequestLookup(id,next);
  renderRequestLookupResults();
}

function requestLookupRowClassV193(row){
  const classes=['request-lookup-row-v193'];

  if(
    requestSearchSelectedIds.has(row.id)
  ){
    classes.push('selected');
  }

  if(requestLookupRowCanSelectV193(row)){
    classes.push('selectable');
  }else{
    classes.push('not-selectable');
  }

  if(isDirectReassignRowV191(row)){
    classes.push('direct-reassign');
  }

  return classes.join(' ');
}

function syncRequestLookupContinueLabelV193(){
  const btn=el('requestLookupContinueBtn');
  if(!btn || addToExistingRequestId)return;

  const list=Array.isArray(requestDraftItems)
    ?requestDraftItems
    :[];

  const directCount=list.filter(
    x=>isDirectReassignRowV191(x)
  ).length;

  const normalCount=list.length-directCount;

  if(directCount && !normalCount){
    btn.textContent='Continuar con la solicitud de reasignación';
  }else if(directCount && normalCount){
    btn.textContent='Continuar con solicitud / reasignación';
  }else{
    btn.textContent='Continuar solicitud';
  }
}

function toggleRequestLookup(id,checked){
  if(checked)requestSearchSelectedIds.add(id);
  else requestSearchSelectedIds.delete(id);
  updateRequestLookupSelection();
}

function updateRequestLookupSelection(){
  const selected=requestSearchSelectedIds.size;
  el('requestLookupCount').textContent=selected+
    ' seleccionado'+(selected===1?'':'s')+' en la búsqueda';

  if(el('requestLookupAddBtn')){
    el('requestLookupAddBtn').disabled=selected===0;
  }

  el('requestLookupContinueBtn').disabled=requestDraftItems.length===0;
  syncRequestLookupContinueLabelV193();
}

function renderRequestDraft(){
  const n=requestDraftItems.length;
  el('requestDraftCount').textContent=n+' expediente'+(n===1?'':'s');
  el('requestLookupContinueBtn').disabled=n===0;
  syncRequestLookupContinueLabelV193();

  if(!n){
    el('requestDraftTable').className='request-draft-empty';
    el('requestDraftTable').innerHTML='Aún no ha agregado expedientes.';
    return;
  }

  el('requestDraftTable').className='';
  el('requestDraftTable').innerHTML=`<table>
    <thead>
      <tr><th>N°</th><th>Expediente</th><th>Ext.</th><th>R.D.</th><th>Tipo</th><th></th></tr>
    </thead>
    <tbody>
      ${requestDraftItems.map((x,i)=>`<tr>
        <td>${i+1}</td>
        <td>
          <b>${esc(x.expediente)}</b>
          ${accumulatedInlineHtml(
            x,
            {
              canManage:requestCanManageAccumulated(x),
              solicitudId:String(currentRequestId||'')
            }
          )}
        </td>
        <td>${x.extension?esc(x.extension):'—'}</td>
        <td>${esc(x.rd||'')}</td>
        <td>${
          x._nuevo
            ?'<span class="pill">NUEVO</span>'
            :x.retorno_instruccion
              ?'<span class="pill instruction-return">RETORNO INSTRUCCIÓN · NUEVO CICLO</span>'
              :x.solicitud_interna
                ?'<span class="pill returned">REASIGNACIÓN DIRECTA</span>'
                :'<span class="pill returned">EXISTENTE</span>'
        }</td>
        <td><button class="btn secondary small" onclick="removeRequestDraftItem(${i})">Quitar</button></td>
      </tr>`).join('')}
    </tbody>
  </table>`;
}

function removeRequestDraftItem(index){
  requestDraftItems.splice(index,1);
  renderRequestDraft();
  updateRequestLookupSelection();
}

function addSelectedSearchResultsToDraft(){
  const selected=requestSearchRows.filter(r=>requestSearchSelectedIds.has(r.id));

  if(!selected.length)return;

  let added=0;
  let skipped=0;

  selected.forEach(r=>{
    const extCheck=requestExtensionValidationV265(normalizeRequestExpediente(r.expediente||''),r.extension||'');
    if(!r.disponible || (extCheck.required&&!extCheck.ok)){
      skipped++;
      return;
    }

    const item={
      ...r,
      _nuevo:false,
      numero_solicitado_original:
        r._numero_solicitado_original||
        r.numero_solicitado_original||
        null
    };
    const key=requestDraftKey(item);

    if(requestDraftItems.some(x=>requestDraftKey(x)===key)){
      skipped++;
      return;
    }

    requestDraftItems.push(item);
    added++;
  });

  requestSearchSelectedIds.clear();
  renderRequestDraft();
  renderRequestLookupResults();

  el('requestLookupStatus').textContent=
    `${added} expediente(s) agregado(s)`+
    (skipped?` · ${skipped} ya estaba(n) agregado(s) o no disponible(s)`:'')+
    '. Puede buscar otro expediente.';

  updateRequestLookupSelection();
}

function renderRequestLookupResults(){
  if(!requestSearchRows.length){
    el('requestLookupStatus').textContent='No se encontraron expedientes.';
    el('requestLookupResults').innerHTML='<div class="empty">Sin resultados.</div>';
    updateRequestLookupSelection();
    return;
  }

  const noDisponibles=requestSearchRows.filter(r=>!r.disponible);

  // V192 · Expedientes que pueden tramitarse por REASIGNACIÓN DIRECTA.
  // En V191 esta colección se usaba en el mensaje de resultados pero no
  // se había declarado, provocando un ReferenceError y cortando la búsqueda.
  const directReassign=requestSearchRows.filter(
    r=>isDirectReassignRowV191(r)
  );

  if(
    requestSearchRows.length===1 &&
    isDirectReassignRowV191(requestSearchRows[0])
  ){
    const row=requestSearchRows[0];
    el('requestLookupStatus').textContent=
      requestCustodyStatusTextV791(requestSearchRows[0])||
      'REASIGNACIÓN DIRECTA · Seleccione la fila para continuar con la solicitud de reasignación.';
  }else if(
    requestSearchRows.length===1 &&
    requestSearchRows[0]._instruction_active && !requestSearchRows[0]._referralDestination
  ){
    el('requestLookupStatus').textContent=
      'El expediente está DERIVADO A INSTRUCCIÓN. '+
      'Archivo puede aceptar su retorno físico y agregarlo directamente a esta nueva solicitud.';
  }else if(
    requestSearchRows.length===1 &&
    requestSearchRows[0]._v328_resolicitable &&
    requestSearchRows[0].disponible
  ){
    el('requestLookupStatus').textContent=
      'El ciclo anterior ya está cerrado. Puede seleccionar el expediente y generar una nueva solicitud independiente.';
  }else if(requestSearchRows.length===1 && noDisponibles.length===1){
    el('requestLookupStatus').textContent=
      requestCustodyStatusTextV791(noDisponibles[0])||
      noDisponibles[0].motivo||
      'El expediente no está disponible para una nueva solicitud.';
  }else{
    const extFilter=normalizeRequestExtension(
      el('requestLookupExtension')?.value||''
    );

    el('requestLookupStatus').textContent=
      `${requestSearchRows.length} resultado(s)`+
      (extFilter
        ?` · Extensión: ${extFilter}`
        :' · Todas las extensiones')+
      (directReassign.length
        ?` · ${directReassign.length} para reasignación directa`
        :'')+
      (noDisponibles.length
        ?` · ${noDisponibles.length} no disponible(s)`
        :'')+
      '. Seleccione el expediente y pulse “Agregar seleccionados”.';
  }

  el('requestLookupResults').innerHTML=`<table>
    <thead><tr>
      <th></th>
      <th>Expediente</th>
      <th>Ext.</th>
      <th>R.D.</th>
      <th>Estado actual</th>
      <th>Responsable actual / ubicación</th>
      <th>Fecha del último estado</th>
      <th>Disponibilidad</th>
      <th>Situación del trámite</th>
    </tr></thead>
    <tbody>${requestSearchRows.map(r=>{
      const already=requestDraftItems.some(x=>requestDraftKey(x)===requestDraftKey(r));
      return `<tr
        class="${requestLookupRowClassV193(r)}"
        onclick="toggleRequestLookupRowV193('${r.id}',event)"
        title="${requestLookupRowCanSelectV193(r)
          ?'Haga clic en cualquier parte de la fila para seleccionar o deseleccionar'
          :'Este expediente no puede seleccionarse en este momento'
        }">
        <td><input type="checkbox"
          ${(!requestLookupRowCanSelectV193(r))?'disabled':''}
          ${requestSearchSelectedIds.has(r.id)?'checked':''}
          onchange="toggleRequestLookup('${r.id}',this.checked);renderRequestLookupResults()"></td>
        <td>
          <b>${esc(r.expediente)}</b>
          ${r._busqueda_acumulada
            ?`<span class="accum-search-note">
                Solicitado: ${esc(r._numero_solicitado_original)}
                ${r._extension_solicitada_original?` · ${esc(r._extension_solicitada_original)}`:''}
                <br>
                Acumulado al principal:
                ${esc(r._expediente_principal_resuelto||r.expediente||'')}
                ${r._extension_principal_resuelta?` · ${esc(r._extension_principal_resuelta)}`:''}
              </span>`
            :''
          }
        </td>
        <td>${r.extension
          ?`<span class="${requestExtensionKey(el('requestLookupExtension')?.value||'')===requestExtensionKey(r.extension)?'request-extension-match':''}">
              ${esc(r.extension)}
            </span>`
          :'—'}</td>
        <td>${esc(r.rd||'')}</td>
        <td>${requestLatestStateHtmlV793(r)}</td>
        <td class="request-owner-current">${requestOwnerWithAreaV785(r,requestCurrentCustodianV120(r.estado_operativo||r.estado,r.responsable_actual)||'—')}</td>
        <td class="request-custody-date">${requestCustodyDateHtml(r)}</td>
        <td>${r._v188_verifying
          ?'<span class="pill v188-verifying">VERIFICANDO...</span><span class="active-request-brief">Comprobando custodia, solicitudes activas y derivaciones.</span>'
          :(requestExtensionValidationV265(normalizeRequestExpediente(r.expediente||''),r.extension||'').required && !requestExtensionValidationV265(normalizeRequestExpediente(r.expediente||''),r.extension||'').ok)
            ?`<span class="pill alert">EXTENSIÓN OBLIGATORIA</span><span class="request-custody-warning">${esc(requestExtensionRuleMessageV265(normalizeRequestExpediente(r.expediente||''),r.extension||''))}</span>`
          :r._referralDestination
            ?requestReferralHtmlV124(r)
            :r._existingPendingReassignV481
              ?existingPendingReassignHtmlV481(r)
              :isDirectReassignRowV191(r)
                ?directReassignAvailabilityHtmlV191(r)
                :requestCustodyAvailabilityHtmlV791(r)
                  ?requestCustodyAvailabilityHtmlV791(r)
                  :(r._activeLookupFailed||r._activeRequests?.length)
                    ?activeRequestNoticeHtml(r)
                :`${already
          ?'<span class="pill">YA AGREGADO</span>'
          :(r._v506_returned_resolicitable && r.disponible
            ?`<span class="pill returned">DISPONIBLE · DEVUELTO AL ARCHIVO</span>
               <span class="request-custody-warning">El ciclo anterior terminó y el expediente está nuevamente en Archivo. Este pedido generará una nueva solicitud independiente.</span>`
          :((r._v329_resolicitable||r._v328_resolicitable||r._v324_resolicitable||r._closedRequestsV322?.length) && r.disponible
            ?`<span class="pill returned">NUEVA SOLICITUD PERMITIDA</span>
               <span class="request-custody-warning">La solicitud anterior fue cerrada por el Administrador. Este pedido generará una nueva solicitud independiente y conservará el historial anterior.</span>`
            :(r._instruction_active && hasFullAccess()
            ?`<span class="pill instruction">RETORNO DE INSTRUCCIÓN</span>
               <span class="request-custody-warning">
                 Ciclo ${Number(r._instruction_ciclo||1)}
                 ${r._instruction_origen
                   ?` · Salió desde ${esc(r._instruction_origen)}`
                   :''}
                 ${r._instruction_cargo
                   ?` · Cargo ${esc(r._instruction_cargo)}`
                   :''}
               </span>
               <button class="btn small instruction-return-from-request-btn"
                       type="button"
                       onclick="openInstructionReturnFromRequest('${r.id}')">
                 ✓ Aceptar retorno y agregar
               </button>`
            :(r.solicitud_interna
            ?`<span class="v792-requiere-reasignacion">REQUIERE REASIGNACIÓN</span>`
            :(r.solicitud_otra_area
              ?`<span class="pill returned">DISPONIBLE · OTRA ÁREA</span>
                 <span class="request-custody-warning">
                   Con ${esc(r.responsable_actual||'otro usuario')}
                   ${r.area_trabajo?` · ${esc(r.area_trabajo)}`:''}
                   · Puede solicitarlo normalmente
                 </span>`
              :(r.disponible
                ?(r._v517_digitalAvailable
                  ?`<span class="pill returned">DISPONIBLE · COPIA DIGITAL</span><span class="v517-digital-nonblocking-note">La copia digital no bloquea ni modifica la custodia física.</span>`
                  :(r._v517_physicalAvailableDespiteDigital
                    ?`<span class="pill returned">DISPONIBLE</span><span class="v517-digital-nonblocking-note">Existe una copia digital en atención, pero no bloquea este préstamo.</span>`
                    :'<span class="pill returned">DISPONIBLE</span>'))
                :`<span class="pill alert">NO DISPONIBLE</span>
                   <span class="request-custody-warning">${esc(r.motivo||'NO DISPONIBLE')}</span>`))))))}`}</td>
        <td class="v784-search-cell"><span class="v784-summary" data-v784-id="${esc(r.expediente_id||r.id)}">Consultando situación...</span></td>
      </tr>`;
    }).join('')}</tbody>
  </table>`;

  updateRequestLookupSelection();
}

async function continueRequestFromSearch(){
  if(!requestDraftItems.length)return;
  // V787: evitar seleccionar nuevos préstamos de expedientes ya regularizados
  // como acumulados. La prohibición también se comprueba en Supabase.
  if(typeof window.v787CheckDraft==='function'){
    try{
      const vinculos=await window.v787CheckDraft(requestDraftItems.map(x=>x.id));
      if(vinculos.length){
        const nombres=vinculos.map(x=>x.principal_numero).filter(Boolean).join(', ');
        el('requestLookupStatus').textContent='Expediente acumulado: solicite el principal '+nombres+'. Quite el acumulado de la selección para continuar.';
        return;
      }
    }catch(e){
      el('requestLookupStatus').textContent='No se pudo verificar la relación de acumulación. Actualice la consulta antes de continuar: '+String(e?.message||e);
      return;
    }
  }

  const extensionIssue=requestDraftExtensionIssueV265(requestDraftItems);
  if(extensionIssue){
    const msg=`${extensionIssue.expediente}: ${extensionIssue.message}`;
    el('requestLookupStatus').textContent=msg;
    showToast('Revise la extensión obligatoria antes de continuar');
    return;
  }

  const items=requestDraftItems.map(x=>({
    id:x.id||null,
    expediente:x.expediente,
    extension:x.extension||null,
    rd:x.rd||null,
    ultimo_folio:x.ultimo_folio||null,
    observacion:x.observacion||null,
    solicitud_interna:!!x.solicitud_interna,
    solicitud_otra_area:!!x.solicitud_otra_area,
    usar_reasignacion_interna:!!x.usar_reasignacion_interna,
    area_trabajo:x.area_trabajo||null,
    responsable_actual:x.responsable_actual||null,
    retorno_instruccion:!!x.retorno_instruccion,
    ciclo_instruccion:x.ciclo_instruccion||null,
    fecha_custodia_actual:x.fecha_custodia_actual||x.fecha_ultima_reasignacion||x.fecha_reasignacion||x.fecha_entrega||null,
    fecha_derivacion_conas:x.fecha_derivacion_conas||x.fecha_derivacion||null,
    fecha_derivacion_dvc:x.fecha_derivacion_dvc||x.fecha_derivacion||null,
    nuevo:!!x._nuevo
  }));

  // MODO: agregar a una solicitud ya existente
  if(addToExistingRequestId){
    const solicitudId=addToExistingRequestId;

    el('requestLookupContinueBtn').disabled=true;
    el('requestLookupContinueBtn').textContent='Agregando...';

    const {data,error}=await sb.rpc('agregar_expedientes_a_solicitud',{
      p_solicitud_id:solicitudId,
      p_items:items
    });

    if(error){
      el('requestLookupStatus').textContent=error.message;
      el('requestLookupContinueBtn').disabled=false;
      el('requestLookupContinueBtn').textContent='Agregar a solicitud';
      return;
    }

    closeRequestSearchModal();
    addToExistingRequestId='';
    showToast(`${data?.agregados||items.length} expediente(s) agregados a ${currentRequest?.numero||'la solicitud'}`);

    await loadRequests();
    if(hasFullAccess())await loadRequestsByLawyer();
    await openRequestDetail(solicitudId);
    return;
  }

  // MODO: crear una solicitud nueva
  const itemsCopy=items.map(x=>({
    ...x,
    _nuevo:x.nuevo
  }));

  closeRequestSearchModal();
  await openNewRequestModal(itemsCopy,true);
}


function closeReturnPanelWhenOpeningState(){
  const returnBox=el('statesReturnAdminBox');
  if(returnBox)returnBox.classList.add('hidden');

  const returnBtn=el('statesReturnToggleBtn');
  if(returnBtn)returnBtn.textContent='Ver solicitudes';

  const detailBox=el('stateDetailBox');
  if(detailBox)detailBox.classList.remove('hidden');

  el('tab-states')?.classList.remove('return-requests-open');

  requestAnimationFrame(()=>{
    try{ adjustUniversalModuleSticky(); }catch(_){}
  });
}

function prepareReturnPanelExclusiveView(){
  // Al abrir devoluciones, cerrar cualquier detalle de estado anterior.
  selectedState='';
  try{ renderStates(); }catch(_){}

  const detailBox=el('stateDetailBox');
  if(detailBox)detailBox.classList.add('hidden');

  if(el('stateDetailTitle'))el('stateDetailTitle').textContent='Seleccione un estado para ver sus expedientes';
  if(el('stateDetailCount'))el('stateDetailCount').textContent='0';
  if(el('stateDetailTable')){
    el('stateDetailTable').innerHTML='<div class="empty">Pulse “Ver expedientes” en uno de los estados.</div>';
  }
}

function toggleReturnRequestsInStates(){
  if(!(isAdmin()||isArchive()))return;

  const box=el('statesReturnAdminBox');
  const btn=el('statesReturnToggleBtn');
  if(!box)return;

  const opening=box.classList.contains('hidden');
  if(opening)prepareReturnPanelExclusiveView();
  box.classList.toggle('hidden',!opening);
  if(!opening){
    const detailBox=el('stateDetailBox');
    if(detailBox)detailBox.classList.remove('hidden');
  }

  if(btn){
    btn.textContent=opening?'Ocultar solicitudes':'Ver solicitudes';
  }

  const statesTab=el('tab-states');
  statesTab?.classList.toggle('return-requests-open',opening);

  if(opening){
    loadReturnRequests();
    setTimeout(()=>{
      statesTab?.scrollIntoView({behavior:'auto',block:'start'});
      requestAnimationFrame(()=>{
        try{ adjustUniversalModuleSticky(); }catch(_){}
      });
    },50);
  }else{
    requestAnimationFrame(()=>{
      try{ adjustUniversalModuleSticky(); }catch(_){}
    });
  }
}

function debounceReturnRequests(){
  clearTimeout(returnRequestsTimer);
  returnRequestsTimer=setTimeout(()=>loadReturnRequests(),250);
}

function clearReturnFilters(){
  if(el('returnSearch'))el('returnSearch').value='';
  if(el('returnResponsible'))el('returnResponsible').value='';
  loadReturnRequests();
}

function returnBusinessDays(dateStr){
  if(!dateStr)return 0;

  const start=new Date(dateStr+'T00:00:00');
  const end=new Date();
  end.setHours(0,0,0,0);

  let days=0;
  const d=new Date(start);

  while(d<end){
    d.setDate(d.getDate()+1);
    const w=d.getDay();
    if(w!==0 && w!==6)days++;
  }
  return days;
}

function returnRequestKey(row){
  return `${row?.solicitud_id||''}::${row?.expediente_id||''}`;
}

function fillReturnBulkLocations(){
  const sel=el('returnBulkLocation');
  if(!sel)return;

  const current=sel.value;
  const locations=(catalogo||[])
    .filter(x=>x.activo!==false && x.tipo!=='PERSONAL')
    .map(x=>(x.nombre||'').trim())
    .filter(Boolean);

  const unique=[...new Set(locations)];
  sel.innerHTML=unique.length
    ? unique.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('')
    : '<option value="ARCHIVO">ARCHIVO</option>';

  if(current && [...sel.options].some(o=>o.value===current)){
    sel.value=current;
  }else{
    const archivo=[...sel.options].find(o=>norm(o.value).includes('ARCHIVO'));
    if(archivo)sel.value=archivo.value;
  }
}

function syncReturnRequestBulkUI(){
  const visibleKeys=new Set((returnRequestRows||[]).map(returnRequestKey));
  [...returnRequestSelectedKeys].forEach(k=>{
    if(!visibleKeys.has(k))returnRequestSelectedKeys.delete(k);
  });

  const count=returnRequestSelectedKeys.size;
  if(el('returnSelectedCount'))el('returnSelectedCount').textContent=`${count} seleccionado${count===1?'':'s'}`;
  if(el('returnBulkConfirmBtn'))el('returnBulkConfirmBtn').disabled=!count;

  const all=el('returnSelectAll');
  if(all){
    const total=returnRequestRows.length;
    const selected=returnRequestRows.filter(r=>returnRequestSelectedKeys.has(returnRequestKey(r))).length;
    all.checked=total>0 && selected===total;
    all.indeterminate=selected>0 && selected<total;
  }
}

function toggleReturnRequestSelection(key,checked,checkbox){
  if(checked)returnRequestSelectedKeys.add(key);
  else returnRequestSelectedKeys.delete(key);
  checkbox?.closest('tr')?.classList.toggle('record-selected-row',!!checked);
  syncReturnRequestBulkUI();
}

function toggleAllReturnRequests(checked){
  (returnRequestRows||[]).forEach(r=>{
    const key=returnRequestKey(r);
    if(checked)returnRequestSelectedKeys.add(key);
    else returnRequestSelectedKeys.delete(key);
  });
  renderReturnRequests();
}

async function confirmSelectedReturnRequests(){
  if(!hasFullAccess())return;

  const selected=(returnRequestRows||[]).filter(r=>returnRequestSelectedKeys.has(returnRequestKey(r)));
  if(!selected.length){
    if(el('returnBulkStatus'))el('returnBulkStatus').textContent='Seleccione uno o más expedientes.';
    return;
  }

  // V743: protección frente a cambios simultáneos de estado o nuevo préstamo.
  // Revalidar la existencia exacta del ciclo antes de cualquier escritura.
  try{
    const current=await loadReturnRequestsByCycle({search:'',responsible:''});
    const allowed=new Set((current||[]).map(r=>
      `${String(r.solicitud_id||'')}::${String(r.expediente_id||'')}`
    ));
    if(selected.some(r=>!allowed.has(returnRequestKey(r)))){
      if(el('returnBulkStatus'))el('returnBulkStatus').textContent=
        'Algunos expedientes ya no tienen devolución solicitada. Se actualizó la bandeja sin confirmar recepciones.';
      await loadReturnRequests();
      return;
    }
  }catch(error){
    serverError(error);
    return;
  }

  const location=(el('returnBulkLocation')?.value||'').trim();
  if(!location){
    if(el('returnBulkStatus'))el('returnBulkStatus').textContent='Seleccione la ubicación física de retorno.';
    return;
  }

  const destinationRequestsV169=[...new Set(
    (crossAreaWaitRows||[])
      .filter(w=>selected.some(r=>String(r.expediente_id||'')===String(w.expediente_id||'')) && w.solicitud_destino_id)
      .map(w=>String(w.solicitud_destino_id))
      .filter(Boolean)
  )];

  const btn=el('returnBulkConfirmBtn');
  if(btn)btn.disabled=true;
  if(el('returnBulkStatus'))el('returnBulkStatus').textContent=`Confirmando recepción de ${selected.length} expediente(s)...`;

  const groups=new Map();
  selected.forEach(r=>{
    if(!groups.has(r.solicitud_id))groups.set(r.solicitud_id,[]);
    groups.get(r.solicitud_id).push(r.expediente_id);
  });

  let confirmed=0;
  const errors=[];
  for(const [solicitudId,expedienteIds] of groups.entries()){
    const {data,error}=await sb.rpc('confirmar_devolucion_archivo_estado_fisico_v2',{
      p_solicitud_id:solicitudId,
      p_expediente_ids:expedienteIds,
      p_ubicacion_retorno:location,
      p_observacion:null
    });
    if(error){
      errors.push(error.message);
      continue;
    }
    confirmed+=Number(data?.devueltos||expedienteIds.length);
  }

  if(errors.length){
    if(el('returnBulkStatus'))el('returnBulkStatus').textContent=`Se confirmaron ${confirmed} expediente(s). Error: ${errors[0]}`;
  }else{
    returnRequestSelectedKeys.clear();
    if(el('returnBulkStatus')){
      el('returnBulkStatus').textContent=destinationRequestsV169.length
        ?`${confirmed} expediente(s) recibidos · ${destinationRequestsV169.length} solicitud(es) quedaron habilitadas para atención.`
        :'';
    }
    showToast(destinationRequestsV169.length
      ?`${confirmed} expediente(s) recibidos · ${destinationRequestsV169.length} solicitud(es) habilitadas`
      :`${confirmed} expediente(s) recibidos por Archivo`);
  }

  await refreshReturnCountersAndViews({
    full:true,
    reason:'RECEPCIÓN MÚLTIPLE DESDE SOLICITUDES DE DEVOLUCIÓN'
  });
  syncReturnRequestBulkUI();
}



async function loadReturnRequestsByCycle({
  search='',
  responsible=''
}={}){
  const {data,error}=await sb.rpc(
    'listar_solicitudes_devolucion_por_ciclo_operativo',
    {
      p_busqueda:search||null,
      p_responsable:responsible||null
    }
  );

  if(error)throw error;

  return Array.isArray(data)?data:[];
}

// V743: La bandeja de recepcion de devoluciones tiene una unica fuente: 
// solicitud_expedientes en el ciclo exacto con estado DEVOLUCION SOLICITADA.
// Nunca se reconstruye una devolucion a partir de prestamos activos,
// del numero SOL (que se repite entre usuarios) ni del ultimo movimiento historico.
window.v505ReturnSourceInfo=function(){
  return {
    version:'V743',
    rule:'Solo ciclos con devolución solicitada y sin recepción confirmada',
    source:'listar_solicitudes_devolucion_por_ciclo_operativo',
    identification:'solicitud_id + expediente_id',
    archive_personal:true,
    counter_and_detail:'misma colección returnRequestRows'
  };
};

async function loadReturnRequests(){
  if(!(isAdmin()||isArchive()))return;

  const search=(el('returnSearch')?.value||'').trim();
  const responsible=(el('returnResponsible')?.value||'').trim();

  try{
    // V743: no mezclar préstamos activos con devoluciones pendientes.
    // Única fuente autorizada por el estado del vínculo solicitud-expediente.
    // Esta RPC aplica filtros por ID de ciclo y fecha de devolución nula.
    const cycleRows=await loadReturnRequestsByCycle({search,responsible});
    const validRows=(Array.isArray(cycleRows)?cycleRows:[])
      .filter(row=>row?.solicitud_id && row?.expediente_id)
      .map(row=>({...row,_v743_source:'DEVOLUCION_POR_CICLO'}));
    const enrichedReturnRows=await enrichRowsWithExpedienteAsunto(validRows);
    returnRequestRows=await enrichRowsWithRequestOrigin(
      enrichedReturnRows,
      'solicitud_id'
    );
  }catch(error){
    console.warn('V743 · recepción por ciclo:',error);

    const msg=String(
      error?.message||
      error||
      'Error al consultar devoluciones'
    );

    if(el('returnRequestsTable')){
      el('returnRequestsTable').innerHTML=
        `<div class="empty">${esc(msg)}</div>`;
    }

    if(el('statesReturnCount')){
      el('statesReturnCount').textContent='!';
      el('statesReturnCount').title=msg;
    }

    return;
  }

  if(el('statesReturnCount')){
    el('statesReturnCount').textContent=returnRequestRows.length;
  }

  if(el('returnRequestsCount')){
    el('returnRequestsCount').textContent=
      `${returnRequestRows.length} expediente${returnRequestRows.length===1?'':'s'}`;
  }

  if(el('returnResponsible')){
    const current=el('returnResponsible').value;

    const names=[...new Set(
      returnRequestRows
        .map(x=>(x.responsable_actual||'').trim())
        .filter(Boolean)
    )].sort((a,b)=>a.localeCompare(b,'es'));

    el('returnResponsible').innerHTML=
      '<option value="">TODOS</option>'+
      names.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('');

    if(names.includes(current)){
      el('returnResponsible').value=current;
    }
  }

  fillReturnBulkLocations();
  renderReturnRequests();
  syncReturnRequestBulkUI();

  if(el('stateGrid'))renderStates();
  if(selectedState==='SOLICITUDES DE DEVOLUCIÓN' && el('stateDetailTable')){
    v504RenderReturnStateDetail(true);
  }
}

function renderReturnRequests(){
  if(!returnRequestRows.length){
    el('returnRequestsTable').innerHTML=
      '<div class="empty">No hay solicitudes de devolución pendientes.</div>';
    syncReturnRequestBulkUI();
    return;
  }

  el('returnRequestsTable').innerHTML=`<table>
    <thead>
      <tr>
        <th style="width:42px;text-align:center">
          <input id="returnSelectAll" type="checkbox" title="Seleccionar todos"
                 onchange="toggleAllReturnRequests(this.checked)">
        </th>
        <th>Expediente</th>
        <th>Ext.</th>
        <th>Solicitud</th>
        <th>Registrado por</th>
        <th>Responsable de la devolución</th>
        <th class="subject-cell-v455 subject-cell-v639">Asunto</th>
        <th>Fecha / hora solicitud devolución</th>
        <th>Observación</th>
        <th>Acción</th>
      </tr>
    </thead>
    <tbody>
      ${returnRequestRows.map(x=>{
        const days=returnBusinessDays(x.fecha_solicitud_devolucion);
        const key=returnRequestKey(x);
        const checked=returnRequestSelectedKeys.has(key)?'checked':'';
        return `<tr class="row-click-select ${returnRequestSelectedKeys.has(key)?'record-selected-row':''}" onclick="toggleReturnRequestFromRow(event,'${key}')" title="Clic en la fila para seleccionar o deseleccionar">
          <td style="text-align:center">
            <input type="checkbox" ${checked}
                   aria-label="Seleccionar ${esc(x.expediente||'expediente')}"
                   onchange="toggleReturnRequestSelection('${key}',this.checked,this)">
          </td>
          <td>
          <div class="v704-principal-line">
            <b>${esc(x.expediente)}</b>
            <span class="v704-exp-role principal">PRINCIPAL</span>
          </div>
          ${accumulatedInlineHtml(
            x,
            {
              canManage:requestCanManageAccumulated(x),
              solicitudId:String(currentRequestId||'')
            }
          )}
        </td>
          <td>${esc(x.extension||'—')}</td>
          <td title="${esc(x.solicitud_expediente_id?`Ciclo: ${x.solicitud_expediente_id}`:'')}">
            <b>${esc(x.solicitud_numero||'—')}</b>
          </td>
          <td><b>${esc(x.registrado_por||'—')}</b></td>
          <td><b>${esc(x.responsable_actual||'—')}</b></td>
          <td class="subject-cell-v455 subject-cell-v639" title="${esc(expedienteAsuntoValue(x)||'')}"><div class="subject-text-v639">${esc(expedienteAsuntoValue(x)||'—')}</div></td>
          <td class="return-request-datetime">
            ${v619ReturnRequestDateTimeHtml(x)}
          </td>
          <td>${esc(x.observacion||'')}</td>
          <td>
            <button class="btn small"
              onclick="manageReturnRequest('${x.solicitud_id}','${x.expediente_id}')">
              Gestionar
            </button>
          </td>
        </tr>`;
      }).join('')}
    </tbody>
  </table>`;

  syncReturnRequestBulkUI();
}

async function manageReturnRequest(solicitudId,expedienteId){
  if(!hasFullAccess())return;

  // V743: un botón viejo o la caché del navegador no pueden abrir una
  // recepción de un nuevo préstamo o de una devolución ya atendida.
  try{
    const actuales=await loadReturnRequestsByCycle({search:'',responsible:''});
    const vigente=(actuales||[]).some(r=>
      String(r.solicitud_id)===String(solicitudId) &&
      String(r.expediente_id)===String(expedienteId)
    );
    if(!vigente){
      showToast('El expediente no tiene una devolución pendiente en este ciclo. Se actualizará la bandeja.');
      await loadReturnRequests();
      return;
    }
  }catch(e){
    serverError(e);
    return;
  }

  await openRequestDetail(solicitudId);

  requestSelectedIds.clear();

  const item=requestDetailRows.find(
    x=>x.expediente_id===expedienteId
  );

  if(item)requestSelectedIds.add(expedienteId);

  renderRequestDetailItems();
  renderRequestActions();

  if(el('rqActionStatus')){
    el('rqActionStatus').textContent=item
      ? `Expediente ${item.expediente} seleccionado. Confirme la devolución cuando Archivo lo haya recibido físicamente.`
      : '';
  }
}

async function loadRequestsByLawyer(){
  if(!hasFullAccess())return;

  const {data,error}=await sb.rpc('listar_solicitudes_prestamo',{
    p_busqueda:null,
    p_estado:null
  });

  if(error){
    if(el('lawyerRequestsGrid'))el('lawyerRequestsGrid').innerHTML=`<div class="empty">${esc(error.message)}</div>`;
    return;
  }

  const rows=await applyAdminClosedStateToRequests(
    await enrichRequestAttentionTimes(data||[])
  );
  const map=new Map();

  rows.forEach(r=>{
    const name=(r.solicitante||'SIN SOLICITANTE').trim()||'SIN SOLICITANTE';
    if(!map.has(name)){
      map.set(name,{
        solicitante:name,total:0,solicitado:0,aceptado:0,cargo_pendiente:0,
        entrega_parcial:0,entrega_total:0,por_recibir:0,devuelto:0,
        origen_admin:0,origen_usuario:0,origen_archivo:0,origen_otro:0
      });
    }

    const x=map.get(name);
    x.total++;

    const st=r.estado_atencion||r.estado||'';
    if(st==='REGISTRADA')x.solicitado++;
    if(requestCountsAsPendingAttentionV163(r))x.aceptado++;
    if(st==='CARGO PENDIENTE DE ENTREGA')x.cargo_pendiente++;
    if(st==='ENTREGA PARCIAL')x.entrega_parcial++;
    if(st==='ENTREGA TOTAL')x.entrega_total++;
    if(['CERRADA POR ARCHIVO','CERRADA POR ADMINISTRADOR','CERRADO POR ADMINISTRADOR'].includes(st))x.devuelto++;
    x.por_recibir+=Number(r.devoluciones_pendientes||0);

    const o=requestOriginValue(r.origen_registro);
    if(o==='ADMINISTRADOR')x.origen_admin++;
    else if(o==='USUARIO')x.origen_usuario++;
    else if(o==='ARCHIVO')x.origen_archivo++;
    else x.origen_otro++;
  });

  requestsByLawyerRows=[...map.values()];

  // V202 · Solo Administrador:
  // prioridad operativa = primero quien tenga más pendientes por atender.
  if(isAdmin()){
    requestsByLawyerRows.sort((a,b)=>
      Number(b.aceptado||0)-Number(a.aceptado||0) ||
      Number(b.entrega_parcial||0)-Number(a.entrega_parcial||0) ||
      Number(b.total||0)-Number(a.total||0) ||
      a.solicitante.localeCompare(b.solicitante,'es')
    );
  }else{
    requestsByLawyerRows.sort((a,b)=>
      Number(b.total||0)-Number(a.total||0) ||
      a.solicitante.localeCompare(b.solicitante,'es')
    );
  }

  renderRequestsByLawyer();
}


let lawyerRequestSearchTimerV203=null;

function debounceLawyerRequestSearchV203(){
  const input=el('lawyerRequestSearch');
  const clear=el('v203LawyerSearchClear');

  if(clear){
    clear.classList.toggle(
      'hidden',
      !String(input?.value||'').trim()
    );
  }

  clearTimeout(lawyerRequestSearchTimerV203);
  lawyerRequestSearchTimerV203=setTimeout(
    renderRequestsByLawyer,
    120
  );
}

function clearLawyerRequestSearchV203(){
  const input=el('lawyerRequestSearch');
  if(input){
    input.value='';
    input.focus();
  }

  el('v203LawyerSearchClear')?.classList.add('hidden');
  renderRequestsByLawyer();
}

function lawyerActiveCountV202(x){
  return Math.max(
    0,
    Number(x.total||0)-Number(x.devuelto||0)
  );
}

function lawyerPriorityClassV202(x){
  const pending=Number(x.aceptado||0);
  const partial=Number(x.entrega_parcial||0);

  if(pending>=5)return 'v202-priority-high';
  if(pending>0)return 'v202-priority-pending';
  if(partial>0)return 'v202-priority-partial';
  return '';
}

function setLawyerPriorityFilterV202(value){
  if(!isAdmin())return;

  if(el('lawyerPriorityFilter')){
    el('lawyerPriorityFilter').value=value||'';
  }

  document.querySelectorAll('[data-v202-lawyer-filter]').forEach(btn=>{
    btn.classList.toggle(
      'active',
      (btn.dataset.v202LawyerFilter||'')===(value||'')
    );
  });

  renderRequestsByLawyer();
}

function renderRequestsByLawyer(){
  if(!el('lawyerRequestsGrid'))return;

  const q=norm(el('lawyerRequestSearch')?.value||'');

  if(el('v203LawyerSearchClear')){
    el('v203LawyerSearchClear').classList.toggle(
      'hidden',
      !String(el('lawyerRequestSearch')?.value||'').trim()
    );
  }

  const priority=isAdmin()
    ?String(el('lawyerPriorityFilter')?.value||'')
    :'';

  let data=requestsByLawyerRows.filter(
    x=>!q||norm(x.solicitante).includes(q)
  );

  if(isAdmin()){
    if(priority==='PENDIENTES'){
      data=data.filter(x=>Number(x.aceptado||0)>0);
    }else if(priority==='PARCIAL'){
      data=data.filter(x=>Number(x.entrega_parcial||0)>0);
    }else if(priority==='ACTIVAS'){
      data=data.filter(x=>lawyerActiveCountV202(x)>0);
    }else if(priority==='CERRADAS'){
      data=data.filter(x=>Number(x.devuelto||0)>0);
    }

    // Mantener siempre arriba lo más urgente.
    data=[...data].sort((a,b)=>
      Number(b.aceptado||0)-Number(a.aceptado||0) ||
      Number(b.entrega_parcial||0)-Number(a.entrega_parcial||0) ||
      lawyerActiveCountV202(b)-lawyerActiveCountV202(a) ||
      Number(b.total||0)-Number(a.total||0) ||
      a.solicitante.localeCompare(b.solicitante,'es')
    );

    const totalPending=data.reduce(
      (sum,x)=>sum+Number(x.aceptado||0),
      0
    );

    const lawyersPending=data.filter(
      x=>Number(x.aceptado||0)>0
    ).length;

    const active=data.reduce(
      (sum,x)=>sum+lawyerActiveCountV202(x),
      0
    );

    if(el('v202LawyerSummary')){
      el('v202LawyerSummary').innerHTML=
        `<b>${data.length}</b> abogados · `+
        `<b>${lawyersPending}</b> con pendientes · `+
        `<b>${totalPending}</b> solicitudes por atender · `+
        `<b>${active}</b> solicitudes activas`;
    }

    document.querySelectorAll('[data-v202-lawyer-filter]').forEach(btn=>{
      btn.classList.toggle(
        'active',
        (btn.dataset.v202LawyerFilter||'')===priority
      );
    });
  }

  if(!data.length){
    el('lawyerRequestsGrid').innerHTML=
      '<div class="empty">No hay solicitudes para mostrar con los filtros seleccionados.</div>';
    return;
  }

  el('lawyerRequestsGrid').innerHTML=data.map(x=>{
    const pending=Number(x.aceptado||0);
    const active=lawyerActiveCountV202(x);
    const pClass=isAdmin()?lawyerPriorityClassV202(x):'';

    return `
    <div class="lawyer-card ${pClass}">
      ${isAdmin() && pending>0
        ?`<div class="v202-priority-badge">
             ${pending>=5?'PRIORIDAD ALTA':'PENDIENTE'}
           </div>`
        :''
      }

      <div class="v202-lawyer-card-head">
        <h3>${esc(x.solicitante)}</h3>
        ${isAdmin()
          ?`<span class="v202-active-count">${active} activas</span>`
          :''
        }
      </div>

      <div class="lawyer-total">${Number(x.total||0)}</div>
      <div class="note">solicitudes registradas</div>

      <div class="lawyer-stats">
        <div class="${pending>0?'v202-stat-alert':''}">
          PEND. POR ATENDER
          <b>${pending}</b>
        </div>
        <div class="${Number(x.entrega_parcial||0)>0?'v202-stat-partial':''}">
          ENTREGA PARCIAL
          <b>${Number(x.entrega_parcial||0)}</b>
        </div>
        <div>
          ENTREGA TOTAL
          <b>${Number(x.entrega_total||0)}</b>
        </div>
        <div>
          POR RECIBIR
          <b>${Number(x.por_recibir||0)}</b>
        </div>
        <div>
          CERRADAS
          <b>${Number(x.devuelto||0)}</b>
        </div>
      </div>

      <div class="lawyer-actions">
        <button class="btn secondary small"
                onclick="openLawyerRequests('${x.solicitante.replace(/'/g,"\\'")}')">
          Ver todas (${Number(x.total||0)})
        </button>

        ${pending>0
          ?`<button class="btn small v202-pending-btn"
                    onclick="openLawyerRequests('${x.solicitante.replace(/'/g,"\\'")}','PENDIENTES_POR_ATENDER_ITEMS')">
               Por atender (${pending})
             </button>`
          :''
        }

        ${Number(x.entrega_parcial||0)>0
          ?`<button class="btn secondary small"
                    onclick="openLawyerRequests('${x.solicitante.replace(/'/g,"\\'")}','ENTREGA PARCIAL')">
               Parcial (${Number(x.entrega_parcial||0)})
             </button>`
          :''
        }

        ${Number(x.entrega_total||0)>0
          ?`<button class="btn secondary small"
                    onclick="openLawyerRequests('${x.solicitante.replace(/'/g,"\\'")}','ENTREGA TOTAL')">
               Entrega total (${Number(x.entrega_total||0)})
             </button>`
          :''
        }

        ${Number(x.por_recibir||0)>0
          ?`<button class="btn secondary small"
                    onclick="openLawyerRequests('${x.solicitante.replace(/'/g,"\\'")}','PENDIENTE DE CIERRE')">
               Por recibir (${Number(x.por_recibir||0)})
             </button>`
          :''
        }
      </div>
    </div>
  `;
  }).join('');
}

async function openLawyerRequests(nombre,estado=''){
  switchTab('requests',document.querySelector('[data-tab="requests"]'));
  el('requestSearch').value=nombre;
  el('requestStateFilter').value=estado;

  // Desde Solicitudes por abogado se contabilizan todas las solicitudes
  // del usuario, sin separar ADMINISTRADOR / USUARIO.
  if(isAdmin()&&el('requestOriginFilter')){
    el('requestOriginFilter').value='';
  }

  await loadRequests();
}


function updateMyRequestCards(){
  if(!isLimitedUser())return;

  const state=el('requestStateFilter')?.value||'';
  const map={
    '':'userRqTotalSolicitudes',
    'REGISTRADA':'userRqRegistradas',
    'PENDIENTES_POR_ATENDER_ITEMS':'userRqArchivo',
    'CARGO PENDIENTE DE ENTREGA':'userRqCargoPendiente',
    'ENTREGA PARCIAL':'userRqParcial',
    'ENTREGA TOTAL':'userRqTotal'
  };

  Object.entries(map).forEach(([key,id])=>{
    if(el(id))el(id).classList.toggle('selected',state===key);
  });
}

async function selectMyRequestCard(estado){
  if(!isLimitedUser())return;

  if(el('requestStateFilter')){
    el('requestStateFilter').value=estado;
  }

  updateMyRequestCards();
  if(!showCachedRequestView(estado))await loadRequests();

  if(el('requestsTable')){
    el('requestsTable').scrollIntoView({behavior:'auto',block:'start'});
  }
}

async function selectAdminRequestCard(estado){
  if(!hasFullAccess())return;
  if(el('requestStateFilter'))el('requestStateFilter').value=estado||'';
  updateAdminRequestCards();
  if(!showCachedRequestView(estado||''))await loadRequests();
  el('requestsTable')?.scrollIntoView({behavior:'auto',block:'start'});
}
function updateAdminRequestCards(){
  if(!hasFullAccess())return;
  const state=el('requestStateFilter')?.value||'';
  document.querySelectorAll('#fullRequestKpis [data-rq-state]').forEach(card=>{
    card.classList.toggle('selected',(card.dataset.rqState||'')===state);
  });
}
async function clearRequestWorkflowFilter(){
  if(el('requestSearch'))el('requestSearch').value='';
  if(el('requestStateFilter'))el('requestStateFilter').value='';
  if(el('requestOriginFilter'))el('requestOriginFilter').value='';
  if(el('requestAgeFilter'))el('requestAgeFilter').value='';
  if(el('requestAgeOrder'))el('requestAgeOrder').value='RECENT';
  if(el('requestPendingPriority'))el('requestPendingPriority').value='';
  requestViewCache=null;
  await applyRequestFilterChange('clear');
}
function requestWorkflowAction(r){
  const st=r.estado_atencion||r.estado||'';

  // V209 · COORDINADOR:
  // En cualquier espacio (personal o equipo) la solicitud es SOLO LECTURA.
  // Nunca puede atender, continuar atención, regularizar cargo,
  // recibir devolución ni gestionar como Archivo.
  if(isCoordinator()){
    if(st==='EN ESPERA DE DEVOLUCIÓN'){
      return `<button class="btn secondary small" onclick="openRequestDetail('${r.id}')">Ver seguimiento</button>`;
    }
    // V313 · En el perfil COORDINADOR no se muestra la acción «Ver solicitud».
    return '';
  }

  if(!hasFullAccess())return `<button class="btn secondary small" onclick="openRequestDetail('${r.id}')">Ver solicitud</button>`;
  if(st==='EN ESPERA DE DEVOLUCIÓN')return `<button class="btn secondary small" onclick="openRequestDetail('${r.id}')">Ver espera</button>`;
  if(st==='REGISTRADA')return `<button class="btn small" onclick="openRequestDetail('${r.id}')">Gestionar</button>`;
  if(
    st==='REGISTRADA POR ARCHIVO' ||
    st==='PENDIENTE POR ATENDER' ||
    st==='ACEPTADO'
  ){
    return `<button class="btn small" onclick="openEditRequest('${r.id}')">Atender solicitud</button>`;
  }
  if(st==='CARGO PENDIENTE DE ENTREGA')return `<button class="btn small" onclick="openRequestDetail('${r.id}')">Regularizar cargo</button>`;
  if(st==='ENTREGA PARCIAL')return `<button class="btn small" onclick="openEditRequest('${r.id}')">Continuar atención</button>`;
  if(st==='ENTREGA TOTAL')return `<button class="btn secondary small" onclick="openRequestDetail('${r.id}')">Ver entrega</button>`;
  if(st==='PENDIENTE DE CIERRE')return `<button class="btn small" onclick="openRequestDetail('${r.id}')">Recibir devolución</button>`;
  if(st==='CERRADA POR ARCHIVO')return `<button class="btn secondary small" onclick="openRequestDetail('${r.id}')">Ver historial</button>`;
  if(['CERRADA POR ADMINISTRADOR','CERRADO POR ADMINISTRADOR'].includes(st))return `<button class="btn secondary small" onclick="openRequestDetail('${r.id}')">Ver historial</button>`;
  return `<button class="btn secondary small" onclick="openRequestDetail('${r.id}')">Gestionar</button>`;
}

function pendingRequestMatchKey(row){
  const id=String(row?.solicitud_id||row?.id||'').trim();
  if(id)return 'ID:'+id;
  const num=String(row?.solicitud_numero||row?.numero||'').trim();
  const sol=String(row?.solicitante||'').trim().toUpperCase();
  return 'NUM:'+num+'|SOL:'+sol;
}

function requestRowPendingKeys(row){
  const keys=[];
  const id=String(row?.id||row?.solicitud_id||'').trim();
  if(id)keys.push('ID:'+id);
  const num=String(row?.numero||row?.solicitud_numero||'').trim();
  const sol=String(row?.solicitante||'').trim().toUpperCase();
  if(num)keys.push('NUM:'+num+'|SOL:'+sol);
  return keys;
}


async function enrichRequestHeadersWithCreatedAt(rows){
  const list=Array.isArray(rows)?rows:[];
  if(!list.length||!sb||!session)return list;

  const ids=[...new Set(
    list.map(r=>String(r?.id||'').trim()).filter(Boolean)
  )];

  if(!ids.length)return list;

  const {data,error}=await sb
    .from('solicitudes_prestamo')
    .select('id,created_at,fecha_solicitud')
    .in('id',ids);

  if(error)console.warn('Hora real de solicitud:',error.message);

  const map=new Map(
    (data||[]).map(r=>[
      String(r.id),
      {
        created_at:r.created_at||null,
        fecha_solicitud:r.fecha_solicitud||null
      }
    ])
  );

  let enriched=list.map(r=>{
    const exact=map.get(String(r.id||''));
    if(!exact)return r;

    return {
      ...r,
      created_at:exact.created_at||r.created_at||null,
      solicitud_created_at:exact.created_at||r.solicitud_created_at||null,
      fecha_solicitud:r.fecha_solicitud||exact.fecha_solicitud||null
    };
  });

  // La política de lectura directa puede ocultar la cabecera al Coordinador.
  // El detalle V211 comprueba en Supabase que la solicitud pertenece a su equipo.
  if(isCoordinator() && enriched.some(r=>!requestHasRealHourV417(r))){
    const missing=enriched.filter(r=>
      r?.id && !requestHasRealHourV417(r)
    );
    const recovered=new Map();
    for(let i=0;i<missing.length;i+=4){
      await Promise.all(missing.slice(i,i+4).map(async r=>{
        try{
          const response=await sb.rpc(
            'v211_coordinador_detalle_solicitud',
            {p_solicitud_id:r.id}
          );
          if(response.error)throw response.error;
          const header=v211JsonObject(response.data)?.header||{};
          if(requestHasRealHourV417(header))recovered.set(String(r.id),header);
        }catch(detailError){
          console.warn('Hora de solicitud del equipo:',detailError?.message||detailError);
        }
      }));
    }
    enriched=enriched.map(r=>{
      const header=recovered.get(String(r?.id||''));
      return header?{
        ...r,
        solicitud_created_at:header.solicitud_created_at||header.created_at||
          (requestHasRealHourV417({fecha_solicitud:header.fecha_solicitud})?header.fecha_solicitud:null)||
          r.solicitud_created_at,
        hora_solicitud:header.hora_solicitud||header.hora_registro||r.hora_solicitud
      }:r;
    });
  }
  return enriched;
}

function requestHasRealHourV417(r){
  return [r?.solicitud_created_at,r?.created_at,r?.fecha_solicitud,
          r?.hora_solicitud,r?.hora_registro].some(value=>
    /(?:[T ]|^)\d{1,2}:\d{2}/.test(String(value||''))
  );
}


function expedienteAsuntoValue(r){
  return String(
    r?.asunto||
    r?.master_asunto||
    r?.asunto_requerimiento||
    r?.solicitud_asunto||
    ''
  ).trim();
}

async function enrichRowsWithExpedienteAsunto(rows){
  const list=Array.isArray(rows)?rows:[];
  if(!list.length||!sb||!session)return list;

  const missing=list.filter(r=>!expedienteAsuntoValue(r));
  if(!missing.length)return list;

  // =========================================================
  // V102 · FUENTE PRINCIPAL
  // Resolver el ASUNTO en PostgreSQL para evitar que las políticas RLS
  // del navegador oculten solicitudes/cargos de otros usuarios.
  //
  // Se envían los identificadores del ciclo visible:
  //   expediente_id + solicitud_numero + cargo_numero
  // para recuperar el asunto correcto de ESA atención.
  // =========================================================
  const rpcItems=missing
    .map(r=>({
      expediente_id:
        r?.expediente_id||
        r?.id||
        null,

      solicitud_numero:String(
        r?.solicitud_numero||
        r?.solicitud_pendiente_numero||
        ''
      ).trim()||null,

      cargo_numero:String(
        r?.cargo_numero||
        r?.cargo_devolucion_usuario||
        r?.cargo||
        ''
      ).trim()||null
    }))
    .filter(x=>x.expediente_id);

  const rpcByExp=new Map();

  if(rpcItems.length){
    const {data:rpcData,error:rpcError}=await sb.rpc(
      'obtener_asuntos_expedientes_operativo',
      {p_items:rpcItems}
    );

    if(!rpcError){
      (rpcData||[]).forEach(x=>{
        const expId=String(x.expediente_id||'');
        const asunto=String(x.asunto||'').trim();

        if(expId && asunto && !rpcByExp.has(expId)){
          rpcByExp.set(expId,{
            asunto,
            solicitud_numero:x.solicitud_numero||'',
            cargo_numero:x.cargo_numero||''
          });
        }
      });
    }else{
      console.warn(
        'obtener_asuntos_expedientes_operativo:',
        rpcError.message
      );
    }
  }

  let withRpc=list.map(r=>{
    if(expedienteAsuntoValue(r))return r;

    const expId=String(
      r?.expediente_id||
      r?.id||
      ''
    );

    const resolved=rpcByExp.get(expId);

    return resolved?.asunto
      ?{
          ...r,
          asunto:resolved.asunto,
          solicitud_numero:
            r.solicitud_numero||
            resolved.solicitud_numero||
            '',
          cargo_numero:
            r.cargo_numero||
            resolved.cargo_numero||
            ''
        }
      :r;
  });

  // Si la RPC resolvió todos los asuntos, terminar aquí.
  const stillMissing=withRpc.filter(r=>!expedienteAsuntoValue(r));
  if(!stillMissing.length)return withRpc;

  // =========================================================
  // RESPALDOS CLIENTE existentes
  // =========================================================
  const ids=[...new Set(
    stillMissing.map(r=>
      String(
        r?.solicitud_id||
        r?.solicitud_pendiente_id||
        ''
      ).trim()
    ).filter(Boolean)
  )];

  const numbers=[...new Set(
    stillMissing.map(r=>
      String(
        r?.solicitud_numero||
        r?.solicitud_pendiente_numero||
        ''
      ).trim()
    ).filter(Boolean)
  )];

  const cargoNumbers=[...new Set(
    stillMissing.map(r=>
      String(
        r?.cargo_numero||
        r?.cargo_devolucion_usuario||
        r?.cargo||
        ''
      ).trim()
    ).filter(v=>v && v!=='—')
  )];

  const byId=new Map();
  const byNumber=new Map();
  const byCargo=new Map();

  if(ids.length){
    const {data,error}=await sb
      .from('solicitudes_prestamo')
      .select('id,numero,asunto')
      .in('id',ids);

    if(!error){
      (data||[]).forEach(x=>{
        byId.set(String(x.id),x.asunto||'');
        if(x.numero)byNumber.set(String(x.numero).trim(),x.asunto||'');
      });
    }else{
      console.warn('Asunto por solicitud_id:',error.message);
    }
  }

  if(numbers.length){
    const missingNumbers=numbers.filter(n=>!byNumber.has(n));

    if(missingNumbers.length){
      const {data,error}=await sb
        .from('solicitudes_prestamo')
        .select('id,numero,asunto')
        .in('numero',missingNumbers);

      if(!error){
        (data||[]).forEach(x=>{
          if(x.id)byId.set(String(x.id),x.asunto||'');
          if(x.numero)byNumber.set(String(x.numero).trim(),x.asunto||'');
        });
      }else{
        console.warn('Asunto por número de solicitud:',error.message);
      }
    }
  }

  if(cargoNumbers.length){
    const {data,error}=await sb
      .from('cargos')
      .select('numero,asunto')
      .in('numero',cargoNumbers);

    if(!error){
      (data||[]).forEach(x=>{
        if(x.numero)byCargo.set(String(x.numero).trim(),x.asunto||'');
      });
    }else{
      console.warn('Asunto por cargo:',error.message);
    }
  }

  return withRpc.map(r=>{
    if(expedienteAsuntoValue(r))return r;

    const requestId=String(
      r?.solicitud_id||
      r?.solicitud_pendiente_id||
      ''
    ).trim();

    const requestNumber=String(
      r?.solicitud_numero||
      r?.solicitud_pendiente_numero||
      ''
    ).trim();

    const cargoNumber=String(
      r?.cargo_numero||
      r?.cargo_devolucion_usuario||
      r?.cargo||
      ''
    ).trim();

    const asunto=
      byId.get(requestId)||
      byNumber.get(requestNumber)||
      byCargo.get(cargoNumber)||
      '';

    return asunto?{...r,asunto}:r;
  });
}


async function enrichPanelRowsWithLatestStateTime(rows){
  const list=Array.isArray(rows)?rows:[];
  if(!list.length||!sb||!session)return list;

  const expedienteIds=[...new Set(
    list.map(r=>
      String(
        r?.expediente_id||
        r?.id||
        ''
      ).trim()
    ).filter(Boolean)
  )];

  if(!expedienteIds.length)return list;

  let movements=[];
  let items=[];

  try{
    const [movesResult,itemsResult]=await Promise.all([
      sb
        .from('movimientos_prestamo')
        .select('expediente_id,solicitud_id,accion,estado,created_at')
        .in('expediente_id',expedienteIds)
        .order('created_at',{ascending:false}),

      sb
        .from('solicitud_expedientes')
        .select('expediente_id,solicitud_id,estado,updated_at,created_at,fecha_entrega,fecha_solicitud_devolucion,fecha_devolucion')
        .in('expediente_id',expedienteIds)
        .order('updated_at',{ascending:false})
    ]);

    if(!movesResult.error){
      movements=movesResult.data||[];
    }else{
      console.warn('Hora último estado · movimientos:',movesResult.error.message);
    }

    if(!itemsResult.error){
      items=itemsResult.data||[];
    }else{
      console.warn('Hora último estado · ciclos:',itemsResult.error.message);
    }

  }catch(error){
    console.warn(
      'Hora real del último estado:',
      error?.message||error
    );
  }

  return list.map(r=>{
    const expedienteId=String(
      r?.expediente_id||
      r?.id||
      ''
    );

    const solicitudId=String(
      r?.solicitud_id||
      r?.solicitud_pendiente_id||
      ''
    );

    const state=norm(
      r?.estado_operativo||
      r?.ultimo_estado||
      r?.estado||
      operationalStatus(r)||
      ''
    );

    const movementCandidates=movements.filter(m=>
      String(m?.expediente_id||'')===expedienteId
    );

    // Prioridad: movimiento perteneciente al mismo ciclo visible.
    let movement=solicitudId
      ?movementCandidates.find(m=>
          String(m?.solicitud_id||'')===solicitudId
        )
      :null;

    // Respaldo: movimiento más reciente compatible con el estado.
    if(!movement){
      movement=movementCandidates.find(m=>{
        const action=norm(m?.accion||'');
        const moveState=norm(m?.estado||'');

        if(state==='EN PRÉSTAMO'){
          return (
            action.includes('ENTREGA') ||
            action.includes('CARGO GENERADO') ||
            moveState==='EN PRÉSTAMO'
          );
        }

        if(state==='REASIGNADO'){
          return action.includes('REASIGN');
        }

        if(state==='DEVOLUCIÓN SOLICITADA'){
          return (
            action.includes('DEVOLUC') ||
            moveState==='DEVOLUCIÓN SOLICITADA'
          );
        }

        if(state==='DEVUELTO AL ARCHIVO'){
          return (
            action.includes('DEVOLUCION CONFIRMADA') ||
            action.includes('DEVOLUCIÓN CONFIRMADA') ||
            action.includes('RECIBIDO EN ARCHIVO') ||
            moveState==='DEVUELTO AL ARCHIVO'
          );
        }

        return true;
      })||movementCandidates[0]||null;
    }

    const itemCandidates=items.filter(x=>
      String(x?.expediente_id||'')===expedienteId
    );

    let item=solicitudId
      ?itemCandidates.find(x=>
          String(x?.solicitud_id||'')===solicitudId
        )
      :null;

    if(!item)item=itemCandidates[0]||null;

    const timestamp=
      movement?.created_at||
      item?.updated_at||
      item?.created_at||
      null;

    if(!timestamp)return r;

    return {
      ...r,

      // Timestamp real del último cambio operativo del ciclo.
      ultimo_movimiento_fecha:
        timestamp,

      fecha_ultimo_estado:
        timestamp,

      estado_solicitud_item:
        item?.estado||
        r.estado_solicitud_item||
        ''
    };
  });
}

async function enrichPanelRowsWithRequestCreatedAt(rows){
  const list=Array.isArray(rows)?rows:[];
  if(!list.length||!sb||!session)return list;

  const ids=[...new Set(
    list.map(r=>
      String(
        r?.solicitud_id||
        r?.solicitud_pendiente_id||
        ''
      ).trim()
    ).filter(Boolean)
  )];

  const numbers=[...new Set(
    list.map(r=>
      String(
        r?.solicitud_numero||
        r?.solicitud_pendiente_numero||
        ''
      ).trim()
    ).filter(Boolean)
  )];

  const byId=new Map();
  const byNumber=new Map();

  if(ids.length){
    const {data,error}=await sb
      .from('solicitudes_prestamo')
      .select('id,numero,created_at,fecha_solicitud')
      .in('id',ids);

    if(!error){
      (data||[]).forEach(r=>{
        if(r.id)byId.set(String(r.id),r);
        if(r.numero)byNumber.set(String(r.numero).trim(),r);
      });
    }else{
      console.warn('Hora real de solicitud en Mis expedientes:',error.message);
    }
  }

  const missingNumbers=numbers.filter(n=>!byNumber.has(n));

  if(missingNumbers.length){
    const {data,error}=await sb
      .from('solicitudes_prestamo')
      .select('id,numero,created_at,fecha_solicitud')
      .in('numero',missingNumbers);

    if(!error){
      (data||[]).forEach(r=>{
        if(r.id)byId.set(String(r.id),r);
        if(r.numero)byNumber.set(String(r.numero).trim(),r);
      });
    }else{
      console.warn('Hora real por número de solicitud:',error.message);
    }
  }

  return list.map(r=>{
    const requestId=String(
      r?.solicitud_id||
      r?.solicitud_pendiente_id||
      ''
    ).trim();

    const requestNumber=String(
      r?.solicitud_numero||
      r?.solicitud_pendiente_numero||
      ''
    ).trim();

    const exact=
      byId.get(requestId)||
      byNumber.get(requestNumber)||
      null;

    if(!exact)return r;

    return {
      ...r,
      solicitud_id:r.solicitud_id||exact.id||null,
      solicitud_created_at:
        exact.created_at||
        r.solicitud_created_at||
        null,
      created_at:
        exact.created_at||
        r.created_at||
        null,
      fecha_solicitud:
        r.fecha_solicitud||
        exact.fecha_solicitud||
        null
    };
  });
}

async function applyAdminClosedStateToRequests(rows){
  /* V720 · Consulta de estados de cada expediente solicitado.
     La fuente final del estado es Supabase; una copia digital ya entregada
     jamás vuelve a clasificarse como pendiente. Se conservan todos los ciclos. */
  const list=Array.isArray(rows)?rows:[];
  if(!list.length||!sb||!session)return list;

  const ids=[...new Set(list.map(r=>String(r?.id||'')).filter(Boolean))];
  if(!ids.length)return list;

  const byRequest=new Map();
  const idChunkSize=100;
  const pageSize=700;
  for(let offset=0;offset<ids.length;offset+=idChunkSize){
    const chunk=ids.slice(offset,offset+idChunkSize);
    for(let from=0;;from+=pageSize){
      const {data,error}=await sb.from('solicitud_expedientes')
        .select('id,solicitud_id,estado')
        .in('solicitud_id',chunk)
        .order('solicitud_id',{ascending:true})
        .order('id',{ascending:true})
        .range(from,from+pageSize-1);
      if(error){
        console.warn('V720 · estados de solicitudes:',error.message);
        break; // Mantener la cabecera si faltan datos por RLS o red.
      }
      const items=Array.isArray(data)?data:[];
      for(const item of items){
        const key=String(item?.solicitud_id||'');
        if(!key)continue;
        if(!byRequest.has(key))byRequest.set(key,[]);
        byRequest.get(key).push(norm(item?.estado||''));
      }
      if(items.length<pageSize)break;
    }
  }

  const isAdminClosed=st=>['CERRADO POR ADMINISTRADOR','CERRADA POR ADMINISTRADOR'].includes(st);
  const attendedStates=new Set([
    'EN PRESTAMO','DEVOLUCION SOLICITADA','DEVUELTO',
    'REASIGNADO','DEVUELTO AL ARCHIVO','CERRADO POR ARCHIVO',
    'CERRADA POR ARCHIVO','COPIA DIGITAL ENTREGADA'
  ]);
  return list.map(r=>{
    const states=byRequest.get(String(r?.id||''))||[];
    const total=Math.max(0,Number(r?.total_expedientes||0));
    const complete=total>0 && states.length===total;
    const closedCount=states.filter(isAdminClosed).length;
    const digitalCount=states.filter(st=>st==='COPIA DIGITAL ENTREGADA').length;
    const attendedCount=states.filter(st=>attendedStates.has(
      st.normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    )).length;
    const head=norm(r?.estado||'');
    const attention=norm(r?.estado_atencion||'');
    const headerClosed=isAdminClosed(head)||isAdminClosed(attention);
    const base={...r,
      _admin_closed_count:closedCount,
      _v720_digital_delivered_count:digitalCount,
      _v720_attended_item_count:attendedCount,
      _v720_items_complete:complete
    };

    // Sólo considerar un cierre integral si existe confirmación en la cabecera
    // o se han recuperado TODOS los vínculos de la solicitud.
    if(headerClosed||(complete && closedCount===total)){
      return {...base,
        estado:'CERRADA POR ADMINISTRADOR',
        estado_atencion:'CERRADA POR ADMINISTRADOR',
        _admin_closed_count:Math.max(closedCount,total),
        _v719_estado_confirmado:true};
    }

    // La RPC antigua puede mostrar una copia ya entregada como "REGISTRADA".
    // Un requerimiento compuesto únicamente por copias ya entregadas está
    // atendido; se conserva el estado original de cabecera en la BD.
    if(complete && digitalCount===total){
      return {...base,estado_atencion:'ENTREGA TOTAL',
        _v720_digital_total:true};
    }
    return base;
  });
}

let requestViewCache=null;
function currentRequestViewCacheKey(){
  const search=cleanSearch(el('requestSearch')?.value||'');
  const origin=isAdmin()?(el('requestOriginFilter')?.value||''):'';
  return JSON.stringify([
    session?.user?.id||'',
    norm(currentProfile?.nombre_personal||''),
    search,
    origin
  ]);
}
function showCachedRequestView(state){
  const cache=requestViewCache;
  if(!cache||cache.key!==currentRequestViewCacheKey()||Date.now()-cache.savedAt>30000)return false;

  if(state==='EN ESPERA DE DEVOLUCIÓN'){
    requestRows=sortRequestsByIngresoDesc(cache.rows.filter(r=>Number(r._cross_wait_count||0)>0),'numero');
  }else if(state==='PENDIENTES_POR_ATENDER_ITEMS'){
    requestRows=sortRequestsByIngresoDesc(cache.rows.filter(r=>requestCountsAsPendingAttentionV163(r)),'numero');
  }else if(!state){
    requestRows=sortRequestsByIngresoDesc(cache.rows,'numero');
  }else{
    requestRows=sortRequestsByIngresoDesc(cache.rows.filter(r=>
      norm(r.estado_atencion||r.estado||'')===norm(state)
    ),'numero');
  }
  if(el('requestsCount'))el('requestsCount').textContent=requestRows.length+' solicitud'+(requestRows.length===1?'':'es');
  if(isLimitedUser()){
    const title=el('requestsTable')?.previousElementSibling?.querySelector('strong');
    if(title)title.textContent=state?`Mis solicitudes · ${requestStateDisplayName(state)}`:'Mis solicitudes';
  }
  if(el('requestsListTitle')&&hasFullAccess()){
    el('requestsListTitle').textContent=state
      ?`Bandeja de solicitudes · ${requestStateDisplayName(state)}`
      :'Bandeja de solicitudes';
  }
  updateMyRequestCards();updateAdminRequestCards();renderRequests();
  return true;
}


let __returnAlertRepairRunning=false;
let __returnAlertRepairAt=0;

async function repairMissingCustodianReturnAlerts(rows){
  if(!isLimitedUser()||!sb||!session||__returnAlertRepairRunning)return;

  const now=Date.now();
  if(now-__returnAlertRepairAt<30000)return;

  const requests=(rows||[]).filter(r=>
    [
      'PENDIENTE POR ATENDER',
      'ACEPTADO',
      'REGISTRADA',
      'SOLICITADO'
    ].includes(norm(r.estado_atencion||r.estado||''))
  );

  if(!requests.length)return;

  __returnAlertRepairRunning=true;
  __returnAlertRepairAt=now;

  try{
    await loadInternalReassignRequests(true);

    const existing=new Set(
      (internalReassignRows||[])
        .filter(r=>norm(r.estado)==='PENDIENTE')
        .map(r=>String(r.expediente_id||''))
    );

    const requestMap=new Map(
      requests.map(r=>[String(r.id||''),r])
    );

    const requestIds=[...requestMap.keys()].filter(Boolean);
    if(!requestIds.length)return;

    const {data:links,error:linkError}=await sb
      .from('solicitud_expedientes')
      .select('solicitud_id,expediente_id,estado')
      .in('solicitud_id',requestIds);

    if(linkError){
      console.warn('Reparar alertas de custodio:',linkError.message);
      return;
    }

    const expIds=[...new Set(
      (links||[]).map(x=>x.expediente_id).filter(Boolean)
    )];

    if(!expIds.length)return;

    const {data:expRows,error:expError}=await sb
      .from('expedientes')
      .select('id,expediente,extension,responsable,estado')
      .in('id',expIds);

    if(expError){
      console.warn('Reparar alertas de custodio:',expError.message);
      return;
    }

    const expMap=new Map((expRows||[]).map(x=>[String(x.id),x]));
    const me=String(currentProfile?.nombre_personal||'').trim();
    const myArea=String(catalogPersonByName(me)?.area_trabajo||'').trim();

    for(const link of (links||[])){
      const exp=expMap.get(String(link.expediente_id||''));
      if(!exp||existing.has(String(exp.id)))continue;

      const holder=String(exp.responsable||'').trim();
      if(!holder || norm(holder)===norm(me))continue;

      const holderArea=String(catalogPersonByName(holder)?.area_trabajo||'').trim();

      const sameArea=
        !!myArea &&
        !!holderArea &&
        areaMatchKey(myArea)===areaMatchKey(holderArea);

      if(!sameArea)continue;

      const request=requestMap.get(String(link.solicitud_id||''))||{};

      const {error}=await sb.rpc('solicitar_reasignacion_personal_v242',{
        p_expediente_id:exp.id,
        p_asunto:request.asunto||'SOLICITUD DE EXPEDIENTE',
        p_observacion:
          `Aviso automático de devolución por la solicitud ${request.numero||'registrada'}. `+
          `El expediente está actualmente en custodia de ${holder}. `+
          `Debe devolverse a Archivo para continuar con la atención.`
      });

      if(!error){
        existing.add(String(exp.id));
      }else{
        console.warn(
          `No se pudo generar aviso automático para ${exp.expediente}:`,
          error.message
        );
      }
    }

    await loadInternalReassignRequests(true);

  }finally{
    __returnAlertRepairRunning=false;
  }
}



function coordinatorTeamUsesDirectV218(type){
  return ['CUSTODIA','PRESTAMO','REASIGNADOS_A_MI']
    .includes(String(type||'').toUpperCase());
}

// ============================================================
// V410 · CONSISTENCIA ENTRE CONTADOR Y DETALLE DEL COORDINADOR
//
// Problema corregido:
//   El resumen V409 podía indicar, por ejemplo, 66 EN PRÉSTAMO y la
//   consulta de detalle PRESTAMO devolver 0 filas para el Coordinador.
//
// Regla V410:
//   - Se conserva la RPC segura V409 y la validación del equipo en Supabase.
//   - CUSTODIA sigue siendo la fuente física principal del integrante.
//   - Para PRESTAMO / REASIGNADOS_A_MI, si la consulta específica no
//     coincide con el contador, el detalle se reconstruye desde CUSTODIA
//     usando el mismo estado operativo que muestra el sistema.
//   - Nunca se amplía el alcance: el Coordinador continúa viendo solamente
//     a los integrantes autorizados de su equipo.
// ============================================================
function coordinatorExpectedCountV410(nombre,pTipo){
  const row=(ownerCardsRows||[]).find(
    x=>norm(x?.nombre||'')===norm(nombre||'')
  );

  if(!row)return null;

  const map={
    CUSTODIA:'total_custodia',
    PRESTAMO:'en_prestamo',
    REASIGNADOS_A_MI:'reasignados',
    PENDIENTES_POR_ATENDER:'pendientes_por_atender',
    DEVOLUCION_SOLICITADA:'devoluciones_pendientes_aceptacion',
    DEVUELTOS_AL_ARCHIVO:'devoluciones_realizadas',
    ALERTAS_30:'alertas_30'
  };

  const key=map[String(pTipo||'').toUpperCase()];
  if(!key)return null;

  const value=Number(row?.[key]);
  return Number.isFinite(value)?value:null;
}

function coordinatorOperationalStateV410(row){
  let primary='';

  try{
    primary=norm(operationalStatus(row)||'');
  }catch(_){
    primary='';
  }

  /*
    V411: la respuesta CUSTODIA de V409 puede traer el estado en campos
    distintos de los usados por la consulta PRESTAMO. Debemos leer TODOS
    los nombres que ya utiliza el sistema (incluidos ultimo_estado,
    estado_actual y estado_item).
  */
  const raw=[
    primary,
    row?.situacion_operativa,
    row?.estado_operativo,
    row?.ultimo_estado,
    row?.estado_actual_db,
    row?.estado_actual,
    row?.estado_item,
    row?.estado_solicitud_item,
    row?.estado,
    row?.ultimo_movimiento,
    row?.accion
  ].map(v=>norm(v||'')).filter(Boolean);

  return {
    primary,
    raw,
    text:raw.join(' | ')
  };
}

function coordinatorFilterCustodyRowsV410(rows,pTipo){
  const type=String(pTipo||'').toUpperCase();
  const list=Array.isArray(rows)?rows:[];

  if(type==='CUSTODIA')return list;

  /*
    V411: utilizar primero la clasificación única V406, que ya reconoce
    EN PRÉSTAMO, PRESTAMO sin tilde, ENTREGA EN PRÉSTAMO, CARGO GENERADO,
    EN CUSTODIA DEL USUARIO y REASIGNADO. Esto evita que el contador diga
    4 préstamos mientras el detalle quede en cero.
  */
  if(typeof coordinatorFilterCustodyV406==='function'){
    const derived=coordinatorFilterCustodyV406(list,type);
    if(Array.isArray(derived) && derived.length){
      return derived;
    }
  }

  if(type==='PRESTAMO'){
    return list.filter(row=>{
      const state=coordinatorOperationalStateV410(row);
      const text=state.text;
      const isLoan=(
        state.primary==='EN PRÉSTAMO' ||
        state.primary==='EN PRESTAMO' ||
        text.includes('EN PRÉSTAMO') ||
        text.includes('EN PRESTAMO') ||
        text.includes('PRÉSTAMO') ||
        text.includes('PRESTAMO') ||
        text.includes('ATENDIDO CON CARGO') ||
        text.includes('CARGO GENERADO') ||
        text.includes('ENTREGA EN PRÉSTAMO') ||
        text.includes('ENTREGA EN PRESTAMO') ||
        text.includes('EN CUSTODIA DEL USUARIO')
      );

      const isReassigned=(
        text.includes('REASIGNADO') ||
        text.includes('REASIGNACIÓN') ||
        text.includes('REASIGNACION') ||
        text.includes('DERIVADO A USUARIO')
      );

      const isReturnRequested=(
        text.includes('DEVOLUCIÓN SOLICITADA') ||
        text.includes('DEVOLUCION SOLICITADA')
      );

      return isLoan && !isReassigned && !isReturnRequested;
    });
  }

  if(type==='REASIGNADOS_A_MI'){
    return list.filter(row=>{
      const state=coordinatorOperationalStateV410(row);
      const text=state.text;
      return (
        state.primary==='REASIGNADO' ||
        text.includes('REASIGNADO') ||
        text.includes('REASIGNACIÓN') ||
        text.includes('REASIGNACION') ||
        text.includes('DERIVADO A USUARIO')
      ) &&
        !text.includes('REASIGNACIÓN SOLICITADA') &&
        !text.includes('REASIGNACION SOLICITADA');
    });
  }

  return [];
}

async function coordinatorTeamRowsV218(nombre,type,search=''){
  const pTipo=String(type||'CUSTODIA').toUpperCase();
  const pBusqueda=cleanSearch(search||'')||null;

  // Primera consulta: misma fuente segura V409 que Administración/Archivo.
  const {data,error}=await coordinatorCardRpcV404({
    p_nombre:nombre,
    p_tipo:pTipo,
    p_busqueda:pBusqueda
  });

  if(error)throw coordinatorTrackingErrorV404(error);

  const directRows=v211JsonRows(data);

  // Las demás bandejas mantienen su consulta específica.
  if(!['PRESTAMO','REASIGNADOS_A_MI'].includes(pTipo)){
    return directRows;
  }

  const expected=coordinatorExpectedCountV410(nombre,pTipo);

  // Si la consulta específica ya coincide con el resumen, no hacer nada más.
  if(
    expected!==null &&
    directRows.length===expected &&
    !pBusqueda
  ){
    return directRows;
  }

  // Con búsqueda activa, una cantidad menor es normal. Solo reconstruimos
  // cuando la consulta específica está vacía; así no anulamos el buscador.
  if(pBusqueda && directRows.length){
    return directRows;
  }

  // Fuente de respaldo: TOTAL EN CUSTODIA del mismo integrante, mediante la
  // MISMA RPC segura. Desde allí se deriva el estado visible.
  const custodyResponse=await coordinatorCardRpcV404({
    p_nombre:nombre,
    p_tipo:'CUSTODIA',
    p_busqueda:pBusqueda
  });

  if(custodyResponse?.error){
    console.warn(
      `V410 · respaldo CUSTODIA de ${nombre}:`,
      custodyResponse.error?.message||custodyResponse.error
    );
    return directRows;
  }

  const custodyRows=v211JsonRows(custodyResponse?.data);
  let rebuilt=coordinatorFilterCustodyRowsV410(custodyRows,pTipo);

  // Caso inequívoco: el resumen dice que TODOS los expedientes en custodia
  // pertenecen al estado solicitado (ej. 66 custodia / 66 en préstamo).
  // Esto cubre registros antiguos donde la fila no trae todos los campos
  // necesarios para reconstruir operationalStatus en el navegador.
  if(
    !pBusqueda &&
    expected!==null &&
    expected>0 &&
    expected===custodyRows.length &&
    rebuilt.length!==expected
  ){
    rebuilt=custodyRows;
  }

  /*
    V411: cuando el resumen separa exactamente la custodia entre préstamos
    y reasignados (ej. 5 total = 4 préstamo + 1 reasignado), usar la otra
    clasificación como exclusión. No se seleccionan filas arbitrariamente.
  */
  if(!pBusqueda && expected!==null && expected>0 && rebuilt.length!==expected){
    const summary=(ownerCardsRows||[]).find(
      x=>norm(x?.nombre||'')===norm(nombre||'')
    )||{};

    const total=Number(summary.total_custodia||custodyRows.length||0);
    const loanExpected=Number(summary.en_prestamo||0);
    const reassignedExpected=Number(summary.reasignados||0);

    if(total===custodyRows.length && loanExpected+reassignedExpected===total){
      if(pTipo==='PRESTAMO'){
        const reassigned=coordinatorFilterCustodyRowsV410(
          custodyRows,
          'REASIGNADOS_A_MI'
        );
        if(reassigned.length===reassignedExpected){
          const excluded=new Set(
            reassigned.map(row=>String(
              row?.expediente_id||row?.id||coordinatorExpNumberV216(row)||''
            ))
          );
          const complement=custodyRows.filter(row=>!excluded.has(String(
            row?.expediente_id||row?.id||coordinatorExpNumberV216(row)||''
          )));
          if(complement.length===loanExpected)rebuilt=complement;
        }
      }else if(pTipo==='REASIGNADOS_A_MI'){
        const loans=coordinatorFilterCustodyRowsV410(custodyRows,'PRESTAMO');
        if(loans.length===loanExpected){
          const excluded=new Set(
            loans.map(row=>String(
              row?.expediente_id||row?.id||coordinatorExpNumberV216(row)||''
            ))
          );
          const complement=custodyRows.filter(row=>!excluded.has(String(
            row?.expediente_id||row?.id||coordinatorExpNumberV216(row)||''
          )));
          if(complement.length===reassignedExpected)rebuilt=complement;
        }
      }
    }
  }

  /*
    V411 · segundo respaldo: consultar la bandeja complementaria y usarla
    como exclusión cuando esa consulta sí devuelve sus filas.
    Ejemplo: 5 custodia = 4 préstamo + 1 reasignado. Si PRESTAMO devuelve 0
    pero REASIGNADOS_A_MI devuelve 1, se muestran los otros 4 como préstamo.
  */
  if(!pBusqueda && expected!==null && expected>0 && rebuilt.length!==expected){
    const summary=(ownerCardsRows||[]).find(
      x=>norm(x?.nombre||'')===norm(nombre||'')
    )||{};

    const total=Number(summary.total_custodia||custodyRows.length||0);
    const loanExpected=Number(summary.en_prestamo||0);
    const reassignedExpected=Number(summary.reasignados||0);
    const complementaryType=pTipo==='PRESTAMO'
      ?'REASIGNADOS_A_MI'
      :'PRESTAMO';
    const complementaryExpected=pTipo==='PRESTAMO'
      ?reassignedExpected
      :loanExpected;

    if(
      total===custodyRows.length &&
      complementaryExpected>=0 &&
      expected+complementaryExpected===total
    ){
      try{
        const complementaryResponse=await coordinatorCardRpcV404({
          p_nombre:nombre,
          p_tipo:complementaryType,
          p_busqueda:null
        });

        if(!complementaryResponse?.error){
          const complementaryRows=v211JsonRows(complementaryResponse?.data);

          if(complementaryRows.length===complementaryExpected){
            const excluded=new Set(
              complementaryRows.map(row=>String(
                row?.expediente_id||row?.id||coordinatorExpNumberV216(row)||''
              ))
            );

            const complement=custodyRows.filter(row=>!excluded.has(String(
              row?.expediente_id||row?.id||coordinatorExpNumberV216(row)||''
            )));

            if(complement.length===expected){
              rebuilt=complement;
            }
          }
        }
      }catch(error){
        console.warn(
          `V411 · bandeja complementaria ${complementaryType} de ${nombre}:`,
          error?.message||error
        );
      }
    }
  }

  // Si el respaldo produce una lectura más coherente con el resumen, usarlo.
  const shouldUseRebuilt=(
    rebuilt.length>0 &&
    (
      directRows.length===0 ||
      (expected!==null && rebuilt.length===expected && directRows.length!==expected)
    )
  );

  if(shouldUseRebuilt){
    return rebuilt.map(row=>({
      ...row,
      _v410_detail_source:'CUSTODIA_RECONSTRUIDA'
    }));
  }

  return directRows;
}

async function coordinatorRequestRowsV211(search='',state=null){
  const scope=isCoordinatorSelfWorkspaceV206()
    ?'SELF'
    :'TEAM';

  const {data,error}=await sb.rpc(
    'v211_coordinador_solicitudes',
    {
      p_scope:scope,
      p_busqueda:search||null,
      p_estado:state||null
    }
  );

  if(error)throw error;
  return v211JsonRows(data);
}

function requestsVisibleForCurrentProfile(rows){
  const list=Array.isArray(rows)?rows:[];

  // COORDINADOR · ESPACIO PERSONAL:
  // se comporta como el perfil USUARIO de Marcela.
  if(isCoordinatorSelfWorkspaceV206()){
    const currentName=norm(currentProfile?.nombre_personal||'');
    if(!currentName)return [];
    return list.filter(r=>norm(r?.solicitante||'')===currentName);
  }

  // COORDINADOR · SEGUIMIENTO DEL EQUIPO:
  // solo Milton Diaz y Joan Valdivieso.
  if(isCoordinatorTeamWorkspaceV206()){
    const allowed=new Set(coordinatorAllowedUserNamesV205().map(norm));
    return list.filter(r=>allowed.has(norm(r?.solicitante||'')));
  }

  // Administrador y Archivo conservan la vista global.
  if(!isLimitedUser())return list;

  const currentName=norm(currentProfile?.nombre_personal||'');

  if(!currentName)return [];

  return list.filter(r=>
    norm(r?.solicitante||'')===currentName
  );
}


// ============================================================
// V254 · MEJORA CONSOLIDADA DEL CASO 01
// Mantiene el respaldo introducido en V250 para que ADMINISTRADOR / ARCHIVO
// no vea una bandeja vacía cuando la RPC omite una solicitud que sí está
// vinculada en solicitud_expedientes.
// V250 · RESPALDO PARA BANDEJA DE SOLICITUDES ADMINISTRADOR / ARCHIVO
// ============================================================
// En algunas sesiones la RPC listar_solicitudes_prestamo puede devolver 0
// aunque la solicitud exista y el vínculo expediente -> solicitud sea visible.
// Para evitar que Archivo vea una bandeja vacía, reconstruimos únicamente la
// información necesaria desde solicitud_expedientes + solicitudes_prestamo.
async function loadRequestsDirectFallbackV250(search=''){
  if(!sb||!session||!hasFullAccess())return [];

  const {data:links,error:linksError}=await sb
    .from('solicitud_expedientes')
    .select('solicitud_id,expediente_id,estado,fecha_entrega,fecha_solicitud_devolucion,fecha_devolucion,cargo_numero,created_at,updated_at')
    .order('created_at',{ascending:false})
    .limit(5000);

  if(linksError)throw linksError;
  if(!links?.length)return [];

  // Conservar las solicitudes más recientes para no generar consultas .in()
  // excesivamente largas en bases con muchos años de información.
  const requestIds=[];
  const seenRequestIds=new Set();
  for(const link of links){
    const id=String(link?.solicitud_id||'').trim();
    if(!id||seenRequestIds.has(id))continue;
    seenRequestIds.add(id);
    requestIds.push(id);
    if(requestIds.length>=800)break;
  }
  if(!requestIds.length)return [];

  const {data:headers,error:headersError}=await sb
    .from('solicitudes_prestamo')
    .select('*')
    .in('id',requestIds)
    .order('created_at',{ascending:false});

  if(headersError)throw headersError;
  if(!headers?.length)return [];

  const itemsByRequest=new Map();
  const visibleIdSet=new Set((headers||[]).map(h=>String(h.id||'')));
  const expIds=new Set();

  (links||[]).forEach(link=>{
    const requestId=String(link?.solicitud_id||'');
    if(!visibleIdSet.has(requestId))return;
    if(!itemsByRequest.has(requestId))itemsByRequest.set(requestId,[]);
    itemsByRequest.get(requestId).push(link);
    if(link?.expediente_id)expIds.add(String(link.expediente_id));
  });

  // Solo recuperamos los datos básicos del expediente para que el buscador de
  // Solicitudes también encuentre por N.° de expediente / extensión / R.D.
  const expMap=new Map();
  const expIdList=[...expIds].slice(0,5000);
  if(expIdList.length){
    const {data:expRows,error:expError}=await sb
      .from('expedientes')
      .select('id,expediente,extension,rd')
      .in('id',expIdList);
    if(!expError){
      (expRows||[]).forEach(r=>expMap.set(String(r.id),r));
    }else{
      console.warn('V250 · expedientes para búsqueda de solicitudes:',expError.message);
    }
  }

  const pendingStates=new Set([
    'SOLICITADO','REGISTRADA','REGISTRADA POR ARCHIVO',
    'ACEPTADO','PENDIENTE POR ATENDER','EN ESPERA DE DEVOLUCIÓN'
  ]);

  let rows=(headers||[]).map(h=>{
    const requestId=String(h.id||'');
    const items=itemsByRequest.get(requestId)||[];
    const total=items.length;

    const attended=items.filter(item=>{
      const state=norm(item?.estado||'');
      if(item?.fecha_entrega)return true;
      if(!state)return false;
      return !pendingStates.has(state);
    }).length;

    const devolucionesPendientes=items.filter(item=>
      norm(item?.estado||'')==='DEVOLUCIÓN SOLICITADA' && !item?.fecha_devolucion
    ).length;

    const cargos=[...new Set(items
      .map(item=>String(item?.cargo_numero||'').trim())
      .filter(v=>v&&v!=='—'))];

    const fechasEntrega=[...new Set(items
      .map(item=>item?.fecha_entrega)
      .filter(Boolean))]
      .sort();

    const expedientes=items
      .map(item=>expMap.get(String(item?.expediente_id||'')))
      .filter(Boolean);

    const searchExp=expedientes.map(e=>
      [e.expediente,e.extension,e.rd].filter(Boolean).join(' ')
    ).join(' ');

    return {
      ...h,
      total_expedientes:Number(h.total_expedientes||total||0),
      atendidos:Number.isFinite(Number(h.atendidos)) && h.atendidos!==null && h.atendidos!==''
        ?Number(h.atendidos)
        :attended,
      devoluciones_pendientes:Number.isFinite(Number(h.devoluciones_pendientes)) && h.devoluciones_pendientes!==null && h.devoluciones_pendientes!==''
        ?Number(h.devoluciones_pendientes)
        :devolucionesPendientes,
      cargo_numero:h.cargo_numero||cargos[0]||null,
      fechas_entrega_prestamo:Array.isArray(h.fechas_entrega_prestamo)
        ?h.fechas_entrega_prestamo
        :fechasEntrega,
      _v250_search_expedientes:searchExp,
      _v250_direct_fallback:true
    };
  });

  const q=norm(search||'');
  if(q){
    rows=rows.filter(r=>[
      r.numero,
      r.solicitante,
      r.asunto,
      r.modalidad,
      r.estado_atencion,
      r.estado,
      r.cargo_numero,
      r.observacion,
      r._v250_search_expedientes
    ].some(v=>norm(v||'').includes(q)));
  }

  return sortRequestsByIngresoDesc(rows,'numero');
}


async function v626EnrichRequestRows(rows){
  const list=Array.isArray(rows)?rows:[];
  if(!list.length || !sb || !session)return list;
  try{
    const {data,error}=await sb.rpc('v626_resumen_reiteraciones');
    if(error)throw error;
    const map=new Map((data||[]).map(x=>[String(x.solicitud_id||''),x]));
    const enriched=list.map(r=>{
      const info=map.get(String(r?.id||r?.solicitud_id||''));
      if(!info)return {
        ...r,
        v626_total_reiteraciones:0,
        v626_ultima_reiteracion_at:null,
        v626_dias_habiles_espera:0,
        v626_expedientes_pendientes:0,
        v626_puede_reiterar:false,
        v626_dias_para_reiterar:0
      };
      return {
        ...r,
        v626_total_reiteraciones:Number(info.total_reiteraciones||0),
        v626_ultima_reiteracion_at:info.ultima_reiteracion_at||null,
        v626_dias_habiles_espera:Number(info.dias_habiles_espera||0),
        v626_expedientes_pendientes:Number(info.expedientes_pendientes||0),
        v626_puede_reiterar:info.puede_reiterar===true,
        v626_dias_para_reiterar:Number(info.dias_para_reiterar||0)
      };
    });

    // Archivo / Administrador ve primero las solicitudes reiteradas sin
    // perder el orden relativo de las demás solicitudes.
    if(hasFullAccess?.()){
      return enriched
        .map((r,i)=>({r,i}))
        .sort((a,b)=>{
          const ar=Number(a.r.v626_total_reiteraciones||0)>0?1:0;
          const br=Number(b.r.v626_total_reiteraciones||0)>0?1:0;
          if(br!==ar)return br-ar;
          const at=new Date(a.r.v626_ultima_reiteracion_at||0).getTime()||0;
          const bt=new Date(b.r.v626_ultima_reiteracion_at||0).getTime()||0;
          if(br && bt!==at)return bt-at;
          return a.i-b.i;
        })
        .map(x=>x.r);
    }
    return enriched;
  }catch(error){
    console.warn('V626 · resumen de reiteraciones:',error?.message||error);
    return list;
  }
}

window.v626ReiterationButton=function(r){
  if(!r?.v626_puede_reiterar)return '';
  const id=String(r?.id||r?.solicitud_id||'');
  if(!id)return '';
  return `<button class="btn small v626-reiterate-btn" type="button" onclick="event.stopPropagation();openV626Reiteration('${id}')">🔔 Reiterar</button>`;
};

function v626ReiterationStateHtml(r){
  const total=Number(r?.v626_total_reiteraciones||0);
  const can=!!r?.v626_puede_reiterar;
  const pending=Number(r?.v626_expedientes_pendientes||0);
  const left=Number(r?.v626_dias_para_reiterar||0);
  let html='';
  if(total>0){
    html+=`<span class="v626-reit-badge">🔔 REITERADA ${total===1?'1 VEZ':total+' VECES'}</span>`;
  }
  if(can && pending>0){
    html+=`<span class="v626-reit-ready">Puede reiterar · ${pending} pendiente${pending===1?'':'s'}</span>`;
  }else if(!hasFullAccess?.() && pending>0 && left>0){
    html+=`<span class="v626-reit-wait">Reiterar en ${left} día${left===1?'':'s'} hábil${left===1?'':'es'}</span>`;
  }
  return html;
}

let v626ReiterationTarget=null;

window.openV626Reiteration=function(id){
  const all=[...(requestRows||[]),...((requestViewCache?.rows)||[])];
  const row=all.find(x=>String(x?.id||x?.solicitud_id||'')===String(id||''));
  if(!row){
    showToast?.('No se pudo identificar la solicitud para reiterarla.');
    return;
  }
  if(!row.v626_puede_reiterar){
    const left=Number(row.v626_dias_para_reiterar||0);
    showToast?.(left>0?`La reiteración estará disponible en ${left} día(s) hábil(es).`:'La solicitud ya no puede reiterarse.');
    return;
  }
  v626ReiterationTarget=row;
  const summary=el('v626ReitSummary');
  if(summary){
    summary.innerHTML=`
      <div><b>Solicitud:</b> ${esc(row.numero||'—')}</div>
      <div><b>Solicitante:</b> ${esc(row.solicitante||currentProfile?.nombre_personal||'—')}</div>
      <div><b>Asunto:</b> ${esc(row.asunto||'—')}</div>
      <div><b>Días hábiles transcurridos:</b> ${Number(row.v626_dias_habiles_espera||0)}</div>
      <div><b>Expedientes pendientes:</b> ${Number(row.v626_expedientes_pendientes||0)}</div>
      <div><b>Reiteraciones anteriores:</b> ${Number(row.v626_total_reiteraciones||0)}</div>`;
  }
  if(el('v626ReitObservation'))el('v626ReitObservation').value='';
  if(el('v626ReitStatus'))el('v626ReitStatus').textContent='';
  el('v626ReiterationModal')?.classList.add('show');
  setTimeout(()=>el('v626ReitObservation')?.focus(),60);
};

window.closeV626Reiteration=function(){
  el('v626ReiterationModal')?.classList.remove('show');
  v626ReiterationTarget=null;
};

window.submitV626Reiteration=async function(){
  const row=v626ReiterationTarget;
  if(!row)return;
  const btn=el('v626ReitSubmit');
  const status=el('v626ReitStatus');
  if(btn)btn.disabled=true;
  if(status)status.textContent='Registrando reiteración…';
  try{
    const {data,error}=await sb.rpc('v626_reiterar_solicitud',{
      p_solicitud_id:row.id||row.solicitud_id,
      p_observacion:String(el('v626ReitObservation')?.value||'').trim()||null
    });
    if(error)throw error;
    window.v586DrainMailInBackground?.('V626_REITERACION_SOLICITUD');
    showToast?.(`Reiteración N.° ${Number(data?.numero_reiteracion||0)} registrada. El correo quedó en cola.`);
    const requestId=String(row.id||row.solicitud_id||'');
    closeV626Reiteration();
    requestViewCache=null;
    await loadRequests();
    if(currentRequestId && String(currentRequestId)===requestId){
      await v626LoadReiterationHistory(requestId);
    }
  }catch(error){
    if(status)status.textContent=error?.message||String(error);
  }finally{
    if(btn)btn.disabled=false;
  }
};

window.v626LoadReiterationHistory=async function(id){
  const section=el('v626ReiterationSection');
  const box=el('v626ReiterationHistory');
  if(!section||!box||!id)return;
  try{
    const {data,error}=await sb.rpc('v626_listar_reiteraciones',{p_solicitud_id:id});
    if(error)throw error;
    const rows=Array.isArray(data)?data:[];
    if(!rows.length){
      section.classList.add('hidden');
      box.innerHTML='<div class="empty">Sin reiteraciones.</div>';
      return;
    }
    section.classList.remove('hidden');
    box.innerHTML=rows.map(r=>{
      const dt=r.reiterado_at?new Date(r.reiterado_at):null;
      const when=dt&&!Number.isNaN(dt.getTime())
        ?dt.toLocaleString('es-PE',{dateStyle:'short',timeStyle:'short'})
        :'—';
      return `<div class="v626-reit-event">
        <div class="v626-reit-event-num">🔔 ${Number(r.numero_reiteracion||0)}.ª reiteración</div>
        <div><b>${esc(r.reiterado_por_nombre||'—')}</b> · ${esc(when)}</div>
        <div>${Number(r.dias_habiles_pendiente||0)} días hábiles · ${Number(r.expedientes_pendientes||0)} expediente${Number(r.expedientes_pendientes||0)===1?'':'s'} pendiente${Number(r.expedientes_pendientes||0)===1?'':'s'}</div>
        ${r.observacion?`<div class="note">${esc(r.observacion)}</div>`:''}
      </div>`;
    }).join('');
  }catch(error){
    section.classList.remove('hidden');
    box.innerHTML=`<div class="empty">${esc(error?.message||String(error))}</div>`;
  }
};

async function loadRequests(){
  if(!sb||!session)return;

  // V693 · siempre leer la situación vigente antes de calcular las tarjetas.
  // Evita que una espera resuelta/cerrada permanezca hasta 20 s en caché.
  await loadCrossAreaWaits(true,true);

  const search=cleanSearch(el('requestSearch')?.value||'');
  const state=el('requestStateFilter')?.value||'';
  const origin=isAdmin()?(el('requestOriginFilter')?.value||''):'';
  const requestViewCacheKey=currentRequestViewCacheKey();

  // Primera consulta: siempre sin filtro de estado.
  // Sirve para mantener las cantidades correctas de todas las tarjetas.
  let allData=[];
  let allError=null;

  if(isCoordinator()){
    try{
      allData=await coordinatorRequestRowsV211(search,null);
    }catch(error){
      allError=error;
    }
  }else{
    const result=await sb.rpc('listar_solicitudes_prestamo',{
      p_busqueda:search||null,
      p_estado:null
    });
    allData=result.data;
    allError=result.error;
  }

  // V254 · regla consolidada del Caso 01:
  // la RPC sigue siendo la fuente principal. Si falla o devuelve 0, ADMINISTRADOR / ARCHIVO
  // reconstruye la bandeja desde el vínculo canónico antes de mostrar una bandeja vacía.
  if(hasFullAccess() && (allError || !(allData||[]).length)){
    try{
      const recovered=await loadRequestsDirectFallbackV250(search);
      if(recovered.length){
        allData=recovered;
        allError=null;
        console.info(`V250 · solicitudes recuperadas por vínculo: ${recovered.length}`);
      }
    }catch(fallbackError){
      console.warn('V250 · respaldo de solicitudes:',fallbackError?.message||fallbackError);
    }
  }

  if(allError){
    if(el('requestsTable')){
      el('requestsTable').innerHTML=`<div class="empty">${esc(allError.message)}</div>`;
    }
    return;
  }

  const profileScopedAllData=
    requestsVisibleForCurrentProfile(allData||[]);

  const allDataWithCreatedAt=
    await enrichRequestHeadersWithCreatedAt(profileScopedAllData);

  let allRequestRows=enrichRequestsWithCrossAreaWait(
    sortRequestsByIngresoDesc(
      await applyAdminClosedStateToRequests(
        await enrichRequestAttentionTimes(allDataWithCreatedAt)
      ),
      'numero'
    )
  );

  // V626 · una sola consulta adicional para toda la bandeja.
  allRequestRows=await v626EnrichRequestRows(allRequestRows);

  if(origin){
    allRequestRows=allRequestRows.filter(
      x=>requestOriginValue(x.origen_registro)===origin
    );
  }

  // Contador y bandeja usan exactamente el mismo criterio de solicitudes
  // visibles. Cada cabecera descuenta ítems atendidos y esperas de devolución.
  const pendingRequestCount=allRequestRows.filter(r=>
    requestCountsAsPendingAttentionV163(r)
  ).length;
  const pendingReadyUnits=allRequestRows.reduce((sum,r)=>
    sum+requestPendingUnitsV163(r),0
  );

  // V420 · En espera de devolución es una bandeja de SOLICITUDES.
  // La cifra grande cuenta exactamente las mismas cabeceras que se abren
  // al pulsar la tarjeta. El total de expedientes queda como desglose.
  const waitingRequestRows=allRequestRows.filter(r=>
    Number(r._cross_wait_count||0)>0
  );
  const waitingRequestCount=waitingRequestRows.length;
  const waitingExpedienteCount=waitingRequestRows.reduce(
    (sum,r)=>sum+Number(r._cross_wait_count||0),0
  );
  // The KPI cards only change the view. Keep the prepared rows so clicking a
  // card does not repeat the same database and enrichment queries.
  requestViewCache={
    key:requestViewCacheKey,
    savedAt:Date.now(),
    rows:allRequestRows.slice()
  };

  const counts={
    'REGISTRADA':0,
    'REGISTRADA POR ARCHIVO':0,
    'CARGO PENDIENTE DE ENTREGA':0,
    'ENTREGA PARCIAL':0,
    'ENTREGA TOTAL':0,
    'PENDIENTE DE CIERRE':0,
    'CERRADA POR ARCHIVO':0,
    'CERRADA POR ADMINISTRADOR':0,
    'CERRADO POR ADMINISTRADOR':0
  };

  allRequestRows.forEach(x=>{
    const st=x.estado_atencion||x.estado;
    if(counts[st]!==undefined)counts[st]++;
  });

  // Tarjetas ADMINISTRADOR / ARCHIVO
  if(el('rqSolicitado'))el('rqSolicitado').textContent=counts['REGISTRADA'];
  if(el('rqAceptado'))el('rqAceptado').textContent=pendingRequestCount;
  if(el('rqAceptadoExpedientes'))el('rqAceptadoExpedientes').textContent=pendingReadyUnits+' expediente'+(pendingReadyUnits===1?'':'s');
  if(el('rqAceptadoSolicitudes'))el('rqAceptadoSolicitudes').textContent=pendingRequestCount+' solicitud'+(pendingRequestCount===1?'':'es');
  if(el('rqCargoPendiente'))el('rqCargoPendiente').textContent=counts['CARGO PENDIENTE DE ENTREGA'];
  if(el('rqEntregaParcial'))el('rqEntregaParcial').textContent=counts['ENTREGA PARCIAL'];
  if(el('rqEsperaDevolucion'))el('rqEsperaDevolucion').textContent=waitingRequestCount;
  if(el('rqEntregaTotal'))el('rqEntregaTotal').textContent=counts['ENTREGA TOTAL'];
  if(el('rqPendienteRecepcion'))el('rqPendienteRecepcion').textContent=allRequestRows.reduce((a,x)=>a+Number(x.devoluciones_pendientes||0),0);
  if(el('rqDevuelto'))el('rqDevuelto').textContent=counts['CERRADA POR ARCHIVO'];
  if(el('rqTodas'))el('rqTodas').textContent=allRequestRows.length;

  // Tarjetas exclusivas del USUARIO
  if(el('uRqTotalSolicitudes'))el('uRqTotalSolicitudes').textContent=allRequestRows.length;
  if(el('uRqRegistradas'))el('uRqRegistradas').textContent=counts['REGISTRADA'];
  if(el('uRqArchivo'))el('uRqArchivo').textContent=pendingRequestCount;
  if(el('uRqEsperaDevolucion'))el('uRqEsperaDevolucion').textContent=waitingRequestCount;

  // V420 · Mostrar el doble contexto sin mezclar unidades:
  // cifra principal = solicitudes; detalle = expedientes esperando devolución.
  const waitAdminCard=el('rqEsperaDevolucion')?.closest('.kpi');
  const waitAdminNote=waitAdminCard?.querySelector('.note-mini');
  if(waitAdminNote){
    waitAdminNote.textContent=
      `${waitingRequestCount} solicitud${waitingRequestCount===1?'':'es'} · `+
      `${waitingExpedienteCount} expediente${waitingExpedienteCount===1?'':'s'} esperando devolución.`;
  }

  const waitUserCard=el('uRqEsperaDevolucion')?.closest('.kpi');
  let waitUserNote=waitUserCard?.querySelector('.v420-wait-breakdown');
  if(waitUserCard && !waitUserNote){
    waitUserNote=document.createElement('div');
    waitUserNote.className='note-mini v420-wait-breakdown';
    waitUserCard.appendChild(waitUserNote);
  }
  if(waitUserNote){
    waitUserNote.textContent=
      `${waitingRequestCount} solicitud${waitingRequestCount===1?'':'es'} · `+
      `${waitingExpedienteCount} expediente${waitingExpedienteCount===1?'':'s'} esperando devolución.`;
  }

  if(el('uRqCargoPendiente'))el('uRqCargoPendiente').textContent=counts['CARGO PENDIENTE DE ENTREGA'];
  if(el('uRqParcial'))el('uRqParcial').textContent=counts['ENTREGA PARCIAL'];
  if(el('uRqTotal'))el('uRqTotal').textContent=counts['ENTREGA TOTAL'];

  // V420 · CONTADOR Y DETALLE SIEMPRE PARTEN DE LA MISMA COLECCIÓN.
  // Ya no se ejecuta una segunda consulta por estado después de calcular
  // las tarjetas. Esto evita que la tarjeta indique una cantidad y la
  // bandeja abra otra diferente.
  if(state==='EN ESPERA DE DEVOLUCIÓN'){
    requestRows=sortRequestsByIngresoDesc(
      waitingRequestRows.slice(),
      'numero'
    );
  }else if(state==='PENDIENTES_POR_ATENDER_ITEMS'){
    requestRows=sortRequestsByIngresoDesc(
      allRequestRows.filter(r=>requestCountsAsPendingAttentionV163(r)),
      'numero'
    );
  }else if(state){
    const wantedState=norm(state||'');
    requestRows=sortRequestsByIngresoDesc(
      allRequestRows.filter(r=>
        norm(r.estado_atencion||r.estado||'')===wantedState
      ),
      'numero'
    );
  }else{
    requestRows=sortRequestsByIngresoDesc(allRequestRows,'numero');
  }

  // Refuerzo de privacidad de la vista.
  requestRows=requestsVisibleForCurrentProfile(requestRows);

  if(el('requestsCount')){
    el('requestsCount').textContent=
      requestRows.length+' solicitud'+(requestRows.length===1?'':'es');
  }

  // V92 · Revisar silenciosamente si alguna solicitud ya existente
  // necesita avisar al custodio actual. Esto corrige casos anteriores
  // al despliegue, por ejemplo un expediente solicitado por Marcela
  // que todavía permanece bajo custodia de Hans.
  if(isLimitedUser() && !isCoordinator()){
    repairMissingCustodianReturnAlerts(requestRows)
      .catch(error=>console.warn('Reparación de alertas:',error));
  }

  if(isLimitedUser()){
    const label=requestStateDisplayName(state||'TODAS');
    const title=el('requestsTable')?.previousElementSibling?.querySelector('strong');
    if(title){
      title.textContent=state
        ?`Mis solicitudes · ${label}`
        :'Mis solicitudes';
    }
  }else if(isCoordinatorTeamWorkspaceV206()){
    const label=requestStateDisplayName(state||'TODAS');
    const title=el('requestsTable')?.previousElementSibling?.querySelector('strong');
    if(title){
      title.textContent=state
        ?`Solicitudes del equipo · ${label}`
        :'Solicitudes del equipo';
    }
  }

  updateMyRequestCards();
  updateAdminRequestCards();
  if(el('requestsListTitle')&&hasFullAccess()&&!isLimitedUser()){
    el('requestsListTitle').textContent=isCoordinatorTeamWorkspaceV206()
      ?(state
        ?`Solicitudes del equipo · ${requestStateDisplayName(state)}`
        :'Solicitudes del equipo')
      :(state
        ?`Bandeja de solicitudes · ${requestStateDisplayName(state)}`
        :'Bandeja de solicitudes');
  }
  renderRequests();
}

let requestFilterStatusTimer=null;
let requestFilterStartedAt=0;

function setRequestFilterLoading(active,message='Actualizando solicitudes…'){
  const status=el('requestFilterStatus');
  const table=el('requestsTable');
  clearTimeout(requestFilterStatusTimer);

  if(active){
    requestFilterStartedAt=performance.now();
    if(status){
      status.classList.remove('hidden','ready');
      status.classList.add('loading');
      status.innerHTML=`<span class="request-filter-spinner" aria-hidden="true"></span>${esc(message)}`;
    }
    table?.classList.add('request-filter-loading');
    return;
  }

  table?.classList.remove('request-filter-loading');
  if(status){
    const elapsed=requestFilterStartedAt?Math.max(0,performance.now()-requestFilterStartedAt):0;
    status.classList.remove('loading','hidden');
    status.classList.add('ready');
    status.textContent=message||`Actualizado en ${(elapsed/1000).toFixed(1)} s`;
    requestFilterStatusTimer=setTimeout(()=>status.classList.add('hidden'),1400);
  }
}

async function applyRequestFilterChange(kind='state'){
  const state=el('requestStateFilter')?.value||'';

  // Cambiar de ETAPA puede resolverse desde la memoria de la última consulta.
  // Esto evita repetir llamadas a Supabase para PENDIENTE POR ATENDER,
  // ENTREGA PARCIAL, EN ESPERA DE DEVOLUCIÓN y TODOS.
  if(kind==='state'){
    setRequestFilterLoading(true,'Aplicando filtro…');
    if(showCachedRequestView(state)){
      setRequestFilterLoading(false,'Filtro aplicado');
      return;
    }
  }else{
    setRequestFilterLoading(true,'Consultando datos…');
  }

  try{
    await loadRequests();
    setRequestFilterLoading(false);
  }catch(error){
    console.error('Filtro de solicitudes:',error);
    setRequestFilterLoading(false,'No se pudo actualizar');
  }
}

function debounceRequests(){
  clearTimeout(requestsTimer);
  // V837: disminuir consultas de solicitudes durante la escritura sin cambiar su RPC.
  requestsTimer=setTimeout(()=>applyRequestFilterChange('search'),320);
}


function attentionStateClass(value){
  value=requestStateDisplayName(value);
  return value==='REGISTRADA'?'requested':
    value==='REGISTRADA POR ARCHIVO'?'accepted':
    value==='CARGO PENDIENTE DE ENTREGA'?'returning':
    value==='EN ESPERA DE DEVOLUCIÓN'?'wait-return':
    value==='ENTREGA PARCIAL'?'partial':
    value==='ENTREGA TOTAL'?'total':
    value==='PENDIENTE DE CIERRE'?'returning':
    value==='CERRADA POR ARCHIVO'?'received':
    ['CERRADA POR ADMINISTRADOR','CERRADO POR ADMINISTRADOR'].includes(value)?'received':'accepted';
}

function attentionStatePill(value){
  const v=value||'—';
  return `<span class="status-attn ${attentionStateClass(v)}">${esc(requestStateDisplayName(v))}</span>`;
}

function requestOverallDisplayState(request,items){
  const rows=Array.isArray(items)?items:[];

  const allClosedByAdmin=
    rows.length>0 &&
    rows.every(x=>
      [
        'CERRADO POR ADMINISTRADOR',
        'CERRADA POR ADMINISTRADOR'
      ].includes(norm(x.estado_item||''))
    );

  if(allClosedByAdmin){
    return 'CERRADO POR ADMINISTRADOR';
  }

  const header=norm(
    request?.estado_atencion||
    request?.estado||
    ''
  );

  if(
    [
      'CERRADO POR ADMINISTRADOR',
      'CERRADA POR ADMINISTRADOR'
    ].includes(header)
  ){
    return 'CERRADO POR ADMINISTRADOR';
  }

  const activeWaits=
    rows.filter(x=>!!x._cross_wait).length;

  const pendingItems=
    rows.filter(x=>
      ['ACEPTADO','PENDIENTE POR ATENDER']
        .includes(norm(x.estado_item||''))
      && !x._cross_wait
    ).length;

  if(
    rows.length>0 &&
    activeWaits===0 &&
    pendingItems>0 &&
    [
      'EN ESPERA DE DEVOLUCIÓN',
      'SOLICITADO',
      'ACEPTADO',
      'PENDIENTE POR ATENDER'
    ].includes(header)
  ){
    return 'PENDIENTE POR ATENDER';
  }

  return (
    request?.estado_atencion||
    request?.estado||
    ''
  );
}



function canEditRequestBeforeCargo(r){
  if(!hasFullAccess() || !r)return false;

  const cargo=String(r.cargo_numero||'').trim();
  const atendidos=Number(r.atendidos||0);
  const state=norm(r.estado_atencion||r.estado||'');

  if(cargo && cargo!=='—')return false;
  if(atendidos>0)return false;

  if([
    'CARGO PENDIENTE DE ENTREGA',
    'ENTREGA PARCIAL',
    'ENTREGA TOTAL',
    'PENDIENTE DE CIERRE',
    'CERRADA POR ARCHIVO',
    'CERRADA POR ADMINISTRADOR',
    'CERRADO POR ADMINISTRADOR'
  ].includes(state))return false;

  return true;
}

// V81: en Solicitudes se eliminan Fecha/Hora de ingreso a atención; se conserva Fecha préstamo.
// El cargo se muestra en una sola línea horizontal.
// V80: en Mis solicitudes la Fecha / hora solicitud pasa a la segunda columna,
// inmediatamente al costado de Solicitud.

// ============================================================
// V235 · Eliminación segura de solicitudes · solo ADMINISTRADOR
// ============================================================
let adminDeleteRequestTargetV235=null;

function canAdminDeleteRequestV235(r){
  if(!isAdmin() || !r)return false;

  const state=norm(r.estado_atencion||r.estado||'');
  const cargo=String(r.cargo_numero||'').trim();
  const atendidos=Number(r.atendidos||0);
  const porRecibir=Number(r.devoluciones_pendientes||0);

  if(cargo && cargo!=='—')return false;
  if(atendidos>0)return false;
  if(porRecibir>0)return false;

  return [
    'REGISTRADA',
    'REGISTRADA POR ARCHIVO',
    'SOLICITADO',
    'ACEPTADO',
    'PENDIENTE POR ATENDER'
  ].includes(state);
}

/* V678 · Compatibilidad legacy: esta función ya no se renderiza en la bandeja principal.
   La cancelación se ejecuta únicamente desde Gestionar solicitud. */
function adminDeleteRequestButtonV235(r){
  if(!canAdminDeleteRequestV235(r))return '';

  return `
    <button class="btn secondary small admin-delete-btn"
            type="button"
            title="Eliminar solicitud sin movimientos"
            onclick="event.stopPropagation();openAdminDeleteRequestV235('${r.id}')">
      Eliminar
    </button>`;
}

function currentRequestCanDeleteV235(){
  if(!isAdmin() || !currentRequest)return false;

  const headerOk=canAdminDeleteRequestV235({
    ...currentRequest,
    total_expedientes:requestDetailRows.length,
    atendidos:(requestDetailRows||[]).filter(x=>
      !['SOLICITADO','ACEPTADO','PENDIENTE POR ATENDER'].includes(norm(x.estado_item||''))
    ).length,
    cargo_numero:(requestDetailRows||[]).find(x=>String(x.cargo_numero||'').trim())?.cargo_numero||
      currentRequest.cargo_numero||
      ''
  });

  if(!headerOk)return false;

  return (requestDetailRows||[]).every(x=>
    ['SOLICITADO','ACEPTADO','PENDIENTE POR ATENDER']
      .includes(norm(x.estado_item||''))
    &&
    !String(x.cargo_numero||'').trim()
    &&
    !x.fecha_entrega
    &&
    !x.fecha_devolucion
    &&
    !x.fecha_solicitud_devolucion
  );
}

function adminDeleteReasonV235(){
  const type=String(el('adminDeleteReasonTypeV235')?.value||'').trim();
  const detail=String(el('adminDeleteReasonDetailV235')?.value||'').trim();

  if(!type)return '';
  if(type==='OTRO')return detail?`OTRO: ${detail}`:'';
  return detail?`${type}: ${detail}`:type;
}

function openAdminDeleteRequestV235(requestId){
  if(!isAdmin())return;

  const row=(requestRows||[]).find(x=>String(x.id)===String(requestId))
    ||(
      currentRequest && String(currentRequest.id||currentRequestId)===String(requestId)
        ?currentRequest
        :null
    );

  if(!row){
    showToast('No se pudo identificar la solicitud.');
    return;
  }

  if(!canAdminDeleteRequestV235(row) && !(
    currentRequest &&
    String(currentRequestId)===String(requestId) &&
    currentRequestCanDeleteV235()
  )){
    alert(
      'Esta solicitud ya tiene atención, cargo, devolución o movimientos asociados. '+
      'No puede eliminarse. Utilice el cierre administrativo para conservar la trazabilidad.'
    );
    return;
  }

  adminDeleteRequestTargetV235={
    id:requestId,
    numero:String(row.numero||'').trim(),
    solicitante:String(row.solicitante||'').trim(),
    asunto:String(row.asunto||'').trim(),
    estado:String(row.estado_atencion||row.estado||'').trim(),
    total:Number(row.total_expedientes||requestDetailRows?.length||0)
  };

  el('adminDeleteRequestSummaryV235').innerHTML=`
    <div><b>Solicitud:</b> ${esc(adminDeleteRequestTargetV235.numero||'—')}</div>
    <div><b>Solicitante:</b> ${esc(adminDeleteRequestTargetV235.solicitante||'—')}</div>
    <div><b>Expedientes:</b> ${adminDeleteRequestTargetV235.total}</div>
    <div><b>Estado:</b> ${esc(requestStateDisplayName(adminDeleteRequestTargetV235.estado||'—'))}</div>
    <div><b>Asunto:</b> ${esc(adminDeleteRequestTargetV235.asunto||'—')}</div>`;

  el('adminDeleteReasonTypeV235').value='';
  el('adminDeleteReasonDetailV235').value='';
  el('adminDeleteConfirmV235').value='';
  el('adminDeleteStatusV235').textContent='';
  el('adminDeleteSubmitV235').disabled=false;

  el('adminDeleteRequestModal').classList.add('show');

  setTimeout(()=>el('adminDeleteReasonTypeV235')?.focus(),50);
}

function closeAdminDeleteRequestV235(){
  el('adminDeleteRequestModal')?.classList.remove('show');
  adminDeleteRequestTargetV235=null;
  if(el('adminDeleteStatusV235'))el('adminDeleteStatusV235').textContent='';
}

async function submitAdminDeleteRequestV235(){
  if(!isAdmin() || !adminDeleteRequestTargetV235)return;

  const status=el('adminDeleteStatusV235');
  const btn=el('adminDeleteSubmitV235');
  const reason=adminDeleteReasonV235();
  const typed=String(el('adminDeleteConfirmV235')?.value||'').trim();
  const expected=String(adminDeleteRequestTargetV235.numero||'').trim();

  if(!reason){
    status.textContent=
      String(el('adminDeleteReasonTypeV235')?.value||'')==='OTRO'
        ?'Ingrese el detalle del motivo OTRO.'
        :'Seleccione el motivo de eliminación.';
    return;
  }

  if(!typed || norm(typed)!==norm(expected)){
    status.textContent=`Escriba exactamente el número de solicitud: ${expected}`;
    el('adminDeleteConfirmV235')?.focus();
    return;
  }

  if(!confirm(
    `¿Eliminar definitivamente la solicitud ${expected} de las bandejas operativas?\n\n`+
    'Supabase conservará una copia de auditoría. Esta acción no puede deshacerse desde el sistema.'
  )){
    return;
  }

  btn.disabled=true;
  status.textContent='Validando y eliminando solicitud...';

  const targetId=adminDeleteRequestTargetV235.id;

  try{
    const {data,error}=await sb.rpc(
      'eliminar_solicitud_admin_v235',
      {
        p_solicitud_id:targetId,
        p_motivo:reason
      }
    );

    if(error){
      status.textContent=error.message;
      return;
    }

    closeAdminDeleteRequestV235();

    if(String(currentRequestId||'')===String(targetId)){
      closeRequestDetail();
      currentRequestId='';
      currentRequest=null;
      requestDetailRows=[];
      requestMovementRows=[];
      requestSelectedIds.clear();
    }

    requestViewCache=null;
    showToast(
      `Solicitud ${data?.numero||expected} eliminada · auditoría conservada`
    );

    await Promise.all([
      loadSummary(),
      loadPanel(),
      loadAll(),
      loadStates(),
      loadRequests(),
      loadRequestsByLawyer(),
      loadCargos(),
      loadHistory()
    ]);

  }catch(err){
    status.textContent=err?.message||String(err);
  }finally{
    if(btn)btn.disabled=false;
  }
}

function v641RequestAgeDays(row){
  return v628HasPendingAttention(row,false)
    ?Number(v628RequestDaysWithoutAttention(row)||0)
    :null;
}

function v641VisibleRequestRows(rows){
  const minDays=Number(el('requestAgeFilter')?.value||0);
  const order=String(el('requestAgeOrder')?.value||'RECENT');
  const priority=String(el('requestPendingPriority')?.value||'');

  let visible=(Array.isArray(rows)?rows:[]).filter(row=>{
    const days=v641RequestAgeDays(row);

    // V643 · filtro específico para priorizar únicamente lo que todavía
    // permanece pendiente de atención.
    if(priority==='OLD_PENDING' && days===null)return false;

    if(!minDays)return true;
    return days!==null && days>=minDays;
  });

  visible=visible.slice().sort((a,b)=>{
    const da=v641RequestAgeDays(a);
    const db=v641RequestAgeDays(b);

    if(priority==='OLD_PENDING'){
      // Mayor cantidad de días hábiles primero. Si empatan, la solicitud
      // más antigua por fecha/hora queda arriba.
      if(da!==null && db!==null && da!==db)return db-da;
      const ta=new Date(a?.fecha_solicitud||a?.created_at||0).getTime()||0;
      const tb=new Date(b?.fecha_solicitud||b?.created_at||0).getTime()||0;
      return ta-tb;
    }

    // Las solicitudes sin pendiente siempre quedan después de las pendientes
    // cuando se ordena por antigüedad.
    if(da===null && db!==null)return 1;
    if(db===null && da!==null)return -1;

    if(da!==null && db!==null && da!==db){
      return order==='OLD' ? db-da : da-db;
    }

    const ta=new Date(a?.fecha_solicitud||a?.created_at||0).getTime()||0;
    const tb=new Date(b?.fecha_solicitud||b?.created_at||0).getTime()||0;
    return order==='OLD' ? ta-tb : tb-ta;
  });

  return visible;
}

function v644ToggleUnattendedOrder(){
  const select=el('requestAgeOrder');
  if(!select)return;

  const current=String(select.value||'RECENT');
  select.value=current==='OLD'?'RECENT':'OLD';

  // Si estaba activo el filtro especial de prioridad, al cambiar manualmente
  // el orden desde la cabecera se vuelve al modo de orden normal para que
  // el cambio sea visible e intuitivo.
  const priority=el('requestPendingPriority');
  if(priority && String(priority.value||'')==='OLD_PENDING' && select.value==='RECENT'){
    priority.value='';
  }

  renderRequests();
}

function v641UnattendedDaysCell(row){
  if(!v628HasPendingAttention(row,false))return '—';
  const days=v641RequestAgeDays(row);
  const level=days>=10?'critical':days>=5?'high':days>=2?'warn':'normal';
  const label=days===1?'1 día hábil':`${days} días hábiles`;
  return `<span class="v641-unattended-cell ${level}" title="Días hábiles transcurridos sin atención">${esc(label)}</span>`;
}


/* ============================================================
   V691 · UBICACIÓN VISIBLE EN "MIS SOLICITUDES"
   - Solo en espacios personales (Usuario / Coordinador / Staff personal)
   - Usa únicamente avisos del ciclo actual (solicitud_id exacto)
   - Una ubicación: muestra sede + observación
   - Varias ubicaciones: muestra VARIAS (n)
   - Clic abre el detalle completo sin modificar estado/custodia
   ============================================================ */
let v691RequestLocationMap=new Map();
let v691RequestLocationSeq=0;
let v691RequestLocationCacheKey='';

function v691RequestLocationEnabled(){
  // V699 · La comunicación de ubicación se muestra únicamente
  // en EXPEDIENTES PENDIENTES POR ATENDER.
  // Mis solicitudes conserva la trazabilidad en Historial, pero no una columna propia.
  return false;
}

function v691RequestLocationRows(requestId){
  return v691RequestLocationMap.get(String(requestId||''))||[];
}

function v691ShortLocationText(value,max=72){
  const text=String(value||'').replace(/\s+/g,' ').trim();
  if(!text)return '';
  return text.length>max?text.slice(0,max-1).trimEnd()+'…':text;
}

function v691RequestLocationSummaryHtml(requestId,totalExpedientes){
  const rows=v691RequestLocationRows(requestId);
  if(!rows.length)return '<span class="v691-location-empty">—</span>';

  const locations=[...new Set(rows.map(r=>String(r?.sede||'UBICACIÓN VERIFICADA').trim()).filter(Boolean))];
  const latest=rows.slice().sort((a,b)=>new Date(b?.created_at||0)-new Date(a?.created_at||0))[0]||rows[0];
  const title=locations.length===1?locations[0]:`VARIAS (${locations.length})`;
  const total=Math.max(0,Number(totalExpedientes||0));
  const communicated=rows.length;
  const sameObservation=[...new Set(rows.map(r=>String(r?.observacion||'').trim()).filter(Boolean))];
  const observation=sameObservation.length===1
    ?v691ShortLocationText(sameObservation[0])
    :(rows.length===1?v691ShortLocationText(latest?.observacion||''):`Ver observaciones de ${rows.length} expediente(s)`);
  const coverage=total>1?`${communicated} de ${total} comunicado${communicated===1?'':'s'}`:'Ubicación comunicada';

  return `<button type="button" class="v691-location-summary-btn" onclick="openRequestLocationDetailV691('${esc(String(requestId||''))}')" title="Ver ubicación y observación comunicada">
    <span class="v691-location-main">📍 ${esc(title)}</span>
    <span class="v691-location-coverage">${esc(coverage)}</span>
    ${observation?`<span class="v691-location-observation">${esc(observation)}</span>`:''}
    <span class="v691-location-date">${fmtDate(latest?.created_at)} ${fmtTime(latest?.created_at)}</span>
  </button>`;
}

function v691PaintRequestLocationCells(){
  document.querySelectorAll('#requestsTable [data-v691-request-location]').forEach(cell=>{
    const requestId=String(cell.dataset.v691RequestLocation||'');
    const total=Number(cell.dataset.v691Total||0);
    cell.innerHTML=v691RequestLocationSummaryHtml(requestId,total);
    cell.removeAttribute('aria-busy');
  });
}

async function loadRequestLocationSummariesV691(force=false){
  if(!v691RequestLocationEnabled()||!sb||!session)return;
  const cells=[...document.querySelectorAll('#requestsTable [data-v691-request-location]')];
  if(!cells.length)return;

  const uid=String(session.user.id||'');
  const requestIds=[...new Set(cells.map(c=>String(c.dataset.v691RequestLocation||'')).filter(Boolean))].sort();
  if(!requestIds.length)return;

  const cacheKey=uid+'|'+requestIds.join(',');
  if(!force&&v691RequestLocationCacheKey===cacheKey){
    v691PaintRequestLocationCells();
    return;
  }

  const seq=++v691RequestLocationSeq;
  const grouped=new Map();

  try{
    for(let i=0;i<requestIds.length;i+=100){
      for(let offset=0;;offset+=500){
        let query=sb.from('avisos_ubicacion_verificada')
          .select('id,solicitud_id,solicitud_numero,expediente_id,expediente,extension,sede,observacion,verificado_nombre,created_at,leida_at,destinatario_id')
          .in('solicitud_id',requestIds.slice(i,i+100));

        const limitByRecipient=typeof hasFullAccess==='function' && hasFullAccess()
          ? false
          : (typeof isLimitedUser==='function' && isLimitedUser());

        if(limitByRecipient){
          query=query.eq('destinatario_id',uid);
        }

        const {data,error}=await query
          .order('created_at',{ascending:false})
          .order('id')
          .range(offset,offset+499);

        if(seq!==v691RequestLocationSeq||String(session?.user?.id||'')!==uid)return;
        if(error)throw error;

        for(const notice of data||[]){
          const requestId=String(notice?.solicitud_id||'');
          const expedienteId=String(notice?.expediente_id||'');
          if(!requestId||!expedienteId)continue;
          if(!grouped.has(requestId))grouped.set(requestId,new Map());
          const byExp=grouped.get(requestId);
          // La consulta viene de más reciente a más antigua: conservar solo la
          // última comunicación del expediente dentro de este ciclo exacto.
          if(!byExp.has(expedienteId))byExp.set(expedienteId,notice);
        }

        if(!data||data.length<500)break;
      }
    }

    if(seq!==v691RequestLocationSeq||String(session?.user?.id||'')!==uid)return;

    const finalMap=new Map();
    for(const [requestId,byExp] of grouped.entries()){
      finalMap.set(requestId,[...byExp.values()].sort((a,b)=>new Date(b?.created_at||0)-new Date(a?.created_at||0)));
    }
    v691RequestLocationMap=finalMap;
    v691RequestLocationCacheKey=cacheKey;
    v691PaintRequestLocationCells();
  }catch(error){
    if(seq!==v691RequestLocationSeq||String(session?.user?.id||'')!==uid)return;
    document.querySelectorAll('#requestsTable [data-v691-request-location]').forEach(cell=>{
      cell.innerHTML='<span class="v691-location-empty">No disponible</span>';
      cell.title=typeof locationNoticeError==='function'?locationNoticeError(error):(error?.message||String(error));
      cell.removeAttribute('aria-busy');
    });
    console.warn('V691 ubicación en Mis solicitudes:',error);
  }
}
window.loadRequestLocationSummariesV691=loadRequestLocationSummariesV691;

function v691EnsureRequestLocationModal(){
  let modal=document.getElementById('v691RequestLocationModal');
  if(modal)return modal;
  modal=document.createElement('div');
  modal.className='modal';
  modal.id='v691RequestLocationModal';
  modal.setAttribute('role','dialog');
  modal.setAttribute('aria-modal','true');
  modal.setAttribute('aria-labelledby','v691RequestLocationTitle');
  modal.innerHTML=`<div class="modal-box v691-location-modal-box">
    <div class="modal-head">
      <div><h2 id="v691RequestLocationTitle">Ubicación comunicada</h2><div class="v691-location-modal-sub" id="v691RequestLocationSubtitle"></div></div>
      <button class="btn secondary" type="button" onclick="closeRequestLocationDetailV691()">Cerrar</button>
    </div>
    <div id="v691RequestLocationDetail"></div>
  </div>`;
  document.body.appendChild(modal);
  return modal;
}

async function openRequestLocationDetailV691(requestId){
  const id=String(requestId||'').trim();
  if(!id)return;

  if(!v691RequestLocationRows(id).length){
    v691RequestLocationCacheKey='';
    await loadRequestLocationSummariesV691(true);
  }

  const rows=v691RequestLocationRows(id);
  if(!rows.length){
    showToast('Esta solicitud no tiene comunicaciones de ubicación registradas.');
    return;
  }

  const modal=v691EnsureRequestLocationModal();
  const request=(requestRows||[]).find(r=>String(r?.id||'')===id)||{};
  const subtitle=document.getElementById('v691RequestLocationSubtitle');
  if(subtitle)subtitle.textContent=`Solicitud ${request.numero||rows[0]?.solicitud_numero||'—'} · ${rows.length} expediente(s) con ubicación comunicada`;

  const detail=document.getElementById('v691RequestLocationDetail');
  detail.innerHTML=rows.map(row=>{
    if(typeof locationNoticeCard==='function')return locationNoticeCard(row);
    return `<article class="v691-location-fallback-card">
      <b>📍 ${esc(row.sede||'UBICACIÓN VERIFICADA')}</b>
      <div><b>Expediente:</b> ${esc(row.expediente||'—')} ${esc(row.extension||'')}</div>
      <div>${esc(row.observacion||'Sin observación registrada.')}</div>
      <small>${fmtDate(row.created_at)} ${fmtTime(row.created_at)} · ${esc(row.verificado_nombre||'—')}</small>
    </article>`;
  }).join('');

  modal.classList.add('show');
}
window.openRequestLocationDetailV691=openRequestLocationDetailV691;

function closeRequestLocationDetailV691(){
  document.getElementById('v691RequestLocationModal')?.classList.remove('show');
}
window.closeRequestLocationDetailV691=closeRequestLocationDetailV691;

window.addEventListener('focus',()=>{
  if(v691RequestLocationEnabled()&&document.querySelector('#requestsTable [data-v691-request-location]')){
    v691RequestLocationCacheKey='';
    loadRequestLocationSummariesV691(true);
  }
},{passive:true});



// V738: detalle al final de la tabla, abierto en una ventana accesible,
// consulta siempre el estado vigente en el servidor, con control de permisos.
let v738DialogSequence=0;
let v738LastFocus=null;
function v738CloseRequestDialog(){
  ++v738DialogSequence;
  const modal=document.getElementById('v738-request-detail-modal');
  if(modal)modal.remove();
  if(v738LastFocus && v738LastFocus.isConnected)try{v738LastFocus.focus()}catch(_){}
  v738LastFocus=null;
}
function v738EscapeClose(ev){
  if(ev.key==='Escape' && document.getElementById('v738-request-detail-modal')){
    ev.preventDefault();v738CloseRequestDialog();
  }
}
if(!window.__v738EscapeInstalled){
  document.addEventListener('keydown',v738EscapeClose);
  window.__v738EscapeInstalled=true;
}
function v738StateStyle(raw){
  const k=String(raw||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toUpperCase();
  if(/DEVUELT|CUSTODIA|RECIBIDO EN ARCHIVO/.test(k))return 'returned';
  if(/REASIGNAD/.test(k))return 'reassigned';
  if(/DEVOLUCION SOLICITADA|SOLICITUD DE DEVOLUCION/.test(k))return 'return-requested';
  if(/EN PRESTAMO|PRESTAMO/.test(k))return 'loan';
  if(/PENDIENT|SOLICITAD|ACEPTADO|POR ATENDER/.test(k))return 'pending';
  if(/ENTREGA|ATENDID|COPIA DIGITAL/.test(k))return 'delivered';
  return 'neutral';
}
function v738StateName(raw){
  const s=String(raw||'').trim();
  const key=s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase();
  if(key==='CUSTODIA'||key==='DEVUELTO AL ARCHIVO'||key==='DEVUELTO')return 'En custodia del Archivo';
  if(key==='EN PRESTAMO')return 'En préstamo';
  if(key==='REASIGNADO')return 'Reasignado';
  if(key==='DEVOLUCION SOLICITADA')return 'Devolución solicitada';
  if(key==='PENDIENTE POR ATENDER')return 'Pendiente por atender';
  if(key==='SOLICITADO')return 'Solicitado';
  return s||'No determinado';
}
async function v738ShowRequestDetail(requestId,trigger){
  const id=String(requestId||'').trim();
  if(!id || !sb || !session?.user?.id)return;
  const request=(requestRows||[]).find(x=>String(x.id||'')===id);
  if(!request){showToast('No se encontró la solicitud seleccionada.');return;}
  v738CloseRequestDialog();
  v738LastFocus=trigger||document.activeElement;
  const safe=value=>esc(String(value??''));
  const dialog=document.createElement('div');
  dialog.className='v738-dialog-backdrop';
  dialog.id='v738-request-detail-modal';
  dialog.setAttribute('role','presentation');
  dialog.innerHTML=`<section class="v738-dialog" role="dialog" aria-modal="true" aria-labelledby="v738-dialog-heading">
    <header class="v738-dialog-header">
      <div><h3 id="v738-dialog-heading">Expedientes de ${safe(request.numero||'la solicitud')}</h3>
        <p>Relación de expedientes y estado vigente, consultados al abrir el detalle.</p></div>
      <button type="button" class="v738-dialog-close" data-v738-close aria-label="Cerrar detalle">✕</button>
    </header>
    <div class="v738-dialog-content" aria-live="polite"><p class="v738-dialog-loading">Consultando los estados actuales…</p></div>
    <footer class="v738-dialog-footer"><button type="button" data-v738-close>Cerrar</button></footer>
  </section>`;
  document.body.appendChild(dialog);
  dialog.addEventListener('click',event=>{
    if(event.target===dialog || event.target.closest('[data-v738-close]'))v738CloseRequestDialog();
  });
  dialog.querySelector('.v738-dialog-close')?.focus();
  const seq=++v738DialogSequence;
  const originalUid=String(session?.user?.id||'');
  const content=dialog.querySelector('.v738-dialog-content');
  try {
    const {data,error}=await sb.rpc('v738_mis_solicitudes_detalle',{p_solicitud_id:id});
    if(error)throw error;
    if(seq!==v738DialogSequence||!dialog.isConnected||originalUid!==String(session?.user?.id||''))return;
    const items=Array.isArray(data)?data:[];
    if(!items.length){
      content.innerHTML='<p class="v738-dialog-empty">Esta solicitud no tiene expedientes asociados.</p>';
      return;
    }
    const rows=items.map((item,index)=>{
      const name=safe(item.expediente||'Expediente sin número');
      const ext=String(item.extension||'').trim();
      const now=v738StateName(item.estado_actual);
      const original=v738StateName(item.estado_solicitud);
      const nowTag='<span class="v738-status v738-'+v738StateStyle(item.estado_actual)+'">'+safe(now)+'</span>';
      const beforeTag='<span class="v738-status v738-'+v738StateStyle(item.estado_solicitud)+'">'+safe(original)+'</span>';
      const note=item.otra_solicitud_vigente?'<small class="v738-other-cycle">El expediente registra otro ciclo vigente.</small>':'';
      return '<tr><td class="v738-seq">'+(index+1)+'</td><td><b>'+name+'</b>'+
        (ext?'<small>Ext.: '+safe(ext)+'</small>':'')+'</td>'+
        '<td>'+nowTag+note+'</td><td>'+beforeTag+'</td></tr>';
    }).join('');
    content.innerHTML='<p class="v738-items-count">'+items.length+' expediente'+(items.length===1?'':'s')+' en esta solicitud</p>'+
      '<div class="v738-table-scroll"><table class="v738-detail-table"><thead><tr><th>N.º</th><th>Expediente</th><th>Estado actual</th><th>En esta solicitud</th></tr></thead><tbody>'+rows+'</tbody></table></div>';
  } catch(error) {
    if(seq!==v738DialogSequence||!dialog.isConnected)return;
    content.innerHTML='<p class="v738-dialog-error">No se pudo consultar el detalle: '+safe(error?.message||error)+'</p>';
  }
}
window.v738ShowRequestDetail=v738ShowRequestDetail;

function renderRequests(){
  if(!el('requestsTable'))return;
  const showLocationColumnV691=v691RequestLocationEnabled();

  if(!requestRows.length){
    el('requestsTable').innerHTML='<div class="empty">No hay solicitudes para mostrar.</div>';
    return;
  }

  const visibleRequestRows=v641VisibleRequestRows(requestRows);

  if(el('requestsCount')){
    const total=requestRows.length;
    const visible=visibleRequestRows.length;
    el('requestsCount').textContent=visible===total
      ?`${total} solicitud${total===1?'':'es'}`
      :`${visible} de ${total} solicitudes`;
  }

  if(!visibleRequestRows.length){
    el('requestsTable').innerHTML='<div class="empty">No hay solicitudes que coincidan con el filtro de antigüedad.</div>';
    return;
  }

  // La bandeja de Solicitudes debe mostrar solo el SOLICITANTE.
  // La columna "Registrado por" se retira de la vista principal.
  el('requestsTable').innerHTML=`<table>
    <thead><tr>
      <th>Expedientes</th>
      <th>Solicitud</th>
      <th>Fecha / hora solicitud</th>
      <th class="v644-unattended-sort-head" aria-sort="${String(el('requestAgeOrder')?.value||'RECENT')==='OLD'?'descending':'ascending'}">
        <button type="button" class="v644-unattended-sort-btn" onclick="v644ToggleUnattendedOrder()" title="Ordenar por días hábiles sin atender">
          Días sin atender ${String(el('requestAgeOrder')?.value||'RECENT')==='OLD'?'↑':'↓'}
        </button>
        <div class="v644-unattended-sort-caption">
          ${String(el('requestAgeOrder')?.value||'RECENT')==='OLD'?'Más antiguas primero':'Más recientes primero'}
        </div>
      </th>
      <th>Solicitante</th>
      <th class="subject-cell-v639">Asunto</th>
      <th>Modalidad</th>
      <th>Estado</th>
      ${showLocationColumnV691?'<th class="v691-request-location-col">Ubicación</th>':''}
      <th>Atendidos</th>
