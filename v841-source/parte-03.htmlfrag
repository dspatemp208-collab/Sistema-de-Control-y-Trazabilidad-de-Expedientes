<style id="v528-state-route">
/* =========================================================
   V528 · RUTA DE ESTADOS
   Sustituye la apariencia de tarjetas por una banda continua
   de trazabilidad documental.
   ========================================================= */
#tab-states .state-grid,
body.produce-staff #tab-states .state-grid{
  position:relative!important;
  display:grid!important;
  grid-template-columns:repeat(5,minmax(150px,1fr))!important;
  gap:0!important;
  margin:12px 0 14px!important;
  padding:8px 10px!important;
  background:#eef4f8!important;
  border:1px solid #c9d7e4!important;
  border-radius:14px!important;
  box-shadow:0 2px 8px rgba(18,52,86,.05)!important;
  overflow:visible!important;
}
/* Línea de recorrido */
#tab-states .state-grid::before,
body.produce-staff #tab-states .state-grid::before{
  content:"";
  position:absolute;
  left:7%!important;
  right:7%!important;
  top:38px!important;
  height:2px!important;
  background:#c8d6e4!important;
  z-index:0!important;
}
#tab-states .state-card,
body.produce-staff #tab-states .state-card{
  position:relative!important;
  z-index:1!important;
  min-height:82px!important;
  padding:7px 12px 8px!important;
  margin:0!important;
  display:grid!important;
  grid-template-columns:50px minmax(0,1fr)!important;
  grid-template-rows:auto auto!important;
  grid-template-areas:"count title" "count meta"!important;
  align-items:center!important;
  column-gap:10px!important;
  row-gap:2px!important;
  background:transparent!important;
  border:0!important;
  border-radius:10px!important;
  box-shadow:none!important;
  outline:none!important;
  transform:none!important;
  overflow:visible!important;
  cursor:pointer!important;
  transition:background .12s ease,box-shadow .12s ease!important;
}
