}

async function showUserCard(tipo){
  if(!isLimitedUser())return;

  // Pulsar una tarjeta abre su listado completo, sin una búsqueda anterior.
  if(el('searchInput'))el('searchInput').value='';
  userPanelMode=tipo||'PRESTAMO';
  page=0;
  updateUserPersonalKpiUI();

  setFastPanelTransitionV244(userPanelLabel());

  try{
    await loadPanel({forceFresh:true});
  }finally{
    clearFastPanelTransitionV244();
  }

  el('panelTable')?.scrollIntoView({behavior:'auto',block:'start'});
}

function panelQuickLabel(){
  return panelQuickFilter==='all_records'?'Todos los expedientes':
    panelQuickFilter==='custody'?'Total en custodia':
    panelQuickFilter==='pending'
      ?(selectedOwnerIsUser()?'Solicitudes de devolución':'Solicitudes de devolución'):
    panelQuickFilter==='returns'?'Devueltos al Archivo':
    panelQuickFilter==='pending_attention'?'Pendientes por atender':
    panelQuickFilter==='loan'?'Préstamos':
    panelQuickFilter==='reassigned'?'Reasignados':
    panelQuickFilter==='alert'?'Alertas > 30 días':
    '';
}

function updateKpiQuickUI(){
  const map={
    all_records:null,
    total:'kpiTotalCard',
    custody:'kpiTotalCard',
    pending:'kpiPendingCard',
    returns:'kpiReturnedHistoryCard',
    loan:'kpiLoanCard',
    reassigned:'kpiReassignedCard',
    pending_attention:'kpiPendingAttentionCard',
    alert:'kpiAlertCard'
  };

  document.querySelectorAll('#fullAccessKpis .kpi').forEach(
    x=>x.classList.remove('quick-active')
