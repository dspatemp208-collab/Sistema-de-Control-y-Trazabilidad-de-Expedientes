  const labels={
    all_records:'todos los expedientes',
    custody:'expedientes en custodia',
    loan:'expedientes en préstamo',
    reassigned:'expedientes reasignados',
    pending_attention:'expedientes pendientes por atender',
    pending:'solicitudes de devolución',
    returns:'expedientes devueltos al Archivo',
    alert:'alertas > 30 días'
  };
  return labels[filter]||'expedientes';
}

function showOwnerPanelLoading(filter){
  if(!selectedOwnerIsUser())return;

  // V179: si la actividad ya fue consultada recientemente, no vaciar la tabla.
  // loadPanel() restaurará la vista en memoria inmediatamente.
  try{
    const cached=v179PanelViewCache?.get(v179PanelCacheKey());
    if(cached && (Date.now()-cached.savedAt)<V179_PANEL_CACHE_TTL)return;
  }catch(_){}

  const label=ownerPanelLoadingLabel(filter);

  if(el('panelTitle')){
    el('panelTitle').textContent=
      filter==='returns'
        ?`Expedientes de ${selectedOwner} · Devueltos al Archivo · Histórico`
        :`Expedientes de ${selectedOwner} · ${panelQuickLabel()||label}`;
  }

  if(el('pageInfo'))el('pageInfo').textContent='Cargando...';

  if(el('panelTable')){
    el('panelTable').innerHTML=
      `<div class="empty">Cargando ${esc(label)}...</div>`;
  }
}

async function changeOwnerStateFilter(value){
  page=0;
  selectedIds.clear();
  updateSelectionUI();

  if(typeof v629IsOtherUser==='function' && v629IsOtherUser()){
    const valid=['custody','loan','reassigned','pending_attention','pending','returns','alert'];
    panelQuickFilter=valid.includes(value)?value:'custody';
    if(el('ownerStateFilter'))el('ownerStateFilter').value=panelQuickFilter;
    await loadPanel({refreshCards:false,forceFresh:true});
    return;
  }

  if(isLimitedUser()){
    const valid=[
      'TODOS_EXPEDIENTES','TODOS','PRESTAMO','REASIGNADOS_A_MI',
      'PENDIENTES_POR_ATENDER','DEVOLUCION_SOLICITADA',
      'DEVUELTOS','REASIGNADOS_POR_MI','ALERTAS_30'
    ];
    userPanelMode=valid.includes(value)?value:'TODOS';
    updateUserPersonalKpiUI();
    await loadPanel({refreshCards:false,forceFresh:true});
    return;
  }

  if(!selectedOwnerIsUser())return;

  const valid=['all_records','custody','loan','reassigned','pending_attention','pending','returns','alert'];
  panelQuickFilter=valid.includes(value)?value:'custody';
  page=0;

  if(el('ownerStateFilter')){
    el('ownerStateFilter').value=panelQuickFilter;
  }

  showOwnerPanelLoading(panelQuickFilter);
  await loadPanel({refreshCards:false,forceFresh:true});
}
async function showKpiExpedientes(tipo){
  selectedIds.clear();
  updateSelectionUI();

  if(typeof v629IsOtherUser==='function' && v629IsOtherUser()){
    panelQuickFilter=tipo==='total'?'custody':tipo;
    if(el('ownerStateFilter'))el('ownerStateFilter').value=panelQuickFilter||'custody';
    page=0;
    updateKpiQuickUI();
    await loadPanel({refreshCards:false,forceFresh:true});
    el('panelTable')?.scrollIntoView({behavior:'auto',block:'start'});
    return;
  }

  if(selectedOwnerIsUser()){
    panelQuickFilter=tipo==='total'?'custody':tipo;
    if(el('ownerStateFilter')){
      el('ownerStateFilter').value=panelQuickFilter||'custody';
    }
  }else{
    panelQuickFilter=tipo==='total'?'':tipo;
  }

  page=0;
  updateKpiQuickUI();

  if(selectedOwnerIsUser()){
    showOwnerPanelLoading(panelQuickFilter);
  }

  await loadPanel({refreshCards:false,forceFresh:true});

  // Llevar visualmente a la relación de expedientes.
  el('panelTable')?.scrollIntoView({behavior:'auto',block:'start'});
}

async function clearPanelFilters(){
  panelQuickFilter='';
  page=0;

  if(el('searchInput'))el('searchInput').value='';
  if(el('ownerStateFilter'))el('ownerStateFilter').value='custody';

  if(isLimitedUser()){
    userPanelMode='TODOS';
    selectedOwner=currentProfile?.nombre_personal||'';
    panelQuickFilter='';
    if(el('ownerSelect'))el('ownerSelect').value=selectedOwner;
    if(el('selectedOwnerDisplay'))el('selectedOwnerDisplay').value=selectedOwner;
    if(typeof v629SyncOwnerMode==='function')v629SyncOwnerMode();
    applyRoleUI();
    updateOwnerPanelVisibility();
    updateUserPersonalKpiUI();
    await loadUserPersonalSummary();
    await loadPanel({forceFresh:true});
    return;
  }

  selectedOwner='';
  if(el('ownerSelect'))el('ownerSelect').value='';

  renderSidebar();
  updateOwnerPanelVisibility();
  renderKpis();
  updateKpiQuickUI();
  await loadPanel();
}


// ============================================================
// V179 · CAMBIO RÁPIDO ENTRE ACTIVIDADES
// Objetivos:
//   1. Ejecutar en paralelo los enriquecimientos independientes del panel.
//   2. Conservar temporalmente la última vista de cada tarjeta/actividad.
//   3. Al volver a una actividad ya consultada, mostrarla de inmediato y
//      actualizarla silenciosamente en segundo plano.
// Aplica a USUARIO, ARCHIVO y ADMINISTRADOR.
// ============================================================
const V179_PANEL_CACHE_TTL=900000;
const V179_PANEL_REVALIDATE_AFTER=10000;
const v179PanelViewCache=new Map();

// V353 · conservar la última vista del panel también en sessionStorage.
// Así, al actualizar la página o volver al sistema en la misma pestaña,
// Mis expedientes puede mostrarse antes de terminar la consulta a Supabase.
function v353PanelStorageKey(key){
  return 'v353_panel_snapshot_'+String(key||'');
}

function v353LoadStoredPanelSnapshot(key){
  if(!key)return null;
  try{
    const raw=sessionStorage.getItem(v353PanelStorageKey(key));
    if(!raw)return null;
    const snapshot=JSON.parse(raw);
    if(!snapshot?.savedAt)return null;
    if((Date.now()-Number(snapshot.savedAt))>V179_PANEL_CACHE_TTL){
      sessionStorage.removeItem(v353PanelStorageKey(key));
      return null;
    }
    return snapshot;
  }catch(_){
    return null;
  }
}

function v353SaveStoredPanelSnapshot(key,snapshot){
  if(!key||!snapshot)return;
  try{
    sessionStorage.setItem(v353PanelStorageKey(key),JSON.stringify(snapshot));
  }catch(_){
    // Si el navegador alcanza el límite de sessionStorage, mantener
    // únicamente la caché en memoria sin interrumpir el sistema.
  }
}

function v179PanelCacheKey(){
  const profileId=String(
    currentProfile?.id||
    currentProfile?.email||
    currentProfile?.nombre_personal||
    ''
  );
  const search=typeof window.v745GetScopedTerm==='function'
    ?window.v745GetScopedTerm():cleanSearch(el('searchInput')?.value||'');
  const limited=isLimitedUser();
  const globalSearch=limited && !!search && !window.V745_CARD_SEARCH_ONLY;
  const coordinatorScopeSearch=
    isCoordinatorSelfWorkspaceV206() && !!search && !window.V745_CARD_SEARCH_ONLY;

  return [
    profileId,
    coordinatorScopeSearch
      ?'COORDINATOR_SCOPE_SEARCH'
      :(limited?'USER':'STAFF'),
    String(selectedOwner||''),
    globalSearch?'GLOBAL_SEARCH':String(userPanelMode||''),
    globalSearch?'':String(panelQuickFilter||''),
    String(search||''),
    String(page||0)
  ].join('|');
}

function v179CloneRows(rows){
  return (Array.isArray(rows)?rows:[]).map(r=>({
    ...r,
    _acumulados:Array.isArray(r?._acumulados)
      ?r._acumulados.map(x=>({...x}))
      :r?._acumulados
  }));
}

function invalidatePanelViewCacheV179(){
  v179PanelViewCache.clear();
}

function v179SavePanelSnapshot(key){
  if(!key||!el('panelTable'))return;

  const html=el('panelTable').innerHTML||'';
  if(/Cargando .*?\.\.\.|Consultando .*?\.\.\./i.test(html))return;

  const snapshot={
    savedAt:Date.now(),
    html,
    title:el('panelTitle')?.textContent||'',
    pageInfo:el('pageInfo')?.textContent||'',
    count:Number(panelCount||0),
    rows:v179CloneRows(panelRows)
  };

  v179PanelViewCache.set(key,snapshot);
  v353SaveStoredPanelSnapshot(key,snapshot);
}

function v179RestorePanelSnapshot(snapshot){
  if(!snapshot||!el('panelTable'))return false;

  panelCount=Number(snapshot.count||0);
  panelRows=v179CloneRows(snapshot.rows);

  if(el('panelTitle'))el('panelTitle').textContent=snapshot.title||'';
  if(el('pageInfo'))el('pageInfo').textContent=snapshot.pageInfo||'';
  el('panelTable').innerHTML=snapshot.html||'<div class="empty">Sin datos.</div>';

  if(isLimitedUser())updateUserPersonalKpiUI();
  else updateKpiQuickUI();

  if(typeof syncPanelReturnBulkUI==='function')syncPanelReturnBulkUI();
  return true;
}


function renderStaffPanelFastV234(rows,owner,quickFilter){
  const list=Array.isArray(rows)?rows:[];

  if(quickFilter==='pending_attention'){
    return renderUserPendingAttentionRows(list,true);
  }

  if(quickFilter==='returns'){
    return renderOwnerHistoricalReturnsTable(list,owner);
  }

  return recordTable(list,false,'panel');
}

function updateStaffPanelHeaderV234(owner,quickFilter,count,from,to){
  const baseTitle=`Expedientes de ${owner}`;

  el('panelTitle').textContent=
    `${baseTitle} · ${panelQuickLabel()||'Total en custodia'}`;

  const first=count?from+1:0;
  const last=Math.min(to+1,count);

  el('pageInfo').textContent=
    `${first} - ${last} de ${count} registros`;
}

async function enrichPanelRowsFastV179(rows,options={}){
  const base=v179CloneRows(rows);
  if(!base.length)return base;

  // Todos estos enriquecimientos leen información complementaria y no
  // necesitan ejecutarse uno después del otro. Se ejecutan simultáneamente.
  const jobs=[
    enrichPanelRowsWithRequestCreatedAt(v179CloneRows(base)),
    enrichPanelRowsWithLatestStateTime(v179CloneRows(base)),
    enrichRowsWithExpedienteAsunto(v179CloneRows(base)),
    enrichAccumulatedRowsInPlace(v179CloneRows(base))
  ];

  if(options.canonical){
    jobs.push(
      applyV171CanonicalCustody(
        v179CloneRows(base),
        {overwriteResponsible:true,overwriteLocation:true}
      )
    );
  }

  // V723: asunto y cargo del ciclo físico vigente; prevalece sobre
  // respaldos históricos que pueden pertenecer a otra solicitud.
  if(typeof v723EnrichCargoMateria==='function'){
    jobs.push(v723EnrichCargoMateria(v179CloneRows(base)));
  }

  const results=await Promise.allSettled(jobs);
  let merged=v179CloneRows(base);

  results.forEach(result=>{
    if(result.status!=='fulfilled'||!Array.isArray(result.value))return;
    result.value.forEach((row,index)=>{
      if(!merged[index])merged[index]={};
      merged[index]={...merged[index],...row};
    });
  });

  return merged;
}

function v712ExpectedPanelCount(){
  try{
    const search=cleanSearch(el('searchInput')?.value||'');
    if(search)return null;

    // Perfil personal: USUARIO / COORDINADOR / ARCHIVO en modo personal.
    if(isLimitedUser()){
      const map={
        TODOS:'todos',
        PRESTAMO:'en_prestamo',
        PENDIENTES_POR_ATENDER:'pendientes_por_atender',
        DEVOLUCION_SOLICITADA:'devolucion_solicitada',
        REASIGNADOS_POR_MI:'reasignados_por_mi',
        REASIGNADOS_A_MI:'reasignados_a_mi',
        DEVUELTOS:'devueltos',
        ALERTAS_30:'alertas_30',
        SOLICITUDES_REASIGNACION:'solicitudes_reasignacion',
        REASIGNACIONES_SOLICITADAS_POR_MI:'reasignaciones_solicitadas_por_mi'
      };
      const key=map[String(userPanelMode||'').toUpperCase()];
      if(!key)return null;
      const value=Number(userPanelSummary?.[key]);
      return Number.isFinite(value)?value:null;
    }

    // Administrador / Archivo viendo un usuario específico.
    if(selectedOwnerIsUser()){
      const owner=(ownerCardsRows||[]).find(
        x=>norm(x?.nombre||'')===norm(selectedOwner||'')
      );
      if(!owner)return null;

      const filter=String(panelQuickFilter||'custody').toLowerCase();
      const keyMap={
        custody:'total_custodia',
        loan:'en_prestamo',
        reassigned:'reasignados',
        pending_attention:'pendientes_por_atender',
        pending:'devoluciones_pendientes_aceptacion',
        returns:'devoluciones_realizadas',
        alert:'alertas_30'
      };
      const key=keyMap[filter];
      if(!key)return null;

      const value=Number(owner?.[key]);
      return Number.isFinite(value)?value:null;
    }
  }catch(_){}
  return null;
}

function v712DiscardPanelSnapshot(key){
  try{v179PanelViewCache?.delete?.(key);}catch(_){}
  try{sessionStorage.removeItem(v353PanelStorageKey(key));}catch(_){}
}

function v712SnapshotMatchesCurrentCard(snapshot){
  if(!snapshot)return false;
  const expected=v712ExpectedPanelCount();
  if(expected===null)return true;
  return Number(snapshot.count||0)===Number(expected);
}

async function loadPanel(options={}){
  // V780 · En la portada TEAM, las tarjetas se reconstruyen desde V211.
  // No restaurar una captura previa del detalle de Johnny u otro usuario.
  if(isCoordinatorTeamWorkspaceV206() &&
     (!selectedOwner || norm(selectedOwner)===norm(currentProfile?.nombre_personal||''))){
    if(selectedOwner)selectedOwner='';
    await loadPanelCoreV179({...options,forceFresh:true});
    return;
  }
  const key=v179PanelCacheKey();
  let snapshot=v179PanelViewCache.get(key);

  // V712 · una tarjeta actualizada nunca debe abrir un detalle antiguo.
  if(snapshot && !v712SnapshotMatchesCurrentCard(snapshot)){
    v712DiscardPanelSnapshot(key);
    snapshot=null;
  }

  // V353 · si esta pestaña ya consultó antes esta misma vista,
  // restaurarla desde sessionStorage antes de esperar a Supabase.
  if(!snapshot && options.forceFresh!==true){
    snapshot=v353LoadStoredPanelSnapshot(key);

    if(snapshot && !v712SnapshotMatchesCurrentCard(snapshot)){
      v712DiscardPanelSnapshot(key);
      snapshot=null;
    }

    if(snapshot)v179PanelViewCache.set(key,snapshot);
  }

  const age=snapshot?Date.now()-snapshot.savedAt:Infinity;

  // Mostrar instantáneamente una vista ya consultada.
  if(
    options.forceFresh!==true &&
    snapshot &&
    age<V179_PANEL_CACHE_TTL
  ){
    v179RestorePanelSnapshot(snapshot);

    // Si aún es muy reciente, no hacemos ninguna consulta adicional.
    if(age<V179_PANEL_REVALIDATE_AFTER)return;

    // Si tiene algunos segundos, se muestra primero y se actualiza sin bloquear.
    loadPanelCoreV179({...options,refreshCards:false,__background:true})
      .then(()=>v179SavePanelSnapshot(v179PanelCacheKey()))
      .catch(error=>console.warn('Actualización silenciosa del panel:',error));
    return;
  }

  await loadPanelCoreV179(options);
  v179SavePanelSnapshot(v179PanelCacheKey());
}


// ============================================================
// V183 · DATOS OPERATIVOS ADICIONALES DEL PERFIL USUARIO
// ============================================================

async function enrichUserLoansForCompactViewV183(rows){
  const list=Array.isArray(rows)?rows:[];
  if(!list.length||!sb||!session)return list;

  const expIds=[...new Set(
    list.map(r=>String(r.expediente_id||r.id||'').trim()).filter(Boolean)
  )];

  if(!expIds.length)return list;

  let links=[];
  try{
    const {data,error}=await sb
      .from('solicitud_expedientes')
      .select('solicitud_id,expediente_id,estado,cargo_numero,fecha_entrega,updated_at')
      .in('expediente_id',expIds)
      .order('updated_at',{ascending:false});

    if(error){
      console.warn('V183 · vínculos de préstamos:',error.message);
    }else{
      links=data||[];
    }
  }catch(error){
    console.warn('V183 · vínculos de préstamos:',error?.message||error);
  }

  const selectedLinkByExp=new Map();

  list.forEach(r=>{
    const expId=String(r.expediente_id||r.id||'');
    const requestId=String(r.solicitud_id||r.solicitud_pendiente_id||'');
    const candidates=links.filter(x=>String(x.expediente_id||'')===expId);

    let chosen=requestId
      ?candidates.find(x=>String(x.solicitud_id||'')===requestId)
      :null;

    if(!chosen){
      chosen=candidates.find(x=>
        ['EN PRÉSTAMO','DEVOLUCIÓN SOLICITADA']
          .includes(norm(x.estado||''))
      )||candidates[0]||null;
    }

    if(chosen)selectedLinkByExp.set(expId,chosen);
  });

  const cargoNumbers=[...new Set(
    list.map(r=>{
      const expId=String(r.expediente_id||r.id||'');
      const link=selectedLinkByExp.get(expId)||{};
      return String(
        link.cargo_numero||
        r.cargo_numero||
        r.cargo||
        ''
      ).trim();
    }).filter(Boolean)
  )];

  const cargoMap=new Map();

  if(cargoNumbers.length){
    try{
      const {data,error}=await sb
        .from('cargos')
        .select('numero,atiende_requerimiento')
        .in('numero',cargoNumbers);

      if(error){
        console.warn('V183 · personal que atendió:',error.message);
      }else{
        (data||[]).forEach(c=>{
          const n=String(c.numero||'').trim();
          if(n)cargoMap.set(n,c);
        });
      }
    }catch(error){
      console.warn('V183 · personal que atendió:',error?.message||error);
    }
  }

  return list.map(r=>{
    const expId=String(r.expediente_id||r.id||'');
    const link=selectedLinkByExp.get(expId)||{};

    const cargo=String(
      link.cargo_numero||
      r.cargo_numero||
      r.cargo||
      ''
    ).trim();

    const cargoRow=cargoMap.get(cargo)||{};

    const archiveStaff=String(
      cargoRow.atiende_requerimiento||
      r.atiende_requerimiento||
      r.atiende||
      r.aceptado_por||
      ''
    ).trim();

    return {
      ...r,
      _v183_cargo:cargo||'—',
      _v183_archive_staff:archiveStaff||'—'
    };
  });
}


async function enrichUserReassignedByMeV183(rows){
  const list=Array.isArray(rows)?rows:[];
  if(!list.length||!sb||!session)return list;

  // V544 · "Reasignados por mí" debe mostrar siempre el destinatario real.
  // Se toleran diferencias de tildes, campos incompletos de la RPC y filas
  // donde el UUID del expediente no venga directamente en expediente_id.
  const normalizePersonV544=value=>String(value??'')
    .trim()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g,'')
    .toUpperCase();

  const me=normalizePersonV544(currentProfile?.nombre_personal||'');
  const uuidRx=/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

  const rowExpId=new Map();
  const directIds=[];
  const unresolved=[];

  list.forEach((r,index)=>{
    const candidate=String(r?.expediente_id||r?.id||'').trim();
    if(uuidRx.test(candidate)){
      rowExpId.set(index,candidate);
      directIds.push(candidate);
    }else{
      unresolved.push({index,row:r});
    }
  });

  // Si una tarjeta no trae UUID, resolverlo por número + extensión.
  if(unresolved.length){
    const numbers=[...new Set(unresolved.map(x=>String(x.row?.expediente||'').trim()).filter(Boolean))];
    if(numbers.length){
      try{
        const {data,error}=await sb
          .from('expedientes')
          .select('id,expediente,extension')
          .in('expediente',numbers);
        if(error){
          console.warn('V544 · resolución de expediente para reasignación:',error.message);
        }else{
          const master=Array.isArray(data)?data:[];
          unresolved.forEach(({index,row})=>{
            const exp=String(row?.expediente||'').trim();
            const ext=normalizePersonV544(row?.extension||row?.ext||'');
            let match=master.find(x=>
              String(x?.expediente||'').trim()===exp &&
              (!ext || normalizePersonV544(x?.extension||'')===ext)
            );
            if(!match)match=master.find(x=>String(x?.expediente||'').trim()===exp);
            if(match?.id){
              const id=String(match.id);
              rowExpId.set(index,id);
              directIds.push(id);
            }
          });
        }
      }catch(error){
        console.warn('V544 · resolución de expediente para reasignación:',error?.message||error);
      }
    }
  }

  const expIds=[...new Set(directIds.filter(Boolean))];
  let moves=[];

  if(expIds.length){
    try{
      const {data,error}=await sb
        .from('movimientos_prestamo')
        .select('expediente_id,solicitud_id,accion,desde,hacia,created_at')
        .in('expediente_id',expIds)
        .order('created_at',{ascending:false});

      if(error){
        console.warn('V544 · destino de reasignaciones:',error.message);
      }else{
        moves=Array.isArray(data)?data:[];
      }
    }catch(error){
      console.warn('V544 · destino de reasignaciones:',error?.message||error);
    }
  }

  return list.map((r,index)=>{
    const expId=String(rowExpId.get(index)||r?.expediente_id||'').trim();
    const requestId=String(r?.solicitud_id||r?.solicitud_pendiente_id||'').trim();

    const expMoves=moves.filter(m=>
      String(m?.expediente_id||'')===expId &&
      normalizePersonV544(m?.accion||'').includes('REASIGN') &&
      !normalizePersonV544(m?.accion||'').includes('SOLICITUD')
    );

    // Prioridad 1: movimiento generado DESDE el usuario actual.
    let candidates=expMoves.filter(m=>
      !me || normalizePersonV544(m?.desde||'')===me
    );

    // Si la base histórica tiene el nombre "desde" incompleto, no perder
    // el destinatario: usar la reasignación real más reciente del expediente.
    if(!candidates.length)candidates=expMoves.filter(m=>String(m?.hacia||'').trim());

    let chosen=requestId
      ?candidates.find(m=>String(m?.solicitud_id||'')===requestId)
      :null;
    if(!chosen)chosen=candidates[0]||null;

    let destination=String(
      chosen?.hacia||
      r?._v183_reassigned_to||
      r?.reasignado_hacia||
      r?.ultimo_movimiento_hacia||
      r?.hacia||
      r?.destinatario||
      r?.destinatario_nombre||
      ''
    ).trim();

    // Último respaldo: responsable actual, siempre que no sea el propio usuario.
    if(!destination){
      let current='';
      try{current=String(typeof currentResponsibleDisplay==='function'?currentResponsibleDisplay(r):'').trim();}catch(_){ }
      if(!current)current=String(r?.responsable_actual||r?.responsable||'').trim();
      if(current && (!me || normalizePersonV544(current)!==me))destination=current;
    }

    return {
      ...r,
      _v183_reassigned_to:destination||'—',
      _v544_reassigned_at:chosen?.created_at||r?._v544_reassigned_at||null
    };
  });
}



// ============================================================
// V184 · BUSCADOR GLOBAL DE "MIS EXPEDIENTES"
// Si hay texto en Buscar expediente, no importa qué tarjeta estaba activa:
// se consultan todas las actividades simultáneamente.
// ============================================================
const V184_USER_GLOBAL_SEARCH_TTL=45000;
const v184UserGlobalSearchCache=new Map();

function invalidateUserGlobalSearchV184(){
  v184UserGlobalSearchCache.clear();
}

function userGlobalSearchCacheKeyV184(search){
  return [
    String(session?.user?.id||''),
    norm(search||'')
  ].join('|');
}

function userActivityLabelV184(type){
  const map={
    PRESTAMO:'PRÉSTAMOS',
    PENDIENTES_POR_ATENDER:'PENDIENTES POR ATENDER',
    DEVOLUCION_SOLICITADA:'DEVOLUCIÓN SOLICITADA',
    SOLICITUDES_REASIGNACION:'REASIGNACIÓN QUE ME SOLICITAN',
    REASIGNACIONES_SOLICITADAS_POR_MI:'REASIGNACIÓN SOLICITADA POR MÍ',
    REASIGNADOS_POR_MI:'REASIGNADOS POR MÍ',
    REASIGNADOS_A_MI:'REASIGNADOS A MÍ',
    DEVUELTOS:'DEVUELTOS AL ARCHIVO',
    ALERTAS_30:'ALERTAS > 30 DÍAS'
  };
  return map[type]||type||'—';
}

function userActivityClassV184(type){
  const map={
    PRESTAMO:'loan',
    PENDIENTES_POR_ATENDER:'pending',
    DEVOLUCION_SOLICITADA:'return',
    SOLICITUDES_REASIGNACION:'reassigned',
    REASIGNACIONES_SOLICITADAS_POR_MI:'reassigned',
    REASIGNADOS_POR_MI:'reassigned',
    REASIGNADOS_A_MI:'reassigned',
    DEVUELTOS:'returned',
    ALERTAS_30:'alert'
  };
  return map[type]||'neutral';
}



// ============================================================
// V230 · BUSCADOR POR PERFIL
//
// ADMINISTRADOR : toda la base
// COORDINADOR   : propios + equipo (V229)
// USUARIO       : todos sus propios expedientes (V184)
// ============================================================


function isPureArchiveV231(){
  return !!(
    currentProfile &&
    currentProfile.activo!==false &&
    norm(currentProfile.rol||'')==='ARCHIVO'
  );
}

function canUseGlobalSearchV231(){
  if(typeof isStaffPersonalWorkspaceV319==='function' && isStaffPersonalWorkspaceV319()){
    return false;
  }
  return isAdmin() || isPureArchiveV231();
}

async function runPersonalScopeSearchV230(){
  page=0;

  const search=cleanSearch(el('searchInput')?.value||'');

  // V395: USUARIO normal con una búsqueda exacta no necesita invalidar
  // todos los caches ni reconstruir todo el panel antes de consultar.
  if(
    search &&
    isLimitedUser() &&
    !isCoordinatorSelfWorkspaceV206() &&
    !isStaffPersonalWorkspaceV319()
  ){
    if(typeof window.v395FastUserSearch==='function'){
      const key=(typeof window.v395LogicalKey==='function')
        ?window.v395LogicalKey(search)
        :search;

      return window.v395FastUserSearch(
        search,
        key,
        Date.now()
      );
    }
  }

  invalidatePanelViewCacheV179();

  if(typeof invalidateUserGlobalSearchV184==='function'){
    invalidateUserGlobalSearchV184();
  }

  if(typeof clearCoordinatorScopeSearchCacheV229==='function'){
    clearCoordinatorScopeSearchCacheV229();
  }

  await loadPanel({
    forceFresh:true,
    refreshCards:false
  });
}

async function clearPersonalScopeSearchV230(){
  if(el('searchInput'))el('searchInput').value='';

  page=0;
  panelQuickFilter='';
  userPanelMode='TODOS';

  invalidatePanelViewCacheV179();

  if(typeof invalidateUserGlobalSearchV184==='function'){
    invalidateUserGlobalSearchV184();
  }

  await loadPanel({
    forceFresh:true,
    refreshCards:false
  });
}

function syncSearchLabelsV230(){
  const label=el('searchInputLabelV229');
  const input=el('searchInput');

  if(label&&input){
    if(isCoordinatorSelfWorkspaceV206()){
      label.textContent='Buscar por N.° de expediente';
      input.placeholder=
        'Ej.: 0105-2026';
    }else if(
      currentProfile &&
      norm(currentProfile.rol||'')==='USUARIO'
    ){
      label.textContent='Buscar por N.° de expediente';
      input.placeholder=
        'Ej.: 0105-2026';
    }else if(selectedOwnerIsUser()){
      label.textContent='Buscar por N.° de expediente';
      input.placeholder=
        'Ej.: 0105-2026';
    }else{
      label.textContent='Buscar por N.° de expediente';
      input.placeholder=
        'Ej.: 0105-2026';
    }
  }

  const adminPanel=el('adminGlobalSearchPanelV230');

  if(adminPanel){
    const show=canUseGlobalSearchV231();
    adminPanel.classList.toggle('hidden-by-role',!show);
    adminPanel.classList.toggle('hidden',!show);

    const title=adminPanel.querySelector('.v230-admin-search-head strong');
    const note=adminPanel.querySelector('.v230-admin-search-head .note');
    const pill=adminPanel.querySelector('.v230-scope-pill');

    if(show){
      if(title)title.textContent='Buscar en todos los expedientes';

      if(note){
        note.textContent=isPureArchiveV231()
          ?'Busca únicamente por número de expediente. Formato: 0105-2026.'
          :'Busca únicamente por número de expediente. Formato: 0105-2026.';
      }

      if(pill){
        pill.textContent=isPureArchiveV231()
          ?'ARCHIVO · TODA LA BASE'
          :'ADMINISTRADOR · TODA LA BASE';
      }
    }
  }
}



const V246_ARCHIVE_LIST_CACHE_TTL=60000;
const v246ArchiveListSearchCache=new Map();

function v246ArchiveListKey(r){
  return `${norm(r?.expediente||'')}::${norm(r?.extension||'')}`;
}

function v246ArchiveLocation(r){
  return String(
    r?._v246_ubicacion_archivo||
    r?.ubicacion_archivo_v246||
    ''
  ).trim();
}

function v246ArchiveListNumber(r){
  return String(
    r?._v246_listado_numero||
    r?.listado_numero||
    ''
  ).trim();
}

function v246ArchiveListState(r){
  return String(
    r?._v246_listado_estado||
    r?.listado_estado||
    ''
  ).trim();
}

function v246ArchiveListSentAt(r){
  return (
    r?._v246_enviado_at||
    r?.fecha_envio_san_luis_v246||
    r?.enviado_at||
    null
  );
}

function v246ArchiveListHtml(r){
  const numero=v246ArchiveListNumber(r);
  if(!numero)return '<span style="color:var(--muted)">—</span>';

  const estado=v246ArchiveListState(r)||'—';
  const rawDestination=String(
    r?._v246_destino_archivo||
    r?.destino_archivo||
    ''
  ).trim();
  const destination=rawDestination||(
    norm(numero).startsWith('SL-')
      ?'SAN LUIS'
      :norm(numero).startsWith('BA-')
        ?'BARRENECHEA'
        :'—'
  );
  const displayState=norm(estado)==='ENVIADO A SAN LUIS'
    ?'ENVIADO'
    :estado;

  return `<div class="v246-list-box">
    <span class="v246-list-number">${esc(numero)}</span>
    <span class="v246-list-state"><b>Destino:</b> ${esc(destination)} · ${esc(displayState)}</span>
  </div>`;
}

function v246ArchiveLocationHtml(r){
  const numero=v246ArchiveListNumber(r);
  if(!numero)return '<span style="color:var(--muted)">—</span>';

  const location=v246ArchiveLocation(r)||'BARRENECHEA';
  const sentAt=v246ArchiveListSentAt(r);
  const destination=norm(
    r?._v246_destino_archivo||
    r?.destino_archivo||
    (
      norm(numero).startsWith('SL-')
        ?'SAN LUIS'
        :norm(numero).startsWith('BA-')
          ?'BARRENECHEA'
          :''
    )
  );
  const state=norm(v246ArchiveListState(r));

  const sent=location==='SAN LUIS';

  const note=sent
    ?(
        sentAt
          ?`Enviado: ${fmtDate(sentAt)}${fmtTime(sentAt)!=='—'?` ${fmtTime(sentAt)}`:''}`
          :'Traslado confirmado'
      )
    :(
        destination==='SAN LUIS' && state!=='ENVIADO A SAN LUIS'
          ?'Pendiente de traslado'
          :'En custodia de Archivo'
      );

  return `<div class="v246-archive-location">
    <span class="v246-location-badge ${sent?'san-luis':'barrenechea'}">
      ${esc(location)}
    </span>
    <span class="v246-location-note ${sent?'sent':(destination==='SAN LUIS'?'pending':'')}">
      ${esc(note)}
    </span>
  </div>`;
}

async function enrichArchiveListSearchV246(rows){
  const list=Array.isArray(rows)?rows:[];

  const expedientes=[
    ...new Set(
      list
        .map(r=>String(r?.expediente||'').trim())
        .filter(Boolean)
    )
  ];

  if(!expedientes.length || !sb || !session)return list;

  const cacheKey=[
    String(session?.user?.id||''),
    ...expedientes.slice().sort()
  ].join('|');

  const cached=v246ArchiveListSearchCache.get(cacheKey);

  if(
    cached &&
    Date.now()-cached.savedAt<V246_ARCHIVE_LIST_CACHE_TTL
  ){
    const map=cached.map;

    return list.map(r=>{
      const info=map.get(v246ArchiveListKey(r));
      return info?{...r,...info}:r;
    });
  }

  try{
    const {data,error}=await sb.rpc(
      'v246_info_listado_busqueda',
      {p_expedientes:expedientes}
    );

    if(error)throw error;

    const infoRows=v211JsonRows(data);
    const map=new Map();

    infoRows.forEach(x=>{
      const key=v246ArchiveListKey(x);

      if(!key)return;

      map.set(key,{
        _v246_listado_numero:String(x.listado_numero||'').trim(),
        _v246_listado_estado:String(x.listado_estado||'').trim(),
        _v246_destino_archivo:String(x.destino_archivo||'').trim(),
        _v246_ubicacion_archivo:String(x.ubicacion_archivo_v246||'').trim(),
        _v246_enviado_at:x.fecha_envio_san_luis_v246||x.enviado_at||null
      });
    });

    v246ArchiveListSearchCache.set(
      cacheKey,
      {savedAt:Date.now(),map}
    );

    return list.map(r=>{
      const info=map.get(v246ArchiveListKey(r));
      return info?{...r,...info}:r;
    });

  }catch(error){
    console.warn(
      'V246 · información de listado en búsqueda:',
      error?.message||error
    );
    return list;
  }
}

const V230_ADMIN_SEARCH_TTL=30000; // V231: compartido por ADMINISTRADOR y ARCHIVO
const v230AdminSearchCache=new Map();

function v230AdminSearchKey(q){
  return [
    String(session?.user?.id||''),
    norm(q||'')
  ].join('|');
}

async function fetchAdminGlobalSearchV230(search){
  const q=cleanSearch(search||'');

  if(!q)return [];

  if(q.length<2){
    throw new Error('Ingrese al menos 2 caracteres para realizar la búsqueda.');
  }

  const key=v230AdminSearchKey(q);
  const cached=v230AdminSearchCache.get(key);

  if(
    cached &&
    Date.now()-cached.savedAt<V230_ADMIN_SEARCH_TTL
  ){
    return v179CloneRows(cached.rows);
  }

  const {data,error}=await sb.rpc(
    'v231_buscar_expedientes_global',
    {p_busqueda:q}
  );

  if(error)throw error;

  let rows=v211JsonRows(data);

  // V246 · si el expediente fue devuelto y ya está en un listado,
  // agregar listado + ubicación física actual.
  rows=await enrichArchiveListSearchV246(rows);

  v230AdminSearchCache.set(
    key,
    {
      savedAt:Date.now(),
      rows:v179CloneRows(rows)
    }
  );

  return rows;
}


function adminSearchAreaV230(r){
  const responsible=String(
    coordinatorValueV225(
      r,
      'responsable_actual',
      'responsable'
    )||''
  ).trim();

  if(!responsible)return '—';

  const person=catalogPersonByName(responsible);

  return String(
    person?.area_trabajo||
    person?.area||
    '—'
  ).trim()||'—';
}


