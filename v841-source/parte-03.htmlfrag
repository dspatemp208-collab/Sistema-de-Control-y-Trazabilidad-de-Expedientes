}
#tab-states .state-card:hover,
body.produce-staff #tab-states .state-card:hover{
  background:rgba(255,255,255,.50)!important;
  box-shadow:none!important;
  transform:none!important;
}
#tab-states .state-card.selected,
body.produce-staff #tab-states .state-card.selected{
  background:#f8fbfe!important;
  box-shadow:inset 0 -4px 0 #245f98!important;
