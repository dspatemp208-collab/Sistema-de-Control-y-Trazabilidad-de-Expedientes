  padding:0!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  border-radius:50%!important;
  border:3px solid #6e94b9!important;
  background:#f8fbfd!important;
  color:#123b66!important;
  font-size:20px!important;
  line-height:1!important;
  font-weight:900!important;
  box-shadow:0 0 0 5px #eef4f8!important;
  text-align:center!important;
  white-space:nowrap!important;
}
#tab-states .state-card .state-name,
body.produce-staff #tab-states .state-card .state-name{
  grid-area:title!important;
  min-height:0!important;
  margin:0!important;
  padding:0!important;
  font-size:12px!important;
  line-height:1.15!important;
  font-weight:850!important;
  text-transform:none!important;
  letter-spacing:0!important;
  color:#173b63!important;
  white-space:normal!important;
}
#tab-states .state-card .state-meta,
body.produce-staff #tab-states .state-card .state-meta{
  display:block!important;
  grid-area:meta!important;
  margin:0!important;
  padding:0!important;
  font-size:9.5px!important;
  line-height:1.25!important;
  color:#6a7d91!important;
  white-space:normal!important;
}
#tab-states .state-card .state-progress,
#tab-states .state-card .state-card-actions,
body.produce-staff #tab-states .state-card .state-progress,
body.produce-staff #tab-states .state-card .state-card-actions{
