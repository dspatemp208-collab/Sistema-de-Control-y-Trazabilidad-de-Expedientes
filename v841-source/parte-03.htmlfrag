    TODOS_EXPEDIENTES:'Todos los expedientes',
    TODOS:'Total en custodia',
    PRESTAMO:'Préstamos',
    PENDIENTES_POR_ATENDER:'Pendientes por atender',
    DEVOLUCION_SOLICITADA:'Devolución solicitada',
    SOLICITUDES_REASIGNACION:'Reasignaciones que me solicitan',
    REASIGNACIONES_SOLICITADAS_POR_MI:'Reasignaciones solicitadas por mí',
    REASIGNADOS_POR_MI:'Reasignados por mí',
    REASIGNADOS_A_MI:'Reasignados a mí',
    DEVUELTOS:'Devueltos al Archivo',
    ALERTAS_30:'Alertas > 30 días sin movimiento'
  };
  return labels[userPanelMode]||'Mis expedientes';
}

