  const map={
    TODOS:'userKpiAllCard',
    PRESTAMO:'userKpiLoanCard',
    PENDIENTES_POR_ATENDER:'userKpiPendingAttentionCard',
    DEVOLUCION_SOLICITADA:'userKpiReturnRequestedCard',
    SOLICITUDES_REASIGNACION:'userKpiReassignRequestsCard',
    REASIGNACIONES_SOLICITADAS_POR_MI:'userKpiReassignSentCard',
    REASIGNADOS_POR_MI:'userKpiReassignedByCard',
    REASIGNADOS_A_MI:'userKpiReassignedToCard',
