}


async function runAdminGlobalSearchV230(){
  if(!canUseGlobalSearchV231())return;

  const q=cleanSearch(
    el('adminGlobalSearchInputV230')?.value||''
  );

  const resultBox=el('adminGlobalResultsV230');
  const table=el('adminGlobalResultsTableV230');
  const count=el('adminGlobalResultsCountV230');
  const title=el('adminGlobalResultsTitleV230');

  if(!q){
    resultBox?.classList.add('hidden');
    return;
  }

  if(q.length<2){
    resultBox?.classList.remove('hidden');
    if(title)title.textContent='Resultados de búsqueda';
    if(count)count.textContent='0 resultados';
    if(table){
      table.innerHTML=
        '<div class="empty">Ingrese al menos 2 caracteres.</div>';
    }
    return;
  }

  resultBox?.classList.remove('hidden');

  if(title){
    title.textContent=`Resultados globales · "${q}"`;
  }

  if(count)count.textContent='Buscando...';

  if(table){
    table.innerHTML=
      '<div class="empty">Buscando en todos los expedientes...</div>';
  }

  try{
    const rows=await fetchAdminGlobalSearchV230(q);

    if(count){
      count.textContent=
        `${rows.length} resultado${rows.length===1?'':'s'}`;
    }

    if(table){
      table.innerHTML=
        renderAdminGlobalSearchV230(rows,q);
    }

    if(el('ownerCardsPanel')){
      el('ownerCardsPanel').classList.add('hidden');
    }

    resultBox?.scrollIntoView({
      behavior:'auto',
      block:'start'
    });

  }catch(error){
    if(count)count.textContent='Error';

    if(table){
      table.innerHTML=`
        <div class="empty">
          No se pudo realizar la búsqueda.<br>
          <b>${esc(error?.message||String(error))}</b>
        </div>`;
    }
  }
}


function clearAdminGlobalSearchV230(){
  if(el('adminGlobalSearchInputV230')){
    el('adminGlobalSearchInputV230').value='';
  }

  v230AdminSearchCache.clear();

  el('adminGlobalResultsV230')?.classList.add('hidden');

  if(el('ownerCardsPanel') && ownerCardsMode()){
    el('ownerCardsPanel').classList.remove('hidden');
    el('ownerCardsPanel').classList.remove('hidden-by-role');
  }

  if(isPureArchiveV231()){
    selectedOwner='';
    panelQuickFilter='';
  }
}


const V229_SCOPE_SEARCH_TTL=30000;
const v229ScopeSearchCache=new Map();

function coordinatorScopeSearchKeyV229(search){
  return [
    String(session?.user?.id||''),
    norm(search||'')
  ].join('|');
}

function clearCoordinatorScopeSearchCacheV229(){
  v229ScopeSearchCache.clear();
}

async function coordinatorScopeSearchRowsV229(search){
  const q=cleanSearch(search||'');

  if(!q)return [];

  if(q.length<2){
    throw new Error('Ingrese al menos 2 caracteres para buscar en su ámbito.');
  }

  const key=coordinatorScopeSearchKeyV229(q);
  const cached=v229ScopeSearchCache.get(key);

  if(
    cached &&
    Date.now()-cached.savedAt<V229_SCOPE_SEARCH_TTL
  ){
    return v179CloneRows(cached.rows);
  }

  const {data,error}=await sb.rpc(
    'v229_coordinador_buscar_ambito',
    {p_busqueda:q}
  );

  if(error)throw error;

  const rows=v211JsonRows(data);

  v229ScopeSearchCache.set(
    key,
    {
      savedAt:Date.now(),
      rows:v179CloneRows(rows)
    }
  );

  return rows;
}

