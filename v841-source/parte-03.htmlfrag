  if(button){
    button.disabled=true;
    button.textContent='Abriendo...';
  }

  try{
    await manageExpedienteFromPanel(expedienteId,null);

    // manageExpedienteFromPanel ya abre la solicitud relacionada y
    // selecciona automáticamente el expediente si puede gestionarse.
    const item=(requestDetailRows||[]).find(
      x=>String(x.expediente_id)===String(expedienteId)
    );

    if(!item){
      if(el('rqActionStatus')){
        el('rqActionStatus').textContent='No se encontró el expediente dentro de la solicitud asociada.';
      }
      return;
    }

    if(norm(item.estado_item)!=='DEVOLUCIÓN SOLICITADA'){
      if(el('rqActionStatus')){
        el('rqActionStatus').textContent=
          'Este expediente ya no se encuentra en DEVOLUCIÓN SOLICITADA. Actualice el Registro maestro.';
      }
      return;
    }

    requestSelectedIds.clear();
    requestSelectedIds.add(expedienteId);
    renderRequestDetailItems();
    renderRequestActions();

    // Seleccionar por defecto la primera ubicación de Archivo disponible,
    // manteniendo la posibilidad de cambiarla antes de aceptar.
    const retorno=el('rqDRetorno');
    if(retorno && !retorno.value){
      const archiveOption=[...retorno.options].find(o=>norm(o.value).includes('ARCHIVO'));
      if(archiveOption)retorno.value=archiveOption.value;
    }

    if(el('rqActionStatus')){
      el('rqActionStatus').innerHTML=
        '<b>DEVOLUCIÓN SOLICITADA.</b> El expediente ya está seleccionado. '+
        'Revise la ubicación de retorno y pulse <b>✓ Aceptar solicitud de devolución</b>.';
    }

    // Llevar visualmente al bloque de acciones.
    setTimeout(()=>{
      el('rqWorkflowActions')?.scrollIntoView({behavior:'auto',block:'center'});
    },80);

  }catch(err){
    alert(err?.message||String(err));
  }finally{
    if(button){
      button.disabled=false;
      button.textContent=originalText;
    }
  }
}


function alertCutoffDate(){
  // Devuelve el día correspondiente al 31.er día hábil contado
  // hacia atrás, porque la alerta se activa cuando rowDays() > 30.
  const d=new Date();
  d.setHours(0,0,0,0);

  let count=0;
  while(count<31){
    const w=d.getDay();
    if(w!==0 && w!==6)count++;
    if(count<31)d.setDate(d.getDate()-1);
  }

  const y=d.getFullYear();
  const m=String(d.getMonth()+1).padStart(2,'0');
  const day=String(d.getDate()).padStart(2,'0');
  return `${y}-${m}-${day}`;
}



// ============================================================
// V628 · DÍAS HÁBILES SIN ATENDER
// Regla única para todos los perfiles:
// - inicia en la fecha de ingreso de la solicitud;
// - cuenta únicamente lunes a viernes;
// - el día actual todavía no se considera transcurrido;
// - solo se muestra mientras exista atención pendiente.
// No genera consultas adicionales a Supabase.
// ============================================================
function v628LimaDateKey(value){
  const raw=String(value??'').trim();
  if(!raw)return '';

  if(/^\d{4}-\d{2}-\d{2}$/.test(raw))return raw;

  const d=new Date(raw);
  if(!Number.isFinite(d.getTime())){
    const m=raw.match(/^(\d{4}-\d{2}-\d{2})/);
    return m?m[1]:'';
  }

  try{
    const parts=new Intl.DateTimeFormat('en-CA',{
      timeZone:'America/Lima',
      year:'numeric',month:'2-digit',day:'2-digit'
    }).formatToParts(d);
    const get=type=>parts.find(p=>p.type===type)?.value||'';
    const y=get('year'),m=get('month'),day=get('day');
    return y&&m&&day?`${y}-${m}-${day}`:'';
  }catch(_){
    return raw.slice(0,10);
  }
}

function v628TodayLimaKey(){
  return v628LimaDateKey(new Date());
}

function v628BusinessDaysElapsedFromKey(startKey){
  const m=String(startKey||'').match(/^(\d{4})-(\d{2})-(\d{2})$/);
  const endMatch=v628TodayLimaKey().match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if(!m||!endMatch)return 0;

  const start=new Date(Date.UTC(Number(m[1]),Number(m[2])-1,Number(m[3])));
  const end=new Date(Date.UTC(Number(endMatch[1]),Number(endMatch[2])-1,Number(endMatch[3])));
  if(start>=end)return 0;

  let days=0;
  const cursor=new Date(start);
  while(cursor<end){
    const w=cursor.getUTCDay();
    if(w!==0&&w!==6)days++;
    cursor.setUTCDate(cursor.getUTCDate()+1);
  }
  return days;
}

function v628RequestDaysWithoutAttention(row){
  const start=
    row?.fecha_solicitud||
    row?.solicitud_created_at||
    row?.created_at||
    row?.fecha_registro||
    null;
  return v628BusinessDaysElapsedFromKey(v628LimaDateKey(start));
}

function v628HasPendingAttention(row,forcePending=false){
  if(forcePending)return true;
  try{
    if(typeof requestPendingUnitsV163==='function'){
      return Number(requestPendingUnitsV163(row)||0)>0;
    }
  }catch(_){ }

  if(Number(row?.v626_expedientes_pendientes||0)>0)return true;
  const state=norm(row?.estado_atencion||row?.estado||'');
  return ['PENDIENTE POR ATENDER','ACEPTADO','REGISTRADA POR ARCHIVO','ENTREGA PARCIAL'].includes(state);
}

function v628UnattendedDaysHtml(row,forcePending=false){
  if(!v628HasPendingAttention(row,forcePending))return '';
  const days=v628RequestDaysWithoutAttention(row);
  const level=days>=5?'high':days>=2?'warn':'normal';
  const label=days===1?'1 día hábil sin atender':`${days} días hábiles sin atender`;
  return `<span class="v628-unattended-days ${level}" title="Días hábiles transcurridos desde el ingreso de la solicitud">${esc(label)}</span>`;
}

function renderUserPendingAttentionRows(rows,canManage=false){
  if(!rows.length){
    return '<div class="empty">No hay expedientes pendientes por atender.</div>';
  }

  return `<table class="pending-attention-table">
    <thead><tr>
      <th>Expediente</th>
      <th>Extensión</th>
      <th>R.D.</th>
      <th class="pending-folio-col">Último folio</th>
      <th>Solicitud</th>
      <th class="subject-cell-v639">Asunto</th>
      <th>Modalidad</th>
      <th>Estado</th>
      <th>Fecha / hora solicitud</th>
      <th class="v647-days-unattended-col">Días sin atender</th>
      <th></th>
    </tr></thead>
    <tbody>${rows.map(r=>`<tr>
      <td>
        <b>${esc(r.expediente||'—')}</b>
        ${accumulatedInlineHtml(r,{canManage:false})}
      </td>
      <td>${esc(r.extension||'—')}</td>
      <td>${esc(r.rd||'—')}</td>
      <td class="pending-folio-col">${esc(r.ultimo_folio||'—')}</td>
      <td>${esc(r.solicitud_numero||'—')}</td>
      <td class="subject-cell-v639" title="${esc(r.asunto||'')}"><div class="subject-text-v639">${esc(r.asunto||'—')}</div></td>
      <td>${v497ModalityBadge(r.modalidad)}</td>
      <td>
        <span class="pill pending">PENDIENTE POR ATENDER</span>
        ${r._cross_wait
          ?`<span class="v183-other-holder-note">
              ${norm(r._cross_wait.estado||'')==='DEVOLUCIÓN SOLICITADA'
                ?'Devolución registrada · pendiente de recepción por Archivo'
                :`Actualmente con ${esc(r.responsable_actual||'otro usuario')} · esperando devolución`
              }
            </span>`
          :''
        }
      </td>
      <td>${requestRequestDateTimeHtml(r)}</td>
      <td class="v647-days-unattended-col">${v628UnattendedDaysHtml(r,true)||'—'}</td>
      <td><div style="display:flex;gap:6px;white-space:nowrap">
        ${cycleHistoryButton(r.expediente_id||r.id,r)}
        ${canManage
          ?`<button class="btn small"
                    onclick="openPendingAttentionDirect('${r.expediente_id||r.id||''}',this)">
              ${esc(v497PendingActionLabel(r.modalidad))}
            </button>`
          :''
        }
      </div></td>
    </tr>`).join('')}</tbody>
  </table>`;
}

