}
/* Colores de los nodos de la ruta */
#tab-states .state-card:nth-child(1) .state-count{border-color:#d99a00!important;color:#8b6200!important;background:#fff8e1!important}
#tab-states .state-card:nth-child(2) .state-count{border-color:#27805f!important;color:#1e684d!important;background:#e8f7ef!important}
#tab-states .state-card:nth-child(3) .state-count{border-color:#7251ad!important;color:#5d4092!important;background:#f1ecfb!important}
#tab-states .state-card:nth-child(4) .state-count{border-color:#c97b2c!important;color:#92541b!important;background:#fff0e2!important}
#tab-states .state-card:nth-child(5) .state-count{border-color:#2b835f!important;color:#1e6a4b!important;background:#e7f6ed!important}

/* Responsive: la ruta se convierte en bloques de flujo, sin superposición */
@media(max-width:1280px){
  #tab-states .state-grid,
  body.produce-staff #tab-states .state-grid{
    grid-template-columns:repeat(3,minmax(190px,1fr))!important;
    gap:6px!important;
  }
  #tab-states .state-grid::before,
  body.produce-staff #tab-states .state-grid::before{display:none!important}
  #tab-states .state-card,
  body.produce-staff #tab-states .state-card{
    border:1px solid #d1dce7!important;
    background:#f5f8fb!important;
  }
  #tab-states .state-card:not(:last-child),
  body.produce-staff #tab-states .state-card:not(:last-child){border-right:1px solid #d1dce7!important}
  #tab-states .state-card .state-count,
  body.produce-staff #tab-states .state-card .state-count{box-shadow:none!important}
}
@media(max-width:820px){
  #tab-states .state-grid,
  body.produce-staff #tab-states .state-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
}
@media(max-width:520px){
  #tab-states .state-grid,
  body.produce-staff #tab-states .state-grid{grid-template-columns:1fr!important}
}
</style>











<!-- V728 · Ocultar el buscador desplegable de «Usuario seleccionado» sin tocar los filtros ni la lógica de selección. -->
<style id="v728-selected-owner-display-only">
  /* El valor continúa sincronizado por los scripts existentes a través de #selectedOwnerDisplay. */
  html body #ownerDetailFilters #ownerSelectedUserField #selectedOwnerDisplay {
    appearance: none !important;
    -webkit-appearance: none !important;
    pointer-events: none !important;
    cursor: default !important;
    border: 0 !important;
    outline: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
    background-image: none !important;
    padding: 1px 0 !important;
    min-height: 22px !important;
    height: auto !important;
    font-weight: 850 !important;
    color: #102c60 !important;
    font-size: 14px !important;
    border-radius: 0 !important;
    text-overflow: ellipsis;
  }
  html body #ownerDetailFilters #ownerSelectedUserField #selectedOwnerDisplay::-webkit-calendar-picker-indicator {
    display: none !important;
  }
</style>

<!-- V744: CORRECCIÓN DE ORIGEN EN SUPABASE + ACTUALIZACIÓN REAL DE TARJETAS -->
<!-- V746 · Observaciones opcionales de devolución y reasignación, vinculadas a los movimientos. -->
<!-- V793 · Búsqueda: Estado actual = último movimiento operativo confirmado.
Se conserva sin modificaciones el formato de Fecha del último estado, la
custodia en Supabase, el historial y los permisos de préstamo/reasignación. -->

<style id="v813-pending-user-filter-style">
#statePendingFilters .v813-pending-grid{display:grid!important;grid-template-columns:minmax(190px,1.7fr) minmax(175px,1.45fr) minmax(130px,.95fr) minmax(195px,1.35fr) auto!important;gap:10px;align-items:end}
#statePendingFilters .v813-pending-grid .field{min-width:0}
#statePendingFilters .v813-pending-grid select,#statePendingFilters .v813-pending-grid input{width:100%;max-width:100%;min-width:0;box-sizing:border-box}
@media(max-width:1160px){#statePendingFilters .v813-pending-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
@media(max-width:620px){#statePendingFilters .v813-pending-grid{grid-template-columns:minmax(0,1fr)!important}}
</style>

</body></html>`);

  w.document.close();
}

async function sendSelectedArchiveListsToSanLuis(){
  if(!hasFullAccess() || archiveListBulkSending)return;

  const rows=selectedArchiveLists();

  if(!rows.length){
    showToast('Seleccione uno o varios listados con destino SAN LUIS.');
    return;
  }

  if(rows.some(l=>norm(l.destino||'')!=='SAN LUIS')){
    showToast(
      'Para enviar a San Luis debe seleccionar únicamente listados cuyo destino sea SAN LUIS. Desmarque los listados de Barrenechea.'
    );
    return;
  }

  if(rows.some(l=>norm(l.estado||'')!=='GENERADO')){
    showToast(
      'Todos los listados seleccionados deben estar en estado GENERADO antes de enviarlos a San Luis.'
    );
    return;
  }

  if(rows.some(l=>Number(l.total_expedientes||0)<=0)){
    showToast('No se puede enviar un listado vacío.');
    return;
  }

  const confirmed=window.confirm(
    `Se registrará el envío físico de ${rows.length} listado${rows.length===1?'':'s'} a SAN LUIS. `+
    `Los expedientes cambiarán su ubicación física de BARRENECHEA a SAN LUIS. ¿Continuar?`
  );

  if(!confirmed)return;

  archiveListBulkSending=true;
  syncArchiveListBulkSelectionUI();

  if(el('archiveListBulkStatus')){
    el('archiveListBulkStatus').textContent=
      `Procesando ${rows.length} listado${rows.length===1?'':'s'}...`;
  }

  const successes=[];
  const failures=[];

  // Secuencial: evita cruces y permite identificar exactamente
  // qué listado falló sin perder los ya confirmados.
  for(let i=0;i<rows.length;i++){
    const l=rows[i];

    if(el('archiveListBulkStatus')){
      el('archiveListBulkStatus').textContent=
        `Enviando ${i+1} de ${rows.length}: ${l.numero}...`;
    }

    const {data,error}=await sb.rpc('confirmar_envio_listado_san_luis',{
      p_listado_id:l.id,
      p_observacion:null
    });

    if(error){
      failures.push({
        numero:l.numero,
        error:error.message||'No se pudo registrar el envío'
      });
      continue;
    }

    successes.push({
      numero:l.numero,
      total:Number(data?.total_expedientes||l.total_expedientes||0)
    });

    archiveListSelectedIds.delete(String(l.id));
  }

  archiveListBulkSending=false;
  invalidateMasterArchiveListCaches();

  const totalExp=successes.reduce((sum,x)=>sum+x.total,0);

  if(el('archiveListBulkStatus')){
    el('archiveListBulkStatus').textContent=failures.length
      ?`${successes.length} listado(s) enviados · ${failures.length} con observación.`
      :`${successes.length} listado(s) enviados correctamente a San Luis.`;
  }

  if(successes.length){
    showToast(
      `${successes.length} listado(s) · ${totalExp} expediente(s) enviados a San Luis.`
    );
  }else if(failures.length){
    showToast(failures[0].error);
  }

  await loadArchiveLists();

  // Si el listado abierto fue enviado, recargar su detalle para mostrar
  // inmediatamente ENVIADO A SAN LUIS.
  if(currentArchiveListId){
    const refreshed=archiveListsRows.find(x=>
      String(x.id)===String(currentArchiveListId)
    );

    if(refreshed){
      await loadArchiveListDetail(currentArchiveListId);
    }
  }

  await Promise.all([
    loadAll(),
    loadSummary(),
    loadStates(),
    loadPanel(),
    loadHistory()
  ]);

  syncArchiveListBulkSelectionUI();

  if(failures.length && el('archiveListBulkStatus')){
    el('archiveListBulkStatus').innerHTML=
      `<b>${successes.length} enviados.</b> `+
      `${failures.length} no pudieron enviarse: `+
      failures.map(x=>`${esc(x.numero)} · ${esc(x.error)}`).join(' | ');
  }
}


async function loadArchiveLists(){
  if(!hasFullAccess())return;

  el('archiveListsTable').innerHTML='<div class="empty">Cargando listados...</div>';

  const {data,error}=await sb.rpc('listar_listados_devolucion_archivo_v2');

  if(error){
    el('archiveListsTable').innerHTML=`<div class="empty">${esc(error.message)}</div>`;
    return;
  }

  archiveListsRows=data||[];

  archiveListSearchText=archiveListSearchValue();

  // Conservar selección múltiple de cualquier listado que siga existiendo.
  const existingIds=new Set(
    archiveListsRows.map(l=>String(l.id))
  );

  [...archiveListSelectedIds].forEach(id=>{
    if(!existingIds.has(String(id))){
      archiveListSelectedIds.delete(String(id));
    }
  });

  renderArchiveListsTable();
}

async function loadArchiveListDetail(id){
  currentArchiveListId=id;
  el('archiveListDetailTable').innerHTML='<div class="empty">Cargando expedientes...</div>';
  const {data,error}=await sb.rpc('detalle_listado_devolucion_archivo',{p_listado_id:id});
  if(error){el('archiveListDetailTable').innerHTML=`<div class="empty">${esc(error.message)}</div>`;return}
  archiveListCombinedMode=false;
  archiveListCombinedHeaders=[];
  currentArchiveListRows=data||[];
  const header=archiveListsRows.find(x=>String(x.id)===String(id));
  const numero=header?.numero||currentArchiveListRows[0]?.listado_numero||'Listado';
  const destino=header?.destino||currentArchiveListRows[0]?.destino||'—';
  const estado=header?.estado||currentArchiveListRows[0]?.estado_listado||'—';
  el('archiveListDetailTitle').textContent=numero;
  el('archiveListDetailMeta').textContent=
    `${destino} · ${estado} · ${currentArchiveListRows.length} expediente(s)`+
    (
      header?.generado_por
        ?` · Generado por: ${header.generado_por}`
        :''
    )+
    (
      norm(estado)==='ENVIADO A SAN LUIS' && header?.enviado_at
        ?` · Fecha envío: ${fmtDate(header.enviado_at)}`
        :''
    );
  const isSanLuis=
    norm(destino)==='SAN LUIS' &&
    (currentArchiveListRows||[]).every(isSanLuisArchiveRange);
  const isSent=norm(estado)==='ENVIADO A SAN LUIS';

  el('archiveListExportBtn').disabled=!currentArchiveListRows.length;
  el('archiveListPrintBtn').disabled=!currentArchiveListRows.length;

  el('archiveListGenerateBtn').disabled=!currentArchiveListRows.length||estado!=='EN PREPARACIÓN';
  el('archiveListGenerateBtn').textContent=
    estado==='EN PREPARACIÓN'
      ?'Generar listado'
      :'Listado generado';

  const sendBtn=el('archiveListSendSanLuisBtn');
  if(sendBtn){
    sendBtn.classList.toggle('hidden',!isSanLuis);
    sendBtn.disabled=!currentArchiveListRows.length||estado!=='GENERADO';
    sendBtn.textContent=isSent?'Enviado a San Luis':'Enviar a San Luis';
  }

  if(isSanLuis){
    if(isSent){
      el('archiveListStatus').innerHTML=
        `<b>ENVIADO A SAN LUIS.</b> Los expedientes de este listado ya cambiaron su ubicación física a SAN LUIS.${
          header?.enviado_at?` Fecha de envío: <b>${fmtDate(header.enviado_at)}</b>.`:''
        }`;
    }else if(estado==='GENERADO'){
      el('archiveListStatus').innerHTML=
        '<b>LISTADO GENERADO · AÚN EN BARRENECHEA.</b> Los expedientes todavía permanecen físicamente en Barrenechea hasta registrar el envío a San Luis.';
    }else{
      el('archiveListStatus').innerHTML=
        '<b>EN PREPARACIÓN · EN BARRENECHEA.</b> Puede retirar expedientes antes de generar el listado.';
    }
  }else{
    el('archiveListStatus').textContent=estado==='EN PREPARACIÓN'
      ?'Puede retirar expedientes antes de generar el listado definitivo.'
      :'Listado generado. Los expedientes permanecen en Barrenechea.';
  }

  el('archiveListDetailTable').innerHTML=currentArchiveListRows.length?`<table>
    <thead><tr>
      <th class="rq-col-num">N°</th>
      <th>Expediente</th>
      <th>Ext.</th>
      <th>R.D.</th>
      <th>Último folio</th>
      <th>Fecha devolución</th>
      <th>Devuelto por</th>
      <th>Cargo</th>
      <th>Generó listado</th>
      ${estado==='EN PREPARACIÓN'?'<th></th>':''}
    </tr></thead>
    <tbody>${currentArchiveListRows.map((r,i)=>`<tr>
      <td>${i+1}</td>
      <td><b>${esc(r.expediente)}</b></td>
      <td>${esc(r.extension||'—')}</td>
      <td>${esc(r.rd||'—')}</td>
      <td>${esc(r.ultimo_folio||'—')}</td>
      <td>${fmtDate(r.fecha_devolucion)}</td>
      <td>${esc(r.devuelto_por||'—')}</td>
      <td>${esc(r.cargo||'—')}</td>
      <td>
        <span class="list-generated-by ${r._listado_generado_por?'':'empty'}">
          ${esc(r._listado_generado_por||'—')}
        </span>
      </td>
      ${estado==='EN PREPARACIÓN'?`<td><button class="btn secondary small" onclick="removeArchiveListItem('${id}','${r.expediente_id}')">Retirar</button></td>`:''}
    </tr>`).join('')}</tbody></table>`:'<div class="empty">Este listado no contiene expedientes.</div>';
  await loadArchiveLists();
}

async function removeArchiveListItem(listadoId,expedienteId){
  if(!hasFullAccess())return;
  const {error}=await sb.rpc('quitar_expediente_listado_devolucion',{
    p_listado_id:listadoId,p_expediente_id:expedienteId
  });
  if(!error){
    const header=archiveListsRows.find(x=>
      String(x.id)===String(listadoId)
    );

    const listadoNumero=String(
      header?.numero||
      ''
    ).trim();

    if(listadoNumero){
      const {error:cycleError}=await sb.rpc(
        'quitar_vinculo_listado_ciclo',
        {
          p_expediente_id:String(expedienteId),
          p_listado_numero:listadoNumero
        }
      );

      if(cycleError){
        console.warn(
          'Retirar vínculo Listado/Ciclo:',
          cycleError.message
        );
      }
    }

    invalidateMasterArchiveListCaches();
  }

  if(error){
    showToast(error.message);
    return;
  }

  showToast('Expediente retirado del listado.');
  await loadArchiveListDetail(listadoId);
  if(returnedArchiveView==='master' && masterReturnedArchiveFilterActive()){
    await loadReturnedArchiveForLists('master');
  }else if(selectedState==='DEVUELTOS AL ARCHIVO'){
    await loadReturnedArchiveForLists('states');
  }
}

async function generateCurrentArchiveList(){
  if(!currentArchiveListId)return;
  const btn=el('archiveListGenerateBtn');
  if(btn){btn.disabled=true;btn.textContent='Generando...'}
  const {error}=await sb.rpc('generar_listado_devolucion_archivo_v2',{p_listado_id:currentArchiveListId});
  if(!error){
    invalidateMasterArchiveListCaches();
  }
  if(error){showToast(error.message);if(btn){btn.disabled=false;btn.textContent='Generar listado'}return}
  const currentHeader=archiveListsRows.find(x=>String(x.id)===String(currentArchiveListId));
  showToast(
    norm(currentHeader?.destino||'')==='SAN LUIS'
      ?'Listado generado. Los expedientes aún permanecen en Barrenechea.'
      :'Listado generado correctamente.'
  );
  await loadArchiveLists();
  await loadArchiveListDetail(currentArchiveListId);
  if(returnedArchiveView==='master' && masterReturnedArchiveFilterActive()){
    await loadReturnedArchiveForLists('master');
  }else if(selectedState==='DEVUELTOS AL ARCHIVO'){
    await loadReturnedArchiveForLists('states');
  }
}


async function sendCurrentArchiveListToSanLuis(){
  if(!hasFullAccess()||!currentArchiveListId)return;

  const header=archiveListsRows.find(x=>String(x.id)===String(currentArchiveListId));
  if(!header)return;

  if(norm(header.destino||'')!=='SAN LUIS'){
    showToast('Esta acción solo corresponde a listados destinados a San Luis.');
    return;
  }

  if(norm(header.estado||'')!=='GENERADO'){
    showToast('Primero debe generar el listado antes de registrar su envío a San Luis.');
    return;
  }

  const invalidYears=(currentArchiveListRows||[]).filter(r=>!isSanLuisArchiveRange(r));
  if(invalidYears.length){
    showToast('Solo los expedientes de los años 1995 al 2016 pueden ser enviados a la sede San Luis.');
    return;
  }

  const btn=el('archiveListSendSanLuisBtn');
  if(btn){
    btn.disabled=true;
    btn.textContent='Registrando envío...';
  }

  const {data,error}=await sb.rpc('confirmar_envio_listado_san_luis',{
    p_listado_id:currentArchiveListId,
    p_observacion:null
  });

  if(error){
    showToast(error.message||'No se pudo registrar el envío a San Luis.');
    if(btn){
      btn.disabled=false;
      btn.textContent='Enviar a San Luis';
    }
    return;
  }

  invalidateMasterArchiveListCaches();
  archiveListSelectedIds.delete(String(currentArchiveListId));

  showToast(
    `${Number(data?.total_expedientes||currentArchiveListRows.length)} expediente(s) enviados a San Luis.`
  );

  await loadArchiveLists();
  await loadArchiveListDetail(currentArchiveListId);

  // Actualizar Registro Maestro y vistas operativas para que la ubicación
  // cambie inmediatamente de ARCHIVO/BARRENECHEA a SAN LUIS.
  await Promise.all([
    loadAll(),
    loadSummary(),
    loadStates(),
    loadPanel(),
    loadHistory()
  ]);
}


function exportCurrentArchiveListCSV(){
  if(!currentArchiveListRows.length)return;
  const header=archiveListsRows.find(x=>String(x.id)===String(currentArchiveListId));
  const numero=header?.numero||currentArchiveListRows[0]?.listado_numero||'LISTADO';
  const generadoPor=header?.generado_por||'';
  const rows=currentArchiveListRows.map((r,i)=>[
    i+1,r.expediente,r.extension,r.rd,r.ultimo_folio,r.fecha_devolucion,r.devuelto_por,r.cargo,generadoPor
  ]);
  const csv=[['N°','EXPEDIENTE','EXTENSIÓN','R.D.','ÚLTIMO FOLIO','FECHA DEVOLUCIÓN','DEVUELTO POR','CARGO','GENERÓ LISTADO'].join(';'),
    ...rows.map(x=>x.map(csvEscape).join(';'))].join('\n');
  downloadBlob(`${numero}.csv`,csv);
}

function printCurrentArchiveList(){
  if(!currentArchiveListRows.length)return;
  const header=archiveListsRows.find(x=>String(x.id)===String(currentArchiveListId));
  const numero=header?.numero||currentArchiveListRows[0]?.listado_numero||'LISTADO';
  const destino=header?.destino||currentArchiveListRows[0]?.destino||'—';
  const estado=header?.estado||currentArchiveListRows[0]?.estado_listado||'—';
  const generadoPor=header?.generado_por||'—';
  const w=window.open('','_blank');
  if(!w)return;
  const rows=currentArchiveListRows.map((r,i)=>`<tr>
    <td>${i+1}</td>
    <td><b>${esc(r.expediente)}</b></td>
    <td>${esc(r.extension||'—')}</td>
    <td>${esc(r.rd||'—')}</td>
    <td>${esc(r.ultimo_folio||'—')}</td>
    <td>${fmtDate(r.fecha_devolucion)}</td>
    <td>${esc(r.devuelto_por||'—')}</td>
    <td>${esc(r.cargo||'—')}</td>
    <td>${esc(generadoPor)}</td>
  </tr>`).join('');
  w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>${esc(numero)}</title><style>
    body{font-family:Arial,sans-serif;padding:28px;color:#111}h2{margin:0 0 5px}p{margin:3px 0 16px;color:#444}table{border-collapse:collapse;width:100%;font-size:11px}th,td{border:1px solid #999;padding:6px;text-align:left}th{background:#eee}@media print{button{display:none}}
    </style></head><body><h2>${esc(numero)}</h2>
    <p><b>Destino:</b> ${esc(destino)} · <b>Estado:</b> ${esc(estado)} · <b>Generado por:</b> ${esc(generadoPor)} · <b>Total:</b> ${currentArchiveListRows.length}</p>
    <table><thead><tr><th>N°</th><th>Expediente</th><th>Ext.</th><th>R.D.</th><th>Último folio</th><th>Fecha devolución</th><th>Devuelto por</th><th>Cargo</th><th>Generó listado</th></tr></thead><tbody>${rows}</tbody></table>
    <script>window.onload=()=>setTimeout(()=>window.print(),250)<\/script></body></html>`);
  w.document.close();
}
// ============================================================
// FIN LISTADOS DE EXPEDIENTES DEVUELTOS
// ============================================================

function clearStateSelection(){
  closeReturnPanelWhenOpeningState();
  selectedState='';
  if(el('stateSearch'))el('stateSearch').value='';
  renderStates();
  el('stateDetailTitle').textContent='Seleccione un estado para ver sus expedientes';
  if(el('stateDetailMeta'))el('stateDetailMeta').textContent='Seleccione una tarjeta para ver el detalle y usar las opciones del módulo.';
  if(el('stateDetailActions'))el('stateDetailActions').innerHTML='';
  el('stateDetailCount').textContent='0';
  el('stateDetailTable').innerHTML='<div class="empty">Pulse una tarjeta para ver sus expedientes.</div>';
}


function reqStatePill(state){
  const cls=state==='SOLICITADO'?'req-solicitado':
    state==='ACEPTADO'?'req-aceptado':
    state==='CARGO GENERADO'?'req-atencion':
    state==='EN ATENCIÓN'?'req-atencion':
    state==='EN PRÉSTAMO'?'req-prestamo':
    state==='DEVOLUCIÓN SOLICITADA'?'req-devolucion-solicitada':
    state==='DEVUELTO'?'req-devuelto':
    state==='CERRADO POR ADMINISTRADOR'?'req-cerrado-admin':'req-cancelado';
  return `<span class="req-state ${cls}">${esc(requestStateDisplayName(state||''))}</span>`;
}



function openAddItemsToExistingRequest(){
  if(!currentRequestId || !currentRequest){
    alert('No se pudo identificar la solicitud.');
    return;
  }

  // Una vez enviada, la solicitud del perfil USUARIO queda en solo lectura.
  if(isLimitedUser()){
    alert('La solicitud ya fue enviada a Archivo y no puede modificarse a nivel usuario.');
    return;
  }

  if(currentRequest.estado!=='SOLICITADO'){
    alert('Solo se pueden agregar expedientes mientras la solicitud esté en estado SOLICITADO.');
    return;
  }

  addToExistingRequestId=currentRequestId;
  requestSearchRows=[];
  requestSearchSelectedIds.clear();
  requestDraftItems=[];

  el('requestLookupInput').value='';
  el('requestLookupStatus').textContent='Busque y agregue uno o más expedientes a esta solicitud.';
  el('requestLookupResults').innerHTML='<div class="empty">Sin búsqueda.</div>';
  showNewExpRequestOption(false);
  updateRequestLookupSelection();
  renderRequestDraft();

  el('requestLookupContinueBtn').textContent='Agregar a solicitud';
  el('requestSearchModal').classList.add('show');
  setTimeout(()=>el('requestLookupInput').focus(),50);
}


function closeNewRequestModal(){
  const modal=el('newRequestModal');
  if(modal){
    modal.classList.remove('show');
    modal.dataset.editId='';

    // V475 · no conservar la posición vertical entre aperturas.
    const box=modal.querySelector('.modal-box');
    if(box)box.scrollTop=0;
    modal.scrollTop=0;
  }
  // V458: retirar físicamente del DOM todas las opciones del catálogo al cerrar.
  clearRequestAsuntoOptionsV458();

  window.__newRequestHeaderDraft=null;
  window.__editingRequestId=null;
  window.__editingRequestNumero=null;
  window.__editingRequestState=null;
  window.__editingRequestAttentionState=null;
  window.__editingRequestModalidad=null;
  window.__editingRequestAtiende=null;
  window.__editCargoSelectedKeys=null;

  if(el('rqPrepareAtiende'))el('rqPrepareAtiende').value='';
  if(el('rqPrepareCargoObs'))el('rqPrepareCargoObs').value='';
  el('rqPrepareDeliveryPanel')?.classList.add('hidden');
  el('rqAddItemsPanel')?.classList.remove('hidden');
  if(el('rqSelectedTitle'))el('rqSelectedTitle').textContent='Expedientes solicitados';
  if(el('rqSaveBtn'))el('rqSaveBtn').classList.remove('hidden');
  ['rqAsunto','rqModalidad','rqObservacion'].forEach(id=>{if(el(id))el(id).disabled=false;});
  el('rqAcceptFromEditBtn')?.classList.add('hidden');
  el('rqSavePrintCargoBtn')?.classList.add('hidden');

  if(el('rqModalTitle')){
    el('rqModalTitle').textContent='Nueva solicitud de expedientes';
  }
  if(el('rqModalNote')){
    el('rqModalNote').textContent=
      'Si el expediente está disponible en Archivo, se genera una solicitud normal. Si está bajo custodia de OTRO USUARIO O COORDINADOR, no se crea una nueva solicitud: se envía una SOLICITUD DE REASIGNACIÓN al responsable actual. USUARIO, COORDINADOR y personal con perfil ARCHIVO pueden solicitarla. Si el custodio confirma, el expediente pasa directamente al solicitante.';
  }
  if(el('rqSaveBtn')){
    el('rqSaveBtn').textContent='Enviar solicitud';
  }
}

async function saveNewRequest(){
  const status=el('rqSaveStatus');
  const btn=el('rqSaveBtn');

  const solicitante=(el('rqSolicitante')?.value||'').trim();
  const asunto=(el('rqAsunto')?.value||'').trim();
  const modalidad=(el('rqModalidad')?.value||'').trim();
  const observacion=(el('rqObservacion')?.value||'').trim();

  let items=[];
  try{
    items=JSON.parse(el('newRequestModal')?.dataset.items||'[]');
  }catch(_){
    items=[];
  }

  if(!solicitante){
    if(status){
      status.textContent=isLimitedUser()
        ?'No se pudo identificar al solicitante.'
        :'Seleccione a quién se entregarán los expedientes.';
    }
    el('rqSolicitante')?.focus();
    return;
  }

  // V828: USUARIO y COORDINADOR solo pueden pedir a nombre propio.
  // Se valida de nuevo al enviar, además de mostrar el selector bloqueado.
  if(isPersonalRequesterV828()){
    const autenticado=String(currentProfile?.nombre_personal||'').trim();
    if(!autenticado || norm(solicitante)!==norm(autenticado)){
      if(status)status.textContent='La solicitud debe registrarse a nombre del usuario autenticado. Vuelva a abrir Nueva solicitud.';
      return;
    }
  }

  if(!asunto){
    if(status)status.textContent='Seleccione el asunto.';
    focusRequestAsuntoPicker();
    return;
  }

  if(!validarAsuntoActivo(asunto,'rqSaveStatus','rqAsunto')){
    return;
  }

  if(!['PRÉSTAMO','COPIA DIGITAL','LECTURA EN SALA'].includes(modalidad)){
    if(status)status.textContent='Seleccione una modalidad válida.';
    el('rqModalidad')?.focus();
    return;
  }

  if(!Array.isArray(items)||!items.length){
    if(status){
      status.textContent=
        'Agregue al menos un expediente usando Manual, Buscar en la base o Cargar Excel.';
    }
    return;
  }

  // Limpiar y validar datos antes de enviar.
  const cleanItems=[];
  const seen=new Set();

  for(const raw of items){
    const expediente=(raw?.expediente||'').trim();
    if(!expediente)continue;

    const normalizedExp=normalizeRequestExpediente(expediente);
    const normalizedExt=canonicalRequestExtension(raw?.extension||'');
    const extValidation=requestExtensionValidationV265(normalizedExp,normalizedExt);
    if(extValidation.required&&!extValidation.ok){
      if(status)status.textContent=`${normalizedExp}: ${requestExtensionRuleMessageV265(normalizedExp,normalizedExt)}`;
      return null;
    }

    const key=[
      expediente.toUpperCase(),
      (raw?.extension||'').trim().toUpperCase()
    ].join('|');

    if(seen.has(key))continue;
    seen.add(key);

    cleanItems.push({
      id:raw?.id||null,
      expediente,
      extension:normalizedExt||null,
      rd:raw?.rd||null,
      ultimo_folio:raw?.ultimo_folio||null,
      observacion:raw?.observacion||null,
      solicitud_interna:!!raw?.solicitud_interna,
      solicitud_otra_area:!!raw?.solicitud_otra_area,
      usar_reasignacion_interna:!!raw?.usar_reasignacion_interna,
      area_trabajo:raw?.area_trabajo||null,
      responsable_actual:raw?.responsable_actual||null,
      nuevo:!!raw?.nuevo
    });
  }

  if(!cleanItems.length){
    if(status)status.textContent='No hay expedientes válidos para enviar.';
    return;
  }

  const editId=window.__editingRequestId||null;
  const editNumero=window.__editingRequestNumero||'';
  const correoDraftV560=!editId && typeof window.v560CaptureRequestMailDraft==='function'
    ?window.v560CaptureRequestMailDraft({solicitante,asunto,modalidad,observacion,items:cleanItems})
    :null;
  if(correoDraftV560?.invalid){
    if(status)status.textContent=correoDraftV560.invalid;
    return;
  }

  if(btn){
    btn.disabled=true;
    btn.textContent=editId?'Guardando...':'Enviando...';
  }

  if(status){
    status.textContent=editId
      ?`Guardando cambios de ${editNumero||'la solicitud'}...`
      :`Registrando solicitud con ${cleanItems.length} expediente(s)...`;
  }

  try{
    let data=null;
    let internalCreated=[];
    let correoV560Resultado=null;

    if(editId){
      const {data:editData,error}=await sb.rpc('editar_solicitud_antes_cargo',{
        p_solicitud_id:editId,
        p_solicitante:solicitante,
        p_asunto:asunto,
        p_observacion:observacion||null,
        p_modalidad:modalidad,
        p_items:cleanItems
      });
      if(error)throw error;
      data=editData;
    }else{
      const referralCheck=await annotateReferralsV124(items,true);
      const blockedReferral=referralCheck.find(r=>r._referralDestination);
      if(blockedReferral){
        throw Error(`${blockedReferral.expediente||'Expediente'}: ${requestReferralTextV124(blockedReferral)}`);
      }

      // V160:
      // Una falla al consultar alguna bandeja de CONAS/DVC/Instrucción NO debe
      // bloquear una solicitud cuando el expediente ya está identificado
      // físicamente con un usuario (p. ej. HANS HUARACA) y no figura como
      // derivado en su estado/responsable actual.
      //
      // Antes se marcaba cualquier expediente como "_referralUnverified"
      // si fallaba UNA de las tres consultas, incluso cuando su custodio era
      // un usuario normal. Eso impedía enviar solicitudes válidas.
      const referralVerificationWarning=referralCheck.some(r=>r._referralUnverified);
      if(referralVerificationWarning){
        console.warn(
          'No se pudo completar la verificación auxiliar de CONAS/DVC/Instrucción. '+
          'La solicitud continuará porque no se detectó una derivación activa en el expediente seleccionado.'
        );
      }

      // Clasificar nuevamente al momento de enviar para no depender de datos
      // antiguos de la pantalla. Solo PRÉSTAMO usa la vía interna.
      if(referralVerificationWarning && status){
        status.textContent=
          'Verificación auxiliar de derivaciones no disponible. '+
          'No se detectó derivación activa; registrando la solicitud...';
      }
      // V827: en perfil ADMINISTRADOR el destino y la custodia se
      // comprueban en Supabase ANTES de elegir la ruta. Un expediente prestado
      // nunca cae por error a la solicitud normal de Archivo.
      // No cambia ningún procedimiento del resto de perfiles.
      let split;
      if(norm(currentProfile?.rol||'')==='ADMINISTRADOR'){
        const controlV827=await v827CheckItems(cleanItems,solicitante,modalidad);
        const idsReasignacionV827=new Set(controlV827.filter(x=>x.ruta==='REASIGNACION').map(x=>String(x.expediente_id)));
        split={
          internal:cleanItems.filter(x=>x.id&&idsReasignacionV827.has(String(x.id)))
            .map(x=>({...x,solicitud_interna:true,solicitud_otra_area:false,
              usar_reasignacion_interna:true,_direct_reassign:true})),
          normal:cleanItems.filter(x=>!x.id||!idsReasignacionV827.has(String(x.id)))
            .map(x=>({...x,solicitud_interna:false,solicitud_otra_area:false,
              usar_reasignacion_interna:false}))
        };
      }else{
        split=await splitInternalReassignItems(cleanItems,modalidad);
      }

      // V794: si el Administrador solicita una reasignación, debe existir un
      // destinatario personal distinto del custodio. Supabase verificará que
      // corresponda a un usuario/coordinador/Archivo activo y único.
      if(norm(currentProfile?.rol||'')==='ADMINISTRADOR' && split.internal.length){
        const destinoV794=String(solicitante||'').trim();
        if(!destinoV794){
          throw new Error('Seleccione al usuario que recibirá el expediente reasignado.');
        }
        const propioCustodioV794=split.internal.find(x=>
          norm(x.responsable_actual||'')===norm(destinoV794)
        );
        if(propioCustodioV794){
          throw new Error(`${propioCustodioV794.expediente}: el destino ya es el custodio del expediente.`);
        }
      }

      // V466 · Si ARCHIVO solicita una reasignación directa, el destino de la
      // reasignación es el propio personal de Archivo autenticado. La RPC usa
      // auth.uid(), por lo que evitamos que el selector de solicitante muestre
      // un nombre distinto al usuario que realmente recibirá la custodia.
      if(norm(currentProfile?.rol||'')==='ARCHIVO' && split.internal.length){
        const archiveRequester=String(currentProfile?.nombre_personal||'').trim();
        if(!archiveRequester){
          throw new Error('La cuenta de Archivo no tiene un nombre de personal asociado.');
        }
        if(norm(solicitante)!==norm(archiveRequester)){
          throw new Error(
            'Para solicitar una REASIGNACIÓN DIRECTA desde el perfil ARCHIVO, '+
            'el solicitante debe ser el propio personal de Archivo conectado: '+archiveRequester+'.'
          );
        }
      }

      if(split.normal.length){
        // V159:
        // Si uno o más expedientes están físicamente con un usuario de OTRA ÁREA,
        // la solicitud debe crear también la ESPERA DE DEVOLUCIÓN que alimenta
        // la alerta del custodio actual. La RPC genérica de ciclos limpios no
        // garantiza ese registro auxiliar; por eso usamos la RPC específica.
        const crossAreaItems=split.normal.filter(x=>
          !!x?.id &&
          !!x?.solicitud_otra_area
        );

        const createRequestRpc=crossAreaItems.length
          ?'crear_solicitud_multiple_mixta_con_modalidad_espera_otra_area'
          :'crear_solicitud_multiple_mixta_con_modalidad_ciclos_limpios';

        const {data:normalData,error}=await sb.rpc(
          createRequestRpc,
          {
            p_solicitante:solicitante,
            p_asunto:asunto,
            p_observacion:observacion||null,
            p_modalidad:modalidad,
            p_items:split.normal
          }
        );

        if(error){
          const msg=String(error?.message||error||'');
          if(
            crossAreaItems.length &&
            /PGRST202|could not find the function|crear_solicitud_multiple_mixta_con_modalidad_espera_otra_area/i.test(msg)
          ){
            throw new Error(
              'La solicitud incluye un expediente que está con un usuario de otra área, '+
              'pero falta la función SQL que genera la espera de devolución y la alerta al custodio. '+
              'No se continuará con una solicitud sin alerta.'
            );
          }
          throw error;
        }

        data=normalData;

        if(crossAreaItems.length){
          data={
            ...(data||{}),
            _cross_area_alerts:crossAreaItems.length
          };
        }
      }

      for(const item of split.internal){
        const avisoObservacion=[
          `Solicitud de reasignación directa generada por ${solicitante}.`,
          `El expediente está actualmente bajo custodia de ${item.responsable_actual||'otro usuario'}.`,
          'Al confirmar, la custodia pasará directamente al usuario solicitante.',
          'No se genera una solicitud normal ni se requiere devolución previa a Archivo.',
          asunto?`Asunto: ${asunto}.`:'',
          observacion||''
        ].filter(Boolean).join(' ');

        // V794: el Administrador tramita EN NOMBRE del destinatario
        // seleccionado. La solicitud pendiente se dirige al custodio actual
        // y, al aceptarse, el expediente se reasigna al usuario destinatario,
        // no a la cuenta genérica ADMINISTRADOR.
        const esAdministradorV794=norm(currentProfile?.rol||'')==='ADMINISTRADOR';
        const rpcV794=esAdministradorV794
          ?'v794_solicitar_reasignacion_admin'
          :'solicitar_reasignacion_personal_v242';
        const paramsV794=esAdministradorV794
          ?{
              p_expediente_id:item.id,
              p_destinatario_nombre:solicitante,
              p_asunto:asunto,
              p_observacion:avisoObservacion
            }
          :{
              p_expediente_id:item.id,
              p_asunto:asunto,
              p_observacion:avisoObservacion
            };
        const {data:riData,error:riError}=await sb.rpc(rpcV794,paramsV794);

        if(riError){
          // En V190 la reasignación ES el trámite principal para este expediente.
          // No se oculta un error porque no existe una solicitud normal de respaldo.
          throw new Error(
            `${item.expediente||'Expediente'}: no se pudo enviar la solicitud de reasignación. `+
            `${riError.message||''}`
          );
        }else{
          internalCreated.push(riData);
        }
      }

      if(!data && internalCreated.length){
        data={numero:'',total:internalCreated.length};
      }
    }

    // V560 · El correo es complementario: si falla, la solicitud NO se revierte.
    if(!editId && correoDraftV560?.enabled && typeof window.v560EnqueueRequestMail==='function'){
      try{
        correoV560Resultado=await window.v560EnqueueRequestMail({
          draft:correoDraftV560,
          data,solicitante,asunto,modalidad,observacion,
          items:cleanItems,
          internalCreated
        });
      }catch(mailErr){
        console.warn('V560 · solicitud registrada, correo pendiente:',mailErr);
        correoV560Resultado={ok:false,error:mailErr?.message||String(mailErr)};
      }
    }

    selectedIds.clear();
    updateSelectionUI();

    requestDraftItems=[];
    requestSearchSelectedIds.clear();
    requestExcelRows=[];
    requestExcelMissing=[];
    requestExcelDuplicates=0;

    closeNewRequestModal();

    if(editId){
      showToast(`Solicitud ${data?.numero||editNumero} actualizada correctamente`);
    }else if(internalCreated.length && data?.numero){
      showToast(
        `Solicitud ${data.numero} registrada para los expedientes disponibles · `+
        `${internalCreated.length} solicitud(es) de reasignación enviada(s)`
      );
    }else if(internalCreated.length){
      showToast(
        `${internalCreated.length} solicitud(es) de reasignación enviada(s) al usuario que tiene el expediente`
      );
    }else if(Number(data?._cross_area_alerts||0)>0){
      showToast(
        `Solicitud ${data?.numero||''} registrada · `+
        `${Number(data._cross_area_alerts)} expediente(s) en espera de devolución · `+
        `aviso generado para el custodio actual`
      );
    }else{
      showToast(`Solicitud ${data?.numero||''} registrada · ${data?.total||cleanItems.length} expediente(s) · ${modalidad}`);
    }

    if(correoDraftV560?.enabled){
      setTimeout(()=>{
        if(correoV560Resultado?.sent>0){
          showToast(`✉ Aviso registrado para ${correoV560Resultado.sent} destinatario${correoV560Resultado.sent===1?'':'s'}. Consulte el estado de envío.`);
        }else if(correoV560Resultado?.processing){
          showToast('✉ Solicitud registrada. El correo se está enviando en segundo plano.',5000);
        }else if(correoV560Resultado?.queued>0){
          showToast(`✉ Solicitud registrada. ${correoV560Resultado.queued} correo${correoV560Resultado.queued===1?'':'s'} quedó${correoV560Resultado.queued===1?'':'aron'} en cola para envío.`);
        }else if(correoV560Resultado?.ok===false){
          showToast('Solicitud registrada correctamente. El aviso por correo no pudo procesarse y puede reintentarse.',7000);
        }
      },500);
    }

    await Promise.all([loadRequests(),loadInternalReassignRequests(true),loadCrossAreaWaits(true)]);

    if(hasFullAccess()){
      await loadRequestsByLawyer();
    }

    if(isLimitedUser()){
      await loadSummary();
      await loadPanel();
    }

    switchTab(
      'requests',
      document.querySelector('[data-tab="requests"]')
    );

  }catch(err){
    console.error('saveNewRequest:',err);

    // V786 · Un timeout de PostgREST indica que el guardado NO se confirmó.
    // No cerrar el modal, no limpiar la selección ni reintentar automáticamente:
    // en los flujos mixtos podrían haberse completado operaciones anteriores.
    const v786ErrMsg=String(err?.message||err||'');
    const v786TimedOut=String(err?.code||'')==='57014' ||
      /statement timeout|canceling statement due to statement timeout/i.test(v786ErrMsg);
    if(status){
      status.textContent=v786TimedOut
        ?'Supabase tardó demasiado y no confirmó el envío. Su lista de expedientes se mantiene aquí. '+
         'Compruebe primero en «Mis solicitudes» si se registró alguna solicitud; '+
         'solo después vuelva a intentarlo para evitar duplicidades. '+
         'Si continúa ocurriendo, comuníquelo al administrador de Archivo.'
        :(err?.message || (editId
          ?'No se pudieron guardar los cambios de la solicitud.'
          :'No se pudo registrar la solicitud. Revise los datos e intente nuevamente.'));
    }

  }finally{
    if(btn){
      btn.disabled=false;
      btn.textContent=editId?'Guardar cambios':'Enviar solicitud';
    }
  }
}


function internalReassignBulkKey(item,index){
  if(item?.id)return 'ID:'+String(item.id);
  return 'ROW:'+String(index)+'|'+norm(item?.expediente||'');
}

function getInternalReassignBulkSet(){
  if(!(window.__internalReassignBulkSelectedKeys instanceof Set)){
    window.__internalReassignBulkSelectedKeys=new Set();
  }
  return window.__internalReassignBulkSelectedKeys;
}

function toggleInternalReassignBulkItem(index,checked){
  let items=[];
  try{items=JSON.parse(el('newRequestModal')?.dataset.items||'[]')}catch(_){items=[]}
  const item=items[index];
  if(!item || !item.solicitud_interna || item.usar_reasignacion_interna)return;
  const set=getInternalReassignBulkSet();
  const key=internalReassignBulkKey(item,index);
  if(checked)set.add(key); else set.delete(key);
  updateInternalReassignBulkUI();
}

function toggleAllInternalReassignBulk(checked){
  let items=[];
  try{items=JSON.parse(el('newRequestModal')?.dataset.items||'[]')}catch(_){items=[]}
  const set=getInternalReassignBulkSet();
  items.forEach((item,index)=>{
    if(!item?.solicitud_interna || item.usar_reasignacion_interna)return;
    const key=internalReassignBulkKey(item,index);
    if(checked)set.add(key); else set.delete(key);
  });
  document.querySelectorAll('#rqSelectedTable .internal-reassign-check:not(:disabled)').forEach(cb=>cb.checked=!!checked);
  updateInternalReassignBulkUI();
}

function updateInternalReassignBulkUI(){
  let items=[];
  try{items=JSON.parse(el('newRequestModal')?.dataset.items||'[]')}catch(_){items=[]}
  const set=getInternalReassignBulkSet();
  const pending=items.map((item,index)=>({item,index,key:internalReassignBulkKey(item,index)}))
    .filter(x=>x.item?.solicitud_interna && !x.item.usar_reasignacion_interna);
  const selected=pending.filter(x=>set.has(x.key)).length;
  const count=el('rqInternalReassignBulkCount');
  const btn=el('rqInternalReassignBulkBtn');
  const all=el('rqInternalReassignBulkAll');
  if(count)count.textContent=selected+' seleccionado'+(selected===1?'':'s');
  if(btn){
    btn.disabled=selected===0;
    btn.textContent='↪ Solicitar reasignación de seleccionados'+(selected?` (${selected})`:'' );
  }
  if(all){
    all.checked=!!pending.length && selected===pending.length;
    all.indeterminate=selected>0 && selected<pending.length;
  }
}

function requestInternalReassignBulkSelected(){
  if(!isLimitedUser())return;
  let items=[];
  try{items=JSON.parse(el('newRequestModal')?.dataset.items||'[]')}catch(_){items=[]}
  const set=getInternalReassignBulkSet();
  let changed=0;
  items.forEach((item,index)=>{
    if(!item?.solicitud_interna || item.usar_reasignacion_interna)return;
    if(set.has(internalReassignBulkKey(item,index))){
      item.usar_reasignacion_interna=true;
      changed++;
    }
  });
  if(!changed){
    showToast('Marque al menos un expediente para reasignación.');
    return;
  }
  window.__newRequestHeaderDraft={
    solicitante:(el('rqSolicitante')?.value||'').trim(),
    asunto:(el('rqAsunto')?.value||'').trim(),
    modalidad:(el('rqModalidad')?.value||'PRÉSTAMO').trim(),
    observacion:(el('rqObservacion')?.value||'').trim()
  };
  window.__internalReassignBulkSelectedKeys=new Set();
  showToast(`${changed} expediente${changed===1?'':'s'} marcado${changed===1?'':'s'} para reasignación interna.`);
  openNewRequestModal(items,true);
}

function toggleInternalReassignPreference(index){
  if(!isLimitedUser())return;

  let items=[];
  try{
    items=JSON.parse(el('newRequestModal')?.dataset.items||'[]');
  }catch(_){
    items=[];
  }

  const item=items[index];
  if(!item || !item.solicitud_interna)return;

  // En la misma área no existe alternativa de solicitud normal.
  // Una vez elegida la reasignación interna, solo se puede retirar el
  // expediente de la solicitud usando el botón Quitar.
  item.usar_reasignacion_interna=true;

  window.__newRequestHeaderDraft={
    solicitante:(el('rqSolicitante')?.value||'').trim(),
    asunto:(el('rqAsunto')?.value||'').trim(),
    modalidad:(el('rqModalidad')?.value||'PRÉSTAMO').trim(),
    observacion:(el('rqObservacion')?.value||'').trim()
  };

  openNewRequestModal(items,true);
}

async function openNewRequestModal(rowsOverride=null,preserveHeader=false){
  locationEditContext=null;
  resetLocationSentBadges();
  el('locationEditSection').classList.add('hidden');
  if(!sb||!session){
    alert('Debe iniciar sesión.');
    return;
  }

  if(hasFullAccess()){
    await loadArchiveProfilesV462();
    renderArchiveStaffSelects();
  }

  syncRequestRecipientUI();

  const editMode=!!window.__editingRequestId;

  // Restablecer controles; el modo ENTREGA PARCIAL los ajustará después.
  el('rqAddItemsPanel')?.classList.remove('hidden');
  if(el('rqSelectedTitle'))el('rqSelectedTitle').textContent='Expedientes solicitados';
  if(el('rqSaveBtn'))el('rqSaveBtn').classList.remove('hidden');
  ['rqAsunto','rqModalidad','rqObservacion'].forEach(id=>{if(el(id))el(id).disabled=false;});

  if(el('newRequestModal')){
    el('newRequestModal').dataset.editId=
      editMode ? window.__editingRequestId : '';
  }

  if(el('rqModalTitle')){
    el('rqModalTitle').textContent=editMode
      ?`Preparar entrega ${window.__editingRequestNumero||''}`
      :(norm(currentProfile?.rol||'')==='ADMINISTRADOR'
        ?'Registrar solicitud o reasignación de expediente'
        :'Nueva solicitud de expedientes');
  }

  if(el('rqModalNote')){
    el('rqModalNote').textContent=editMode
      ?'Complete y verifique los datos del expediente. Desde esta misma pantalla podrá aceptar la solicitud y generar/imprimir el cargo cuando corresponda.'
      :(norm(currentProfile?.rol||'')==='ADMINISTRADOR'
        ?'Seleccione el destinatario y busque el expediente. Si está en Archivo, se registrará una solicitud ordinaria; si está en préstamo a otro usuario, se solicitará la reasignación al custodio actual. El registro de la solicitud no modifica la custodia ni crea préstamos duplicados. Antes de enviar, revise la verificación administrativa.'
        :(hasFullAccess() && !isPersonalRequesterV828()
          ?'Seleccione el responsable de destino y los expedientes que serán entregados. La solicitud se registra a nombre de la persona que recibirá físicamente los expedientes; el sistema conserva por separado quién la registró. La custodia cambia recién cuando se genera el cargo y se concreta la entrega.'
          :'Puede solicitar expedientes a su nombre. Si están disponibles en Archivo, se registra una solicitud normal. Si se encuentran en poder de otro trabajador, corresponde solicitar una reasignación al custodio actual. La solicitud no cambia automáticamente al responsable.'));
  }

  if(el('rqSaveBtn')){
    el('rqSaveBtn').textContent=editMode
      ?'Guardar cambios'
      :'Enviar solicitud';
  }

  let rows=Array.isArray(rowsOverride)?rowsOverride:[];
  let ids=[];

  if(!preserveHeader || !(window.__internalReassignBulkSelectedKeys instanceof Set)){
    window.__internalReassignBulkSelectedKeys=new Set();
  }

  // Si viene desde "Solicitar seleccionados", cargar esos expedientes.
  if(!rows.length && !preserveHeader){
    ids=[...selectedIds];

    if(ids.length){
      const {data,error}=await sb
        .from('expedientes')
        .select('*')
        .in('id',ids);

      if(error){
        alert(error.message);
        return;
      }

      rows=(data||[]).map(x=>({...x,_nuevo:false}));
    }
  }

  // Antes de mostrar los expedientes al USUARIO:
  // - retirar los que ya tienen una reasignación interna ENVIADA y PENDIENTE;
  // - completar fecha de custodia / fecha de derivación a CONAS.
  if(canRequestDirectReassignV466() && rows.length){
    rows=await filterAlreadyRequestedInternalReassign(rows);
    rows=await enrichRequestCustodyContext(rows);
  }

  // IMPORTANTE:
  // Si no hay expedientes seleccionados, IGUAL se abre Nueva solicitud.
  // El usuario podrá agregarlos después por Manual / Buscar / Excel.

  const activos=catalogo.filter(x=>x.activo!==false&&x.tipo==='PERSONAL');

  // Guardar valores ya escritos si estamos regresando desde búsqueda/Excel.
  const headerDraft=preserveHeader
    ?(window.__newRequestHeaderDraft||{})
    :{};

  if(isPersonalRequesterV828()){
    if(!currentProfile.nombre_personal){
      alert('Su cuenta no tiene personal asociado.');
      return;
    }

    el('rqSolicitante').innerHTML=
      `<option value="${esc(currentProfile.nombre_personal)}">${esc(currentProfile.nombre_personal)}</option>`;
    el('rqSolicitante').value=currentProfile.nombre_personal;
    el('rqSolicitante').disabled=true;
  }else{
    el('rqSolicitante').disabled=false;

    // ARCHIVO / ADMINISTRADOR elige expresamente a quién se entregarán
    // físicamente los expedientes. Se muestran todos los PERSONAL activos.
    el('rqSolicitante').innerHTML=
      '<option value="">— SELECCIONE RESPONSABLE DE DESTINO —</option>'+
      activos
        .slice()
        .sort((a,b)=>String(a.nombre||'').localeCompare(String(b.nombre||''),'es'))
        .map(x=>`<option value="${esc(x.nombre)}">${esc(x.nombre)}</option>`)
        .join('');

    const preferred=
      headerDraft.solicitante ||
      (selectedOwner && activos.some(x=>x.nombre===selectedOwner)?selectedOwner:'') ||
      '';

    if(preferred){
      if(![...el('rqSolicitante').options].some(o=>o.value===preferred)){
        el('rqSolicitante').insertAdjacentHTML(
          'beforeend',
          `<option value="${esc(preferred)}">${esc(preferred)} (HISTÓRICO)</option>`
        );
      }
      el('rqSolicitante').value=preferred;
    }else{
      el('rqSolicitante').value='';
    }
  }

  // V458: mostrar el modal antes de crear OPTION; fuera del modal no quedan asuntos en el DOM.
  el('newRequestModal')?.classList.add('show');

  // V475 · Nueva solicitud siempre abre desde el encabezado.
  requestAnimationFrame(()=>{
    const box=el('newRequestModal')?.querySelector('.modal-box');
    if(box)box.scrollTop=0;
    if(el('newRequestModal'))el('newRequestModal').scrollTop=0;
  });

  renderRequestAsuntoSelect(headerDraft.asunto||'');

  if(preserveHeader){
    el('rqAsunto').value=headerDraft.asunto||'';
    el('rqModalidad').value=headerDraft.modalidad||'PRÉSTAMO';
    el('rqObservacion').value=headerDraft.observacion||'';
  }else{
    el('rqAsunto').value='';
    el('rqModalidad').value='PRÉSTAMO';
    el('rqObservacion').value='';
    window.__newRequestHeaderDraft=null;
  }

  syncRequestAsuntoPicker();

  el('rqSaveStatus').textContent='';

  const nuevos=rows.filter(x=>x._nuevo||x.nuevo).length;
  const existentes=rows.length-nuevos;

  el('rqSelectedCount').textContent=
    `${rows.length} expediente${rows.length===1?'':'s'} · `+
    `${existentes} existente${existentes===1?'':'s'} · `+
    `${nuevos} nuevo${nuevos===1?'':'s'}`;

  if(!rows.length){
    el('rqSelectedTable').innerHTML=
      `<div class="empty" style="padding:18px">
        Aún no ha agregado expedientes.<br>
        Utilice <b>Agregar manualmente</b>, <b>Buscar en la base</b> o <b>Cargar Excel</b>.
      </div>`;
  }else{
    const editMode=!!window.__editingRequestId;

    const partialContinue=
      editMode && norm(window.__editingRequestState||'')==='ENTREGA PARCIAL';

    const cargoMode=
      editMode &&
      ['ACEPTADO','ENTREGA PARCIAL'].includes(norm(window.__editingRequestState||'')) &&
      (el('rqModalidad')?.value||window.__editingRequestModalidad)==='PRÉSTAMO';

    const internalPendingCount=isLimitedUser()
      ?rows.filter(r=>r.solicitud_interna && !r.usar_reasignacion_interna).length
      :0;
    const internalMarkedCount=isLimitedUser()
      ?rows.filter(r=>r.solicitud_interna && r.usar_reasignacion_interna).length
      :0;
    const bulkBar=(isLimitedUser() && (internalPendingCount||internalMarkedCount))
      ?`<div class="internal-reassign-bulkbar">
          <div class="left">
            ${internalPendingCount
              ?`<label><input id="rqInternalReassignBulkAll" class="internal-reassign-check" type="checkbox" onchange="toggleAllInternalReassignBulk(this.checked)"> Seleccionar todos para reasignación</label>`
              :''}
            <span class="note">${internalPendingCount} pendiente${internalPendingCount===1?'':'s'} · ${internalMarkedCount} marcado${internalMarkedCount===1?'':'s'} para reasignación</span>
          </div>
          ${internalPendingCount
            ?`<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                <span id="rqInternalReassignBulkCount" class="note">0 seleccionados</span>
                <button id="rqInternalReassignBulkBtn" class="btn small" type="button" disabled onclick="requestInternalReassignBulkSelected()">↪ Solicitar reasignación de seleccionados</button>
              </div>`
            :''}
        </div>`
      :'';

    el('rqSelectedTable').innerHTML=`${bulkBar}<table>
      <thead>
        <tr>
          <th>N°</th>
          ${cargoMode
            ?`<th class="rq-col-select">
                <input class="request-cargo-check"
                       type="checkbox"
                       checked
                       title="Seleccionar todos para el cargo"
                       onchange="toggleAllEditCargoItems(this.checked)">
              </th>`
            :''}
          <th class="rq-col-exp">Expediente</th>
          <th class="rq-col-ext">Ext.</th>
          <th class="rq-col-rd">R.D.</th>
          <th class="rq-col-folio">Último folio</th>
          ${cargoMode?'<th class="rq-col-cargo-obs">Observación del expediente</th>':''}
          <th class="rq-col-tipo">Tipo</th>
          <th class="rq-col-estado">Estado</th>
          ${editMode?'<th class="rq-col-ubicacion">Ubicación comunicada</th>':''}
          <th class="rq-col-actions">Acciones</th>
        </tr>
      </thead>
      <tbody>
        ${rows.map((r,i)=>`<tr>
          <td class="rq-col-num">
            <div class="internal-reassign-number">
              ${isLimitedUser() && r.solicitud_interna
                ?`<input class="internal-reassign-check"
                         type="checkbox"
                         ${r.usar_reasignacion_interna?'checked disabled':''}
                         title="Marcar para solicitar reasignación interna"
                         onchange="toggleInternalReassignBulkItem(${i},this.checked)">`
                :''}
              <span>${i+1}</span>
            </div>
          </td>
          ${cargoMode
            ?`<td class="rq-col-select">
                <input class="request-cargo-check"
                       type="checkbox"
                       ${cargoItemSelected(r)?'checked':''}
                       onchange="toggleEditCargoItem(${i},this.checked)">
              </td>`
            :''}
          <td class="rq-col-exp">
            <b>${esc(expBase(r.expediente))}</b>
            ${editMode
              ?accumulatedInlineHtml(
                  r,
                  {
                    canManage:hasFullAccess(),
                    solicitudId:String(window.__editingRequestId||'')
                  }
                )
              :''
            }
          </td>

          <td class="rq-col-ext">
            ${editMode
              ?`<input class="request-item-edit extension"
                       value="${esc(r.extension||'')}"
                       placeholder="Ext."
                       oninput="updateNewRequestItemField(${i},'extension',this.value)">`
              :(r.extension?esc(r.extension):'—')}
          </td>

          <td class="rq-col-rd">
            ${editMode
              ?`<input class="request-item-edit rd"
                       value="${esc(r.rd||'')}"
                       placeholder="R.D."
                       oninput="updateNewRequestItemField(${i},'rd',this.value)">`
              :esc(r.rd||'')}
          </td>

          <td class="rq-col-folio">
            ${editMode
              ?`<input class="request-item-edit folio"
                       value="${esc(r.ultimo_folio||'')}"
                       placeholder="Último folio"
                       oninput="updateNewRequestItemField(${i},'ultimo_folio',this.value)">`
              :esc(r.ultimo_folio||'—')}
          </td>
          ${cargoMode?`<td class="rq-col-cargo-obs">
            <textarea class="cargo-item-observation"
                      style="min-width:170px;min-height:44px"
                      placeholder="Observación solo para este expediente"
                      oninput="updateEditCargoObservation(${i},this.value)">${esc(r._cargo_observacion||'')}</textarea>
          </td>`:''}

          <td class="rq-col-tipo">${
            (r._nuevo||r.nuevo)
              ?'NUEVO'
              :r.solicitud_interna
                ?'REASIGNACIÓN'
                :r.solicitud_otra_area
                  ?'OTRA ÁREA'
                  :'EXISTENTE'
          }</td>
          <td class="rq-col-estado">${r.solicitud_interna
            ?(r.usar_reasignacion_interna
              ?`<div class="internal-reassign-state selected">
                  <span class="pill returned">REASIGNACIÓN DIRECTA</span>
                  <span class="internal-reassign-note">
                    Se enviará una solicitud de reasignación a <b>${esc(r.responsable_actual||'USUARIO')}</b>
                    ${requestCustodyDateValue(r)?` · custodia desde <b>${fmtDate(requestCustodyDateValue(r))}</b>`:''}.
                    No se generará una solicitud normal para este expediente.
                  </span>
                </div>`
              :`<div class="internal-reassign-state required">
                  <span class="pill alert">REASIGNACIÓN OBLIGATORIA</span>
                  <span class="internal-reassign-note">
                    Con <b>${esc(r.responsable_actual||'USUARIO')}</b>
                    ${requestCustodyDateValue(r)?` desde <b>${fmtDate(requestCustodyDateValue(r))}</b>`:''}
                    · debe solicitarse su reasignación directa.
                  </span>
                </div>`)
            :(r.solicitud_otra_area
              ?`<div class="internal-reassign-state selected">
                  <span class="pill alert">EN ESPERA DE DEVOLUCIÓN · OTRA ÁREA</span>
                  <span class="internal-reassign-note">
                    Actualmente con <b>${esc(r.responsable_actual||'OTRO USUARIO')}</b>
                    ${r.area_trabajo?` · ${esc(r.area_trabajo)}`:''}
                    ${requestCustodyDateValue(r)?` · custodia desde <b>${fmtDate(requestCustodyDateValue(r))}</b>`:''}.
                    La solicitud se registrará, pero el expediente quedará EN ESPERA DE DEVOLUCIÓN hasta que Archivo confirme su recepción física.
                  </span>
                </div>`
              :esc(r.estado||((r._nuevo||r.nuevo)?'PENDIENTE POR ATENDER':'')))}</td>
          ${editMode?`<td class="rq-col-ubicacion"><div data-location-sent="${esc(r.id||'')}">${locationSentBadge(r.id)}</div></td>`:''}
          <td class="request-item-actions rq-col-actions">
            ${partialContinue
              ?'<span class="note" style="padding:4px 6px">Pendiente</span>'
              :`<button class="btn secondary small request-remove-btn"
                  type="button"
                  onclick="removeNewRequestItem(${i})">
                  Quitar
                </button>`}
          </td>
        </tr>`).join('')}
      </tbody>
    </table>
    ${editMode
      ?'<span class="request-edit-help">Puede completar o corregir Extensión, R.D. y Último folio antes de generar el cargo. No requiere observación: cada cambio queda registrado automáticamente en el Historial.</span>'
      :''}`;
  }

  const normalized=rows.map(r=>({
    id:r.id||null,
    expediente:r.expediente,
    extension:r.extension||null,
    rd:r.rd||null,
    ultimo_folio:r.ultimo_folio||null,
    observacion:r.observacion||null,
    _cargo_observacion:r._cargo_observacion||null,
    estado:r.estado||null,
    estado_item:r.estado_item||null,
    cargo_numero:r.cargo_numero||null,
    solicitud_interna:!!r.solicitud_interna,
    solicitud_otra_area:!!r.solicitud_otra_area,
    usar_reasignacion_interna:!!r.usar_reasignacion_interna,
    area_trabajo:r.area_trabajo||null,
    responsable_actual:r.responsable_actual||null,
    fecha_custodia_actual:r.fecha_custodia_actual||r.fecha_ultima_reasignacion||r.fecha_reasignacion||r.fecha_entrega||null,
    fecha_derivacion_conas:r.fecha_derivacion_conas||r.fecha_derivacion||null,
    fecha_derivacion_dvc:r.fecha_derivacion_dvc||r.fecha_derivacion||null,
    nuevo:!!(r._nuevo||r.nuevo)
  }));

  el('newRequestModal').dataset.items=JSON.stringify(normalized);
  syncDirectReassignSaveButtonV190(normalized);
  el('newRequestModal').dataset.ids='';
  el('newRequestModal').dataset.newExp='';
  updateInternalReassignBulkUI();
  updatePrepareDeliveryUI();
  updatePrepareCargoCount();
}


function syncDirectReassignSaveButtonV190(rows){
  const btn=el('rqSaveBtn');
  if(!btn || window.__editingRequestId)return;

  const list=Array.isArray(rows)?rows:[];
  const reassignCount=list.filter(r=>
    (r?.solicitud_interna && r?.usar_reasignacion_interna) ||
    norm(r?.tipo||'')==='REASIGNACIÓN' ||
    norm(r?.tipo||'')==='REASIGNACION' ||
    isDirectReassignRowV191(r)
  ).length;
  const normalCount=list.length-reassignCount;

  if(reassignCount && !normalCount){
    btn.textContent='Enviar solicitud de reasignación';
    btn.dataset.flow='DIRECT_REASSIGN';
  }else if(reassignCount && normalCount){
    btn.textContent='Enviar solicitud / reasignación';
    btn.dataset.flow='MIXED';
    btn.textContent='Enviar solicitud / reasignación';
  }else{
    btn.textContent='Enviar solicitud';
    btn.dataset.flow='NORMAL';
  }
}

function requestCargoKeys(r){
  const keys=[];
  if(r?.id)keys.push('ID:'+String(r.id));

  const exp=norm(r?.expediente||'');
  const ext=norm(r?.extension||'');
  if(exp)keys.push('EXP:'+exp+'|'+ext);

  return keys;
}

function cargoItemSelected(r){
  const set=window.__editCargoSelectedKeys;
  if(!(set instanceof Set))return false;
  return requestCargoKeys(r).some(k=>set.has(k));
}

function setCargoItemSelected(r,checked){
  if(!(window.__editCargoSelectedKeys instanceof Set)){
    window.__editCargoSelectedKeys=new Set();
  }

  requestCargoKeys(r).forEach(k=>{
    if(checked)window.__editCargoSelectedKeys.add(k);
    else window.__editCargoSelectedKeys.delete(k);
  });
}

function toggleEditCargoItem(index,checked){
  let items=[];
  try{
    items=JSON.parse(el('newRequestModal')?.dataset.items||'[]');
  }catch(_){items=[]}

  if(index<0||index>=items.length)return;
  setCargoItemSelected(items[index],checked);
  updatePrepareCargoCount();
}

function updateEditCargoObservation(index,value){
  let items=[];
  try{items=JSON.parse(el('newRequestModal')?.dataset.items||'[]');}catch(_){items=[]}
  if(index<0||index>=items.length)return;
  items[index]._cargo_observacion=String(value||'');
  if(el('newRequestModal'))el('newRequestModal').dataset.items=JSON.stringify(items);
}

function v676EditCargoObservationItems(expedienteIds){
  let items=[];
  try{items=JSON.parse(el('newRequestModal')?.dataset.items||'[]');}catch(_){items=[]}
  const wanted=new Set((expedienteIds||[]).map(String));
  return items
    .filter(r=>!wanted.size||wanted.has(String(r.id||'')))
    .map(r=>({
      expediente_id:String(r.id||''),
      observacion:String(r._cargo_observacion||'').trim()||null
    }))
    .filter(r=>r.expediente_id);
}

function toggleAllEditCargoItems(checked){
  let items=[];
  try{
    items=JSON.parse(el('newRequestModal')?.dataset.items||'[]');
  }catch(_){items=[]}

  items.forEach(r=>setCargoItemSelected(r,checked));
  renderNewRequestSelected();
}

function updatePrepareCargoCount(){
  const box=el('rqPrepareCargoCount');
  if(!box)return;

  let items=[];
  try{
    items=JSON.parse(el('newRequestModal')?.dataset.items||'[]');
  }catch(_){items=[]}

  const n=items.filter(cargoItemSelected).length;
  box.textContent=n
    ?`${n} expediente${n===1?'':'s'} para el cargo`
    :'Ningún expediente seleccionado para el cargo';
}

function buildCurrentRequestPayload(){
  const status=el('rqSaveStatus');

  const solicitante=(el('rqSolicitante')?.value||'').trim();
  const asunto=(el('rqAsunto')?.value||'').trim();
  const modalidad=(el('rqModalidad')?.value||'').trim();
  const observacion=(el('rqObservacion')?.value||'').trim();

  let items=[];
  try{
    items=JSON.parse(el('newRequestModal')?.dataset.items||'[]');
  }catch(_){items=[]}

  if(!solicitante){
    if(status){
      status.textContent=isLimitedUser()
        ?'No se pudo identificar al solicitante.'
        :'Seleccione a quién se entregarán los expedientes.';
    }
    el('rqSolicitante')?.focus();
    return null;
  }

  if(!asunto){
    if(status)status.textContent='Seleccione el asunto.';
    focusRequestAsuntoPicker();
    return null;
  }

  if(!validarAsuntoActivo(asunto,'rqSaveStatus','rqAsunto')){
    return null;
  }

  if(!['PRÉSTAMO','COPIA DIGITAL','LECTURA EN SALA'].includes(modalidad)){
    if(status)status.textContent='Seleccione una modalidad válida.';
    return null;
  }

  if(!items.length){
    if(status)status.textContent='La solicitud debe contener al menos un expediente.';
    return null;
  }

  const cleanItems=[];
  const seen=new Set();

  for(const raw of items){
    const expediente=(raw?.expediente||'').trim();
    if(!expediente)continue;

    const key=[
      expediente.toUpperCase(),
      (raw?.extension||'').trim().toUpperCase()
    ].join('|');

    if(seen.has(key))continue;
    seen.add(key);

    cleanItems.push({
      id:raw?.id||null,
      expediente,
      extension:raw?.extension||null,
      rd:raw?.rd||null,
      ultimo_folio:raw?.ultimo_folio||null,
      observacion:raw?.observacion||null,
      nuevo:!!raw?.nuevo
    });
  }

  if(!cleanItems.length){
    if(status)status.textContent='No hay expedientes válidos.';
    return null;
  }

  return {
    solicitante,
    asunto,
    modalidad,
    observacion,
    cleanItems
  };
}

async function saveCurrentEditSilently(){
  const editId=window.__editingRequestId;
  if(!editId)throw new Error('No existe una solicitud en edición.');

  const p=buildCurrentRequestPayload();
  if(!p)return null;

  const partialContinue=
    norm(window.__editingRequestState||'')==='ENTREGA PARCIAL';

  if(partialContinue){
    const {data,error}=await sb.rpc(
      'actualizar_datos_pendientes_solicitud',
      {
        p_solicitud_id:editId,
        p_items:p.cleanItems
      }
    );
    if(error)throw error;
    return {data,payload:p};
  }

  const {data,error}=await sb.rpc(
    'editar_solicitud_antes_cargo',
    {
      p_solicitud_id:editId,
      p_solicitante:p.solicitante,
      p_asunto:p.asunto,
      p_observacion:p.observacion||null,
      p_modalidad:p.modalidad,
      p_items:p.cleanItems
    }
  );

  if(error)throw error;
  return {data,payload:p};
}

function updatePrepareDeliveryUI(){
  const editMode=!!window.__editingRequestId;
  const state=norm(window.__editingRequestState||'');
  const modalidad=(el('rqModalidad')?.value||window.__editingRequestModalidad||'').trim();

  const panel=el('rqPrepareDeliveryPanel');
  const acceptBtn=el('rqAcceptFromEditBtn');
  const printBtn=el('rqSavePrintCargoBtn');
  const note=el('rqPrepareDeliveryNote');
  const title=el('rqPrepareDeliveryTitle');

  if(panel)panel.classList.toggle('hidden',!editMode||!hasFullAccess());

  if(!editMode||!hasFullAccess()){
    acceptBtn?.classList.add('hidden');
    printBtn?.classList.add('hidden');
    return;
  }

  fillArchiveStaffSelect('rqPrepareAtiende');
  if(el('rqPrepareAtiende') && !el('rqPrepareAtiende').value){
    const currentAtiende=window.__editingRequestAtiende||'';
    if(currentAtiende){
      const s=el('rqPrepareAtiende');
      if(![...s.options].some(o=>norm(o.value)===norm(currentAtiende))){
        const opt=document.createElement('option');
        opt.value=currentAtiende;
        opt.textContent=currentAtiende+' (histórico)';
        s.appendChild(opt);
      }
      s.value=currentAtiende;
    }
  }

  if((state==='SOLICITADO' || state==='ACEPTADO') && modalidad==='PRÉSTAMO'){
    acceptBtn?.classList.add('hidden');
    printBtn?.classList.remove('hidden');
    if(title)title.textContent='Preparación de entrega y cargo';
    if(note){
      note.textContent=
        'La solicitud ya ingresó automáticamente a atención. Seleccione quién atiende, complete los datos necesarios y genere el cargo.';
    }
  }else if(state==='ENTREGA PARCIAL' && modalidad==='PRÉSTAMO'){
    if(title)title.textContent='Continuar atención · preparar expedientes pendientes';
    acceptBtn?.classList.add('hidden');
    printBtn?.classList.remove('hidden');
    if(note){
      note.textContent=
        'Complete o corrija Extensión, R.D. y Último folio de los expedientes que aún están pendientes; seleccione los que atenderá ahora y genere el siguiente cargo.';
    }
  }else if(state==='ACEPTADO'){
    if(title)title.textContent='Solicitud en atención · responsable asignado';
    acceptBtn?.classList.add('hidden');
    printBtn?.classList.add('hidden');
    if(note){
      note.textContent=
        'La solicitud está en atención. La generación de cargo se habilita únicamente para modalidad PRÉSTAMO.';
    }
  }else{
    if(title)title.textContent='Preparación de entrega y cargo';
    acceptBtn?.classList.add('hidden');
    printBtn?.classList.add('hidden');
    if(note)note.textContent='La solicitud ya no admite preparación de cargo desde esta pantalla.';
  }

  updatePrepareCargoCount();
}

function updateNewRequestItemField(index,field,value){
  let items=[];
  try{
    items=JSON.parse(el('newRequestModal')?.dataset.items||'[]');
  }catch(_){
    items=[];
  }

  if(index<0 || index>=items.length)return;
  if(!['extension','rd','ultimo_folio'].includes(field))return;

  const v=String(value??'').trim();
  items[index][field]=v||null;

  if(el('newRequestModal')){
    el('newRequestModal').dataset.items=JSON.stringify(items);
  }
}

function removeNewRequestItem(index){
  let items=[];
  try{
    items=JSON.parse(el('newRequestModal').dataset.items||'[]');
  }catch(_){
    items=[];
  }

  if(index<0 || index>=items.length)return;

  items.splice(index,1);

  // Guardar cabecera para no perder lo escrito.
  window.__newRequestHeaderDraft={
    solicitante:el('rqSolicitante')?.value||'',
    asunto:el('rqAsunto')?.value||'',
    modalidad:el('rqModalidad')?.value||'PRÉSTAMO',
    observacion:el('rqObservacion')?.value||''
  };

  openNewRequestModal(
    items.map(x=>({...x,_nuevo:!!x.nuevo})),
    true
  );
}

function openRequestSourceFromNew(mode){
  const m=String(mode||'BUSCAR').toUpperCase();

  // Guardar Solicitante / Asunto / Modalidad / Observación.
  window.__newRequestHeaderDraft={
    solicitante:el('rqSolicitante')?.value||'',
    asunto:el('rqAsunto')?.value||'',
    modalidad:el('rqModalidad')?.value||'PRÉSTAMO',
    observacion:el('rqObservacion')?.value||''
  };

  // Conservar los expedientes ya agregados a la solicitud.
  let existingItems=[];
  try{
    existingItems=JSON.parse(el('newRequestModal')?.dataset.items||'[]');
  }catch(_){
    existingItems=[];
  }

  // V335: la Nueva solicitud permanece abierta detrás de la ventana auxiliar.
  // Solo debe desaparecer mediante Cerrar o al finalizar correctamente la solicitud.
  openRequestSearchModal();

  // Restaurar los elementos actuales dentro del borrador de búsqueda.
  requestDraftItems=existingItems.map(x=>({
    id:x.id||null,
    expediente:x.expediente,
    extension:x.extension||null,
    rd:x.rd||null,
    ultimo_folio:x.ultimo_folio||null,
    observacion:x.observacion||null,
    estado:x.estado||null,
    solicitud_interna:!!x.solicitud_interna,
    solicitud_otra_area:!!x.solicitud_otra_area,
    usar_reasignacion_interna:!!x.usar_reasignacion_interna,
    area_trabajo:x.area_trabajo||null,
    responsable_actual:x.responsable_actual||null,
    _nuevo:!!x.nuevo
  }));

  renderRequestDraft();
  updateRequestLookupSelection();

  if(el('requestSearchModalTitle')){
    el('requestSearchModalTitle').textContent=
      m==='EXCEL'
        ?'Cargar Excel para la solicitud'
        :m==='MANUAL'
          ?'Agregar expediente manualmente'
          :'Buscar expedientes para la solicitud';
  }

  if(m==='MANUAL'){
    if(el('requestLookupStatus')){
      el('requestLookupStatus').textContent=
        'Escriba el número del expediente. Si no existe en la base, podrá registrarlo como nuevo.';
    }
    setTimeout(()=>el('requestLookupInput')?.focus(),80);
    return;
  }

  if(m==='EXCEL'){
    if(el('requestLookupStatus')){
      el('requestLookupStatus').textContent=
        'Seleccione la plantilla XLSX con las columnas Expediente, Extensión, R.D. y Último folio.';
    }
    setTimeout(()=>{
      const input=el('requestExcelFile');
      if(input)input.click();
    },120);
    return;
  }

  if(el('requestLookupStatus')){
    el('requestLookupStatus').textContent=
      'Busque uno o varios expedientes existentes y agréguelos a la solicitud.';
  }

  setTimeout(()=>el('requestLookupInput')?.focus(),80);
}

function openRequestSearchModal(){
  requestLookupSequence++;
  addToExistingRequestId='';
  if(el('requestLookupContinueBtn')){
    el('requestLookupContinueBtn').textContent=
      addToExistingRequestId
        ?'Agregar a solicitud'
        :'Continuar solicitud';
  }
  if(!currentProfile?.activo){
    alert('Cuenta sin acceso.');
    return;
  }

  if(isLimitedUser() && !currentProfile.nombre_personal){
    alert('Su cuenta todavía no está asociada a un nombre de personal.');
    return;
  }

  requestSearchRows=[];
  requestSearchSelectedIds.clear();
  requestDraftItems=[];
  requestExcelRows=[];
  requestExcelMissing=[];
  requestExcelDuplicates=0;
  if(el('requestExcelSummary')){el('requestExcelSummary').classList.add('hidden');el('requestExcelSummary').innerHTML='';}
  if(el('requestExcelResults'))el('requestExcelResults').innerHTML='';
  el('requestLookupInput').value='';
  if(el('requestLookupExtension'))setRequestExtensionDropdownV330([],false);
  updateRequestExtensionRequirementV265();
  el('requestLookupStatus').textContent=
    'Escriba el número del expediente. La extensión es obligatoria para 2006, 2012 y 2017; en los demás años es opcional.';
  el('requestLookupResults').innerHTML='<div class="empty">Sin búsqueda.</div>';
  showNewExpRequestOption(false);
  updateRequestLookupSelection();
  renderRequestDraft();
  el('requestSearchModal').classList.add('show');
  setTimeout(()=>el('requestLookupInput').focus(),50);
}


function returnToNewRequestFromSearch(){
  const items=requestDraftItems.map(x=>({
    id:x.id||null,
    expediente:x.expediente,
    extension:x.extension||null,
    rd:x.rd||null,
    ultimo_folio:x.ultimo_folio||null,
    observacion:x.observacion||null,
    estado:x.estado||null,
    solicitud_interna:!!x.solicitud_interna,
    solicitud_otra_area:!!x.solicitud_otra_area,
    usar_reasignacion_interna:!!x.usar_reasignacion_interna,
    area_trabajo:x.area_trabajo||null,
    responsable_actual:x.responsable_actual||null,
    retorno_instruccion:!!x.retorno_instruccion,
    ciclo_instruccion:x.ciclo_instruccion||null,
    numero_solicitado_original:x.numero_solicitado_original||null,
