}
</style>



<style id="v362-request-alert-style">
/* ============================================================
   V362 · ALERTA PERSISTENTE POR NUEVA SOLICITUD
   - Solo ARCHIVO / ADMINISTRADOR.
   - No se cierra por tiempo.
   - Desaparece únicamente cuando el usuario abre la alerta.
   ============================================================ */
.v362-request-alert-stack{
  position:fixed;
  right:18px;
  bottom:18px;
  z-index:10080;
  width:min(390px,calc(100vw - 28px));
  max-height:min(70vh,620px);
  overflow:auto;
  display:flex;
  flex-direction:column;
  gap:9px;
  padding:2px;
  scrollbar-gutter:stable;
}
.v362-request-alert-stack.hidden{
  display:none!important;
}
.v362-request-alert-card{
  border:1px solid #8fb5db;
  border-left:6px solid #d99a00;
  border-radius:13px;
  background:#fff;
  box-shadow:0 12px 34px rgba(15,45,78,.25);
  overflow:hidden;
  animation:v362RequestAlertIn .22s ease-out;
}
@keyframes v362RequestAlertIn{
  from{opacity:0;transform:translateY(12px)}
  to{opacity:1;transform:translateY(0)}
}
.v362-request-alert-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:10px 12px 8px;
  background:#fff8e8;
  border-bottom:1px solid #f0dfb6;
}
.v362-request-alert-title{
  display:flex;
  align-items:center;
  gap:8px;
  min-width:0;
  color:#17365d;
  font-weight:900;
  font-size:13px;
}
.v362-request-alert-bell{
  font-size:19px;
  flex:0 0 auto;
}
.v362-request-alert-new{
  flex:0 0 auto;
  padding:3px 7px;
  border-radius:999px;
  background:#d92727;
  color:#fff;
  font-size:9px;
  font-weight:900;
  letter-spacing:.04em;
}
.v362-request-alert-body{
  padding:10px 12px;
}
.v362-request-alert-number{
  color:#123e6b;
  font-size:16px;
  font-weight:900;
  margin-bottom:5px;
}
.v362-request-alert-meta{
  display:grid;
  gap:3px;
  color:#465f7a;
  font-size:11px;
  line-height:1.35;
}
.v362-request-alert-meta b{
  color:#17365d;
}
.v362-request-alert-actions{
  display:flex;
  justify-content:flex-end;
  padding:0 12px 11px;
}
.v362-request-alert-open{
  min-width:132px;
}
.v362-request-alert-summary{
  border:1px solid #b7cce2;
  border-radius:11px;
  background:#eef6ff;
  color:#17365d;
  padding:8px 11px;
  font-size:11px;
  font-weight:800;
  box-shadow:0 8px 22px rgba(15,45,78,.16);
}
@media(max-width:700px){
  .v362-request-alert-stack{
    right:8px;
    bottom:8px;
    width:calc(100vw - 16px);
  }
}
</style>



<style id="v363-toast-duration-style">
/* V363 · las notificaciones temporales permanecen visibles más tiempo.
   La alerta persistente de nueva solicitud sigue sin cerrarse por tiempo. */
#toast{
  transition:opacity .22s ease,transform .22s ease!important;
}
</style>


<style id="v424-anfora-visual-merge">
/* =========================================================
   V424 · COMBINACIÓN VISUAL
   Estilo de referencia: Ánfora.
   Se conserva íntegramente la estructura, lógica y Supabase de V423.
   ========================================================= */
:root{
  --anfora-navy:#142d49;
  --anfora-navy2:#213e5d;
  --anfora-accent:#e3a641;
  --anfora-bg:#f2f5f8;
  --anfora-surface:#ffffff;
  --anfora-ink:#192d40;
  --anfora-muted:#657687;
  --anfora-line:#dce4eb;
  --anfora-green:#147a64;
  --anfora-red:#b34646;
  --anfora-blue:#2565a1;
  --anfora-shadow:0 8px 28px rgba(27,51,77,.08);

  --navy:var(--anfora-navy);
  --blue:var(--anfora-blue);
  --bg:var(--anfora-bg);
  --text:var(--anfora-ink);
  --muted:var(--anfora-muted);
  --line:var(--anfora-line);
  --shadow:var(--anfora-shadow);
  --block:#fff;
  --block-soft:#f8fafc;
  --block-muted:#f4f7fa;
  --block-warm:#fff8ea;
  --block-danger:#fff3f3;
}

html,body{background:var(--anfora-bg)!important;color:var(--anfora-ink)!important}
body,body.produce-ui{
  font-family:system-ui,-apple-system,"Segoe UI",Arial,sans-serif!important;
  background:var(--anfora-bg)!important;
  color:var(--anfora-ink)!important;
}

/* Cabecera institucional: se conserva PRODUCE, pero con lenguaje visual Ánfora. */
.produce-top{
  background:#fff!important;
  color:var(--anfora-ink)!important;
  border-bottom:1px solid var(--anfora-line)!important;
  box-shadow:0 2px 10px rgba(27,51,77,.07)!important;
}
.produce-brand{
  background:var(--anfora-navy)!important;
  color:#fff!important;
  box-shadow:inset 0 -4px 0 var(--anfora-accent)!important;
  letter-spacing:.02em!important;
}
.produce-org{color:var(--anfora-ink)!important}
.produce-org strong{color:var(--anfora-navy)!important}
.produce-person{color:var(--anfora-ink)!important}
.produce-person small{color:var(--anfora-muted)!important}
.produce-avatar{
  background:#eef3f7!important;
  color:var(--anfora-navy)!important;
  border:1px solid var(--anfora-line)!important;
}
.produce-bell{color:var(--anfora-navy)!important}
.produce-bell b{background:var(--anfora-red)!important}
.produce-account button.produce-logout{
  background:#fff!important;
  color:var(--anfora-navy)!important;
  border:1px solid var(--anfora-line)!important;
  border-radius:9px!important;
}
.produce-account button.produce-logout:hover{background:#f3f7fa!important}

/* Menú lateral oscuro del estilo Ánfora. */
.produce-nav,
body.produce-user .produce-nav,
body.produce-staff .produce-nav{
  background:var(--anfora-navy)!important;
  border-right:1px solid #284560!important;
  color:#fff!important;
  box-shadow:none!important;
}
.produce-nav>button,
body.produce-user .produce-nav>button,
body.produce-staff .produce-nav>button{
  color:#cfdae5!important;
  background:transparent!important;
  border:0!important;
  border-radius:10px!important;
  font-weight:600!important;
  box-shadow:none!important;
  position:relative!important;
}
.produce-nav>button:hover,
body.produce-user .produce-nav>button:hover,
body.produce-staff .produce-nav>button:hover{
  background:#213e5d!important;
  color:#fff!important;
}
.produce-nav>button.active,
body.produce-user .produce-nav>button.active,
body.produce-staff .produce-nav>button.active{
  background:#2b4c6e!important;
  color:#fff!important;
  box-shadow:inset 3px 0 0 var(--anfora-accent)!important;
  border:0!important;
}
.produce-nav footer,
body.produce-staff .produce-nav footer,
body.produce-user .produce-nav footer{
  background:var(--anfora-navy)!important;
  color:#b8c8d6!important;
  border-top:1px solid #3a546e!important;
}
.produce-nav footer strong{color:#fff!important}

/* Acciones del menú lateral del perfil usuario. */
body.produce-user .produce-selection-actions{border-top-color:#3a546e!important}
body.produce-user .produce-selection-heading{color:#9fb3c5!important}
body.produce-user .produce-nav .produce-selection-actions #selectedCount{
  background:#203c59!important;color:#e7eef5!important;border-color:#3a5874!important;
}
body.produce-user .produce-nav .produce-selection-actions button.btn{
  background:transparent!important;
  border:1px solid transparent!important;
  color:#cfdae5!important;
  border-radius:9px!important;
}
body.produce-user .produce-nav .produce-selection-actions button.btn:not(:disabled):hover{
  background:#213e5d!important;border-color:#36536e!important;color:#fff!important;
}

/* Área principal. */
body.produce-user .app .main,
body.produce-staff .app .main,
.app.role-admin .main,
.app.role-archive .main,
.app.role-user .main,
.app.limited-user .main{
  background:var(--anfora-bg)!important;
}
body.produce-user .title h1,
body.produce-staff .title h1,
.title h1{
  font-family:Georgia,"Times New Roman",serif!important;
  color:var(--anfora-navy)!important;
  letter-spacing:-.02em!important;
  font-weight:700!important;
}
body.produce-user .title p,
body.produce-staff .title p,
.title p{color:var(--anfora-muted)!important}

/* Fecha/hora y bandas técnicas. */
.produce-clock,
.statusbar,
#connectionBar,
.improvement-bar{
  background:#fff!important;
  color:var(--anfora-ink)!important;
  border:1px solid var(--anfora-line)!important;
  border-radius:10px!important;
  box-shadow:none!important;
}
.produce-clock strong{border-left-color:var(--anfora-line)!important}
.connection-dot{background:var(--anfora-green)!important}

/* Botones generales. */
.btn,
body.produce-user .main-sticky-header .actions>.btn:not(.hidden-by-role),
body.produce-staff .main-sticky-header .actions>.btn:not(.hidden-by-role){
  border-radius:9px!important;
  box-shadow:none!important;
  font-weight:700!important;
}
.btn:not(.secondary):not(:disabled),
body.produce-user .main-sticky-header .actions>#searchRequestBtn,
body.produce-staff .main-sticky-header .actions #newRecordBtn,
body.produce-staff .main-sticky-header .actions #custodyIncorporateBtn{
  background:var(--anfora-navy)!important;
  border-color:var(--anfora-navy)!important;
  color:#fff!important;
}
.btn:not(.secondary):not(:disabled):hover{background:var(--anfora-navy2)!important}
.btn.secondary,
body.produce-user .main-sticky-header .actions>.btn.secondary:not(.hidden-by-role),
body.produce-staff .main-sticky-header .actions>.btn.secondary:not(.hidden-by-role){
  background:#fff!important;
  color:var(--anfora-navy)!important;
  border:1px solid var(--anfora-line)!important;
}
.btn.secondary:hover{background:#f3f7fa!important}

/* Pestañas: mismas posiciones, estilo limpio. */
.tabs{background:transparent!important;border:0!important;box-shadow:none!important}
.tab,
body.produce-user .main-sticky-header .tabs .tab:not(.hidden-by-role),
body.produce-staff .main-sticky-header .tabs .tab:not(.hidden-by-role){
  background:#fff!important;
  color:#526579!important;
  border:1px solid var(--anfora-line)!important;
  border-radius:9px!important;
}
.tab:hover{background:#f0f5f9!important;color:var(--anfora-navy)!important}
.tab.active,
body.produce-user .main-sticky-header .tabs .tab.active,
body.produce-staff .main-sticky-header .tabs .tab.active{
  background:#e8f0f7!important;
  color:var(--anfora-navy)!important;
  border-color:#cbd8e4!important;
  box-shadow:inset 0 -3px 0 var(--anfora-accent)!important;
}

/* Superficies, tarjetas y filtros. */
.card,
.kpi,
.summary-card,
.owner-user-card,
.state-card,
.filters,
#panelDetailWrap,
.table-wrap,
.modal-box,
.prepare-delivery-panel,
.request-unified-section{
  border-color:var(--anfora-line)!important;
  border-radius:13px!important;
  box-shadow:var(--anfora-shadow)!important;
}
.card,.summary-card,#panelDetailWrap,.table-wrap,.modal-box{background:#fff!important}
.filters,
#ownerDetailFilters,
.prepare-delivery-panel,
.request-unified-section{background:#f8fafc!important}
.table-head{
  background:#fff!important;
  color:var(--anfora-ink)!important;
  border-bottom:1px solid var(--anfora-line)!important;
}
.table-head strong{color:var(--anfora-navy)!important}

/* KPI: conserva significado por color, pero con el acabado limpio del referente. */
.kpi,
body.produce-staff #fullAccessKpis .kpi,
body.produce-user .app.role-user #userPersonalKpis .kpi,
body.produce-user .app.role-user #userPersonalKpis #userKpiAllCard{
  background:#fff!important;
  border:1px solid var(--anfora-line)!important;
  box-shadow:var(--anfora-shadow)!important;
}
.kpi .label{color:var(--anfora-muted)!important}
.kpi .value{color:var(--anfora-navy)!important;font-family:Georgia,"Times New Roman",serif!important}
.kpi.warn,
body.produce-staff #fullAccessKpis .card-pending,
#userKpiPendingAttentionCard{background:#fff8ea!important;border-color:#f0dfba!important}
.kpi.danger,#userKpiAlertCard{background:#fff2f2!important;border-color:#efd3d3!important}
body.produce-staff #fullAccessKpis .card-returned,
#userKpiReturnedCard{background:#eef8f4!important;border-color:#cfe7df!important}
#userKpiReassignedByCard,#userKpiReassignedToCard{background:#f3f0fb!important;border-color:#ddd5ef!important}
#userKpiReturnRequestedCard{background:#fff6ec!important;border-color:#efdcc7!important}
.kpi-view{color:var(--anfora-blue)!important;text-decoration:none!important}
.kpi-view:hover{text-decoration:underline!important}

/* Tarjetas de usuarios/equipo. */
body.produce-staff .owner-user-card{
  background:#fff!important;
  border:1px solid var(--anfora-line)!important;
  box-shadow:var(--anfora-shadow)!important;
}
.owner-user-card.selected-user-card{
  border-color:#90a8be!important;
  box-shadow:inset 3px 0 0 var(--anfora-accent),var(--anfora-shadow)!important;
}
.owner-user-name,.owner-user-total{color:var(--anfora-navy)!important}

/* Estados: semánticos pero sobrios. */
body.produce-staff .state-card{background:#fff!important;border-color:var(--anfora-line)!important;color:var(--anfora-ink)!important;box-shadow:var(--anfora-shadow)!important}
body.produce-staff .state-card:nth-child(2){background:#eef8f4!important;border-color:#cfe7df!important}
body.produce-staff .state-card:nth-child(3){background:#fff8ea!important;border-color:#f0dfba!important}
body.produce-staff .state-card:nth-child(4){background:#fff5ec!important;border-color:#eedbc8!important}
body.produce-staff .state-card.selected{outline:none!important;box-shadow:inset 3px 0 0 var(--anfora-accent),var(--anfora-shadow)!important}

/* Formularios. */
.field input,.field select,.field textarea,
#ownerDetailFilters input,#ownerDetailFilters select,
.asunto-picker-trigger,.asunto-picker-search,
.request-item-edit,.bulk-return-input,.instruction-return-input{
  background:#fff!important;
  color:var(--anfora-ink)!important;
  border-color:var(--anfora-line)!important;
  border-radius:8px!important;
}
.field input:focus,.field select:focus,.field textarea:focus,
#ownerDetailFilters input:focus,#ownerDetailFilters select:focus,
.asunto-picker-trigger:focus,.asunto-picker-search:focus{
  outline:none!important;
  border-color:#70a2cc!important;
  box-shadow:0 0 0 3px #dcebf8!important;
}
.field label,#ownerDetailFilters label{color:var(--anfora-muted)!important}
.note{background:#f4f7fa!important;border-color:var(--anfora-line)!important;color:var(--anfora-muted)!important}

/* Menú de asuntos con el mismo lenguaje visual. */
.asunto-picker-menu{border-color:var(--anfora-line)!important;border-radius:11px!important;box-shadow:var(--anfora-shadow)!important}
.asunto-picker-search-wrap{background:#f7f9fb!important;border-bottom-color:var(--anfora-line)!important}
/* Tablas generales: cabecera clara como en Ánfora. Registro maestro V19 conserva sus grupos. */
body.produce-ui .main section table:not(.master-v19):not(.master-v18) thead th,
body.produce-user #panelTable table thead th,
body.produce-staff .main section table:not(.master-v19):not(.master-v18) thead th{
  background:#f7f9fb!important;
  color:#617386!important;
  text-transform:uppercase!important;
  letter-spacing:.04em!important;
  border-color:var(--anfora-line)!important;
  border-bottom:1px solid #ccd7e0!important;
}
body.produce-ui .main section table:not(.master-v19):not(.master-v18) tbody td,
body.produce-user #panelTable table tbody td,
body.produce-staff .main section table:not(.master-v19):not(.master-v18) tbody td{
  background:#fff!important;
  color:var(--anfora-ink)!important;
  border-color:var(--anfora-line)!important;
}
body.produce-ui .main section table:not(.master-v19):not(.master-v18) tbody tr:nth-child(even)>td,
body.produce-user #panelTable table tbody tr:nth-child(even)>td,
body.produce-staff .main section table:not(.master-v19):not(.master-v18) tbody tr:nth-child(even)>td{
  background:#fafcfe!important;
}
body.produce-ui .main section table:not(.master-v19):not(.master-v18) tbody tr:hover>td,
body.produce-user #panelTable table tbody tr:hover>td,
body.produce-staff .main section table:not(.master-v19):not(.master-v18) tbody tr:hover>td{
  background:#f2f6fa!important;
}
.record-selected-row td,.row-click-select.record-selected-row td,
body.produce-user #panelTable table tbody tr.record-selected-row>td,
body.produce-staff .main section table:not(.master-v19) tbody tr.record-selected-row>td{
  background:#e5eef6!important;
  color:var(--anfora-ink)!important;
}
.record-selected-row td:first-child{box-shadow:inset 4px 0 0 var(--anfora-accent)!important}

/* Registro Maestro: conserva colores funcionales de bloques, armoniza cuerpo. */
#allTable .master-v19 tbody td{color:var(--anfora-ink)!important;border-color:#d7e0e7!important}
#allTable .master-v19 tbody tr:nth-child(odd) td{background:#fff!important}
#allTable .master-v19 tbody tr:nth-child(even) td{background:#fafcfe!important}
#allTable .master-v19 tbody tr:hover td{background:#f1f5f8!important}
#allTable .master-v19 tbody tr.record-selected-row td{background:#e5eef6!important}

/* Badges y estados. */
.pill,.badge,.req-state,.status-attn,.list-status,.sede-badge,.dest-badge{
  border-radius:999px!important;
}
.pill.returned,.req-devuelto,.status-attn.received,.list-status.generated,.list-status.sent{background:#dff3ed!important;color:#116e59!important}
.pill.loan,.req-prestamo,.status-attn.returning{background:#fff1d7!important;color:#935c12!important}
.pill.alert{background:#fbe6e6!important;color:#9e3434!important}

/* Modales. */
.modal{background:rgba(9,30,53,.66)!important}
.modal-box{border:1px solid var(--anfora-line)!important;background:#fff!important}
.modal-head{border-bottom:1px solid var(--anfora-line)!important;padding-bottom:12px!important}
.modal-head h2{font-family:Georgia,"Times New Roman",serif!important;color:var(--anfora-navy)!important}
.modal-foot{border-top-color:var(--anfora-line)!important}

/* Directorio original que se abre como panel complementario. */
body.produce-staff.produce-directory-open .app>.sidebar{
  background:#fff!important;
  color:var(--anfora-ink)!important;
  border-right:1px solid var(--anfora-line)!important;
  box-shadow:7px 0 22px rgba(27,51,77,.16)!important;
}
body.produce-staff .sidebar .brand,
body.produce-staff .sidebar .side-title{color:var(--anfora-navy)!important}
body.produce-staff .sidebar .side-item{
  color:#42566b!important;
  background:#fff!important;
  border:1px solid var(--anfora-line)!important;
  border-radius:9px!important;
}
body.produce-staff .sidebar .side-item:hover{background:#f3f7fa!important}
body.produce-staff .sidebar .side-item.active{
  background:#e8f0f7!important;
  color:var(--anfora-navy)!important;
  border-color:#c6d4e0!important;
  box-shadow:inset 3px 0 0 var(--anfora-accent)!important;
}

/* Alertas y paneles de apoyo. */
#alertsModal .alerts-modal-box{background:#f7f9fb!important}
#alertsModal .alerts-total-card,#alertsModal .alerts-group,#alertsModal .alerts-type-card{border-color:var(--anfora-line)!important;box-shadow:none!important}
#alertsModal .alerts-group-title,#alertsModal .alerts-type-head{background:#f7f9fb!important;border-color:var(--anfora-line)!important}
#alertsModal #alertsUnreadText{background:var(--anfora-navy)!important}

/* Scrollbars discretas. */
.main *, .produce-nav{
  scrollbar-color:#aebdca #edf1f4;
  scrollbar-width:thin;
}
.main *::-webkit-scrollbar,.produce-nav::-webkit-scrollbar{width:9px;height:9px}
.main *::-webkit-scrollbar-track,.produce-nav::-webkit-scrollbar-track{background:#edf1f4}
.main *::-webkit-scrollbar-thumb,.produce-nav::-webkit-scrollbar-thumb{background:#aebdca;border-radius:999px;border:2px solid #edf1f4}

/* Responsive: mantiene la lógica existente y el nuevo estilo. */
@media(max-width:700px){
  .produce-top{background:#fff!important}
  .produce-brand{font-size:20px!important}
  body.produce-user .produce-nav,
  body.produce-staff .produce-nav{background:var(--anfora-navy)!important}
}
</style>


<style id="v467-desktop-notification-style">
/* V467 · Avisos de escritorio por solicitud de reasignación */
#desktopNotifyBtnV467.v467-active{
  background:#e9f8ef!important;
  color:#17613a!important;
  border-color:#86c9a2!important;
}
#desktopNotifyBtnV467.v467-blocked{
  background:#fff3f3!important;
  color:#9f1d1d!important;
  border-color:#e4aaaa!important;
}
#desktopNotifyBtnV467.v467-waiting{
  background:#fff8e6!important;
  color:#815700!important;
  border-color:#e6c46b!important;
}
</style>


<style id="v475-new-request-view-fix">
/* ============================================================
   V475 · NUEVA SOLICITUD · VISTA CORREGIDA
   Problema:
   - el menú lateral / cabecera podían quedar por encima del modal;
   - el cuadro de Nueva solicitud podía abrir conservando un scroll
     anterior, dejando oculto el encabezado y los primeros campos.
   Solución:
   - el modal queda por encima de toda la interfaz;
   - se centra dentro del viewport real;
   - limita su alto y usa un único scroll interno;
   - cabecera permanece visible durante el desplazamiento;
   - formulario usa dos columnas equilibradas en escritorio.
   ============================================================ */

#newRequestModal{
  z-index:100500!important;
  box-sizing:border-box!important;
  overflow-y:auto!important;
  overflow-x:hidden!important;
  overscroll-behavior:contain!important;
}

#newRequestModal.show{
  display:flex!important;
  align-items:flex-start!important;
  justify-content:center!important;
  padding:12px!important;
}

#newRequestModal .modal-box{
  position:relative!important;
  width:min(1180px,calc(100vw - 28px))!important;
  max-width:1180px!important;
  min-width:0!important;
  max-height:calc(100vh - 24px)!important;
  max-height:calc(100dvh - 24px)!important;
  margin:0 auto!important;
  padding:16px!important;
  box-sizing:border-box!important;
  overflow-y:auto!important;
  overflow-x:hidden!important;
  scrollbar-gutter:stable;
}

/* Mantener título y botón Cerrar visibles. */
#newRequestModal .modal-head{
  position:sticky!important;
  top:0!important;
  z-index:6!important;
  background:#fff!important;
  margin:-4px -4px 12px!important;
  padding:4px 4px 12px!important;
  border-bottom:1px solid var(--line)!important;
}

/* Dos columnas reales: Solicitante/Asunto y Modalidad/Observación. */
#newRequestModal > .modal-box > .form-grid{
  grid-template-columns:repeat(4,minmax(0,1fr))!important;
  gap:10px!important;
  width:100%!important;
  min-width:0!important;
}

#newRequestModal > .modal-box > .form-grid .span2{
  grid-column:span 2!important;
}

#newRequestModal .field,
#newRequestModal .card,
#newRequestModal .request-selected-wrap,
#newRequestModal #rqSelectedTable{
  min-width:0!important;
  max-width:100%!important;
  box-sizing:border-box!important;
}

