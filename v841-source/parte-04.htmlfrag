  top:0!important;
  z-index:35!important;
}
</style>


<style id="v317-selection-visual-fix">
/* =========================================================
   V317 · VISTA DE SELECCIÓN CORREGIDA
   - La tarjeta activa se distingue sin borde negro/grueso.
   - El clic con mouse no deja un rectángulo azul sobre "Ver expedientes".
   - Se conserva foco accesible cuando se navega con teclado.
   ========================================================= */
#userPersonalKpis .kpi.quick-active,
body.produce-user #userPersonalKpis .kpi.quick-active,
body.produce-staff #userPersonalKpis .kpi.quick-active{
  outline:none!important;
  border-color:#7fa9d2!important;
  box-shadow:inset 0 0 0 2px rgba(23,63,107,.18),0 4px 12px rgba(23,63,107,.06)!important;
}

#userPersonalKpis .kpi.quick-active:hover,
body.produce-user #userPersonalKpis .kpi.quick-active:hover,
body.produce-staff #userPersonalKpis .kpi.quick-active:hover{
  outline:none!important;
  box-shadow:inset 0 0 0 2px rgba(23,63,107,.22),0 5px 14px rgba(23,63,107,.08)!important;
}

/* Evita el rectángulo de foco después de un clic con mouse. */
#userPersonalKpis .kpi-view:focus:not(:focus-visible){
  outline:none!important;
  box-shadow:none!important;
}

/* Foco visible, pero más limpio, para navegación con teclado. */
#userPersonalKpis .kpi-view:focus-visible{
  outline:2px solid #7aa8d8!important;
  outline-offset:2px!important;
  border-radius:4px!important;
  box-shadow:none!important;
}

/* La selección corresponde a la tarjeta completa, no al texto del enlace. */
#userPersonalKpis .kpi.quick-active .kpi-view{
  text-decoration:none!important;
}
</style>


