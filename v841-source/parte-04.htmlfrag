}
</style>

<style id="v130-cabecera-adaptable-pantalla">
/* =========================================================
   V130 · CABECERA Y PESTAÑAS ADAPTABLES AL ANCHO DISPONIBLE
   - Las pestañas se redistribuyen en nuevas filas al reducir la ventana.
   - Se elimina el recorte lateral de opciones.
   - Los botones se compactan progresivamente sin perder legibilidad.
   - La barra inferior de desplazamiento del Registro maestro se conserva.
   ========================================================= */

/* La navegación superior aprovecha el ancho disponible y baja de fila
   cuando una opción ya no entra completa. */
.main-sticky-header .tabs,
.tabs{
  display:flex !important;
  flex-wrap:wrap !important;
  align-items:center !important;
  align-content:flex-start !important;
  gap:6px !important;
  width:100% !important;
  max-width:100% !important;
  overflow-x:visible !important;
  overflow-y:visible !important;
  white-space:normal !important;
}

.main-sticky-header .tab,
.tabs .tab{
  flex:0 1 auto !important;
  min-width:0 !important;
  max-width:100% !important;
  white-space:nowrap !important;
  line-height:1.15 !important;
}

/* Los bloques informativos también pueden repartirse en varias líneas. */
.main-sticky-header .statusbar{
  white-space:normal !important;
  overflow-wrap:anywhere;
}
.main-sticky-header .improvement-bar{
  width:100%;
  max-width:100%;
  flex-wrap:wrap !important;
}

/* Pantalla mediana: compactar suavemente antes de crear demasiadas filas. */
@media(max-width:1280px){
  .main-sticky-header .tabs,
  .tabs{
    gap:5px !important;
    padding:5px !important;
  }
  .main-sticky-header .tab,
  .tabs .tab{
    padding:7px 9px !important;
    font-size:10px !important;
  }
}

/* Ventana dividida o portátil pequeño. */
@media(max-width:1000px){
  .main-sticky-header .tabs,
  .tabs{
    gap:4px !important;
  }
  .main-sticky-header .tab,
  .tabs .tab{
    padding:6px 8px !important;
    font-size:9.5px !important;
  }
}

/* En pantallas pequeñas se usa una cuadrícula para que ninguna pestaña
   quede fuera del área visible. */
@media(max-width:700px){
  .main-sticky-header .tabs,
  .tabs{
    display:grid !important;
    grid-template-columns:repeat(2,minmax(0,1fr)) !important;
    gap:5px !important;
  }
  .main-sticky-header .tab,
  .tabs .tab{
    width:100% !important;
    white-space:normal !important;
    text-align:center !important;
    min-height:34px;
  }
}

@media(max-width:430px){
  .main-sticky-header .tabs,
  .tabs{
    grid-template-columns:1fr !important;
  }
}
</style>


<style id="v158-scroll-vertical-total-custodia">
/* V158 · Perfil USUARIO · listado de Mis expedientes con desplazador vertical.
   La cabecera del listado queda visible y solo se desplazan las filas. */
body.produce-user #panelDetailWrap{
  overflow:hidden!important;
}
body.produce-user #panelTable{overflow-x:auto!important;overflow-y:visible!important;min-height:0!important;max-height:none!important;}
body.produce-user #panelTable table thead th{
