      <th>Por recibir</th>
      <th class="rq-cargo-col">Cargo</th>
      <th>Atiende el requerimiento</th>
      <th>Fecha préstamo</th>
      <th></th>
      <th class="v738-detail-th" title="Consultar el estado de cada expediente">Detalle</th>
    </tr></thead>
    <tbody>
      ${visibleRequestRows.map(r=>`<tr class="${(String(r?.modalidad||'').trim().toUpperCase()==='COPIA DIGITAL' && (['COPIA DIGITAL ENTREGADA','ENTREGA TOTAL'].includes(String(r?.estado_atencion||r?.estado||'').trim().toUpperCase()) || (Number(r?.total_expedientes||0)>0 && Number(r?.atendidos||0)>=Number(r?.total_expedientes||0) && Number(r?.devoluciones_pendientes||0)===0)))?'v500-digital-total-row':''}">
        <td><b>${Number(r.total_expedientes||0)}</b></td>
        <td><b>${esc(r.numero)}</b></td>
        <td>${requestRequestDateTimeHtml(r)}</td>
        <td>${v641UnattendedDaysCell(r)}</td>
        <td>${esc(r.solicitante)}</td>
        <td class="subject-cell-v639" title="${esc(r.asunto||'')}"><div class="subject-text-v639">${esc(r.asunto||'—')}</div></td>
        <td>${v497ModalityBadge(r.modalidad||'PRÉSTAMO')}</td>
        <td>${requestAttentionCellHtml(r)}</td>
        ${showLocationColumnV691?`<td class="v691-request-location-col" data-v691-request-location="${esc(String(r.id||''))}" data-v691-total="${Number(r.total_expedientes||0)}" aria-busy="true"><span class="v691-location-empty">Consultando…</span></td>`:''}
        <td>${Number(r.atendidos||0)} / ${Number(r.total_expedientes||0)}</td>
        <td>${Number(r.devoluciones_pendientes||0)}</td>
        <td class="rq-cargo-col"><span class="rq-cargo-inline">${esc(r.cargo_numero||'—')}</span></td>
        <td><b>${esc(r.atiende_requerimiento||r.atiende||'—')}</b></td>
        <td><b>${requestDeliveryText(r)}</b></td>
        <td><div style="display:flex;gap:6px;flex-wrap:wrap;justify-content:center">
          ${requestWorkflowAction(r)}
        </div></td>
        <td class="v738-detail-td"><button type="button" class="v738-detail-button" title="Ver expedientes y estados actuales de ${esc(r.numero||'la solicitud')}" onclick="event.stopPropagation();v738ShowRequestDetail('${esc(String(r.id||''))}',this)">Ver ▾</button></td>
      </tr>`).join('')}
    </tbody>
  </table>`;

  if(showLocationColumnV691){
    loadRequestLocationSummariesV691(false);
  }
}



async function markPendingVerificationDone(rowIndex){
  // Función conservada solo por compatibilidad con versiones antiguas.
  showToast('La verificación separada fue eliminada. El expediente ya debe estar en PENDIENTE POR ATENDER.');
  await loadStates();
}

async function openPendingManageRequest(rowIndex){
  // V497: usar primero la colección actualmente visible. Al filtrar por
  // modalidad o expediente, el índice de la tabla ya no coincide necesariamente
  // con pendingVerifyRows completo.
  const row=(pendingAttentionVisibleRows||[])?.[Number(rowIndex)]
    || pendingVerifyRows?.[Number(rowIndex)];

  if(!row){
    alert('No se pudo identificar el expediente seleccionado.');
    return;
  }

  try{
    let requestId=null;

    // 1. Si la función SQL ya devolvió el ID, usarlo directamente.
    if(row.solicitud_id){
      requestId=row.solicitud_id;
    }

    // 2. Buscar en las solicitudes ya cargadas por número + solicitante.
    if(!requestId){
      const localMatches=(requestRows||[]).filter(r=>
        String(r.numero||'').trim()===String(row.solicitud_numero||'').trim()
        &&
        norm(r.solicitante||'')===norm(row.solicitante||'')
      );

      if(localMatches.length===1){
        requestId=localMatches[0].id;
      }
    }

    // 3. Resolver desde la relación expediente ↔ solicitud.
    // Esto evita equivocarse incluso si existen números repetidos.
    if(!requestId && row.expediente_id){
      const {data:links,error:linkError}=await sb
        .from('solicitud_expedientes')
        .select('solicitud_id')
        .eq('expediente_id',row.expediente_id);

      if(linkError)throw linkError;

      const ids=[...new Set((links||[])
        .map(x=>x.solicitud_id)
        .filter(Boolean))];

      if(ids.length){
        const {data:headers,error:headerError}=await sb
          .from('solicitudes_prestamo')
          .select('id,numero,solicitante,created_at')
          .in('id',ids);

        if(headerError)throw headerError;

        const exact=(headers||[])
          .filter(h=>
            String(h.numero||'').trim()===
              String(row.solicitud_numero||'').trim()
            &&
            norm(h.solicitante||'')===norm(row.solicitante||'')
          )
          .sort((a,b)=>
            String(b.created_at||'').localeCompare(String(a.created_at||''))
          );

        if(exact.length){
          requestId=exact[0].id;
        }
      }
    }

    // 4. Último respaldo: número + solicitante directamente en cabecera.
    if(!requestId && row.solicitud_numero){
      let q=sb
        .from('solicitudes_prestamo')
        .select('id,numero,solicitante,created_at')
        .eq('numero',row.solicitud_numero);

      const {data:headers,error:headerError}=await q;
      if(headerError)throw headerError;

      const exact=(headers||[])
        .filter(h=>
          norm(h.solicitante||'')===norm(row.solicitante||'')
        )
        .sort((a,b)=>
          String(b.created_at||'').localeCompare(String(a.created_at||''))
        );

      if(exact.length){
        requestId=exact[0].id;
      }
    }

    if(!requestId){
      alert(
        `No se pudo vincular el expediente ${row.expediente||''} `+
        `con la solicitud ${row.solicitud_numero||''}.`
      );
      return;
    }

    await openRequestDetail(requestId);

  }catch(err){
    console.error('openPendingManageRequest:',err);
    alert(
      err?.message||
      'No se pudo abrir la solicitud para gestionar.'
    );
  }
}

async function openEditRequest(id){
  if(isCoordinator()){
    alert('El perfil COORDINADOR puede realizar seguimiento, pero no puede atender ni gestionar solicitudes como Archivo.');
    return;
  }

  if(!hasFullAccess()){
    alert('Solo ADMINISTRADOR o ARCHIVO puede editar una solicitud.');
    return;
  }

  let header=requestRows.find(x=>
    x.id===id || String(x.numero||'')===String(id||'')
  );

  if(!header){
    await loadRequests();

    header=requestRows.find(x=>
      x.id===id || String(x.numero||'')===String(id||'')
    );
  }

  // Respaldo adicional: consultar directamente la cabecera por ID.
  if(!header && id && id!=='undefined' && id!=='null'){
    const looksUuid=/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(String(id));

    if(looksUuid){
      const {data,error}=await sb
        .from('solicitudes_prestamo')
        .select('*')
        .eq('id',id)
        .maybeSingle();

      if(!error && data){
        header=data;
      }
    }
  }

  if(!header){
    alert('No se encontró la solicitud.');
    return;
  }

  const attentionState=norm(header.estado_atencion||header.estado||'');

  // IMPORTANTE:
  // Una solicitud puede tener un cargo anterior o expedientes ya atendidos
  // y, al mismo tiempo, conservar otros expedientes PENDIENTES POR ATENDER.
  // Por eso la posibilidad de continuar la atención se decide por los ITEMS
  // pendientes del ciclo, no solo por la cabecera de la solicitud.
  //
  // Primero reconciliamos cualquier devolución previa y después leemos el
  // detalle real de la solicitud antes de bloquear la edición.
  await normalizePendingRequestAfterPreviousReturn(id);

  const {data:items,error}=await sb.rpc(
    'detalle_solicitud_prestamo',
    {p_solicitud_id:id}
  );

  if(error){
    alert(error.message);
    return;
  }

  await loadCrossAreaWaits(true);

  const allRows=(items||[]).map(x=>{
    const wait=crossAreaWaitFor(id,x.expediente_id);

    return {
      id:x.expediente_id,
      expediente:x.expediente,
      extension:x.extension||null,
      rd:x.rd||null,
      ultimo_folio:x.ultimo_folio||null,
      observacion:x.observacion||null,
      estado:x.estado_fisico||x.estado_item||null,
      estado_item:x.estado_item||null,
      responsable_actual:requestEffectiveCurrentResponsible(x),
      ubicacion_actual:x.ubicacion_actual||null,
      cargo_numero:x.cargo_numero||null,
      _cross_wait:wait||null,
      _nuevo:false,
      nuevo:false
    };
  });

  await enrichAccumulatedRowsInPlace(allRows);

  // Estados que equivalen operativamente a PENDIENTE POR ATENDER.
  const pendingRows=allRows.filter(x=>
    ['ACEPTADO','PENDIENTE POR ATENDER'].includes(norm(x.estado_item||'')) &&
    !x._cross_wait
  );

  const editableBeforeFirstCargo=canEditRequestBeforeCargo(header);
  const hasPriorAttention=
    Number(header.atendidos||0)>0 ||
    !!String(header.cargo_numero||'').trim() ||
    [
      'CARGO PENDIENTE DE ENTREGA',
      'ENTREGA PARCIAL',
      'ENTREGA TOTAL',
      'PENDIENTE DE CIERRE'
    ].includes(attentionState);

  // Si existen ítems pendientes, SIEMPRE debe poder continuarse la atención,
  // aunque la solicitud ya tenga un cargo anterior o expedientes devueltos.
  // En ese caso se abre en modo ENTREGA PARCIAL y solo se trabaja con los
  // expedientes todavía pendientes.
  const continuePendingAttention=
    pendingRows.length>0 &&
    (hasPriorAttention || !editableBeforeFirstCargo || attentionState==='ENTREGA PARCIAL');

  if(!editableBeforeFirstCargo && !continuePendingAttention){
    alert(
      'Esta solicitud ya no tiene expedientes pendientes por atender. '+
      'Los cargos y movimientos anteriores permanecen disponibles para consulta.'
    );
    return;
  }

  window.__editingRequestId=id;
  window.__editingRequestNumero=header.numero||'';
  window.__editingRequestState=
    continuePendingAttention
      ?'ENTREGA PARCIAL'
      :(
        ['PENDIENTE POR ATENDER','ACEPTADO']
          .includes(attentionState)
          ?'ACEPTADO'
          :(header.estado||'')
      );

  window.__editingRequestAttentionState=attentionState;
  window.__editingRequestModalidad=header.modalidad||'PRÉSTAMO';
  window.__editingRequestAtiende=header.atiende||header.atiende_requerimiento||'';

  window.__newRequestHeaderDraft={
    solicitante:header.solicitante||'',
    asunto:header.asunto||'',
    modalidad:header.modalidad||'PRÉSTAMO',
    observacion:header.observacion||''
  };

  // En continuación parcial SOLO se muestran los ítems pendientes.
  // Los ya prestados/devueltos quedan en el historial y no bloquean el nuevo cargo.
  const rows=(continuePendingAttention
    ?pendingRows
    :allRows.filter(x=>!x._cross_wait)
  );

  if(continuePendingAttention && !rows.length){
    alert('Esta solicitud ya no tiene expedientes pendientes por atender.');
    return;
  }

  window.__editCargoSelectedKeys=new Set();

  // En primera atención y en continuación parcial se proponen para el cargo
  // todos los expedientes que siguen PENDIENTES POR ATENDER.
  if(
    ['ACEPTADO','PENDIENTE POR ATENDER'].includes(norm(header.estado||'')) ||
    continuePendingAttention
  ){
    rows.forEach(r=>setCargoItemSelected(r,true));
  }

  await openNewRequestModal(rows,true);
  locationEditContext={id,header,rows:items||[]};
  el('locationEditSection').classList.remove('hidden');
  refreshLocationSentBadges(id);

  if(continuePendingAttention){
    if(el('rqModalTitle')){
      el('rqModalTitle').textContent=`Continuar atención ${header.numero||''}`;
    }
    if(el('rqModalNote')){
      el('rqModalNote').textContent=
        'La solicitud ya tuvo movimientos o cargos anteriores, pero aún conserva expedientes PENDIENTES POR ATENDER. Complete los datos de los expedientes pendientes y genere un nuevo cargo únicamente con los que atenderá en esta oportunidad.';
    }
    if(el('rqSelectedTitle')){
      el('rqSelectedTitle').textContent='Expedientes pendientes por atender';
    }
    el('rqAddItemsPanel')?.classList.add('hidden');
    if(el('rqSaveBtn'))el('rqSaveBtn').classList.add('hidden');
    ['rqSolicitante','rqAsunto','rqModalidad','rqObservacion'].forEach(fieldId=>{
      if(el(fieldId))el(fieldId).disabled=true;
    });
  }
}


async function saveAndPrintCargoFromEdit(){
  if(!hasFullAccess())return;

  const id=window.__editingRequestId;
  const status=el('rqSaveStatus');
  const btn=el('rqSavePrintCargoBtn');

  if(!id)return;

  const modalidad=(el('rqModalidad')?.value||'').trim();
  if(modalidad!=='PRÉSTAMO'){
    if(status)status.textContent='El cargo de préstamo solo corresponde a modalidad PRÉSTAMO.';
    return;
  }

  const atiende=(el('rqPrepareAtiende')?.value||'').trim();
  const obs=(el('rqPrepareCargoObs')?.value||el('rqObservacion')?.value||'').trim();
  const v676ObsDraft=v676EditCargoObservationItems();

  if(!validateArchiveStaffV421(atiende,'rqSaveStatus','rqPrepareAtiende'))return;

  if(!(window.__editCargoSelectedKeys instanceof Set) ||
     !window.__editCargoSelectedKeys.size){
    if(status)status.textContent='Seleccione al menos un expediente para el cargo.';
    return;
  }

  // Abrir la ventana inmediatamente para evitar bloqueo de popups.
  const w=window.open('','_blank','width=980,height=800');
  if(!w){
    alert('El navegador bloqueó la ventana de impresión. Permita ventanas emergentes para este sitio.');
    return;
  }

  w.document.write(
    '<!doctype html><html><body style="font-family:Arial;padding:30px">'+
    '<p>Generando cargo y registrando préstamo...</p></body></html>'
  );

  btn.disabled=true;
  btn.textContent='Generando cargo...';

  try{
    const saved=await saveCurrentEditSilently();
    if(!saved){
      w.close();
      return;
    }

    // Volver a leer la solicitud para incluir IDs creados durante la edición.
    const {data:detail,error:detailError}=await sb.rpc(
      'detalle_solicitud_prestamo',
      {p_solicitud_id:id}
    );
    if(detailError)throw detailError;

    const accepted=(detail||[]).filter(x=>{
      if(x.estado_item!=='ACEPTADO')return false;
      if(crossAreaWaitFor(id,x.expediente_id))return false;

      const keys=[
        'ID:'+String(x.expediente_id||''),
        'EXP:'+norm(x.expediente||'')+'|'+norm(x.extension||'')
      ];

      return keys.some(k=>window.__editCargoSelectedKeys.has(k));
    });

    if(!accepted.length){
      throw new Error('No hay expedientes PENDIENTES POR ATENDER seleccionados para generar el cargo.');
    }

    const ids=accepted.map(x=>x.expediente_id);

    const v676ObsMap=new Map(v676ObsDraft.map(x=>[String(x.expediente_id),x.observacion||null]));
    const v676ObsItems=ids.map(expedienteId=>({
      expediente_id:String(expedienteId),
      observacion:v676ObsMap.get(String(expedienteId))||null
    }));

    const {data:result,error}=await sb.rpc(
      'v676_generar_cargo_atencion',
      {
        p_solicitud_id:id,
        p_expediente_ids:ids,
        p_atiende:atiende,
        p_observacion:obs||null,
        p_tipo_cargo:'OFICIAL',
        p_observaciones_items:v676ObsItems
      }
    );
    if(error)throw error;

    const cargoId=result?.cargo_id;
    const cargoNumero=String(result?.cargo_numero||'').trim();

    if(!cargoId||!cargoNumero){
      throw new Error('No se pudo obtener el cargo generado.');
    }

    const {data:header,error:headError}=await sb
      .from('cargos')
      .select('*')
      .eq('id',cargoId)
      .single();

    if(headError)throw headError;

    const {data:expRows,error:expError}=await sb
      .from('expedientes')
      .select('*')
      .in('id',ids);

    if(expError)throw expError;

    const byId=new Map((expRows||[]).map(x=>[x.id,x]));
    const printRows=ids.map(x=>{
      const row=byId.get(x);
      if(!row)return null;
      return {...row,_cargo_observacion:v676ObsMap.get(String(x))||''};
    }).filter(Boolean);

    await enrichAccumulatedRowsInPlace(printRows);

    w.document.open();
    w.document.write(
      cargoPrintHtml(
        header.numero,
        header.solicitante,
        header.asunto||saved.payload.asunto,
        header.atiende_requerimiento||atiende,
        header.fecha,
        header.observacion||'',
        printRows
      )
    );
    w.document.close();

    closeNewRequestModal();

    showToast(
      `Cargo ${cargoNumero} generado · expediente(s) registrados EN PRÉSTAMO`
    );

    await Promise.all([
      loadSummary(),loadPanel(),loadAll(),loadStates(),
      loadRequests(),loadRequestsByLawyer(),loadCargos(),loadHistory()
    ]);

  }catch(err){
    try{w.close()}catch(_){}
    if(status)status.textContent=err?.message||String(err);
  }finally{
    btn.disabled=false;
    btn.textContent='Guardar, generar e imprimir cargo';
  }
}


async function normalizePendingRequestAfterPreviousReturn(requestId){
  if(!hasFullAccess() || !sb || !session || !requestId){
    return null;
  }

  try{
    const {data,error}=await sb.rpc(
      'normalizar_nueva_solicitud_tras_devolucion',
      {p_solicitud_id:requestId}
    );

    if(error){
      // Compatibilidad mientras se instala el SQL nuevo.
      console.warn(
        'normalizar_nueva_solicitud_tras_devolucion:',
        error.message
      );
      return null;
    }

    return data||null;
  }catch(error){
    console.warn(
      'normalizar nueva solicitud tras devolución:',
      error?.message||error
    );
    return null;
  }
}

function requestEffectiveCurrentResponsible(item){
  if(!item)return '';

  const itemState=norm(item.estado_item||'');
  const physicalLocation=String(
    item.ubicacion_actual||
    ''
  ).trim();

  // Una solicitud pendiente ya liberada para Archivo debe mostrar
  // la ubicación física actual, no el responsable arrastrado del
  // ciclo anterior.
  if(
    ['ACEPTADO','PENDIENTE POR ATENDER'].includes(itemState) &&
    !item._cross_wait &&
    norm(physicalLocation).includes('ARCHIVO')
  ){
    return physicalLocation;
  }

  return (
    item.responsable_actual||
    item.ubicacion_actual||
    ''
  );
}

let requestDetailLoadSeq=0;
const requestDetailCacheV358=new Map();
const REQUEST_DETAIL_CACHE_TTL_V358=120000; // V653 · 2 min de cache de detalle

function requestDetailHeaderPreviewV358(r){
  if(!r)return;
  el('rqDetailTitle').textContent=`Solicitud ${r.numero||''}`;
  el('rqDetailMeta').textContent=
    `${r.asunto||''}`+
    ` · Modalidad: ${r.modalidad||'PRÉSTAMO'}`+
    ` · Fecha solicitud: ${fmtDate(r.fecha_solicitud)}`+
    `${r.fecha_atencion||r.hora_atencion
      ?` · Ingreso a atención: ${requestAttentionText(r)}`
      :''}`+
    `${r.fechas_entrega_prestamo?.length
      ?` · Entrega préstamo: ${requestDeliveryText(r)}`
      :''}`;
}

function requestDetailCacheGetV358(id){
  const cached=requestDetailCacheV358.get(String(id||''));
  if(!cached)return null;
  if((Date.now()-Number(cached.at||0))>REQUEST_DETAIL_CACHE_TTL_V358){
    requestDetailCacheV358.delete(String(id||''));
    return null;
  }
  return cached;
}

function requestDetailCacheSetV358(id,payload){
  requestDetailCacheV358.set(String(id||''),{...payload,at:Date.now()});
  if(requestDetailCacheV358.size>24){
    const first=requestDetailCacheV358.keys().next().value;
    if(first)requestDetailCacheV358.delete(first);
  }
}

async function requestHeaderByIdV653(id){
  if(!sb||!session||!id||isCoordinator())return null;
  try{
    const {data,error}=await sb
      .from('solicitudes_prestamo')
      .select('id,numero,solicitante,asunto,observacion,estado,atiende,cargo_id,cargo_numero,fecha_solicitud,fecha_atencion,fecha_entrega,fecha_cierre,created_at,updated_at,hora_atencion,modalidad,origen_registro,registrado_por_usuario_id,cerrado_admin,motivo_cierre')
      .eq('id',id)
      .maybeSingle();
    if(error){
      console.warn('V653 · cabecera puntual:',error.message);
      return null;
    }
    return data||null;
  }catch(error){
    console.warn('V653 · cabecera puntual:',error?.message||error);
    return null;
  }
}

function requestDetailPaintHeaderV653(r,rows=[]){
  const req=r||{};
  requestDetailHeaderPreviewV358(req);
  if(el('rqDState'))el('rqDState').innerHTML=attentionStatePill(requestOverallDisplayState(req,rows));
  if(el('rqDTotal'))el('rqDTotal').textContent=Number(req.total_expedientes||rows.length||0);
  if(el('rqDCargo'))el('rqDCargo').textContent=req.cargo_numero||'—';
  if(el('rqDSolicitante'))el('rqDSolicitante').textContent=req.solicitante||'—';
  if(el('rqDOrigen'))el('rqDOrigen').innerHTML=requestOriginPill(req.origen_registro);
  if(el('rqDRegistradoPor'))el('rqDRegistradoPor').textContent=req.registrado_por||'—';
}

function requestDetailProgressiveShellV653(header){
  const modal=el('requestDetailModal');
  modal.classList.add('show');
  modal.classList.remove('detail-loading');
  modal.setAttribute('aria-busy','true');

  if(header){
    requestDetailPaintHeaderV653(header,[]);
  }else{
    el('rqDetailTitle').textContent='Solicitud';
    el('rqDetailMeta').textContent='Cargando información principal…';
    if(el('rqDState'))el('rqDState').textContent='—';
    if(el('rqDTotal'))el('rqDTotal').textContent='0';
    if(el('rqDCargo'))el('rqDCargo').textContent='—';
    if(el('rqDSolicitante'))el('rqDSolicitante').textContent='—';
  }

  if(el('rqDSelectedCount'))el('rqDSelectedCount').textContent='0 seleccionados';
  if(el('rqDetailItems'))el('rqDetailItems').innerHTML='<div class="empty v653-progressive-loading">Cargando expedientes…</div>';
  if(el('rqMovements'))el('rqMovements').innerHTML='<div class="empty v653-progressive-loading">Cargando historial en segundo plano…</div>';
  if(el('rqWorkflowActions'))el('rqWorkflowActions').innerHTML='<span class="note">Cargando opciones de gestión…</span>';
  el('rqAttentionSection')?.classList.add('hidden');
  el('rqMovementSection')?.classList.add('hidden');
  el('rqObservationSection')?.classList.add('hidden');
}

async function openRequestDetail(id){
  const detailSeq=++requestDetailLoadSeq;
  const detailSession=session;
  const stillCurrent=()=>detailSeq===requestDetailLoadSeq && session===detailSession;
  const modal=el('requestDetailModal');
  currentRequestId=id;
  v752DetailSubjects.clear();
  v752DetailSubjectCurrent.clear();

  try{
    requestSelectedIds.clear();
    requestDetailRows=[];
    requestMovementRows=[];
    if(el('rqActionStatus'))el('rqActionStatus').textContent='';
    if(el('rqDObservacion'))el('rqDObservacion').value='';
    if(el('rqDCargoExistente'))el('rqDCargoExistente').value='';

    // V653 · abrir primero, consultar después. Nunca bloquear el modal esperando perfiles.
    const cached=requestDetailCacheGetV358(id);
    let header=requestRows.find(x=>x.id===id)||
      requestViewCache?.rows?.find(x=>x.id===id)||
      cached?.header||null;

    currentRequest=header||null;
    requestDetailProgressiveShellV653(header);

    // Historial de reiteraciones: una sola carga en segundo plano por apertura.
    const reiterationPromise=v626LoadReiterationHistory(id)
      .catch(error=>console.warn('V626 · historial reiteraciones:',error));

    // Perfiles de Archivo y responsables: precarga no bloqueante.
    const archiveProfilesPromise=hasFullAccess()
      ?loadArchiveProfilesV462().then(()=>{
          if(!stillCurrent()||currentRequestId!==id)return;
          renderArchiveStaffSelects();
          try{
            fillSelects();
            renderRequestActions();
            setTimeout(forceEnableRequestAttendant,0);
          }catch(error){
            console.warn('V653 · completar perfiles Archivo:',error?.message||error);
          }
        }).catch(error=>{
          console.warn('V653 · perfiles Archivo:',error?.message||error);
        })
      :Promise.resolve(null);

    const profilesPromise=isCoordinator()
      ?Promise.resolve(null)
      :loadReassignmentProfiles().catch(error=>{
          console.warn('V653 · responsables:',error?.message||error);
          return null;
        });

    // Si se llega desde otra vista, obtener SOLO la cabecera por ID.
    // Ya no se recarga toda la bandeja de solicitudes para abrir el detalle.
    if(!header && !isCoordinator()){
      header=await requestHeaderByIdV653(id);
      if(!stillCurrent())return;
      if(header){
        currentRequest=header;
        requestDetailPaintHeaderV653(header,[]);
      }
    }

    // Cache reciente: mostrar expediente e historial inmediatamente.
    if(cached && stillCurrent()){
      currentRequest={...(header||{}),...(cached.header||{})};
      requestDetailRows=(cached.rows||[]).map(x=>({...x}));
      requestMovementRows=(cached.movements||[]).map(x=>({...x}));

      requestDetailPaintHeaderV653(currentRequest,requestDetailRows);
      renderRequestDetailItems();
      renderRequestMovements();
      renderRequestActions();
      modal.setAttribute('aria-busy','false');
      loadLocationDetail();
    }

    let currentHeaderState=norm(header?.estado_atencion||header?.estado||'');

    const needsNormalizationV358=!isCoordinator() && [
      'SOLICITADO','ACEPTADO','EN ESPERA DE DEVOLUCIÓN'
    ].includes(currentHeaderState);

    const normalizePromise=isCoordinator()
      ?Promise.resolve(null)
      :normalizePendingRequestAfterPreviousReturn(id).catch(error=>{
          console.warn('V653 · normalización:',error?.message||error);
          return null;
        });

    const crossPromise=isCoordinator()
      ?Promise.resolve(null)
      :loadCrossAreaWaits(true).catch(error=>{
          console.warn('V653 · esperas entre áreas:',error?.message||error);
          return null;
        });

    // Si la solicitud necesita reconciliación, la pantalla ya está visible;
    // solo se difiere la habilitación de acciones hasta terminarla.
    if(needsNormalizationV358){
      await normalizePromise;
      if(!stillCurrent())return;
    }

    let detailResult={data:[],error:null};
    let securePayload=null;
    let movementPromise=null;

    if(isCoordinator()){
      const secure=await sb.rpc(
        'v211_coordinador_detalle_solicitud',
        {p_solicitud_id:id}
      );
      if(secure.error)throw secure.error;
      securePayload=v211JsonObject(secure.data);
      detailResult={data:Array.isArray(securePayload.items)?securePayload.items:[],error:null};
      requestMovementRows=Array.isArray(securePayload.movements)?securePayload.movements:[];
      currentRequest={
        ...(currentRequest||{}),
        ...(securePayload.header||{})
      };
    }else{
      // V653 · el detalle principal tiene prioridad. El historial NO bloquea la apertura.
      movementPromise=sb.from('movimientos_prestamo')
        .select('*')
        .eq('solicitud_id',id)
        .order('created_at',{ascending:false})
        .limit(300)
        .then(result=>{
          if(!stillCurrent()||currentRequestId!==id)return result;
          requestMovementRows=result.error?[]:(result.data||[]);
          renderRequestMovements();

          const previous=requestDetailCacheGetV358(id);
          requestDetailCacheSetV358(id,{
            header:{...(currentRequest||previous?.header||{})},
            rows:(requestDetailRows||previous?.rows||[]).map(x=>({...x})),
            movements:(requestMovementRows||[]).map(x=>({...x}))
          });
          return result;
        }).catch(error=>{
          console.warn('V653 · historial:',error?.message||error);
          if(stillCurrent()&&currentRequestId===id && el('rqMovements')){
            el('rqMovements').innerHTML='<div class="empty">No se pudo actualizar el historial. El detalle principal permanece disponible.</div>';
          }
          return {data:[],error};
        });

      detailResult=await sb.rpc('detalle_solicitud_prestamo',{p_solicitud_id:id});
    }

    if(!stillCurrent())return;
    if(detailResult.error)throw detailResult.error;

    const rawDetailRows=(detailResult.data||[]).map(x=>({...x}));

    // En espera de devolución requiere las marcas vigentes antes de habilitar acciones.
    if(!isCoordinator() && currentHeaderState==='EN ESPERA DE DEVOLUCIÓN'){
      await crossPromise;
      if(!stillCurrent())return;
    }

    requestDetailRows=isCoordinator()
      ?rawDetailRows
      :annotateCrossAreaWaitDetail(rawDetailRows,id);

    const rowsForAccumulated=requestDetailRows;

    if(hasFullAccess() && !isCoordinator()){
      requestDetailRows
        .filter(x=>(x.estado_item==='ACEPTADO' && !x._cross_wait) || x.estado_item==='DEVOLUCIÓN SOLICITADA')
        .forEach(x=>requestSelectedIds.add(x.expediente_id));
    }

    // Respaldo no bloqueante: si por RLS no llegó la cabecera puntual,
    // el detalle se muestra ya y la bandeja se actualiza después.
    if(!currentRequest){
      currentRequest={id,estado:'',estado_atencion:'',total_expedientes:rawDetailRows.length};
      loadRequests().then(()=>{
        if(!stillCurrent()||currentRequestId!==id)return;
        const fresh=requestRows.find(x=>x.id===id)||requestViewCache?.rows?.find(x=>x.id===id)||null;
        if(fresh){
          currentRequest=fresh;
          requestDetailPaintHeaderV653(currentRequest,requestDetailRows);
          renderRequestActions();
        }
      }).catch(error=>console.warn('V653 · respaldo de cabecera:',error?.message||error));
    }

    currentRequest=
      enrichRequestsWithCrossAreaWait([currentRequest||{}])[0]||
      currentRequest||{};

    const hasActiveCrossWait=(requestDetailRows||[]).some(x=>!!x._cross_wait);
    const hasAcceptedPendingItem=(requestDetailRows||[]).some(x=>
      ['ACEPTADO','PENDIENTE POR ATENDER'].includes(norm(x.estado_item||'')) &&
      !x._cross_wait
    );

    if(
      !hasActiveCrossWait &&
      hasAcceptedPendingItem &&
      ['SOLICITADO','ACEPTADO','EN ESPERA DE DEVOLUCIÓN'].includes(
        norm(currentRequest.estado_atencion||currentRequest.estado||'')
      )
    ){
      currentRequest={
        ...currentRequest,
        estado:'ACEPTADO',
        estado_atencion:'PENDIENTE POR ATENDER',
        _cross_wait_count:0,
        _cross_wait_all:false
      };
    }

    requestDetailPaintHeaderV653(currentRequest,requestDetailRows);

    const atiendeActual=String(currentRequest?.atiende_requerimiento||currentRequest?.atiende||'').trim();
    setArchiveStaffValue('rqDAtiende',norm(atiendeActual)==='ARCHIVO'?'':atiendeActual);

    const retornoOpts=[...el('rqDRetorno').options].map(o=>o.value);
    const archivo=retornoOpts.find(x=>norm(x).includes('ARCHIVO'));
    if(archivo)el('rqDRetorno').value=archivo;

    // V653 · este es el primer punto en que las acciones quedan habilitadas.
    renderRequestDetailItems();
    if(isCoordinator())renderRequestMovements();
    renderRequestActions();
    loadLocationDetail();

    if(hasFullAccess() && !isCoordinator()){
      setTimeout(forceEnableRequestAttendant,0);
      setTimeout(forceEnableRequestAttendant,120);
    }

    modal.setAttribute('aria-busy','false');

    requestDetailCacheSetV358(id,{
      header:{...(currentRequest||{})},
      rows:rawDetailRows.map(x=>({...x})),
      movements:(requestMovementRows||[]).map(x=>({...x}))
    });

    // Responsables: completar sin bloquear la ventana.
    profilesPromise.then(()=>{
      if(!stillCurrent() || currentRequestId!==id)return;
      try{
        fillSelects();
        renderRequestActions();
        setTimeout(forceEnableRequestAttendant,0);
      }catch(error){
        console.warn('V653 · completar responsables:',error?.message||error);
      }
    });

    // Esperas entre áreas: refrescar marcas y acciones cuando llegue el dato.
    if(!isCoordinator() && currentHeaderState!=='EN ESPERA DE DEVOLUCIÓN'){
      crossPromise.then(()=>{
        if(!stillCurrent() || currentRequestId!==id)return;
        requestDetailRows=annotateCrossAreaWaitDetail(rawDetailRows,id);
        renderRequestDetailItems();
        renderRequestActions();
      });
    }

    // Acumulados y reiteraciones siguen cargando en segundo plano.
    enrichAccumulatedRowsInPlace(rowsForAccumulated)
      .then(()=>{
        if(stillCurrent() && currentRequestId===id && el('requestDetailModal')?.classList.contains('show')){
          renderRequestDetailItems();
        }
      })
      .catch(err=>console.warn('Acumulados de solicitud:',err?.message||err));


    // Evita warning de promesa no observada; la actualización ocurre dentro del then.
    if(movementPromise)void movementPromise;
    if(archiveProfilesPromise)void archiveProfilesPromise;
    if(reiterationPromise)void reiterationPromise;

  }catch(error){
    if(stillCurrent()){
      el('rqDetailTitle').textContent='No se pudo cargar la solicitud';
      el('rqDetailMeta').textContent=error?.message||'Error de conexión.';
      if(el('rqDetailItems'))el('rqDetailItems').innerHTML='<div class="empty">No se pudo cargar el detalle. Cierre la ventana y vuelva a intentarlo.</div>';
      if(el('rqWorkflowActions'))el('rqWorkflowActions').innerHTML='';
    }
  }finally{
    if(stillCurrent())modal.setAttribute('aria-busy','false');
  }
}

function closeRequestDetail(){
  ++requestDetailLoadSeq;
  el('requestDetailModal').classList.remove('detail-loading');
  el('requestDetailModal').setAttribute('aria-busy','false');
  el('requestDetailModal').classList.remove('show');
  currentRequestId='';
  currentRequest=null;
  requestSelectedIds.clear();
  activeArchiveDeliveryRequestId='';
}

function toggleRequestItem(id,checked){
  if(checked)requestSelectedIds.add(id);else requestSelectedIds.delete(id);
  renderRequestDetailItems();
  syncUserReturnButtonState();
  v752RenderDetailSubjectRows();
}

function toggleAllRequestItems(checked){
  // Seleccionar todos los expedientes que realmente pueden gestionarse
  // en la etapa actual (cargo, préstamo, devolución, etc.).
  requestDetailRows
    .filter(x=>requestItemSelectable(x))
    .forEach(x=>checked?requestSelectedIds.add(x.expediente_id):requestSelectedIds.delete(x.expediente_id));
  renderRequestDetailItems();
  syncUserReturnButtonState();
  v752RenderDetailSubjectRows();
}

function requestItemCanAssignCargo(x){
  return hasFullAccess() && x.estado_item==='ACEPTADO' && !x._cross_wait;
}
function requestItemCanConfirmDelivery(x){
  return hasFullAccess() && x.estado_item==='CARGO GENERADO';
}

function requestItemCanReassign(x){
  if(x.estado_item!=='EN PRÉSTAMO')return false;

  // V290: el COORDINADOR en su espacio PERSONAL opera como usuario,
  // pero únicamente sobre expedientes que estén bajo su propia custodia.
  if(isCoordinatorSelfWorkspaceV206()){
    const mine=currentProfile?.nombre_personal||'';
    return !!mine && norm(x.responsable_actual||x.ubicacion_actual||'')===norm(mine);
  }

  if(hasFullAccess())return true;

  const mine=currentProfile?.nombre_personal||'';
  return !!mine && norm(x.responsable_actual||x.ubicacion_actual||'')===norm(mine);
}

function requestItemCanRequestReturn(x){
  if(x.estado_item!=='EN PRÉSTAMO')return false;

  // V290: mismo límite para devolución del coordinador en espacio PERSONAL.
  if(isCoordinatorSelfWorkspaceV206()){
    const mine=currentProfile?.nombre_personal||'';
    return !!mine && norm(x.responsable_actual||x.ubicacion_actual||'')===norm(mine);
  }

  if(hasFullAccess())return true;

  const mine=currentProfile?.nombre_personal||'';
  return !!mine && norm(x.responsable_actual||x.ubicacion_actual||'')===norm(mine);
}

function requestItemCanConfirmReturn(x){
  return hasFullAccess() && x.estado_item==='DEVOLUCIÓN SOLICITADA';
}

function requestItemCanAdminClose(x){
  if(!isAdmin() || !x)return false;
  const state=norm(x.estado_item||'');
  return [
    'SOLICITADO',
    'ACEPTADO',
    'PENDIENTE POR ATENDER'
  ].includes(state);
}

function requestItemCanManageArchiveDelivery(x){
  if(!isLimitedUser() || !activeArchiveDeliveryRequestId)return false;
  if(!isArchiveRequestedReturnItem(x))return false;
  if(x.estado_item!=='EN PRÉSTAMO')return false;

  const mine=currentProfile?.nombre_personal||'';
  return !!mine && norm(x.responsable_actual||x.ubicacion_actual||'')===norm(mine);
}

function requestItemSelectable(x){
  // V290: en su espacio PERSONAL, el COORDINADOR conserva las mismas
  // acciones operativas del usuario sobre SU PROPIA custodia, no las de Archivo.
  if(isCoordinatorSelfWorkspaceV206()){
    if(activeArchiveDeliveryRequestId){
      return requestItemCanManageArchiveDelivery(x);
    }
    return requestItemCanReassign(x) || requestItemCanRequestReturn(x);
  }

  if(hasFullAccess()){
    return requestItemCanAssignCargo(x) ||
      requestItemCanConfirmDelivery(x) ||
      requestItemCanReassign(x) ||
      requestItemCanConfirmReturn(x) ||
      requestItemCanAdminClose(x);
  }

  // Si Archivo solicitó específicamente el expediente, esta pantalla
  // se limita a ese expediente, pero permite REASIGNAR o DEVOLVER.
  if(activeArchiveDeliveryRequestId){
    return requestItemCanManageArchiveDelivery(x);
  }

  return requestItemCanReassign(x) || requestItemCanRequestReturn(x);
}

function updateRequestDetailCargoObservation(expedienteId,value){
  const row=(requestDetailRows||[]).find(x=>String(x.expediente_id)===String(expedienteId));
  if(row)row._cargo_observacion=String(value||'');
}

function v676RequestDetailObservationItems(expedienteIds){
  const wanted=new Set((expedienteIds||[]).map(String));
  return (requestDetailRows||[])
    .filter(r=>wanted.has(String(r.expediente_id||'')))
    .map(r=>({
      expediente_id:String(r.expediente_id||''),
      observacion:String(r._cargo_observacion||'').trim()||null
    }));
}



function v705RequestAccumulatedUnderPrincipalHtml(row){
  const principalId=accumulatedPrincipalId(row);
  const requestId=String(currentRequestId||'').trim();

  const all=(Array.isArray(row?._acumulados)
    ?row._acumulados.slice()
    :accumulatedRowsForPrincipal(principalId).slice()
  )
  // V706 · En Gestionar solicitud solo interesan los acumulados
  // vinculados expresamente al ciclo que está abierto.
  .filter(a=>String(a?.solicitud_id||'').trim()===requestId)
  .sort((a,b)=>String(a?.numero_acumulado||'').localeCompare(
    String(b?.numero_acumulado||''),
    'es',
    {numeric:true,sensitivity:'base'}
  ));

  if(!all.length)return '';

  const count=all.length;
  const label=count===1?'1 acumulado':`${count} acumulados`;

  return `<div class="v706-request-accumulated">
    <button type="button"
            class="v706-accumulated-toggle"
            data-label="${esc(label)}"
            aria-expanded="false"
            onclick="v706ToggleAccumulated(this)">
      ${esc(label)} ▾
    </button>
    <div class="v706-request-accumulated-list" hidden>
      ${all.map(a=>`
        <div class="v706-request-accumulated-item">
          <span class="v706-request-accumulated-arrow">↳</span>
          <span class="v706-request-accumulated-number">${esc(a?.numero_acumulado||'—')}</span>
        </div>
      `).join('')}
    </div>
  </div>`;
}

function v706ToggleAccumulated(button){
  const list=button?.nextElementSibling;
  if(!list)return;

  const open=list.hasAttribute('hidden');

  if(open)list.removeAttribute('hidden');
  else list.setAttribute('hidden','');

  button.setAttribute('aria-expanded',open?'true':'false');

  const label=String(button.dataset.label||'Acumulados');
  button.textContent=label+(open?' ▴':' ▾');
}

window.v706ToggleAccumulated=v706ToggleAccumulated;

function v704SelectedPrincipalRow(){
  const ids=[...requestSelectedIds].map(String);
  if(ids.length!==1)return null;

  return (requestDetailRows||[]).find(
    r=>String(r?.expediente_id||'')===ids[0]
  )||null;
}

function syncV704AccumulatedSelectedButton(){
  const btn=el('v704AccumulatedSelectedBtn');
  if(!btn)return;

  const row=v704SelectedPrincipalRow();
  const allowed=!!row && requestCanManageAccumulated(row);

  btn.disabled=!allowed;

  if(!row){
    btn.title=requestSelectedIds.size>1
      ?'Seleccione únicamente un expediente principal.'
      :'Seleccione un expediente principal.';
  }else if(!allowed){
    btn.title='El expediente seleccionado no está en una etapa que permita gestionar acumulados.';
  }else{
    btn.title=`Vincular acumulados a ${row.expediente||'este expediente'} dentro de la solicitud actual.`;
  }
}

async function openSelectedAccumulatedV704(){
  if(!hasFullAccess()){
    alert('Solo ARCHIVO o ADMINISTRADOR puede gestionar expedientes acumulados.');
    return;
  }

  const row=v704SelectedPrincipalRow();

  if(!row){
    if(el('rqActionStatus')){
      el('rqActionStatus').textContent=requestSelectedIds.size>1
        ?'Para vincular acumulados, seleccione únicamente un expediente principal.'
        :'Seleccione un expediente principal para vincular sus acumulados.';
    }
    return;
  }

  if(!requestCanManageAccumulated(row)){
    if(el('rqActionStatus')){
      el('rqActionStatus').textContent='El expediente seleccionado no está en una etapa que permita gestionar acumulados.';
    }
    return;
  }

  await openAccumulatedModal(
    row.expediente_id,
    currentRequestId||'',
    row.expediente||'',
    row.extension||''
  );
}

window.openSelectedAccumulatedV704=openSelectedAccumulatedV704;

function renderRequestDetailItems(){
  const data=requestDetailRows||[];
  // V788: La opción de regularización es independiente de la selección masiva.
  const v788Entry=el('v788Entry');
  if(v788Entry)v788Entry.hidden=!(isAdmin()&&data.some(x=>x?.expediente_id));
  const selectableRows=data.filter(x=>requestItemSelectable(x));
  const showAttentionObservation=hasFullAccess() && data.some(x=>x.estado_item==='ACEPTADO');
  const allChecked=selectableRows.length>0 &&
    selectableRows.every(x=>requestSelectedIds.has(x.expediente_id));

  el('rqDSelectedCount').textContent=requestSelectedIds.size+
    ' seleccionado'+(requestSelectedIds.size===1?'':'s');
  if(typeof window.v801SyncNumberButton==='function')window.v801SyncNumberButton();

  if(!data.length){
    el('rqDetailItems').innerHTML='<div class="empty">No hay expedientes.</div>';
    return;
  }

  el('rqDetailItems').innerHTML=`<table>
    <thead><tr>
      <th><input type="checkbox" ${selectableRows.length?'':'disabled'} ${allChecked?'checked':''} onchange="toggleAllRequestItems(this.checked)"></th>
      <th>Expediente</th><th>Ext.</th><th>${isLimitedUser()?'R.D. (opcional)':'R.D.'}</th><th>${isLimitedUser()?'Último folio *':'Último folio'}</th>${showAttentionObservation?'<th>Observación del expediente</th>':''}<th>Estado solicitud</th><th>Modalidad actual</th><th>Estado físico</th>
      <th>Responsable actual</th><th>Cargo</th><th>F. entrega préstamo</th><th>F. sol. devolución</th><th>F. devolución</th>
    </tr></thead>
    <tbody>${data.map(x=>{
      const selectable=requestItemSelectable(x);
      return `<tr class="${selectable?'row-click-select ':''}${requestSelectedIds.has(x.expediente_id)?'record-selected-row':''}" ${selectable?`onclick="toggleRequestItemFromRow(event,'${x.expediente_id}',true)" title="Clic en la fila para seleccionar o deseleccionar"`:''}>
        <td><input type="checkbox" ${selectable?'':'disabled'}
          ${requestSelectedIds.has(x.expediente_id)?'checked':''}
          onchange="toggleRequestItem('${x.expediente_id}',this.checked)"></td>
        <td>
          <div class="v705-request-principal">
            <b>${esc(x.expediente)}</b>
            <span class="v704-exp-role principal">PRINCIPAL</span>
          </div>
          ${v705RequestAccumulatedUnderPrincipalHtml(x)}
        </td>
        <td>${hasFullAccess() && x.estado_item==='ACEPTADO'
          ?`<input class="request-item-edit extension"
                   value="${esc(x.extension||'')}"
                   placeholder="Ext."
                   oninput="updateRequestDetailPendingField('${x.expediente_id}','extension',this.value)">`
          :(x.extension?esc(x.extension):'—')}</td>
        <td>${hasFullAccess() && x.estado_item==='ACEPTADO'
          ?`<input class="request-item-edit rd"
                   value="${esc(x.rd||'')}"
                   placeholder="R.D."
                   oninput="updateRequestDetailPendingField('${x.expediente_id}','rd',this.value)">`
          :(isLimitedUser() && (requestItemCanRequestReturn(x)||requestItemCanManageArchiveDelivery(x)) && isArchiveRequestedReturnItem(x)
            ?`<input class="request-item-edit rd user-return-rd"
                     data-user-rd-id="${x.expediente_id}"
                     value="${esc(x.rd||'')}"
                     placeholder="R.D. (opcional)"
                     title="Puede actualizar la R.D. antes de efectuar la devolución"
                     oninput="updateUserCustodyReturnField('${x.expediente_id}','rd',this.value)">`
            :esc(x.rd||'—'))}</td>
        <td>${hasFullAccess() && x.estado_item==='ACEPTADO'
          ?`<input class="request-item-edit folio"
                   value="${esc(x.ultimo_folio||'')}"
                   placeholder="Último folio"
                   oninput="updateRequestDetailPendingField('${x.expediente_id}','ultimo_folio',this.value)">`
          :(isLimitedUser() && isArchiveRequestedReturnItem(x) && (requestItemCanReassign(x)||requestItemCanRequestReturn(x)||requestItemCanManageArchiveDelivery(x))
            ?`<input class="request-item-edit folio user-required-folio"
                     data-user-folio-id="${x.expediente_id}"
                     value="${esc(x.ultimo_folio||'')}"
                     placeholder="Último folio *"
                     title="Dato obligatorio antes de reasignar o efectuar devolución"
                     oninput="updateUserCustodyReturnField('${x.expediente_id}','ultimo_folio',this.value)">`
            :esc(x.ultimo_folio||'—'))}</td>
        ${showAttentionObservation?`<td>${x.estado_item==='ACEPTADO'
          ?`<textarea class="cargo-item-observation" style="min-width:170px;min-height:44px"
                     placeholder="Observación solo para este expediente"
                     oninput="updateRequestDetailCargoObservation('${x.expediente_id}',this.value)">${esc(x._cargo_observacion||'')}</textarea>`
          :'—'}</td>`:''}
        <td>${activeArchiveDeliveryRequestId && isArchiveRequestedReturnItem(x)
          ?'<span class="req-state req-devolucion-solicitada">SOLICITADO POR EL ARCHIVO</span>'
          :(x._cross_wait
            ?`<span class="req-state req-wait-return">EN ESPERA DE DEVOLUCIÓN</span>
              <span class="cross-area-wait-note">
                Con ${esc(x._cross_wait.responsable_actual||'OTRO USUARIO')}
                ${x._cross_wait.area_actual?' · '+esc(x._cross_wait.area_actual):''}
              </span>`
            :reqStatePill(x.estado_item))}</td>
        <td>${typeof v710ModalityBadge==='function'
          ?v710ModalityBadge(x.modalidad_atencion||x.modalidad_actual||currentRequest?.modalidad||'PRÉSTAMO')
          :esc(x.modalidad_atencion||x.modalidad_actual||currentRequest?.modalidad||'PRÉSTAMO')}</td>
        <td>${esc(x.estado_fisico||'')}</td>
        <td>${esc(requestEffectiveCurrentResponsible(x))}</td>
        <td><b>${esc(x.cargo_numero||'—')}</b></td>
        <td>${fmtDate(x.fecha_entrega)}</td>
        <td>
          ${x.fecha_solicitud_devolucion
            ?masterDateTimeHtml(x.fecha_solicitud_devolucion)
            :'—'
          }
        </td>
        <td>${fmtDate(x.fecha_devolucion)}</td>
      </tr>`;
    }).join('')}</tbody>
  </table>`;

  queueMicrotask(syncV704AccumulatedSelectedButton);
}

function toggleAllRequestItems(checked){
  requestDetailRows
    .filter(x=>requestItemSelectable(x))
    .forEach(x=>checked
      ?requestSelectedIds.add(x.expediente_id)
      :requestSelectedIds.delete(x.expediente_id));
  renderRequestDetailItems();
  syncUserReturnButtonState();
}
function updateRequestDetailPendingField(expedienteId,field,value){
  const row=(requestDetailRows||[]).find(x=>String(x.expediente_id)===String(expedienteId));
  if(!row || row.estado_item!=='ACEPTADO')return;
  if(!['extension','rd','ultimo_folio'].includes(field))return;
  row[field]=value;
}

function updateUserCustodyReturnField(expedienteId,field,value){
  const row=(requestDetailRows||[]).find(x=>String(x.expediente_id)===String(expedienteId));
  if(!row || !isLimitedUser())return;
  if(!requestItemCanReassign(row) && !requestItemCanRequestReturn(row) && !requestItemCanManageArchiveDelivery(row))return;
  if(!['rd','ultimo_folio'].includes(field))return;
  row[field]=value;
  syncUserReturnButtonState();
}

function updateUserCustodyFolioField(expedienteId,value){
  updateUserCustodyReturnField(expedienteId,'ultimo_folio',value);
}

function userReturnSelectionReady(){
  if(!isLimitedUser())return false;
  const ids=[...requestSelectedIds];
  if(!ids.length)return false;
  const rows=(requestDetailRows||[]).filter(x=>ids.includes(x.expediente_id));
  if(!rows.length)return false;

  if(activeArchiveDeliveryRequestId){
    const req=currentArchiveDeliveryRequest();
    if(!req || ids.length!==1 || String(ids[0])!==String(req.expediente_id))return false;
    if(rows.some(x=>!requestItemCanManageArchiveDelivery(x)))return false;
  }else if(rows.some(x=>!requestItemCanRequestReturn(x))){
    return false;
  }

  return rows.every(x=>String(x.ultimo_folio||'').trim());
}

function syncUserReturnButtonState(){
  const ready=userReturnSelectionReady();

  const btn=el('btnEffectReturn');
  if(btn){
    btn.disabled=!ready;
    btn.title=ready
      ?'Devolver el expediente y dejarlo pendiente de recepción por Archivo'
      :'Ingrese el Último folio obligatorio para habilitar Devolver';
  }

  const reassignBtn=el('btnEffectReassign');
  if(reassignBtn){
    const nuevo=String(el('rqDNuevoResponsable')?.value||'').trim();
    // El requisito para habilitar la acción es haber verificado/ingresado el folio.
    // El nuevo responsable se valida al pulsar Reasignar, para evitar un botón
    // aparentemente bloqueado aunque el usuario ya haya cumplido el requisito del folio.
    reassignBtn.disabled=!ready;
    reassignBtn.title=!ready
      ?'Ingrese el Último folio obligatorio para habilitar Reasignar'
      :(!nuevo?'Pulse Reasignar y seleccione el nuevo responsable':'Reasignar el expediente al nuevo responsable');
  }
}

async function saveUserReturnDataBeforeReturn(expedienteIds){
  if(!isLimitedUser())return true;

  const ids=[...new Set((expedienteIds||[]).filter(Boolean))];
  if(!ids.length)return true;

  const rows=(requestDetailRows||[]).filter(x=>ids.includes(x.expediente_id));
  const missing=rows.filter(x=>!String(x.ultimo_folio||'').trim());

  if(missing.length){
    const names=missing.map(x=>x.expediente).filter(Boolean).join(', ');
    if(el('rqActionStatus')){
      el('rqActionStatus').textContent=`Último folio obligatorio. Ingrese el dato antes de efectuar la devolución${names?' para: '+names:''}.`;
    }
    document.querySelector(`[data-user-folio-id="${missing[0]?.expediente_id||''}"]`)?.focus();
    syncUserReturnButtonState();
    return false;
  }

  if(el('rqActionStatus')){
    el('rqActionStatus').textContent='Guardando R.D. y Último folio antes de la devolución...';
  }

  const {data,error}=await sb.rpc('actualizar_datos_devolucion_mi_custodia',{
    p_solicitud_id:currentRequestId,
    p_items:rows.map(x=>({
      id:x.expediente_id,
      rd:String(x.rd||'').trim()||null,
      ultimo_folio:String(x.ultimo_folio||'').trim()
    }))
  });

  if(error){
    if(el('rqActionStatus'))el('rqActionStatus').textContent=error.message;
    return false;
  }

  if(el('rqActionStatus')){
    el('rqActionStatus').textContent=`Datos verificados para ${Number(data?.actualizados||rows.length)} expediente(s). Registrando devolución...`;
  }
  return true;
}

async function saveRequiredUserFoliosBeforeMovement(expedienteIds){
  if(!isLimitedUser())return true;

  const ids=[...new Set((expedienteIds||[]).filter(Boolean))];
  if(!ids.length)return true;

  const rows=(requestDetailRows||[]).filter(x=>ids.includes(x.expediente_id));

  const missing=rows.filter(x=>!String(x.ultimo_folio||'').trim());
  if(missing.length){
    const names=missing.map(x=>x.expediente).filter(Boolean).join(', ');
    if(el('rqActionStatus')){
      el('rqActionStatus').textContent=`Último folio obligatorio. Complete el dato antes de continuar${names?' para: '+names:''}.`;
    }
    const first=missing[0];
    document.querySelector(`[data-user-folio-id="${first?.expediente_id||''}"]`)?.focus();
    return false;
  }

  if(el('rqActionStatus')){
    el('rqActionStatus').textContent='Registrando Último folio antes del movimiento...';
  }

  const {data,error}=await sb.rpc('actualizar_ultimos_folios_mi_custodia',{
    p_solicitud_id:currentRequestId,
    p_items:rows.map(x=>({
      id:x.expediente_id,
      ultimo_folio:String(x.ultimo_folio||'').trim()
    }))
  });

  if(error){
    if(el('rqActionStatus'))el('rqActionStatus').textContent=error.message;
    return false;
  }

  if(el('rqActionStatus')){
    el('rqActionStatus').textContent=`Último folio registrado para ${Number(data?.actualizados||rows.length)} expediente(s).`;
  }

  return true;
}

async function savePendingRequestDetailData(silent=false){
  if(!hasFullAccess())return false;

  const pending=(requestDetailRows||[])
    .filter(x=>x.estado_item==='ACEPTADO')
    .map(x=>({
      id:x.expediente_id,
      expediente:x.expediente,
      extension:x.extension||null,
      rd:x.rd||null,
      ultimo_folio:x.ultimo_folio||null
    }));

  if(!pending.length){
    if(!silent && el('rqActionStatus')){
      el('rqActionStatus').textContent='No hay expedientes pendientes por atender para actualizar.';
    }
    return true;
  }

  if(!currentRequestId){
    if(el('rqActionStatus'))el('rqActionStatus').textContent='No se pudo identificar la solicitud.';
    return false;
  }

  if(el('rqActionStatus'))el('rqActionStatus').textContent='Guardando Extensión, R.D. y Último folio...';

  const {data,error}=await sb.rpc('actualizar_datos_pendientes_solicitud',{
    p_solicitud_id:currentRequestId,
    p_items:pending
  });

  if(error){
    if(el('rqActionStatus'))el('rqActionStatus').textContent=error.message;
    return false;
  }

  if(!silent){
    showToast(`${Number(data?.actualizados||0)} expediente(s) actualizado(s)`);
    await Promise.all([loadStates(),loadAll(),loadHistory()]);
    await refreshRequestDetail();
  }else if(el('rqActionStatus')){
    el('rqActionStatus').textContent='Datos guardados. Generando cargo...';
  }

  return true;
}

function renderRequestMovements(){
  if(!requestMovementRows.length){
    el('rqMovements').innerHTML='<div class="empty">Sin movimientos registrados.</div>';
    return;
  }

  el('rqMovements').innerHTML=`<table>
    <thead><tr><th>Fecha / hora</th><th>Expediente</th><th>Acción</th><th>Desde</th><th>Hacia</th><th>Estado</th><th>Cargo</th><th>Observación</th></tr></thead>
    <tbody>${requestMovementRows.map(m=>`<tr>
      <td><div class="datetime-cell"><span class="datetime-date">${fmtDate(m.created_at)}</span><span class="datetime-time">${fmtTime(m.created_at)}</span></div></td>
      <td>${esc(m.expediente||'')}</td>
      <td>${esc(movementActionDisplay(m.accion))}</td>
      <td>${esc(m.desde||'')}</td>
      <td>${esc(m.hacia||'')}</td>
      <td>${esc(requestStateDisplayName(stateDisplayName(m.estado||'')))}</td>
      <td>${esc(m.cargo_numero||'')}</td>
      <td>${esc(m.observacion||'')}</td>
    </tr>`).join('')}</tbody>
  </table>`;
}

function forceEnableRequestAttendant(){
  const s=el('rqDAtiende');
  if(!s)return;

  // Solo Archivo/Administrador puede definir quién atiende; la persona seleccionada debe pertenecer a Archivo.
  if(hasFullAccess()){
    const current=String(s.value||currentRequest?.atiende||'').trim();
    fillArchiveStaffSelect('rqDAtiende');
    s.disabled=false;
    s.removeAttribute('disabled');
    s.style.pointerEvents='auto';
    s.style.opacity='1';
    s.tabIndex=0;

    // Conservar el valor previamente asignado si existe.
    if(current){
      const opt=[...s.options].find(o=>norm(o.value)===norm(current));
      if(opt)s.value=opt.value;
    }
  }else{
    s.disabled=true;
  }
}

let adminCloseMode='';
let adminCloseIds=[];

function adminClosableRows(){
  return (requestDetailRows||[]).filter(x=>requestItemCanAdminClose(x));
}

function openAdminCloseItemsModal(){
  if(!isAdmin())return;

  const ids=[...requestSelectedIds];
  if(!ids.length){
    el('rqActionStatus').textContent='Seleccione uno o más expedientes pendientes para cerrar.';
    return;
  }

  const selected=(requestDetailRows||[]).filter(x=>ids.includes(x.expediente_id));
  const invalid=selected.filter(x=>!requestItemCanAdminClose(x));
  if(invalid.length){
    el('rqActionStatus').textContent='Para cerrar administrativamente, seleccione únicamente expedientes que todavía no hayan sido entregados o prestados.';
    return;
  }

  adminCloseMode='ITEMS';
  adminCloseIds=selected.map(x=>x.expediente_id);
  el('adminCloseTitle').textContent=`Cierre administrativo · ${selected.length} expediente${selected.length===1?'':'s'} seleccionado${selected.length===1?'':'s'}`;
  el('adminCloseNote').textContent=`Solicitud ${currentRequest?.numero||''} · El registro continuará visible en el historial.`;
  el('adminCloseSummary').innerHTML=selected.map(x=>
    `<div><b>${esc(x.expediente||'')}</b> · Estado actual: ${esc(requestStateDisplayName(x.estado_item||''))}</div>`
  ).join('');
  el('adminCloseReasonType').value='';
  el('adminCloseReasonDetail').value='';
  el('adminCloseStatus').textContent='';
  el('adminCloseSubmitBtn').disabled=false;
  el('adminCloseModal').classList.add('show');
}

function openAdminCloseRequestModal(){
  if(!isAdmin())return;

  const rows=requestDetailRows||[];
  if(!rows.length){
    el('rqActionStatus').textContent='La solicitud no contiene expedientes.';
    return;
  }

  const invalid=rows.filter(x=>!requestItemCanAdminClose(x));
  if(invalid.length){
    const examples=invalid.slice(0,3).map(x=>`${x.expediente} (${requestStateDisplayName(x.estado_item||'')})`).join(', ');
    el('rqActionStatus').textContent=`No se puede cerrar la solicitud completa porque ${invalid.length} expediente(s) ya avanzaron en el flujo${examples?' · '+examples:''}. Puede cerrar únicamente los expedientes pendientes seleccionándolos.`;
    return;
  }

  adminCloseMode='REQUEST';
  adminCloseIds=[];
  el('adminCloseTitle').textContent='Cierre administrativo · solicitud completa';
  el('adminCloseNote').textContent=`Solicitud ${currentRequest?.numero||''} · ${rows.length} expediente${rows.length===1?'':'s'} quedarán CERRADOS POR ADMINISTRADOR.`;
  el('adminCloseSummary').innerHTML=rows.map(x=>
    `<div><b>${esc(x.expediente||'')}</b> · Estado actual: ${esc(requestStateDisplayName(x.estado_item||''))}</div>`
  ).join('');
  el('adminCloseReasonType').value='';
  el('adminCloseReasonDetail').value='';
  el('adminCloseStatus').textContent='';
  el('adminCloseSubmitBtn').disabled=false;
  el('adminCloseModal').classList.add('show');
}

function closeAdminCloseModal(){
  el('adminCloseModal')?.classList.remove('show');
  adminCloseMode='';
  adminCloseIds=[];
}

function adminCloseReason(){
  const type=String(el('adminCloseReasonType')?.value||'').trim();
  const detail=String(el('adminCloseReasonDetail')?.value||'').trim();
  if(!type)return '';
  if(type==='OTRO')return detail?`OTRO: ${detail}`:'';
  return detail?`${type}: ${detail}`:type;
}

async function submitAdminClose(){
  if(!isAdmin())return;

  const reason=adminCloseReason();
  const status=el('adminCloseStatus');
  const btn=el('adminCloseSubmitBtn');

  if(!reason){
    status.textContent=String(el('adminCloseReasonType')?.value||'')==='OTRO'
      ?'Ingrese el detalle del motivo OTRO.'
      :'Seleccione el motivo del cierre.';
    return;
  }
  if(!currentRequestId){
    status.textContent='No se pudo identificar la solicitud.';
    return;
  }

  btn.disabled=true;
  status.textContent='Registrando cierre administrativo...';

  try{
    let result;
    if(adminCloseMode==='ITEMS'){
      if(!adminCloseIds.length){
        status.textContent='No hay expedientes seleccionados.';
        return;
      }
      result=await sb.rpc('cerrar_expedientes_solicitud_admin',{
        p_solicitud_id:currentRequestId,
        p_expediente_ids:adminCloseIds,
        p_motivo:reason
      });
    }else if(adminCloseMode==='REQUEST'){
      result=await sb.rpc('cerrar_solicitud_admin',{
        p_solicitud_id:currentRequestId,
        p_motivo:reason
      });
    }else{
      status.textContent='No se pudo determinar el tipo de cierre.';
      return;
    }

    if(result.error){
      status.textContent=result.error.message;
      return;
    }

    const completedMode=adminCloseMode;
    closeAdminCloseModal();
    requestSelectedIds.clear();
    requestViewCache=null; // V689 · no reutilizar una bandeja previa al cierre.
    showToast(completedMode==='REQUEST'?'Solicitud cerrada por Administrador':'Expediente(s) cerrados por Administrador');

    await Promise.all([
      loadSummary(),loadPanel(),loadAll(),loadStates(),loadRequests(),
      loadRequestsByLawyer(),loadCargos(),loadHistory()
    ]);

    // Forzar recarga de la cabecera de la solicitud después del cierre.
    // Evita conservar en memoria el estado previo (por ejemplo PENDIENTE POR ATENDER).
    currentRequest=null;
    await openRequestDetail(currentRequestId);
  }catch(err){
    status.textContent=err?.message||String(err);
  }finally{
    if(btn)btn.disabled=false;
  }
}

function syncRequestDetailUnifiedSections(){
  const rows=requestDetailRows||[];
  const r=currentRequest||{};

  const pending=rows.some(x=>
    ['ACEPTADO','PENDIENTE POR ATENDER'].includes(norm(x.estado_item||'')) &&
    !x._cross_wait
  );

  const inLoan=rows.some(x=>
    ['EN PRÉSTAMO','REASIGNADO'].includes(norm(x.estado_item||''))
  );

  const returnRequested=rows.some(x=>
    norm(x.estado_item||'')==='DEVOLUCIÓN SOLICITADA'
  );

  const archiveRequested=rows.some(x=>requestItemCanManageArchiveDelivery(x));

  const closed=[
    'DEVUELTO',
    'CERRADA POR ADMINISTRADOR'
  ].includes(norm(r.estado||r.estado_atencion||''));

  const showAttention=
    !closed &&
    hasFullAccess() &&
    !isCoordinator() &&
    pending;

  const showMovement=
    !closed &&
    (
      inLoan ||
      returnRequested ||
      archiveRequested
    );

  const showObservation=
    !closed &&
    (
      showAttention ||
      showMovement
    );

  el('rqAttentionSection')?.classList.toggle('hidden',!showAttention);
  el('rqMovementSection')?.classList.toggle('hidden',!showMovement);
  el('rqObservationSection')?.classList.toggle('hidden',!showObservation);

  // Los campos mantienen la seguridad existente; aquí solo se mejora
  // la organización visual según la etapa actual del ciclo.
  if(el('rqDAtiende')){
    el('rqDAtiende').required=showAttention;
  }
}

function renderRequestActions(){
  const r=currentRequest||{};
  syncRequestDetailUnifiedSections();

  // V609 · Las acciones que operan directamente sobre los expedientes
  // seleccionados se muestran dentro del bloque “Expedientes solicitados”.
  const primaryActions=el('rqItemPrimaryActions');
  if(primaryActions){
    primaryActions.innerHTML='';
    primaryActions.classList.add('hidden');
  }
  const hasMyLoan=requestDetailRows.some(x=>requestItemCanReassign(x));
  const hasArchiveRequestedItem=requestDetailRows.some(x=>requestItemCanManageArchiveDelivery(x));

  const crossWaitReturnItem=requestDetailRows.find(
    x=>x._cross_wait &&
       norm(x._cross_wait.estado)==='DEVOLUCIÓN SOLICITADA'
  );

  const crossWaitPendingItems=requestDetailRows.filter(
    x=>x._cross_wait &&
       norm(x._cross_wait.estado)!=='DEVOLUCIÓN SOLICITADA'
  );

  if(isCoordinatorTeamWorkspaceV206()){
    [
      'rqDAtiende',
      'rqDNuevoResponsable',
      'rqDRetorno',
      'rqDCargoExistente',
      'rqDObservacion'
    ].forEach(id=>{
      if(el(id))el(id).disabled=true;
    });

    // En el espacio EQUIPO el coordinador solo supervisa.
    // No puede reasignar ni devolver expedientes que pertenecen a otro integrante.
    document.querySelectorAll(
      '#requestDetailModal input, #requestDetailModal select, #requestDetailModal textarea'
    ).forEach(control=>{
      control.disabled=true;
    });

    el('rqWorkflowActions').innerHTML=`
      <span class="note v208-coordinator-readonly-note">
        <b>SEGUIMIENTO DEL EQUIPO.</b>
        Puede consultar el estado, expedientes y avance del personal a su cargo,
        pero no puede reasignar ni devolver expedientes cuyo responsable actual sea otro usuario.
      </span>`;

    return;
  }

  if(isLimitedUser()){
    el('rqDAtiende').disabled=true;
    el('rqDRetorno').disabled=true;
    el('rqDCargoExistente').disabled=true;
    el('rqDNuevoResponsable').disabled=false;
    el('rqDObservacion').disabled=false;

    let actions='';

    if(r.estado==='SOLICITADO'){
      actions=`
        <span class="note">
          Solicitud enviada a Archivo. Mientras esté pendiente de atención, queda en solo lectura:
          ya no se puede modificar el asunto, modalidad, observación ni agregar o retirar expedientes.
        </span>`;
    }else if(r.estado==='ACEPTADO'){
      actions='<span class="note">Solicitud pendiente por atender. Ya ingresó a la bandeja de Archivo y todavía no se ha generado el cargo.</span>';
    }

    if(hasArchiveRequestedItem){
      actions += `
        <span class="note"><b>SOLICITADO POR EL ARCHIVO.</b> Actualice la <b>R.D.</b> si corresponde e ingrese obligatoriamente el <b>Último folio</b>. Con el folio registrado se habilitan las acciones. Para <b>Reasignar</b>, seleccione además el nuevo responsable; para <b>Devolver</b>, el expediente quedará pendiente de recepción por Archivo. Si se reasigna, la solicitud de Archivo seguirá activa para el nuevo responsable.</span>
        <button class="btn secondary" id="btnEffectReassign" onclick="userReassignSelectedItems()" disabled>Reasignar</button>
        <button class="btn" id="btnEffectReturn" onclick="requestReturnItems()" disabled>Devolver</button>`;
      setTimeout(syncUserReturnButtonState,0);
    }else if(hasMyLoan){
      actions += `
        <span class="note"><b>Gestionar expediente:</b> ingrese obligatoriamente el <b>Último folio</b>. Puede actualizar la <b>R.D.</b> si corresponde y luego elegir entre <b>Reasignar</b> o <b>Devolver</b>. En perfil Coordinador, estas acciones aplican únicamente a expedientes bajo su propia custodia.</span>
        <button class="btn secondary" id="btnEffectReassign" onclick="userReassignSelectedItems()" disabled>Reasignar</button>
        <button class="btn" id="btnEffectReturn" onclick="requestReturnItems()" disabled>Devolver</button>`;
      setTimeout(syncUserReturnButtonState,0);
    }

    if(r.estado==='DEVUELTO'){
      actions='<span class="note">Solicitud cerrada. Todos los expedientes fueron recibidos por Archivo.</span>';
    }

    el('rqWorkflowActions').innerHTML=actions||'<span class="note">Consulte el estado de la solicitud.</span>';
    return;
  }

  ['rqDAtiende','rqDNuevoResponsable','rqDRetorno','rqDCargoExistente','rqDObservacion'].forEach(id=>{
    if(el(id))el(id).disabled=false;
  });
  forceEnableRequestAttendant();

  if(norm(r.estado||r.estado_atencion||'')==='CERRADA POR ADMINISTRADOR'){
    ['rqDAtiende','rqDNuevoResponsable','rqDRetorno','rqDCargoExistente','rqDObservacion'].forEach(id=>{
      if(el(id))el(id).disabled=true;
    });
    el('rqWorkflowActions').innerHTML='<span class="note"><b>CERRADA POR ADMINISTRADOR.</b> La solicitud se conserva únicamente para consulta e historial. El cierre no modifica la custodia física de ningún expediente.</span>';
    return;
  }

  let actions='';

  if(r.estado==='SOLICITADO'){
    if(el('rqDAtiende'))el('rqDAtiende').disabled=false;
    actions=`
      <button class="btn secondary" onclick="openAddItemsToExistingRequest()">+ Agregar expedientes</button>
      <span class="note"><b>Ingreso automático a atención.</b> Esta solicitud no requiere aceptación manual de Archivo. Los expedientes disponibles pasan directamente a PENDIENTE POR ATENDER.</span>`;
  }

  if(crossWaitReturnItem && hasFullAccess()){
    actions += `
      <button class="btn"
              onclick="openCrossAreaReturnAcceptance('${crossWaitReturnItem._cross_wait.espera_id}',this)">
        ✓ Aceptar devolución
      </button>
      <span class="note">
        <b>DEVOLUCIÓN SOLICITADA.</b>
        El responsable actual ya registró la devolución del expediente
        <b>${esc(crossWaitReturnItem.expediente)}</b>.
        Pulse <b>Aceptar devolución</b> cuando Archivo lo haya recibido físicamente.
        Al confirmar la recepción, esta nueva solicitud pasará a
        <b>PENDIENTE POR ATENDER</b>.
      </span>`;
  }else if(crossWaitPendingItems.length && hasFullAccess()){
    actions += `
      <span class="note">
        <b>EN ESPERA DE DEVOLUCIÓN.</b>
        ${crossWaitPendingItems.length} expediente${crossWaitPendingItems.length===1?'':'s'}
        continúa${crossWaitPendingItems.length===1?'':'n'} con otro usuario.
        La opción <b>Aceptar devolución</b> aparecerá cuando el responsable
        registre primero la devolución.
      </span>`;
  }

  const hasPendingAccepted=requestDetailRows.some(x=>x.estado_item==='ACEPTADO' && !x._cross_wait);

  if(hasPendingAccepted){
    if(el('rqDAtiende'))el('rqDAtiende').disabled=false;

    if(primaryActions){
      primaryActions.classList.remove('hidden');
      primaryActions.innerHTML=`
        <span class="request-primary-label">Acciones de los expedientes seleccionados</span>
        <button class="btn secondary"
                id="v704AccumulatedSelectedBtn"
                onclick="openSelectedAccumulatedV704()"
                type="button">
          + Vincular acumulado
        </button>
        <button class="btn secondary"
                onclick="v656DownloadPendingResponseExcel()">
          ⬇ Descargar pendientes Excel
        </button>
        <button class="btn secondary"
                onclick="v656OpenResponseExcelPicker()">
          📊 Cargar respuesta Excel
        </button>
        <input id="v656ResponseExcelFile" type="file" accept=".xlsx,.xls,.csv" style="display:none"
               onchange="v656ImportResponseExcel(this.files&&this.files[0]);this.value=''">
        <button class="btn secondary"
                onclick="savePendingRequestDetailData()">
          Guardar cambios
        </button>
        <button class="btn"
                onclick="assignNewCargoToAccepted()">
          Guardar, generar e imprimir cargo
        </button>
        <button class="btn secondary"
                onclick="assignExistingCargoToAccepted()">
          Vincular a cargo existente
        </button>
        <span class="request-primary-note">
          Estas acciones se aplican únicamente a los expedientes seleccionados en este cuadro.
          Para <b>Vincular acumulado</b>, seleccione un solo expediente PRINCIPAL.
          El acumulado quedará asociado a la misma solicitud, pero no tendrá préstamo, cargo ni custodia independientes.
          Verifique Extensión, R.D., Último folio y quién atiende antes de generar o vincular el cargo.
        </span>`;

      queueMicrotask(syncV704AccumulatedSelectedButton);
    }

    actions += `
      <span class="note">
        <b>PENDIENTE POR ATENDER.</b>
        Las opciones de atención se encuentran dentro del cuadro <b>Expedientes solicitados</b>, junto a las filas seleccionadas.
        El expediente pasa a <b>EN PRÉSTAMO</b> únicamente cuando se registra la entrega correspondiente.
      </span>`;
  }

  const v658PrintableCargoNumbers=[...new Set(
    requestDetailRows
      .filter(x=>x.cargo_numero && ['EN PRÉSTAMO','DEVOLUCIÓN SOLICITADA','DEVUELTO','CARGO GENERADO'].includes(x.estado_item))
      .map(x=>String(x.cargo_numero||'').trim())
      .filter(Boolean)
  )];
  if(v658PrintableCargoNumbers.length){
    const v658CargoLabel=v658PrintableCargoNumbers.length===1
      ?`Imprimir / reimprimir cargo ${esc(v658PrintableCargoNumbers[0])}`
      :'Imprimir / reimprimir cargo';
    actions += `
      <button class="btn secondary" onclick="printCargoFromSelectedRequestItems()">${v658CargoLabel}</button>`;
  }

  if(requestDetailRows.some(x=>x.estado_item==='EN PRÉSTAMO')){
    actions += `
      <button class="btn secondary" onclick="reassignRequestItems()">Reasignar expedientes EN PRÉSTAMO</button>
      <button class="btn" onclick="requestArchiveDeliveryItems()">📁 Solicitar entrega a Archivo</button>
      <span class="note">Para reasignar o solicitar la entrega a Archivo, seleccione uno o más expedientes que ya estén EN PRÉSTAMO. La solicitud de entrega no cambia la custodia hasta que Archivo confirme la recepción.</span>`;
  }else if(hasPendingAccepted){
    actions += `<span class="note">La reasignación se habilitará aquí cuando alguno de los expedientes de esta solicitud ya se encuentre EN PRÉSTAMO.</span>`;
  }

  if(requestDetailRows.some(x=>x.estado_item==='DEVOLUCIÓN SOLICITADA')){
    const pendingReturns=requestDetailRows.filter(
      x=>x.estado_item==='DEVOLUCIÓN SOLICITADA'
    ).length;

    actions += `
      <button class="btn" onclick="confirmReturnItems()">
        ✓ Aceptar devolución${pendingReturns>1?' ('+pendingReturns+')':''}
      </button>
      <span class="note">
        Los expedientes con <b>DEVOLUCIÓN SOLICITADA</b> se seleccionan automáticamente.
        Confirme la ubicación de retorno y pulse el botón para registrar la recepción física.
      </span>`;
  }

  if(isAdmin()){
    const closable=adminClosableRows();
    const allClosable=requestDetailRows.length>0 && closable.length===requestDetailRows.length;
    if(closable.length){
      actions += `
        <button class="btn secondary v717-admin-close-btn" type="button"
          onclick="openAdminCloseItemsModal()"
          title="Cerrar administrativamente solo los expedientes marcados y elegibles">
          Cierre administrativo · seleccionados
        </button>`;
    }
    if(allClosable){
      actions += `
        <button class="btn secondary v717-admin-close-btn" type="button"
          onclick="openAdminCloseRequestModal()"
          title="Cerrar administrativamente todos los expedientes de esta solicitud">
          Cierre administrativo · solicitud completa
        </button>`;
      actions += `
        <button class="btn secondary" onclick="openAdminCancelRequestModalV289()">Cancelar solicitud</button>`;
    }

    if(closable.length){
      actions += `<span class="note"><b>Cierre administrativo (Administrador):</b> seleccione uno o varios expedientes todavía pendientes, o cierre la solicitud completa si todos son elegibles. Se exige motivo y se conserva el historial; no se cambia la custodia física.</span>`;
    }

    if(allClosable){
      actions += `<span class="note"><b>Cancelar solicitud:</b> es una acción distinta del cierre administrativo normal. Conserva la trazabilidad y no elimina la documentación.</span>`;
    }
  }

  if(r.estado==='DEVUELTO'){
    actions='<span class="note">Solicitud cerrada: todos los expedientes fueron recibidos físicamente y devueltos a custodia.</span>';
  }

  el('rqWorkflowActions').innerHTML=actions||'<span class="note">Sin acciones pendientes.</span>';
}
// Aceptación manual eliminada: las solicitudes ingresan automáticamente a atención.

function selectedAcceptedIds(){
  const ids=[...requestSelectedIds];
  return requestDetailRows
    .filter(x=>ids.includes(x.expediente_id) && x.estado_item==='ACEPTADO' && !x._cross_wait)
    .map(x=>x.expediente_id);
}

async function printCargoFromSelectedRequestItems(){
  const ids=[...requestSelectedIds];
  const eligibleRows=requestDetailRows.filter(x=>
    x.cargo_numero &&
    ['EN PRÉSTAMO','DEVOLUCIÓN SOLICITADA','DEVUELTO','CARGO GENERADO'].includes(x.estado_item)
  );

  let rows=requestDetailRows.filter(x=>
    ids.includes(x.expediente_id) && x.cargo_numero
  );

  // V658 · Para reimprimir no es obligatorio marcar el checkbox cuando
  // la solicitud contiene un solo cargo identificable.
  if(!rows.length && !ids.length){
    const allNums=[...new Set(eligibleRows.map(x=>(x.cargo_numero||'').trim()).filter(Boolean))];
    if(allNums.length===1){
      if(el('rqActionStatus'))el('rqActionStatus').textContent=`Preparando reimpresión del Cargo N.° ${allNums[0]}...`;
      await v658ReprintExistingCargoDirect(allNums[0]);
      return;
    }
    if(allNums.length>1){
      if(el('rqActionStatus'))el('rqActionStatus').textContent='Esta solicitud contiene más de un cargo. Seleccione al menos un expediente del cargo que desea reimprimir.';
      return;
    }
  }

  if(!rows.length){
    if(el('rqActionStatus'))el('rqActionStatus').textContent='Seleccione uno o más expedientes que tengan cargo.';
    return;
  }

  const nums=[...new Set(rows.map(x=>(x.cargo_numero||'').trim()).filter(Boolean))];
  if(nums.length!==1){
    if(el('rqActionStatus'))el('rqActionStatus').textContent='Seleccione expedientes pertenecientes a un solo cargo.';
    return;
  }

  await v658ReprintExistingCargoDirect(nums[0]);
}

async function v658ReprintExistingCargoDirect(numero){
  if(!hasFullAccess()){
    if(el('rqActionStatus'))el('rqActionStatus').textContent='Solo Archivo o Administrador puede imprimir cargos.';
    return;
  }

  numero=String(numero||'').trim();
  if(!numero){
    if(el('rqActionStatus'))el('rqActionStatus').textContent='No se encontró un número de cargo para reimprimir.';
    return;
  }

  // Abrir la ventana antes de las consultas para evitar el bloqueo de pop-ups.
  const w=window.open('','_blank','width=980,height=800');
  if(!w){
    if(el('rqActionStatus'))el('rqActionStatus').textContent='El navegador bloqueó la ventana de impresión. Permita ventanas emergentes para este sitio.';
    return;
  }
  w.document.write('<!doctype html><html><body style="font-family:Arial;padding:30px"><p>Preparando reimpresión del cargo...</p></body></html>');

  try{
    const {data:header,error:headerError}=await sb
      .from('cargos')
      .select('*')
      .eq('numero',numero)
      .maybeSingle();
    if(headerError)throw headerError;

    // Para cargos antiguos sin encabezado se conserva el flujo de compatibilidad.
    if(!header){
      try{w.close()}catch(_){ }
      await openExistingCargoForPrint(numero);
      return;
    }

    let ids=[];
    const {data:links,error:linksError}=await sb
      .from('cargo_expedientes')
      .select('expediente_id')
      .eq('cargo_id',header.id);
    if(!linksError && links?.length){
      ids=links.map(x=>x.expediente_id).filter(Boolean);
    }

    if(!ids.length){
      const {data:fallback,error:fallbackError}=await sb
        .from('expedientes')
        .select('id')
        .eq('cargo',numero);
      if(fallbackError)throw fallbackError;
      ids=(fallback||[]).map(x=>x.id).filter(Boolean);
    }

    if(!ids.length)throw new Error(`No se encontraron expedientes vinculados al Cargo N.° ${numero}.`);

    const {data:expedientes,error:expError}=await sb
      .from('expedientes')
      .select('*')
      .in('id',ids)
      .order('expediente');
    if(expError)throw expError;

    const rows=(expedientes||[]).map(r=>({...r,_cargo_observacion:''}));

    // Observaciones individuales: si no estuvieran disponibles, la reimpresión continúa.
    try{
      const {data:obs,error:obsError}=await sb.rpc('listar_observaciones_cargo',{p_numero:numero});
      if(!obsError && Array.isArray(obs)){
        const obsMap=new Map(obs.map(x=>[String(x.expediente_id||''),String(x.observacion||'')]));
        rows.forEach(r=>{r._cargo_observacion=obsMap.get(String(r.id))||'';});
      }
    }catch(err){
      console.warn('V658 observaciones de cargo:',err);
    }

    try{await enrichAccumulatedRowsInPlace(rows);}catch(err){console.warn('V658 acumulados:',err);}

    w.document.open();
    w.document.write(cargoPrintHtml(
      header.numero,
      header.solicitante||'',
      header.asunto||'',
      header.atiende_requerimiento||'',
      header.fecha||new Date().toISOString().slice(0,10),
      header.observacion||'',
      rows
    ));
    w.document.close();

    if(el('rqActionStatus'))el('rqActionStatus').textContent=`Cargo N.° ${numero} preparado para reimpresión. No se generó un nuevo cargo.`;
    showToast(`Cargo N.° ${numero} listo para reimpresión · sin modificar el préstamo ni el correlativo`);
  }catch(err){
    try{w.close()}catch(_){ }
    if(el('rqActionStatus'))el('rqActionStatus').textContent=err?.message||String(err);
  }
}

async function openCargoTypeV651(){
  const modal=el('v651CargoTypeModal');
  if(!modal)return;
  if(el('v651OfficialNext'))el('v651OfficialNext').textContent='Calculando...';
  if(el('v651TestNext'))el('v651TestNext').textContent='Calculando...';
  if(el('v651CargoTypeStatus'))el('v651CargoTypeStatus').textContent='Consultando correlativos disponibles...';
  modal.classList.add('show');
  try{
    const year=new Date().getFullYear();
    const {data,error}=await sb.rpc('v651_previsualizar_cargos_atencion',{p_anio:year});
    if(error)throw error;
    if(el('v651OfficialNext'))el('v651OfficialNext').textContent=data?.proximo_oficial||'—';
    if(el('v651TestNext'))el('v651TestNext').textContent=data?.proximo_prueba||'—';
    if(el('v651CargoTypeStatus')){
      const last=Number(data?.ultimo_fisico||0);
      el('v651CargoTypeStatus').textContent=last
        ?`Último cargo físico configurado: ${String(last).padStart(4,'0')}-${year}. La prueba controlada no modifica ese correlativo.`
        :'La prueba controlada no modifica el correlativo oficial.';
    }
  }catch(error){
    console.warn('V651 previsualización de cargo:',error);
    if(el('v651OfficialNext'))el('v651OfficialNext').textContent='Cargo oficial';
    if(el('v651TestNext'))el('v651TestNext').textContent='Cargo de prueba';
    if(el('v651CargoTypeStatus'))el('v651CargoTypeStatus').textContent='No se pudo previsualizar el número, pero Supabase lo validará al generar el cargo.';
  }
}

function closeCargoTypeV651(){
  el('v651CargoTypeModal')?.classList.remove('show');
}

async function assignNewCargoToAccepted(tipoCargoV651){
  if(!hasFullAccess())return;

  const ids=[...requestSelectedIds];
  const accepted=selectedAcceptedIds();
  const atiende=((el('rqDAtiende')?.value||currentRequest?.atiende||'')).trim();
  const obs=el('rqDObservacion').value.trim();

  if(!ids.length){
    el('rqActionStatus').textContent='Seleccione uno o más expedientes PENDIENTES POR ATENDER.';
    return;
  }

  if(accepted.length!==ids.length){
    el('rqActionStatus').textContent='Para generar un cargo nuevo, seleccione únicamente expedientes PENDIENTES POR ATENDER.';
    return;
  }

  if(!validateArchiveStaffV421(atiende,'rqActionStatus','rqDAtiende'))return;

  const tipo=String(tipoCargoV651||'').trim().toUpperCase();
  if(!['OFICIAL','PRUEBA'].includes(tipo)){
    await openCargoTypeV651();
    return;
  }

  closeCargoTypeV651();

  const saved=await savePendingRequestDetailData(true);
  if(!saved)return;

  el('rqActionStatus').textContent=tipo==='PRUEBA'
    ?'Generando cargo de prueba controlada y registrando préstamo...'
    :'Generando cargo oficial y registrando préstamo...';

  const v676ObsItems=v676RequestDetailObservationItems(accepted);
  const {data,error}=await sb.rpc('v676_generar_cargo_atencion',{
    p_solicitud_id:currentRequestId,
    p_expediente_ids:accepted,
    p_atiende:atiende,
    p_observacion:obs||null,
    p_tipo_cargo:tipo,
    p_observaciones_items:v676ObsItems
  });

  if(error){
    el('rqActionStatus').textContent=error.message;
    return;
  }

  requestSelectedIds.clear();
  const numero=data?.cargo_numero||'';
  const label=data?.es_prueba?'Cargo de prueba':'Cargo';
  showToast(`${label} ${numero} generado · expediente(s) EN PRÉSTAMO`);

  if(numero)await openExistingCargoForPrint(numero);

  await Promise.all([
    loadSummary(),loadPanel(),loadAll(),loadStates(),
    loadRequestsByLawyer(),loadCargos(),loadHistory()
  ]);

  await refreshRequestDetail();
}

async function assignExistingCargoToAccepted(){
  if(!hasFullAccess())return;

  const ids=[...requestSelectedIds];
  const accepted=selectedAcceptedIds();
  const cargo=el('rqDCargoExistente').value.trim();
  const obs=el('rqDObservacion').value.trim();

  if(!ids.length){
    el('rqActionStatus').textContent='Seleccione uno o más expedientes PENDIENTES POR ATENDER.';
    return;
  }

  if(accepted.length!==ids.length){
    el('rqActionStatus').textContent='Para usar un cargo existente, seleccione únicamente expedientes PENDIENTES POR ATENDER.';
    return;
  }

  if(!cargo){
    el('rqActionStatus').textContent='Ingrese el número del cargo existente.';
    el('rqDCargoExistente').focus();
    return;
  }

  el('rqActionStatus').textContent='Vinculando al cargo y registrando préstamo...';

  const v676ObsItems=v676RequestDetailObservationItems(accepted);
  const {data,error}=await sb.rpc('v676_vincular_cargo_atencion',{
    p_solicitud_id:currentRequestId,
    p_expediente_ids:accepted,
    p_cargo_numero:cargo,
    p_observacion:obs||null,
    p_observaciones_items:v676ObsItems
  });

  if(error){
    el('rqActionStatus').textContent=error.message;
    return;
  }

  requestSelectedIds.clear();
  el('rqDCargoExistente').value='';
  showToast(`${accepted.length} expediente(s) vinculados al Cargo ${data?.cargo_numero||cargo} · EN PRÉSTAMO`);
  await openExistingCargoForPrint(data?.cargo_numero||cargo);

  await Promise.all([
    loadSummary(),loadPanel(),loadAll(),loadStates(),
    loadRequestsByLawyer(),loadCargos(),loadHistory()
  ]);

  await refreshRequestDetail();
}

// Compatibilidad visual con llamadas antiguas: ya no existe aceptación manual.
async function verifyAndAttendRequest(){
  if(el('rqActionStatus'))el('rqActionStatus').textContent='La solicitud ya ingresa automáticamente a PENDIENTE POR ATENDER.';
}
async function attendRequest(){ return verifyAndAttendRequest(); }
async function deliverRequest(){
  if(el('rqActionStatus'))el('rqActionStatus').textContent='Seleccione los expedientes pendientes y genere el cargo.';
}

async function userReassignSelectedItems(){
  if(activeArchiveDeliveryRequestId){
    return reassignArchiveRequestedItem();
  }
  return reassignRequestItems();
}

async function reassignArchiveRequestedItem(){
  if(!isLimitedUser())return;

  const req=currentArchiveDeliveryRequest();
  const ids=[...requestSelectedIds];
  const nuevo=String(el('rqDNuevoResponsable')?.value||'').trim();

  if(!req || ids.length!==1 || String(ids[0])!==String(req.expediente_id)){
    el('rqActionStatus').textContent='Seleccione únicamente el expediente solicitado por Archivo.';
    return;
  }

  const row=(requestDetailRows||[]).find(x=>String(x.expediente_id)===String(req.expediente_id));
  if(!row || !requestItemCanManageArchiveDelivery(row)){
    el('rqActionStatus').textContent='Este expediente ya no está disponible para esta gestión.';
    return;
  }

  if(!String(row.ultimo_folio||'').trim()){
    el('rqActionStatus').textContent='Ingrese obligatoriamente el Último folio antes de reasignar.';
    document.querySelector(`[data-user-folio-id="${row.expediente_id}"]`)?.focus();
    return;
  }

  if(!nuevo){
    el('rqActionStatus').textContent='Seleccione el nuevo responsable.';
    el('rqDNuevoResponsable')?.focus();
    return;
  }

  el('rqActionStatus').textContent='Actualizando datos y reasignando expediente...';

  const {data,error}=await sb.rpc('v752_gestionar_archivo_con_asunto',{
    p_asunto:v752DetailSubjects.get(String(req.expediente_id))||null,
    p_solicitud_entrega_id:activeArchiveDeliveryRequestId,
    p_accion:'REASIGNAR',
    p_rd:String(row.rd||'').trim()||null,
    p_ultimo_folio:String(row.ultimo_folio||'').trim(),
    p_nuevo_responsable:nuevo,
    p_observacion:String(el('rqDObservacion')?.value||'').trim()||null
  });

  if(error){
    el('rqActionStatus').textContent=error.message;
    return;
  }

  const exp=row.expediente||'Expediente';
  activeArchiveDeliveryRequestId='';
  requestSelectedIds.clear();
  showToast(`${exp} reasignado a ${data?.nuevo_responsable||nuevo}. Archivo mantiene la solicitud de entrega.`);

  await Promise.all([
    loadArchiveDeliveryRequests(true),loadOperationalAlerts(true),loadNotifications(true),
    loadPanel(),loadRequests(),loadHistory()
  ]);

  closeRequestDetail();
}

async function reassignRequestItems(){
  const ids=(requestDetailRows||[])
    .filter(x=>requestSelectedIds.has(x.expediente_id) && requestItemCanReassign(x))
    .map(x=>x.expediente_id);
  const nuevo=el('rqDNuevoResponsable').value.trim();
  const obs=el('rqDObservacion').value.trim();

  if(!ids.length){
    el('rqActionStatus').textContent='Seleccione uno o más expedientes que ya estén EN PRÉSTAMO.';
    return;
  }
  if(!nuevo){
    el('rqActionStatus').textContent='Seleccione el nuevo responsable.';
    return;
  }

  const foliosOk=await saveRequiredUserFoliosBeforeMovement(ids);
  if(!foliosOk)return;

  el('rqActionStatus').textContent='Registrando reasignación...';

  const {error}=await sb.rpc('v752_reasignar_con_asunto',{
    p_asuntos:v752AsuntosSelected(ids),
    p_solicitud_id:currentRequestId,
    p_expediente_ids:ids,
    p_nuevo_responsable:nuevo,
    p_observacion:obs||null
  });

  if(error){el('rqActionStatus').textContent=error.message;return}

  requestSelectedIds.clear();
  showToast('Reasignación registrada');
  if(hasFullAccess()){
    await Promise.all([loadSummary(),loadPanel(),loadAll(),loadStates(),loadRequestsByLawyer(),loadHistory()]);
  }else{
    await Promise.all([loadSummary(),loadPanel(),loadRequests()]);
  }
  await refreshRequestDetail();
}


async function requestArchiveDeliveryItems(){
  if(!hasFullAccess()){
    el('rqActionStatus').textContent='Solo Archivo o Administrador puede iniciar esta solicitud.';
    return;
  }

  const ids=[...requestSelectedIds];
  if(!ids.length){
    el('rqActionStatus').textContent='Seleccione uno o más expedientes EN PRÉSTAMO.';
    return;
  }

  const selected=requestDetailRows.filter(x=>ids.includes(x.expediente_id));
  if(selected.some(x=>x.estado_item!=='EN PRÉSTAMO')){
    el('rqActionStatus').textContent='La entrega a Archivo solo puede solicitarse para expedientes EN PRÉSTAMO.';
    return;
  }

  el('rqActionStatus').textContent='Registrando solicitud de entrega a Archivo...';

  const {data,error}=await sb.rpc('solicitar_entrega_archivo',{
    p_solicitud_id:currentRequestId,
    p_expediente_ids:ids,
    p_observacion:null
  });

  if(error){
    el('rqActionStatus').textContent=error.message;
    return;
  }

  requestSelectedIds.clear();
  showToast(`${data?.solicitados||ids.length} solicitud(es) de entrega enviada(s)`);

  await Promise.all([
    loadArchiveDeliveryRequests(true),loadOperationalAlerts(true),
    loadSummary(),loadPanel(),loadAll(),loadStates(),loadRequests(),loadHistory()
  ]);

  await refreshRequestDetail();
}

async function requestReturnItems(){
  if(!isLimitedUser()){
    if(el('rqActionStatus'))el('rqActionStatus').textContent='Esta acción corresponde al usuario responsable del expediente o al coordinador en su espacio personal.';
    return;
  }

  const ids=[...requestSelectedIds];
  if(!ids.length){
    el('rqActionStatus').textContent='Seleccione uno o más expedientes EN PRÉSTAMO.';
    return;
  }

  const selected=(requestDetailRows||[]).filter(x=>ids.includes(x.expediente_id));
  if(selected.length!==ids.length){
    el('rqActionStatus').textContent='No se pudo identificar uno de los expedientes seleccionados.';
    return;
  }

  // La devolución NUEVA solo parte de EN PRÉSTAMO.
  const invalid=selected.filter(x=>x.estado_item!=='EN PRÉSTAMO');
  if(invalid.length){
    el('rqActionStatus').textContent='Solo se pueden devolver expedientes cuyo estado sea EN PRÉSTAMO.';
    return;
  }

  const mine=String(currentProfile?.nombre_personal||'').trim();
  const notMine=selected.filter(x=>
    mine && norm(x.responsable_actual||x.ubicacion_actual||'')!==norm(mine)
  );
  if(notMine.length){
    el('rqActionStatus').textContent='Uno de los expedientes ya no está bajo su responsabilidad.';
    return;
  }

  const missing=selected.filter(x=>!String(x.ultimo_folio||'').trim());
  if(missing.length){
    el('rqActionStatus').textContent='Ingrese obligatoriamente el Último folio antes de devolver.';
    document.querySelector(`[data-user-folio-id="${missing[0].expediente_id}"]`)?.focus();
    syncUserReturnButtonState();
    return;
  }

  if(!currentRequestId){
    el('rqActionStatus').textContent='No se pudo identificar la solicitud actual.';
    return;
  }

  const archiveReq=currentArchiveDeliveryRequest();
  const items=selected.map(x=>({
    solicitud_id:currentRequestId,
    expediente_id:x.expediente_id,
    solicitud_entrega_archivo_id:
      archiveReq && String(archiveReq.expediente_id||'')===String(x.expediente_id)
        ?archiveReq.id:null,
    rd:String(x.rd||'').trim()||null,
    ultimo_folio:String(x.ultimo_folio||'').trim(),
    observacion:String(el('rqDObservacion')?.value||'').trim()||null
  }));

  const btn=el('btnEffectReturn');
  if(btn)btn.disabled=true;
  el('rqActionStatus').textContent='Registrando devolución...';

  const {data,error}=await sb.rpc('devolver_expedientes_usuario_nuevo',{p_items:items});

  if(error){
    el('rqActionStatus').textContent='NO SE REGISTRÓ LA DEVOLUCIÓN: '+error.message;
    syncUserReturnButtonState();
    return;
  }

  if(norm(data?.estado||'')!=='DEVOLUCIÓN SOLICITADA'){
    el('rqActionStatus').textContent='Supabase no confirmó el estado DEVOLUCIÓN SOLICITADA.';
    syncUserReturnButtonState();
    return;
  }

  activeArchiveDeliveryRequestId='';
  requestSelectedIds.clear();

  // Si la devolución fue motivada por una nueva solicitud de otro usuario,
  // retirar automáticamente la alerta del custodio actual.
  await closeReturnAlertsForExpedientes(
    selected.map(x=>x.expediente_id)
  );

  showToast(`${Number(data?.total||selected.length)} expediente(s) en DEVOLUCIÓN SOLICITADA`);

  // V684 · La devolución solicitada sigue formando parte de la custodia física.
  // Invalidar caches antes de reconstruir Total en custodia / En préstamo / Devolución solicitada.
  try{if(typeof invalidateV171CustodyCache==='function')invalidateV171CustodyCache();}catch(_){ }

  await Promise.all([
    loadSummary(),loadPanel(),loadRequests(),
    loadArchiveDeliveryRequests(true),loadOperationalAlerts(true),loadNotifications(true)
  ]);
  await refreshRequestDetail();
}

async function confirmReturnItems(){
  let ids=[...requestSelectedIds];

  // Respaldo operativo: si Archivo pulsa directamente el botón y no hay
  // selección manual, tomar todos los expedientes que realmente estén
  // en DEVOLUCIÓN SOLICITADA.
  if(!ids.length && hasFullAccess()){
    ids=requestDetailRows
      .filter(x=>requestItemCanConfirmReturn(x))
      .map(x=>x.expediente_id);

    ids.forEach(id=>requestSelectedIds.add(id));

    if(ids.length){
      renderRequestDetailItems();
    }
  }

  const retorno=el('rqDRetorno').value.trim();
  const obs=el('rqDObservacion').value.trim();

  if(!hasFullAccess()){
    el('rqActionStatus').textContent='Solo Archivo o Administrador puede confirmar la recepción física.';
    return;
  }

  if(!ids.length){
    el('rqActionStatus').textContent='Seleccione uno o más expedientes con DEVOLUCIÓN SOLICITADA.';
    return;
  }

  const selected=requestDetailRows.filter(x=>ids.includes(x.expediente_id));
  if(selected.some(x=>!requestItemCanConfirmReturn(x))){
    el('rqActionStatus').textContent='Para confirmar la devolución, todos los seleccionados deben estar en DEVOLUCIÓN SOLICITADA.';
    return;
  }

  if(!retorno){
    el('rqActionStatus').textContent='Seleccione la ubicación física de retorno.';
    return;
  }

  // V169 · si esta devolución desbloquea una solicitud de otra área,
  // conservar su ID antes de confirmar porque la espera puede desaparecer
  // inmediatamente después de la recepción física.
  const destinationRequestsV169=[...new Set(
    (crossAreaWaitRows||[])
      .filter(w=>
        ids.some(id=>String(id)===String(w.expediente_id||'')) &&
        w.solicitud_destino_id
      )
      .map(w=>String(w.solicitud_destino_id))
      .filter(Boolean)
  )];

  el('rqActionStatus').textContent='Confirmando recepción física y actualizando la solicitud...';

  const {data,error}=await sb.rpc('confirmar_devolucion_archivo_estado_fisico_v2',{
    p_solicitud_id:currentRequestId,
    p_expediente_ids:ids,
    p_ubicacion_retorno:retorno,
    p_observacion:obs||null
  });

  if(error){
    el('rqActionStatus').textContent=error.message;
    return;
  }

  requestSelectedIds.clear();

  showToast(data?.cerrada
    ?'Solicitud cerrada: todos los expedientes fueron recibidos'
    :`${data?.devueltos||ids.length} expediente(s) recibidos por Archivo`);

  await refreshReturnCountersAndViews({
    full:true,
    reason:'RECEPCIÓN DESDE GESTIONAR SOLICITUD'
  });

  // V169 · flujo corto entre áreas:
  // si la recepción habilitó exactamente una solicitud nueva, Archivo no
  // necesita cerrar, buscarla y abrirla manualmente. Se abre directamente.
  const nextRequestId=destinationRequestsV169.length===1
    ?destinationRequestsV169[0]
    :'';

  if(
    nextRequestId &&
    String(nextRequestId)!==String(currentRequestId||'')
  ){
    if(el('rqActionStatus')){
      el('rqActionStatus').textContent='Recepción confirmada. Abriendo la solicitud que estaba en espera...';
    }
    showToast('Recepción confirmada · continuando con la solicitud pendiente');
    await openRequestDetail(nextRequestId);
    return;
  }

  await refreshRequestDetail();
}

async function returnRequestItems(){
  return confirmReturnItems();
}

async function refreshRequestDetail(){
  const id=currentRequestId;
  await Promise.all([loadRequests(),loadSummary()]);
  if(id && currentRequestId===id && el('requestDetailModal').classList.contains('show')){
    await openRequestDetail(id);
  }
}

function masterStateOptions(){
  return [
    'CUSTODIA',
    'EN PRÉSTAMO',
    'REASIGNADO',
    'DEVOLUCIÓN SOLICITADA',
    'DERIVADO AL CONAS',
    'DERIVADO A LA DVC',
    'DERIVADO A INSTRUCCIÓN',
    'RETORNO DE INSTRUCCIÓN',
    'DEVUELTO AL ARCHIVO',
    'PENDIENTE POR ATENDER',
    'EN TRÁMITE'
  ];
}

let masterSelectedStates=new Set(masterStateOptions());

function formatMasterMonth(value){
  const m=String(value||'').match(/^(\d{4})-(\d{2})$/);
  if(!m)return String(value||'');
  const d=new Date(Number(m[1]),Number(m[2])-1,1);
  return new Intl.DateTimeFormat('es-PE',{month:'long',year:'numeric'})
    .format(d).toUpperCase();
}

function renderMasterStateFilter(){
  const box=el('allStateCheckboxes');
  if(!box)return;

  const states=masterStateOptions();
  // Si la variable quedó vacía al iniciar una versión anterior, empezar con todos.
  if(!(masterSelectedStates instanceof Set))masterSelectedStates=new Set(states);

  box.innerHTML=states.map(x=>`
    <label class="master-state-check">
      <input type="checkbox" value="${esc(x)}"
             ${masterSelectedStates.has(x)?'checked':''}
             onchange="changeMasterStateCheckbox(this)">
      <span>${esc(stateDisplayName(x))}</span>
    </label>`).join('');

  updateMasterStateFilterText();
}

function updateMasterStateFilterText(){
  const states=masterStateOptions();
  const selected=states.filter(x=>masterSelectedStates.has(x));
  const text=el('allStateMultiText');
  const count=el('allStateCountLabel');

  if(text){
    if(selected.length===states.length)text.textContent='TODOS LOS ESTADOS';
    else if(selected.length===0)text.textContent='NINGÚN ESTADO';
    else if(selected.length===1)text.textContent=stateDisplayName(selected[0]);
    else text.textContent=`${selected.length} ESTADOS SELECCIONADOS`;
  }

  if(count)count.textContent=`${selected.length}/${states.length}`;

  const button=el('allStateMultiButton');
  if(button){
    button.classList.toggle(
      'has-selection',
      selected.length>0 && selected.length<states.length
    );
    button.title=selected.length===states.length
      ?'Todos los estados'
      :selected.length
        ?selected.map(stateDisplayName).join(' · ')
        :'Ningún estado seleccionado';
  }

  syncMasterReturnBulkUI();
}

function toggleMasterStatePanel(ev){
  if(ev)ev.stopPropagation();
  closeMasterDayPanel();
  renderMasterStateFilter();
  const panel=el('allStateMultiPanel');
  const advanced=el('allAdvancedFilters');
  if(!panel)return;
  const opening=panel.classList.contains('hidden');
  panel.classList.toggle('hidden',!opening);
  advanced?.classList.toggle('state-panel-open',opening);
  requestAnimationFrame(()=>{
    try{ syncStickyLayout(); }catch(_e){}
  });
}

function closeMasterStatePanel(){
  el('allStateMultiPanel')?.classList.add('hidden');
  el('allAdvancedFilters')?.classList.remove('state-panel-open');
  requestAnimationFrame(()=>{
    try{ syncStickyLayout(); }catch(_e){}
  });
}

function changeMasterStateCheckbox(input){
  const v=input.value;
  if(input.checked)masterSelectedStates.add(v);
  else masterSelectedStates.delete(v);

  // Al cambiar el filtro del Registro maestro se reinicia la selección,
  // para que la recepción múltiple solo trabaje con la vista actual.
  selectedIds.clear();
  updateSelectionUI();

  updateMasterStateFilterText();
  resetAllAndLoad();
}

function selectAllMasterStates(){
  masterSelectedStates=new Set(masterStateOptions());
  selectedIds.clear();
  updateSelectionUI();
  renderMasterStateFilter();
  el('allStateMultiPanel')?.classList.remove('hidden');
  el('allAdvancedFilters')?.classList.add('state-panel-open');
  resetAllAndLoad();
}

function clearAllMasterStates(){
  masterSelectedStates=new Set();
  selectedIds.clear();
  updateSelectionUI();
  renderMasterStateFilter();
  el('allStateMultiPanel')?.classList.remove('hidden');
  el('allAdvancedFilters')?.classList.add('state-panel-open');
  resetAllAndLoad();
}

function masterStatesForRpc(){
  const all=masterStateOptions();
  const selected=all.filter(x=>masterSelectedStates.has(x));
  if(selected.length===all.length)return null;
  return selected;
}

function populateMasterFilters(){
  renderMasterStateFilter();
  const owner=el('allOwnerFilter');

  if(owner){
    const current=owner.value||'';

    const names=[...new Set([
      ...abogadoNames(),
      ...(catalogo||[])
        .filter(x=>x.activo!==false)
        .map(x=>x.nombre)
        .filter(Boolean)
    ])].sort((a,b)=>a.localeCompare(b,'es'));

    owner.innerHTML=
      '<option value="">TODOS</option>'+names.map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join('');

    owner.value=[...owner.options].some(o=>o.value===current)?current:'';
  }
}

function normalizeMasterSearchV523(value){
  const q=cleanSearch(value||'')||'';
  const raw=q.replace(/\s+/g,'');
  const m=raw.match(/^0*(\d+)-(\d{4})$/);
  if(!m)return q;
  let n=String(m[1]||'').replace(/^0+(?=\d)/,'')||'0';
  if(n.length<4)n=n.padStart(4,'0');
  return `${n}-${m[2]}`;
}

function masterParams(limit=ALL_PAGE_SIZE,offset=allPage*ALL_PAGE_SIZE,options={}){
  const ignoreState=!!options.ignoreState;

  return {
    p_busqueda:normalizeMasterSearchV523(el('allSearch')?.value||'')||null,
    p_estados:ignoreState?null:masterStatesForRpc(),
    p_responsable:(el('allOwnerFilter')?.value||'').trim()||null,
    p_modalidad:(el('allModeFilter')?.value||'').trim()||null,
    p_mes:(el('allMonthFilter')?.value||'').trim()||null,

    // Día se filtra localmente porque permite múltiples fechas.
    p_fecha_dia:null,

    p_limite:limit,
    p_offset:offset
  };
}

function masterLatestStateFilterActive(){
  const all=masterStateOptions();
  const selected=all.filter(x=>masterSelectedStates.has(x));
  return selected.length!==all.length;
}

function masterMatchesLatestState(r){
  const all=masterStateOptions();
  const selected=all.filter(x=>masterSelectedStates.has(x));

  if(selected.length===all.length)return true;
  if(selected.length===0)return false;

  const latest=norm(operationalStatus(r)||r?.estado_operativo||r?.estado||'');
  return selected.some(x=>norm(x)===latest);
}

let masterAvailableDays=[];
let masterSelectedDays=new Set();
let masterDayMonthKey='';

function masterRequestDateKey(value){
  if(!value)return '';

  const raw=String(value).trim();

  if(/^\d{4}-\d{2}-\d{2}/.test(raw)){
    return raw.slice(0,10);
  }

  const pe=raw.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
  if(pe){
    return `${pe[3]}-${String(pe[2]).padStart(2,'0')}-${String(pe[1]).padStart(2,'0')}`;
  }

  const d=new Date(value);
  if(isNaN(d.getTime()))return '';

  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}

function masterDayFilterActive(){
  const month=(el('allMonthFilter')?.value||'').trim();
  if(!month||!masterAvailableDays.length)return false;

  return masterSelectedDays.size!==masterAvailableDays.length;
}

function masterMatchesSelectedDays(r){
  const month=(el('allMonthFilter')?.value||'').trim();
  if(!month)return true;

  if(!masterAvailableDays.length)return true;
  if(masterSelectedDays.size===masterAvailableDays.length)return true;
  if(masterSelectedDays.size===0)return false;

  return masterSelectedDays.has(masterRequestDateKey(r?.fecha_solicitud));
}

function renderMasterDayFilter(){
  const box=el('allDayCheckboxes');
  const button=el('allDayMultiButton');
  const month=(el('allMonthFilter')?.value||'').trim();

  if(!box||!button)return;

  if(!month){
    box.innerHTML='<div class="empty">Seleccione primero un mes de solicitud.</div>';
    button.disabled=true;
    updateMasterDayFilterText();
    return;
  }

  button.disabled=false;

  box.innerHTML=masterAvailableDays.length
    ?masterAvailableDays.map(x=>`
      <label class="master-day-check">
        <input type="checkbox"
               value="${esc(x.fecha)}"
               ${masterSelectedDays.has(x.fecha)?'checked':''}
               onchange="changeMasterDayCheckbox(this)">
        <span>${esc(fmtDate(x.fecha))}</span>
        <span class="day-count">${Number(x.cantidad||0)}</span>
      </label>
    `).join('')
    :'<div class="empty">No hay días disponibles para el mes seleccionado.</div>';

  updateMasterDayFilterText();
}

function updateMasterDayFilterText(){
  const month=(el('allMonthFilter')?.value||'').trim();
  const button=el('allDayMultiButton');
  const textBox=el('allDayMultiText');
  const count=el('allDayCountLabel');

  if(!button||!textBox)return;

  if(!month){
    button.disabled=true;
    textBox.textContent='SELECCIONE UN MES';
    if(count)count.textContent='';
    button.classList.remove('has-selection');
    return;
  }

  button.disabled=false;

  const total=masterAvailableDays.length;
  const selected=masterSelectedDays.size;

  if(!total){
    textBox.textContent='SIN DÍAS DISPONIBLES';
  }else if(selected===total){
    textBox.textContent='TODOS LOS DÍAS DEL MES';
  }else if(selected===0){
    textBox.textContent='NINGÚN DÍA';
  }else if(selected===1){
    textBox.textContent=fmtDate([...masterSelectedDays][0]);
  }else{
    textBox.textContent=`${selected} DÍAS SELECCIONADOS`;
  }

  if(count)count.textContent=total?`${selected}/${total}`:'';

  button.classList.toggle(
    'has-selection',
    total>0 && selected!==total
  );

  button.title=
    selected===total
      ?'Todos los días del mes'
      :selected
        ?[...masterSelectedDays].sort().map(fmtDate).join(' · ')
        :'Ningún día seleccionado';
}

function toggleMasterDayPanel(ev){
  if(ev)ev.stopPropagation();
  if(el('allDayMultiButton')?.disabled)return;

  renderMasterDayFilter();

  const panel=el('allDayMultiPanel');
  if(!panel)return;

  const opening=panel.classList.contains('hidden');

  if(opening)closeMasterStatePanel();

  panel.classList.toggle('hidden',!opening);
}

function closeMasterDayPanel(){
  el('allDayMultiPanel')?.classList.add('hidden');
}

function changeMasterDayCheckbox(input){
  if(input.checked)masterSelectedDays.add(input.value);
  else masterSelectedDays.delete(input.value);

  selectedIds.clear();
  updateSelectionUI();
  updateMasterDayFilterText();

  allPage=0;
  loadAll();
}

function selectAllMasterDays(){
  masterSelectedDays=new Set(masterAvailableDays.map(x=>x.fecha));

  selectedIds.clear();
  updateSelectionUI();
  renderMasterDayFilter();
  el('allDayMultiPanel')?.classList.remove('hidden');

  allPage=0;
  loadAll();
}

function clearAllMasterDays(){
  masterSelectedDays=new Set();

  selectedIds.clear();
  updateSelectionUI();
  renderMasterDayFilter();
  el('allDayMultiPanel')?.classList.remove('hidden');

  allPage=0;
  loadAll();
}

function syncMasterDayOptions(dayRows){
  const month=(el('allMonthFilter')?.value||'').trim();

  const rows=(Array.isArray(dayRows)?dayRows:[])
    .map(x=>({
      fecha:masterRequestDateKey(x.fecha),
      cantidad:Number(x.cantidad||0)
    }))
    .filter(x=>x.fecha)
    .sort((a,b)=>String(b.fecha).localeCompare(String(a.fecha)));

  if(!month){
    masterDayMonthKey='';
    masterAvailableDays=[];
    masterSelectedDays=new Set();
    renderMasterDayFilter();
    return;
  }

  const oldAvailable=new Set(masterAvailableDays.map(x=>x.fecha));
  const nextAvailable=new Set(rows.map(x=>x.fecha));
  const monthChanged=masterDayMonthKey!==month;

  masterAvailableDays=rows;
  masterDayMonthKey=month;

  if(monthChanged){
    // Nuevo mes: todos sus días seleccionados inicialmente.
    masterSelectedDays=new Set(rows.map(x=>x.fecha));
  }else if(!oldAvailable.size && rows.length){
    masterSelectedDays=new Set(rows.map(x=>x.fecha));
  }else{
    const previouslyAll=
      oldAvailable.size>0 &&
      [...oldAvailable].every(x=>masterSelectedDays.has(x));

    if(previouslyAll){
      masterSelectedDays=new Set(rows.map(x=>x.fecha));
    }else{
      masterSelectedDays=new Set(
        [...masterSelectedDays].filter(x=>nextAvailable.has(x))
      );
    }
  }

  renderMasterDayFilter();
}


function masterRequestEntryValue(r){
  if(!r)return '';

  return (
    // Priorizar el timestamp real de creación/ingreso de la solicitud
    // para que en Mis expedientes se vea también la hora.
    r.solicitud_created_at ||
    r.created_at ||
    r.fecha_ingreso_solicitud ||
    r.solicitud_pendiente_created_at ||
    r.fecha_solicitud ||
    ''
  );
}

function masterRequestEntryTimestamp(r){
  const value=masterRequestEntryValue(r);
  if(!value)return 0;

  const raw=String(value).trim();

  if(/^\d{4}-\d{2}-\d{2}$/.test(raw)){
    const ts=new Date(`${raw}T00:00:00`).getTime();
    return isNaN(ts)?0:ts;
  }

  const ts=new Date(raw).getTime();
  return isNaN(ts)?0:ts;
}

function masterRequestEntryHasTime(r){
  const raw=String(
    masterRequestEntryValue(r)||''
  ).trim();

  return (
    /[T ]\d{1,2}:\d{2}/.test(raw) ||
    /^\d{1,2}:\d{2}/.test(raw)
  );
}

function masterRequestEntryHtml(r){
  const value=masterRequestEntryValue(r);

  if(!value)return '—';

  const dateText=fmtDate(value)||'—';
  const timeText=masterRequestEntryHasTime(r)
    ?fmtTime(value)
    :'—';

  return `
    <div class="datetime-cell">
      <span class="datetime-date">${esc(dateText)}</span>
      <span class="datetime-time">${esc(timeText)}</span>
    </div>
  `;
}


function masterValueHasExplicitTime(value){
  const raw=String(value||'').trim();
  if(!raw)return false;

  return (
    /[T ]\d{1,2}:\d{2}/.test(raw) ||
    /^\d{1,2}:\d{2}/.test(raw)
  );
}

function warnFuturePeruDateV186(value,context='fecha'){
  if(!value)return;

  const key=limaDateKeyV186(value);
  const today=limaNowDateKeyV186();

  if(key && today && key>today){
    console.warn(
      `[V186 · FECHA FUTURA] ${context}: ${key}. `+
      `Fecha actual Perú: ${today}. Revise si la RPC de Supabase usa CURRENT_DATE en UTC.`
    );
  }
}

function masterDateTimeHtml(value){
  if(!value)return '—';

  const dateText=fmtDate(value)||'—';
  const timeText=masterValueHasExplicitTime(value)
    ?fmtTime(value)
    :'—';

  return `
    <div class="datetime-cell">
      <span class="datetime-date">${esc(dateText)}</span>
      <span class="datetime-time">${esc(timeText)}</span>
    </div>
  `;
}

function masterDeliveryDateTimeValue(r){
  const delivery=masterDeliveryDateValue(r);

  if(masterValueHasExplicitTime(delivery))return delivery;

  const state=norm(
    r?.estado_operativo||
    r?.estado||
    operationalStatus(r)||
    ''
  );
  const action=norm(r?.ultimo_movimiento||'');
  const movement=r?.ultimo_movimiento_fecha||null;

  const movementIsDelivery=
    action.includes('CARGO GENERADO') ||
    action.includes('ENTREGA EN PRÉSTAMO') ||
    action.includes('ENTREGA EN PRESTAMO');

  if(
    movement &&
    masterValueHasExplicitTime(movement) &&
    (state==='EN PRÉSTAMO' || movementIsDelivery)
  ){
    return movement;
  }

  return delivery;
}

function sortMasterByRequestDate(rows){
  return rows.slice().sort((a,b)=>{
    const at=masterRequestEntryTimestamp(a);
    const bt=masterRequestEntryTimestamp(b);

    // Solicitud que ingresó más recientemente primero.
    if(bt!==at)return bt-at;

    // Desempate por correlativo de solicitud.
    const A=requestNumberParts(
      a.solicitud_numero||
      a.solicitud_pendiente_numero||
      ''
    );

    const B=requestNumberParts(
      b.solicitud_numero||
      b.solicitud_pendiente_numero||
      ''
    );

    if(B.year!==A.year)return B.year-A.year;
    if(B.num!==A.num)return B.num-A.num;

    return (
      String(a.expediente||'')
        .localeCompare(
          String(b.expediente||''),
          'es',
          {numeric:true}
        ) ||
      String(a.extension||'')
        .localeCompare(
          String(b.extension||''),
          'es'
        ) ||
      String(a.id||'')
        .localeCompare(
          String(b.id||'')
        )
    );
  });
}
async function masterRequestDates(rows){
  const ids=[...new Set(rows.map(r=>r.id).filter(Boolean))];
  const links=[];
  async function collect(table,columns,field,values){
    const result=[];
    for(let i=0;i<values.length;i+=100){
      for(let from=0;;from+=500){
        const {data,error}=await sb.from(table).select(columns).in(field,values.slice(i,i+100)).order('id').range(from,from+499);
        if(error)throw error;
        result.push(...(data||[]));if(!data||data.length<500)break;
      }
    }
    return result;
  }
  links.push(...await collect('solicitud_expedientes','id,expediente_id,solicitud_id','expediente_id',ids));
  const requestIds=[...new Set(links.map(r=>r.solicitud_id).filter(Boolean))];
  const requests=await collect('solicitudes_prestamo','id,numero,fecha_solicitud','id',requestIds);
  const byId=new Map(requests.map(r=>[String(r.id),r])),latest=new Map();
  for(const link of links){
    const request=byId.get(String(link.solicitud_id));
    if(!request||!masterRequestDateKey(request.fecha_solicitud))continue;
    const id=String(link.expediente_id),previous=latest.get(id);
    const date=masterRequestDateKey(request.fecha_solicitud),old=masterRequestDateKey(previous?.fecha_solicitud);
    if(!previous||date>old||(date===old&&String(request.id)>String(previous.id)))latest.set(id,request);
  }
  return rows.map(row=>{
    const request=latest.get(String(row.id));
    // Attention, delivery, return and last movement dates never replace this value.
    return {...row,fecha_solicitud:request?masterRequestDateKey(request.fecha_solicitud):masterRequestDateKey(row.fecha_solicitud)||null};
  });
}

async function resolveMasterAccumulatedSearch(rawSearch){
  const q=String(rawSearch||'').trim();

  // Solo consultar la relación de acumulados cuando la búsqueda
  // tiene forma de número de expediente.
  if(!q || !/^\d+-\d{4}$/i.test(q)){
    return null;
  }

  try{
    const {data,error}=await sb.rpc(
      'buscar_variantes_acumuladas',
      {p_numero:q}
    );

    if(error){
      console.warn('Búsqueda de acumulado en Registro Maestro:',error.message||error);
      return null;
    }

    const variants=Array.isArray(data)?data:[];

    if(!variants.length)return null;

    return {
      numero:q,
      variants,
      principalIds:new Set(
        variants
          .map(v=>String(v.expediente_principal_id||''))
          .filter(Boolean)
      )
    };
  }catch(error){
    console.warn('Búsqueda de acumulado en Registro Maestro:',error);
    return null;
  }
}


let expSearchSequence=0;
let expSearchCurrentId='';
let expSearchContextById=new Map();

function expSearchDateTime(value){
  if(!value)return '—';
  const d=fmtDate(value)||'—';
  const t=masterValueHasExplicitTime(value)?fmtTime(value):'';
  return t ? `${d} · ${t}` : d;
}

function expSearchValue(value,fallback='—'){
  const s=String(value??'').trim();
  return s||fallback;
}

function expSearchKpi(label,value,cls=''){
  return `<div class="exp-search-kv ${cls}">
    <span>${esc(label)}</span>
    <b>${value}</b>
  </div>`;
}

function expSearchMovementDetails(movements){
  const rows=[...(movements||[])]
    .sort((a,b)=>new Date(b?.created_at||0)-new Date(a?.created_at||0));

  if(!rows.length)return '<div class="note" style="margin-top:8px">Sin movimientos registrados.</div>';

  return `<div class="timeline" style="margin-top:8px">
    ${rows.map(m=>{
      const meta=[
        m.desde?`Desde: ${esc(m.desde)}`:'',
        m.hacia?`Hacia: ${esc(m.hacia)}`:'',
        m.cargo_numero?`Cargo: ${esc(m.cargo_numero)}`:''
      ].filter(Boolean).join(' · ');

      return `<div class="timeline-item">
        <div class="t-date">${esc(expSearchDateTime(m.created_at))}</div>
        <div class="t-action">${esc(m.accion||'MOVIMIENTO')}</div>
        <div class="t-detail">${esc(m.observacion||m.detalle||'Sin detalle')}</div>
        ${meta?`<div class="t-meta">${meta}</div>`:''}
      </div>`;
    }).join('')}
  </div>`;
}

function expSearchLatestMovement(movements){
  return [...(movements||[])]
    .sort((a,b)=>new Date(b?.created_at||0)-new Date(a?.created_at||0))[0]||null;
}

function expSearchLatestReassignment(movements){
  return [...(movements||[])]
    .filter(m=>{
      const a=norm(m?.accion||'');
      return a.includes('REASIGN') && !a.includes('SOLICITUD');
    })
    .sort((a,b)=>new Date(b?.created_at||0)-new Date(a?.created_at||0))[0]||null;
}

function expSearchReturnMovement(movements){
  return [...(movements||[])]
    .filter(m=>{
      const a=norm(m?.accion||'');
      return (
        a.includes('DEVOLUCIÓN CONFIRMADA') ||
        a.includes('DEVOLUCION CONFIRMADA') ||
        a.includes('RECIBIDO EN ARCHIVO')
      );
    })
    .sort((a,b)=>new Date(b?.created_at||0)-new Date(a?.created_at||0))[0]||null;
}

function expSearchAttentionDays(cycle){
  const request=cycle?.request||{};
  const link=cycle?.link||{};
  const start=request.fecha_solicitud||request.created_at||link.created_at||null;
  const end=link.fecha_entrega||request.fecha_entrega||null;
  if(!start||!end)return '—';
  const days=businessDays(start,end);
  return days>0?String(days):'—';
}

function expSearchCustodyDays(cycle){
  const request=cycle?.request||{};
  const link=cycle?.link||{};
  if(norm(request.modalidad||'')==='COPIA DIGITAL')return '—';

  const latestReassign=expSearchLatestReassignment(cycle?.movements||[]);
  const start=
    latestReassign?.created_at||
    link.fecha_entrega||
    request.fecha_entrega||
    null;

  const ret=expSearchReturnMovement(cycle?.movements||[]);
  const end=
    link.fecha_devolucion||
    ret?.created_at||
    null;

  if(!start)return '—';
  const days=businessDays(start,end);
  return days>0?String(days):'—';
}

function expSearchCycleCard(cycle,index,total,masterRecord){
  const request=cycle?.request||{};
  const link=cycle?.link||{};
  const movements=cycle?.movements||[];
  const state=requestCycleOperationalState(cycle);
  const current=index===0;
  const closed=norm(state)==='DEVUELTO AL ARCHIVO';
  const latestReassign=expSearchLatestReassignment(movements);
  const returnMove=expSearchReturnMovement(movements);

  const cargo=
    link.cargo_numero||
    request.cargo_numero||
    movements.find(m=>m.cargo_numero)?.cargo_numero||
    '—';

  const attendedBy=
    request.aceptado_por||
    request.atiende||
    request.atiende_requerimiento||
    link.aceptado_por||
    '—';

  const returnedBy=
    link.devuelto_por||
    link.profesional_devuelve||
    returnMove?.desde||
    '—';

  const receivedBy=
    link.recibido_por||
    link.profesional_recibe||
    returnMove?.hacia||
    '—';

  const returnFolio=
    link.folio_devolucion||
    link.folios_devolucion||
    link.ultimo_folio_devolucion||
    '—';

  const requestDate=request.fecha_solicitud||request.created_at||link.created_at||null;
  const deliveryDate=link.fecha_entrega||request.fecha_entrega||null;
  const returnDate=link.fecha_devolucion||returnMove?.created_at||request.fecha_cierre||null;

  return `<section class="exp-search-cycle ${current?'current':''} ${closed?'closed':''}">
    <div class="exp-search-cycle-head">
      <div>
        <div style="font-size:12px;font-weight:900;color:#173f6b">
          ${esc(request.numero||`ATENCIÓN ${total-index}`)}
          ${current?'<span class="request-cycle-number">MÁS RECIENTE</span>':''}
        </div>
        <div class="asunto">${esc(request.asunto||'Sin asunto registrado')}</div>
      </div>
      ${attentionStatePill(state)}
    </div>

    <div class="exp-search-cycle-grid">
      ${expSearchKpi('Fecha / hora solicitud',esc(expSearchDateTime(requestDate)))}
      ${expSearchKpi('Solicitante',esc(expSearchValue(request.solicitante)))}
      ${expSearchKpi('Modalidad',esc(expSearchValue(request.modalidad)))}
      ${expSearchKpi('Cargo',esc(expSearchValue(cargo)))}

      ${expSearchKpi('Fecha / hora entrega',esc(expSearchDateTime(deliveryDate)))}
      ${expSearchKpi('Responsable de la atención',esc(expSearchValue(attendedBy)))}
      ${expSearchKpi('Días de atención',esc(expSearchAttentionDays(cycle)))}
      ${expSearchKpi('Responsable actual',esc(requestCycleResponsible(cycle,masterRecord)))}

      ${expSearchKpi(
        'Última reasignación',
        latestReassign
          ?`${esc(expSearchValue(latestReassign.desde))} → ${esc(expSearchValue(latestReassign.hacia))}`
          :'—'
      )}
      ${expSearchKpi('Fecha última reasignación',esc(expSearchDateTime(latestReassign?.created_at)))}
      ${expSearchKpi('Días en custodia',esc(expSearchCustodyDays(cycle)))}
      ${expSearchKpi('Estado final / actual',esc(expSearchValue(state)))}

      ${expSearchKpi('Fecha devolución',esc(expSearchDateTime(returnDate)))}
      ${expSearchKpi('Profesional que devuelve',esc(expSearchValue(returnedBy)))}
      ${expSearchKpi('Profesional que recibe',esc(expSearchValue(receivedBy)))}
      ${expSearchKpi('N.° folios al devolver',esc(expSearchValue(returnFolio)))}
    </div>

    <details class="exp-search-movements">
      <summary>Ver movimientos de esta atención (${movements.length})</summary>
      ${expSearchMovementDetails(movements)}
    </details>
  </section>`;
}

async function expSearchFindCandidates(numero,extension){
  const parsed=parseRequestLookupNumberAndExtension(numero,extension);
  const q=parsed.expediente;
  const ext=parsed.extension;

  if(!q || q.length<4){
    return {error:'Ingrese un número de expediente válido.',rows:[]};
  }

  let effectiveSearch=q;
  let effectiveExtension=ext;
  let accumulatedResolution=null;
  let ambiguousVariants=null;

  // 1. Resolver acumulados exactamente igual que en Agregar expediente.
  const resolved=await resolveAccumulatedLookup(q,ext);

  if(resolved?._ambiguous_accumulated){
    ambiguousVariants=resolved.variants||[];
  }else if(resolved?.es_acumulado && resolved?.expediente_principal){
    accumulatedResolution=resolved;
    effectiveSearch=resolved.expediente_principal;
    effectiveExtension=resolved.extension_principal||'';
  }

  // Si el acumulado tiene varias variantes, consultar cada principal
  // para poder mostrar responsable/ubicación real antes de seleccionar.
  if(ambiguousVariants?.length){
    const hydrated=[];

    for(const variant of ambiguousVariants){
      const principal=variant.expediente_principal;
      const principalExt=variant.extension_principal||'';

      const {data,error}=await sb.rpc(
        'buscar_expedientes_para_solicitud_v2',
        {p_busqueda:principal}
      );

      if(error)continue;

      let rows=Array.isArray(data)?data:[];

      rows=rows.filter(r=>
        normalizeRequestExpediente(r.expediente||'')===
        normalizeRequestExpediente(principal||'')
      );

      if(principalExt){
        rows=requestRowsMatchingExtension(rows,principalExt);
      }

      // MISMA LÓGICA DEL MÓDULO "AGREGAR EXPEDIENTE"
      rows=await annotateInternalReassignEligibility(rows);
      rows=await enrichRequestCustodyContext(rows);
      rows=await annotateInstructionReturnEligibility(rows);

      hydrated.push(
        ...rows.map(r=>({
          ...r,
          _searched_as_accumulated:true,
          _original_accumulated:q,
          _original_accumulated_extension:
            variant.extension_acumulado||'',
          _expediente_principal_resuelto:principal,
          _extension_principal_resuelta:principalExt
        }))
      );
    }

    const seen=new Set();
    const unique=hydrated.filter(r=>{
      const id=String(r.id||'');
      if(!id||seen.has(id))return false;
      seen.add(id);
      return true;
    });

    return {rows:unique,ambiguous:true};
  }

  // 2. Buscar el expediente físico usando la misma RPC de Agregar expediente.
  const {data,error}=await sb.rpc(
    'buscar_expedientes_para_solicitud_v2',
    {p_busqueda:effectiveSearch}
  );

  if(error)return {error:error.message||String(error),rows:[]};

  let rows=Array.isArray(data)?data:[];

  // Mantener exactamente el número físico consultado/resuelto.
  rows=rows.filter(r=>
    normalizeRequestExpediente(r.expediente||'')===
    normalizeRequestExpediente(effectiveSearch||'')
  );

  // 3. MISMA LÓGICA OPERATIVA DEL MÓDULO "AGREGAR EXPEDIENTE".
  rows=await annotateInternalReassignEligibility(rows);
  rows=await enrichRequestCustodyContext(rows);
  rows=await annotateInstructionReturnEligibility(rows);

  if(effectiveExtension){
    rows=requestRowsMatchingExtension(rows,effectiveExtension);
  }

  if(accumulatedResolution){
    rows=rows.map(r=>({
      ...r,
      _searched_as_accumulated:true,
      _original_accumulated:q,
      _original_accumulated_extension:ext||'',
      _expediente_principal_resuelto:
        accumulatedResolution.expediente_principal,
      _extension_principal_resuelta:
        accumulatedResolution.extension_principal||''
    }));
  }

  // Evitar duplicados por UUID físico.
  const seen=new Set();
  rows=rows.filter(r=>{
    const id=String(r.id||'');
    if(!id||seen.has(id))return false;
    seen.add(id);
    return true;
  });

  return {rows};
}

function renderExpSearchChoices(rows){
  const box=el('expSearchChoices');
  if(!box)return;

  if(!rows.length){
    box.innerHTML='';
    return;
  }

  box.innerHTML=rows.map(r=>{
    const state=
      r.estado_operativo||
      r.ultimo_estado||
      r.estado||
      operationalStatus(r)||
      '—';

    const responsible=
      r.responsable_actual||
      r.responsable||
      '—';

    const stateDate=
      r.fecha_ultimo_estado||
      requestLatestStateDateValue(r)||
      null;

    return `
      <div class="exp-search-choice"
           onclick="loadExpedienteSearchDetail('${esc(String(r.id||''))}','${esc(r._original_accumulated||'')}')">
        <div class="main">
          ${esc(r.expediente||'—')} · ${esc(r.extension||'SIN EXTENSIÓN')}
        </div>

        <div class="exp-search-choice-context">
          <span><b>Estado:</b> ${esc(state)}</span>
          <span><b>Responsable / ubicación:</b> ${esc(responsible)}</span>
          <span><b>Último estado:</b> ${stateDate?esc(expSearchDateTime(stateDate)):'—'}</span>
        </div>

        <div class="sub">
          ${r._searched_as_accumulated
            ?`Coincidencia por acumulado: ${esc(r._original_accumulated||'')}${r._original_accumulated_extension?` · ${esc(r._original_accumulated_extension)}`:''}`
            :'Expediente físico registrado'
          }
        </div>
      </div>
    `;
  }).join('');
}

async function searchExpedienteQuick(){
  if(!(hasFullAccess()||isLimitedUser())){
    showToast('No tiene permisos para usar el Buscador de expedientes.');
    return;
  }

  const seq=++expSearchSequence;
  const isCurrent=()=>seq===expSearchSequence;

  const numero=(el('expSearchNumber')?.value||'').trim();
  const extension=(el('expSearchExtension')?.value||'').trim();

  el('expSearchChoices').innerHTML='';
  el('expSearchResult').classList.add('hidden');
  el('expSearchStatus').textContent='Buscando expediente...';

  const btn=el('expSearchBtn');
  btn.disabled=true;
  btn.textContent='Buscando...';

  try{
    const result=await expSearchFindCandidates(numero,extension);
    if(!isCurrent())return;

    if(result.error){
      el('expSearchStatus').textContent=result.error;
      return;
    }

    const rows=result.rows||[];

    // Guardar el mismo contexto operativo usado en "Agregar expediente"
    // para reutilizarlo en la ficha detallada.
    expSearchContextById=new Map(
      rows
        .filter(r=>r?.id)
        .map(r=>[String(r.id),r])
    );

    if(!rows.length){
      el('expSearchStatus').textContent='No se encontró el expediente ni una relación de acumulación con esos datos.';
      return;
    }

    if(rows.length===1){
      const r=rows[0];
      el('expSearchStatus').textContent=
        r._searched_as_accumulated
          ?`${r._original_accumulated} está acumulado al expediente principal ${r.expediente} · ${r.extension||'SIN EXTENSIÓN'}.`
          :`Expediente encontrado: ${r.expediente} · ${r.extension||'SIN EXTENSIÓN'}.`;

      await loadExpedienteSearchDetail(
        String(r.id||''),
        r._original_accumulated||''
      );
      return;
    }

    el('expSearchStatus').textContent=
      result.ambiguous
        ?'El número acumulado tiene más de una variante. Seleccione el expediente físico correcto.'
        :`${rows.length} variantes encontradas. Seleccione la extensión correcta.`;

    renderExpSearchChoices(rows);

  }catch(error){
    if(isCurrent()){
      el('expSearchStatus').textContent=error?.message||String(error);
    }
  }finally{
    if(isCurrent()){
      btn.disabled=false;
      btn.textContent='🔎 Buscar';
    }
  }
}

async function loadExpedienteSearchDetail(expedienteId,originalAccumulated=''){
  expedienteId=String(expedienteId||'').trim();
  if(!expedienteId)return;

  const lookupContext=expSearchContextById.get(expedienteId)||null;

  expSearchCurrentId=expedienteId;
  el('expSearchChoices').innerHTML='';
  el('expSearchResult').classList.remove('hidden');
  el('expSearchResult').innerHTML='<div class="exp-search-empty">Cargando información del expediente...</div>';

  try{
    const [expResult,linkResult,movementResult]=await Promise.all([
      sb.from('expedientes').select('*').eq('id',expedienteId).single(),
      sb.from('solicitud_expedientes')
        .select('*')
        .eq('expediente_id',expedienteId)
        .order('created_at',{ascending:false}),
      sb.from('movimientos_prestamo')
        .select('*')
        .eq('expediente_id',expedienteId)
        .order('created_at',{ascending:false})
    ]);

    if(expResult.error||linkResult.error||movementResult.error){
      throw expResult.error||linkResult.error||movementResult.error;
    }

    const rawRecord=expResult.data||{};
    const links=linkResult.data||[];
    const movements=movementResult.data||[];

    const enrichedRows=await attachLatestMovementToRecords([rawRecord]);
    const record=enrichedRows[0]||rawRecord;

    await loadAccumulatedForPrincipalIds([expedienteId],true);
    const acumulados=accumulatedRowsForPrincipal(expedienteId);

    const listMap=await loadMasterArchiveListStatus(true);
    const listInfo=listMap.get(expedienteId)||{};

    const requestIds=[...new Set([
      ...links.map(x=>x.solicitud_id),
      ...movements.map(x=>x.solicitud_id)
    ].filter(Boolean))];

    let requests=[];
    if(requestIds.length){
      let requestQuery=sb
        .from('solicitudes_prestamo')
        .select('*')
        .in('id',requestIds);

      // Perfil USUARIO: el buscador puede localizar el expediente,
      // pero el historial detallado debe mostrar únicamente sus propias
      // solicitudes, respetando la regla general de privacidad del sistema.
      if(isLimitedUser() && currentProfile?.nombre_personal){
        requestQuery=requestQuery.eq(
          'solicitante',
          currentProfile.nombre_personal
        );
      }

      const result=await requestQuery;

      if(!result.error)requests=result.data||[];
    }

    const requestMap=new Map(requests.map(r=>[String(r.id||''),r]));
    const linkMap=new Map();
    links.forEach(link=>{
      const key=String(link.solicitud_id||'');
      if(key && !linkMap.has(key))linkMap.set(key,link);
    });

    const movementMap=new Map();
    movements.forEach(m=>{
      const key=String(m.solicitud_id||'');
      if(!key)return;
      if(!movementMap.has(key))movementMap.set(key,[]);
      movementMap.get(key).push(m);
    });

    const visibleRequestIds=isLimitedUser()
      ?requestIds.filter(requestId=>requestMap.has(String(requestId)))
      :requestIds;

    const cycles=visibleRequestIds.map(requestId=>({
      id:String(requestId),
      request:requestMap.get(String(requestId))||{},
      link:linkMap.get(String(requestId))||{},
      movements:movementMap.get(String(requestId))||[]
    })).sort((a,b)=>{
      const da=a.request.fecha_solicitud||a.request.created_at||a.link.created_at||0;
      const db=b.request.fecha_solicitud||b.request.created_at||b.link.created_at||0;
      return new Date(db)-new Date(da);
    });

    const latestMovement=expSearchLatestMovement(movements);

    const currentState=
      lookupContext?.estado_operativo||
      lookupContext?.ultimo_estado||
      estadoOperativoDesdeMovimientos(record,movements)||
      operationalStatus(record)||
      record.estado||
      '—';

    const currentResponsible=
      lookupContext?.responsable_actual||
      lookupContext?.responsable||
      latestMovement?.hacia||
      currentResponsibleDisplay(record)||
      record.responsable||
      record.responsable_actual||
      '—';

    const currentStateDate=
      lookupContext?.fecha_ultimo_estado||
      requestLatestStateDateValue(lookupContext||{})||
      masterCurrentStateDateValue(record)||
      latestMovement?.created_at||
      null;

    const sedeRecord={
      ...record,
      listado_numero:listInfo.listado_numero||'',
      listado_estado:listInfo.listado_estado||'',
      destino_archivo_listado:listInfo.destino_archivo||'',
      listado_enviado_at:listInfo.enviado_at||null
    };

    const sede=masterSedeValue(sedeRecord)||record.ubicacion_comunicada||record.responsable||'—';
    const listado=listInfo.listado_numero||'NO INCORPORADO A LISTADO';
    const listadoEstado=listInfo.listado_estado||'—';
    const fechaEnvio=listInfo.enviado_at||null;

    const accumHtml=acumulados.length
      ?`<details class="exp-search-accumulated">
          <summary>▸ ${acumulados.length} acumulado${acumulados.length===1?'':'s'}</summary>
          <div class="exp-search-accumulated-list">
            ${acumulados.map(a=>`
              <span class="exp-search-accumulated-tag">
                ${esc(a.numero_acumulado||'—')} · ${esc(a.extension||'SIN EXTENSIÓN')}
              </span>
            `).join('')}
          </div>
        </details>`
      :`<div class="exp-search-accumulated">
          <b style="color:#315b98">Sin expedientes acumulados registrados.</b>
        </div>`;

    const originNote=originalAccumulated
      ?`<span class="exp-search-origin">
          Búsqueda realizada por acumulado: ${esc(originalAccumulated)}
        </span>`
      :'';

    el('expSearchStatus').textContent=
      `${record.expediente||'—'} · ${record.extension||'SIN EXTENSIÓN'} · ${cycles.length} atención${cycles.length===1?'':'es'} registrada${cycles.length===1?'':'s'}.`;

    el('expSearchResult').innerHTML=`
      <div class="exp-search-headline">
        <div>
          <div class="exp-search-title">
            ${esc(record.expediente||'—')} · ${esc(record.extension||'SIN EXTENSIÓN')}
          </div>
          <div class="exp-search-subtitle">
            Expediente físico identificado por N.° + extensión.
          </div>
          ${originNote}
        </div>
        <button class="btn secondary small"
                type="button"
                onclick="showExpHistory('${esc(expedienteId)}')"
                title="Consultar en solo lectura los ciclos y movimientos permitidos para su perfil">
          Ver historial del expediente
        </button>
      </div>

      <div class="exp-search-summary-grid">
        ${expSearchKpi('Expediente',esc(record.expediente||'—'),'emphasis')}
        ${expSearchKpi('Extensión',esc(record.extension||'SIN EXTENSIÓN'),'emphasis')}
        ${expSearchKpi('Última R.D.',esc(expSearchValue(record.rd)))}
        ${expSearchKpi('N.° de folios',esc(expSearchValue(record.ultimo_folio)))}

        ${expSearchKpi('Estado actual',esc(expSearchValue(currentState)))}
        ${expSearchKpi('Responsable actual / ubicación',esc(expSearchValue(currentResponsible)),'emphasis')}
        ${expSearchKpi('Ubicación / sede',esc(expSearchValue(sede)),norm(sede)==='SAN LUIS'?'san-luis':'')}
        ${expSearchKpi(
          'Fecha / hora último estado',
          currentStateDate?esc(expSearchDateTime(currentStateDate)):'—'
        )}

        ${expSearchKpi(
          'Listado',
          listInfo.listado_numero
            ?`${esc(listado)}<br><small>${esc(listadoEstado)}</small>`
            :'NO INCORPORADO A LISTADO',
          listInfo.listado_numero?'listed':''
        )}
        ${expSearchKpi(
          'Fecha de envío a San Luis',
          fechaEnvio?esc(expSearchDateTime(fechaEnvio)):'—',
          fechaEnvio?'san-luis':''
        )}
        ${expSearchKpi('Digitalizado',esc(expSearchValue(record.digitalizado||record.digitalizacion)))}
        ${expSearchKpi(
          isLimitedUser()?'Mis solicitudes':'Total de atenciones',
          String(cycles.length)
        )}
      </div>

      ${accumHtml}

      <div style="margin-top:16px;margin-bottom:8px">
        <strong style="font-size:14px;color:#173f6b">
          ${isLimitedUser()?'Mis atenciones del expediente':'Historial de atenciones'}
        </strong>
        <div class="note" style="margin-top:3px">
          ${isLimitedUser()
            ?'Se muestran únicamente las solicitudes registradas a su nombre, de la más reciente a la más antigua.'
            :'Cada solicitud se presenta como un ciclo independiente, de la más reciente a la más antigua.'
          }
        </div>
      </div>

      <div class="exp-search-cycles">
        ${cycles.length
          ?cycles.map((cycle,index)=>expSearchCycleCard(cycle,index,cycles.length,record)).join('')
          :(isLimitedUser()
            ?'<div class="exp-search-empty">El expediente fue localizado, pero no tiene solicitudes registradas a su nombre.</div>'
            :'<div class="exp-search-empty">Este expediente todavía no tiene solicitudes registradas.</div>')
        }
      </div>
    `;

  }catch(error){
    el('expSearchResult').innerHTML=
      `<div class="exp-search-empty">
        No se pudo cargar la información.<br>
        <b>${esc(error?.message||String(error))}</b>
      </div>`;
  }
}



// ============================================================
// V180 · REGISTRO MAESTRO: BÚSQUEDA RÁPIDA
//
// Cuando el Registro Maestro ya cargó su conjunto completo, las siguientes
// búsquedas y cambios de filtros se resuelven primero en memoria.
// Evita volver a consultar y enriquecer todos los registros en Supabase
// por cada tecla escrita.
//
// La caché dura 60 segundos y se invalida cuando cambia la custodia,
// los listados archivísticos u otra operación relevante.
// ============================================================
const V180_MASTER_CACHE_TTL=60000;
let v180MasterBaseCache={
  key:'',
  savedAt:0,
  rows:[],
  totalGeneral:0,
  serverTotal:0
};

function invalidateMasterFastCacheV180(){
  v180MasterBaseCache={
    key:'',
    savedAt:0,
    rows:[],
    totalGeneral:0,
    serverTotal:0
  };
}

function v180MasterBaseKey(){
  return [
    String(el('allOwnerFilter')?.value||'').trim(),
    String(el('allModeFilter')?.value||'').trim()
  ].join('|');
}

function v180MasterSearchText(value){
  return String(value??'')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g,'')
    .toUpperCase()
    .replace(/\s+/g,' ')
    .trim();
}

function v180MasterRowHaystack(row){
  if(!row)return '';

  const parts=[];

  const visit=value=>{
    if(value===null||value===undefined)return;

    if(Array.isArray(value)){
      value.forEach(visit);
      return;
    }

    if(typeof value==='object'){
      Object.values(value).forEach(visit);
      return;
    }

    if(
      typeof value==='string' ||
      typeof value==='number' ||
      typeof value==='boolean'
    ){
      parts.push(String(value));
    }
  };

  visit(row);
  return v180MasterSearchText(parts.join(' '));
}

function v180MasterMatchesSearch(row,rawSearch){
  const query=v180MasterSearchText(rawSearch);
  if(!query)return true;

  // Permite buscar varias palabras sin exigir que estén juntas.
  // Ej.: "0007 2026", "HANS PRESTAMO", "ACCESO INFORMACION".
  const tokens=query.split(' ').filter(Boolean);
  const haystack=row.__v180_search_text||v180MasterRowHaystack(row);

  if(!row.__v180_search_text){
    try{
      Object.defineProperty(row,'__v180_search_text',{
        value:haystack,
        writable:true,
        configurable:true,
        enumerable:false
      });
    }catch(_){
      row.__v180_search_text=haystack;
    }
  }

  return tokens.every(token=>haystack.includes(token));
}

function v180BuildMasterDatasetFromRows(
  orderedRows,
  totalGeneral,
  serverTotal,
  originalSearch
){
  const selectedMonth=(el('allMonthFilter')?.value||'').trim();

  // Primero buscar localmente. Después se calculan los meses y días,
  // exactamente sobre los registros que coinciden con la búsqueda.
  const searched=(orderedRows||[]).filter(row=>
    v180MasterMatchesSearch(row,originalSearch)
  );

  const months=new Map();
  const days=new Map();

  searched.forEach(row=>{
    const date=masterRequestDateKey(row.fecha_solicitud);
    if(!date)return;

    const month=date.slice(0,7);

    months.set(
      month,
      (months.get(month)||0)+1
    );

    if(!selectedMonth || month===selectedMonth){
      days.set(
        date,
        (days.get(date)||0)+1
      );
    }
  });

  const monthRows=[...months]
    .sort((a,b)=>b[0].localeCompare(a[0]))
    .map(([mes,cantidad])=>({mes,cantidad}));

  const dayRows=[...days]
    .sort((a,b)=>b[0].localeCompare(a[0]))
    .map(([fecha,cantidad])=>({fecha,cantidad}));

  const stateFiltered=searched
    .filter(masterMatchesLatestState)
    .filter(r=>
      !selectedMonth ||
      masterRequestDateKey(r.fecha_solicitud)
        .slice(0,7)===selectedMonth
    );

  const partialDays=
    selectedMonth &&
    masterDayMonthKey===selectedMonth &&
    masterAvailableDays.length>0 &&
    masterSelectedDays.size!==masterAvailableDays.length;

  const filtered=stateFiltered
    .filter(r=>
      !partialDays ||
      masterSelectedDays.has(
        masterRequestDateKey(r.fecha_solicitud)
      )
    )
    .filter(masterMatchesSede);

  const physicalIds=new Set(
    filtered.map(r=>String(r.id||'')).filter(Boolean)
  );

  // Si la coincidencia provino de un acumulado, marcarla visualmente.
  const exactAccumulated=/^\d+-\d{4}$/i.test(String(originalSearch||'').trim())
    ?String(originalSearch||'').trim()
    :'';

  if(exactAccumulated){
    filtered.forEach(row=>{
      const acc=Array.isArray(row?._acumulados)?row._acumulados:[];
      const found=acc.some(a=>
        v180MasterSearchText(a?.numero_acumulado||'')===
        v180MasterSearchText(exactAccumulated)
      );
      if(found){
        row._master_search_by_accumulated=true;
        row._master_accumulated_search_number=exactAccumulated;
      }
    });
  }

  return {
    rows:filtered,
    allRows:stateFiltered,
    totalGeneral:Number(totalGeneral||0),
    serverTotal:Number(serverTotal||0),
    physicalCount:physicalIds.size,
    cycleCount:filtered.filter(r=>r._master_cycle).length,
    monthRows,
    dayRows,
    _v180Local:true
  };
}

function v180CachedMasterDataset(originalSearch){
  const cache=v180MasterBaseCache;
  const valid=
    cache.key===v180MasterBaseKey() &&
    cache.rows.length>0 &&
    (Date.now()-cache.savedAt)<V180_MASTER_CACHE_TTL;

  if(!valid)return null;

  return v180BuildMasterDatasetFromRows(
    cache.rows,
    cache.totalGeneral,
    cache.serverTotal,
    originalSearch
  );
}

async function fetchMasterOperationalDataset(){

  const params=masterParams(1000,0,{ignoreState:true});
  const selectedMonth=params.p_mes||'';
  const originalSearch=cleanSearch(el('allSearch')?.value||'')||'';

  // V180 · Si el Registro Maestro completo fue cargado recientemente,
  // buscar y filtrar localmente. Esto elimina la espera entre tecla y tecla.
  const cachedDataset=v180CachedMasterDataset(originalSearch);
  if(cachedDataset){
    return cachedDataset;
  }

  // V57 · Si el número buscado es un expediente ACUMULADO,
  // la RPC antigua no lo conoce porque solo busca en expedientes físicos.
  // En ese caso cargamos el conjunto físico y luego nos quedamos
  // únicamente con el/los UUID principales vinculados al acumulado.
  const accumulatedSearch=await resolveMasterAccumulatedSearch(originalSearch);

  if(accumulatedSearch){
    params.p_busqueda=null;
  }

  // El mes se aplica después sobre la fecha DE CADA CICLO.
  params.p_mes=null;

  const physicalRows=[];
  let totalGeneral=0;
  let serverTotal=0;

  for(let offset=0;;offset+=1000){
    const {data,error}=await sb.rpc(
      'buscar_registro_maestro_v5',
      {...params,p_offset:offset}
    );

    if(error)throw error;

    const result=data||{};
    const rows=Array.isArray(result.rows)
      ?result.rows
      :[];

    if(offset===0){
      totalGeneral=Number(result.total_general||0);
      serverTotal=Number(result.total_encontrados||0);
    }

    physicalRows.push(
      ...rows.map(masterNormalizeRow)
    );

    if(
      rows.length<1000 ||
      physicalRows.length>=serverTotal
    ){
      break;
    }
  }

  // V57 · La búsqueda por acumulado se resuelve por el UUID físico
  // principal. Esto respeta la regla N.° de expediente + extensión
  // y evita mezclar variantes con el mismo número.
  let resolvedPhysicalRows=physicalRows;

  if(accumulatedSearch?.principalIds?.size){
    resolvedPhysicalRows=physicalRows.filter(row=>
      accumulatedSearch.principalIds.has(
        String(row.id||row.expediente_id||'')
      )
    );
  }

  // 1. Enriquecimiento físico actual del expediente.
  let base=await attachLatestMovementToRecords(resolvedPhysicalRows);
  // V171: responsable/ubicación física actual provienen de una sola fuente
  // canónica. Los ciclos históricos se expanden DESPUÉS y conservan sus datos.
  base=await applyV171CanonicalCustody(base,{overwriteResponsible:true,overwriteLocation:true});
  base=masterApplyLatestOperationalState(base);
  base=await enrichMasterPendingRequestData(base);

  // 2. EXPANSIÓN: un expediente físico puede producir varias filas,
  //    una por cada solicitud histórica.
  let dated=await expandMasterRowsByRequestCycles(base);

  // 3. Listado / sede siguen siendo datos del expediente físico.
  dated=await enrichMasterArchiveListStatus(dated);

  // 3.1. Acumulados: pertenecen al expediente físico principal.
  dated=await enrichMasterAccumulatedRows(dated);

  if(accumulatedSearch){
    dated=dated.map(row=>({
      ...row,
      _master_search_by_accumulated:true,
      _master_accumulated_search_number:accumulatedSearch.numero
    }));
  }

  // 4. V18: completar asunto, responsable de atención, última
  // reasignación, devolución y demás columnas operativas por ciclo.
  dated=await enrichMasterOperationalColumnsV18(dated);

  const ordered=sortMasterByRequestDate(dated);

  // V180 · Guardar la base completa ya enriquecida.
  // Solo se guarda cuando no existe texto de búsqueda; así la caché sirve
  // para búsquedas posteriores sin perder registros.
  if(!originalSearch){
    v180MasterBaseCache={
      key:v180MasterBaseKey(),
      savedAt:Date.now(),
      rows:ordered,
      totalGeneral:Number(totalGeneral||0),
      serverTotal:Number(serverTotal||0)
    };
  }

  const months=new Map();
  const days=new Map();

  ordered.forEach(row=>{
    const date=masterRequestDateKey(row.fecha_solicitud);
    if(!date)return;

    const month=date.slice(0,7);

    months.set(
      month,
      (months.get(month)||0)+1
    );

    if(!selectedMonth || month===selectedMonth){
      days.set(
        date,
        (days.get(date)||0)+1
      );
    }
  });

  const monthRows=[...months]
    .sort((a,b)=>b[0].localeCompare(a[0]))
    .map(([mes,cantidad])=>({mes,cantidad}));

  const dayRows=[...days]
    .sort((a,b)=>b[0].localeCompare(a[0]))
    .map(([fecha,cantidad])=>({fecha,cantidad}));

  const stateFiltered=ordered
    .filter(masterMatchesLatestState)
    .filter(r=>
      !selectedMonth ||
      masterRequestDateKey(r.fecha_solicitud)
        .slice(0,7)===selectedMonth
    );

  const partialDays=
    selectedMonth &&
    masterDayMonthKey===selectedMonth &&
    masterAvailableDays.length>0 &&
    masterSelectedDays.size!==masterAvailableDays.length;

  const filtered=stateFiltered
    .filter(r=>
      !partialDays ||
      masterSelectedDays.has(
        masterRequestDateKey(r.fecha_solicitud)
      )
    )
    .filter(masterMatchesSede);

  const physicalIds=new Set(
    filtered.map(r=>String(r.id||'')).filter(Boolean)
  );

  return {
    rows:filtered,
    allRows:stateFiltered,

    // Conteo físico permanece separado del conteo de ciclos.
    totalGeneral,
    serverTotal,
    physicalCount:physicalIds.size,
    cycleCount:filtered.filter(r=>r._master_cycle).length,

    monthRows,
    dayRows
  };
}
function toggleMasterAdvanced(){
  el('allAdvancedFilters')?.classList.toggle('hidden');
  populateMasterFilters();
  renderMasterDayFilter();
}

async function resetAllAndLoad(){
  allPage=0;
  await loadAll();
}

async function changeMasterMonth(){
  masterDayMonthKey='';
  masterAvailableDays=[];
  masterSelectedDays=new Set();
  closeMasterDayPanel();
  updateMasterDayFilterText();

  allPage=0;
  await loadAll();
}

async function clearMasterFilters(){
  if(el('allSearch'))el('allSearch').value='';
  masterSelectedStates=new Set(masterStateOptions());
  renderMasterStateFilter();
  if(el('allOwnerFilter'))el('allOwnerFilter').value='';
  if(el('allSedeFilter'))el('allSedeFilter').value='';
  if(el('allModeFilter'))el('allModeFilter').value='';
  if(el('allMonthFilter'))el('allMonthFilter').value='';

  masterDayMonthKey='';
  masterAvailableDays=[];
  masterSelectedDays=new Set();
  closeMasterDayPanel();
  renderMasterDayFilter();

  allPage=0;
  await loadAll();
}

let masterArchiveListStatusCache=new Map();
let masterArchiveListStatusCacheAt=0;

let masterArchiveListHeaderCache=new Map();
let masterArchiveListHeaderCacheAt=0;

let masterArchiveCycleBindingCache=new Map();
let masterArchiveCycleBindingCacheAt=0;

function invalidateMasterArchiveListCaches(){
  masterArchiveListStatusCache=new Map();
  masterArchiveListStatusCacheAt=0;

  if(typeof invalidateMasterFastCacheV180==='function'){
    invalidateMasterFastCacheV180();
  }

  masterArchiveListHeaderCache=new Map();
  masterArchiveListHeaderCacheAt=0;

  masterArchiveCycleBindingCache=new Map();
  masterArchiveCycleBindingCacheAt=0;
}

function masterCycleBindingKey(cycleId){
  return String(cycleId||'').trim();
}

function masterCycleReturnBoundary(r){
  return (
    r?.master_fecha_devolucion||
    r?.fecha_devolucion||
    r?.ultimo_movimiento_fecha||
    r?.fecha_solicitud||
    r?.solicitud_created_at||
    null
  );
}

function masterCycleNewerBoundary(r){
  return r?._master_cycle_newer_start||null;
}

function archiveListTimestamp(info,header){
  return (
    info?.enviado_at||
    header?.enviado_at||
    header?.generado_at||
    header?.fecha_generacion||
    header?.created_at||
    header?.updated_at||
    null
  );
}

function archiveListBelongsToCycle(r,info,header,binding=null){
  if(!r?._master_cycle)return true;

  const cycleId=masterCycleBindingKey(r._master_cycle_id);

  // Fuente principal desde V116: vínculo persistente CICLO -> LISTADO.
  if(binding && cycleId){
    return (
      masterCycleBindingKey(binding.solicitud_expediente_id)===cycleId
    );
  }

  // Compatibilidad con listados históricos previos a V116.
  // Solo aceptar el listado físico si su fecha cae dentro de ESTE ciclo.
  const listTime=archiveListTimestamp(info,header);

  if(listTime){
    const listMs=new Date(listTime).getTime();
    const returnMs=new Date(masterCycleReturnBoundary(r)||0).getTime();
    const newerMs=new Date(masterCycleNewerBoundary(r)||0).getTime();

    if(!isNaN(returnMs) && returnMs>0 && listMs<returnMs){
      return false;
    }

    if(!isNaN(newerMs) && newerMs>0 && listMs>=newerMs){
      return false;
    }

    return true;
  }

  // Si el expediente solo tuvo un ciclo, no existe riesgo de herencia.
  // Con varios ciclos y sin fecha verificable, preferimos NO heredar.
  return Number(r?._master_cycle_total||0)<=1;
}

async function loadArchiveListHeaders(force=false){
  if(!hasFullAccess()||!sb||!session)return new Map();

  const now=Date.now();

  if(
    !force &&
    masterArchiveListHeaderCache.size &&
    now-masterArchiveListHeaderCacheAt<30000
  ){
    return masterArchiveListHeaderCache;
  }

  try{
    const {data,error}=await sb.rpc(
      'listar_listados_devolucion_archivo_v2'
    );

    if(error)throw error;

    const map=new Map();

    (data||[]).forEach(h=>{
      const numero=String(h.numero||'').trim();
      if(!numero)return;
      map.set(numero,h);
    });

    masterArchiveListHeaderCache=map;
    masterArchiveListHeaderCacheAt=now;

    return map;
  }catch(error){
    console.warn(
      'Cabeceras de listados:',
      error?.message||error
    );

    return masterArchiveListHeaderCache;
  }
}

async function loadMasterCycleListBindings(rows,force=false){
  if(!hasFullAccess()||!sb||!session)return new Map();

  const cycleIds=[...new Set(
    (rows||[])
      .map(r=>masterCycleBindingKey(
        r?._master_cycle_id||
        r?.solicitud_expediente_id||
        ''
      ))
      .filter(Boolean)
  )];

  if(!cycleIds.length)return new Map();

  const now=Date.now();

  if(
    !force &&
    masterArchiveCycleBindingCache.size &&
    now-masterArchiveCycleBindingCacheAt<30000 &&
    cycleIds.every(id=>masterArchiveCycleBindingCache.has(id))
  ){
    return masterArchiveCycleBindingCache;
  }

  try{
    const {data,error}=await sb.rpc(
      'listar_vinculos_listado_ciclo',
      {
        p_ciclos:cycleIds
      }
    );

    if(error)throw error;

    const map=new Map(masterArchiveCycleBindingCache);

    (data||[]).forEach(r=>{
      const cycleId=masterCycleBindingKey(
        r?.solicitud_expediente_id
      );

      if(cycleId){
        map.set(cycleId,r);
      }
    });

    masterArchiveCycleBindingCache=map;
    masterArchiveCycleBindingCacheAt=now;

    return map;
  }catch(error){
    // Compatibilidad: el HTML sigue funcionando antes de ejecutar V116.
    console.warn(
      'Vínculos Listado/Ciclo:',
      error?.message||error
    );

    return masterArchiveCycleBindingCache;
  }
}

async function loadMasterArchiveListStatus(force=false){
  if(!hasFullAccess()||!sb||!session)return new Map();

  const now=Date.now();

  if(
    !force &&
    masterArchiveListStatusCache.size &&
    now-masterArchiveListStatusCacheAt<30000
  ){
    return masterArchiveListStatusCache;
  }

  try{
    let {data,error}=await sb.rpc(
      'listar_estado_listado_expedientes'
    );

    // Compatibilidad temporal si todavía no se ejecutó el SQL anterior.
    if(error){
      const fallback=await sb.rpc(
        'listar_devueltos_para_listado'
      );
      data=fallback.data;
      error=fallback.error;
    }

    if(error)throw error;

    const map=new Map();

    (data||[]).forEach(r=>{
      const id=String(r.id||r.expediente_id||'');
      if(!id)return;

      map.set(id,{
        listado_numero:r.listado_numero||'',
        listado_estado:r.listado_estado||'',
        destino_archivo:r.destino_archivo||'',
        enviado_at:r.enviado_at||null,
        devuelto_por:r.devuelto_por||''
      });
    });

    masterArchiveListStatusCache=map;
    masterArchiveListStatusCacheAt=now;

    return map;

  }catch(error){
    console.warn(
      'Estado de listado en Registro Maestro:',
      error?.message||error
    );

    return masterArchiveListStatusCache;
  }
}

function resolvedArchiveListInfoForCycle(
  r,
  physicalInfo,
  bindings,
  headers
){
  const empty={
    listado_numero:'',
    listado_estado:'',
    destino_archivo:'',
    enviado_at:null,
    devuelto_por:'',
    currentCycle:false
  };

  if(!r?._master_cycle){
    return {
      ...physicalInfo,
      currentCycle:true
    };
  }

  const cycleId=masterCycleBindingKey(r._master_cycle_id);
  const binding=cycleId
    ?bindings.get(cycleId)
    :null;

  // Vínculo explícito creado desde V116.
  if(binding?.listado_numero){
    const numero=String(binding.listado_numero).trim();
    const header=headers.get(numero)||{};

    return {
      listado_numero:numero,
      listado_estado:
        header.estado||
        binding.listado_estado||
        '',
      destino_archivo:
        header.destino||
        binding.destino||
        '',
      enviado_at:
        header.enviado_at||
        binding.enviado_at||
        null,
      devuelto_por:
        physicalInfo?.devuelto_por||
        '',
      currentCycle:true,
      source:'CYCLE_BINDING'
    };
  }

  // Compatibilidad con listados generados antes de V116.
  const physicalNumber=String(
    physicalInfo?.listado_numero||
    ''
  ).trim();

  if(!physicalNumber){
    return empty;
  }

  const header=headers.get(physicalNumber)||{};

  if(
    !archiveListBelongsToCycle(
      r,
      physicalInfo,
      header,
      null
    )
  ){
    return {
      ...empty,
      source:'PREVIOUS_CYCLE'
    };
  }

  return {
    listado_numero:physicalNumber,
    listado_estado:
      physicalInfo?.listado_estado||
      header.estado||
      '',
    destino_archivo:
      physicalInfo?.destino_archivo||
      header.destino||
      '',
    enviado_at:
      physicalInfo?.enviado_at||
      header.enviado_at||
      null,
    devuelto_por:
      physicalInfo?.devuelto_por||
      '',
    currentCycle:true,
    source:'LEGACY_INFERRED'
  };
}

async function enrichMasterArchiveListStatus(rows){
  if(!Array.isArray(rows)||!rows.length||!hasFullAccess()){
    return rows||[];
  }

  const [
    physicalMap,
    bindings,
    headers
  ]=await Promise.all([
    loadMasterArchiveListStatus(),
    loadMasterCycleListBindings(rows),
    loadArchiveListHeaders()
  ]);

  return rows.map(r=>{
    const state=norm(
      r?.estado_operativo||
      r?.estado||
      operationalStatus(r)||
      ''
    );

    const returned=state==='DEVUELTO AL ARCHIVO';

    const physicalInfo=
      physicalMap.get(
        String(r.id||r.expediente_id||'')
      )||{};

    // Un ciclo abierto nunca hereda Listado/Sede/Fecha de envío.
    if(r?._master_cycle && !masterCycleIsClosed(r)){
      return {
        ...r,
        listado_numero:'',
        listado_estado:'',
        destino_archivo_listado:'',
        listado_enviado_at:null,
        devuelto_por:'',
        devuelto_por_maestro:'',
        _master_cycle_devuelto_por:'',
        _master_cycle_list_current:false
      };
    }

    if(r?._master_cycle){
      const closedByReturn=
        masterCycleIsClosed(r) &&
        returned;

      const cycleReturner=closedByReturn
        ?String(
            r?._master_cycle_devuelto_por||
            (
              norm(r?.ultimo_movimiento||'').includes('DEVOLUCIÓN CONFIRMADA') ||
              norm(r?.ultimo_movimiento||'').includes('DEVOLUCION CONFIRMADA') ||
              norm(r?.ultimo_movimiento||'').includes('RECIBIDO EN ARCHIVO')
                ?(r?.ultimo_movimiento_desde||'')
                :''
            )||
            ''
          ).trim()
        :'';

      if(!closedByReturn){
        return {
          ...r,
          listado_numero:'',
          listado_estado:'',
          destino_archivo_listado:'',
          listado_enviado_at:null,
          devuelto_por:cycleReturner,
          devuelto_por_maestro:cycleReturner,
          _master_cycle_devuelto_por:cycleReturner,
          _master_cycle_list_current:false
        };
      }

      const cycleInfo=resolvedArchiveListInfoForCycle(
        r,
        physicalInfo,
        bindings,
        headers
      );

      return {
        ...r,

        listado_numero:
          cycleInfo.listado_numero||
          '',

        listado_estado:
          cycleInfo.listado_estado||
          '',

        destino_archivo_listado:
          cycleInfo.destino_archivo||
          '',

        listado_enviado_at:
          cycleInfo.enviado_at||
          null,

        devuelto_por:cycleReturner,
        devuelto_por_maestro:cycleReturner,
        _master_cycle_devuelto_por:cycleReturner,

        // Si es false, este ciclo debe iniciar un NUEVO listado.
        _master_cycle_list_current:
          !!cycleInfo.currentCycle,

        _master_cycle_list_source:
          cycleInfo.source||
          'NONE'
      };
    }

    const hasList=!!physicalInfo.listado_numero;

    if(!returned && !hasList){
      return {
        ...r,
        listado_numero:'',
        listado_estado:'',
        destino_archivo_listado:'',
        listado_enviado_at:null,
        devuelto_por_maestro:''
      };
    }

    return {
      ...r,
      listado_numero:
        physicalInfo.listado_numero||
        '',
      listado_estado:
        physicalInfo.listado_estado||
        '',
      destino_archivo_listado:
        physicalInfo.destino_archivo||
        '',
      listado_enviado_at:
        physicalInfo.enviado_at||
        null,
      devuelto_por_maestro:
        physicalInfo.devuelto_por||
        (
          norm(r.ultimo_movimiento_hacia||'').includes('ARCHIVO')
            ?(r.ultimo_movimiento_desde||'')
            :''
        )
    };
  });
}

function expedienteYearValue(value){
  const s=String(value||'').trim();
  const m=s.match(/-(\d{4})(?:\D|$)/);
  return m?Number(m[1]):null;
}

function isSanLuisArchiveRange(r){
  const year=expedienteYearValue(r?.expediente||r?.numero_expediente||'');
  return Number.isInteger(year) && year>=1995 && year<=2016;
}

function masterSedeValue(r){
  // Un ciclo activo no hereda la sede histórica.
  if(r?._master_cycle && !masterCycleIsClosed(r)){
    return '';
  }

  const state=norm(
    r?.estado_operativo||
    r?.estado||
    operationalStatus(r)||
    ''
  );

  // V116:
  // Si ESTE ciclo acaba de volver a Archivo y todavía no se ha creado
  // un nuevo listado, debe quedar físicamente en BARRENECHEA.
  // No reutilizar SAN LUIS del ciclo anterior.
  if(
    r?._master_cycle &&
    masterCycleIsClosed(r) &&
    state==='DEVUELTO AL ARCHIVO' &&
    r?._master_cycle_list_current===false
  ){
    return 'BARRENECHEA';
  }

  const listDestination=norm(r?.destino_archivo_listado||'');
  const listStatus=norm(r?.listado_estado||'');
  const responsable=norm(r?.responsable||r?.responsable_operativo||'');

  // 1. Expedientes 1995-2016 incluidos en un listado para SAN LUIS:
  //    hasta que el listado salga físicamente, siguen en BARRENECHEA.
  if(
    isSanLuisArchiveRange(r) &&
    listDestination==='SAN LUIS' &&
    r?.listado_numero
  ){
    return listStatus==='ENVIADO A SAN LUIS'
      ?'SAN LUIS'
      :'BARRENECHEA';
  }

  // 2. Expediente ya enviado físicamente y registrado en SAN LUIS.
  if(responsable==='SAN LUIS' || responsable.includes('SAN LUIS')){
    return 'SAN LUIS';
  }

  // 3. BARRENECHEA se muestra cuando el expediente está físicamente
  //    en Archivo, ya sea por devolución confirmada o por incorporación
  //    inicial al Registro Maestro en CUSTODIA.
  const custodyInArchive=
    ['DEVUELTO AL ARCHIVO','CUSTODIA'].includes(state) &&
    (
      responsable==='ARCHIVO' ||
      responsable.includes('ARCHIVO')
    );

  if(custodyInArchive){
    return 'BARRENECHEA';
  }

  // Para préstamos, reasignaciones, pendientes, devolución solicitada,
  // CONAS, DVC u otros estados, la columna SEDE no aplica.
  return '';
}

function masterSedeFilterValue(){
  return (el('allSedeFilter')?.value||'').trim();
}

function masterSedeFilterActive(){
  return !!masterSedeFilterValue();
}

function masterMatchesSede(r){
  const wanted=norm(masterSedeFilterValue());
  if(!wanted)return true;
  return norm(masterSedeValue(r))===wanted;
}

function masterSedeHtml(r){
  const sede=masterSedeValue(r);
  const status=norm(r?.listado_estado||'');
  const destinedToSanLuis=
    isSanLuisArchiveRange(r) &&
    norm(r?.destino_archivo_listado||'')==='SAN LUIS' &&
    !!r?.listado_numero;

  if(sede==='SAN LUIS'){
    const sentDate=r?.listado_enviado_at
      ?fmtDate(r.listado_enviado_at)
      :'';

    return `<span class="sede-badge san-luis">SAN LUIS</span>
            ${sentDate
              ?`<span class="sede-note sent">Enviado: ${esc(sentDate)}</span>`
              :(destinedToSanLuis
                ?'<span class="sede-note sent">Traslado confirmado</span>'
                :'')}`;
  }

  if(sede==='BARRENECHEA'){
    return `<span class="sede-badge barrenechea">BARRENECHEA</span>
            ${destinedToSanLuis && status!=='ENVIADO A SAN LUIS'
              ?'<span class="sede-note pending">Pendiente de traslado</span>'
              :'<span class="sede-note pending">En custodia de Archivo</span>'}`;
  }

  return '<span style="color:var(--muted)">—</span>';
}


function masterReturnedByHtml(r){
  const state=norm(r?.estado_operativo||r?.estado||operationalStatus(r)||'');

  // ==========================================================
  // DEVUELTO POR PERTENECE EXCLUSIVAMENTE AL CICLO MOSTRADO
  // ==========================================================
  // Una nueva solicitud nunca hereda la persona que devolvió el
  // expediente en una solicitud anterior del mismo expediente físico.
  //
  // Ejemplo:
  // MARCELA devuelve 1011-2025 -> queda en el ciclo anterior.
  // HANS genera nueva solicitud -> Devuelto por = —.
  // HANS devuelve ese nuevo ciclo -> Devuelto por = HANS HUARACA.

  if(r?._master_cycle){
    // Ciclo activo: por definición todavía no existe una devolución
    // confirmada de ESTE ciclo. Nunca usar datos físicos/históricos base.
    if(!masterCycleIsClosed(r)){
      return '<span style="color:var(--muted)">—</span>';
    }

    // Solo un ciclo cerrado por devolución puede mostrar "Devuelto por".
    if(state!=='DEVUELTO AL ARCHIVO'){
      return '<span style="color:var(--muted)">—</span>';
    }

    const action=norm(r?.ultimo_movimiento||'');
    const cyclePerson=String(
      r?._master_cycle_devuelto_por||
      r?.devuelto_por_maestro||
      (
        action.includes('DEVOLUCIÓN CONFIRMADA') ||
        action.includes('DEVOLUCION CONFIRMADA') ||
        action.includes('RECIBIDO EN ARCHIVO')
          ?(r?.ultimo_movimiento_desde||'')
          :''
      )||
      ''
    ).trim();

    return cyclePerson
      ?`<span class="returned-by-person"
              title="Persona que devolvió físicamente el expediente en esta solicitud">${esc(cyclePerson)}</span>`
      :'<span class="returned-by-person empty">SIN REGISTRO</span>';
  }

  // Fila física sin ciclos de solicitud: conservar compatibilidad con
  // expedientes antiguos que todavía no fueron expandidos por solicitud.
  const canShowPhysicalReturner=
    state==='DEVUELTO AL ARCHIVO' ||
    state==='CUSTODIA' ||
    !!r?.listado_numero ||
    !!r?.listado_enviado_at;

  if(!canShowPhysicalReturner){
    return '<span style="color:var(--muted)">—</span>';
  }

  const person=String(
    r?.devuelto_por_maestro||
    r?.devuelto_por||
    (
      norm(r?.ultimo_movimiento_hacia||'').includes('ARCHIVO')
        ?(r?.ultimo_movimiento_desde||'')
        :''
    )||
    ''
  ).trim();

  if(person){
    return `<span class="returned-by-person"
                  title="Persona que devolvió físicamente el expediente al Archivo">${esc(person)}</span>`;
  }

  return '<span class="returned-by-person empty">SIN REGISTRO</span>';
}

function masterArchiveListHtml(r){
  const state=norm(r?.estado_operativo||r?.estado||operationalStatus(r)||'');

  // V10: el ciclo activo empieza sin Listado.
  // El listado se conserva únicamente en la fila histórica cerrada.
  if(r?._master_cycle && !masterCycleIsClosed(r)){
    return '<span style="color:var(--muted)">—</span>';
  }

  if(r?.listado_numero){
    const rawDestination=String(r.destino_archivo_listado||'').trim()||'—';
    const destination=
      norm(rawDestination)==='SAN LUIS' && !isSanLuisArchiveRange(r)
        ?'BARRENECHEA'
        :rawDestination;
    const status=norm(r.listado_estado||'');
    const cls=status==='ENVIADO A SAN LUIS'
      ?'sent'
      :status==='GENERADO'
        ?'generated'
        :'prep';

    const displayStatus=status==='ENVIADO A SAN LUIS'
      ?'ENVIADO'
      :(status||'—');

    return `<span class="list-status ${cls}">${esc(r.listado_numero)}</span>
            <span class="list-destination"><b>Destino:</b> ${esc(destination)} · ${esc(displayStatus)}</span>`;
  }

  if(state==='DEVUELTO AL ARCHIVO'){
    if(
      r?._master_cycle &&
      r?._master_cycle_list_current===false
    ){
      return `<span class="list-status unlisted">SIN LISTAR</span>
              <span class="list-destination">NUEVO CICLO · REQUIERE NUEVO LISTADO</span>`;
    }

    return '<span class="list-status unlisted">SIN LISTAR</span>';
  }

  return '<span style="color:var(--muted)">—</span>';
}

function masterCurrentStateDateValue(r){
  const state=norm(r?.estado_operativo||r?.estado||operationalStatus(r)||'');

  // V111:
  // Siempre que exista, el timestamp real del movimiento tiene prioridad.
  // Campos como fecha_entrega o fecha_devolucion pueden contener únicamente
  // YYYY-MM-DD y por eso antes aparecía la hora como "—".
  const realMovementTime=
    r?.ultimo_movimiento_fecha||
    r?.fecha_ultimo_estado||
    null;

  // En una fila histórica, la fecha pertenece exclusivamente al ciclo.
  if(r?._master_cycle){
    if(state==='DEVUELTO AL ARCHIVO'){
      return (
        realMovementTime ||
        r.fecha_devolucion ||
        r.fecha_solicitud ||
        null
      );
    }

    if(state==='EN PRÉSTAMO'){
      return (
        realMovementTime ||
        r.fecha_entrega_ciclo ||
        r.fecha_solicitud ||
        null
      );
    }

    return (
      realMovementTime ||
      r.solicitud_created_at ||
      r.fecha_solicitud ||
      null
    );
  }

  if(state==='DEVUELTO AL ARCHIVO'){
    return (
      r?.fecha_aceptacion_devolucion ||
      realMovementTime ||
      r?.fecha_devolucion ||
      null
    );
  }

  if(state==='REASIGNADO'){
    return (
      realMovementTime ||
      r?.fecha_ultima_reasignacion ||
      r?.fecha_reasignacion ||
      null
    );
  }

  if(state==='EN PRÉSTAMO'){
    return (
      realMovementTime ||
      currentDeliveryDateValue(r) ||
      null
    );
  }

  if(
    state==='DERIVADO AL CONAS' ||
    state==='DERIVADO A LA DVC' ||
    state==='DERIVADO A INSTRUCCIÓN' ||
    state==='RETORNO DE INSTRUCCIÓN' ||
    state==='DEVOLUCIÓN SOLICITADA' ||
    state==='EN TRÁMITE'
  ){
    return (
      realMovementTime ||
      r?.fecha_solicitud_devolucion ||
      null
    );
  }

  if(state==='PENDIENTE POR ATENDER'){
    return (
      r?.solicitud_created_at ||
      realMovementTime ||
      r?.fecha_solicitud ||
      null
    );
  }

  if(state==='CUSTODIA'){
    // Si la custodia actual es SAN LUIS, la fecha relevante es
    // el envío que produjo ese nuevo estado.
    if(
      norm(masterSedeValue(r))==='SAN LUIS' &&
      r?.listado_enviado_at
    ){
      return r.listado_enviado_at;
    }

    return (
      r?.ultimo_movimiento_fecha ||
      r?.fecha_devolucion ||
      null
    );
  }

  if(
    state==='CERRADO POR ADMINISTRADOR' ||
    state==='CERRADO POR ARCHIVO'
  ){
    return (
      r?.ultimo_movimiento_fecha ||
      r?.fecha_devolucion ||
      null
    );
  }

  return (
    r?.ultimo_movimiento_fecha ||
    r?.updated_at ||
    r?.fecha_solicitud ||
    null
  );
}


function masterCycleTerminalState(value){
  return [
    'DEVUELTO',
    'DEVUELTO AL ARCHIVO',
    'COPIA DIGITAL ENTREGADA',
    'ENTREGA TOTAL',
    'CERRADO',
    'CERRADA',
    'CERRADO POR ARCHIVO',
    'CERRADA POR ARCHIVO',
    'CERRADO POR ADMINISTRADOR',
    'CERRADA POR ADMINISTRADOR',
    'CANCELADO',
    'CANCELADA',
    'ANULADO',
    'ANULADA'
  ].includes(norm(value||''));
}

// V521 · Una COPIA DIGITAL atendida es un ciclo documental cerrado.
// No altera el estado físico del expediente, pero visualmente debe usar
// el mismo color que una fila DEVUELTA AL ARCHIVO.
function masterDigitalCycleDelivered(r){
  if(norm(r?.modalidad)!=='COPIA DIGITAL')return false;

  const states=[
    r?.estado_solicitud_item,
    r?.solicitud_estado,
    r?.estado_atencion,
    r?.estado_ciclo,
    r?.estado
  ].map(v=>norm(v||''));

  return states.some(v=>
    v==='COPIA DIGITAL ENTREGADA' ||
    v==='ENTREGA TOTAL'
  );
}

function masterCycleIsClosed(r){
  if(!r?._master_cycle)return false;

  return !!r._cycle_closed ||
    masterCycleTerminalState(r.estado_solicitud_item) ||
    masterCycleTerminalState(r.solicitud_estado);
}

function masterCycleOperationalStatus(r){
  if(!r?._master_cycle)return '';

  if(masterDigitalCycleDelivered(r)){
    return 'ENTREGA TOTAL';
  }

  if(masterCycleIsClosed(r)){
    if(
      norm(r.estado_ciclo)==='CERRADO POR ADMINISTRADOR' ||
      ['CERRADO POR ADMINISTRADOR','CERRADA POR ADMINISTRADOR']
        .includes(norm(r.estado_solicitud_item||r.solicitud_estado||''))
    ){
      return 'CERRADO POR ADMINISTRADOR';
    }

    // Regla principal: una devolución confirmada queda congelada
    // como DEVUELTO AL ARCHIVO aunque luego exista otro pedido.
    if(
      norm(r.estado_ciclo)==='DEVUELTO AL ARCHIVO' ||
      ['DEVUELTO','DEVUELTO AL ARCHIVO']
        .includes(norm(r.estado_solicitud_item||''))
    ){
      return 'DEVUELTO AL ARCHIVO';
    }
  }

  return (
    r.estado_ciclo ||
    r.estado_solicitud_item ||
    r.solicitud_estado ||
    'PENDIENTE POR ATENDER'
  );
}

function masterCycleRowSelectable(r){
  if(!r?._master_cycle)return !r?._internal_reassign_requested;
  return !masterCycleIsClosed(r);
}

function masterCycleRowChecked(r){
  return masterCycleRowSelectable(r) &&
    selectedIds.has(r.id);
}

function masterCycleRowClass(r){
  if(!r?._master_cycle)return '';

  return masterCycleIsClosed(r)
    ?'master-cycle-row-closed'
    :'master-cycle-row-active';
}

function masterCycleBadgeHtml(r){
  if(!r?._master_cycle)return '';

  if(masterCycleIsClosed(r)){
    return '<span class="master-cycle-badge closed">CICLO CERRADO · SOLO LECTURA</span>';
  }

  return '<span class="master-cycle-badge active">CICLO ACTIVO</span>';
}

async function loadMasterCyclesForExpedientes(expedienteIds){
  const ids=[...new Set(
    (expedienteIds||[])
      .map(String)
      .filter(Boolean)
  )];

  if(!ids.length)return [];

  const result=[];

  // Mantener pequeños los lotes para no exceder el tamaño del request.
  for(let i=0;i<ids.length;i+=120){
    const chunk=ids.slice(i,i+120);

    const {data,error}=await sb.rpc(
      'listar_ciclos_registro_maestro',
      {p_expediente_ids:chunk}
    );

    if(error)throw error;

    if(Array.isArray(data)){
      result.push(...data);
    }
  }

  return result;
}

async function expandMasterRowsByRequestCycles(rows){
  const source=Array.isArray(rows)?rows:[];

  if(!source.length || !hasFullAccess())return source;

  const ids=source
    .map(r=>String(r.id||r.expediente_id||''))
    .filter(Boolean);

  let cycles=[];

  try{
    cycles=await loadMasterCyclesForExpedientes(ids);
  }catch(error){
    console.warn(
      'Ciclos del Registro Maestro:',
      error?.message||error
    );

    // Compatibilidad: si todavía no se ejecutó el SQL nuevo,
    // el Registro Maestro continúa funcionando en formato anterior.
    return source;
  }

  const byExp=new Map();

  cycles.forEach(c=>{
    const key=String(c.expediente_id||'');
    if(!key)return;

    if(!byExp.has(key))byExp.set(key,[]);
    byExp.get(key).push(c);
  });

  const expanded=[];

  source.forEach(base=>{
    const expId=String(base.id||base.expediente_id||'');
    const expCycles=(byExp.get(expId)||[])
      .slice()
      .sort((a,b)=>
        String(
          b.solicitud_created_at||
          b.fecha_solicitud||
          ''
        ).localeCompare(
          String(
            a.solicitud_created_at||
            a.fecha_solicitud||
            ''
          )
        )
      );

    // Un expediente que nunca tuvo solicitud sigue mostrando una sola
    // fila física normal.
    if(!expCycles.length){
      expanded.push(base);
      return;
    }

    expCycles.forEach((c,cycleIndex)=>{
      const closed=!!c.ciclo_cerrado;
      const cycleState=norm(c.estado_ciclo||c.estado_item||c.solicitud_estado||'');
      const cycleAction=norm(c.ultimo_movimiento||'');
      const cycleWasReturned=
        closed &&
        (
          cycleState==='DEVUELTO AL ARCHIVO' ||
          cycleState==='DEVUELTO' ||
          cycleAction.includes('DEVOLUCIÓN CONFIRMADA') ||
          cycleAction.includes('DEVOLUCION CONFIRMADA') ||
          cycleAction.includes('RECIBIDO EN ARCHIVO')
        );

      // Nunca tomar devuelto_por de BASE: BASE representa al expediente físico
      // y puede contener la devolución de una solicitud anterior.
      const cycleReturner=cycleWasReturned
        ?String(c.devuelto_por||c.ultimo_movimiento_desde||'').trim()
        :'';

      expanded.push({
        ...base,

        // El UUID físico NO cambia ni se duplica.
        id:expId,
        expediente_id:expId,

        // Identidad del ciclo visual.
        _master_cycle:true,
        _master_cycle_id:c.solicitud_expediente_id||'',
        _cycle_closed:closed,

        // V116 · datos necesarios para impedir que un listado de un
        // ciclo anterior se herede al ciclo actual.
        _master_cycle_index:cycleIndex,
        _master_cycle_total:expCycles.length,
        _master_cycle_newer_start:
          cycleIndex>0
            ?(
              expCycles[cycleIndex-1]?.solicitud_created_at||
              expCycles[cycleIndex-1]?.fecha_solicitud||
              null
            )
            :null,

        solicitud_id:c.solicitud_id||'',
        solicitud_numero:c.solicitud_numero||'',
        solicitud_estado:c.solicitud_estado||'',

        solicitante_pendiente:c.solicitante||'',
        solicitud_pendiente_numero:c.solicitud_numero||'',
        solicitud_pendiente_fecha:c.fecha_solicitud||'',
        solicitud_pendiente_id:c.solicitud_id||'',

        fecha_solicitud:c.fecha_solicitud||null,

        // Momento real de ingreso de esta solicitud.
        solicitud_created_at:
          c.solicitud_created_at||
          c.fecha_solicitud||
          null,

        modalidad:c.modalidad||base.modalidad||'',

        estado_solicitud_item:c.estado_item||'',
        estado_ciclo:c.estado_ciclo||'',

        // El estado mostrado pertenece exclusivamente a ESTE ciclo.
        estado_operativo:c.estado_ciclo||c.estado_item||'',
        estado:c.estado_ciclo||c.estado_item||'',

        fecha_entrega_ciclo:c.fecha_entrega||null,
        fecha_entrega_solicitud_actual:c.fecha_entrega||null,
        fecha_devolucion:c.fecha_devolucion||c.fecha_cierre||null,

        cargo:c.cargo_numero||'',

        ultimo_movimiento:c.ultimo_movimiento||'',
        ultimo_movimiento_fecha:c.ultimo_movimiento_fecha||null,
        ultimo_movimiento_desde:c.ultimo_movimiento_desde||'',
        ultimo_movimiento_hacia:c.ultimo_movimiento_hacia||'',

        // DEVUELTO POR pertenece únicamente a este ciclo.
        // Se sobrescriben expresamente los valores heredados de BASE.
        devuelto_por:cycleReturner,
        devuelto_por_maestro:cycleReturner,
        _master_cycle_devuelto_por:cycleReturner,

        // La ubicación/responsable físico permanece tomada de BASE.
        // Por tanto, las filas visuales no crean expedientes físicos nuevos.
        responsable:base.responsable,
        responsable_fisico_db:
          base.responsable_fisico_db||
          base.responsable||
          '',
        estado_fisico_db:
          base.estado_fisico_db||
          base.estado||
          ''
      });
    });
  });

  return expanded;
}

async function manageMasterCycle(expedienteId,solicitudId,button=null){
  if(!hasFullAccess()){
    showToast('Solo Archivo o Administrador puede gestionar esta solicitud.');
    return;
  }

  expedienteId=String(expedienteId||'').trim();
  solicitudId=String(solicitudId||'').trim();

  if(!expedienteId || !solicitudId){
    showToast('No se pudo identificar el ciclo de solicitud.');
    return;
  }

  const row=(allRows||[]).find(r=>
    String(r.id||'')===expedienteId &&
    String(r.solicitud_id||'')===solicitudId
  );

  if(row && masterCycleIsClosed(row)){
    showToast('Este ciclo está cerrado y es de solo lectura.');
    return;
  }

  const oldText=button?.textContent||'Gestionar';

  if(button){
    button.disabled=true;
    button.textContent='Verificando...';
  }

  try{
    // Verificación en base para impedir gestionar un ciclo que haya sido
    // cerrado por otro usuario mientras esta pantalla estaba abierta.
    const {data:link,error:linkError}=await sb
      .from('solicitud_expedientes')
      .select('estado')
      .eq('solicitud_id',solicitudId)
      .eq('expediente_id',expedienteId)
      .maybeSingle();

    if(linkError)throw linkError;

    if(!link){
      throw new Error(
        'No se encontró la relación de este expediente con la solicitud.'
      );
    }

    if(masterCycleTerminalState(link.estado)){
      showToast(
        'Este ciclo ya fue cerrado. Puede consultar únicamente su historial.'
      );
      await loadAll();
      return;
    }

    const {data:request,error:requestError}=await sb
      .from('solicitudes_prestamo')
      .select('*')
      .eq('id',solicitudId)
      .single();

    if(requestError)throw requestError;

    if(masterCycleTerminalState(request?.estado)){
      showToast(
        'La solicitud ya está cerrada. Puede consultar únicamente su historial.'
      );
      await loadAll();
      return;
    }

    requestRows=[
      request,
      ...(requestRows||[]).filter(
        x=>String(x.id)!==solicitudId
      )
    ];

    await openRequestDetail(solicitudId);

    requestSelectedIds.clear();

    const item=requestDetailRows.find(
      x=>String(x.expediente_id)===expedienteId
    );

    if(item && requestItemSelectable(item)){
      requestSelectedIds.add(expedienteId);
    }

    renderRequestDetailItems();
    renderRequestActions();

    if(el('rqActionStatus')){
      el('rqActionStatus').textContent=
        `Ciclo activo ${request.numero||''} · expediente ${item?.expediente||''}.`;
    }

  }catch(error){
    alert(error?.message||String(error));
  }finally{
    if(button){
      button.disabled=false;
      button.textContent=oldText;
    }
  }
}

function masterNormalizeRow(r){
  const physicalState=
    r.estado_fisico_db||
    r.estado||
    '';

  const physicalResponsible=
    r.responsable_fisico_db||
    r.responsable||
    '';

  const normalizedState=
    r.estado_operativo||
    r.estado||
    '';

  return {
    ...r,

    // El estado de una SOLICITUD y el estado FÍSICO del expediente
    // son conceptos distintos.
    estado_fisico_db:physicalState,
    responsable_fisico_db:physicalResponsible,

    estado:normalizedState,
    estado_operativo:normalizedState,
    responsable:r.responsable_operativo||r.responsable
  };
}

function masterApplyLatestOperationalState(rows){
  return (rows||[]).map(r=>{
    const state=operationalStatus(r)||r.estado_operativo||r.estado||'';
    return {...r,estado:state,estado_operativo:state};
  });
}

function masterShowRequester(r){
  // Una fila de ciclo siempre conserva el solicitante que originó
  // ESA solicitud, incluso cuando el ciclo ya está cerrado.
  if(r?._master_cycle)return true;

  // Mostrar al solicitante de la SOLICITUD ACTIVA.
  //
  // Casos:
  // 1. El expediente está POR VERIFICAR.
  // 2. El expediente ya retornó físicamente a Archivo y la nueva
  //    solicitud quedó PENDIENTE POR ATENDER / ACEPTADA.
  //
  // Esto evita que la devolución del responsable anterior oculte
  // al nuevo solicitante en el Registro Maestro.
  return (
    norm(r?.responsable||'').includes('POR VERIFICAR') ||
    masterRowIsPendingAttention(r)
  );
}

function masterRowIsPendingAttention(r){
  const state=norm(r?.estado_operativo||r?.estado||'');
  return ['PENDIENTE POR ATENDER','ACEPTADO'].includes(state);
}

async function enrichMasterPendingRequestData(rows){
  // En Registro Maestro se muestra el solicitante cuando existe una
  // solicitud vigente que explica el estado PENDIENTE POR ATENDER,
  // o cuando la ubicación todavía está POR VERIFICAR.
  //
  // No se usa el solicitante histórico de ciclos ya cerrados:
  // se toma la solicitud más reciente vinculada al expediente.
  if(!Array.isArray(rows)||!rows.length||!sb||!session)return rows||[];

  const expedienteIds=[...new Set(
    rows.filter(masterShowRequester)
      .map(r=>String(r.id||r.expediente_id||''))
      .filter(Boolean)
  )];
  if(!expedienteIds.length)return rows;

  try{
    const {data:links,error:linksError}=await sb
      .from('solicitud_expedientes')
      .select('expediente_id,solicitud_id')
      .in('expediente_id',expedienteIds);

    if(linksError)throw linksError;

    const solicitudIds=[...new Set(
      (links||[]).map(x=>String(x.solicitud_id||'')).filter(Boolean)
    )];
    if(!solicitudIds.length)return rows;

    const {data:reqs,error:reqsError}=await sb
      .from('solicitudes_prestamo')
      .select('id,numero,solicitante,fecha_solicitud')
      .in('id',solicitudIds);

    if(reqsError)throw reqsError;

    const reqById=new Map((reqs||[]).map(x=>[String(x.id),x]));
    const latestByExp=new Map();

    (links||[]).forEach(link=>{
      const expId=String(link.expediente_id||'');
      const req=reqById.get(String(link.solicitud_id||''));
      if(!expId||!req)return;

      const previous=latestByExp.get(expId);
      const currentDate=String(req.fecha_solicitud||'');
      const previousDate=String(previous?.fecha_solicitud||'');

      // La fecha ISO permite comparar directamente. Si empatan, se conserva
      // el registro que se encuentre después en la consulta.
      if(!previous || currentDate>=previousDate){
        latestByExp.set(expId,req);
      }
    });

    return rows.map(r=>{
      if(!masterShowRequester(r)){
        return {
          ...r,
          solicitante_pendiente:'',
          solicitud_pendiente_numero:'',
          solicitud_pendiente_fecha:'',
          solicitud_pendiente_id:''
        };
      }

      const id=String(r.id||r.expediente_id||'');
      const req=latestByExp.get(id);
      if(!req)return r;

      return {
        ...r,
        solicitante_pendiente:req.solicitante||'',
        solicitud_pendiente_numero:req.numero||'',
        solicitud_pendiente_fecha:req.fecha_solicitud||'',
        solicitud_pendiente_id:req.id||''
      };
    });
  }catch(error){
    console.warn('Solicitante Registro Maestro:',error?.message||error);
    return rows;
  }
}

function updateMasterMonthDayOptions(monthRows,dayRows){
  const monthSel=el('allMonthFilter');
  if(!monthSel)return;

  const currentMonth=monthSel.value||'';
  const months=Array.isArray(monthRows)?monthRows:[];

  monthSel.innerHTML=
    '<option value="">TODOS LOS MESES</option>'+
    months.map(x=>
      `<option value="${esc(x.mes||'')}">${esc(formatMasterMonth(x.mes))} (${Number(x.cantidad||0)})</option>`
    ).join('');

  monthSel.value=[...monthSel.options].some(o=>o.value===currentMonth)
    ?currentMonth
    :'';

  syncMasterDayOptions(dayRows);
}

function renderMasterDateSummary(monthRows,dayRows){
  const box=el('allDateSummary');
  if(!box)return;

  const selectedMonth=el('allMonthFilter')?.value||'';
  const list=selectedMonth
    ?(Array.isArray(dayRows)?dayRows:[])
    :(Array.isArray(monthRows)?monthRows:[]);

  if(!list.length){
    box.classList.add('hidden');
    box.innerHTML='';
    return;
  }

  const MAX=24;
  const visible=list.slice(0,MAX);
  const more=Math.max(0,list.length-MAX);
  const title=selectedMonth?'Cantidad por día de solicitud:':'Cantidad por mes de solicitud:';
  box.innerHTML=`<strong>${title}</strong> `+
    visible.map(x=>{
      const label=selectedMonth?fmtDate(x.fecha):formatMasterMonth(x.mes);
      const selectedDay=selectedMonth && masterSelectedDays.has(masterRequestDateKey(x.fecha));
      return `<span class="master-date-chip ${selectedDay?'selected':''}">${esc(label)} <b>${Number(x.cantidad||0)}</b></span>`;
    }).join('')+
    (more?`<span class="master-date-chip">+ ${more} opciones más</span>`:'');
  box.classList.remove('hidden');
}

async function loadAll(){
  if(!sb||!session)return;

  // Cada ejecución obtiene un identificador propio.
  // Si el usuario cambia de filtro mientras una consulta anterior sigue
  // respondiendo, la consulta vieja no podrá sobrescribir la vista nueva.
  const masterLoadSeq=(window.__masterLoadSeq=(window.__masterLoadSeq||0)+1);

  populateMasterFilters();

  const latestStateFilter=masterLatestStateFilterActive();
  const multipleDayFilter=masterDayFilterActive();
  const sedeFilter=masterSedeFilterActive();

  // Si el único último estado seleccionado es DEVUELTO AL ARCHIVO,
  // Registro maestro cambia SIEMPRE al módulo especial de preparación
  // de listados. Los demás filtros no deben ocultar estas herramientas.
  if(masterReturnedArchiveFilterActive() && hasFullAccess()){
    await loadMasterReturnedArchiveForLists();

    if(masterLoadSeq!==window.__masterLoadSeq)return;

    syncMasterReturnBulkUI();
    return;
  }

  returnedArchiveView='states';
  el('allTable')?.closest('.table-wrap')?.classList.remove('returned-archive-fixed-layout');

  // Último estado o varios días: cargar el conjunto completo que ya
  // cumple los demás filtros y aplicar estas dos reglas localmente.
  { // Fecha de solicitud: ordenar el conjunto completo antes de paginar.
    try{
      const dataset=await fetchMasterOperationalDataset();

      if(masterLoadSeq!==window.__masterLoadSeq)return;

      // Si durante la consulta el usuario cambió a DEVUELTO AL ARCHIVO,
      // no renderizar la tabla normal encima del módulo de listados.
      if(masterReturnedArchiveFilterActive() && hasFullAccess()){
        await loadMasterReturnedArchiveForLists();
        return;
      }

      updateMasterMonthDayOptions(dataset.monthRows,dataset.dayRows);

      const filtered=dataset.rows;
      allCountValue=filtered.length;
      allTotalGeneral=dataset.totalGeneral;

      // V46: Registro Maestro sin paginación.
      // Mostrar todas las filas que cumplen los filtros.
      allPage=0;
      allRows=filtered;

      const startRow=allCountValue?1:0;
      const endRow=allCountValue;
      const totalPages=1;

      const physicalVisible=Number(dataset.physicalCount||0);
      const cycleVisible=Number(dataset.cycleCount||0);

      const searchedAccumulatedNumber=
        filtered.find(r=>r?._master_search_by_accumulated)
          ?._master_accumulated_search_number||'';

      el('allCount').textContent=
        searchedAccumulatedNumber
          ?(
              cycleVisible
                ?`${allCountValue} filas de atención · ${physicalVisible} expediente${physicalVisible===1?'':'s'} físico${physicalVisible===1?'':'s'} asociado${physicalVisible===1?'':'s'} al acumulado ${searchedAccumulatedNumber} · ${allTotalGeneral} expedientes físicos en la base`
                :`${physicalVisible} expediente${physicalVisible===1?'':'s'} físico${physicalVisible===1?'':'s'} asociado${physicalVisible===1?'':'s'} al acumulado ${searchedAccumulatedNumber}`
            )
          :(
              cycleVisible
                ?`${allCountValue} filas de atención · ${physicalVisible} expediente${physicalVisible===1?'':'s'} físico${physicalVisible===1?'':'s'} · ${allTotalGeneral} expedientes físicos en la base`
                :(allCountValue===allTotalGeneral
                  ?`${allTotalGeneral} expedientes físicos totales`
                  :`${allCountValue} encontrados de ${allTotalGeneral} expedientes físicos`)
            );

      if(el('allPageInfo')){
        el('allPageInfo').textContent=
          allCountValue
            ?`Mostrando los ${allCountValue} resultados`
            :'Sin resultados';
      }

      if(el('allPrevBtn'))el('allPrevBtn').disabled=true;
      if(el('allNextBtn'))el('allNextBtn').disabled=true;

      renderMasterDateSummary(dataset.monthRows,dataset.dayRows);

      el('allTable').innerHTML=allRows.length
        ?recordTable(allRows,true,'all')
        :'<div class="empty">No se encontraron expedientes con el último estado, días y sede seleccionados.</div>';

      syncMasterReturnBulkUI();
      return;
    }catch(error){
      serverError(error);
      return;
    }
  }

}

async function changeAllPage(delta){
  // V46: el Registro Maestro ya no usa páginas.
  allPage=0;
  await loadAll();
}

function debounceAll(){
  clearTimeout(allTimer);

  // V523 · Si ya se escribió N.º-AÑO completo, ejecutar casi de inmediato.
  // Para texto incompleto se conserva un debounce corto para no consultar
  // Supabase en cada pulsación.
  const raw=String(el('allSearch')?.value||'').trim().replace(/\s+/g,'');
  const exact=/^\d+-\d{4}$/.test(raw);

  allTimer=setTimeout(()=>{
    allPage=0;
    loadAll();
  },exact?0:70);
}

async function fetchMasterFilteredRows(){
  const dataset=await fetchMasterOperationalDataset();
  return dataset.rows;
}

// Cerrar los selectores múltiples cuando se pulsa fuera de ellos.
document.addEventListener('click',ev=>{
  const statePanel=el('allStateMultiPanel');
  const stateButton=el('allStateMultiButton');

  if(
    statePanel &&
    !statePanel.classList.contains('hidden') &&
    !statePanel.contains(ev.target) &&
    !stateButton?.contains(ev.target)
  ){
    closeMasterStatePanel();
  }

  const dayPanel=el('allDayMultiPanel');
  const dayButton=el('allDayMultiButton');

  if(
    dayPanel &&
    !dayPanel.classList.contains('hidden') &&
    !dayPanel.contains(ev.target) &&
    !dayButton?.contains(ev.target)
  ){
    closeMasterDayPanel();
  }
});

async function exportMasterResults(btn){
  const old=btn.textContent;
  btn.disabled=true;
  btn.textContent='Exportando Excel...';

  try{
    if(typeof XLSX==='undefined'){
      throw new Error('No se pudo cargar la librería de Excel. Recargue la página e intente nuevamente.');
    }

    let rows=await fetchMasterFilteredRows();

    if(!rows.length){
      alert('No hay resultados para exportar.');
      return;
    }

    // Mantener exactamente la misma información operativa que alimenta
    // el Registro Maestro. No cambia tablas, sesión, perfiles ni permisos.
    rows=await enrichMasterOperationalColumnsV18(rows);
    try{ rows=await enrichMasterAccumulatedRows(rows); }catch(_){ }

    const dateTimeText=(value)=>{
      if(!value)return '';
      const d=fmtDate(value)||'';
      const t=masterValueHasExplicitTime(value)?(fmtTime(value)||''):'';
      return [d,t].filter(Boolean).join(' ');
    };

    const expedienteText=(r)=>{
      const base=expBase(r?.expediente||'')||String(r?.expediente||'').trim();
      const acc=Array.isArray(r?._acumulados)?r._acumulados:[];
      if(!acc.length)return base;
      const detail=acc.map(a=>{
        const n=String(a?.numero_acumulado||'').trim();
        const e=String(a?.extension||'').trim();
        return [n,e].filter(Boolean).join(' · ');
      }).filter(Boolean);
      return detail.length ? `${base}\nAcumulados: ${detail.join(' | ')}` : base;
    };

    const requesterText=(r)=>{
      if(!(masterShowRequester(r) && r?.solicitante_pendiente))return '';
      return [r.solicitante_pendiente,r.solicitud_pendiente_numero]
        .filter(Boolean)
        .join('\n');
    };

    const digitalText=(r)=>{
      const value=String(r?.digitalizado||'').trim();
      const link=String(r?.enlace||'').trim();
      return [value,link].filter(Boolean).join('\n');
    };

    const dataRows=rows.map((r,index)=>[
      index+1,

      // INICIO DEL REQUERIMIENTO
      dateTimeText(masterRequestEntryValue(r)),
      expedienteText(r),
      r?.extension||'',
      r?.rd||'',
      r?.ultimo_folio||'',

      // ATENCIÓN DEL REQUERIMIENTO
      masterV18Asunto(r)||'',
      dateTimeText(masterDeliveryDateTimeValue(r)),
      requesterText(r),
      r?.modalidad||'',
      r?.cargo||'',
      masterV18Attendant(r)||'',

      // DÍAS DE ATENCIÓN
      masterV28AttentionDays(r)==='—'?'':masterV28AttentionDays(r),

      // REASIGNACIÓN
      [r?.master_reasignacion_desde||'',r?.master_reasignacion_hacia||'']
        .filter(Boolean).join(' → '),
      dateTimeText(r?.master_reasignacion_fecha),

      // SITUACIÓN FINAL
      operationalStatus(r)||r?.estado_operativo||r?.estado||'',
      masterV19LocationFinal(r)||'',

      // DÍAS EN CUSTODIA
      masterV28CustodyDays(r)==='—'?'':masterV28CustodyDays(r),

      // DEVOLUCIÓN
      dateTimeText(r?.master_fecha_devolucion||r?.fecha_devolucion),
      masterV18Returner(r)||'',
      masterV18Receiver(r)||'',
      masterV18ReturnFolio(r)||'',

      // CAMPOS ADICIONALES DEL SISTEMA
      r?.listado_numero||'',
      masterSedeValue(r)||'',
      dateTimeText(r?.listado_enviado_at||r?.master_fecha_envio_san_luis),
      digitalText(r),
      rowAlert(r)?'ALERTA >30 DÍAS':''
    ]);

    // Dos filas de encabezado para conservar la organización visual
    // del Registro Maestro. Se omiten únicamente selección y Acciones,
    // porque son controles de interfaz y no datos exportables.
    const groupHeaders=[
      'ÍTEM',
      'INICIO DEL REQUERIMIENTO','','','','',
      'ATENCIÓN DEL REQUERIMIENTO','','','','','',
      'DÍAS DE ATENCIÓN',
      'REASIGNACIÓN','',
      'SITUACIÓN FINAL','',
      'DÍAS EN CUSTODIA',
      'DEVOLUCIÓN','','','',
      'CAMPOS ADICIONALES DEL SISTEMA','','','',''
    ];

    const columnHeaders=[
      'Ítem',
      'Fecha y hora de solicitud',
      'Expediente',
      'Extensión',
      'Última R.D.',
      'N.° de folios',
      'Asunto del requerimiento',
      'Fecha y hora de entrega',
      'Nombre del solicitante',
      'Modalidad',
      'Cargo',
      'Profesional responsable de la atención',
      'Días de atención',
      'Reasignación (De → A)',
      'Fecha / hora',
      'Estado',
      'Ubicación',
      'Días en custodia',
      'Fecha',
      'Profesional que devuelve',
      'Profesional que recibe',
      'N.° folios',
      'Listado',
      'Sede',
      'Fecha de envío a San Luis',
      'Digitalizado',
      'Alerta'
    ];

    const ws=XLSX.utils.aoa_to_sheet([groupHeaders,columnHeaders,...dataRows]);

    ws['!merges']=[
      XLSX.utils.decode_range('A1:A2'),
      XLSX.utils.decode_range('B1:F1'),
      XLSX.utils.decode_range('G1:L1'),
      XLSX.utils.decode_range('M1:M2'),
      XLSX.utils.decode_range('N1:O1'),
      XLSX.utils.decode_range('P1:Q1'),
      XLSX.utils.decode_range('R1:R2'),
      XLSX.utils.decode_range('S1:V1'),
      XLSX.utils.decode_range('W1:AA1')
    ];

    ws['!cols']=[
      {wch:7},   // Ítem
      {wch:21},  // solicitud
      {wch:24},  // expediente + acumulados
      {wch:14},  // extensión
      {wch:14},  // RD
      {wch:12},  // folios
      {wch:38},  // asunto
      {wch:21},  // entrega
      {wch:25},  // solicitante
      {wch:16},  // modalidad
      {wch:14},  // cargo
      {wch:28},  // atiende
      {wch:14},  // días atención
      {wch:30},  // reasignación
      {wch:21},  // fecha reasignación
      {wch:24},  // estado
      {wch:25},  // ubicación
      {wch:14},  // días custodia
      {wch:21},  // devolución
      {wch:25},  // devuelve
      {wch:25},  // recibe
      {wch:12},  // folios devolución
      {wch:15},  // listado
      {wch:16},  // sede
      {wch:21},  // envío SL
      {wch:30},  // digitalizado + enlace
      {wch:18}   // alerta
    ];

    ws['!rows']=[{hpt:24},{hpt:34}];
    ws['!autofilter']={ref:`A2:AA${dataRows.length+2}`};

    // Segunda hoja: deja constancia de los filtros con los que se generó
    // el archivo, sin alterar el contenido principal del Registro Maestro.
    const selectedStates=(typeof masterStatesForRpc==='function'?masterStatesForRpc():null);
    const selectedDays=(typeof masterSelectedDays!=='undefined'?[...masterSelectedDays].sort():[]);
    const filterRows=[
      ['FILTRO','VALOR'],
      ['Búsqueda por expediente',String(el('allSearch')?.value||'').trim()||'TODOS'],
      ['Último estado',Array.isArray(selectedStates)?(selectedStates.join(' | ')||'NINGUNO'):'TODOS'],
      ['Mes de solicitud',String(el('allMonthFilter')?.value||'').trim()||'TODOS'],
      ['Días de solicitud',selectedDays.length?selectedDays.map(fmtDate).join(' | '):'TODOS'],
      ['Responsable / ubicación',String(el('allOwnerFilter')?.value||'').trim()||'TODOS'],
      ['Sede',String(el('allSedeFilter')?.value||'').trim()||'TODAS'],
      ['Modalidad',String(el('allModeFilter')?.value||'').trim()||'TODAS'],
      ['Registros exportados',dataRows.length],
      ['Fecha de exportación',new Date().toLocaleString('es-PE')]
    ];
    const wf=XLSX.utils.aoa_to_sheet(filterRows);
    wf['!cols']=[{wch:28},{wch:70}];

    const wb=XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb,ws,'Registro Maestro');
    XLSX.utils.book_append_sheet(wb,wf,'Filtros aplicados');

    const now=new Date();
    const stamp=[
      now.getFullYear(),
      String(now.getMonth()+1).padStart(2,'0'),
      String(now.getDate()).padStart(2,'0')
    ].join('')+'_'+[
      String(now.getHours()).padStart(2,'0'),
      String(now.getMinutes()).padStart(2,'0')
    ].join('');

    XLSX.writeFile(
      wb,
      `REGISTRO_MAESTRO_${stamp}.xlsx`,
      {compression:true}
    );

    showToast?.(`${dataRows.length} registro${dataRows.length===1?'':'s'} exportado${dataRows.length===1?'':'s'} a Excel.`);

  }catch(e){
    serverError(e);
  }finally{
    btn.disabled=false;
    btn.textContent=old;
  }
}

async function goToPendingCargoRequests(){
  switchTab('requests',document.querySelector('[data-tab="requests"]'));
  if(el('requestStateFilter'))el('requestStateFilter').value='REGISTRADA POR ARCHIVO';
  if(el('requestSearch'))el('requestSearch').value='';
  if(el('requestOriginFilter'))el('requestOriginFilter').value='';
  await loadRequests();
}
function setCargoStatusFilter(value){
  if(el('cargoStatusFilter'))el('cargoStatusFilter').value=value||'';
  renderCargos();
}
function updateCargoKpiSelection(){
  const v=el('cargoStatusFilter')?.value||'';
  document.querySelectorAll('[data-cargo-filter]').forEach(card=>{
    card.classList.toggle('selected',(card.dataset.cargoFilter||'')===v);
  });
}

async function loadCargos(){
  if(!sb||!session)return;
  loadCargoCorrelativeConfig();

  let q=sb
    .from('cargos')
    .select('id,numero,solicitante,asunto,atiende_requerimiento,fecha,observacion,created_at')
    .order('fecha',{ascending:false})
    .order('numero',{ascending:false})
    .limit(1000);

  const s=cleanSearch(el('cargoSearch')?.value||'');
  if(s){
    const p=`%${s}%`;
    q=q.or(`numero.ilike.${p},solicitante.ilike.${p},asunto.ilike.${p},atiende_requerimiento.ilike.${p},observacion.ilike.${p}`);
  }

  const {data,error}=await q;

  if(error){
    el('cargosTable').innerHTML=`<div class="empty">${esc(error.message)}</div>`;
    return;
  }

  cargosRows=data||[];

  // Contar expedientes vinculados a cada cargo.
  const cargoIds=cargosRows.map(c=>c.id).filter(Boolean);

  if(cargoIds.length){
    const {data:links,error:linksErr}=await sb
      .from('cargo_expedientes')
      .select('cargo_id,expediente_id')
      .in('cargo_id',cargoIds);

    if(!linksErr){
      const counts=new Map();

      (links||[]).forEach(x=>{
        counts.set(x.cargo_id,(counts.get(x.cargo_id)||0)+1);
      });

      cargosRows=cargosRows.map(c=>({
        ...c,
        total_expedientes:counts.get(c.id)||0
      }));
    }
  }

  // Estado operativo del cargo según su registro de préstamo.
  const cargoNums=cargosRows.map(c=>c.numero).filter(Boolean);
  if(cargoNums.length){
    const {data:deliveryLinks,error:deliveryLinksError}=await sb
      .from('solicitud_expedientes')
      .select('solicitud_id,expediente_id,cargo_numero,estado,fecha_entrega')
      .in('cargo_numero',cargoNums);

    if(!deliveryLinksError){
      const dmap=new Map();
      (deliveryLinks||[]).forEach(x=>{
        if(!x.cargo_numero)return;
        if(!dmap.has(x.cargo_numero))dmap.set(x.cargo_numero,[]);
        dmap.get(x.cargo_numero).push(x);
      });

      cargosRows=cargosRows.map(c=>{
        const items=dmap.get(c.numero)||[];
        const pending=items.filter(x=>x.estado==='CARGO GENERADO').length;
        const delivered=items.filter(x=>['EN PRÉSTAMO','DEVOLUCIÓN SOLICITADA','DEVUELTO'].includes(x.estado)).length;
        const estado_entrega=!items.length
          ?'SIN FLUJO DE ENTREGA'
          :pending>0 && delivered>0
            ?'ENTREGA PARCIAL'
            :pending>0
              ?'PENDIENTE DE ENTREGA'
              :'ENTREGADO';
        return {...c,estado_entrega,pending_delivery:pending,delivery_items:items};
      });
    }
  }

  if(isAdmin()){
    cargosRows=await enrichCargosWithRequestOrigin(cargosRows);
  }

  const pendingDeliveryCount=cargosRows.filter(x=>x.estado_entrega==='PENDIENTE DE ENTREGA').length;
  const partialCount=cargosRows.filter(x=>x.estado_entrega==='ENTREGA PARCIAL').length;
  const deliveredCount=cargosRows.filter(x=>x.estado_entrega==='ENTREGADO').length;
  if(el('cargoPendingDeliveryCount'))el('cargoPendingDeliveryCount').textContent=pendingDeliveryCount;
  if(el('cargoPartialCount'))el('cargoPartialCount').textContent=partialCount;
  if(el('cargoDeliveredCount'))el('cargoDeliveredCount').textContent=deliveredCount;

  const {data:pendingReqData,error:pendingReqError}=await sb.rpc('listar_solicitudes_prestamo',{p_busqueda:null,p_estado:'REGISTRADA POR ARCHIVO'});
  if(el('cargoPendingGenerateCount'))el('cargoPendingGenerateCount').textContent=pendingReqError?'—':(pendingReqData||[]).length;
  updateCargoKpiSelection();

  // Si el cargo seleccionado desapareció del resultado del filtro,
  // limpiar la selección.
  if(selectedCargoNumero &&
     !cargosRows.some(c=>c.numero===selectedCargoNumero)){
    selectCargoForPrint('');
  }

  el('cargosCount').textContent=cargosRows.length+' cargos';

  renderCargos();
}
function debounceCargos(){
  clearTimeout(cargosTimer);
  cargosTimer=setTimeout(loadCargos,300);
}

function selectCargoForPrint(numero){
  selectedCargoNumero=(numero||'').trim();

  if(el('selectedCargoLabel')){
    el('selectedCargoLabel').textContent=selectedCargoNumero||'Ninguno';
  }

  if(el('printSelectedCargoBtn')){
    el('printSelectedCargoBtn').disabled=!selectedCargoNumero;
  }

  renderCargos();
}

async function printSelectedCargo(){
  if(!selectedCargoNumero){
    alert('Seleccione un cargo de la relación.');
    return;
  }

  await openExistingCargoForPrint(selectedCargoNumero);
}

function renderCargos(){
  updateCargoKpiSelection();
  const statusFilter=el('cargoStatusFilter')?.value||'';
  const visibleRows=cargosRows.filter(c=>!statusFilter||c.estado_entrega===statusFilter);
  if(!visibleRows.length){
    el('cargosTable').innerHTML='<div class="empty">No hay cargos para el estado seleccionado.</div>';
    if(el('cargosCount'))el('cargosCount').textContent='0 cargos';
    return;
  }
  if(el('cargosCount'))el('cargosCount').textContent=visibleRows.length+' cargo'+(visibleRows.length===1?'':'s');

  el('cargosTable').innerHTML=`<table>
    <thead>
      <tr>
        <th style="width:42px">Sel.</th>
        <th>Cargo N°</th>
        <th>Expedientes</th>
        <th class="subject-cell-v639">Asunto</th>
        <th>Solicitante</th>
        <th>Estado entrega</th>
        ${isAdmin()?'<th>Origen solicitud</th><th>Registrado por</th>':''}
        <th>Atiende</th>
        <th>Fecha</th>
        <th>Observación</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      ${visibleRows.map(c=>{
        const selected=c.numero===selectedCargoNumero;

        return `<tr class="row-click-select ${selected?'cargo-selected-row record-selected-row':''}" onclick="selectCargoFromRow(event,'${String(c.numero).replace(/'/g,"\'")}')" title="Clic en la fila para seleccionar este cargo">
          <td>
            <input
              type="radio"
              name="cargoParaImprimir"
              aria-label="Seleccionar cargo ${esc(c.numero)}"
              ${selected?'checked':''}
              onchange="selectCargoForPrint('${String(c.numero).replace(/'/g,"\\'")}')">
          </td>
          <td><b>${esc(c.numero)}</b></td>
          <td><b>${Number(c.total_expedientes||0)}</b></td>
          <td class="subject-cell-v639" title="${esc(c.asunto||'')}"><div class="subject-text-v639">${esc(c.asunto||'—')}</div></td>
          <td>${esc(c.solicitante||'')}</td>
          <td><b>${esc(c.estado_entrega||'—')}</b></td>
          ${isAdmin()
            ?`<td>${c.origen_solicitud==='VARIOS'
                ?'<span class="req-origin unknown">VARIOS</span>'
                :requestOriginPill(c.origen_solicitud)}</td>
              <td><b>${esc(c.registrado_por_solicitud||'—')}</b></td>`
            :''}
          <td>${esc(c.atiende_requerimiento||'—')}</td>
          <td>${fmtDate(c.fecha)}</td>
          <td>${esc(c.observacion||'')}</td>
          <td>
            <div style="display:flex;gap:6px;flex-wrap:wrap;justify-content:center">
              <button
                class="btn secondary small"
                onclick="event.stopPropagation();verExpedientesCargo('${String(c.id)}')">
                Ver expedientes
              </button>
              ${isAdmin()?`<button
                class="btn secondary small"
                onclick="event.stopPropagation();openCargoNumberEditModal('${String(c.id||'').replace(/'/g,"\\'")}','${String(c.numero||'').replace(/'/g,"\\'")}')">
                Editar N°
              </button>`:''}
            </div>
          </td>
        </tr>`;
      }).join('')}
    </tbody>
  </table>`;
}
// V739 · Consulta de expedientes vinculados a un cargo, SIN salir del módulo.
let v739ConsultaCargoSecuencia=0;
function v739CerrarExpedientesCargo(){
  ++v739ConsultaCargoSecuencia;
  el('v739CargoExpedientesModal')?.classList.remove('show');
}
function v739ClaseEstadoCargo(valor){
  const txt=String(valor||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().trim();
  if(txt.includes('REASIGNAD')) return 'v739-status-purple';
  if(txt.includes('DEVOLUCION SOLICITADA')) return 'v739-status-amber';
  if(txt.includes('PRESTAMO')) return 'v739-status-blue';
  if(txt.includes('ARCHIVO')||txt.includes('CUSTODIA')||txt.includes('DEVUELTO')) return 'v739-status-green';
  if(txt.includes('PENDIENTE'))return 'v739-status-amber';
  return 'v739-status-neutral';
}
async function verExpedientesCargo(cargoId){
  if(!hasFullAccess()){
    showToast('Esta consulta es exclusiva de Archivo y Administrador.');
    return;
  }
  if(!sb||!session){showToast('Debe iniciar sesión nuevamente.');return;}
  const id=String(cargoId||'').trim();
  const cargo=cargosRows.find(c=>String(c.id)===id);
  if(!cargo){showToast('No se encontró el cargo seleccionado. Actualice la relación.');return;}
  const modal=el('v739CargoExpedientesModal');
  const title=el('v739CargoExpedientesTitle');
  const body=el('v739CargoExpedientesBody');
  const subtitle=el('v739CargoExpedientesInfo');
  if(!modal||!body||!title||!subtitle)return;
  const seq=++v739ConsultaCargoSecuencia;
  title.textContent='Expedientes del cargo '+String(cargo.numero||'');
  subtitle.textContent='Consultando el estado actual de los expedientes vinculados...';
  body.innerHTML='<div class="v739-loading">Cargando expedientes del cargo seleccionado...</div>';
  modal.classList.add('show');
  try{
    const {data,error}=await sb.rpc('v739_ver_expedientes_cargo',{p_cargo_id:id});
    if(seq!==v739ConsultaCargoSecuencia||!modal.classList.contains('show'))return;
    if(error)throw error;
    const items=Array.isArray(data?.expedientes)?data.expedientes:[];
    const numero=String(data?.cargo||cargo.numero||'');
    title.textContent='Expedientes del cargo '+numero;
    subtitle.textContent=items.length+' expediente'+(items.length===1?'':'s')+' asociado'+(items.length===1?'':'s')+' a este cargo · Estado actual del sistema';
    if(!items.length){
      body.innerHTML='<div class="v739-empty">Este cargo no tiene expedientes vinculados en el registro actual.</div>';
      return;
    }
    body.innerHTML=`<div class="v739-table-scroll"><table class="v739-table">
      <thead><tr><th>N.º</th><th>Expediente</th><th>Extensión</th><th>Estado actual</th><th>Responsable / ubicación</th></tr></thead>
      <tbody>${items.map((x,i)=>`<tr>
        <td>${i+1}</td>
        <td><strong>${esc(x.expediente||'—')}</strong></td>
        <td>${esc(x.extension||'—')}</td>
        <td><span class="v739-status ${v739ClaseEstadoCargo(x.estado_actual)}">${esc(x.estado_actual||'SIN ESTADO')}</span></td>
        <td>${esc(x.responsable_actual||'—')}</td>
      </tr>`).join('')}</tbody>
    </table></div><div class="v739-footnote">Información de consulta. El estado refleja la situación vigente del expediente y puede ser posterior a la emisión del cargo.</div>`;
  }catch(error){
    if(seq!==v739ConsultaCargoSecuencia||!modal.classList.contains('show'))return;
    subtitle.textContent='No se pudo completar la consulta.';
    body.innerHTML='<div class="v739-error">'+esc(error?.message||String(error))+'</div>';
  }
}

// V650 · Edición controlada del número de cargo · Solo ADMINISTRADOR
function openCargoNumberEditModal(cargoId,numero){
  if(!isAdmin()){
    showToast('Solo el Administrador puede editar el número de cargo.');
    return;
  }
  const id=String(cargoId||'').trim();
  const n=String(numero||'').trim().toUpperCase();
  if(!id||!n){
    showToast('No se pudo identificar el cargo.');
    return;
  }
  el('cargoEditId').value=id;
  el('cargoEditOld').value=n;
  el('cargoEditNew').value=n;
  el('cargoEditReason').value='';
  el('cargoEditStatus').textContent='';
  el('cargoEditSaveBtn').disabled=false;
  el('cargoNumberEditModal').classList.add('show');
  setTimeout(()=>{
    try{el('cargoEditNew').focus();el('cargoEditNew').select();}catch(_){ }
  },40);
}

function closeCargoNumberEditModal(){
  el('cargoNumberEditModal')?.classList.remove('show');
}

async function saveCargoNumberEdit(){
  if(!isAdmin()){
    showToast('Solo el Administrador puede editar el número de cargo.');
    return;
  }
  if(!sb||!session){
    showToast('Debe iniciar sesión nuevamente.');
    return;
  }

  const cargoId=String(el('cargoEditId')?.value||'').trim();
  const oldNumber=String(el('cargoEditOld')?.value||'').trim().toUpperCase();
  const newNumber=String(el('cargoEditNew')?.value||'').trim().toUpperCase();
  const reason=String(el('cargoEditReason')?.value||'').trim();
  const status=el('cargoEditStatus');
  const btn=el('cargoEditSaveBtn');

  if(!cargoId){
    if(status)status.textContent='No se pudo identificar el cargo.';
    return;
  }
  if(!/^\d{4}-\d{4}$/.test(newNumber)){
    if(status)status.textContent='Use el formato 0000-AÑO. Ejemplo: 0301-2026.';
    el('cargoEditNew')?.focus();
    return;
  }
  if(newNumber===oldNumber){
    if(status)status.textContent='El nuevo número es igual al actual.';
    return;
  }

  const confirmed=window.confirm(
    `Se corregirá el cargo ${oldNumber} por ${newNumber}.\n\n`+
    `El cambio se reflejará en las solicitudes, expedientes e historial vinculados. ¿Continuar?`
  );
  if(!confirmed)return;

  if(btn)btn.disabled=true;
  if(status)status.textContent='Guardando corrección...';

  try{
    const {data,error}=await sb.rpc('v649_editar_numero_cargo',{
      p_cargo_id:cargoId,
      p_nuevo_numero:newNumber,
      p_motivo:reason||null
    });
    if(error)throw error;

    if(selectedCargoNumero===oldNumber){
      selectedCargoNumero=newNumber;
      if(el('selectedCargoLabel'))el('selectedCargoLabel').textContent=newNumber;
    }

    closeCargoNumberEditModal();
    showToast(`Cargo corregido: ${oldNumber} → ${newNumber}`);
    await loadCargos();
  }catch(error){
    if(status)status.textContent=error?.message||String(error);
    if(btn)btn.disabled=false;
  }
}

// V650 · Continuidad del correlativo físico de cargos
let cargoCorrelativeConfig=null;

async function loadCargoCorrelativeConfig(){
  if(!sb||!session)return;
  const year=new Date().getFullYear();
  try{
    const {data,error}=await sb.rpc('v650_obtener_correlativo_cargo',{p_anio:year});
    if(error)throw error;
    cargoCorrelativeConfig=data||null;
    const physical=Number(data?.ultimo_fisico||0);
    if(el('cargoPhysicalCorrelative'))el('cargoPhysicalCorrelative').textContent=physical?`${String(physical).padStart(4,'0')}-${year}`:'No configurado';
    if(el('cargoNextCorrelative'))el('cargoNextCorrelative').textContent=data?.siguiente_numero||'—';
    if(el('cargoAdjustCorrelativeBtn'))el('cargoAdjustCorrelativeBtn').style.display=isAdmin()?'inline-flex':'none';
  }catch(error){
    console.warn('V650 correlativo cargo:',error);
    if(el('cargoPhysicalCorrelative'))el('cargoPhysicalCorrelative').textContent='—';
    if(el('cargoNextCorrelative'))el('cargoNextCorrelative').textContent='—';
  }
}

function openCargoCorrelativeModal(){
  if(!isAdmin()){showToast('Solo el Administrador puede ajustar el correlativo.');return;}
  const year=Number(cargoCorrelativeConfig?.anio||new Date().getFullYear());
  const last=Number(cargoCorrelativeConfig?.ultimo_fisico||0);
  el('cargoCorrYear').value=String(year);
  el('cargoCorrLast').value=last?String(last):'';
  el('cargoCorrNote').value='';
  el('cargoCorrStatus').textContent='';
  updateCargoCorrelativePreview();
  el('cargoCorrelativeModal').classList.add('show');
}
function closeCargoCorrelativeModal(){el('cargoCorrelativeModal')?.classList.remove('show');}
function updateCargoCorrelativePreview(){
  const y=Number(el('cargoCorrYear')?.value||0);
  const n=Number(el('cargoCorrLast')?.value||0);
  const next=n>=0&&y?`${String(n+1).padStart(4,'0')}-${y}`:'—';
  if(el('cargoCorrPreview'))el('cargoCorrPreview').textContent=`El siguiente cargo nuevo continuará desde: ${next}`;
}
async function saveCargoCorrelative(){
  if(!isAdmin()){showToast('Solo el Administrador puede ajustar el correlativo.');return;}
  const year=Number(el('cargoCorrYear')?.value||0);
  const last=Number(el('cargoCorrLast')?.value||0);
  const note=String(el('cargoCorrNote')?.value||'').trim();
  const status=el('cargoCorrStatus');
  const btn=el('cargoCorrSaveBtn');
  if(!Number.isInteger(year)||year<2000||year>2100){if(status)status.textContent='Ingrese un año válido.';return;}
  if(!Number.isInteger(last)||last<0||last>9999){if(status)status.textContent='Ingrese el último número físico entre 0 y 9999.';return;}
  const formatted=`${String(last).padStart(4,'0')}-${year}`;
  if(!window.confirm(`El último cargo físico se establecerá en ${formatted}.\nEl próximo cargo automático continuará desde ${String(last+1).padStart(4,'0')}-${year}. ¿Continuar?`))return;
  if(btn)btn.disabled=true;
  if(status)status.textContent='Guardando...';
  try{
    const {data,error}=await sb.rpc('v650_configurar_correlativo_cargo',{p_anio:year,p_ultimo_numero_fisico:last,p_observacion:note||null});
    if(error)throw error;
    closeCargoCorrelativeModal();
    showToast(`Correlativo actualizado. Próximo cargo: ${data?.siguiente_numero||''}`);
    await loadCargoCorrelativeConfig();
  }catch(error){
    if(status)status.textContent=error?.message||String(error);
  }finally{if(btn)btn.disabled=false;}
}

setTimeout(()=>{
  ['cargoCorrYear','cargoCorrLast'].forEach(id=>el(id)?.addEventListener('input',updateCargoCorrelativePreview));
},0);

async function loadHistory(){
  if(!sb||!session)return;

  if(isLimitedUser()){
    let q=sb
      .from('movimientos_prestamo')
      .select('*')
      .order('created_at',{ascending:false})
      .limit(500);

    const s=cleanSearch(el('historySearch').value);
    if(s){
      const p=`%${s}%`;
      q=q.or(`expediente.ilike.${p},accion.ilike.${p},desde.ilike.${p},hacia.ilike.${p},cargo_numero.ilike.${p},observacion.ilike.${p}`);
    }

    const {data,error}=await q;
    if(error){serverError(error);return}

    historyRows=(data||[]).map(x=>({
      created_at:x.created_at,
      expediente:x.expediente,
      extension:'',
      accion:x.accion,
      desde:x.desde,
      hacia:x.hacia,
      cargo:x.cargo_numero,
      detalle:x.observacion
    }));

    el('historyCount').textContent=historyRows.length;
    renderHistory();
    return;
  }

  let q=sb.from('historial_expedientes').select('*').order('created_at',{ascending:false}).limit(500);
  const s=cleanSearch(el('historySearch').value);
  if(s){
    const p=`%${s}%`;
    q=q.or(`expediente.ilike.${p},extension.ilike.${p},accion.ilike.${p},desde.ilike.${p},hacia.ilike.${p},cargo.ilike.${p},detalle.ilike.${p}`);
  }
  const {data,error}=await q;
  if(error){serverError(error);return}

  historyRows=data||[];
  el('historyCount').textContent=historyRows.length;
  renderHistory();
}
function debounceHistory(){clearTimeout(historyTimer);historyTimer=setTimeout(loadHistory,300)}


function panelReturnViewActive(){
  return hasFullAccess() &&
    selectedOwnerIsUser() &&
    panelQuickFilter==='pending';
}

function panelSelectedReturnRows(){
  return (panelRows||[]).filter(r=>
    selectedIds.has(r.id) &&
    norm(operationalStatus(r))==='DEVOLUCIÓN SOLICITADA'
  );
}

function syncPanelReturnBulkUI(){
  const bar=el('panelBulkReturnBar');
  const btn=el('panelBulkAcceptReturnBtn');
  const active=panelReturnViewActive();
  const rows=active?panelSelectedReturnRows():[];

  if(bar){
    bar.classList.toggle('hidden-by-role',!active);
    bar.classList.toggle('hidden',!active);
    bar.style.display=active?'flex':'none';
  }

  if(btn){
    btn.disabled=!active||rows.length===0;
    btn.textContent='✓ Aceptar varias solicitudes de devolución';
    btn.title=rows.length
      ?`Aceptar ${rows.length} devolución${rows.length===1?'':'es'} de ${selectedOwner}`
      :'Seleccione uno o varios expedientes de la tabla';
  }
}

function fillPanelBulkReturnLocations(){
  const sel=el('panelBulkReturnLocation');
  if(!sel)return;

  const current=sel.value||'';
  const locations=(catalogo||[])
    .filter(x=>x.activo!==false && x.tipo!=='PERSONAL')
    .map(x=>(x.nombre||'').trim())
    .filter(Boolean);

  const unique=[...new Set(locations)];
  sel.innerHTML=unique.length
    ?unique.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('')
    :'<option value="ARCHIVO">ARCHIVO</option>';

  if(current && [...sel.options].some(o=>o.value===current)){
    sel.value=current;
  }else{
    const archivo=[...sel.options].find(o=>norm(o.value).includes('ARCHIVO'));
    if(archivo)sel.value=archivo.value;
  }
}

function renderPanelBulkReturnTable(){
  const rows=panelSelectedReturnRows();

  if(el('panelBulkReturnOwner')){
    el('panelBulkReturnOwner').textContent=selectedOwner||'este usuario';
  }

  if(el('panelBulkReturnSummary')){
    el('panelBulkReturnSummary').textContent=
      `${rows.length} expediente${rows.length===1?'':'s'} para recibir`;
  }

  const box=el('panelBulkReturnTable');
  if(!box)return;

  if(!rows.length){
    box.innerHTML='<div class="empty">No hay expedientes seleccionados con DEVOLUCIÓN SOLICITADA.</div>';
    return;
  }

  box.innerHTML=`<table>
    <thead><tr>
      <th>Expediente</th><th>Extensión</th><th>Responsable actual</th>
      <th>Cargo</th><th>Últ. folio</th><th>Estado</th>
    </tr></thead>
    <tbody>${rows.map(r=>`<tr>
      <td><b>${esc(expBase(r.expediente))}</b></td>
      <td>${r.extension?esc(r.extension):'—'}</td>
      <td>${esc(r.responsable||'—')}</td>
      <td>${esc(r.cargo||'—')}</td>
      <td>${esc(r.ultimo_folio||'—')}</td>
      <td>${rowStatus(r)}</td>
    </tr>`).join('')}</tbody>
  </table>`;
}

function openPanelBulkReturnModal(){
  if(!hasFullAccess()){
    alert('Solo Archivo o Administrador puede aceptar devoluciones.');
    return;
  }

  if(!panelReturnViewActive()){
    alert('Ingrese a Expedientes por usuario → Solicitudes de devolución.');
    return;
  }

  const rows=panelSelectedReturnRows();
  if(!rows.length){
    alert('Seleccione uno o más expedientes con DEVOLUCIÓN SOLICITADA.');
    return;
  }

  fillPanelBulkReturnLocations();
  if(el('panelBulkReturnObservation'))el('panelBulkReturnObservation').value='';
  if(el('panelBulkReturnStatus'))el('panelBulkReturnStatus').textContent='';
  renderPanelBulkReturnTable();

  const btn=el('panelBulkReturnConfirmBtn');
  if(btn){
    btn.disabled=false;
    btn.textContent=`✓ Aceptar ${rows.length} devolución${rows.length===1?'':'es'}`;
  }

  el('panelBulkReturnModal')?.classList.add('show');
}

function closePanelBulkReturnModal(){
  el('panelBulkReturnModal')?.classList.remove('show');
}

async function confirmPanelBulkReturns(){
  if(!hasFullAccess())return;

  const rows=panelSelectedReturnRows();
  if(!rows.length){
    if(el('panelBulkReturnStatus')){
      el('panelBulkReturnStatus').textContent=
        'No hay expedientes seleccionados con DEVOLUCIÓN SOLICITADA.';
    }
    return;
  }

  const location=(el('panelBulkReturnLocation')?.value||'').trim();
  const observation=(el('panelBulkReturnObservation')?.value||'').trim();

  if(!location){
    if(el('panelBulkReturnStatus')){
      el('panelBulkReturnStatus').textContent='Seleccione la ubicación física de retorno.';
    }
    return;
  }

  const ids=rows.map(r=>r.id).filter(Boolean);
  const btn=el('panelBulkReturnConfirmBtn');

  if(btn)btn.disabled=true;
  if(el('panelBulkReturnStatus')){
    el('panelBulkReturnStatus').textContent=
      `Validando ${ids.length} expediente${ids.length===1?'':'s'}...`;
  }

  const {data:links,error:linksError}=await sb
    .from('solicitud_expedientes')
    .select('solicitud_id,expediente_id,estado,updated_at')
    .in('expediente_id',ids)
    .eq('estado','DEVOLUCIÓN SOLICITADA')
    .order('updated_at',{ascending:false});

  if(linksError){
    if(el('panelBulkReturnStatus'))el('panelBulkReturnStatus').textContent=linksError.message;
    if(btn)btn.disabled=false;
    return;
  }

  const latestByExp=new Map();
  (links||[]).forEach(x=>{
    const key=String(x.expediente_id||'');
    if(key&&!latestByExp.has(key))latestByExp.set(key,x);
  });

  const unresolved=ids.filter(id=>!latestByExp.has(String(id)));
  const validLinks=ids
    .map(id=>latestByExp.get(String(id)))
    .filter(Boolean);

  if(!validLinks.length){
    if(el('panelBulkReturnStatus')){
      el('panelBulkReturnStatus').textContent=
        'No se encontró una solicitud de devolución pendiente para los expedientes seleccionados.';
    }
    if(btn)btn.disabled=false;
    return;
  }

  const groups=new Map();
  validLinks.forEach(link=>{
    const sid=String(link.solicitud_id||'');
    if(!sid)return;
    if(!groups.has(sid))groups.set(sid,[]);
    groups.get(sid).push(link.expediente_id);
  });

  let confirmed=0;
  const confirmedIds=new Set();
  const errors=[];

  for(const [solicitudId,expedienteIds] of groups.entries()){
    if(el('panelBulkReturnStatus')){
      el('panelBulkReturnStatus').textContent=
        `Confirmando recepción física... ${confirmed} de ${validLinks.length}`;
    }

    const {data,error}=await sb.rpc('confirmar_devolucion_archivo_estado_fisico_v2',{
      p_solicitud_id:solicitudId,
      p_expediente_ids:expedienteIds,
      p_ubicacion_retorno:location,
      p_observacion:observation||null
    });

    if(error){
      errors.push(error.message);
      continue;
    }

    confirmed+=Number(data?.devueltos||expedienteIds.length);
    expedienteIds.forEach(id=>confirmedIds.add(String(id)));
  }

  [...selectedIds].forEach(id=>{
    if(confirmedIds.has(String(id)))selectedIds.delete(id);
  });

  if(errors.length||unresolved.length){
    const parts=[];
    if(confirmed)parts.push(`${confirmed} expediente${confirmed===1?' recibido':'s recibidos'}`);
    if(unresolved.length)parts.push(`${unresolved.length} sin solicitud pendiente identificada`);
    if(errors.length)parts.push(`Error: ${errors[0]}`);

    if(el('panelBulkReturnStatus')){
      el('panelBulkReturnStatus').textContent=parts.join(' · ');
    }

    if(btn)btn.disabled=false;
  }else{
    showToast(`${confirmed} expediente${confirmed===1?' recibido':'s recibidos'} por Archivo`);
    closePanelBulkReturnModal();
  }

  await refreshReturnCountersAndViews({
    full:true,
    reason:'RECEPCIÓN MÚLTIPLE DESDE EXPEDIENTES POR USUARIO'
  });

  updateSelectionUI();
  syncPanelReturnBulkUI();
}


function masterReturnFilterActive(){
  const selected=masterStateOptions().filter(x=>masterSelectedStates.has(x));
  return selected.length===1 && selected[0]==='DEVOLUCIÓN SOLICITADA';
}

function masterReturnedArchiveFilterActive(){
  const selected=masterStateOptions()
    .filter(x=>masterSelectedStates.has(x))
    .map(x=>norm(x));

  return (
    selected.length===1 &&
    ['DEVUELTO AL ARCHIVO','DEVUELTOS AL ARCHIVO'].includes(selected[0])
  );
}

function masterSelectedReturnRows(){
  return (allRows||[]).filter(r=>
    selectedIds.has(r.id) &&
    norm(operationalStatus(r))==='DEVOLUCIÓN SOLICITADA'
  );
}

function syncMasterReturnBulkUI(){
  const rows=masterSelectedReturnRows();
  const btn=el('masterBulkAcceptReturnBtn');
  const count=el('masterBulkAcceptReturnCount');
  const bar=el('masterBulkReturnBar');
  const filterActive=hasFullAccess() && masterReturnFilterActive();

  if(bar){
    bar.classList.toggle('hidden-by-role',!filterActive);
    bar.classList.toggle('hidden',!filterActive);
  }

  if(count)count.textContent=String(rows.length);

  if(btn){
    btn.disabled=!filterActive || rows.length===0;
    btn.textContent='';
    btn.insertAdjacentHTML(
      'beforeend',
      `✓ Aceptar devoluciones seleccionadas (<span id="masterBulkAcceptReturnCount">${rows.length}</span>)`
    );
    btn.title=!filterActive
      ?'Seleccione únicamente el estado DEVOLUCIÓN SOLICITADA en Filtros'
      :rows.length
        ?`Aceptar ${rows.length} devolución${rows.length===1?'':'es'} seleccionada${rows.length===1?'':'s'}`
        :'Marque uno o varios expedientes de la lista';
  }
}

function fillMasterBulkReturnLocations(){
  const sel=el('masterBulkReturnLocation');
  if(!sel)return;

  const current=sel.value||'';
  const locations=(catalogo||[])
    .filter(x=>x.activo!==false && x.tipo!=='PERSONAL')
    .map(x=>(x.nombre||'').trim())
    .filter(Boolean);

  const unique=[...new Set(locations)];
  sel.innerHTML=unique.length
    ?unique.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('')
    :'<option value="ARCHIVO">ARCHIVO</option>';

  if(current && [...sel.options].some(o=>o.value===current)){
    sel.value=current;
  }else{
    const archivo=[...sel.options].find(o=>norm(o.value).includes('ARCHIVO'));
    if(archivo)sel.value=archivo.value;
  }
}

function renderMasterBulkReturnTable(){
  const rows=masterSelectedReturnRows();
  const selectedTotal=[...selectedIds].filter(id=>(allRows||[]).some(r=>String(r.id)===String(id))).length;
  const excluded=Math.max(0,selectedTotal-rows.length);

  if(el('masterBulkReturnSummary')){
    el('masterBulkReturnSummary').textContent=
      `${rows.length} expediente${rows.length===1?'':'s'} para recibir`;
  }

  if(el('masterBulkReturnStatus')){
    el('masterBulkReturnStatus').textContent=excluded
      ?`${excluded} expediente${excluded===1?' seleccionado no está':'s seleccionados no están'} en DEVOLUCIÓN SOLICITADA y no se procesará${excluded===1?'':'n'}.`
      :'';
  }

  const box=el('masterBulkReturnTable');
  if(!box)return;

  if(!rows.length){
    box.innerHTML='<div class="empty">No hay expedientes seleccionados con DEVOLUCIÓN SOLICITADA.</div>';
    return;
  }

  box.innerHTML=`<table>
    <thead>
      <tr>
        <th>Expediente</th>
        <th>Extensión</th>
        <th>Responsable actual</th>
        <th>Cargo</th>
        <th>Últ. folio</th>
        <th>Estado</th>
      </tr>
    </thead>
    <tbody>
      ${rows.map(r=>`<tr>
        <td><b>${esc(expBase(r.expediente))}</b></td>
        <td>${r.extension?esc(r.extension):'—'}</td>
        <td>${esc(r.responsable||'—')}</td>
        <td>${esc(r.cargo||'—')}</td>
        <td>${esc(r.ultimo_folio||'—')}</td>
        <td>${rowStatus(r)}</td>
      </tr>`).join('')}
    </tbody>
  </table>`;
}

function openMasterBulkReturnModal(){
  if(!hasFullAccess()){
    alert('Solo Archivo o Administrador puede aceptar devoluciones.');
    return;
  }

  const rows=masterSelectedReturnRows();
  if(!rows.length){
    alert('Seleccione uno o más expedientes con DEVOLUCIÓN SOLICITADA.');
    return;
  }

  fillMasterBulkReturnLocations();
  if(el('masterBulkReturnObservation'))el('masterBulkReturnObservation').value='';
  renderMasterBulkReturnTable();

  const btn=el('masterBulkReturnConfirmBtn');
  if(btn){
    btn.disabled=false;
    btn.textContent=`✓ Aceptar ${rows.length} devolución${rows.length===1?'':'es'}`;
  }

  el('masterBulkReturnModal')?.classList.add('show');
}

function closeMasterBulkReturnModal(){
  el('masterBulkReturnModal')?.classList.remove('show');
}

async function confirmMasterBulkReturns(){
  if(!hasFullAccess())return;

  const rows=masterSelectedReturnRows();
  if(!rows.length){
    if(el('masterBulkReturnStatus')){
      el('masterBulkReturnStatus').textContent=
        'No hay expedientes seleccionados con DEVOLUCIÓN SOLICITADA.';
    }
    return;
  }

  const location=(el('masterBulkReturnLocation')?.value||'').trim();
  const observation=(el('masterBulkReturnObservation')?.value||'').trim();

  if(!location){
    if(el('masterBulkReturnStatus')){
      el('masterBulkReturnStatus').textContent='Seleccione la ubicación física de retorno.';
    }
    return;
  }

  const ids=rows.map(r=>r.id).filter(Boolean);
  const btn=el('masterBulkReturnConfirmBtn');
  if(btn)btn.disabled=true;
  if(el('masterBulkReturnStatus')){
    el('masterBulkReturnStatus').textContent=
      `Validando ${ids.length} expediente${ids.length===1?'':'s'} seleccionado${ids.length===1?'':'s'}...`;
  }

  // Buscar la solicitud activa de devolución de cada expediente.
  const {data:links,error:linksError}=await sb
    .from('solicitud_expedientes')
    .select('solicitud_id,expediente_id,estado,updated_at')
    .in('expediente_id',ids)
    .eq('estado','DEVOLUCIÓN SOLICITADA')
    .order('updated_at',{ascending:false});

  if(linksError){
    if(el('masterBulkReturnStatus'))el('masterBulkReturnStatus').textContent=linksError.message;
    if(btn)btn.disabled=false;
    return;
  }

  // Si existiera más de un vínculo histórico, tomar el más reciente por expediente.
  const latestByExp=new Map();
  (links||[]).forEach(x=>{
    const key=String(x.expediente_id||'');
    if(key && !latestByExp.has(key))latestByExp.set(key,x);
  });

  const unresolved=ids.filter(id=>!latestByExp.has(String(id)));
  const validLinks=ids
    .map(id=>latestByExp.get(String(id)))
    .filter(Boolean);

  if(!validLinks.length){
    if(el('masterBulkReturnStatus')){
      el('masterBulkReturnStatus').textContent=
        'No se encontró una solicitud de devolución pendiente para los expedientes seleccionados. Actualice el Registro maestro.';
    }
    if(btn)btn.disabled=false;
    return;
  }

  // La función de Supabase recibe una solicitud por llamada.
  // Agrupamos automáticamente para que el usuario pueda aceptar expedientes
  // de distintas solicitudes en una sola operación.
  const groups=new Map();
  validLinks.forEach(link=>{
    const sid=String(link.solicitud_id||'');
    if(!sid)return;
    if(!groups.has(sid))groups.set(sid,[]);
    groups.get(sid).push(link.expediente_id);
  });

  let confirmed=0;
  const confirmedIds=new Set();
  const errors=[];

  for(const [solicitudId,expedienteIds] of groups.entries()){
    if(el('masterBulkReturnStatus')){
      el('masterBulkReturnStatus').textContent=
        `Confirmando recepción física... ${confirmed} de ${validLinks.length}`;
    }

    const {data,error}=await sb.rpc('confirmar_devolucion_archivo_estado_fisico_v2',{
      p_solicitud_id:solicitudId,
      p_expediente_ids:expedienteIds,
      p_ubicacion_retorno:location,
      p_observacion:observation||null
    });

    if(error){
      errors.push(error.message);
      continue;
    }

    confirmed+=Number(data?.devueltos||expedienteIds.length);
    expedienteIds.forEach(id=>confirmedIds.add(String(id)));
  }

  // Quitar de la selección solo los expedientes efectivamente procesados.
  [...selectedIds].forEach(id=>{
    if(confirmedIds.has(String(id)))selectedIds.delete(id);
  });

  if(errors.length || unresolved.length){
    const parts=[];
    if(confirmed)parts.push(`${confirmed} expediente${confirmed===1?' recibido':'s recibidos'}`);
    if(unresolved.length)parts.push(`${unresolved.length} sin solicitud pendiente identificada`);
    if(errors.length)parts.push(`Error: ${errors[0]}`);
    if(el('masterBulkReturnStatus'))el('masterBulkReturnStatus').textContent=parts.join(' · ');
  }else{
    showToast(`${confirmed} expediente${confirmed===1?' recibido':'s recibidos'} por Archivo`);
    closeMasterBulkReturnModal();
  }

  await refreshReturnCountersAndViews({
    full:true,
    reason:'RECEPCIÓN MÚLTIPLE DESDE REGISTRO MAESTRO'
  });

  updateSelectionUI();
  syncMasterReturnBulkUI();

  if(btn)btn.disabled=false;
}


function updateSelectionUI(){
  const n=selectedIds.size;
  el('selectedCount').textContent=n+' seleccionado'+(n===1?'':'s');
  el('cargoBtn').disabled=n===0;
  if(el('requestBtn'))el('requestBtn').disabled=n===0;
  if(el('bulkReassignBtn'))el('bulkReassignBtn').disabled=n===0;
  if(el('bulkReturnBtn'))el('bulkReturnBtn').disabled=n===0;
  if(el('bulkConasBtn'))el('bulkConasBtn').disabled=n===0;
  if(el('bulkDvcBtn'))el('bulkDvcBtn').disabled=n===0;
  if(el('bulkInstructionBtn'))el('bulkInstructionBtn').disabled=n===0;
  syncPanelReturnBulkUI();
  syncMasterReturnBulkUI();
}
function toggleSelect(id,checked,checkbox){
  if(checked)selectedIds.add(id);else selectedIds.delete(id);
  if(checkbox?.closest('tr')){
    checkbox.closest('tr').classList.toggle('record-selected-row',checked);
  }
  updateSelectionUI();
}
function toggleSelectFromRow(event,id,disabled=false){
  if(disabled)return;

  // Los controles internos mantienen su comportamiento normal y no deben
  // seleccionar/deseleccionar la fila por accidente.
  if(event?.target?.closest('input,button,a,select,textarea,label'))return;

  const checked=!selectedIds.has(id);
  if(checked)selectedIds.add(id);else selectedIds.delete(id);

  const row=event?.currentTarget;
  if(row){
    row.classList.toggle('record-selected-row',checked);
    const checkbox=row.querySelector('input[type="checkbox"]:not(:disabled)');
    if(checkbox)checkbox.checked=checked;
  }

  updateSelectionUI();
}
function rowClickHasInteractiveTarget(event){
  return !!event?.target?.closest('input,button,a,select,textarea,label');
}

function toggleVisibleStateRows(checked){
  const boxes=[...document.querySelectorAll('#stateDetailTable input[data-state-row-select]:not(:disabled)')];
  boxes.forEach(cb=>{
    const id=cb.dataset.stateRowSelect;
    if(!id)return;
    cb.checked=!!checked;
    if(checked)selectedIds.add(id);else selectedIds.delete(id);
    cb.closest('tr')?.classList.toggle('record-selected-row',!!checked);
  });
  updateSelectionUI();
}

function toggleRequestItemFromRow(event,id,selectable=true){
  if(!selectable || rowClickHasInteractiveTarget(event))return;
  toggleRequestItem(id,!requestSelectedIds.has(id));
}

function toggleReturnedArchiveFromRow(event,id,selectable=true){
  if(!selectable || rowClickHasInteractiveTarget(event))return;
  toggleReturnedArchive(id,!returnedArchiveSelectedIds.has(id));
}

function toggleReturnRequestFromRow(event,key){
  if(rowClickHasInteractiveTarget(event))return;
  const checked=!returnRequestSelectedKeys.has(key);
  if(checked)returnRequestSelectedKeys.add(key);else returnRequestSelectedKeys.delete(key);
  const row=event?.currentTarget;
  row?.classList.toggle('record-selected-row',checked);
  const cb=row?.querySelector('input[type="checkbox"]:not(:disabled)');
  if(cb)cb.checked=checked;
  syncReturnRequestBulkUI();
}

function selectCargoFromRow(event,numero){
  if(rowClickHasInteractiveTarget(event))return;
  selectCargoForPrint(numero);
}

function toggleAllRows(checked,source){
  const rows=source==='all'?allRows:(source==='states'?stateDetailRows:panelRows);

  rows.filter(r=>
    source==='all'
      ?masterCycleRowSelectable(r)
      :!r._internal_reassign_requested
  ).forEach(r=>
    checked
      ?selectedIds.add(r.id)
      :selectedIds.delete(r.id)
  );
  updateSelectionUI();
  if(source==='all')el('allTable').innerHTML=recordTable(allRows,true,'all');
  else if(source==='states')el('stateDetailTable').innerHTML=recordTable(stateDetailRows,true,'states');
  else el('panelTable').innerHTML=recordTable(panelRows,false,'panel');
}


function closeBulkReassignModal(){
  el('bulkReassignModal')?.classList.remove('show');
  bulkReassignRows=[];
}

function updateBulkReassignField(id,value){
  const row=bulkReassignRows.find(x=>String(x.id)===String(id));
  if(!row)return;
  row.ultimo_folio=String(value??'').trim();
  syncBulkReassignState();
}

function syncBulkReassignState(){
  const rows=bulkReassignRows||[];
  const target=String(el('bulkReassignTarget')?.value||'').trim();
  const missing=rows.filter(x=>!String(x.ultimo_folio||'').trim());
  const btn=el('bulkReassignSubmitBtn');
  if(btn){
    btn.disabled=!rows.length||!target||missing.length>0;
    btn.textContent=rows.length
      ?`REASIGNAR ${rows.length} EXPEDIENTE${rows.length===1?'':'S'}`
      :'REASIGNAR EXPEDIENTES';
  }
  if(el('bulkReassignStatus')){
    el('bulkReassignStatus').textContent=!target
      ?'Seleccione el nuevo responsable.'
      :(missing.length
        ?`Falta ingresar el Último folio en ${missing.length} expediente${missing.length===1?'':'s'}.`
        :'Datos completos. Puede efectuar la reasignación.');
  }
}

function renderBulkReassignRows(){
  if(el('bulkReassignCount'))el('bulkReassignCount').textContent=bulkReassignRows.length;
  if(el('bulkReassignArchiveCount')){
    el('bulkReassignArchiveCount').textContent=bulkReassignRows.filter(x=>x.archive_request_id).length;
  }

  if(!bulkReassignRows.length){
    el('bulkReassignTable').innerHTML='<div class="empty">No hay expedientes válidos para reasignar.</div>';
    syncBulkReassignState();
    return;
  }

  el('bulkReassignTable').innerHTML=`<table>
    <thead><tr>
      <th>N°</th><th>Expediente</th><th>Ext.</th><th>Cargo</th><th>Estado</th><th>Origen</th><th>Asunto para la nueva atención</th><th>Último folio *</th>
    </tr></thead>
    <tbody>${bulkReassignRows.map((r,i)=>`<tr>
      <td>${i+1}</td>
      <td><b>${esc(r.expediente||'—')}</b></td>
      <td>${esc(r.extension||'—')}</td>
      <td>${esc(r.cargo||r.cargo_numero||'—')}</td>
      <td><span class="pill loan">EN PRÉSTAMO</span></td>
      <td><span class="bulk-return-source ${r.archive_request_id?'archive':''}">${r.archive_request_id?'SOLICITADO POR EL ARCHIVO':'CUSTODIA DEL USUARIO'}</span></td>
       <td class="v752-subject-col"><div class="v752-previous-subject">Vigente: ${esc(r._v752_asunto||'Se conserva el asunto del ciclo')}</div><select class="v752-subject-select" onchange="v752ChangeBulkAsunto('${r.id}',this.value)">${v752AsuntoOptions(r._v752_nuevo||'')}</select></td>
      <td><input class="bulk-return-input required" value="${esc(r.ultimo_folio||'')}" placeholder="Último folio" required
        oninput="updateBulkReassignField('${r.id}',this.value)"></td>
    </tr>`).join('')}</tbody>
  </table>`;

  syncBulkReassignState();
}

async function openBulkReassignModal(){
  if(!isLimitedUser()){
    showToast('La reasignación múltiple está disponible para el responsable actual en su espacio personal (Usuario, Coordinador, Archivo o Administrador).');
    return;
  }

  const ids=[...selectedIds];
  if(!ids.length){
    showToast('Seleccione uno o más expedientes.');
    return;
  }

  const nombre=String(currentProfile?.nombre_personal||'').trim();
  if(!nombre){
    showToast('La cuenta no tiene personal asociado.');
    return;
  }

  await loadReassignmentProfiles();
  const targets=reassignmentNames().filter(x=>norm(x)!==norm(nombre));
  const select=el('bulkReassignTarget');
  if(select){
    select.innerHTML='<option value="">— SELECCIONE NUEVO RESPONSABLE —</option>'+targets.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('');
    select.value='';
  }
  if(el('bulkReassignObservation'))el('bulkReassignObservation').value='';
  if(el('bulkReassignStatus'))el('bulkReassignStatus').textContent='Verificando custodia y ciclo activo...';
  el('bulkReassignModal')?.classList.add('show');

  const {data,error}=await sb.rpc('v687_preparar_reasignacion',{
    p_expediente_ids:ids
  });

  if(error){
    el('bulkReassignTable').innerHTML=`<div class="empty">${esc(error.message||'No se pudo validar la selección.')}</div>`;
    if(el('bulkReassignStatus'))el('bulkReassignStatus').textContent='No se pudo preparar la reasignación.';
    if(el('bulkReassignSubmitBtn'))el('bulkReassignSubmitBtn').disabled=true;
    return;
  }

  const prepared=Array.isArray(data)?data:[];
  const byId=new Map(prepared.map(x=>[String(x.expediente_id||x.id),x]));
  const invalid=[];
  const rows=[];

  for(const id of ids){
    const row=byId.get(String(id));
    if(!row){
      invalid.push({id,expediente:String(id),motivo:'No se pudo validar el expediente en el contexto actual.'});
      continue;
    }
    if(!row.puede_reasignar){
      invalid.push({
        id,
        expediente:row.expediente||String(id),
        motivo:row.motivo_no_reasignable||'El expediente no puede reasignarse desde este perfil.'
      });
      continue;
    }
    rows.push({
      ...row,
      id:row.expediente_id||row.id,
      cargo:row.cargo||row.cargo_numero||'',
      ultimo_folio:String(row.ultimo_folio||'').trim()
    });
  }

  if(invalid.length){
    // Una selección inválida suele indicar que la pantalla conservó datos de
    // otro perfil o que el expediente cambió de responsable. Retirarla para
    // impedir que vuelva a contaminar la siguiente operación.
    invalid.forEach(x=>selectedIds.delete(x.id));
    try{updateSelectionUI();}catch(_){}

    bulkReassignRows=[];
    el('bulkReassignTable').innerHTML=`<div class="empty">
      <b>La selección ya no corresponde a la custodia del perfil actual.</b><br><br>
      ${invalid.map(x=>`<div style="margin:8px 0"><b>${esc(x.expediente)}</b> · ${esc(x.motivo)}</div>`).join('')}
      <br>Actualice la vista o ingrese con el responsable actual para efectuar la reasignación.
    </div>`;
    if(el('bulkReassignCount'))el('bulkReassignCount').textContent='0';
    if(el('bulkReassignArchiveCount'))el('bulkReassignArchiveCount').textContent='0';
    if(el('bulkReassignStatus'))el('bulkReassignStatus').textContent='La selección inválida fue retirada.';
    if(el('bulkReassignSubmitBtn'))el('bulkReassignSubmitBtn').disabled=true;
    return;
  }

  bulkReassignRows=rows.sort((a,b)=>String(a.expediente||'').localeCompare(String(b.expediente||''),'es',{numeric:true}));
  renderBulkReassignRows();
  v752FetchBulkSubjects(bulkReassignRows);
}

async function submitBulkReassign(){
  if(!isLimitedUser()||!bulkReassignRows.length)return;

  const nuevo=String(el('bulkReassignTarget')?.value||'').trim();
  const obs=String(el('bulkReassignObservation')?.value||'').trim();
  // V746: la observación opcional se registra con cada movimiento de reasignación.
  const correoDraftV560=typeof window.v560CaptureReassignMailDraft==='function'
    ?window.v560CaptureReassignMailDraft({nuevo,observacion:obs,items:bulkReassignRows})
    :null;
  if(correoDraftV560?.invalid){
    if(el('bulkReassignStatus'))el('bulkReassignStatus').textContent=correoDraftV560.invalid;
    return;
  }
  if(!nuevo){
    if(el('bulkReassignStatus'))el('bulkReassignStatus').textContent='Seleccione el nuevo responsable.';
    return;
  }

  const missing=bulkReassignRows.filter(x=>!String(x.ultimo_folio||'').trim());
  if(missing.length){
    if(el('bulkReassignStatus'))el('bulkReassignStatus').textContent='El Último folio es obligatorio para todos los expedientes.';
    return;
  }

  const btn=el('bulkReassignSubmitBtn');
  if(btn)btn.disabled=true;
  if(el('bulkReassignStatus'))el('bulkReassignStatus').textContent='Registrando reasignación...';

  try{
    // V753: antes de mover la custodia, consultar los asuntos vigentes de TODOS
    // los expedientes incluidos en el correo. No utilizar el asunto original del cargo.
    // Si no se puede determinar un asunto previo de modo fiable, no enviar un correo
    // incorrecto ni iniciar aún una reasignación parcialmente notificada.
    if(correoDraftV560?.enabled){
      const {data:subjectRows,error:subjectError}=await sb.rpc('v723_cargo_materia_ciclo_vigente',{
        p_expediente_ids:bulkReassignRows.map(x=>x.id)
      });
      if(subjectError)throw new Error(`No se pudieron consultar los asuntos para el correo: ${subjectError.message}`);
      const byExp=new Map((subjectRows||[]).map(x=>[String(x.expediente_id),x]));
      for(const row of bulkReassignRows){
        const prior=byExp.get(String(row.id));
        if(!prior || (String(row.solicitud_id||'') && String(prior.solicitud_id||'')!==String(row.solicitud_id||''))){
          throw new Error(`No se confirmó el asunto del expediente ${row.expediente||row.id}. Actualice y vuelva a intentar.`);
        }
        row._v752_asunto=String(prior.asunto||'').trim();
      }
    }

    // 1) Expedientes solicitados expresamente por Archivo: mantener activa la solicitud de entrega.
    const archiveRows=bulkReassignRows.filter(x=>x.archive_request_id);
    for(const row of archiveRows){
      const {error}=await sb.rpc('v752_gestionar_archivo_con_asunto',{
        p_asunto:String(row._v752_nuevo||'').trim()||null,
        p_solicitud_entrega_id:row.archive_request_id,
        p_accion:'REASIGNAR',
        p_rd:null,
        p_ultimo_folio:String(row.ultimo_folio||'').trim(),
        p_nuevo_responsable:nuevo,
        p_observacion:obs||null
      });
      if(error)throw error;
    }

    // 2) Reasignaciones normales: agrupar por solicitud para usar la función estable ya existente.
    const normalRows=bulkReassignRows.filter(x=>!x.archive_request_id);
    const groups=new Map();
    normalRows.forEach(row=>{
      const key=String(row.solicitud_id||'');
      if(!groups.has(key))groups.set(key,[]);
      groups.get(key).push(row);
    });

    for(const [solicitudId,rows] of groups.entries()){
      const {error:folioError}=await sb.rpc('actualizar_ultimos_folios_mi_custodia',{
        p_solicitud_id:solicitudId,
        p_items:rows.map(x=>({
          id:x.id,
          ultimo_folio:String(x.ultimo_folio||'').trim()
        }))
      });
      if(folioError)throw folioError;

      const {error:reasignError}=await sb.rpc('v752_reasignar_con_asunto',{
        p_asuntos:v752AsuntosBulk(rows),
        p_solicitud_id:solicitudId,
        p_expediente_ids:rows.map(x=>x.id),
        p_nuevo_responsable:nuevo,
        p_observacion:obs||null
      });
      if(reasignError)throw reasignError;
    }

    let correoV560Resultado=null;
    if(correoDraftV560?.enabled && typeof window.v560EnqueueReassignMail==='function'){
      try{
        correoV560Resultado=await window.v560EnqueueReassignMail({
          draft:correoDraftV560,
          nuevo,observacion:obs,
          items:bulkReassignRows
        });
      }catch(mailErr){
        console.warn('V560 · reasignación realizada, correo pendiente:',mailErr);
        correoV560Resultado={ok:false,error:mailErr?.message||String(mailErr)};
      }
    }

    const count=bulkReassignRows.length;
    selectedIds.clear();
    updateSelectionUI();
    closeBulkReassignModal();
    showToast(`${count} expediente${count===1?'':'s'} reasignado${count===1?'':'s'} a ${nuevo}`);
    if(correoDraftV560?.enabled){
      setTimeout(()=>{
        if(correoV560Resultado?.sent>0){
          showToast(`✉ Correo de reasignación encolado para ${correoV560Resultado.sent} destinatario${correoV560Resultado.sent===1?'':'s'}. Consulte el estado de envío.`);
        }else if(correoV560Resultado?.queued>0){
          showToast(`✉ Reasignación registrada. ${correoV560Resultado.queued} correo${correoV560Resultado.queued===1?'':'s'} quedó${correoV560Resultado.queued===1?'':'aron'} en cola.`);
        }else if(correoV560Resultado?.ok===false){
          showToast('Reasignación realizada. El aviso por correo no pudo procesarse y puede reintentarse.',7000);
        }
      },500);
    }

    await Promise.all([
      loadSummary(),loadPanel(),loadRequests(),
      loadNotifications(true),loadArchiveDeliveryRequests(true),loadOperationalAlerts(true)
    ]);
  }catch(err){
    if(el('bulkReassignStatus'))el('bulkReassignStatus').textContent=err?.message||String(err);
    if(btn)btn.disabled=false;
  }
}


async function reconcileArchiveLoanInconsistencies(){
  if(!sb||!session)return null;

  try{
    const {data,error}=await sb.rpc(
      'reconciliar_archivo_en_prestamo'
    );

    if(error){
      // El sistema continúa funcionando aunque el SQL todavía
      // no se haya instalado.
      console.warn(
        'reconciliar_archivo_en_prestamo:',
        error.message
      );
      return null;
    }

    return data||null;
  }catch(error){
    console.warn(
      'Reconciliación ARCHIVO + EN PRÉSTAMO:',
      error?.message||error
    );
    return null;
  }
}


function bulkReturnVisibleCycleContext(expedienteId,myName){
  const id=String(expedienteId||'');

  const sources=[
    ...(panelRows||[]),
    ...(stateDetailRows||[]),
    ...(allRows||[])
  ].filter(r=>
    String(r?.id||r?.expediente_id||'')===id
  );

  const active=sources.filter(r=>{
    const responsible=String(
      r?.responsable_actual||
      r?.responsable||
      r?.ubicacion_actual||
      ''
    ).trim();

    const state=norm(
      r?.estado_solicitud_item||
      r?.estado_item||
      operationalStatus(r)||
      r?.estado||
      ''
    );

    return (
      norm(responsible)===norm(myName) &&
      ['EN PRÉSTAMO','REASIGNADO'].includes(state)
    );
  });

  const ordered=(active.length?active:sources).sort((a,b)=>{
    const at=new Date(
      a?.solicitud_created_at||
      a?.fecha_solicitud||
      a?.created_at||
      a?.fecha_ultimo_estado||
      0
    ).getTime();

    const bt=new Date(
      b?.solicitud_created_at||
      b?.fecha_solicitud||
      b?.created_at||
      b?.fecha_ultimo_estado||
      0
    ).getTime();

    return (isNaN(bt)?0:bt)-(isNaN(at)?0:at);
  });

  return ordered[0]||null;
}

function bulkReturnCycleState(link){
  return norm(link?.estado||'');
}

function bulkReturnExclusionReason(exp,link,myName,visibleCycle=null){
  if(!exp){
    return 'No se pudo validar el expediente en la base de datos.';
  }

  if(norm(exp.modalidad||'')==='COPIA DIGITAL'){
    return 'La modalidad COPIA DIGITAL no requiere devolución física.';
  }

  if(link && bulkReturnCycleState(link)==='DEVOLUCIÓN SOLICITADA'){
    return 'La devolución de este ciclo ya fue solicitada y está pendiente de recepción por Archivo.';
  }

  if(!link){
    const globalResponsible=String(exp.responsable||'').trim();

    if(
      norm(globalResponsible).includes('ARCHIVO') &&
      visibleCycle
    ){
      return 'Se encontró un ciclo anterior cerrado en Archivo, pero no se pudo identificar el ciclo activo seleccionado.';
    }

    if(globalResponsible && norm(globalResponsible)!==norm(myName)){
      return `No existe un ciclo activo bajo su custodia. El registro físico global figura con ${globalResponsible}.`;
    }

    return 'No existe un ciclo activo EN PRÉSTAMO bajo su responsabilidad.';
  }

  const cycleResponsible=String(link.responsable_actual||'').trim();

  if(norm(cycleResponsible)!==norm(myName)){
    return cycleResponsible
      ?`El ciclo activo está actualmente bajo responsabilidad de ${cycleResponsible}.`
      :'El ciclo activo no figura bajo su responsabilidad.';
  }

  return 'No puede devolverse en esta operación.';
}

function canUseBulkReturn(){
  // V652 · USUARIO, COORDINADOR, ARCHIVO y ADMINISTRADOR pueden registrar devoluciones
  // de expedientes que estén efectivamente bajo su propia custodia.
  return isLimitedUser()||isArchive()||isAdmin();
}

function closeBulkReturnModal(){
  el('bulkReturnModal')?.classList.remove('show');
  bulkReturnRows=[];
  bulkReturnExcludedRows=[];
  bulkReturnSelectedTotal=0;
}

function updateBulkReturnField(id,field,value){
  const row=bulkReturnRows.find(x=>String(x.id)===String(id));
  if(!row)return;
  row[field]=String(value??'').trim();
  syncBulkReturnState();
}

function syncBulkReturnState(){
  const rows=bulkReturnRows||[];
  const excluded=bulkReturnExcludedRows||[];
  const missing=rows.filter(
    x=>!String(x.ultimo_folio||'').trim()
  );

  const btn=el('bulkReturnSubmitBtn');

  if(btn){
    btn.disabled=!rows.length||missing.length>0;
    btn.textContent=rows.length
      ?`DEVOLVER ${rows.length} EXPEDIENTE${rows.length===1?'':'S'}`
      :'SIN EXPEDIENTES VÁLIDOS';
  }

  if(el('bulkReturnStatus')){
    if(!rows.length){
      el('bulkReturnStatus').textContent=
        excluded.length
          ?`${excluded.length} expediente${excluded.length===1?' fue excluido':'s fueron excluidos'} porque ya no se encuentra${excluded.length===1?'':'n'} bajo su custodia o no tiene${excluded.length===1?'':'n'} un préstamo activo.`
          :'No hay expedientes válidos para devolver.';
    }else if(missing.length){
      el('bulkReturnStatus').textContent=
        `Falta ingresar el Último folio en ${missing.length} expediente${missing.length===1?'':'s'}.`;
    }else if(excluded.length){
      el('bulkReturnStatus').textContent=
        `${rows.length} válido${rows.length===1?'':'s'} para devolver · ${excluded.length} excluido${excluded.length===1?'':'s'} no se procesará${excluded.length===1?'':'n'}.`;
    }else{
      el('bulkReturnStatus').textContent=
        'Datos completos. Puede efectuar la devolución.';
    }
  }
}

function renderBulkReturnRows(){
  const valid=bulkReturnRows||[];
  const excluded=bulkReturnExcludedRows||[];

  if(el('bulkReturnSelectedTotal')){
    el('bulkReturnSelectedTotal').textContent=
      String(bulkReturnSelectedTotal||0);
  }

  if(el('bulkReturnCount')){
    el('bulkReturnCount').textContent=
      String(valid.length);
  }

  if(el('bulkReturnExcludedCount')){
    el('bulkReturnExcludedCount').textContent=
      String(excluded.length);
  }

  if(el('bulkReturnArchiveCount')){
    el('bulkReturnArchiveCount').textContent=
      String(
        valid.filter(x=>x.archive_request_id).length
      );
  }

  const box=el('bulkReturnTable');
  if(!box)return;

  const validHtml=valid.length
    ?`
      <div class="bulk-return-valid-title">
        ✓ Expedientes válidos para devolver
      </div>

      <table>
        <thead>
          <tr>
            <th>N°</th>
            <th>Expediente</th>
            <th>Ext.</th>
            <th>Responsable actual</th>
            <th>Cargo</th>
            <th>Solicitud / ciclo</th>
            <th>Origen</th>
            <th>R.D. (opcional)</th>
            <th>Último folio *</th>
            <th>Observación del expediente (opcional)</th>
          </tr>
        </thead>
        <tbody>
          ${valid.map((r,i)=>`<tr>
            <td>${i+1}</td>
            <td><b>${esc(r.expediente||'—')}</b></td>
            <td>${esc(r.extension||'—')}</td>
            <td><b>${esc(r.responsable||'—')}</b></td>
            <td>${esc(r.cargo_numero||r.cargo||'—')}</td>
            <td>
              <b>${esc(r.solicitud_numero||'CICLO ACTIVO')}</b>
            </td>
            <td>
              <span class="bulk-return-source ${r.archive_request_id?'archive':''}">
                ${r.archive_request_id
                  ?'SOLICITADO POR EL ARCHIVO'
                  :(isArchive()
                    ?'DEVOLUCIÓN DE ARCHIVO'
                    :'DEVOLUCIÓN DEL USUARIO')}
              </span>
            </td>
            <td>
              <input
                class="bulk-return-input"
                value="${esc(r.rd||'')}"
                placeholder="R.D. (opcional)"
                oninput="updateBulkReturnField('${r.id}','rd',this.value)">
            </td>
            <td>
              <input
                class="bulk-return-input required"
                value="${esc(r.ultimo_folio||'')}"
                placeholder="Último folio"
                required
                oninput="updateBulkReturnField('${r.id}','ultimo_folio',this.value)">
            </td>
            <td>
              <textarea class="bulk-return-input" rows="2" maxlength="700" style="min-width:190px;resize:vertical" placeholder="Comentario específico (opcional)" oninput="updateBulkReturnField('${r.id}','observacion',this.value)">${esc(r.observacion||'')}</textarea>
            </td>
          </tr>`).join('')}
        </tbody>
      </table>
    `
    :`
      <div class="empty">
        No hay expedientes válidos para devolver en esta selección.
      </div>
    `;

  const excludedHtml=excluded.length
    ?`
      <div class="bulk-return-excluded-box">
        <div class="bulk-return-excluded-title">
          Expedientes excluidos · no se procesarán
        </div>

        <table>
          <thead>
            <tr>
              <th>Expediente</th>
              <th>Ext.</th>
              <th>Responsable actual</th>
              <th>Estado físico</th>
              <th>Motivo</th>
              <th>Resultado</th>
            </tr>
          </thead>
          <tbody>
            ${excluded.map(r=>`<tr class="bulk-return-excluded-row">
              <td><b>${esc(r.expediente||r.id||'—')}</b></td>
              <td>${esc(r.extension||'—')}</td>
              <td><b>${esc(r.responsable||'—')}</b></td>
              <td>${esc(r.estado||'—')}</td>
              <td>${esc(r._exclude_reason||'No puede devolverse en esta operación.')}</td>
              <td>
                <span class="bulk-return-excluded-badge">
                  NO INCLUIDO
                </span>
              </td>
            </tr>`).join('')}
          </tbody>
        </table>
      </div>
    `
    :'';

  box.innerHTML=validHtml+excludedHtml;
  syncBulkReturnState();
}
async function openBulkReturnModal(){
  if(!canUseBulkReturn()){
    showToast(
      'La devolución está disponible para USUARIO, COORDINADOR, ARCHIVO y ADMINISTRADOR.'
    );
    return;
  }

  const ids=[...selectedIds];

  if(!ids.length){
    showToast('Seleccione uno o más expedientes.');
    return;
  }

  const nombre=String(
    currentProfile?.nombre_personal||''
  ).trim();

  if(!nombre){
    showToast(
      'La cuenta no tiene personal asociado.'
    );
    return;
  }

  bulkReturnRows=[];
  bulkReturnExcludedRows=[];
  bulkReturnSelectedTotal=ids.length;
  if(el('bulkReturnObservation'))el('bulkReturnObservation').value='';

  if(el('bulkReturnSelectedTotal')){
    el('bulkReturnSelectedTotal').textContent=
      String(ids.length);
  }
  if(el('bulkReturnCount')){
    el('bulkReturnCount').textContent='0';
  }
  if(el('bulkReturnExcludedCount')){
    el('bulkReturnExcludedCount').textContent='0';
  }
  if(el('bulkReturnArchiveCount')){
    el('bulkReturnArchiveCount').textContent='0';
  }

  if(el('bulkReturnStatus')){
    el('bulkReturnStatus').textContent=
      'Verificando custodia actual de los expedientes seleccionados...';
  }

  if(el('bulkReturnTable')){
    el('bulkReturnTable').innerHTML=
      '<div class="empty">Validando expedientes...</div>';
  }

  el('bulkReturnModal')?.classList.add('show');

  // Corregir silenciosamente inconsistencias comprobadas
  // ARCHIVO + EN PRÉSTAMO antes de validar la selección.
  await reconcileArchiveLoanInconsistencies();

  const [
    expResult,
    linkResult,
    archiveResult
  ]=await Promise.all([
    sb.from('expedientes')
      .select(
        'id,expediente,extension,rd,ultimo_folio,responsable,estado,cargo,modalidad,fecha_devolucion'
      )
      .in('id',ids),

    sb.from('solicitud_expedientes')
      .select(
        'id,solicitud_id,expediente_id,estado,responsable_actual,cargo_numero,created_at,updated_at,fecha_entrega,fecha_solicitud_devolucion,fecha_devolucion'
      )
      .in('expediente_id',ids)
      .in(
        'estado',
        [
          'EN PRÉSTAMO',
          'DEVOLUCIÓN SOLICITADA'
        ]
      )
      .order(
        'updated_at',
        {ascending:false}
      ),

    sb.rpc(
      'listar_solicitudes_entrega_archivo_pendientes'
    )
  ]);

  const expData=expResult.data||[];
  const expError=expResult.error;
  const linkData=linkResult.data||[];
  const linkError=linkResult.error;
  const archiveData=archiveResult.data||[];
  const archiveError=archiveResult.error;

  if(expError||linkError){
    el('bulkReturnTable').innerHTML=
      `<div class="empty">
        ${esc((expError||linkError).message)}
      </div>`;

    if(el('bulkReturnStatus')){
      el('bulkReturnStatus').textContent=
        'No se pudo preparar la devolución múltiple.';
    }

    return;
  }

  const archiveRows=
    archiveError
      ?[]
      :archiveData;

  const archiveMap=new Map(
    archiveRows
      .filter(
        x=>
          norm(x.estado||'')===
          'SOLICITADA'
      )
      .map(
        x=>[
          String(x.expediente_id),
          x
        ]
      )
  );

  const links=linkData||[];
  const rows=[];
  const excluded=[];

  for(const e of expData){
    const visibleCycle=
      bulkReturnVisibleCycleContext(
        e.id,
        nombre
      );

    const expectedRequestId=String(
      visibleCycle?.solicitud_id||
      visibleCycle?.solicitud_pendiente_id||
      ''
    );

    const candidateLinks=links
      .filter(x=>
        String(x.expediente_id)===String(e.id)
      )
      .sort((a,b)=>{
        const bt=new Date(b.updated_at||b.created_at||0).getTime();
        const at=new Date(a.updated_at||a.created_at||0).getTime();
        return (isNaN(bt)?0:bt)-(isNaN(at)?0:at);
      });

    // 1. El ciclo que el usuario está viendo/seleccionando.
    let activeLoanLink=
      expectedRequestId
        ?candidateLinks.find(x=>
            String(x.solicitud_id)===expectedRequestId &&
            norm(x.responsable_actual)===norm(nombre) &&
            norm(x.estado)==='EN PRÉSTAMO'
          )
        :null;

    // 2. Respaldo: último ciclo EN PRÉSTAMO realmente bajo su custodia.
    if(!activeLoanLink){
      activeLoanLink=candidateLinks.find(x=>
        norm(x.responsable_actual)===norm(nombre) &&
        norm(x.estado)==='EN PRÉSTAMO'
      )||null;
    }

    // Detectar devolución ya solicitada del MISMO ciclo seleccionado.
    let returnRequestedLink=
      expectedRequestId
        ?candidateLinks.find(x=>
            String(x.solicitud_id)===expectedRequestId &&
            norm(x.responsable_actual)===norm(nombre) &&
            norm(x.estado)==='DEVOLUCIÓN SOLICITADA'
          )
        :null;

    if(!returnRequestedLink && !activeLoanLink){
      returnRequestedLink=candidateLinks.find(x=>
        norm(x.responsable_actual)===norm(nombre) &&
        norm(x.estado)==='DEVOLUCIÓN SOLICITADA'
      )||null;
    }

    // V103:
    // La validez se decide por el CICLO ACTIVO (solicitud_expedientes).
    // Un ciclo anterior DEVUELTO AL ARCHIVO no bloquea un préstamo nuevo.
    if(
      norm(e.modalidad||'')==='COPIA DIGITAL' ||
      !activeLoanLink
    ){
      excluded.push({
        ...e,
        responsable:
          returnRequestedLink?.responsable_actual||
          activeLoanLink?.responsable_actual||
          e.responsable,
        _exclude_reason:
          bulkReturnExclusionReason(
            e,
            returnRequestedLink||activeLoanLink,
            nombre,
            visibleCycle
          )
      });
      continue;
    }

    const archiveReq=
      archiveMap.get(
        String(e.id)
      )||
      null;

    rows.push({
      ...e,

      // El vínculo/ciclo es la fuente operativa actual.
      responsable:
        activeLoanLink.responsable_actual||
        e.responsable,

      estado:
        activeLoanLink.estado||
        e.estado,

      solicitud_id:
        activeLoanLink.solicitud_id,

      solicitud_expediente_id:
        activeLoanLink.id,

      cargo_numero:
        activeLoanLink.cargo_numero||
        visibleCycle?.cargo_numero||
        visibleCycle?.cargo||
        e.cargo,

      solicitud_numero:
        visibleCycle?.solicitud_numero||
        visibleCycle?.solicitud_pendiente_numero||
        '',

      archive_request_id:
        archiveReq?.id||null,

      ultimo_folio:
        String(
          visibleCycle?.ultimo_folio||
          e.ultimo_folio||
          ''
        ).trim(),

      rd:
        String(
          visibleCycle?.rd||
          e.rd||
          ''
        ).trim(),

      _cycle_active:true
    });
  }

  // IDs que la consulta no devolvió también se muestran como excluidos.
  const returnedIds=new Set(
    expData.map(
      x=>String(x.id)
    )
  );

  ids
    .filter(
      id=>
        !returnedIds.has(
          String(id)
        )
    )
    .forEach(id=>{
      excluded.push({
        id,
        expediente:String(id),
        extension:'',
        responsable:'—',
        estado:'—',
        _exclude_reason:
          'No se pudo validar el expediente en la base de datos o no es visible para este usuario.'
      });
    });

  bulkReturnRows=rows.sort(
    (a,b)=>
      String(a.expediente||'')
        .localeCompare(
          String(b.expediente||''),
          'es',
          {numeric:true}
        )
  );

  bulkReturnExcludedRows=excluded.sort(
    (a,b)=>
      String(a.expediente||'')
        .localeCompare(
          String(b.expediente||''),
          'es',
          {numeric:true}
        )
  );

  renderBulkReturnRows();
}
async function submitBulkReturn(){
  if(!canUseBulkReturn()||!bulkReturnRows.length)return;

  const missing=bulkReturnRows.filter(x=>!String(x.ultimo_folio||'').trim());
  if(missing.length){
    if(el('bulkReturnStatus'))el('bulkReturnStatus').textContent='El Último folio es obligatorio para todos los expedientes.';
    return;
  }

  const count=bulkReturnRows.length;

  const btn=el('bulkReturnSubmitBtn');
  if(btn)btn.disabled=true;
  if(el('bulkReturnStatus'))el('bulkReturnStatus').textContent='Actualizando datos y registrando devoluciones...';

  const {data,error}=await sb.rpc('devolver_expedientes_usuario_nuevo',{
    p_items:bulkReturnRows.map(x=>({
      solicitud_id:x.solicitud_id,
      expediente_id:x.id,
      solicitud_entrega_archivo_id:x.archive_request_id||null,
      rd:String(x.rd||'').trim()||null,
      ultimo_folio:String(x.ultimo_folio||'').trim(),
      observacion:(()=>{
        const general=String(el('bulkReturnObservation')?.value||'').trim();
        const particular=String(x.observacion||'').trim();
        const nota=[general?('Comentario general: '+general):'',particular?('Del expediente: '+particular):''].filter(Boolean).join('\n');
        return nota||(isAdmin()?'Devolución registrada por Administrador.':(isCoordinator()?'Devolución registrada por Coordinador.':(isArchive()?'Devolución múltiple registrada por personal de Archivo.':'Devolución múltiple registrada por el usuario.')));
      })()
    }))
  });

  if(error){
    const msg=String(error.message||error);
    if(el('bulkReturnStatus'))el('bulkReturnStatus').textContent='NO SE REGISTRÓ LA DEVOLUCIÓN: '+msg+(isCoordinator()&&/USUARIO|ARCHIVO/i.test(msg)?' · Falta ejecutar el SQL V295 de habilitación del Coordinador en Supabase.':'');
    if(btn)btn.disabled=false;
    return;
  }

  selectedIds.clear();
  updateSelectionUI();
  closeBulkReturnModal();

  const processed=Number(data?.total||count);
  const excludedCount=(bulkReturnExcludedRows||[]).length;

  showToast(
    `${processed} expediente${processed===1?'':'s'} enviado${processed===1?'':'s'} a devolución`+
    (excludedCount
      ?` · ${excludedCount} excluido${excludedCount===1?'':'s'}`
      :'')
  );

  // V684 · mismo criterio para devolución múltiple: permanece en Total en custodia,
  // sale de En préstamo y pasa a Devolución solicitada hasta la recepción de Archivo.
  try{if(typeof invalidateV171CustodyCache==='function')invalidateV171CustodyCache();}catch(_){ }

  await Promise.all([
    loadPanel(),
    loadSummary(),
    loadRequests(),
    loadHistory(),
    loadArchiveDeliveryRequests(true),
    loadOperationalAlerts(true),
    loadNotifications(true)
  ]);
}


function closeBulkConasModal(){
  el('bulkConasModal')?.classList.remove('show');
  bulkConasRows=[];
}

function updateBulkConasField(id,field,value){
  const row=bulkConasRows.find(x=>String(x.id)===String(id));
  if(!row)return;
  row[field]=String(value??'').trim();
  syncBulkConasState();
}

function syncBulkConasState(){
  const missing=(bulkConasRows||[]).filter(x=>!String(x.ultimo_folio||'').trim());
  const memoMissing=!String(el('bulkConasMemo')?.value||'').trim();
  const btn=el('bulkConasSubmitBtn');
  if(btn){
    btn.disabled=!bulkConasRows.length||missing.length>0||memoMissing;
    btn.textContent=bulkConasRows.length
      ?`DERIVAR ${bulkConasRows.length} EXPEDIENTE${bulkConasRows.length===1?'':'S'} AL CONAS`
      :'DERIVAR AL CONAS';
  }
  if(el('bulkConasStatus')){
    el('bulkConasStatus').textContent=memoMissing
      ?'Ingrese el N.º de Memorando de derivación.'
      :missing.length
        ?`Falta ingresar el Último folio en ${missing.length} expediente${missing.length===1?'':'s'}.`
        :'Datos completos. Puede registrar la derivación física al CONAS.';
  }
}

function renderBulkConasRows(){
  const box=el('bulkConasTable');
  if(!box)return;
  if(!bulkConasRows.length){
    box.innerHTML='<div class="empty">No hay expedientes válidos para derivar al CONAS.</div>';
    syncBulkConasState();
    return;
  }

  box.innerHTML=`<table>
    <thead><tr>
      <th>N°</th><th>Expediente</th><th>Ext.</th><th>Responsable actual</th>
      <th>Cargo</th><th>R.D. (opcional)</th><th>Último folio *</th>
    </tr></thead>
    <tbody>${bulkConasRows.map((r,i)=>`<tr>
      <td>${i+1}</td>
      <td><b>${esc(r.expediente||'—')}</b></td>
      <td>${esc(r.extension||'—')}</td>
      <td>${esc(r.responsable||'—')}</td>
      <td>${esc(r.cargo||'—')}</td>
      <td><input class="bulk-return-input" value="${esc(r.rd||'')}"
          placeholder="R.D. (opcional)"
          oninput="updateBulkConasField('${r.id}','rd',this.value)"></td>
      <td><input class="bulk-return-input required" value="${esc(r.ultimo_folio||'')}"
          placeholder="Último folio" required
          oninput="updateBulkConasField('${r.id}','ultimo_folio',this.value)"></td>
    </tr>`).join('')}</tbody>
  </table>`;
  syncBulkConasState();
}

async function openBulkConasModal(){
  if(!(isLimitedUser()||hasFullAccess())){
    showToast('No tiene permiso para derivar expedientes al CONAS.');
    return;
  }

  const ids=[...selectedIds];
  if(!ids.length){
    showToast('Seleccione uno o más expedientes.');
    return;
  }

  el('bulkConasModal')?.classList.add('show');
  if(el('bulkConasMemo'))el('bulkConasMemo').value='';
  if(el('bulkConasObservation'))el('bulkConasObservation').value='';
  if(el('bulkConasStatus'))el('bulkConasStatus').textContent='Verificando expedientes seleccionados...';

  const {data,error}=await sb
    .from('expedientes')
    .select('id,expediente,extension,rd,ultimo_folio,responsable,estado,cargo,modalidad')
    .in('id',ids);

  if(error){
    el('bulkConasTable').innerHTML=`<div class="empty">${esc(error.message)}</div>`;
    if(el('bulkConasStatus'))el('bulkConasStatus').textContent='No se pudo preparar la derivación.';
    return;
  }

  const myName=norm(currentProfile?.nombre_personal||'');
  const invalid=[];
  const rows=[];

  for(const r of (data||[])){
    const state=norm(operationalStatus(r));
    const mine=!isLimitedUser() || norm(r.responsable||'')===myName;
    const validState=['EN PRÉSTAMO','REASIGNADO','DEVUELTO AL ARCHIVO','CUSTODIA'].includes(state);

    if(!mine || !validState || norm(r.modalidad||'')==='COPIA DIGITAL' ||
       norm(r.responsable||'')==='ELEVADO AL CONAS'){
      invalid.push(r.expediente||r.id);
      continue;
    }

    rows.push({
      ...r,
      rd:String(r.rd||'').trim(),
      ultimo_folio:String(r.ultimo_folio||'').trim()
    });
  }

  if(invalid.length){
    bulkConasRows=[];
    el('bulkConasTable').innerHTML=`<div class="empty">
      La selección contiene expedientes que no pueden derivarse al CONAS.<br><br>
      <b>${esc(invalid.join(', '))}</b><br><br>
      Seleccione únicamente expedientes físicos que se encuentren actualmente bajo su custodia
      o en custodia de Archivo.
    </div>`;
    if(el('bulkConasStatus'))el('bulkConasStatus').textContent='Corrija la selección y vuelva a intentar.';
    if(el('bulkConasSubmitBtn'))el('bulkConasSubmitBtn').disabled=true;
    return;
  }

  bulkConasRows=rows.sort((a,b)=>
    String(a.expediente||'').localeCompare(String(b.expediente||''),'es',{numeric:true})
  );
  renderBulkConasRows();
  window.v596PrepareDerivationMail?.('CONAS');
}

async function submitBulkConas(){
  if(!bulkConasRows.length)return;

  const missing=bulkConasRows.filter(x=>!String(x.ultimo_folio||'').trim());
  if(missing.length){
    if(el('bulkConasStatus'))el('bulkConasStatus').textContent='El Último folio es obligatorio para todos los expedientes.';
    return;
  }

  const btn=el('bulkConasSubmitBtn');
  if(btn)btn.disabled=true;
  if(el('bulkConasStatus'))el('bulkConasStatus').textContent='Registrando derivación física al CONAS...';

  const memo=(el('bulkConasMemo')?.value||'').trim();
  if(!memo){
    if(el('bulkConasStatus'))el('bulkConasStatus').textContent='Ingrese el N.º de Memorando de derivación.';
    if(btn)btn.disabled=false;
    return;
  }
  const observation=(el('bulkConasObservation')?.value||'').trim();
  const derivationDraft=window.v596CaptureDerivation?.('CONAS')||null;

  const {data,error}=await sb.rpc('derivar_expedientes_conas',{
    p_items:bulkConasRows.map(x=>({
      expediente_id:x.id,
      rd:String(x.rd||'').trim()||null,
      ultimo_folio:String(x.ultimo_folio||'').trim(),
      observacion:observation||null
    }))
  });

  if(error){
    if(el('bulkConasStatus'))el('bulkConasStatus').textContent='NO SE REGISTRÓ: '+error.message;
    if(btn)btn.disabled=false;
    return;
  }

  if(derivationDraft){
    await window.v596FinalizeDerivation?.(derivationDraft);
  }

  selectedIds.clear();
  updateSelectionUI();
  closeBulkConasModal();
  showToast(`${Number(data?.total||bulkConasRows.length)} expediente(s) derivados al CONAS`);

  const jobs=[loadPanel(),loadAll(),loadStates(),loadHistory()];
  if(hasFullAccess())jobs.push(loadConasFolder());
  await Promise.all(jobs);
}

function debounceConasFolder(){
  clearTimeout(conasTimer);
  conasTimer=setTimeout(loadConasFolder,250);
}

function syncConasSelection(){
  const n=conasSelectedIds.size;
  if(el('conasSelectedCount')){
    el('conasSelectedCount').textContent=
      n+' seleccionado'+(n===1?'':'s');
    el('conasSelectedCount').title=n
      ?'La selección se mantiene aunque realice nuevas búsquedas.'
      :'';
  }
  if(el('conasReturnBtn'))el('conasReturnBtn').disabled=n===0;

  const clearBtn=el('conasClearSelectionV701');
  if(clearBtn)clearBtn.style.display=n>0?'':'none';
}

function rememberConasSelectedRowV701(id){
  const key=String(id||'');
  if(!key)return;
  const row=(conasRows||[]).find(r=>String(r?.expediente_id||'')===key);
  if(row)conasSelectedRowsV701.set(key,{...row});
}

function clearConasSelectionV701(){
  conasSelectedIds.clear();
  conasSelectedRowsV701.clear();
  conasReturnRowsV701=[];
  renderConasTable();
  syncConasSelection();
}

async function resolveConasSelectedRowsV701(){
  const ids=[...conasSelectedIds].map(String).filter(Boolean);
  if(!ids.length)return [];

  // Normalmente todas las filas ya están en memoria porque solo se puede
  // seleccionar una fila que estuvo visible en alguna búsqueda previa.
  let missing=ids.filter(id=>!conasSelectedRowsV701.has(id));

  // Respaldo: si por algún refresco falta la copia de una fila seleccionada,
  // recuperar la carpeta completa y reconstruir únicamente los seleccionados.
  if(missing.length && sb){
    try{
      const {data,error}=await sb.rpc(
        'listar_derivados_conas',
        {p_busqueda:null}
      );
      if(error)throw error;

      const enriched=await v598AttachDerivationMemos(data||[],'CONAS');
      (enriched||[]).forEach(row=>{
        const id=String(row?.expediente_id||'');
        if(id && conasSelectedIds.has(id)){
          conasSelectedRowsV701.set(id,{...row});
        }
      });
    }catch(error){
      console.warn('V701 · No se pudo reconstruir la selección CONAS:',error?.message||error);
    }
  }

  return ids
    .map(id=>conasSelectedRowsV701.get(id))
    .filter(Boolean);
}

window.clearConasSelectionV701=clearConasSelectionV701;

function v599SortDerivationsNewestFirst(rows){
  return (Array.isArray(rows)?rows:[])
    .map((row,index)=>({row,index}))
    .sort((a,b)=>{
      const av=String(a.row?.fecha_derivacion||'').trim();
      const bv=String(b.row?.fecha_derivacion||'').trim();

      const at=Date.parse(av);
      const bt=Date.parse(bv);

      if(Number.isFinite(at) && Number.isFinite(bt) && at!==bt){
        return bt-at; // más reciente primero
      }

      // Las fechas PostgreSQL YYYY-MM-DD también se ordenan correctamente
      // de forma lexicográfica cuando Date.parse no está disponible.
      if(av!==bv){
        return bv.localeCompare(av,'es',{numeric:true});
      }

      // Misma fecha: mantener el orden original recibido.
      return a.index-b.index;
    })
    .map(x=>x.row);
}

async function v598AttachDerivationMemos(rows,destino){
  const list=Array.isArray(rows)?rows:[];
  const ids=[...new Set(
    list.map(r=>String(r?.expediente_id||'').trim()).filter(Boolean)
  )];

  if(!ids.length)return list;

  const memoMap=new Map();

  try{
    for(let i=0;i<ids.length;i+=80){
      const {data,error}=await sb.rpc(
        'v598_listar_memorandos_derivacion',
        {
          p_destino:String(destino||'').toUpperCase(),
          p_expediente_ids:ids.slice(i,i+80)
        }
      );

      if(error)throw error;

      (Array.isArray(data)?data:[]).forEach(x=>{
        const id=String(x?.expediente_id||'');
        if(id && !memoMap.has(id)){
          memoMap.set(id,String(x?.numero_memorando||'').trim());
        }
      });
    }
  }catch(error){
    console.warn(
      'V598 · No se pudieron cargar memorandos de derivación:',
      destino,
      error?.message||error
    );
  }

  return list.map(r=>({
    ...r,
    numero_memorando:
      memoMap.get(String(r?.expediente_id||'')) ||
      r?.numero_memorando ||
      r?.memorando ||
      null
  }));
}

function toggleConasSelect(id,checked){
  const key=String(id||'');
  if(checked){
    conasSelectedIds.add(key);
    rememberConasSelectedRowV701(key);
  }else{
    conasSelectedIds.delete(key);
    conasSelectedRowsV701.delete(key);
  }
  renderConasTable();
  syncConasSelection();
}

function toggleConasSelectFromRow(event,id){
  const target=event?.target;
  if(target?.closest?.('input,button,select,textarea,a,label'))return;

  const key=String(id||'');
  const checked=!conasSelectedIds.has(key);

  if(checked){
    conasSelectedIds.add(key);
    rememberConasSelectedRowV701(key);
  }else{
    conasSelectedIds.delete(key);
    conasSelectedRowsV701.delete(key);
  }

  renderConasTable();
  syncConasSelection();
}


function toggleAllConas(checked){
  (conasRows||[]).forEach(r=>{
    const key=String(r?.expediente_id||'');
    if(!key)return;

    if(checked){
      conasSelectedIds.add(key);
      conasSelectedRowsV701.set(key,{...r});
    }else{
      conasSelectedIds.delete(key);
      conasSelectedRowsV701.delete(key);
    }
  });
  renderConasTable();
  syncConasSelection();
}

function renderConasTable(){
  const box=el('conasTable');
  if(!box)return;

  if(!conasRows.length){
    box.innerHTML='<div class="empty">No hay expedientes actualmente derivados al CONAS dentro de su alcance.</div>';
    return;
  }

  if(isGestionConasReadOnlyV336()){
    box.innerHTML=`<table>
      <thead><tr>
        <th>Expediente</th>
        <th>Ext.</th>
        <th>R.D.</th>
        <th>Memorando</th>
        <th>Responsable de origen</th>
        <th>Fecha / hora derivación</th>
        <th>Días en CONAS</th>
        <th>Último folio</th>
        <th>Cargo de origen</th>
        <th>Observación</th>
      </tr></thead>
      <tbody>${conasRows.map(r=>`
        <tr>
          <td><b>${esc(r.expediente||'—')}</b></td>
          <td>${esc(r.extension||'—')}</td>
          <td>${esc(r.rd||'—')}</td>
          <td><b>${esc(r.numero_memorando||'—')}</b></td>
          <td>${esc(r.responsable_origen||'—')}</td>
          <td>${masterDateTimeHtml(r.fecha_derivacion)}</td>
          <td><b>${Number(r.dias_en_conas||0)}</b></td>
          <td>${esc(r.ultimo_folio_derivacion||'—')}</td>
          <td>${esc(r.cargo_origen||'—')}</td>
          <td>${esc(r.observacion_derivacion||'')}</td>
        </tr>`).join('')}
      </tbody>
    </table>`;
    return;
  }

  const allChecked=conasRows.length>0 &&
    conasRows.every(r=>conasSelectedIds.has(r.expediente_id));

  box.innerHTML=`<table>
    <thead><tr>
      <th><input type="checkbox" ${allChecked?'checked':''} onchange="toggleAllConas(this.checked)"></th>
      <th>Expediente</th><th>Ext.</th><th>R.D.</th><th>Memorando</th><th>Responsable de origen</th>
      <th>Fecha / hora derivación</th><th>Días en CONAS</th><th>Último folio</th>
      <th>Cargo de origen</th><th>Observación</th><th></th>
    </tr></thead>
    <tbody>${conasRows.map(r=>`
      <tr
        class="record-selectable-row ${conasSelectedIds.has(r.expediente_id)?'conas-row-selected record-selected-row':''}"
        onclick="toggleConasSelectFromRow(event,'${r.expediente_id}')"
        title="Clic en la fila para seleccionar o deseleccionar">
        <td><input type="checkbox"
          aria-label="Seleccionar ${esc(r.expediente||'expediente')}"
          ${conasSelectedIds.has(r.expediente_id)?'checked':''}
          onchange="toggleConasSelect('${r.expediente_id}',this.checked)"></td>
        <td><b>${esc(r.expediente||'—')}</b></td>
        <td>${esc(r.extension||'—')}</td>
        <td>${esc(r.rd||'—')}</td>
        <td><b>${esc(r.numero_memorando||'—')}</b></td>
        <td>${esc(r.responsable_origen||'—')}</td>
        <td>${masterDateTimeHtml(r.fecha_derivacion)}</td>
        <td><b>${Number(r.dias_en_conas||0)}</b></td>
        <td>${esc(r.ultimo_folio_derivacion||'—')}</td>
        <td>${esc(r.cargo_origen||'—')}</td>
        <td>${esc(r.observacion_derivacion||'')}</td>
        <td><button class="btn secondary small" onclick="showExpHistory('${r.expediente_id}')">Historial</button></td>
      </tr>`).join('')}
    </tbody>
  </table>`;
}

async function loadConasFolder(){
  if(!isGestionConasViewerV336())return;

  const search=(el('conasSearch')?.value||'').trim();
  const coordinatorQuery=isCoordinator();
  const response=coordinatorQuery
    ?await sb.rpc(
        'v211_coordinador_conas',
        {p_busqueda:search||null}
      )
    :await sb.rpc(
        'listar_derivados_conas',
        {p_busqueda:search||null}
      );

  const error=response.error;
  const data=coordinatorQuery
    ?v211JsonRows(response.data)
    :(response.data||[]);

  if(error){
    conasRows=[];
    if(el('conasTable'))el('conasTable').innerHTML=
      `<div class="empty">${esc(error.message)}<br><br>Verifique que esté instalada la habilitación V338 para consulta CONAS del personal de GESTIÓN.</div>`;
    return;
  }

  conasRows=v599SortDerivationsNewestFirst(
    await v598AttachDerivationMemos(data||[],'CONAS')
  );

  const readOnly=isGestionConasReadOnlyV336();
  const countNode=el('conasSelectedCount');
  const returnBtn=el('conasReturnBtn');
  const note=el('conasFolderNote');
  if(countNode)countNode.style.display=readOnly?'none':'';
  if(returnBtn){
    returnBtn.style.display=readOnly?'none':'';
    if(readOnly)returnBtn.disabled=true;
  }
  if(note){
    note.innerHTML=readOnly
      ?'<b>Consulta de GESTIÓN:</b> puede visualizar todos los expedientes que permanecen físicamente en CONAS. La recepción o devolución desde CONAS corresponde a Archivo/Administrador.'
      :'Esta carpeta contiene únicamente expedientes que permanecen físicamente en CONAS. La selección se mantiene entre búsquedas: puede buscar, seleccionar varios expedientes sucesivamente y luego registrar todos juntos en una sola devolución. Luego podrán salir nuevamente mediante una nueva solicitud y un nuevo cargo.';
  }

  conasRows.forEach(r=>{
    warnFuturePeruDateV186(r.fecha_derivacion,'CONAS · '+String(r.expediente||''));

    // V701 · Si una fila seleccionada vuelve a aparecer en otra búsqueda,
    // actualizar su copia en memoria, pero NUNCA eliminar seleccionados
    // porque no estén visibles en el filtro actual.
    const key=String(r?.expediente_id||'');
    if(key && conasSelectedIds.has(key)){
      conasSelectedRowsV701.set(key,{...r});
    }
  });

  const days=conasRows.map(r=>Number(r.dias_en_conas||0));
  if(el('conasTotalCount'))el('conasTotalCount').textContent=conasRows.length;
  if(el('conas30Count'))el('conas30Count').textContent=days.filter(x=>x>30).length;
  if(el('conas60Count'))el('conas60Count').textContent=days.filter(x=>x>60).length;
  if(el('conas90Count'))el('conas90Count').textContent=days.filter(x=>x>90).length;
  if(el('conasRowsCount'))el('conasRowsCount').textContent=
    conasRows.length+' expediente'+(conasRows.length===1?'':'s');

  renderConasTable();
  syncConasSelection();
  if(typeof window.v339ResizeConasScroller==='function'){
    requestAnimationFrame(()=>window.v339ResizeConasScroller());
  }
}

function fillConasReturnLocations(){
  const sel=el('conasReturnLocation');
  if(!sel)return;

  const names=(catalogo||[])
    .filter(x=>x.activo!==false && x.tipo!=='PERSONAL')
    .map(x=>String(x.nombre||'').trim())
    .filter(Boolean);

  const unique=[...new Set(names)];
  sel.innerHTML=unique.length
    ?unique.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('')
    :'<option value="ARCHIVO CENTRAL">ARCHIVO CENTRAL</option>';

  const preferred=[...sel.options].find(o=>norm(o.value).includes('ARCHIVO'));
  if(preferred)sel.value=preferred.value;
}

async function openConasReturnModal(){
  if(!hasFullAccess())return;

  const rows=await resolveConasSelectedRowsV701();
  conasReturnRowsV701=rows.slice();

  if(!rows.length){
    showToast('Seleccione uno o más expedientes retornados del CONAS.');
    return;
  }

  fillConasReturnLocations();
  if(el('conasReturnObservation'))el('conasReturnObservation').value='';
  if(el('conasReturnSummary'))el('conasReturnSummary').textContent=
    rows.length+' expediente'+(rows.length===1?'':'s');
  if(el('conasReturnStatus'))el('conasReturnStatus').textContent='';

  el('conasReturnTable').innerHTML=`<table>
    <thead><tr><th>Expediente</th><th>Ext.</th><th>Origen</th><th>Fecha / hora derivación</th><th>Días en CONAS</th></tr></thead>
    <tbody>${rows.map(r=>`<tr>
      <td><b>${esc(r.expediente||'—')}</b></td>
      <td>${esc(r.extension||'—')}</td>
      <td>${esc(r.responsable_origen||'—')}</td>
      <td>${masterDateTimeHtml(r.fecha_derivacion)}</td>
      <td>${Number(r.dias_en_conas||0)}</td>
    </tr>`).join('')}</tbody>
  </table>`;

  if(el('conasReturnConfirmBtn'))el('conasReturnConfirmBtn').disabled=false;
  el('conasReturnModal')?.classList.add('show');
}

function closeConasReturnModal(){
  el('conasReturnModal')?.classList.remove('show');
}

async function confirmConasReturns(){
  if(!hasFullAccess())return;

  // V701 · Confirmar todos los expedientes acumulados entre búsquedas,
  // no solo las filas visibles del último filtro.
  const rows=conasReturnRowsV701.length
    ?conasReturnRowsV701.slice()
    :await resolveConasSelectedRowsV701();

  const ids=rows
    .map(r=>String(r?.expediente_id||''))
    .filter(Boolean);

  const location=(el('conasReturnLocation')?.value||'').trim();
  const observation=(el('conasReturnObservation')?.value||'').trim();

  if(!ids.length){
    if(el('conasReturnStatus'))el('conasReturnStatus').textContent='No hay expedientes seleccionados.';
    return;
  }
  if(!location){
    if(el('conasReturnStatus'))el('conasReturnStatus').textContent='Seleccione la ubicación física de retorno.';
    return;
  }

  const btn=el('conasReturnConfirmBtn');
  if(btn)btn.disabled=true;
  if(el('conasReturnStatus'))el('conasReturnStatus').textContent='Registrando retorno físico desde CONAS...';

  const {data,error}=await sb.rpc('registrar_retorno_conas',{
    p_expediente_ids:ids,
    p_ubicacion_retorno:location,
    p_observacion:observation||null
  });

  if(error){
    if(el('conasReturnStatus'))el('conasReturnStatus').textContent=error.message;
    if(btn)btn.disabled=false;
    return;
  }

  conasSelectedIds.clear();
  conasSelectedRowsV701.clear();
  conasReturnRowsV701=[];

  // Si el retorno se inició desde Registro maestro, quitar también
  // cualquier selección anterior de la tabla principal.
  ids.forEach(id=>selectedIds.delete(id));
  updateSelectionUI();

  closeConasReturnModal();
  showToast(`${Number(data?.total||ids.length)} expediente(s) recibidos desde CONAS`);

  await Promise.all([
    loadConasFolder(),
    loadSummary(),
    loadPanel(),
    loadAll(),
    loadStates(),
    loadHistory(),
    loadRequests()
  ]);
}



function closeBulkDvcModal(){
  el('bulkDvcModal')?.classList.remove('show');
  bulkDvcRows=[];
}

function updateBulkDvcField(id,field,value){
  const row=bulkDvcRows.find(x=>String(x.id)===String(id));
  if(!row)return;
  row[field]=String(value??'').trim();
  syncBulkDvcState();
}

function syncBulkDvcState(){
  const missing=(bulkDvcRows||[]).filter(x=>!String(x.ultimo_folio||'').trim());
  const memoMissing=!String(el('bulkDvcMemo')?.value||'').trim();
  const btn=el('bulkDvcSubmitBtn');

  if(btn){
    btn.disabled=!bulkDvcRows.length||missing.length>0||memoMissing;
    btn.textContent=bulkDvcRows.length
      ?`DERIVAR ${bulkDvcRows.length} EXPEDIENTE${bulkDvcRows.length===1?'':'S'} A DVC`
      :'DERIVAR A DVC';
  }

  if(el('bulkDvcStatus')){
    el('bulkDvcStatus').textContent=memoMissing
      ?'Ingrese el N.º de Memorando de derivación.'
      :missing.length
        ?`Falta ingresar el Último folio en ${missing.length} expediente${missing.length===1?'':'s'}.`
        :'Datos completos. Puede registrar la derivación física a la DVC.';
  }
}

function renderBulkDvcRows(){
  const box=el('bulkDvcTable');
  if(!box)return;

  if(!bulkDvcRows.length){
    box.innerHTML='<div class="empty">No hay expedientes válidos para derivar a la DVC.</div>';
    syncBulkDvcState();
    return;
  }

  box.innerHTML=`<table>
    <thead><tr>
      <th>N°</th><th>Expediente</th><th>Ext.</th><th>Responsable actual</th>
      <th>Cargo</th><th>R.D. (opcional)</th><th>Último folio *</th>
    </tr></thead>
    <tbody>${bulkDvcRows.map((r,i)=>`<tr>
      <td>${i+1}</td>
      <td><b>${esc(r.expediente||'—')}</b></td>
      <td>${esc(r.extension||'—')}</td>
      <td>${esc(r.responsable||'—')}</td>
      <td>${esc(r.cargo||'—')}</td>
      <td><input class="bulk-return-input" value="${esc(r.rd||'')}"
          placeholder="R.D. (opcional)"
          oninput="updateBulkDvcField('${r.id}','rd',this.value)"></td>
      <td><input class="bulk-return-input required" value="${esc(r.ultimo_folio||'')}"
          placeholder="Último folio" required
          oninput="updateBulkDvcField('${r.id}','ultimo_folio',this.value)"></td>
    </tr>`).join('')}</tbody>
  </table>`;

  syncBulkDvcState();
}

async function openBulkDvcModal(){
  if(!(isLimitedUser()||hasFullAccess())){
    showToast('No tiene permiso para derivar expedientes a la DVC.');
    return;
  }

  const ids=[...selectedIds];
  if(!ids.length){
    showToast('Seleccione uno o más expedientes.');
    return;
  }

  el('bulkDvcModal')?.classList.add('show');
  if(el('bulkDvcMemo'))el('bulkDvcMemo').value='';
  if(el('bulkDvcObservation'))el('bulkDvcObservation').value='';
  if(el('bulkDvcStatus'))el('bulkDvcStatus').textContent='Verificando expedientes seleccionados...';

  const {data,error}=await sb
    .from('expedientes')
    .select('id,expediente,extension,rd,ultimo_folio,responsable,estado,cargo,modalidad')
    .in('id',ids);

  if(error){
    el('bulkDvcTable').innerHTML=`<div class="empty">${esc(error.message)}</div>`;
    if(el('bulkDvcStatus'))el('bulkDvcStatus').textContent='No se pudo preparar la derivación.';
    return;
  }

  const myName=norm(currentProfile?.nombre_personal||'');
  const invalid=[];
  const rows=[];

  for(const r of (data||[])){
    const state=norm(operationalStatus(r));
    const mine=!isLimitedUser() || norm(r.responsable||'')===myName;
    const validState=['EN PRÉSTAMO','REASIGNADO','DEVUELTO AL ARCHIVO','CUSTODIA'].includes(state);

    if(
      !mine ||
      !validState ||
      norm(r.modalidad||'')==='COPIA DIGITAL' ||
      norm(r.responsable||'')==='DVC' ||
      norm(r.responsable||'')==='ELEVADO AL CONAS'
    ){
      invalid.push(r.expediente||r.id);
      continue;
    }

    rows.push({
      ...r,
      rd:String(r.rd||'').trim(),
      ultimo_folio:String(r.ultimo_folio||'').trim()
    });
  }

  if(invalid.length){
    bulkDvcRows=[];
    el('bulkDvcTable').innerHTML=`<div class="empty">
      La selección contiene expedientes que no pueden derivarse a la DVC.<br><br>
      <b>${esc(invalid.join(', '))}</b><br><br>
      Seleccione únicamente expedientes físicos que se encuentren actualmente
      bajo su custodia o en custodia de Archivo.
    </div>`;
    if(el('bulkDvcStatus'))el('bulkDvcStatus').textContent='Corrija la selección y vuelva a intentar.';
    if(el('bulkDvcSubmitBtn'))el('bulkDvcSubmitBtn').disabled=true;
    return;
  }

  bulkDvcRows=rows.sort((a,b)=>
    String(a.expediente||'').localeCompare(String(b.expediente||''),'es',{numeric:true})
  );

  renderBulkDvcRows();
  window.v596PrepareDerivationMail?.('DVC');
}

async function submitBulkDvc(){
  if(!bulkDvcRows.length)return;

  const missing=bulkDvcRows.filter(x=>!String(x.ultimo_folio||'').trim());
  if(missing.length){
    if(el('bulkDvcStatus')){
      el('bulkDvcStatus').textContent='El Último folio es obligatorio para todos los expedientes.';
    }
    return;
  }

  const btn=el('bulkDvcSubmitBtn');
  if(btn)btn.disabled=true;

  if(el('bulkDvcStatus')){
    el('bulkDvcStatus').textContent='Registrando derivación física a la DVC...';
  }

  const memo=(el('bulkDvcMemo')?.value||'').trim();
  if(!memo){
    if(el('bulkDvcStatus'))el('bulkDvcStatus').textContent='Ingrese el N.º de Memorando de derivación.';
    if(btn)btn.disabled=false;
    return;
  }
  const observation=(el('bulkDvcObservation')?.value||'').trim();
  const derivationDraft=window.v596CaptureDerivation?.('DVC')||null;

  const {data,error}=await sb.rpc('derivar_expedientes_dvc',{
    p_items:bulkDvcRows.map(x=>({
      expediente_id:x.id,
      rd:String(x.rd||'').trim()||null,
      ultimo_folio:String(x.ultimo_folio||'').trim(),
      observacion:observation||null
    }))
  });

  if(error){
    if(el('bulkDvcStatus'))el('bulkDvcStatus').textContent='NO SE REGISTRÓ: '+error.message;
    if(btn)btn.disabled=false;
    return;
  }

  const total=Number(data?.total||bulkDvcRows.length);

  if(derivationDraft){
    await window.v596FinalizeDerivation?.(derivationDraft);
  }

  selectedIds.clear();
  updateSelectionUI();
  closeBulkDvcModal();
  showToast(`${total} expediente(s) derivados a la DVC`);

  const jobs=[
    loadPanel(),loadAll(),loadStates(),loadHistory(),loadRequests()
  ];
  if(hasFullAccess())jobs.push(loadDvcFolder());
  await Promise.all(jobs);
}

function debounceDvcFolder(){
  clearTimeout(dvcTimer);
  dvcTimer=setTimeout(loadDvcFolder,250);
}

function syncDvcSelection(){
  const n=dvcSelectedIds.size;
  if(el('dvcSelectedCount')){
    el('dvcSelectedCount').textContent=n+' seleccionado'+(n===1?'':'s');
  }
  if(el('dvcReturnBtn'))el('dvcReturnBtn').disabled=n===0;
}

function toggleDvcSelect(id,checked){
  if(checked)dvcSelectedIds.add(id);
  else dvcSelectedIds.delete(id);
  renderDvcTable();
  syncDvcSelection();
}

function toggleDvcSelectFromRow(event,id){
  const target=event?.target;
  if(target?.closest?.('input,button,select,textarea,a,label'))return;

  const checked=!dvcSelectedIds.has(id);
  if(checked)dvcSelectedIds.add(id);
  else dvcSelectedIds.delete(id);

  renderDvcTable();
  syncDvcSelection();
}

function toggleAllDvc(checked){
  (dvcRows||[]).forEach(r=>{
    if(checked)dvcSelectedIds.add(r.expediente_id);
    else dvcSelectedIds.delete(r.expediente_id);
  });
  renderDvcTable();
  syncDvcSelection();
}

function renderDvcTable(){
  const box=el('dvcTable');
  if(!box)return;

  if(!dvcRows.length){
    box.innerHTML='<div class="empty">No hay expedientes actualmente derivados a la DVC.</div>';
    return;
  }

  const allChecked=dvcRows.length>0 &&
    dvcRows.every(r=>dvcSelectedIds.has(r.expediente_id));

  box.innerHTML=`<table>
    <thead><tr>
      <th><input type="checkbox" ${allChecked?'checked':''}
          onchange="toggleAllDvc(this.checked)"></th>
      <th>Expediente</th>
      <th>Ext.</th>
      <th>R.D.</th>
      <th>Memorando</th>
      <th>Responsable de origen</th>
      <th>Fecha / hora derivación</th>
      <th>Días en DVC</th>
      <th>Último folio</th>
      <th>Cargo de origen</th>
      <th>Observación</th>
      <th></th>
    </tr></thead>
    <tbody>${dvcRows.map(r=>`
      <tr
        class="record-selectable-row ${dvcSelectedIds.has(r.expediente_id)?'dvc-row-selected record-selected-row':''}"
        onclick="toggleDvcSelectFromRow(event,'${r.expediente_id}')"
        title="Clic en la fila para seleccionar o deseleccionar">
        <td><input type="checkbox"
          aria-label="Seleccionar ${esc(r.expediente||'expediente')}"
          ${dvcSelectedIds.has(r.expediente_id)?'checked':''}
          onchange="toggleDvcSelect('${r.expediente_id}',this.checked)"></td>
        <td><b>${esc(r.expediente||'—')}</b></td>
        <td>${esc(r.extension||'—')}</td>
        <td>${esc(r.rd||'—')}</td>
        <td><b>${esc(r.numero_memorando||'—')}</b></td>
        <td>${esc(r.responsable_origen||'—')}</td>
        <td>${masterDateTimeHtml(r.fecha_derivacion)}</td>
        <td><b>${Number(r.dias_en_dvc||0)}</b></td>
        <td>${esc(r.ultimo_folio_derivacion||'—')}</td>
        <td>${esc(r.cargo_origen||'—')}</td>
        <td>${esc(r.observacion_derivacion||'')}</td>
        <td>
          <button class="btn secondary small"
                  onclick="showExpHistory('${r.expediente_id}')">
            Historial
          </button>
        </td>
      </tr>`).join('')}
    </tbody>
  </table>`;
}

async function loadDvcFolder(){
  if(!hasFullAccess())return;

  const search=(el('dvcSearch')?.value||'').trim();

  const {data,error}=await sb.rpc('listar_derivados_dvc',{
    p_busqueda:search||null
  });

  if(error){
    dvcRows=[];
    if(el('dvcTable')){
      el('dvcTable').innerHTML=
        `<div class="empty">${esc(error.message)}<br><br>
        Ejecute primero <b>INSTALAR_FLUJO_DVC_COMPLETO.sql</b> en Supabase.</div>`;
    }
    return;
  }

  dvcRows=v599SortDerivationsNewestFirst(
    await v598AttachDerivationMemos(data||[],'DVC')
  );
  dvcRows.forEach(r=>warnFuturePeruDateV186(r.fecha_derivacion,'DVC · '+String(r.expediente||'')));

  const visibleIds=new Set(dvcRows.map(r=>String(r.expediente_id)));
  [...dvcSelectedIds].forEach(id=>{
    if(!visibleIds.has(String(id)))dvcSelectedIds.delete(id);
  });

  const days=dvcRows.map(r=>Number(r.dias_en_dvc||0));

  if(el('dvcTotalCount'))el('dvcTotalCount').textContent=dvcRows.length;
  if(el('dvc30Count'))el('dvc30Count').textContent=days.filter(x=>x>30).length;
  if(el('dvc60Count'))el('dvc60Count').textContent=days.filter(x=>x>60).length;
  if(el('dvc90Count'))el('dvc90Count').textContent=days.filter(x=>x>90).length;

  if(el('dvcRowsCount')){
    el('dvcRowsCount').textContent=
      dvcRows.length+' expediente'+(dvcRows.length===1?'':'s');
  }

  renderDvcTable();
  syncDvcSelection();
}

function fillDvcReturnLocations(){
  const sel=el('dvcReturnLocation');
  if(!sel)return;

  const names=(catalogo||[])
    .filter(x=>x.activo!==false && x.tipo!=='PERSONAL')
    .map(x=>String(x.nombre||'').trim())
    .filter(Boolean);

  const unique=[...new Set(names)];

  sel.innerHTML=unique.length
    ?unique.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('')
    :'<option value="ARCHIVO">ARCHIVO</option>';

  const preferred=[...sel.options].find(o=>norm(o.value).includes('ARCHIVO'));
  if(preferred)sel.value=preferred.value;
}

function openDvcReturnModal(){
  if(!hasFullAccess())return;

  const rows=(dvcRows||[]).filter(r=>dvcSelectedIds.has(r.expediente_id));

  if(!rows.length){
    showToast('Seleccione uno o más expedientes retornados de la DVC.');
    return;
  }

  fillDvcReturnLocations();

  if(el('dvcReturnObservation'))el('dvcReturnObservation').value='';
  if(el('dvcReturnSummary')){
    el('dvcReturnSummary').textContent=
      rows.length+' expediente'+(rows.length===1?'':'s');
  }
  if(el('dvcReturnStatus'))el('dvcReturnStatus').textContent='';

  el('dvcReturnTable').innerHTML=`<table>
    <thead><tr>
      <th>Expediente</th>
      <th>Ext.</th>
      <th>Origen</th>
      <th>Fecha / hora derivación</th>
      <th>Días en DVC</th>
    </tr></thead>
    <tbody>${rows.map(r=>`<tr>
      <td><b>${esc(r.expediente||'—')}</b></td>
      <td>${esc(r.extension||'—')}</td>
      <td>${esc(r.responsable_origen||'—')}</td>
      <td>${masterDateTimeHtml(r.fecha_derivacion)}</td>
      <td>${Number(r.dias_en_dvc||0)}</td>
    </tr>`).join('')}</tbody>
  </table>`;

  if(el('dvcReturnConfirmBtn'))el('dvcReturnConfirmBtn').disabled=false;
  el('dvcReturnModal')?.classList.add('show');
}

function closeDvcReturnModal(){
  el('dvcReturnModal')?.classList.remove('show');
}

async function confirmDvcReturns(){
  if(!hasFullAccess())return;

  const ids=(dvcRows||[])
    .filter(r=>dvcSelectedIds.has(r.expediente_id))
    .map(r=>r.expediente_id);

  const location=(el('dvcReturnLocation')?.value||'').trim();
  const observation=(el('dvcReturnObservation')?.value||'').trim();

  if(!ids.length){
    if(el('dvcReturnStatus'))el('dvcReturnStatus').textContent='No hay expedientes seleccionados.';
    return;
  }

  if(!location){
    if(el('dvcReturnStatus'))el('dvcReturnStatus').textContent='Seleccione la ubicación física de retorno.';
    return;
  }

  const btn=el('dvcReturnConfirmBtn');
  if(btn)btn.disabled=true;

  if(el('dvcReturnStatus')){
    el('dvcReturnStatus').textContent='Registrando retorno físico desde la DVC...';
  }

  const {data,error}=await sb.rpc('registrar_retorno_dvc',{
    p_expediente_ids:ids,
    p_ubicacion_retorno:location,
    p_observacion:observation||null
  });

  if(error){
    if(el('dvcReturnStatus'))el('dvcReturnStatus').textContent=error.message;
    if(btn)btn.disabled=false;
    return;
  }

  dvcSelectedIds.clear();

  // V662 · Igual que CONAS: si el retorno nació desde Registro Maestro,
  // retirar también la selección de la tabla principal.
  ids.forEach(id=>selectedIds.delete(id));
  updateSelectionUI();

  closeDvcReturnModal();

  showToast(`${Number(data?.total||ids.length)} expediente(s) recibidos desde la DVC`);

  await Promise.all([
    loadDvcFolder(),loadSummary(),loadPanel(),loadAll(),
    loadStates(),loadHistory(),loadRequests()
  ]);
}



function closeBulkInstructionModal(){
  el('bulkInstructionModal')?.classList.remove('show');
  bulkInstructionRows=[];
}

function updateBulkInstructionField(id,field,value){
  const row=bulkInstructionRows.find(
    x=>String(x.id)===String(id)
  );
  if(!row)return;

  row[field]=String(value??'').trim();
  syncBulkInstructionState();
}

function syncBulkInstructionState(){
  const missing=(bulkInstructionRows||[]).filter(
    x=>!String(x.ultimo_folio||'').trim()
  );
  const memoMissing=!String(el('bulkInstructionMemo')?.value||'').trim();

  const btn=el('bulkInstructionSubmitBtn');

  if(btn){
    btn.disabled=!bulkInstructionRows.length||missing.length>0||memoMissing;
    btn.textContent=bulkInstructionRows.length
      ?`DERIVAR ${bulkInstructionRows.length} EXPEDIENTE${bulkInstructionRows.length===1?'':'S'} A INSTRUCCIÓN`
      :'DERIVAR A INSTRUCCIÓN';
  }

  if(el('bulkInstructionStatus')){
    el('bulkInstructionStatus').textContent=memoMissing
      ?'Ingrese el N.º de Memorando de derivación.'
      :missing.length
        ?`Falta ingresar el Último folio en ${missing.length} expediente${missing.length===1?'':'s'}.`
        :'Datos completos. Puede registrar la derivación física a Instrucción.';
  }
}

function renderBulkInstructionRows(){
  const box=el('bulkInstructionTable');
  if(!box)return;

  if(!bulkInstructionRows.length){
    box.innerHTML=
      '<div class="empty">No hay expedientes válidos para derivar a Instrucción.</div>';
    syncBulkInstructionState();
    return;
  }

  box.innerHTML=`<table>
    <thead><tr>
      <th>N°</th>
      <th>Expediente</th>
      <th>Ext.</th>
      <th>Responsable actual</th>
      <th>Cargo</th>
      <th>R.D. (opcional)</th>
      <th>Último folio *</th>
    </tr></thead>

    <tbody>${bulkInstructionRows.map((r,i)=>`<tr>
      <td>${i+1}</td>
      <td><b>${esc(r.expediente||'—')}</b></td>
      <td>${esc(r.extension||'—')}</td>
      <td>${esc(r.responsable||'—')}</td>
      <td>${esc(r.cargo||'—')}</td>

      <td>
        <input class="bulk-return-input"
               value="${esc(r.rd||'')}"
               placeholder="R.D. (opcional)"
               oninput="updateBulkInstructionField('${r.id}','rd',this.value)">
      </td>

      <td>
        <input class="bulk-return-input required"
               value="${esc(r.ultimo_folio||'')}"
               placeholder="Último folio"
               required
               oninput="updateBulkInstructionField('${r.id}','ultimo_folio',this.value)">
      </td>
    </tr>`).join('')}</tbody>
  </table>`;

  syncBulkInstructionState();
}

async function openBulkInstructionModal(){
  if(!(isLimitedUser()||hasFullAccess())){
    showToast('No tiene permiso para derivar expedientes a Instrucción.');
    return;
  }

  const ids=[...selectedIds];

  if(!ids.length){
    showToast('Seleccione uno o más expedientes.');
    return;
  }

  el('bulkInstructionModal')?.classList.add('show');

  if(el('bulkInstructionMemo')){
    el('bulkInstructionMemo').value='';
  }
  if(el('bulkInstructionObservation')){
    el('bulkInstructionObservation').value='';
  }

  if(el('bulkInstructionStatus')){
    el('bulkInstructionStatus').textContent=
      'Verificando expedientes seleccionados...';
  }

  const {data,error}=await sb
    .from('expedientes')
    .select(
      'id,expediente,extension,rd,ultimo_folio,responsable,estado,cargo,modalidad'
    )
    .in('id',ids);

  if(error){
    el('bulkInstructionTable').innerHTML=
      `<div class="empty">${esc(error.message)}</div>`;

    if(el('bulkInstructionStatus')){
      el('bulkInstructionStatus').textContent=
        'No se pudo preparar la derivación.';
    }
    return;
  }

  const myName=norm(currentProfile?.nombre_personal||'');
  const invalid=[];
  const rows=[];

  for(const r of (data||[])){
    const state=norm(operationalStatus(r));
    const mine=!isLimitedUser() ||
      norm(r.responsable||'')===myName;

    const validState=[
      'EN PRÉSTAMO',
      'REASIGNADO',
      'DEVUELTO AL ARCHIVO',
      'RETORNO DE INSTRUCCIÓN',
      'CUSTODIA'
    ].includes(state);

    if(
      !mine ||
      !validState ||
      norm(r.modalidad||'')==='COPIA DIGITAL' ||
      norm(r.responsable||'')==='INSTRUCCIÓN' ||
      norm(r.responsable||'')==='INSTRUCCION' ||
      norm(r.responsable||'')==='DVC' ||
      norm(r.responsable||'')==='ELEVADO AL CONAS'
    ){
      invalid.push(r.expediente||r.id);
      continue;
    }

    rows.push({
      ...r,
      rd:String(r.rd||'').trim(),
      ultimo_folio:String(r.ultimo_folio||'').trim()
    });
  }

  if(invalid.length){
    bulkInstructionRows=[];

    el('bulkInstructionTable').innerHTML=`<div class="empty">
      La selección contiene expedientes que no pueden derivarse a Instrucción.
      <br><br>
      <b>${esc(invalid.join(', '))}</b>
      <br><br>
      Seleccione únicamente expedientes físicos bajo custodia válida.
    </div>`;

    if(el('bulkInstructionStatus')){
      el('bulkInstructionStatus').textContent=
        'Corrija la selección y vuelva a intentar.';
    }

    if(el('bulkInstructionSubmitBtn')){
      el('bulkInstructionSubmitBtn').disabled=true;
    }

    return;
  }

  bulkInstructionRows=rows.sort((a,b)=>
    String(a.expediente||'').localeCompare(
      String(b.expediente||''),
      'es',
      {numeric:true}
    )
  );

  renderBulkInstructionRows();
  window.v596PrepareDerivationMail?.('INSTRUCCION');
}

async function submitBulkInstruction(){
  if(!bulkInstructionRows.length)return;

  const missing=bulkInstructionRows.filter(
    x=>!String(x.ultimo_folio||'').trim()
  );

  if(missing.length){
    if(el('bulkInstructionStatus')){
      el('bulkInstructionStatus').textContent=
        'El Último folio es obligatorio para todos los expedientes.';
    }
    return;
  }

  const btn=el('bulkInstructionSubmitBtn');
  if(btn)btn.disabled=true;

  if(el('bulkInstructionStatus')){
    el('bulkInstructionStatus').textContent=
      'Registrando derivación física a Instrucción...';
  }

  const memo=(el('bulkInstructionMemo')?.value||'').trim();
  if(!memo){
    if(el('bulkInstructionStatus')){
      el('bulkInstructionStatus').textContent='Ingrese el N.º de Memorando de derivación.';
    }
    if(btn)btn.disabled=false;
    return;
  }

  const observation=
    (el('bulkInstructionObservation')?.value||'').trim();
  const derivationDraft=window.v596CaptureDerivation?.('INSTRUCCION')||null;

  const {data,error}=await sb.rpc(
    'derivar_expedientes_instruccion',
    {
      p_items:bulkInstructionRows.map(x=>({
        expediente_id:x.id,
        rd:String(x.rd||'').trim()||null,
        ultimo_folio:String(x.ultimo_folio||'').trim(),
        observacion:observation||null
      }))
    }
  );

  if(error){
    if(el('bulkInstructionStatus')){
      el('bulkInstructionStatus').textContent=
        'NO SE REGISTRÓ: '+error.message;
    }
    if(btn)btn.disabled=false;
    return;
  }

  const total=Number(data?.total||bulkInstructionRows.length);

  if(derivationDraft){
    await window.v596FinalizeDerivation?.(derivationDraft);
  }

  selectedIds.clear();
  updateSelectionUI();
  closeBulkInstructionModal();

  showToast(
    `${total} expediente(s) derivados a Instrucción`
  );

  const jobs=[
    loadPanel(),
    loadAll(),
    loadStates(),
    loadHistory(),
    loadRequests()
  ];

  if(hasFullAccess()){
    jobs.push(loadInstructionFolder());
  }

  await Promise.all(jobs);
}


function debounceInstructionFolder(){
  clearTimeout(instructionTimer);

  instructionTimer=setTimeout(
    loadInstructionFolder,
    250
  );
}

function syncInstructionSelection(){
  const n=instructionSelectedIds.size;

  if(el('instructionSelectedCount')){
    el('instructionSelectedCount').textContent=
      n+' seleccionado'+(n===1?'':'s');
  }

  if(el('instructionReturnBtn')){
    el('instructionReturnBtn').disabled=n===0;
  }
}

function toggleInstructionSelect(id,checked){
  if(checked){
    instructionSelectedIds.add(id);
  }else{
    instructionSelectedIds.delete(id);
  }

  renderInstructionTable();
  syncInstructionSelection();
}

function toggleInstructionSelectFromRow(event,id){
  const target=event?.target;

  if(
    target?.closest?.(
      'input,button,select,textarea,a,label'
    )
  )return;

  const checked=!instructionSelectedIds.has(id);

  if(checked){
    instructionSelectedIds.add(id);
  }else{
    instructionSelectedIds.delete(id);
  }

  renderInstructionTable();
  syncInstructionSelection();
}

function toggleAllInstruction(checked){
  (instructionRows||[]).forEach(r=>{
    if(checked){
      instructionSelectedIds.add(r.expediente_id);
    }else{
      instructionSelectedIds.delete(r.expediente_id);
    }
  });

  renderInstructionTable();
  syncInstructionSelection();
}

function renderInstructionTable(){
  const box=el('instructionTable');
  if(!box)return;

  if(!instructionRows.length){
    box.innerHTML=
      '<div class="empty">No hay expedientes actualmente derivados a Instrucción.</div>';
    return;
  }

  const allChecked=
    instructionRows.length>0 &&
    instructionRows.every(
      r=>instructionSelectedIds.has(r.expediente_id)
    );

  box.innerHTML=`<table>
    <thead><tr>
      <th>
        <input type="checkbox"
               ${allChecked?'checked':''}
               onchange="toggleAllInstruction(this.checked)">
      </th>

      <th>Expediente</th>
      <th>Ext.</th>
      <th>R.D.</th>
      <th>Memorando</th>
      <th>Ciclo</th>
      <th>Responsable de origen</th>
      <th>Fecha / hora derivación</th>
      <th>Días en Instrucción</th>
      <th>Último folio</th>
      <th>Cargo de origen</th>
      <th>Observación</th>
      <th></th>
    </tr></thead>

    <tbody>${instructionRows.map(r=>`
      <tr
        class="record-selectable-row ${
          instructionSelectedIds.has(r.expediente_id)
            ?'instruction-row-selected record-selected-row'
            :''
        }"
        onclick="toggleInstructionSelectFromRow(
          event,
          '${r.expediente_id}'
        )"
        title="Clic en la fila para seleccionar o deseleccionar">

        <td>
          <input type="checkbox"
            aria-label="Seleccionar ${esc(r.expediente||'expediente')}"
            ${instructionSelectedIds.has(r.expediente_id)?'checked':''}
            onchange="toggleInstructionSelect(
              '${r.expediente_id}',
              this.checked
            )">
        </td>

        <td><b>${esc(r.expediente||'—')}</b></td>
        <td>${esc(r.extension||'—')}</td>
        <td>${esc(r.rd||'—')}</td>
        <td><b>${esc(r.numero_memorando||'—')}</b></td>
        <td><b>${Number(r.ciclo_numero||1)}</b></td>
        <td>${esc(r.responsable_origen||'—')}</td>
        <td>${masterDateTimeHtml(r.fecha_derivacion)}</td>
        <td><b>${Number(r.dias_en_instruccion||0)}</b></td>
        <td>${esc(r.ultimo_folio_derivacion||'—')}</td>
        <td>${esc(r.cargo_origen||'—')}</td>
        <td>${esc(r.observacion_derivacion||'')}</td>

        <td>
          <button class="btn secondary small"
                  onclick="showExpHistory('${r.expediente_id}')">
            Historial
          </button>
        </td>
      </tr>`).join('')}
    </tbody>
  </table>`;
}

async function loadInstructionFolder(){
  if(!hasFullAccess())return;

  const search=
    (el('instructionSearch')?.value||'').trim();

  const {data,error}=await sb.rpc(
    'listar_derivados_instruccion',
    {
      p_busqueda:search||null
    }
  );

  if(error){
    instructionRows=[];

    if(el('instructionTable')){
      el('instructionTable').innerHTML=
        `<div class="empty">
          ${esc(error.message)}
          <br><br>
          Ejecute primero
          <b>INSTALAR_FLUJO_INSTRUCCION_NUEVO_CICLO.sql</b>
          en Supabase.
        </div>`;
    }

    return;
  }

  instructionRows=v599SortDerivationsNewestFirst(
    await v598AttachDerivationMemos(data||[],'INSTRUCCION')
  );
  instructionRows.forEach(r=>warnFuturePeruDateV186(r.fecha_derivacion,'INSTRUCCIÓN · '+String(r.expediente||'')));

  const visibleIds=new Set(
    instructionRows.map(
      r=>String(r.expediente_id)
    )
  );

  [...instructionSelectedIds].forEach(id=>{
    if(!visibleIds.has(String(id))){
      instructionSelectedIds.delete(id);
    }
  });

  const days=instructionRows.map(
    r=>Number(r.dias_en_instruccion||0)
  );

  if(el('instructionTotalCount')){
    el('instructionTotalCount').textContent=
      instructionRows.length;
  }

  if(el('instruction30Count')){
    el('instruction30Count').textContent=
      days.filter(x=>x>30).length;
  }

  if(el('instruction60Count')){
    el('instruction60Count').textContent=
      days.filter(x=>x>60).length;
  }

  if(el('instruction90Count')){
    el('instruction90Count').textContent=
      days.filter(x=>x>90).length;
  }

  if(el('instructionRowsCount')){
    el('instructionRowsCount').textContent=
      instructionRows.length+
      ' expediente'+
      (instructionRows.length===1?'':'s');
  }

  renderInstructionTable();
  syncInstructionSelection();
}


function fillInstructionReturnLocations(){
  const sel=el('instructionReturnLocation');
  if(!sel)return;

  const names=(catalogo||[])
    .filter(
      x=>x.activo!==false &&
         x.tipo!=='PERSONAL'
    )
    .map(
      x=>String(x.nombre||'').trim()
    )
    .filter(Boolean);

  const unique=[...new Set(names)];

  sel.innerHTML=unique.length
    ?unique.map(
      n=>`<option value="${esc(n)}">${esc(n)}</option>`
    ).join('')
    :'<option value="ARCHIVO">ARCHIVO</option>';

  const preferred=[...sel.options].find(
    o=>norm(o.value).includes('ARCHIVO')
  );

  if(preferred){
    sel.value=preferred.value;
  }
}

function updateInstructionReturnField(id,field,value){
  const row=instructionReturnRows.find(
    x=>String(x.expediente_id)===String(id)
  );

  if(!row)return;

  row[field]=String(value??'').trim();
  syncInstructionReturnState();
}

function syncInstructionReturnState(){
  const missing=(instructionReturnRows||[]).filter(
    x=>!String(x.ultimo_folio||'').trim()
  );

  const btn=el('instructionReturnConfirmBtn');

  if(btn){
    btn.disabled=
      !instructionReturnRows.length ||
      missing.length>0;
  }

  if(el('instructionReturnStatus')){
    el('instructionReturnStatus').textContent=
      missing.length
        ?`Falta ingresar el Último folio en ${missing.length} expediente${missing.length===1?'':'s'}.`
        :'Los datos están completos. Al confirmar se cerrará el ciclo anterior y se registrará el nuevo ingreso.';
  }
}

function renderInstructionReturnRows(){
  const box=el('instructionReturnTable');
  if(!box)return;

  box.innerHTML=`<table>
    <thead><tr>
      <th>Expediente</th>
      <th>Ciclo</th>
      <th>Extensión</th>
      <th>R.D.</th>
      <th>Último folio *</th>
      <th>Fecha / hora derivación</th>
      <th>Días en Instrucción</th>
      <th>Origen</th>
    </tr></thead>

    <tbody>${instructionReturnRows.map(r=>`<tr>
      <td><b>${esc(r.expediente||'—')}</b></td>

      <td>
        <b>${Number(r.ciclo_numero||1)}</b>
      </td>

      <td>
        <input class="instruction-return-input"
               value="${esc(r.extension||'')}"
               placeholder="Extensión"
               oninput="updateInstructionReturnField(
                 '${r.expediente_id}',
                 'extension',
                 this.value
               )">
      </td>

      <td>
        <input class="instruction-return-input"
               value="${esc(r.rd||'')}"
               placeholder="R.D."
               oninput="updateInstructionReturnField(
                 '${r.expediente_id}',
                 'rd',
                 this.value
               )">
      </td>

      <td>
        <input class="instruction-return-input required"
               value="${esc(r.ultimo_folio||'')}"
               placeholder="Último folio"
               oninput="updateInstructionReturnField(
                 '${r.expediente_id}',
                 'ultimo_folio',
                 this.value
               )">
      </td>

      <td>${masterDateTimeHtml(r.fecha_derivacion)}</td>
      <td>${Number(r.dias_en_instruccion||0)}</td>
      <td>${esc(r.responsable_origen||'—')}</td>
    </tr>`).join('')}</tbody>
  </table>`;

  syncInstructionReturnState();
}

function openInstructionReturnModal(){
  if(!hasFullAccess())return;

  const rows=(instructionRows||[]).filter(
    r=>instructionSelectedIds.has(r.expediente_id)
  );

  if(!rows.length){
    showToast(
      'Seleccione uno o más expedientes retornados de Instrucción.'
    );
    return;
  }

  instructionReturnRows=rows.map(r=>({
    ...r,
    extension:String(r.extension||'').trim(),
    rd:String(r.rd||'').trim(),
    ultimo_folio:String(
      r.ultimo_folio_derivacion||''
    ).trim()
  }));

  fillInstructionReturnLocations();

  if(el('instructionReturnObservation')){
    el('instructionReturnObservation').value='';
  }

  if(el('instructionReturnSummary')){
    el('instructionReturnSummary').textContent=
      rows.length+
      ' expediente'+
      (rows.length===1?'':'s');
  }

  renderInstructionReturnRows();

  el('instructionReturnModal')?.classList.add('show');
}

function closeInstructionReturnModal(){
  el('instructionReturnModal')?.classList.remove('show');
  instructionReturnRows=[];
}

async function confirmInstructionReturns(){
  if(!hasFullAccess())return;

  const location=
    (el('instructionReturnLocation')?.value||'').trim();

  const observation=
    (el('instructionReturnObservation')?.value||'').trim();

  if(!instructionReturnRows.length){
    if(el('instructionReturnStatus')){
      el('instructionReturnStatus').textContent=
        'No hay expedientes seleccionados.';
    }
    return;
  }

  if(!location){
    if(el('instructionReturnStatus')){
      el('instructionReturnStatus').textContent=
        'Seleccione la ubicación física de retorno.';
    }
    return;
  }

  const missing=instructionReturnRows.filter(
    x=>!String(x.ultimo_folio||'').trim()
  );

  if(missing.length){
    syncInstructionReturnState();
    return;
  }

  const btn=el('instructionReturnConfirmBtn');
  if(btn)btn.disabled=true;

  if(el('instructionReturnStatus')){
    el('instructionReturnStatus').textContent=
      'Registrando retorno de Instrucción y nuevo ingreso...';
  }

  const {data,error}=await sb.rpc(
    'registrar_retorno_instruccion',
    {
      p_items:instructionReturnRows.map(x=>({
        expediente_id:x.expediente_id,
        extension:String(x.extension||'').trim()||null,
        rd:String(x.rd||'').trim()||null,
        ultimo_folio:String(x.ultimo_folio||'').trim(),
        observacion:observation||null
      })),
      p_ubicacion_retorno:location,
      p_observacion:observation||null
    }
  );

  if(error){
    if(el('instructionReturnStatus')){
      el('instructionReturnStatus').textContent=
        'NO SE REGISTRÓ: '+error.message;
    }

    if(btn)btn.disabled=false;
    return;
  }

  const total=Number(
    data?.total||instructionReturnRows.length
  );

  instructionSelectedIds.clear();

  // V662 · Igual que CONAS/DVC: si el retorno se abrió desde Registro Maestro,
  // limpiar también la selección principal. El retorno de Instrucción conserva
  // su regla especial de RETORNO / NUEVO INGRESO.
  instructionReturnRows.forEach(x=>selectedIds.delete(x.expediente_id));
  updateSelectionUI();

  closeInstructionReturnModal();

  showToast(
    `${total} expediente(s) registrados como RETORNO DE INSTRUCCIÓN / NUEVO INGRESO`
  );

  await Promise.all([
    loadInstructionFolder(),
    loadSummary(),
    loadPanel(),
    loadAll(),
    loadStates(),
    loadHistory(),
    loadRequests()
  ]);
}


function operationalStatus(r){
  // REGISTRO MAESTRO POR CICLOS:
  // una fila histórica nunca toma el estado de una solicitud posterior.
  if(r?._master_cycle){
    return masterCycleOperationalStatus(r);
  }

  // V721 · no perder la reasignación activa por la devolución de un ciclo
  // anterior. Mantener las solicitudes de reasignación sin ejecutar aparte.
  if(r?._v721_custodia_verificada && !r?._internal_reassign_requested){
    const actual=norm(r.estado_operativo||'').normalize('NFD')
      .replace(/[̀-ͯ]/g,'');
    if(['EN PRESTAMO','REASIGNADO','DEVOLUCION SOLICITADA'].includes(actual)){
      const archivoState=archiveDeliveryVisualState(r);
      if(archivoState)return archivoState;
      return r.estado_operativo;
    }
  }

  // Una solicitud interna todavía no transfiere custodia, pero para el
  // solicitante debe verse en Mis Expedientes como trámite pendiente.
  if(r?._internal_reassign_requested)return 'REASIGNACIÓN SOLICITADA';

  // La columna ESTADO muestra el último estado operativo
  // para Abogado, Archivo y Administrador.
  const action=norm(r.ultimo_movimiento||'');
  const itemState=norm(r.estado_solicitud_item||'');

  // El cierre administrativo tiene prioridad visual en todas las vistas.
  // No debe volver a mostrarse como pendiente, devuelto o en custodia.
  if(['CERRADO POR ADMINISTRADOR','CERRADA POR ADMINISTRADOR'].includes(itemState)){
    return 'CERRADO POR ADMINISTRADOR';
  }

  // INSTRUCCIÓN: el retorno se registra como NUEVO INGRESO
  // sin duplicar el expediente maestro.
  if(
    action.includes('RETORNO DE INSTRUCCIÓN') ||
    action.includes('RETORNO DE INSTRUCCION')
  ){
    return 'RETORNO DE INSTRUCCIÓN';
  }

  if(
    action.includes('DERIVADO A INSTRUCCIÓN') ||
    action.includes('DERIVADO A INSTRUCCION') ||
    norm(r.responsable||'')==='INSTRUCCIÓN' ||
    norm(r.responsable||'')==='INSTRUCCION'
  ){
    return 'DERIVADO A INSTRUCCIÓN';
  }

  // CONAS y DVC son salidas físicas independientes.
  if(action.includes('RETORNO DE CONAS')){
    return 'DEVUELTO AL ARCHIVO';
  }
  if(action.includes('DERIVADO AL CONAS') ||
     norm(r.responsable||'')==='ELEVADO AL CONAS'){
    return 'DERIVADO AL CONAS';
  }

  if(action.includes('RETORNO DE DVC')){
    return 'DEVUELTO AL ARCHIVO';
  }
  if(action.includes('DERIVADO A LA DVC') ||
     action.includes('DERIVADO A DVC') ||
     norm(r.responsable||'')==='DVC'){
    return 'DERIVADO A LA DVC';
  }

  // Incorporación inicial al Registro Maestro.
  // No es una devolución: el expediente ingresa directamente en CUSTODIA.
  if(
    action.includes('INCORPORACIÓN AL REGISTRO MAESTRO') ||
    action.includes('INCORPORACION AL REGISTRO MAESTRO')
  ){
    return 'CUSTODIA';
  }

  // Envío físico definitivo de un listado a San Luis.
  if(action.includes('ENVÍO DE LISTADO A SAN LUIS') ||
     action.includes('ENVIO DE LISTADO A SAN LUIS')){
    return 'CUSTODIA';
  }

  // Último movimiento confirmado por Archivo.
  if(action.includes('ENVÍO DE LISTADO A SAN LUIS') ||
     action.includes('ENVIO DE LISTADO A SAN LUIS')){
    return 'CUSTODIA';
  }

  if(action.includes('DEVOLUCIÓN CONFIRMADA') ||
     action.includes('RECIBIDO EN ARCHIVO')){
    return 'DEVUELTO AL ARCHIVO';
  }

  // Si Archivo ya recibió físicamente el expediente, una nueva solicitud
  // PENDIENTE POR ATENDER no puede sustituir el estado DEVUELTO AL ARCHIVO.
  const physicalState=norm(r?.estado_fisico_db||'');
  const physicalResponsible=norm(r?.responsable_fisico_db||'');

  if(
    ['DEVUELTO','DEVUELTO AL ARCHIVO','CUSTODIA'].includes(physicalState) &&
    (
      physicalResponsible==='ARCHIVO' ||
      physicalResponsible.includes('ARCHIVO')
    )
  ){
    return 'DEVUELTO AL ARCHIVO';
  }

  // Cuando el USUARIO pulsa Devolver (individual o múltiple), la relación
  // solicitud_expedientes pasa inmediatamente a DEVOLUCIÓN SOLICITADA.
  // Este estado operativo debe tener prioridad sobre el estado físico
  // EN PRÉSTAMO hasta que Archivo confirme la recepción.
  if(itemState==='DEVOLUCIÓN SOLICITADA'){
    return 'DEVOLUCIÓN SOLICITADA';
  }

  // Una solicitud activa iniciada por Archivo tiene prioridad VISUAL.
  // El expediente sigue físicamente bajo custodia del usuario hasta
  // que se efectúe y confirme la devolución, pero ya no debe verse
  // simplemente como EN PRÉSTAMO.
  const archiveState=archiveDeliveryVisualState(r);
  if(archiveState)return archiveState;

  // El abogado comunicó la devolución, pero Archivo aún no confirma.
  if(action.includes('DEVOLUCIÓN SOLICITADA')){
    return 'DEVOLUCIÓN SOLICITADA';
  }

  // Cuando el último movimiento es una reasignación ya aceptada,
  // en la columna ESTADO debe figurar REASIGNADO.
  if(action.includes('REASIGNACIÓN')){
    return 'REASIGNADO';
  }

  // El cargo ya registró el préstamo al abogado.
  if(action.includes('EN PRÉSTAMO') ||
     action.includes('ATENDIDO CON CARGO')){
    return 'EN PRÉSTAMO';
  }

  // DEVUELTO representa una recepción física confirmada por Archivo.
  if(r.estado==='DEVUELTO'){
    return 'DEVUELTO AL ARCHIVO';
  }

  // CUSTODIA sin un movimiento de devolución corresponde a un expediente
  // incorporado o almacenado físicamente en Archivo / San Luis.
  if(r.estado==='CUSTODIA'){
    return 'CUSTODIA';
  }

  // Si aún no hay un movimiento operativo específico,
  // mostrar el estado físico actual de la base.
  return r.estado||'';
}

function rowStatus(r){
  const relation=String(
    r?.estado_relacion||
    r?.relacion_reasignacion||
    ''
  ).trim();

  // V637 · En las tarjetas de reasignación la columna Estado representa
  // la relación consultada. El estado físico permanece disponible en
  // estado_fisico_actual y en el historial, sin volver a rotular la fila
  // como PRÉSTAMOS.
  if(relation){
    const relationDisplay=norm(relation).includes('REASIGN')?'REASIGNADO':relation;
    return `<span class="pill reassigned">${esc(relationDisplay)}</span>`;
  }

  const state=operationalStatus(r);

  const c=state==='EN PRÉSTAMO'?'loan':
    state==='REASIGNACIÓN SOLICITADA'?'reassign-requested':
    state==='SOLICITADO POR EL ARCHIVO'?'archive-requested':
    state==='DEVUELTO AL ARCHIVO'?'returned-archive':
    state==='REASIGNADO'?'reassigned':
    state==='DEVOLUCIÓN SOLICITADA'?'return-requested':
    state==='DERIVADO AL CONAS'?'conas':
    state==='DERIVADO A LA DVC'?'dvc':
    state==='DERIVADO A INSTRUCCIÓN'?'instruction':
    state==='RETORNO DE INSTRUCCIÓN'?'instruction-return':
    state==='CERRADO POR ADMINISTRADOR'?'returned':
    state==='DEVUELTO'?'returned':'';

  return `<span class="pill ${c}">${esc(stateDisplayName(state))}</span>`;
}

function masterCanRegisterConasReturn(r){
  if(!hasFullAccess())return false;

  const state=norm(operationalStatus(r));

  return (
    state==='DERIVADO AL CONAS' ||
    state==='DERIVADO A CONAS' ||
    norm(r?.responsable||'')==='ELEVADO AL CONAS'
  );
}

async function openMasterConasReturn(expedienteId,button=null){
  if(!hasFullAccess()){
    alert('Solo Archivo o Administrador puede registrar el retorno de CONAS.');
    return;
  }

  expedienteId=String(expedienteId||'').trim();

  if(!expedienteId){
    alert('No se pudo identificar el expediente.');
    return;
  }

  const oldText=button?.textContent||'✓ Retorno CONAS';

  if(button){
    button.disabled=true;
    button.textContent='Verificando...';
  }

  try{
    // Consultar directamente la carpeta activa de CONAS sin depender
    // del filtro/buscador que pudiera estar abierto en esa pestaña.
    const {data,error}=await sb.rpc(
      'listar_derivados_conas',
      {p_busqueda:null}
    );

    if(error)throw error;

    const rows=data||[];
    const active=rows.find(
      r=>String(r.expediente_id||'')===expedienteId
    );

    if(!active){
      alert(
        'El expediente ya no figura como derivado activo al CONAS. '+
        'Actualice el Registro maestro para ver su último estado.'
      );

      await Promise.all([
        loadAll(),
        loadHistory()
      ]);

      return;
    }

    // Reutilizar exactamente el flujo de retorno ya existente.
    conasRows=rows;
    conasSelectedIds.clear();
    conasSelectedIds.add(active.expediente_id);

    fillConasReturnLocations();

    if(el('conasReturnObservation')){
      el('conasReturnObservation').value='';
    }

    if(el('conasReturnSummary')){
      el('conasReturnSummary').textContent='1 expediente';
    }

    if(el('conasReturnStatus')){
      el('conasReturnStatus').innerHTML=
        `<b>${esc(active.expediente||'Expediente')}</b> seleccionado. `+
        `Confirme que retornó físicamente del CONAS, revise la ubicación `+
        `de retorno y pulse <b>CONFIRMAR RETORNO DE CONAS</b>.`;
    }

    if(el('conasReturnTable')){
      el('conasReturnTable').innerHTML=`<table>
        <thead><tr>
          <th>Expediente</th>
          <th>Ext.</th>
          <th>Origen</th>
          <th>Fecha / hora derivación</th>
          <th>Días en CONAS</th>
        </tr></thead>
        <tbody><tr>
          <td><b>${esc(active.expediente||'—')}</b></td>
          <td>${esc(active.extension||'—')}</td>
          <td>${esc(active.responsable_origen||'—')}</td>
          <td>${masterDateTimeHtml(active.fecha_derivacion)}</td>
          <td>${Number(active.dias_en_conas||0)}</td>
        </tr></tbody>
      </table>`;
    }

    if(el('conasReturnConfirmBtn')){
      el('conasReturnConfirmBtn').disabled=false;
    }

    el('conasReturnModal')?.classList.add('show');

  }catch(err){
    alert(
      err?.message||
      String(err)
    );
  }finally{
    if(button){
      button.disabled=false;
      button.textContent=oldText;
    }
  }
}


function rowHistoryRequestId(row){
  return String(
    row?.solicitud_id ||
    row?.solicitud_pendiente_id ||
    row?.request_id ||
    ''
  ).trim();
}

function cycleHistoryButton(expedienteId,row,label='Historial'){
  // V751: el Coordinador también puede abrir el historial de expedientes autorizados.
  // Para Usuario/Coordinador se abre la trayectoria completa (todos los ciclos).
  const requestId=hasFullAccess()?rowHistoryRequestId(row):'';

  return `<button class="btn secondary small"
                  onclick="showExpHistory(
                    '${String(expedienteId||'')}',
                    '${String(requestId||'')}'
                  )">
            ${esc(label)}
          </button>`;
}


async function masterV18FetchByIds(table,field,values){
  const ids=[...new Set((values||[]).map(String).filter(Boolean))];
  if(!ids.length)return [];

  const result=[];

  for(let i=0;i<ids.length;i+=60){
    const chunk=ids.slice(i,i+60);

    for(let from=0;;from+=1000){
      const {data,error}=await sb
        .from(table)
        .select('*')
        .in(field,chunk)
        .range(from,from+999);

      if(error)throw error;

      result.push(...(data||[]));

      if(!data || data.length<1000)break;
    }
  }

  return result;
}

function masterV18CycleKey(requestId,expedienteId){
  return `${String(requestId||'')}|${String(expedienteId||'')}`;
}

function masterV18PriorityValue(r){
  return String(
    r?.master_prioridad||
    r?.prioridad||
    r?.nivel_prioridad||
    ''
  ).trim();
}

function masterV18PriorityHtml(r){
  const p=masterV18PriorityValue(r);
  if(!p)return '—';

  const n=norm(p);
  const cls=
    n.includes('URGENT') || n.includes('MUY ALTA')
      ?'urgent'
      :n.includes('ALTA')
        ?'high'
        :'';

  return `<span class="master-v18-priority ${cls}">${esc(p)}</span>`;
}

function masterV18Asunto(r){
  return String(
    r?.master_asunto||
    r?.asunto||
    ''
  ).trim();
}

function masterV18Attendant(r){
  return String(
    r?.master_atiende||
    r?.atiende_requerimiento||
    r?.atiende||
    ''
  ).trim();
}

function masterV18ReassignmentHtml(r){
  const from=String(r?.master_reasignacion_desde||'').trim();
  const to=String(r?.master_reasignacion_hacia||'').trim();

  if(!from && !to)return '—';

  return `
    <div class="master-v18-reassign-main">
      ${esc(from||'—')} → ${esc(to||'—')}
    </div>
  `;
}

function masterV18SentSanLuisHtml(r){
  const value=r?.listado_enviado_at||r?.master_fecha_envio_san_luis||null;
  if(!value)return '—';

  return `
    <div class="master-v18-sent-date">${esc(fmtDate(value)||'—')}</div>
    ${masterValueHasExplicitTime(value)
      ?`<div class="master-v18-muted">${esc(fmtTime(value))}</div>`
      :''
    }
  `;
}

function masterV18ReturnDateHtml(r){
  const value=
    r?.master_fecha_devolucion||
    r?.fecha_devolucion||
    null;

  return value
    ?masterDateTimeHtml(value)
    :'—';
}

function masterV18Returner(r){
  return String(
    r?.master_devuelve||
    r?.devuelto_por||
    r?._master_cycle_devuelto_por||
    ''
  ).trim();
}

function masterV18Receiver(r){
  if(r?._master_cycle && !masterCycleIsClosed(r)){
    return '';
  }

  const value=String(
    r?.master_recibe||
    ''
  ).trim();

  if(
    norm(value)==='ARCHIVO' ||
    norm(value)==='ARCHIVO DE GESTIÓN' ||
    norm(value)==='ARCHIVO DE GESTION'
  ){
    return '';
  }

  return value;
}

function masterV18ReturnFolio(r){
  return String(
    r?.master_folio_devolucion||
    ''
  ).trim();
}

async function enrichMasterOperationalColumnsV18(rows){
  const source=Array.isArray(rows)?rows:[];

  if(!source.length || !hasFullAccess() || !sb || !session){
    return source;
  }

  const cycleRows=source.filter(r=>r?._master_cycle && r?.solicitud_id);

  if(!cycleRows.length)return source;

  const requestIds=[...new Set(
    cycleRows.map(r=>String(r.solicitud_id||'')).filter(Boolean)
  )];

  const expedienteIds=[...new Set(
    cycleRows.map(r=>String(r.id||r.expediente_id||'')).filter(Boolean)
  )];

  try{
    const [requests,links,movements]=await Promise.all([
      masterV18FetchByIds(
        'solicitudes_prestamo',
        'id',
        requestIds
      ),
      masterV18FetchByIds(
        'solicitud_expedientes',
        'solicitud_id',
        requestIds
      ),
      masterV18FetchByIds(
        'movimientos_prestamo',
        'solicitud_id',
        requestIds
      )
    ]);

    const requestMap=new Map(
      (requests||[]).map(x=>[String(x.id||''),x])
    );

    // =====================================================
    // V115 · RECEPCIÓN DE DEVOLUCIÓN POR CICLO
    // =====================================================
    // La persona que recibe debe corresponder al mismo ciclo
    // (solicitud_id + expediente_id). Un ciclo devuelto anteriormente
    // nunca debe contaminar un ciclo nuevo que todavía sigue abierto.
    const acceptanceMap=new Map();

    try{
      const acceptanceItems=cycleRows.map(r=>({
        solicitud_id:String(r.solicitud_id||'').trim()||null,
        expediente_id:String(r.id||r.expediente_id||'').trim()||null
      })).filter(x=>x.solicitud_id && x.expediente_id);

      if(acceptanceItems.length){
        const {data:acceptanceData,error:acceptanceError}=await sb.rpc(
          'obtener_aceptaciones_devolucion_operativo',
          {p_items:acceptanceItems}
        );

        if(!acceptanceError){
          (acceptanceData||[]).forEach(x=>{
            const key=masterV18CycleKey(
              x.solicitud_id,
              x.expediente_id
            );
            acceptanceMap.set(key,x);
          });
        }else{
          console.warn(
            'V115 · aceptación de devolución por ciclo:',
            acceptanceError.message
          );
        }
      }
    }catch(acceptanceError){
      console.warn(
        'V115 · aceptación de devolución por ciclo:',
        acceptanceError?.message||acceptanceError
      );
    }

    const expSet=new Set(expedienteIds);

    const linkMap=new Map();
    const cargoNumbers=new Set();

    (links||[]).forEach(link=>{
      const expId=String(link.expediente_id||'');
      if(!expSet.has(expId))return;

      const key=masterV18CycleKey(
        link.solicitud_id,
        expId
      );

      linkMap.set(key,link);

      const cargo=String(link.cargo_numero||'').trim();
      if(cargo) cargoNumbers.add(cargo);
    });

    cycleRows.forEach(r=>{
      const cargo=String(r.cargo||'').trim();
      if(cargo) cargoNumbers.add(cargo);
    });

    let cargos=[];

    if(cargoNumbers.size){
      cargos=await masterV18FetchByIds(
        'cargos',
        'numero',
        [...cargoNumbers]
      );
    }

    const cargoMap=new Map(
      (cargos||[]).map(x=>[String(x.numero||'').trim(),x])
    );

    const movementMap=new Map();

    (movements||[]).forEach(m=>{
      const expId=String(m.expediente_id||'');
      if(!expSet.has(expId))return;

      const key=masterV18CycleKey(
        m.solicitud_id,
        expId
      );

      if(!movementMap.has(key)){
        movementMap.set(key,[]);
      }

      movementMap.get(key).push(m);
    });

    movementMap.forEach(list=>{
      list.sort(
        (a,b)=>
          new Date(a?.created_at||0) -
          new Date(b?.created_at||0)
      );
    });

    return source.map(r=>{
      if(!r?._master_cycle || !r?.solicitud_id){
        return r;
      }

      const expId=String(r.id||r.expediente_id||'');
      const requestId=String(r.solicitud_id||'');
      const key=masterV18CycleKey(requestId,expId);

      const request=requestMap.get(requestId)||{};
      const link=linkMap.get(key)||{};
      const list=movementMap.get(key)||[];

      const reassignments=list.filter(m=>{
        const action=norm(m?.accion||'');
        return (
          action.includes('REASIGN') &&
          !action.includes('SOLICITUD')
        );
      });

      const latestReassignment=
        reassignments.length
          ?reassignments[reassignments.length-1]
          :null;

      // =====================================================
      // V114 · ÚLTIMO TRASLADO DEL CICLO
      // =====================================================
      // La columna principal "Reasignación (De → A)" no debe quedarse
      // mostrando una reasignación anterior si después el expediente
      // fue derivado físicamente a CONAS, DVC o Instrucción.
      //
      // Ejemplo:
      // HANS HUARACA → MARCELA ALONZO        (reasignación anterior)
      // MARCELA ALONZO → CONAS              (movimiento posterior)
      //
      // Registro Maestro debe mostrar el segundo movimiento y su
      // fecha/hora real de derivación.
      const transferMovements=list.filter(m=>{
        const action=norm(m?.accion||'');

        return (
          (
            action.includes('REASIGN') &&
            !action.includes('SOLICITUD')
          ) ||
          action.includes('DERIVADO AL CONAS') ||
          action.includes('DERIVADO A CONAS') ||
          action.includes('DERIVADO A LA DVC') ||
          action.includes('DERIVADO A DVC') ||
          action.includes('DERIVADO A INSTRUCCIÓN') ||
          action.includes('DERIVADO A INSTRUCCION')
        );
      });

      const latestTransfer=
        transferMovements.length
          ?transferMovements[transferMovements.length-1]
          :latestReassignment;

      const latestTransferAction=norm(
        latestTransfer?.accion||
        ''
      );

      let latestTransferDestination=String(
        latestTransfer?.hacia||
        latestTransfer?.destino||
        latestTransfer?.area||
        ''
      ).trim();

      // Mostrar nombres de destino simples y consistentes.
      if(
        latestTransferAction.includes('DERIVADO AL CONAS') ||
        latestTransferAction.includes('DERIVADO A CONAS')
      ){
        latestTransferDestination='CONAS';
      }else if(
        latestTransferAction.includes('DERIVADO A LA DVC') ||
        latestTransferAction.includes('DERIVADO A DVC')
      ){
        latestTransferDestination='DVC';
      }else if(
        latestTransferAction.includes('DERIVADO A INSTRUCCIÓN') ||
        latestTransferAction.includes('DERIVADO A INSTRUCCION')
      ){
        latestTransferDestination='INSTRUCCIÓN';
      }

      // Si la RPC de derivación no registró "desde", recuperar el
      // responsable que recibió la última reasignación inmediatamente
      // anterior. En el caso 0011-2010 esto permite obtener MARCELA ALONZO.
      const latestTransferFrom=String(
        latestTransfer?.desde||
        (
          latestTransfer!==latestReassignment
            ?latestReassignment?.hacia
            :''
        )||
        ''
      ).trim();

      // V19: conservar las primeras seis reasignaciones
      // en orden cronológico, igual que en el Excel.
      const reassignmentsDetail=reassignments
        .slice(0,6)
        .map(m=>({
          desde:m?.desde||'',
          hacia:m?.hacia||'',
          created_at:m?.created_at||null
        }));

      // V19: movimientos que evidencian que el expediente se encontraba
      // o fue solicitado/derivado hacia otra área o sede.
      const otherAreaDetail=list
        .filter(m=>{
          const action=norm(m?.accion||'');
          return (
            action.includes('SOLICITUD ENTRE AREAS') ||
            action.includes('SOLICITUD ENTRE ÁREAS') ||
            action.includes('DERIVADO A') ||
            action.includes('EN ESPERA DE RETORNO') ||
            action.includes('EN ESPERA DE DEVOLUCION') ||
            action.includes('EN ESPERA DE DEVOLUCIÓN')
          );
        })
        .slice(0,3)
        .map(m=>({
          hacia:m?.hacia||'',
          area:m?.area||'',
          destino:m?.destino||'',
          created_at:m?.created_at||null
        }));

      const returns=list.filter(m=>{
        const action=norm(m?.accion||'');
        return (
          action.includes('DEVOLUCION CONFIRMADA') ||
          action.includes('DEVOLUCIÓN CONFIRMADA') ||
          action.includes('RECIBIDO EN ARCHIVO')
        );
      });

      const latestReturn=
        returns.length
          ?returns[returns.length-1]
          :null;

      const cargoNumber=String(
        link.cargo_numero||
        r.cargo||
        ''
      ).trim();

      const cargo=cargoMap.get(cargoNumber)||{};

      // Puede existir en instalaciones posteriores; si aún no existe
      // simplemente queda en blanco sin romper el sistema.
      const prioridad=String(
        request.prioridad||
        request.nivel_prioridad||
        request.nivel_de_prioridad||
        ''
      ).trim();

      const atiende=String(
        cargo.atiende_requerimiento||
        request.atiende_requerimiento||
        request.atiende||
        request.aceptado_por||
        ''
      ).trim();

      const cycleClosed=masterCycleIsClosed(r);

      const savedAcceptance=
        acceptanceMap.get(key)||
        null;

      const returnTarget=String(
        latestReturn?.hacia||
        ''
      ).trim();

      const savedReceiver=String(
        savedAcceptance?.aceptado_por||
        ''
      ).trim();

      const movementReceiver=String(
        latestReturn?.recibido_por||
        latestReturn?.profesional_recibe||
        latestReturn?.atendido_por||
        latestReturn?.registrado_por||
        latestReturn?.atiende||
        ''
      ).trim();

      const targetLooksLikePerson=
        returnTarget &&
        !norm(returnTarget).includes('ARCHIVO') &&
        !norm(returnTarget).includes('CUSTODIA');

      // REGLA V115:
      // Si ESTE ciclo todavía no fue devuelto, "Profesional que recibe"
      // debe quedar vacío, aunque el mismo expediente haya sido devuelto
      // en un ciclo anterior.
      //
      // Si ESTE ciclo sí fue devuelto, mostrar únicamente la persona
      // ARCHIVO/ADMINISTRADOR que confirmó la recepción.
      let recibe='';

      if(cycleClosed){
        recibe=String(
          savedReceiver||
          movementReceiver||
          (targetLooksLikePerson?returnTarget:'')||
          ''
        ).trim();

        // Nunca mostrar una ubicación como si fuera una persona.
        if(
          norm(recibe)==='ARCHIVO' ||
          norm(recibe)==='ARCHIVO DE GESTIÓN' ||
          norm(recibe)==='ARCHIVO DE GESTION' ||
          norm(recibe)==='CUSTODIA'
        ){
          recibe='';
        }
      }

      // El folio de devolución se toma exclusivamente de la relación
      // de ESA solicitud. Si el esquema antiguo no lo almacena, queda —.
      const folioDevolucion=String(
        link.ultimo_folio||
        link.folio_devolucion||
        ''
      ).trim();

      return {
        ...r,

        master_prioridad:prioridad,
        master_asunto:String(
          request.asunto||
          r.asunto||
          ''
        ).trim(),

        master_atiende:atiende,

        master_reasignacion_desde:
          latestTransferFrom,

        master_reasignacion_hacia:
          latestTransferDestination,

        // Momento exacto del ÚLTIMO traslado, incluida la derivación.
        master_reasignacion_fecha:
          latestTransfer?.created_at||null,

        master_reasignaciones_total:
          reassignments.length,

        master_reasignaciones_detalle:
          reassignmentsDetail,

        master_otra_area_detalle:
          otherAreaDetail,

        master_fecha_devolucion:
          cycleClosed
            ?(
              savedAcceptance?.fecha_aceptacion_devolucion||
              latestReturn?.created_at||
              link.fecha_devolucion||
              r.fecha_devolucion||
              null
            )
            :null,

        master_devuelve:
          cycleClosed
            ?String(
              latestReturn?.desde||
              r.devuelto_por||
              ''
            ).trim()
            :'',

        master_recibe:
          cycleClosed
            ?recibe
            :'',

        master_folio_devolucion:
          masterCycleIsClosed(r)
            ?folioDevolucion
            :'',

        master_fecha_envio_san_luis:
          r.listado_enviado_at||null
      };
    });

  }catch(error){
    console.warn(
      'Columnas operativas Registro Maestro V18:',
      error?.message||error
    );

    // Si algún dato complementario no existe en una instalación antigua,
    // la vista principal continúa funcionando.
    return source;
  }
}



function accumulatedKey(id){
  return String(id||'');
}

function accumulatedRowsForPrincipal(id){
  return accumulatedCache.get(accumulatedKey(id))||[];
}

function accumulatedPrincipalId(row){
  return String(row?.expediente_id||row?.id||'').trim();
}

function setAccumulatedRowsForPrincipal(id,rows){
  accumulatedCache.set(
    accumulatedKey(id),
    Array.isArray(rows)?rows:[]
  );
}

async function loadAccumulatedForPrincipalIds(ids,force=false){
  if(!sb||!session)return new Map();

  const unique=[...new Set(
    (ids||[])
      .map(String)
      .filter(Boolean)
  )];

  const missing=force
    ?unique
    :unique.filter(id=>!accumulatedCache.has(id));

  if(!missing.length){
    return accumulatedCache;
  }

  const {data,error}=await sb.rpc(
    'listar_acumulados_por_principales',
    {p_principal_ids:missing}
  );

  if(error){
    console.warn('Acumulados:',error.message||error);
    missing.forEach(id=>{
      if(!accumulatedCache.has(id))accumulatedCache.set(id,[]);
    });
    return accumulatedCache;
  }

  const grouped=new Map(missing.map(id=>[id,[]]));

  (data||[]).forEach(row=>{
    const id=String(row.expediente_principal_id||'');
    if(!grouped.has(id))grouped.set(id,[]);
    grouped.get(id).push(row);
  });

  grouped.forEach((rows,id)=>{
    accumulatedCache.set(id,rows);
  });

  return accumulatedCache;
}

async function enrichAccumulatedRowsInPlace(rows,force=false){
  const list=Array.isArray(rows)?rows:[];
  const ids=list.map(accumulatedPrincipalId).filter(Boolean);

  await loadAccumulatedForPrincipalIds(ids,force);

  list.forEach(r=>{
    const id=accumulatedPrincipalId(r);
    r._acumulados=accumulatedRowsForPrincipal(id);
  });

  return list;
}

async function enrichMasterAccumulatedRows(rows){
  const list=Array.isArray(rows)?rows:[];

  try{
    await enrichAccumulatedRowsInPlace(list);
  }catch(err){
    console.warn('Registro Maestro · acumulados:',err);
  }

  return list;
}


function v704AccumulatedRequestBadge(a,solicitudId=''){
  const same=
    String(a?.solicitud_id||'').trim() &&
    String(a?.solicitud_id||'').trim()===String(solicitudId||'').trim();

  return same
    ?'<span class="v704-same-request">MISMA SOLICITUD</span>'
    :'';
}

function accumulatedInlineHtml(row,options={}){
  const principalId=accumulatedPrincipalId(row);
  const acumulados=Array.isArray(row?._acumulados)
    ?row._acumulados
    :accumulatedRowsForPrincipal(principalId);

  const n=acumulados.length;
  const canManage=!!options.canManage;
  const solicitudId=String(options.solicitudId||'');
  const principalLabel=String(row?.expediente||'').trim();
  const principalExtension=String(row?.extension||'').trim();

  if(!n){
    if(!canManage)return '';

    return `<div class="accum-inline">
      <button class="btn secondary small accum-add-btn"
              type="button"
              onclick="event.stopPropagation();openAccumulatedModal('${esc(principalId)}','${esc(solicitudId)}','${esc(principalLabel)}','${esc(principalExtension)}')">
        + Agregar acumulados
      </button>
    </div>`;
  }

  return `<div class="accum-inline" onclick="event.stopPropagation()">
    <details>
      <summary>▸ ${n} acumulado${n===1?'':'s'}</summary>
      <div class="accum-inline-list">
        ${acumulados.map(a=>`
          <span class="accum-inline-item">
            ↳ <span class="v704-exp-role acumulado">ACUMULADO</span>
            <b>${esc(a.numero_acumulado||'')}</b>
            · <span>${esc(a.extension||'SIN EXTENSIÓN')}</span>
            ${v704AccumulatedRequestBadge(a,solicitudId)}
          </span>
        `).join('')}
        ${canManage
          ?`<div class="accum-inline-action">
              <button class="btn secondary small accum-add-btn"
                      type="button"
                      onclick="event.stopPropagation();openAccumulatedModal('${esc(principalId)}','${esc(solicitudId)}','${esc(principalLabel)}','${esc(principalExtension)}')">
                Gestionar acumulados
              </button>
            </div>`
          :''
        }
      </div>
    </details>
  </div>`;
}

function masterExpedienteAccumulatedHtml(r){
  const searchedByAccumulated=
    r?._master_search_by_accumulated &&
    r?._master_accumulated_search_number;

  return `
    <b>${esc(expBase(r.expediente))}</b>
    ${searchedByAccumulated
      ?`<span class="accum-search-note">
          Coincidencia por acumulado: ${esc(r._master_accumulated_search_number)}
        </span>`
      :''
    }
    <span class="v787-master-link" data-v787-master="${esc(r.id||'')}"></span>
    ${accumulatedInlineHtml(r,{canManage:false})}
  `;
}

function requestCanManageAccumulated(row){
  if(!hasFullAccess())return false;

  const state=norm(
    row?.estado_item||
    row?.estado||
    ''
  );

  // Archivo puede registrar lo encontrado durante la verificación física.
  return [
    'ACEPTADO',
    'PENDIENTE POR ATENDER',
    'CARGO GENERADO',
    'EN PRÉSTAMO',
    'REASIGNADO'
  ].includes(state);
}

async function openAccumulatedModal(principalId,solicitudId='',principalLabel='',principalExtension=''){
  if(!hasFullAccess()){
    alert('Solo ARCHIVO o ADMINISTRADOR puede gestionar acumulados.');
    return;
  }

  principalId=String(principalId||'').trim();
  solicitudId=String(solicitudId||'').trim();

  if(!principalId){
    alert('No se pudo identificar el expediente principal.');
    return;
  }

  accumulatedContext={
    principalId,
    solicitudId,
    principalLabel,
    principalExtension
  };

  el('accumPrincipalLabel').textContent=principalLabel||'Expediente';
  el('accumPrincipalExtensionLabel').textContent=
    `Extensión: ${principalExtension||'SIN EXTENSIÓN'}`;
  const requestNumber=
    solicitudId && String(currentRequestId||'')===solicitudId
      ?String(currentRequest?.numero||'').trim()
      :'';

  el('accumRequestLabel').textContent=
    solicitudId
      ?`El acumulado quedará vinculado al expediente principal y a la misma solicitud${requestNumber?' '+requestNumber:''}.`
      :'La relación se registrará a nivel del expediente físico.';

  el('accumNumeroInput').value='';
  el('accumExtensionInput').value='';
  el('accumObservationInput').value='';
  el('accumStatus').textContent='';

  el('acumuladosModal').classList.add('show');
  if(typeof v787ShowRegularization==='function')v787ShowRegularization();

  await refreshAccumulatedModal(true);

  setTimeout(()=>el('accumNumeroInput')?.focus(),80);
}

function closeAccumulatedModal(){
  const requestId=String(accumulatedContext?.solicitudId||'');
  const refreshFullEdit=
    !!requestId &&
    !!el('newRequestModal')?.classList.contains('show');

  el('acumuladosModal')?.classList.remove('show');
  accumulatedContext=null;

  if(refreshFullEdit){
    setTimeout(()=>{
      openEditRequest(requestId).catch(err=>console.warn(err));
    },80);
  }
}

async function refreshAccumulatedModal(force=false){
  if(!accumulatedContext)return;

  const id=accumulatedContext.principalId;

  await loadAccumulatedForPrincipalIds([id],force);

  const rows=accumulatedRowsForPrincipal(id);
  const list=el('accumList');

  if(!rows.length){
    list.innerHTML='<div class="empty">Sin acumulados registrados.</div>';
    return;
  }

  list.innerHTML=rows.map(a=>`
    <div class="accum-list-row">
      <div>
        <div class="accum-list-num">${esc(a.numero_acumulado||'')}</div>
        <div class="accum-list-meta">
          ${a.extension?`Ext.: ${esc(a.extension)} · `:''}
          Registrado: ${fmtDate(a.created_at)}
          ${a.registrado_por_nombre?` · ${esc(a.registrado_por_nombre)}`:''}
          ${String(a.solicitud_id||'')===String(accumulatedContext?.solicitudId||'')
            ?' · MISMA SOLICITUD'
            :''}
        </div>
      </div>

      <div class="accum-list-meta">
        ${a.observacion?esc(a.observacion):'—'}
      </div>

      <button class="btn secondary small"
              type="button"
              onclick="removeAccumulatedExpediente('${esc(a.id)}','${esc(a.numero_acumulado||'')}')">
        Quitar vínculo
      </button>
    </div>
  `).join('');
}

async function saveAccumulatedExpediente(){
  if(!hasFullAccess()||!accumulatedContext)return;

  const numero=(el('accumNumeroInput')?.value||'').trim();
  const extension=(el('accumExtensionInput')?.value||'').trim();
  const observacion=(el('accumObservationInput')?.value||'').trim();

  if(!numero){
    el('accumStatus').textContent='Ingrese el número del expediente acumulado.';
    el('accumNumeroInput')?.focus();
    return;
  }

  const btn=el('accumAddBtn');
  btn.disabled=true;
  btn.textContent='Agregando...';
  el('accumStatus').textContent=
    `Registrando acumulado para ${accumulatedContext.principalLabel||'el principal'} · ${accumulatedContext.principalExtension||'SIN EXTENSIÓN'}...`;

  try{
    const {data,error}=await sb.rpc(
      'registrar_acumulado_expediente',
      {
        p_principal_id:accumulatedContext.principalId,
        p_numero_acumulado:numero,
        p_extension:extension||null,
        p_solicitud_id:accumulatedContext.solicitudId||null,
        p_observacion:observacion||null
      }
    );

    if(error)throw error;

    accumulatedCache.delete(accumulatedContext.principalId);

    await refreshAccumulatedModal(true);

    el('accumNumeroInput').value='';
    el('accumExtensionInput').value='';
    el('accumObservationInput').value='';
    el('accumStatus').textContent='Acumulado registrado correctamente.';

    showToast(`${numero} agregado como acumulado`);

    // Actualizar la solicitud abierta sin perder el contexto.
    if(currentRequestId && currentRequestId===accumulatedContext.solicitudId){
      await enrichAccumulatedRowsInPlace(requestDetailRows,true);
      renderRequestDetailItems();
    }

    // La pantalla completa de atención se refrescará al cerrar
    // este modal para conservar correctamente todos sus controles.

    // Refrescar Registro Maestro en segundo plano.
    loadAll().catch(err=>console.warn(err));

  }catch(err){
    el('accumStatus').textContent=err?.message||String(err);
  }finally{
    btn.disabled=false;
    btn.textContent='+ Agregar acumulado';
  }
}

async function removeAccumulatedExpediente(acumuladoId,numero=''){
  if(!hasFullAccess()||!accumulatedContext)return;

  el('accumStatus').textContent=`Retirando vínculo ${numero||''}...`;

  try{
    const {error}=await sb.rpc(
      'retirar_acumulado_expediente',
      {
        p_acumulado_id:acumuladoId,
        p_solicitud_id:accumulatedContext.solicitudId||null,
        p_observacion:'Corrección de la relación de acumulación desde el sistema'
      }
    );

    if(error)throw error;

    accumulatedCache.delete(accumulatedContext.principalId);
    await refreshAccumulatedModal(true);

    el('accumStatus').textContent='Vínculo retirado. La acción quedó en auditoría.';

    if(currentRequestId && currentRequestId===accumulatedContext.solicitudId){
      await enrichAccumulatedRowsInPlace(requestDetailRows,true);
      renderRequestDetailItems();
    }

    // La pantalla completa de atención se refrescará al cerrar
    // este modal para conservar correctamente todos sus controles.

    loadAll().catch(err=>console.warn(err));

  }catch(err){
    el('accumStatus').textContent=err?.message||String(err);
  }
}

async function resolveAccumulatedLookup(numero,extension=''){
  const raw=String(numero||'').trim();
  const ext=String(extension||'').trim();

  if(!raw || !/^\d+-\d{4}$/.test(raw)){
    return null;
  }

  try{
    const {data,error}=await sb.rpc(
      'resolver_expediente_principal',
      {
        p_numero:raw,
        p_extension:ext||null
      }
    );

    if(error)return null;

    const row=Array.isArray(data)?data[0]:data;
    if(row)return row;

    // Si no se indicó extensión y el número existe en más de una
    // relación de acumulación, no escoger una variante al azar.
    if(!ext){
      const {data:variants,error:variantsError}=await sb.rpc(
        'buscar_variantes_acumuladas',
        {p_numero:raw}
      );

      if(!variantsError && Array.isArray(variants) && variants.length>1){
        return {
          _ambiguous_accumulated:true,
          variants
        };
      }
    }

    return null;

  }catch(_){
    return null;
  }
}


function masterV19DateOnly(value){
  return value ? (fmtDate(value)||'—') : '—';
}

function masterV19TimeOnly(value){
  if(!value)return '—';
  return masterValueHasExplicitTime(value)
    ?(fmtTime(value)||'—')
    :'—';
}


function masterV28AttentionDays(r){
  const start=masterRequestEntryValue(r);
  const end=masterDeliveryDateTimeValue(r);

  if(!start || !end)return '—';

  const days=businessDays(start,end);
  return days>0 ? String(days) : '—';
}

function masterV28CustodyDays(r){
  // V627 · El contador representa la custodia VIGENTE, no la primera
  // entrega histórica. Toda transferencia efectiva reinicia el conteo:
  // usuario → usuario, CONAS, DVC, Instrucción, retorno a Archivo, etc.
  if(norm(r?.modalidad||'')==='COPIA DIGITAL'){
    return '—';
  }

  const start=
    r?.fecha_inicio_custodia_vigente ||
    r?.fecha_inicio_custodia ||
    r?.master_reasignacion_fecha ||
    masterDeliveryDateTimeValue(r) ||
    null;

  const end=
    r?.master_fecha_devolucion ||
    r?.fecha_devolucion ||
    null;

  if(!start)return '—';

  const days=businessDays(start,end);
  return Number.isFinite(days) && days>=0 ? String(days) : '—';
}

function masterV19AttentionDuration(r){
  const start=masterRequestEntryValue(r);
  const end=masterDeliveryDateTimeValue(r);

  if(!start || !end){
    return {days:'—',hours:'—'};
  }

  const s=new Date(start);
  const e=new Date(end);

  if(Number.isNaN(s.getTime()) || Number.isNaN(e.getTime()) || e<s){
    return {days:'—',hours:'—'};
  }

  const totalHours=(e-s)/3600000;
  const days=Math.floor(totalHours/24);
  const hours=Math.round((totalHours-(days*24))*10)/10;

  return {
    days:String(days),
    hours:String(hours)
  };
}

function masterV19ReassignmentCell(r,index){
  const items=Array.isArray(r?.master_reasignaciones_detalle)
    ?r.master_reasignaciones_detalle
    :[];

  const item=items[index]||null;

  if(!item)return '—';

  const professional=String(item.hacia||'').trim();

  return professional
    ?`<span class="v19-reassign">${esc(professional)}</span>`
    :'—';
}

function masterV19ReassignmentDate(r,index){
  const items=Array.isArray(r?.master_reasignaciones_detalle)
    ?r.master_reasignaciones_detalle
    :[];

  const item=items[index]||null;

  return item?.created_at
    ?masterDateTimeHtml(item.created_at)
    :'—';
}

function masterV19OtherAreaCell(r,index){
  const items=Array.isArray(r?.master_otra_area_detalle)
    ?r.master_otra_area_detalle
    :[];

  const item=items[index]||null;

  if(item){
    const label=String(
      item.hacia||
      item.area||
      item.destino||
      ''
    ).trim();

    return label?esc(label):'—';
  }

  if(index===0){
    const fallback=String(
      r?.ubicacion_comunicada||
      ''
    ).trim();

    return fallback?esc(fallback):'—';
  }

  return '—';
}

function masterV19OtherAreaDate(r,index){
  const items=Array.isArray(r?.master_otra_area_detalle)
    ?r.master_otra_area_detalle
    :[];

  const item=items[index]||null;

  if(item?.created_at){
    return masterDateTimeHtml(item.created_at);
  }

  if(index===0 && r?.ubicacion_comunicada_at){
    return masterDateTimeHtml(r.ubicacion_comunicada_at);
  }

  return '—';
}

function masterV19LocationFinal(r){
  return (
    masterSedeValue(r)||
    r?.ubicacion_comunicada||
    r?.responsable||
    '—'
  );
}

function masterV19SystemFields(r){
  return {
    listado:r?.listado_numero||'—',
    sede:masterSedeHtml(r),
    envio:masterV18SentSanLuisHtml(r)
  };
}

function masterRecordTableV18(data){
  if(!data.length){
    return '<div class="empty">No hay expedientes registrados para esta selección.</div>';
  }

  const limited=isLimitedUser();

  const selectableRows=data.filter(r=>masterCycleRowSelectable(r));

  const body=data.map((r,index)=>{
    const masterSelectable=masterCycleRowSelectable(r);
    const checked=masterCycleRowChecked(r);

    const rowClass=[
      masterSelectable?'record-selectable-row':'',
      checked?'record-selected-row':'',
      masterCycleRowClass(r),
      (operationalStatus(r)==='DEVUELTO AL ARCHIVO' || masterDigitalCycleDelivered(r))
        ?'master-row-returned-archive'
        :''
    ].filter(Boolean).join(' ');

    const rowClick=masterSelectable
      ?`onclick="toggleSelectFromRow(event,'${r.id}')" title="Clic en la fila para seleccionar o deseleccionar"`
      :(r._master_cycle
        ?'title="Ciclo cerrado · solo lectura"'
        :'');

    const rowNumber=index+1;

    const solicitudFecha=masterRequestEntryValue(r);
    const entregaFecha=masterDeliveryDateTimeValue(r);
    const duration=masterV19AttentionDuration(r);

    const solicitante=
      masterShowRequester(r) && r.solicitante_pendiente
        ?`<b>${esc(r.solicitante_pendiente)}</b>
          ${r.solicitud_pendiente_numero
            ?`<span class="v19-small">${esc(r.solicitud_pendiente_numero)}</span>`
            :''
          }
          ${masterCycleBadgeHtml(r)}`
        :'—';

    const systemFields=masterV19SystemFields(r);

    const actions=`<div class="master-actions-inline">
      <button class="btn secondary small"
              onclick="showExpHistory(
                '${r.id}',
                '${r._master_cycle?(r.solicitud_id||''):''}'
              )">
        Historial
      </button>
      ${isAdmin() && !r._master_cycle
        ?`<button class="btn secondary small v800-correction-button" type="button"
            title="Corregir número sin crear otra solicitud ni modificar el préstamo"
            onclick="event.stopPropagation();window.v800OpenCorrection('${r.expediente_id||r.id}')">
            ✎ Corregir número
          </button>`
        :''}

      ${r._master_cycle && masterCycleIsClosed(r)
        ?`<span class="master-cycle-readonly">Solo lectura</span>`
        :(!limited
          ?(r._master_cycle
            ?`<button class="btn small user-manage-action"
                      onclick="manageMasterCycle(
                        '${r.id}',
                        '${r.solicitud_id||''}',
                        this
                      )">
                Gestionar
              </button>`
            :`<button class="btn small user-manage-action"
                      onclick="manageExpedienteFromPanel('${r.id}',this)">
                Gestionar
              </button>`)
          :'')}
    </div>`;

    return `<tr class="${rowClass}" ${rowClick}>
      <td>
        ${!masterSelectable
          ?`<input type="checkbox" disabled>`
          :`<input type="checkbox"
                   aria-label="Seleccionar ${esc(expKey(r))}"
                   ${checked?'checked':''}
                   onchange="toggleSelect('${r.id}',this.checked,this)">`
        }
      </td>

      <!-- ÍTEM -->
      <td class="v19-item"><b>${rowNumber}</b></td>

      <!-- ORDEN V28 -->
      <td class="v19-date">${masterRequestEntryHtml(r)}</td>

      <td class="v19-exp">
        ${masterExpedienteAccumulatedHtml(r)}
      </td>

      <td>${r.extension?esc(r.extension):'—'}</td>

      <td>${r.rd?esc(r.rd):'—'}</td>

      <td>${r.ultimo_folio?esc(r.ultimo_folio):'—'}</td>

      <td class="v19-asunto subject-cell-v455 subject-cell-v639" title="${esc(masterV18Asunto(r)||'')}">
        ${masterV18Asunto(r)
          ?`<div class="subject-text-v638 subject-text-v639" title="${esc(masterV18Asunto(r))}">${esc(masterV18Asunto(r))}</div>`
          :'—'
        }
      </td>

      <td class="v19-date">
        ${entregaFecha?masterDateTimeHtml(entregaFecha):'—'}
      </td>

      <td class="v19-person">
        ${solicitante}
      </td>

      <td>${esc(r.modalidad||'—')}</td>

      <td>${r.cargo?esc(r.cargo):'—'}</td>

      <td class="v19-person">
        ${masterV18Attendant(r)
          ?esc(masterV18Attendant(r))
          :'—'
        }
      </td>

      <td class="v19-time">
        ${masterV28AttentionDays(r)}
      </td>

      <td class="v19-reassignment-single">
        ${masterV18ReassignmentHtml(r)}
      </td>

      <td class="v19-date v19-block-end">
        ${r.master_reasignacion_fecha
          ?masterDateTimeHtml(r.master_reasignacion_fecha)
          :'—'
        }
      </td>

      <!-- SITUACIÓN FINAL -->
      <td>${rowStatus(r)}</td>
      <td class="v19-block-end">${esc(masterV19LocationFinal(r))}</td>

      <!-- DÍAS EN CUSTODIA -->
      <td class="v19-time v19-block-end">
        ${masterV28CustodyDays(r)}
      </td>

      <!-- DEVOLUCIÓN -->
      <td class="v19-date">${masterV18ReturnDateHtml(r)}</td>
      <td class="v19-person">${masterV18Returner(r)
        ?esc(masterV18Returner(r))
        :'—'
      }</td>
      <td class="v19-person">${masterV18Receiver(r)
        ?esc(masterV18Receiver(r))
        :'—'
      }</td>
      <td class="v19-block-end">${masterV18ReturnFolio(r)
        ?esc(masterV18ReturnFolio(r))
        :'—'
      }</td>

      <!-- CAMPOS ADICIONALES DEL SISTEMA -->
      <td>${systemFields.listado}</td>
      <td>${systemFields.sede}</td>
      <td>${systemFields.envio}</td>
      <td>${esc(r.digitalizado||'—')}${r.enlace
        ?` · <a href="${esc(r.enlace)}" target="_blank">Abrir</a>`
        :''
      }</td>
      <td>${rowAlert(r)
        ?'<span class="pill alert">ALERTA &gt;30 DÍAS</span>'
        :'—'
      }</td>
      <td class="v19-actions">${actions}</td>
    </tr>`;
  }).join('');

  return `<table class="master-record-table master-v19">
    <thead>
      <tr class="master-v19-groups">
        <th scope="col" rowspan="2">✓</th>
        <th scope="col" rowspan="2">Ítem</th>

        <th scope="colgroup" colspan="5" class="g-init">
          Inicio del requerimiento
        </th>

        <th scope="colgroup" colspan="6" class="g-att">
          Atención del requerimiento
        </th>

        <th scope="col" rowspan="2" class="g-time">
          Días de<br>atención
        </th>

        <th scope="colgroup" colspan="2" class="g-reas">
          Reasignación
        </th>

        <th scope="colgroup" colspan="2" class="g-final">
          Situación final
        </th>

        <th scope="col" rowspan="2" class="g-custody">
          Días en<br>custodia
        </th>

        <th scope="colgroup" colspan="4" class="g-return">
          Devolución
        </th>

        <th scope="colgroup" colspan="6" class="g-system">
          Campos adicionales del sistema
        </th>
      </tr>

      <tr class="master-v19-columns">
        <!-- Inicio / Atención -->
        <th scope="col">Fecha y hora<br>de solicitud</th>
        <th scope="col">Expediente</th>
        <th scope="col">Extensión</th>
        <th scope="col">Última R.D.</th>
        <th scope="col">N.° de folios</th>

        <th scope="col">Asunto del requerimiento</th>
        <th scope="col">Fecha y hora<br>de entrega</th>
        <th scope="col">Nombre del solicitante</th>
        <th scope="col">Modalidad</th>
        <th scope="col">Cargo</th>
        <th scope="col">Profesional responsable<br>de la atención</th>

        <!-- Reasignación -->
        <th scope="col">Reasignación (De → A)</th>
        <th scope="col" class="v19-block-end">Fecha / hora</th>

        <!-- Situación final -->
        <th scope="col">Estado</th>
        <th scope="col" class="v19-block-end">Ubicación</th>

        <!-- Devolución -->
        <th scope="col">Fecha</th>
        <th scope="col">Profesional que devuelve</th>
        <th scope="col" title="Perfil ARCHIVO o ADMINISTRADOR que confirmó la devolución de este ciclo">Profesional que recibe</th>
        <th scope="col" class="v19-block-end">N.° folios</th>

        <!-- Adicional -->
        <th scope="col">Listado</th>
        <th scope="col">Sede</th>
        <th scope="col">Fecha de envío<br>a San Luis</th>
        <th scope="col">Digitalizado</th>
        <th scope="col">Alerta</th>
        <th scope="col">Acciones</th>
      </tr>
    </thead>

    <tbody>${body}</tbody>
  </table>`;
}

// V79: en las tablas operativas ya no se muestra una columna separada
// de Fecha de devolución. La Fecha / hora del último estado resume
// cronológicamente el último cambio operativo, incluido el retorno al Archivo.
// La fecha de devolución se conserva en datos e historial.



function coordinatorTeamFieldV217(row,...keys){
  for(const key of keys){
    const value=row?.[key];
    if(value===0)return 0;

    const text=String(value??'').trim();
    if(text && text.toLowerCase()!=='null'){
      return value;
    }
  }
  return '';
}

function coordinatorTeamStateV217(row){
  return String(
    coordinatorTeamFieldV217(
      row,
      'ultimo_estado',
      'estado_operativo',
      'estado',
      'estado_item',
      'estado_solicitud_item'
    )||'—'
  ).trim();
}


// ============================================================
// V406 · CLASIFICACIÓN ÚNICA DE CUSTODIA DEL EQUIPO
// CUSTODIA es la fuente principal.
// De esa misma lista se derivan PRÉSTAMOS y REASIGNADOS.
// ============================================================
function coordinatorCustodyStateV406(row){
  let operational='';

  try{
    operational=
      typeof operationalStatus==='function'
        ?operationalStatus(row)
        :'';
  }catch(_){}

  const raw=norm(
    operational||
    row?.estado_operativo||
    row?.ultimo_estado||
    row?.estado_actual_db||
    row?.estado_actual||
    row?.estado||
    row?.situacion_operativa||
    row?.estado_item||
    row?.estado_solicitud_item||
    coordinatorTeamStateV217(row)||
    ''
  );

  if(
    raw.includes('DEVOLUCIÓN SOLICITADA') ||
    raw.includes('DEVOLUCION SOLICITADA')
  ){
    return 'DEVOLUCIÓN SOLICITADA';
  }

  if(
    raw.includes('REASIGN') ||
    raw.includes('DERIVADO A USUARIO')
  ){
    return 'REASIGNADO';
  }

  if(
    raw.includes('PRÉSTAMO') ||
    raw.includes('PRESTAMO') ||
    raw==='CARGO GENERADO' ||
    raw.includes('ENTREGA EN PRÉSTAMO') ||
    raw.includes('ENTREGA EN PRESTAMO') ||
    raw.includes('EN CUSTODIA DEL USUARIO')
  ){
    return 'EN PRÉSTAMO';
  }

  return raw||'SIN ESTADO';
}

function coordinatorCustodyBreakdownV406(rows=[]){
  const list=Array.isArray(rows)?rows:[];

  const loans=[];
  const reassigned=[];
  const returnRequested=[];
  const others=[];

  for(const row of list){
    const state=coordinatorCustodyStateV406(row);

    if(state==='EN PRÉSTAMO'){
      loans.push(row);
    }else if(state==='REASIGNADO'){
      reassigned.push(row);
    }else if(state==='DEVOLUCIÓN SOLICITADA'){
      returnRequested.push(row);
    }else{
      others.push(row);
    }
  }

  return {
    total:list.length,
    loans,
    reassigned,
    returnRequested,
    others
  };
}

function coordinatorFilterCustodyV406(rows,type){
  const normalized=String(type||'CUSTODIA').toUpperCase();
  const breakdown=coordinatorCustodyBreakdownV406(rows);

  if(normalized==='PRESTAMO'){
    return breakdown.loans;
  }

  if(
    normalized==='REASIGNADOS_A_MI' ||
    normalized==='REASIGNADOS' ||
    normalized==='REASIGNADO'
  ){
    return breakdown.reassigned;
  }

  if(normalized==='DEVOLUCION_SOLICITADA'){
    return breakdown.returnRequested;
  }

  return Array.isArray(rows)?rows:[];
}

function coordinatorTeamDateV217(row){
  return coordinatorTeamFieldV217(
    row,
    'ultimo_movimiento_fecha',
    'fecha_ultimo_estado',
    'fecha_inicio_custodia',
    'fecha_entrega',
    'updated_at',
    'created_at'
  )||null;
}



function coordinatorValueV225(row,...keys){
  for(const key of keys){
    const value=row?.[key];

    if(value===0 || value===false)return value;

    const text=String(value??'').trim();

    if(
      text &&
      text!=='—' &&
      text.toLowerCase()!=='null' &&
      text.toLowerCase()!=='undefined'
    ){
      return value;
    }
  }

  return '';
}

function coordinatorDateV225(value){
  return value?masterDateTimeHtml(value):'—';
}

function coordinatorDigitalV225(r){
  const digital=String(
    coordinatorValueV225(
      r,
      'digitalizado',
      'digitalizacion',
      'digital'
    )||''
  ).trim();

  const link=String(
    coordinatorValueV225(
      r,
      'enlace',
      'link',
      'url'
    )||''
  ).trim();

  const text=digital||(
    link
      ?'SÍ'
      :'—'
  );

  return `
    <div class="v225-stack">
      <b>${esc(text)}</b>
      ${link
        ?`<a href="${esc(link)}" target="_blank" rel="noopener">Abrir digital</a>`
        :''
      }
    </div>`;
}

function coordinatorReturnDataV225(r){
  const returnedBy=coordinatorValueV225(
    r,
    'devuelto_por',
    'devuelto_por_usuario'
  );

  const returnedAt=coordinatorValueV225(
    r,
    'fecha_aceptacion_devolucion',
    'fecha_devolucion',
    'fecha_devuelto_por_usuario'
  );

  const acceptedBy=coordinatorValueV225(
    r,
    'responsable_acepta_devolucion',
    'aceptado_devolucion_por',
    'profesional_recibe',
    'recibido_por'
  );

  if(!returnedBy && !returnedAt && !acceptedBy)return '—';

  return `
    <div class="v225-stack">
      ${returnedBy
        ?`<span><small>Devuelto por</small><b>${esc(returnedBy)}</b></span>`
        :''
      }
      ${returnedAt
        ?`<span><small>Fecha</small>${coordinatorDateV225(returnedAt)}</span>`
        :''
      }
      ${acceptedBy
        ?`<span><small>Recibido por</small><b>${esc(acceptedBy)}</b></span>`
        :''
      }
    </div>`;
}

function renderCoordinatorCompleteTableV225(rows,context=''){
  const data=(Array.isArray(rows)?rows:[])
    .map(canonicalizeCoordinatorRowV216);
  const v647PendingContext=/PENDIENT/i.test(String(context||''));
  const v681Context=String(context||'').toLowerCase();
  const v675ShowReassignment=(
    v681Context.includes('reassigned') || v681Context.includes('reasign')
      ? data.length>0
      : (v681Context.includes('custody') || v681Context.includes('custodia'))
  );

  if(!data.length){
    return '<div class="empty">No hay expedientes para mostrar en esta selección.</div>';
  }

  return `
    <div class="v225-complete-wrap">
      <table class="v225-complete-table">
        <thead>
          <tr>
            <th>N.°</th>
            <th>Expediente</th>
            <th>Ext.</th>
            <th>R.D.</th>
            <th class="subject-cell-v639">Asunto</th>
            <th>Solicitud / solicitante</th>
            <th>Cargo / atención</th>
            <th>Responsable actual / ubicación</th>
            <th>Estado</th>
            ${v675ShowReassignment?'<th>Reasignación (De → A)</th>':''}
            ${v647PendingContext?'<th class="v647-days-unattended-col">Días sin atender</th>':''}
            <th>Días en custodia</th>
            <th>Fecha último movimiento / estado</th>
            <th>Último movimiento</th>
            <th>Último folio</th>
            <th>Digitalización</th>
            <th>Datos de devolución</th>
            <th>Observación</th>
          </tr>
        </thead>

        <tbody>
          ${data.map((r,index)=>{
            const expediente=coordinatorExpNumberV216(r)||'—';
            const extension=coordinatorValueV225(r,'extension','ext')||'—';
            const rd=coordinatorValueV225(
              r,
              'rd',
              'resolucion_directoral',
              'numero_rd'
            )||'—';

            const asunto=v732AsuntoValor(r)||'—';

            const solicitud=coordinatorValueV225(
              r,
              'solicitud_numero',
              'numero_solicitud'
            )||'—';

            const solicitante=coordinatorValueV225(
              r,
              'solicitante'
            )||'—';

            const modalidad=coordinatorValueV225(
              r,
              'modalidad'
            )||'—';

            const cargo=coordinatorValueV225(
              r,
              'cargo_numero',
              'cargo',
              'cargo_devolucion_usuario'
            )||'—';

            const atendidoPor=coordinatorValueV225(
              r,
              'atendido_por_archivo',
              'atiende_requerimiento',
              '_v183_archive_staff'
            )||'—';

            const responsable=coordinatorValueV225(
              r,
              'responsable_actual',
              'responsable',
              'responsable_actual_db'
            )||'—';

            const ubicacion=coordinatorValueV225(
              r,
              'ubicacion_actual',
              'ubicacion',
              'sede'
            )||'';

            const ctx=String(context||'').toUpperCase();
            const relation=String(
              r?.estado_relacion||
              r?.relacion_reasignacion||
              ''
            ).trim();
            const estado=(
              relation &&
              (ctx.includes('REASIGNADOS_POR_MI') || ctx.includes('REASIGNADOS_A_MI'))
            )
              ?relation
              :coordinatorTeamStateV217(r);

            const fechaSolicitud=coordinatorValueV225(
              r,
              'solicitud_created_at',
              'fecha_solicitud',
              'created_at'
            );

            const fechaCustodia=coordinatorValueV225(
              r,
              'fecha_inicio_custodia',
              'fecha_entrega_solicitud_actual',
              'fecha_entrega'
            );

            const fechaUltimo=coordinatorValueV225(
              r,
              'ultimo_movimiento_fecha',
              'fecha_ultimo_estado',
              'updated_at'
            );

            const movimiento=coordinatorValueV225(
              r,
              'ultimo_movimiento',
              'accion'
            )||'—';

            const desde=coordinatorValueV225(
              r,
              'ultimo_movimiento_desde',
              'desde'
            );

            const hacia=coordinatorValueV225(
              r,
              'ultimo_movimiento_hacia',
              'hacia'
            );

            const ultimoFolio=coordinatorValueV225(
              r,
              'ultimo_folio',
              'folio_final',
              'folio'
            )||'—';

            const observacion=coordinatorValueV225(
              r,
              'observacion',
              'observaciones'
            )||'—';

            return `
              <tr>
                <td>${index+1}</td>

                <td>
                  <div class="v225-exp-number">
                    <b>${esc(expediente)}</b>
                  </div>
                </td>

                <td>${esc(extension)}</td>
                <td>${esc(rd)}</td>

                <td class="v225-wide">
                  <div class="v225-wrap-text">${esc(asunto)}</div>
                </td>

                <td>
                  <div class="v225-stack">
                    <span><small>Solicitud</small><b>${esc(solicitud)}</b></span>
                    <span><small>Solicitante</small>${esc(solicitante)}</span>
                    <span><small>Modalidad</small>${esc(modalidad)}</span>
                    ${v647PendingContext && fechaSolicitud
                      ?`<span><small>Fecha solicitud</small>${coordinatorDateV225(fechaSolicitud)}</span>`
                      :''
                    }
                  </div>
                </td>

                <td>
                  <div class="v225-stack">
                    <span><small>Cargo</small><b>${esc(cargo)}</b></span>
                    <span><small>Atendido por Archivo</small>${esc(atendidoPor)}</span>
                  </div>
                </td>

                <td>
                  <div class="v225-stack">
                    <b>${esc(responsable)}</b>
                    ${ubicacion
                      ?`<span><small>Ubicación</small>${esc(ubicacion)}</span>`
                      :''
                    }
                  </div>
                </td>

                <td>
                  <span class="v217-state">${esc(estado||'—')}</span>
                  ${relation && r?.estado_fisico_actual && norm(r.estado_fisico_actual)!==norm(estado)
                    ?`<div class="v637-physical-state">${esc(r.estado_fisico_actual)}</div>`
                    :''
                  }
                </td>

                ${v675ShowReassignment?`<td>${(v681Context.includes('custody')||v681Context.includes('custodia'))?reassignmentRouteCustodyV683(r):reassignmentRouteHtmlV675(r)}</td>`:''}
                ${v647PendingContext?`<td class="v647-days-unattended-col">${v628UnattendedDaysHtml(r,true)||'—'}</td>`:''}

                <td>${custodyDaysHtmlV221(r)}</td>

                <td class="v226-last-date">
                  ${
                    (
                      fechaUltimo ||
                      coordinatorValueV225(
                        r,
                        'fecha_aceptacion_devolucion',
                        'fecha_devolucion',
                        'fecha_devuelto_por_usuario',
                        'updated_at'
                      )
                    )
                      ?coordinatorDateV225(
                          fechaUltimo ||
                          coordinatorValueV225(
                            r,
                            'fecha_aceptacion_devolucion',
                            'fecha_devolucion',
                            'fecha_devuelto_por_usuario',
                            'updated_at'
                          )
                        )
                      :'—'
                  }
                </td>

                <td>
                  <div class="v225-stack">
                    <b>${esc(movimiento)}</b>
                    ${desde||hacia
                      ?`<span>${esc(desde||'—')} → ${esc(hacia||'—')}</span>`
                      :''
                    }
                  </div>
                </td>

                <td><b>${esc(String(ultimoFolio))}</b></td>

                <td>${coordinatorDigitalV225(r)}</td>

                <td>${coordinatorReturnDataV225(r)}</td>

                <td class="v225-wide">
                  <div class="v225-wrap-text">${esc(observacion)}</div>
                </td>
              </tr>`;
          }).join('')}
        </tbody>
      </table>
    </div>`;
}

function renderCoordinatorPendingTeamTableV220(rows){
  const data=(Array.isArray(rows)?rows:[])
    .map(canonicalizeCoordinatorRowV216);

  if(!data.length){
    return `
      <div class="empty">
        No se encontraron expedientes pendientes por atender para este usuario.
      </div>`;
  }

  return `
    <div class="v217-coordinator-table-wrap">
      <table class="v217-coordinator-table v220-pending-table">
        <thead>
          <tr>
            <th>N.°</th>
            <th>Expediente</th>
            <th>Ext.</th>
            <th>R.D.</th>
            <th>Solicitud</th>
            <th>Fecha solicitud</th>
            <th class="v647-days-unattended-col">Días sin atender</th>
            <th class="subject-cell-v639">Asunto</th>
            <th>Estado solicitud</th>
            <th>Responsable actual</th>
            <th>Días en custodia</th>
          </tr>
        </thead>
        <tbody>
          ${data.map((r,index)=>{
            const expediente=coordinatorExpNumberV216(r)||'—';
            const extension=coordinatorTeamFieldV217(r,'extension','ext')||'—';
            const rd=coordinatorTeamFieldV217(r,'rd','resolucion_directoral','numero_rd')||'—';
            const solicitud=coordinatorTeamFieldV217(
              r,
              'solicitud_numero',
              'numero_solicitud'
            )||'—';
            const fecha=coordinatorTeamFieldV217(
              r,
              'solicitud_created_at',
              'fecha_solicitud',
              'created_at'
            )||null;
            const asunto=coordinatorTeamFieldV217(
              r,
              'asunto',
              'solicitud_asunto'
            )||'—';
            const estado=coordinatorTeamFieldV217(
              r,
              'estado_item',
              'estado'
            )||'PENDIENTE POR ATENDER';
            const responsable=coordinatorTeamFieldV217(
              r,
              'responsable_actual',
              'ubicacion_actual',
              'responsable'
            )||'—';

            return `
              <tr>
                <td>${index+1}</td>
                <td><b>${esc(expediente)}</b></td>
                <td>${esc(extension)}</td>
                <td>${esc(rd)}</td>
                <td><b>${esc(solicitud)}</b></td>
                <td>${fecha?masterDateTimeHtml(fecha):'—'}</td>
                <td class="v647-days-unattended-col">${v628UnattendedDaysHtml(r,true)||'—'}</td>
                <td class="subject-cell-v639" title="${esc(asunto||'')}"><div class="subject-text-v639">${esc(asunto||'—')}</div></td>
                <td><span class="v217-state">${esc(estado)}</span></td>
                <td>${esc(responsable)}</td>
                <td>${custodyDaysHtmlV221(r)}</td>
              </tr>`;
          }).join('')}
        </tbody>
      </table>
    </div>`;
}

function renderCoordinatorTeamTableV217(rows){
  const data=(Array.isArray(rows)?rows:[])
    .map(canonicalizeCoordinatorRowV216);

  if(!data.length){
    return '<div class="empty">No hay expedientes para mostrar en este estado.</div>';
  }

  const numbers=coordinatorVisibleExpNumbersV216(data);

  return `
    <div class="v217-coordinator-table-wrap">
      <table class="v217-coordinator-table">
        <thead>
          <tr>
            <th>N.°</th>
            <th>Expediente</th>
            <th>Ext.</th>
            <th>R.D.</th>
            <th class="subject-cell-v639">Asunto</th>
            <th>Responsable actual / ubicación</th>
            <th>Estado</th>
            <th>Días en custodia</th>
            <th>Último folio</th>
            <th>Fecha / hora último estado</th>
          </tr>
        </thead>
        <tbody>
          ${data.map((r,index)=>{
            const expediente=coordinatorExpNumberV216(r)||'—';
            const extension=coordinatorTeamFieldV217(r,'extension','ext')||'—';
            const rd=coordinatorTeamFieldV217(r,'rd','resolucion_directoral','numero_rd')||'—';
            const asunto=coordinatorTeamFieldV217(
              r,
              'asunto',
              'master_asunto',
              'asunto_requerimiento',
              'solicitud_asunto'
            )||'—';

            const responsable=coordinatorTeamFieldV217(
              r,
              'responsable_actual',
              'responsable',
              'responsable_fisico_db'
            )||'';

            const ubicacion=coordinatorTeamFieldV217(
              r,
              'ubicacion_actual',
              'ubicacion',
              'sede'
            )||'';

            const responsibleText=[
              String(responsable||'').trim(),
              String(ubicacion||'').trim()
            ].filter(Boolean).join(' · ')||'—';

            const estado=coordinatorTeamStateV217(r);
            const ultimoFolio=coordinatorTeamFieldV217(
              r,
              'ultimo_folio',
              'folio_final',
              'folio'
            )||'—';

            const fecha=coordinatorTeamDateV217(r);

            return `
              <tr>
                <td>${index+1}</td>
                <td><b>${esc(expediente)}</b></td>
                <td>${esc(extension)}</td>
                <td>${esc(rd)}</td>
                <td class="subject-cell-v639" title="${esc(asunto||'')}"><div class="subject-text-v639">${esc(asunto||'—')}</div></td>
                <td>${esc(responsibleText)}</td>
                <td><span class="v217-state">${esc(estado)}</span></td>
                <td>${custodyDaysHtmlV221(r)}</td>
                <td>${esc(String(ultimoFolio))}</td>
                <td>${fecha?masterDateTimeHtml(fecha):'—'}</td>
              </tr>
            `;
          }).join('')}
        </tbody>
      </table>
    </div>
  `;
}

function coordinatorExpNumberStripV216(data){
  if(!isCoordinatorTeamWorkspaceV206())return '';

  const numbers=coordinatorVisibleExpNumbersV216(data);

  if(!numbers.length){
    return `
      <div class="v216-exp-number-strip empty">
        No se encontraron números de expediente para esta selección.
      </div>`;
  }

  return `
    <div class="v216-exp-number-strip">
      <div class="v216-exp-number-title">
        <b>${numbers.length}</b> expediente${numbers.length===1?'':'s'}:
      </div>
      <div class="v216-exp-number-list">
        ${numbers.map((n,i)=>
          `<span class="v216-exp-chip">
             <span class="v216-exp-index">${i+1}</span>
             ${esc(n)}
           </span>`
        ).join('')}
      </div>
    </div>`;
}



// ============================================================
// V675 · REASIGNACIÓN VISIBLE DE → A EN TODOS LOS PERFILES
// La trazabilidad ya existe en Supabase. Esta capa solo unifica
// cómo se muestra en Usuario, Coordinador, Archivo y Administrador.
// ============================================================
function reassignmentPartyV675(r,side){
  const from=[
    r?.reasignado_por,
    r?.reasignado_por_usuario,
    r?._v183_reassigned_from,
    r?.ultimo_movimiento_desde,
    r?.desde
  ];
  const to=[
    r?.reasignado_a,
    r?._v183_reassigned_to,
    r?.ultimo_movimiento_hacia,
    r?.hacia
  ];
  const values=side==='from'?from:to;
  for(const value of values){
    const clean=String(value??'').trim();
    if(clean)return clean;
  }
  if(side==='to'){
    const fallback=String(r?.responsable_actual||r?.responsable||'').trim();
    if(fallback)return fallback;
  }
  return '';
}

function reassignmentDateV675(r){
  return r?.fecha_reasignacion||r?.ultimo_movimiento_fecha||r?.updated_at||null;
}

// V677 · Clasificación estricta del movimiento físico.
// ARCHIVO → usuario = ENTREGA, usuario → usuario = REASIGNACIÓN,
// usuario → ARCHIVO = DEVOLUCIÓN. La existencia de `desde` y `hacia`
// por sí sola ya NO convierte un movimiento en reasignación.
function movementKindV677(r){
  const from=reassignmentPartyV675(r,'from');
  const to=reassignmentPartyV675(r,'to');
  const fromN=norm(from);
  const toN=norm(to);
  const action=norm(r?.ultimo_movimiento||r?.accion||r?.movimiento||'');
  const relation=norm(
    r?.estado_relacion||
    r?.relacion_reasignacion||
    r?.estado_operativo||
    r?.estado||''
  );
  const explicitFrom=String(r?.reasignado_por||r?.reasignado_por_usuario||r?._v183_reassigned_from||'').trim();
  const explicitTo=String(r?.reasignado_a||r?._v183_reassigned_to||'').trim();
  const archiveFrom=fromN==='ARCHIVO'||fromN.startsWith('ARCHIVO ')||fromN.includes('ARCHIVO CENTRAL');
  const archiveTo=toN==='ARCHIVO'||toN.startsWith('ARCHIVO ')||toN.includes('ARCHIVO CENTRAL');

  if(archiveTo && (action.includes('DEVOLUC')||action.includes('RECIBIDO EN ARCHIVO')||action.includes('RETORNO A ARCHIVO'))){
    return 'DEVOLUCION';
  }

  if(archiveFrom && (
    action.includes('CARGO GENERADO')||
    action.includes('ENTREGA EN PRESTAMO')||
    action.includes('ENTREGA EN PRÉSTAMO')||
    action.includes('VINCULADO A CARGO')||
    relation.includes('EN PRESTAMO')||
    relation.includes('EN PRÉSTAMO')
  )){
    return 'ENTREGA';
  }

  const hasExplicitReassignment=!!(explicitFrom||explicitTo);
  const actionIsReassignment=action.includes('REASIGN');
  const relationIsReassignment=relation.includes('REASIGN');

  if((actionIsReassignment||relationIsReassignment||hasExplicitReassignment) && !archiveFrom && !archiveTo){
    return 'REASIGNACION';
  }

  // Compatibilidad con datos históricos que solo guardan fecha de reasignación:
  // se acepta únicamente cuando ambos extremos son personas y ninguno es Archivo.
  if(r?.fecha_reasignacion && from && to && !archiveFrom && !archiveTo){
    return 'REASIGNACION';
  }

  return 'OTRO';
}

function hasReassignmentRouteV675(r){
  return movementKindV677(r)==='REASIGNACION';
}

// V683 · En Total en custodia, una ruta DE → A solo se considera
// vigente si el estado/relación/movimiento actual indica REASIGNACIÓN.
// No basta con que existan campos desde/hacia históricos.
function isCurrentReassignedV683(r){
  const values=[
    r?.estado_relacion,
    r?.relacion_reasignacion,
    r?.estado_operativo,
    r?.estado,
    r?.ultimo_estado,
    r?.ultimo_movimiento,
    r?.accion
  ];
  try{
    const op=typeof operationalStatus==='function'?operationalStatus(r):'';
    if(op)values.push(op);
  }catch(_){ }
  return values.some(v=>norm(v||'').includes('REASIGN'));
}

function reassignmentRouteCustodyV683(r){
  return isCurrentReassignedV683(r)?reassignmentRouteHtmlV675(r):'—';
}

function reassignmentRouteHtmlV675(r,{showDate=true}={}){
  if(!hasReassignmentRouteV675(r))return '—';
  const from=reassignmentPartyV675(r,'from')||'—';
  const to=reassignmentPartyV675(r,'to')||'—';
  const date=reassignmentDateV675(r);
  let dateText='';
  if(showDate&&date){
    try{
      const d=typeof fmtDate==='function'?fmtDate(date):String(date);
      const t=typeof fmtTime==='function'?fmtTime(date):'';
      dateText=[d,t].filter(Boolean).join(' ');
    }catch(_){
      dateText=String(date);
    }
  }
  return `<div class="v675-reassign-route">
    <div class="v675-reassign-names">
      <span class="v675-reassign-from">${esc(from)}</span>
      <span class="v675-reassign-arrow">→</span>
      <span class="v675-reassign-to">${esc(to)}</span>
    </div>
    ${dateText?`<small>${esc(dateText)}</small>`:''}
  </div>`;
}

function recordTable(data,withOwner=false,source='panel'){
  if(source==='all'){
    masterLocationSequence++;
    const locationIds=data.map(r=>r.id);
    queueMicrotask(()=>loadMasterLocationNotices(locationIds));
  }

  if(!data.length){
    return '<div class="empty">No hay expedientes registrados para esta selección.</div>';
  }

  // V18: el Registro Maestro utiliza la estructura integral por etapas.
  if(source==='all'){
    return masterRecordTableV18(data);
  }

  const limited=isLimitedUser();
  const v698PanelFilter=String(
    typeof panelQuickFilter!=='undefined'?panelQuickFilter:''
  ).toLowerCase();

  // V698 · La ubicación comunicada no se muestra en EN PRÉSTAMO.
  // En esta tarjeta la referencia operativa es la custodia vigente del usuario.
  // Se mantiene en Total en custodia, Pendientes por atender, Mis solicitudes
  // y demás vistas donde aporta contexto sin confundir la ubicación física actual.
  // V699 · En las tarjetas generales de Mis expedientes NO se muestra
  // Ubicación / comunicación. La única excepción es la tarjeta especial
  // EXPEDIENTES PENDIENTES POR ATENDER, cuya tabla usa el renderer V695.
  const userNotices=false;

  if(userNotices)queueMicrotask(()=>loadUserLocationNotices());

  // Siempre mostrar quién tiene actualmente el expediente.
  // Esto permite que una búsqueda por N° de expediente indique
  // inmediatamente la persona o ubicación responsable.
  const showOwner=true;
  const ownerHead='<th>Responsable actual / ubicación</th>';

  // V730: en el detalle general no se muestra la columna redundante 'Último movimiento'.
  // V681 · La columna de reasignación depende de la tarjeta consultada.
  // - PRÉSTAMOS: nunca debe mostrarse.
  // - TOTAL EN CUSTODIA: se muestra solo si en la página hay al menos una reasignación real.
  // - REASIGNADOS: se muestra siempre que haya filas.
  const v681PanelFilter=v698PanelFilter;
  const showReassignmentColumn=source==='panel' && (
    v681PanelFilter==='reassigned'
      ? data.length>0
      : v681PanelFilter==='custody'
  );
  const reassignmentHead=showReassignmentColumn
    ?'<th title="Solo movimientos reales de reasignación entre usuarios: quién entregó y quién recibió la custodia">Reasignación (De → A)</th>'
    :'';
  const masterSolicitanteHead=
    source==='all'
      ?'<th>Solicitante</th><th>Ingreso solicitud</th>'
      :'';
  const selectableRows=data.filter(r=>
    source==='all'
      ?masterCycleRowSelectable(r)
      :!r._internal_reassign_requested
  );

  const allChecked=
    selectableRows.length>0 &&
    selectableRows.every(r=>selectedIds.has(r.id));

  const body=data.map(r=>{
    const masterSelectable=
      source==='all'
        ?masterCycleRowSelectable(r)
        :!r._internal_reassign_requested;

    const checked=
      source==='all'
        ?masterCycleRowChecked(r)
        :selectedIds.has(r.id);

    const rowClass=[
      masterSelectable?'record-selectable-row':'',
      checked?'record-selected-row':'',
      source==='all'?masterCycleRowClass(r):''
    ].filter(Boolean).join(' ');

    const rowClick=masterSelectable
      ?`onclick="toggleSelectFromRow(event,'${r.id}')" title="Clic en la fila para seleccionar o deseleccionar"`
      :(source==='all' && r._master_cycle
        ?'title="Ciclo cerrado · solo lectura"'
        :'');

    return `<tr class="${rowClass}" ${rowClick}>
    <td>${!masterSelectable
      ?`<input type="checkbox" disabled
               title="${source==='all' && r._master_cycle
                 ?'El ciclo está cerrado y es de solo lectura.'
                 :'La fila no está disponible para selección.'}">`
      :`<input type="checkbox"
               aria-label="Seleccionar ${esc(expKey(r))}"
               ${checked?'checked':''}
               onchange="toggleSelect('${r.id}',this.checked,this)">`}</td>
    <td>
      <b>${esc(expBase(
        isCoordinatorTeamWorkspaceV206()
          ?coordinatorExpNumberV216(r)
          :r.expediente
      ))}</b>
      ${accumulatedInlineHtml(r,{canManage:false})}
    </td>
    <td>${r.extension?esc(r.extension):'—'}</td>
    <td>${esc(r.rd)}</td>
    <td class="subject-cell-v455 v723-cargo-materia-cell">
      ${v723CargoMateriaHtml(r)}
    </td>

    ${showOwner
      ?`<td><b>${esc(currentResponsibleDisplay(r))}</b></td>`
      :''}

    <td>${rowStatus(r)}</td>
    ${showReassignmentColumn?`<td>${v681PanelFilter==='custody'?reassignmentRouteCustodyV683(r):reassignmentRouteHtmlV675(r)}</td>`:''}
    ${source==='panel'
      ?`<td class="v730-days-custody">${custodyDaysHtmlV221(r)}</td>`
      :''
    }
    ${userNotices?`<td data-user-location="${esc(r.id||r.expediente_id||'')}" data-user-location-request="${esc(r.solicitud_id||r.solicitud_activa_id||'')}" aria-busy="true" style="min-width:220px;max-width:330px;white-space:normal"></td>`:''}
    ${source==='all'?`<td data-master-location="${esc(r.id)}" aria-busy="true" style="min-width:175px;line-height:1.45"></td>`:''}
    ${source==='all'?`<td>${masterArchiveListHtml(r)}</td><td>${masterSedeHtml(r)}</td>`:''}
    ${source==='all'?`<td>${masterShowRequester(r) && r.solicitante_pendiente
      ?`<b>${esc(r.solicitante_pendiente)}</b>${r.solicitud_pendiente_numero
        ?`<span class="master-cycle-request-number">${esc(r.solicitud_pendiente_numero)}</span>`
        :''}${masterCycleBadgeHtml(r)}`
      :'—'}</td><td>${masterRequestEntryHtml(r)}</td>`:''}

    ${source==='all'
      ?`<td>${masterDeliveryDateTimeValue(r)?masterDateTimeHtml(masterDeliveryDateTimeValue(r)):'—'}</td>`
      :`<td>${masterRequestEntryHtml(r)}</td>`
    }

    ${source==='all'
      ?`<td>${masterCurrentStateDateValue(r)?masterDateTimeHtml(masterCurrentStateDateValue(r)):'—'}</td>`
      :`<td>${masterCurrentStateDateValue(r)?masterDateTimeHtml(masterCurrentStateDateValue(r)):'—'}</td>`
    }

    ${source==='all'?`<td>${masterReturnedByHtml(r)}</td>`:''}
    ${source==='all'?`<td>${rowDays(r)||''}</td>`:''}
    <td>${esc(r.modalidad)}</td>
    <td>${esc(r.ultimo_folio)}</td>
    <td>${esc(r.digitalizado)}${r.enlace?` · <a href="${esc(r.enlace)}" target="_blank">Abrir</a>`:''}</td>
    <td>${esc(r.cargo)}</td>
    <td>${rowAlert(r)?'<span class="pill alert">ALERTA >30 DÍAS</span>':''}</td>
    <td>${esc(r.observacion)}</td>
    <td>
      ${
        source==='all'
          ?`<div class="master-actions-inline">
              <button class="btn secondary small"
                      onclick="showExpHistory(
                        '${r.id}',
                        '${r._master_cycle?(r.solicitud_id||''):''}'
                      )">
                Historial
              </button>

              ${r._master_cycle && masterCycleIsClosed(r)
                ?`<span class="master-cycle-readonly">Solo lectura</span>`
                :(!limited
                  ?(r._master_cycle
                    ?`<button class="btn small user-manage-action"
                              onclick="manageMasterCycle(
                                '${r.id}',
                                '${r.solicitud_id||''}',
                                this
                              )">
                        Gestionar
                      </button>`
                    :`<button class="btn small user-manage-action"
                              onclick="manageExpedienteFromPanel('${r.id}',this)">
                        Gestionar
                      </button>`)
                  :'')}

              ${!r._master_cycle && masterCanRegisterConasReturn(r)
                ?`<button class="btn master-conas-return-btn"
                          type="button"
                          onclick="openMasterConasReturn('${r.id}',this)">
                    ✓ Retorno CONAS
                  </button>`
                :''}

              ${!r._master_cycle && window.masterCanRegisterDvcReturnV662?.(r)
                ?`<button class="btn master-dvc-return-btn"
                          type="button"
                          onclick="window.openMasterDvcReturnV662('${r.id}',this)">
                    ✓ Retorno DVC
                  </button>`
                :''}

              ${!r._master_cycle && window.masterCanRegisterInstructionReturnV662?.(r)
                ?`<button class="btn master-instruction-return-btn"
                          type="button"
                          onclick="window.openMasterInstructionReturnV662('${r.id}',this)">
                    ✓ Retorno Instrucción
                  </button>`
                :''}
            </div>`
          :`<div style="display:flex;gap:5px;white-space:nowrap">
              ${cycleHistoryButton(
                r.id,
                r
              )}
              ${!limited
                ?`<button class="btn small user-manage-action"
                          onclick="manageExpedienteFromPanel('${r.id}',this)">
                    Gestionar
                  </button>`
                :''}
              ${hasFullAccess() && !isCoordinator()
                ?`<button class="btn secondary small"
                          onclick="editRecord('${r.id}')">
                    Editar
                  </button>`
                :''}
            </div>`
      }
    </td>
  </tr>`;
  }).join('');

  const coordinatorStrip=
    source==='panel'
      ?coordinatorExpNumberStripV216(data)
      :'';

  return `${coordinatorStrip}<table class="${source==='all'?'master-record-table':''}"><thead><tr>
    <th><input type="checkbox" aria-label="Seleccionar todos" ${allChecked?'checked':''} onchange="toggleAllRows(this.checked,'${source}')"></th>
    <th>Expediente</th>
    <th>Extensión</th>
    <th>R.D.</th>
    <th class="subject-cell-v455 subject-cell-v639" title="Asunto de la solicitud vinculada al expediente">Asunto</th>
    ${ownerHead}
    <th title="Último estado operativo del expediente">Último estado</th>
    ${reassignmentHead}
    ${source==='panel'
      ?'<th class="v730-days-custody" title="Días hábiles transcurridos desde el inicio de la custodia vigente">Días en custodia</th>'
      :''
    }
    ${userNotices?'<th>Ubicación</th>':''}
    ${source==='all'?'<th title="Último aviso de ubicación comunicado; no modifica la ubicación física actual">Ubicación comunicada / fecha</th>':''}
    ${source==='all'?'<th title="Listado histórico asociado a la devolución del ciclo cerrado">Listado</th><th title="Sede física histórica; si fue enviado a San Luis se muestra la fecha de envío">Sede</th>':''}
    ${masterSolicitanteHead}

    ${source==='all'
      ?'<th title="Primera entrega física registrada del expediente">Fecha de entrega</th>'
      :'<th title="Fecha y hora de ingreso de la solicitud">Fecha / hora solicitud</th>'
    }

    ${source==='all'
      ?'<th title="Fecha correspondiente al último estado operativo del expediente">Fecha último estado</th>'
      :'<th title="Fecha y hora correspondiente al último estado operativo del expediente">Fecha / hora último estado</th>'
    }

    ${source==='all'?'<th>Devuelto por</th>':''}
    ${source==='all'?'<th>Días háb.</th>':''}
    <th>Modalidad</th>
    <th>Últ. folio</th>
    <th>Digitalizado</th>
    <th>Cargo</th>
    <th>Alerta</th>
    <th>Observación</th>
    <th>Acciones</th>
  </tr></thead><tbody>${body}</tbody></table>`;
}

function renderHistory(){
  if(!historyRows.length){el('historyTable').innerHTML='<div class="empty">No hay movimientos para mostrar.</div>';return}
  el('historyTable').innerHTML=`<table><thead><tr><th>Fecha / hora</th><th>Expediente</th><th>Extensión</th><th>Acción</th><th>Desde</th><th>Hacia</th><th>Cargo</th><th>Detalle</th></tr></thead><tbody>${historyRows.map(h=>`<tr><td><div class="datetime-cell"><span class="datetime-date">${fmtDate(h.created_at)}</span><span class="datetime-time">${fmtTime(h.created_at)}</span></div></td><td><b>${esc(h.expediente)}</b></td><td>${h.extension?esc(h.extension):'—'}</td><td>${esc(h.accion)}</td><td>${esc(h.desde)}</td><td>${esc(h.hacia)}</td><td>${esc(h.cargo)}</td><td>${esc(h.detalle)}</td></tr>`).join('')}</tbody></table>`
}
function syncV315ProfilePanelFreeze(){
  const panel=document.getElementById('tab-panel');
  const panelVisible=!!panel && !panel.classList.contains('hidden');
  const body=document.body;
  const personalProfile=
    body.classList.contains('produce-user') ||
    body.classList.contains('produce-coordinator-self');
  body.classList.toggle('v315-freeze-profile-panel',panelVisible && personalProfile);
}

window.addEventListener('load',()=>{try{syncV315ProfilePanelFreeze();}catch(_){}});
window.addEventListener('resize',()=>{try{syncV315ProfilePanelFreeze();}catch(_){}});

function switchTab(name,btn){
  // V210 · Protección adicional para el perfil Coordinador.
  // Aunque se intente forzar la navegación desde el navegador,
  // Estados, DVC e Instrucción quedan bloqueados.
  if(
    typeof isCoordinator==='function' &&
    isCoordinator() &&
    ['states','dvc','instruction'].includes(name)
  ){
    toast('Esta opción no está habilitada para el perfil COORDINADOR de Gestión.');
    name=defaultTabForCurrentRole();
    btn=tabButtonFor(name);
  }

  // Si una pestaña no corresponde al perfil actual, volver a una vista permitida.
  // Esto refuerza la separación visual entre USUARIO y los perfiles de gestión.
  if(currentProfile && name && !tabAvailableForCurrentRole(name)){
    name=defaultTabForCurrentRole();
    btn=tabButtonFor(name);
  }
  if(name && tabAvailableForCurrentRole(name)){
    __lastActiveTabName=String(name);
  }
  // Mostrar/ocultar dinámicamente todas las secciones del sistema.
  // Así cualquier nueva pestaña (por ejemplo Instrucción) funciona
  // sin tener que agregarla manualmente a una lista fija.
  const activeSectionId=`tab-${name}`;
  document.querySelectorAll('section[id^="tab-"]').forEach(section=>{
    const isActive=section.id===activeSectionId;
    section.classList.toggle('hidden',!isActive);
    section.hidden=!isActive;
    section.style.setProperty('display',isActive?'block':'none','important');
    section.setAttribute('aria-hidden',isActive?'false':'true');
  });

  // V460: una sola vista operativa permanece físicamente pintable.
  // Forzar un nuevo ciclo de layout evita reutilizar capas visuales de la pestaña anterior.
  requestAnimationFrame(()=>{
    const active=document.getElementById(activeSectionId);
    if(active){ void active.offsetHeight; active.style.visibility='visible'; }
  });

  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));

  if(btn)btn.classList.add('active');

  setTimeout(()=>{
    try{adjustUniversalModuleSticky?.();}catch(_){}
    try{syncV315ProfilePanelFreeze();}catch(_){}
  },0);
}


function autoCargoNumber(){ return ''; }

async function loadCargoHeaderByNumber(){
  if(!sb)return false;

  const numero=(el('cNumero').dataset.numeroExistente||'').trim();
  if(!numero)return false;

  el('cargoStatus').textContent='Buscando datos del cargo...';

  // 1. Buscar el encabezado oficial del cargo.
  const {data,error}=await sb
    .from('cargos')
    .select('*')
    .eq('numero',numero)
    .maybeSingle();

  if(error){
    el('cargoStatus').textContent=error.message;
    return false;
  }

  if(!data){
    return false;
  }

  let solicitante=(data.solicitante||'').trim();

  // 2. Si el cargo existe pero el nombre está vacío, intentar recuperarlo del historial.
  if(!solicitante){
    const {data:hist,error:histError}=await sb
      .from('historial_expedientes')
      .select('hacia,created_at')
      .eq('cargo',numero)
      .eq('accion','CARGO ASOCIADO')
      .not('hacia','is',null)
      .order('created_at',{ascending:true});

    if(!histError && hist && hist.length){
      const nombres=[...new Set(hist.map(x=>(x.hacia||'').trim()).filter(Boolean))];
      if(nombres.length===1)solicitante=nombres[0];
    }
  }

  // 3. Segundo fallback: expedientes vinculados al cargo.
  if(!solicitante){
    const {data:exp,error:expError}=await sb
      .from('expedientes')
      .select('responsable')
      .eq('cargo',numero);

    if(!expError && exp && exp.length){
      const nombres=[...new Set(exp.map(x=>(x.responsable||'').trim()).filter(Boolean))];
      if(nombres.length===1)solicitante=nombres[0];
    }
  }

  el('cNumero').value=data.numero;
  el('cNumero').dataset.numeroExistente=data.numero;
  el('cNumero').dataset.cargoId=data.id||'';
  el('cNumero').readOnly=true;

  // El nombre se carga automáticamente PERO sigue siendo editable.
  el('cSolicitante').value=solicitante;
  el('cSolicitante').readOnly=false;
  el('cSolicitante').title='Nombre cargado automáticamente. Puede corregirlo antes de imprimir.';

  if(data.fecha)el('cFecha').value=data.fecha;
  el('cAsunto').value=(data.asunto||'').trim();
  el('cAsunto').dataset.originalAsunto=(data.asunto||'').trim();
  el('cAsunto').readOnly=true;
  el('cAsunto').title='Asunto cargado automáticamente desde la solicitud vinculada al cargo.';
  setArchiveStaffValue('cAtiende',(data.atiende_requerimiento||'').trim());
  el('cAtiende').disabled=true;
  el('cAtiende').title='Responsable de atención definido al aceptar la solicitud.';
  if(data.observacion)el('cObservacion').value=data.observacion;

  if(solicitante){
    el('cargoStatus').textContent='Solicitante cargado automáticamente. Puede corregirlo antes de imprimir.';
  }else{
    el('cargoStatus').textContent='No se encontró un solicitante guardado. Escriba el nombre antes de imprimir; al guardar quedará asociado al cargo.';
    setTimeout(()=>el('cSolicitante').focus(),50);
  }

  return true;
}

async function openExistingCargoForPrint(numero){
  if(!hasFullAccess()){
    alert('Solo Archivo o Administrador puede imprimir cargos.');
    return;
  }

  numero=(numero||'').trim();
  if(!numero){
    alert('El expediente todavía no tiene un cargo asociado.');
    return;
  }

  try{
    // Recuperar encabezado del cargo.
    const {data:cargo,error:cargoErr}=await sb
      .from('cargos')
      .select('id,numero')
      .eq('numero',numero)
      .maybeSingle();

    if(cargoErr)throw cargoErr;

    let ids=[];

    // Forma principal: tabla de relación cargo_expedientes.
    if(cargo?.id){
      const {data:links,error:linksErr}=await sb
        .from('cargo_expedientes')
        .select('expediente_id')
        .eq('cargo_id',cargo.id);

      if(!linksErr && links?.length){
        ids=links.map(x=>x.expediente_id).filter(Boolean);
      }
    }

    // Compatibilidad con cargos antiguos.
    if(!ids.length){
      const {data:rows,error:rowsErr}=await sb
        .from('expedientes')
        .select('id')
        .eq('cargo',numero);

      if(rowsErr)throw rowsErr;
      ids=(rows||[]).map(x=>x.id).filter(Boolean);
    }

    if(!ids.length){
      alert(`No se encontraron expedientes vinculados al Cargo N.° ${numero}.`);
      return;
    }

    selectedIds.clear();
    ids.forEach(id=>selectedIds.add(id));
    updateSelectionUI();

    await openCargoModal();

  }catch(err){
    alert(err?.message||String(err));
  }
}


async function loadCargoItemObservations(numero){
  numero=String(numero||'').trim();
  if(!numero||!sb||!cargoRows.length)return false;
  try{
    const {data,error}=await sb.rpc('listar_observaciones_cargo',{p_numero:numero});
    if(error){
      console.warn('Observaciones individuales de cargo:',error.message);
      return false;
    }
    const map=new Map((data||[]).map(x=>[String(x.expediente_id||''),String(x.observacion||'')]));
    cargoRows=cargoRows.map(r=>({
      ...r,
      _cargo_observacion:map.get(String(r.id))||''
    }));
    return true;
  }catch(e){
    console.warn('Observaciones individuales de cargo:',e);
    return false;
  }
}

function setCargoItemObservation(expedienteId,value){
  const id=String(expedienteId||'');
  const row=cargoRows.find(r=>String(r.id)===id);
  if(row)row._cargo_observacion=String(value||'');
}

function renderCargoSelectedList(){
  if(!el('cargoSelectedList'))return;
  el('cargoSelectedList').innerHTML=`<table><thead><tr><th>N°</th><th>Expediente</th><th>Ext.</th><th>R.D.</th><th>Último folio</th><th>Observación individual</th></tr></thead><tbody>${
    cargoRows.map((r,i)=>`<tr>
      <td>${i+1}</td>
      <td><b>${esc(r.expediente)}</b></td>
      <td>${r.extension?esc(r.extension):'—'}</td>
      <td>${esc(r.rd||'—')}</td>
      <td>${esc(r.ultimo_folio||'—')}</td>
      <td><textarea class="cargo-item-observation" data-expediente-id="${esc(r.id)}" placeholder="Escriba una observación para este expediente" oninput="setCargoItemObservation('${esc(r.id)}',this.value)">${esc(r._cargo_observacion||'')}</textarea></td>
    </tr>`).join('')
  }</tbody></table>`;
}

async function saveCargoItemObservations(numero){
  numero=String(numero||'').trim();
  if(!numero||!sb)return {ok:false,skipped:true};
  const items=cargoRows.map(r=>({
    expediente_id:String(r.id||''),
    observacion:String(r._cargo_observacion||'').trim()||null
  }));
  try{
    const {error}=await sb.rpc('guardar_observaciones_cargo',{
      p_numero:numero,
      p_items:items
    });
    if(error)return {ok:false,error};
    return {ok:true};
  }catch(error){
    return {ok:false,error};
  }
}

async function openCargoModal(){
  if(hasFullAccess()){
    await loadArchiveProfilesV462();
    renderArchiveStaffSelects();
  }
  if(!selectedIds.size){alert('Seleccione al menos un expediente.');return}
  el('cargoStatus').textContent='Cargando expedientes seleccionados...';
  el('cargoModal').classList.add('show');

  const ids=[...selectedIds];
  const {data,error}=await sb.from('expedientes').select('*').in('id',ids).order('expediente');
  if(error){el('cargoStatus').textContent=error.message;return}
  cargoRows=(data||[]).map(r=>({...r,_cargo_observacion:''}));

  const cargosExistentes=[...new Set(cargoRows.map(r=>(r.cargo||'').trim()).filter(Boolean))];
  const responsables=[...new Set(cargoRows.map(r=>(r.responsable||'').trim()).filter(Boolean))];

  el('cNumero').readOnly=true;
  el('cNumero').dataset.numeroExistente=cargosExistentes.length===1?cargosExistentes[0]:'';
  el('cNumero').dataset.cargoId='';
  el('cNumero').value=cargosExistentes.length===1?cargosExistentes[0]:'AUTOMÁTICO';
  el('cSolicitante').readOnly=false;
  el('cSolicitante').value='';
  el('cFecha').value=new Date().toISOString().slice(0,10);
  el('cAsunto').value='';
  el('cAsunto').dataset.originalAsunto='';
  el('cAsunto').readOnly=false;
  el('cAsunto').title='';
  setArchiveStaffValue('cAtiende','');
  el('cAtiende').disabled=false;
  el('cAtiende').title='';
  el('cObservacion').value='';
  el('cargoStatus').textContent='';

  // Si el cargo ya existe, recuperar SIEMPRE el encabezado original desde la tabla cargos.
  if(cargosExistentes.length===1){
    const encontrado=await loadCargoHeaderByNumber();
    if(encontrado){
      await loadCargoItemObservations(cargosExistentes[0]);
    }else{
      // Compatibilidad con cargos antiguos que aún no fueron migrados.
      if(responsables.length===1){
        el('cSolicitante').value=responsables[0];
        el('cargoStatus').textContent='Cargo antiguo sin encabezado almacenado. Se usará el responsable registrado y se guardará como solicitante del cargo.';
      }else{
        el('cargoStatus').textContent='Cargo antiguo con responsables actuales distintos. Ejecute MIGRACION_CARGOS.sql para recuperar el solicitante desde el historial.';
      }
    }
  }else if(cargosExistentes.length>1){
    el('cNumero').readOnly=true;
    el('cargoStatus').textContent='Los expedientes seleccionados pertenecen a cargos distintos. Seleccione un solo cargo.';
  }else{
    // Nuevo cargo: el solicitante se toma del panel por personal si existe;
    // si no, se usa el responsable común de los expedientes seleccionados.
    const panelPersona=selectedOwner && typeOf(selectedOwner)==='PERSONAL' ? selectedOwner : '';
    if(panelPersona){
      el('cSolicitante').value=panelPersona;
      el('cargoStatus').textContent='Solicitante cargado automáticamente. El número de cargo se asignará al guardar.';
    }else if(responsables.length===1){
      el('cSolicitante').value=responsables[0];
      el('cargoStatus').textContent='Solicitante cargado automáticamente. El número de cargo se asignará al guardar.';
    }else{
      el('cargoStatus').textContent='El número de cargo se generará automáticamente con formato 0001-AÑO, por ejemplo 0152-2026.';
    }
  }

  renderCargoSelectedList();
}

function closeCargoModal(){el('cargoModal').classList.remove('show')}
function cargoPrintHtml(cargo,solicitante,asunto,atiende,fecha,observacion,rows){
  const user=session?.user?.email||'';
  const rowsHtml=rows.map((r,i)=>{
    const acumulados=Array.isArray(r._acumulados)?r._acumulados:[];
    const acumuladosHtml=acumulados.length
      ?`<div style="margin-top:4px;font-size:9px">
          <b>Acumulados:</b>
          ${acumulados.map(a=>esc(a.numero_acumulado)+(a.extension?' · '+esc(a.extension):'')).join(' · ')}
        </div>`
      :'';

    return `<tr>
      <td>${i+1}</td>
      <td><b>${esc(r.expediente)}</b>${acumuladosHtml}</td>
      <td>${r.extension?esc(r.extension):'—'}</td>
      <td>${esc(r.rd||'')}</td>
      <td>${esc(r.ultimo_folio||'')}</td>
      <td class="obs-individual">${esc(r._cargo_observacion||'')}</td>
    </tr>`;
  }).join('');
  return `<!doctype html><html><head><meta charset="utf-8"><title>${esc(cargo)}</title><style>
  @page{size:A4;margin:15mm}body{font-family:Arial,sans-serif;color:#111;font-size:11px;margin:0;text-align:center}
  .cargo-page{width:100%;max-width:180mm;margin:0 auto;text-align:left}
  h1{text-align:center;font-size:16px;margin:0 0 4px}h2{text-align:center;font-size:12px;font-weight:normal;margin:0 0 18px}
  .meta{width:100%;border-collapse:collapse;margin-bottom:12px}.meta td{padding:5px 6px;border:1px solid #777;text-align:left}
  table.list{width:100%;border-collapse:collapse;table-layout:fixed}.list th,.list td{border:1px solid #555;padding:6px;vertical-align:middle;text-align:center}.list th{background:#eee}.list th:last-child,.list td.obs-individual{text-align:left}.list td.obs-individual{white-space:pre-wrap;word-break:break-word}
  .total{margin-top:8px;font-weight:bold;text-align:left}.obs{margin-top:12px;border:1px solid #777;padding:8px;min-height:35px;text-align:left}
  .signatures{display:flex;justify-content:space-between;margin-top:58px;gap:60px}.signature{flex:1;text-align:center;border-top:1px solid #111;padding-top:5px}
  .footer{margin-top:20px;font-size:9px;color:#555;text-align:right}
/* ===== Expedientes por usuario: tarjetas ultracompactas ===== */
#fullAccessKpis.owner-user-kpis{
  grid-template-columns:repeat(auto-fit,minmax(180px,240px));
  justify-content:start;
  gap:7px;
  margin-bottom:8px;
}
#fullAccessKpis.owner-user-kpis .kpi.user-status-card{
  min-height:60px!important;
